// Generated by unicode/tools/gen_tables.py from UCD 18.0.0. Do not edit.
//
// Two-stage tables. Code points are cut into blocks of 128. The index holds
// one two-digit hex block id per block, 64 per line; a block is one line of
// values, one character (width) or two (grapheme) per code point. Identical
// blocks are stored once.
//
// widthBlocks: the value is the cell width 0, 1 or 2.
//   0  gc is Cc, Mn, Me, Cf, Zl or Zp, or Grapheme_Cluster_Break is Control, V or T
//   2  not 0, and East_Asian_Width is W or F
//   1  everything else
// graphemeBlocks: two hex digits, Grapheme_Cluster_Break then InCB.
//   gcb: 0 Other 1 CR 2 LF 3 Control 4 Extend 5 ZWJ 6 Regional_Indicator
//        7 Prepend 8 SpacingMark 9 L a V b T c Extended_Pictographic
//   incb: 0 None 1 Consonant 2 Linker 3 Extend
//   LV and LVT are computed from the syllable block, so they read as Other here.
pure noalloc fn hexDigit(c: Int) -> Int {
    if c >= 0x61 {
        c - 0x57
    } else {
        c - 0x30
    }
}

pure noalloc fn digitAt(t: &String, at: usize) -> Int {
    hexDigit(t[at].toInt())
}

/// Offset in `blocks` of the value for p, where each value is `digits`
/// characters. The layout is described above; the tables live in width_index.kg, width_blocks.kg, grapheme_index.kg and grapheme_blocks.kg.
pure noalloc fn valueOffset(index: &String, blocks: &String, digits: usize, p: Int) -> usize {
    let q = p.toUsize() || 0
    let block = q >> 7
    let at = block * 2 + block / 64
    let id = digitAt(index, at) * 16 + digitAt(index, at + 1)
    let line = 128 * digits + 1
    (id.toUsize() || 0) * line + (q & 127) * digits
}

/// Cells one cluster occupies. The first scalar that takes a cell decides, so a
/// Prepend mark in front of a letter does not hide it. A flag pair is two cells
/// even though a lone indicator is one.
pub pure fn clusterWidth(cluster: String) -> Int {
    let cs = cluster.chars()
    if isRegionalPair(&cs) {
        return 2
    }
    let mut first: Int = 0
    let mut emoji = false
    for c in cs {
        if c.toInt() == 0xfe0f {
            emoji = true
        }
        if first == 0 {
            first = width(c)
        }
    }
    if emoji && first == 1 {
        2
    } else {
        first
    }
}

pure fn isRegionalPair(cs: &Array[Char]) -> Bool {
    if cs.len() != 2 {
        return false
    }
    let a = (cs.get(0) || ' ').toInt()
    let b = (cs.get(1) || ' ').toInt()
    a >= 0x1f1e6 && a <= 0x1f1ff && b >= 0x1f1e6 && b <= 0x1f1ff
}

/// Incremental boundary detection, for callers that walk a string themselves.
/// A terminal string interleaves escape sequences with text, so `graphemes`
/// cannot be used directly on it; feed only the visible scalars here.
pub type Breaker = {
    at Scan
    started Bool
}

/// What `Breaker.step` reports.
pub type Boundary = {
    pub boundary Bool
    pub next Breaker
}

/// A breaker positioned before the first scalar.
pub pure fn breaker() -> Breaker {
    Breaker {
        at: start()
        started: false
    }
}

/// Feeds the next visible scalar. `boundary` is true when a new cluster starts
/// at c, which is always the case for the first scalar.
pub pure fn Breaker.step(self, c: Char) -> Boundary {
    let next = propOf(c.toInt())
    let cut = !self.started || breaks(&self.at, next)
    Boundary {
        boundary: cut
        next: Breaker {
            at: advance(&self.at, next, !cut)
            started: true
        }
    }
}

/// Cells the character occupies, from UCD 18.0.0 (see tables.kg).
///
/// 0 for general category Cc, Mn, Me, Cf, Zl and Zp, for every scalar whose
/// Grapheme_Cluster_Break is Control (which adds the unassigned default
/// ignorables), and for conjoining Hangul vowels and finals. Tab is 0 as well:
/// callers must expand tabs and strip controls before measuring.
/// 2 for East_Asian_Width W and F, 1 for the rest. A scalar that is both
/// zero-width and Wide (U+3099, U+302A..U+302D) is 0.
pub pure noalloc fn width(c: Char) -> Int {
    let p = c.toInt()
    if p >= 0x20 && p < 0x7f {
        return 1
    }
    digitAt(&widthBlocks, valueOffset(&widthIndex, &widthBlocks, 1, p))
}

/// Total display width of the text, measured one grapheme cluster at a time.
/// Per-scalar summing would count a ZWJ emoji sequence several times over.
pub pure fn stringWidth(s: String) -> Int {
    let mut total = 0
    for g in graphemes(s) {
        total = total + clusterWidth(g)
    }
    total
}

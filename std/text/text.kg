/// Byte offset of the first occurrence of c in s, or None.
pub pure fn indexOf(s: String, c: Char) -> usize? {
    let needle = fromChar(c)
    if needle.len() > s.len() {
        return None
    }
    let mut i: usize = 0
    for i <= s.len() - needle.len() {
        if s.matchesAt(needle, i) {
            return Some(i)
        }
        i = i + 1
    }
    None
}

/// Lines of s without their `\n` or `\r\n` endings, as `BufReader.readLine` reads them; a trailing newline adds no empty line and "" has no lines.
pub pure fn lines(s: String) -> Array[String] {
    tryLines(s) || panic("out of memory")
}

/// Same as lines, or AllocError when the allocator refuses (lines panics instead).
pub pure fn tryLines(s: String) -> Result[Array[String], AllocError]

/// One string per Unicode scalar value of s.
pub pure fn graphemes(s: String) -> Array[String] {
    tryGraphemes(s) || panic("out of memory")
}

/// Same as graphemes, or AllocError when the allocator refuses (graphemes panics instead).
pub pure fn tryGraphemes(s: String) -> Result[Array[String], AllocError]

/// Parses `-? digits (. digits)? ([eE] [+-]? digits)?` (the JSON number grammar); None for anything else,
/// including a leading `+`, spaces, `inf`, `nan`, hex floats, underscores and a result that overflows to infinity.
pub pure fn parseFloat(s: String) -> Float?

fn isSpace(b: u8) -> Bool {
    b == 32 || b == 9 || b == 10 || b == 13
}

/// Parses s (surrounding whitespace allowed, the same set `trim` removes) as a base-10 integer with an optional sign, or None.
pub pure fn parseInt(s: String) -> Int? {
    let n = s.len()
    let mut i: usize = 0
    for i < n && isSpace(s[i]) {
        i = i + 1
    }
    let mut negative = false
    if i < n && (s[i] == 43 || s[i] == 45) {
        negative = s[i] == 45
        i = i + 1
    }
    let min = -9223372036854775807 - 1
    let mut acc = 0
    let mut digits = 0
    for i < n && s[i] >= 48 && s[i] <= 57 {
        let d = (s[i] - 48).toInt()
        if acc < (min + d) / 10 {
            return None
        }
        acc = acc * 10 - d
        digits = digits + 1
        i = i + 1
    }
    for i < n && isSpace(s[i]) {
        i = i + 1
    }
    if digits == 0 || i != n {
        return None
    }
    if negative {
        return Some(acc)
    }
    if acc == min {
        return None
    }
    Some(-acc)
}

/// Parses s (surrounding whitespace allowed, the same set `trim` removes) as a base-10 unsigned integer with an optional leading `+`, or None. The full u64 range, unlike parseInt.
pub pure fn parseUint(s: String) -> u64? {
    let n = s.len()
    let mut i: usize = 0
    for i < n && isSpace(s[i]) {
        i = i + 1
    }
    if i < n && s[i] == 43 {
        i = i + 1
    }
    let max: u64 = 18446744073709551615
    let mut acc: u64 = 0
    let mut digits = 0
    for i < n && s[i] >= 48 && s[i] <= 57 {
        let d = (s[i] - 48).toU64()
        if acc > (max - d) / 10 {
            return None
        }
        acc = acc * 10 + d
        digits = digits + 1
        i = i + 1
    }
    for i < n && isSpace(s[i]) {
        i = i + 1
    }
    if digits == 0 || i != n {
        return None
    }
    Some(acc)
}

/// Parses s (surrounding whitespace allowed, the same set `trim` removes) as a base-10 i128 with an optional sign, or None.
pub pure fn parseI128(s: String) -> i128? {
    let n = s.len()
    let mut i: usize = 0
    for i < n && isSpace(s[i]) {
        i = i + 1
    }
    let mut negative = false
    if i < n && (s[i] == 43 || s[i] == 45) {
        negative = s[i] == 45
        i = i + 1
    }
    let min: i128 = -170141183460469231731687303715884105727 - 1
    let mut acc: i128 = 0
    let mut digits = 0
    for i < n && s[i] >= 48 && s[i] <= 57 {
        let d = (s[i] - 48).toI128()
        if acc < (min + d) / 10 {
            return None
        }
        acc = acc * 10 - d
        digits = digits + 1
        i = i + 1
    }
    for i < n && isSpace(s[i]) {
        i = i + 1
    }
    if digits == 0 || i != n {
        return None
    }
    if negative {
        return Some(acc)
    }
    if acc == min {
        return None
    }
    Some(-acc)
}

/// Parses s (surrounding whitespace allowed, the same set `trim` removes) as a base-10 unsigned integer with an optional leading `+`, or None. The full u128 range.
pub pure fn parseU128(s: String) -> u128? {
    let n = s.len()
    let mut i: usize = 0
    for i < n && isSpace(s[i]) {
        i = i + 1
    }
    if i < n && s[i] == 43 {
        i = i + 1
    }
    let max: u128 = 340282366920938463463374607431768211455
    let mut acc: u128 = 0
    let mut digits = 0
    for i < n && s[i] >= 48 && s[i] <= 57 {
        let d = (s[i] - 48).toU128()
        if acc > (max - d) / 10 {
            return None
        }
        acc = acc * 10 + d
        digits = digits + 1
        i = i + 1
    }
    for i < n && isSpace(s[i]) {
        i = i + 1
    }
    if digits == 0 || i != n {
        return None
    }
    Some(acc)
}

/// String holding just c.
pub pure fn fromChar(c: Char) -> String

/// Bytes start..end of s as a string; None unless both offsets are within s and on character boundaries.
pub pure fn slice(s: String, start: usize, end: usize) -> String? {
    s.sliceBytes(start, end)
}

/// Same as slice, or AllocError when the allocator refuses (slice panics instead).
pub pure fn trySlice(s: String, start: usize, end: usize) -> Result[String?, AllocError] {
    s.trySliceBytes(start, end)
}

/// s with every occurrence of old replaced by new; an empty old leaves s unchanged.
pub pure fn replace(s: String, old: String, new: String) -> String {
    tryReplace(s, old, new) || panic("out of memory")
}

/// Same as replace, or AllocError when the allocator refuses (replace panics instead).
pub pure fn tryReplace(s: String, old: String, new: String) -> Result[String, AllocError]

/// Byte offset of the first `sub` in `s`, or None. The empty `sub` is at 0.
/// Offsets are byte offsets, the same as `slice` takes.
///
/// Why not an `indexOf` overload: the engines key their accelerators by
/// package and name, so an overload of an accelerated function reaches the
/// wrong implementation (`internal/interp/call_dispatch.go` builtinKey).
pub pure fn find(s: String, sub: String) -> usize? {
    s.toBytes().indexOf(sub.toBytes())
}

/// Byte offset of the last `sub` in `s`, or None. The empty `sub` is at `s.len()`.
pub pure fn rfind(s: String, sub: String) -> usize? {
    s.toBytes().lastIndexOf(sub.toBytes())
}

/// Whether `a` and `b` are equal ignoring the case of ASCII letters. Bytes
/// outside `A-Za-z` must match exactly, so this is not Unicode case folding.
/// HTTP field names compare this way, per RFC 9110.
pub pure noalloc fn equalFold(a: String, b: String) -> Bool {
    if a.len() != b.len() {
        return false
    }
    let mut i: usize = 0
    for i < a.len() {
        if foldAscii(a[i]) != foldAscii(b[i]) {
            return false
        }
        i = i + 1
    }
    true
}

pure noalloc fn foldAscii(b: u8) -> u8 {
    if b >= 65 && b <= 90 {
        b + 32
    } else {
        b
    }
}

/// `s` without a leading `prefix`; `s` unchanged when it does not start with one.
pub pure fn trimPrefix(s: String, prefix: String) -> String {
    tryTrimPrefix(s, prefix) || panic("out of memory")
}

/// Same as trimPrefix, or AllocError when the allocator refuses (trimPrefix panics instead).
pub pure fn tryTrimPrefix(s: String, prefix: String) -> Result[String, AllocError]

/// `s` without a trailing `suffix`; `s` unchanged when it does not end with one.
pub pure fn trimSuffix(s: String, suffix: String) -> String {
    tryTrimSuffix(s, suffix) || panic("out of memory")
}

/// Same as trimSuffix, or AllocError when the allocator refuses (trimSuffix panics instead).
pub pure fn tryTrimSuffix(s: String, suffix: String) -> Result[String, AllocError]

/// `s` as an unsigned integer in `base` (2 to 36, letters either case), or None
/// when it is empty, has a stray character, or does not fit in a u64.
/// Surrounding whitespace is allowed, the same set `trim` removes; a sign is not.
pub pure fn parseUint(s: String, base: usize) -> u64? {
    if base < 2 || base > 36 {
        return None
    }
    let t = s.trim()
    if t.len() == 0 {
        return None
    }
    let radix = base.toU64()
    let mut v: u64 = 0
    let mut i: usize = 0
    for i < t.len() {
        let d = digitValue(t[i])
        if d >= base {
            return None
        }
        let next = v.wrappingMul(radix).wrappingAdd(d.toU64())
        // Overflow shows up as a value that no longer divides back.
        if v != 0 && next / radix != v {
            return None
        }
        if v == 0 && next < d.toU64() {
            return None
        }
        v = next
        i = i + 1
    }
    Some(v)
}

/// 36 for anything that is not a digit or an ASCII letter, so a caller comparing
/// against its base rejects it.
pure noalloc fn digitValue(c: u8) -> usize {
    let v = c.toUsize()
    if v >= 48 && v <= 57 {
        v - 48
    } else if v >= 97 && v <= 122 {
        v - 87
    } else if v >= 65 && v <= 90 {
        v - 55
    } else {
        36
    }
}

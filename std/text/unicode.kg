// Extended grapheme cluster boundaries, UAX #29 with the Indic conjunct rule
// (GB9c, Unicode 18). Properties come from the generated tables in unicode_tables.kg.
/// What the scan remembers between scalars.
type Scan = {
    prev Class
    // Regional indicators seen in a row, so a flag pair joins but a third
    // indicator starts a new cluster (GB12/GB13).
    riRun Int
    // The run so far is `Pict Extend*`, which is what GB11 joins across a ZWJ.
    pictChain Bool
    // A ZWJ closed a `Pict Extend*` run, so the next Pict joins it.
    zwjAfterPict Bool
    // The run so far is `Linker Extend*`, which GB9c joins to a following consonant.
    linker Bool
}

pure noalloc fn start() -> Scan {
    Scan {
        prev: Class.Other
        riRun: 0
        pictChain: false
        zwjAfterPict: false
        linker: false
    }
}

/// Whether a boundary falls between `at.prev` and `next`.
pure noalloc fn breaks(at: &Scan, next: Prop) -> Bool {
    // GB3: CR LF never splits.
    if at.prev is Class.Cr && next.class is Class.Lf {
        return false
    }
    // GB4 / GB5: controls stand alone.
    if isBreakClass(at.prev) || isBreakClass(next.class) {
        return true
    }
    // GB9 / GB9a: marks and ZWJ attach to whatever precedes them.
    if next.class is Class.Extend || next.class is Class.Zwj || next.class is Class.SpacingMark {
        return false
    }
    // GB9b: a prepended mark attaches to what follows.
    if at.prev is Class.Prepend {
        return false
    }
    // GB9c: Linker Extend* x Consonant.
    if at.linker && next.incb is Incb.IncbConsonant {
        return false
    }
    // GB11: emoji joined by ZWJ stay one cluster.
    if at.zwjAfterPict && next.class is Class.Pict {
        return false
    }
    // GB12 / GB13: indicators pair up.
    if at.prev is Class.Ri && next.class is Class.Ri {
        return at.riRun % 2 == 0
    }
    !hangulJoins(at.prev, next.class)
}

pure noalloc fn isBreakClass(c: Class) -> Bool {
    c is Class.Control || c is Class.Cr || c is Class.Lf
}

/// GB6 / GB7 / GB8.
pure noalloc fn hangulJoins(prev: Class, next: Class) -> Bool {
    match prev {
        HangL -> next is Class.HangL
            || next is Class.HangV
            || next is Class.HangLv
            || next is Class.HangLvt
        HangV -> next is Class.HangV || next is Class.HangT
        HangLv -> next is Class.HangV || next is Class.HangT
        HangT -> next is Class.HangT
        HangLvt -> next is Class.HangT
        _ -> false
    }
}

pure noalloc fn nextLinker(prev: &Scan, incb: Incb) -> Bool {
    match incb {
        IncbLinker -> true
        IncbExtend -> prev.linker
        _ -> false
    }
}

pure noalloc fn advance(at: &Scan, next: Prop, joined: Bool) -> Scan {
    let run = if next.class is Class.Ri {
        if joined {
            at.riRun + 1
        } else {
            1
        }
    } else {
        0
    }
    let chain = if next.class is Class.Pict {
        true
    } else if next.class is Class.Extend {
        joined && at.pictChain
    } else {
        false
    }
    let zwj = if next.class is Class.Zwj {
        joined && at.pictChain
    } else {
        false
    }
    Scan {
        prev: next.class
        riRun: run
        pictChain: chain
        zwjAfterPict: zwj
        linker: nextLinker(at, next.incb)
    }
}

/// Splits s into extended grapheme clusters. The clusters concatenate back to s.
pub pure fn graphemes(s: String) -> Array[String] {
    tryGraphemes(s) || panic("out of memory")
}

/// Same as graphemes, or AllocError when the allocator refuses (graphemes panics instead).
pub pure fn tryGraphemes(s: String) -> Result[Array[String], AllocError] {
    let mut out = Array.tryWithCapacity[String](s.len())?
    let mut cur = StringBuilder.tryNew()?
    let mut at = start()
    let mut first = true
    for c in s.tryChars()? {
        let next = propOf(c.toInt())
        let cut = !first && breaks(&at, next)
        if cut {
            let piece = finishCluster(cur)?
            out.tryPush(piece)?
            cur = StringBuilder.tryNew()?
        }
        let p = c.toInt()
        if p < 0x80 {
            cur.tryPushByte((p & 0x7f).toU8() || 0)?
        } else if p < 0x800 {
            cur.tryPushByte((0xc0 | (p >> 6)).toU8() || 0)?
            cur.tryPushByte((0x80 | (p & 0x3f)).toU8() || 0)?
        } else if p < 0x10000 {
            cur.tryPushByte((0xe0 | (p >> 12)).toU8() || 0)?
            cur.tryPushByte((0x80 | ((p >> 6) & 0x3f)).toU8() || 0)?
            cur.tryPushByte((0x80 | (p & 0x3f)).toU8() || 0)?
        } else {
            cur.tryPushByte((0xf0 | (p >> 18)).toU8() || 0)?
            cur.tryPushByte((0x80 | ((p >> 12) & 0x3f)).toU8() || 0)?
            cur.tryPushByte((0x80 | ((p >> 6) & 0x3f)).toU8() || 0)?
            cur.tryPushByte((0x80 | (p & 0x3f)).toU8() || 0)?
        }
        at = advance(&at, next, !cut && !first)
        first = false
    }
    if !first {
        let piece = finishCluster(cur)?
        out.tryPush(piece)?
    }
    AllocError.wrap(out)
}

// A cluster is built from whole scalars, so a freeze failure is an allocator refusal, not bad UTF-8.
pure fn finishCluster(b: StringBuilder) -> Result[String, AllocError] {
    match b.tryFreeze() {
        Ok(s) -> Ok(s)
        Err(_) -> Err(AllocError.OutOfMemory)
    }
}

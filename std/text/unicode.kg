// Extended grapheme cluster boundaries, UAX #29 with the Indic conjunct rule
// (GB9c). Properties come from the generated tables in tables.kg.
/// The Grapheme_Cluster_Break property of one scalar, with Extended_Pictographic
/// as its own value.
type Class =
    | Other
    | Cr
    | Lf
    | Control
    | Extend
    | Zwj
    | Ri
    | Prepend
    | SpacingMark
    | HangL
    | HangV
    | HangT
    | HangLv
    | HangLvt
    | Pict

/// Indic_Conjunct_Break of one scalar.
type Incb =
    | NoIncb
    | IncbConsonant
    | IncbLinker
    | IncbExtend

type Prop = {
    class Class
    incb Incb
}

pure noalloc fn classFromCode(code: Int) -> Class {
    match code {
        1 -> Class.Cr
        2 -> Class.Lf
        3 -> Class.Control
        4 -> Class.Extend
        5 -> Class.Zwj
        6 -> Class.Ri
        7 -> Class.Prepend
        8 -> Class.SpacingMark
        9 -> Class.HangL
        10 -> Class.HangV
        11 -> Class.HangT
        12 -> Class.Pict
        _ -> Class.Other
    }
}

pure noalloc fn incbFromCode(code: Int) -> Incb {
    match code {
        1 -> Incb.IncbConsonant
        2 -> Incb.IncbLinker
        3 -> Incb.IncbExtend
        _ -> Incb.NoIncb
    }
}

pure noalloc fn propOf(p: Int) -> Prop {
    if p >= 0x20 && p < 0x7f {
        return Prop {
            class: Class.Other
            incb: Incb.NoIncb
        }
    }
    if p >= 0xac00 && p <= 0xd7a3 {
        return Prop {
            class: hangulSyllable(p)
            incb: Incb.NoIncb
        }
    }
    let at = valueOffset(&graphemeIndex, &graphemeBlocks, 2, p)
    Prop {
        class: classFromCode(digitAt(&graphemeBlocks, at))
        incb: incbFromCode(digitAt(&graphemeBlocks, at + 1))
    }
}

/// A precomposed syllable is LV when it has no trailing jamo, LVT otherwise.
pure noalloc fn hangulSyllable(p: Int) -> Class {
    if (p - 0xac00) % 28 == 0 {
        Class.HangLv
    } else {
        Class.HangLvt
    }
}

/// What the scan remembers between scalars.
type Scan = {
    prev Class
    // Regional indicators seen in a row, so a flag pair joins but a third
    // indicator starts a new cluster (GB12/GB13).
    riRun Int
    // The run so far is `Pict Extend*`, which is what GB11 joins across a ZWJ.
    pictChain Bool
    // A ZWJ closed a `Pict Extend*` run, so the next Pict joins it.
    zwjAfterPict Bool
    // A consonant has been seen in this cluster (GB9c's left edge).
    consonant Bool
    // A linker followed that consonant, possibly with Extend/Linker between.
    linker Bool
}

pure noalloc fn start() -> Scan {
    Scan {
        prev: Class.Other
        riRun: 0
        pictChain: false
        zwjAfterPict: false
        consonant: false
        linker: false
    }
}

/// Whether a boundary falls between `at.prev` and `next`.
pure noalloc fn breaks(at: &Scan, next: Prop) -> Bool {
    // GB3: CR LF never splits.
    if at.prev is Class.Cr && next.class is Class.Lf {
        return false
    }
    // GB4 / GB5: controls stand alone.
    if isBreakClass(at.prev) || isBreakClass(next.class) {
        return true
    }
    // GB9 / GB9a: marks and ZWJ attach to whatever precedes them.
    if next.class is Class.Extend || next.class is Class.Zwj || next.class is Class.SpacingMark {
        return false
    }
    // GB9b: a prepended mark attaches to what follows.
    if at.prev is Class.Prepend {
        return false
    }
    // GB9c: Consonant [Extend Linker]* Linker [Extend Linker]* x Consonant.
    if at.linker && next.incb is Incb.IncbConsonant {
        return false
    }
    // GB11: emoji joined by ZWJ stay one cluster.
    if at.zwjAfterPict && next.class is Class.Pict {
        return false
    }
    // GB12 / GB13: indicators pair up.
    if at.prev is Class.Ri && next.class is Class.Ri {
        return at.riRun % 2 == 0
    }
    !hangulJoins(at.prev, next.class)
}

pure noalloc fn isBreakClass(c: Class) -> Bool {
    c is Class.Control || c is Class.Cr || c is Class.Lf
}

/// GB6 / GB7 / GB8.
pure noalloc fn hangulJoins(prev: Class, next: Class) -> Bool {
    match prev {
        HangL -> next is Class.HangL
            || next is Class.HangV
            || next is Class.HangLv
            || next is Class.HangLvt
        HangV -> next is Class.HangV || next is Class.HangT
        HangLv -> next is Class.HangV || next is Class.HangT
        HangT -> next is Class.HangT
        HangLvt -> next is Class.HangT
        _ -> false
    }
}

// nextIncb advances the GB9c left-edge state. A link at a boundary does not
// count, so a cluster that starts with a linker never joins a following consonant.
pure noalloc fn nextIncb(prev: &Scan, incb: Incb, joined: Bool) -> (Bool, Bool) {
    match incb {
        IncbConsonant -> (true, false)
        IncbLinker -> (prev.consonant, joined && prev.consonant)
        IncbExtend -> (prev.consonant, prev.linker)
        _ -> (false, false)
    }
}

pure noalloc fn advance(at: &Scan, next: Prop, joined: Bool) -> Scan {
    let run = if next.class is Class.Ri {
        if joined {
            at.riRun + 1
        } else {
            1
        }
    } else {
        0
    }
    let chain = if next.class is Class.Pict {
        true
    } else if next.class is Class.Extend {
        joined && at.pictChain
    } else {
        false
    }
    let zwj = if next.class is Class.Zwj {
        joined && at.pictChain
    } else {
        false
    }
    let (incbConsonant, incbLinker) = nextIncb(at, next.incb, joined)
    Scan {
        prev: next.class
        riRun: run
        pictChain: chain
        zwjAfterPict: zwj
        consonant: incbConsonant
        linker: incbLinker
    }
}

/// Splits s into extended grapheme clusters. The clusters concatenate back to s.
pub pure fn graphemes(s: String) -> Array[String] {
    tryGraphemes(s) || panic("out of memory")
}

/// Same as graphemes, or AllocError when the allocator refuses (graphemes panics instead).
pub pure fn tryGraphemes(s: String) -> Result[Array[String], AllocError] {
    let mut out = Array.tryWithCapacity[String](s.len())?
    let mut cur = StringBuilder.tryNew()?
    let mut at = start()
    let mut first = true
    for c in s.chars() {
        let next = propOf(c.toInt())
        let cut = !first && breaks(&at, next)
        if cut {
            let piece = finishCluster(cur)?
            out.tryPush(piece)?
            cur = StringBuilder.tryNew()?
        }
        cur.tryPush(fromChar(c))?
        at = advance(&at, next, !cut && !first)
        first = false
    }
    if !first {
        let piece = finishCluster(cur)?
        out.tryPush(piece)?
    }
    AllocError.wrap(out)
}

// A cluster is built from whole scalars, so a freeze failure is an allocator refusal, not bad UTF-8.
pure fn finishCluster(b: StringBuilder) -> Result[String, AllocError] {
    match b.tryFreeze() {
        Ok(s) -> Ok(s)
        Err(_) -> Err(AllocError.OutOfMemory)
    }
}

/// Cells one cluster occupies. The first scalar that takes a cell decides, so a
/// Prepend mark in front of a letter does not hide it. A flag pair is two cells
/// even though a lone indicator is one.
pub pure fn clusterWidth(cluster: String) -> Int {
    let cs = cluster.chars()
    if isRegionalPair(&cs) {
        return 2
    }
    let mut first: Int = 0
    let mut emoji = false
    for c in cs {
        if c.toInt() == 0xfe0f {
            emoji = true
        }
        if first == 0 {
            first = width(c)
        }
    }
    if emoji && first == 1 {
        2
    } else {
        first
    }
}

pure fn isRegionalPair(cs: &Array[Char]) -> Bool {
    if cs.len() != 2 {
        return false
    }
    let a = (cs.get(0) || ' ').toInt()
    let b = (cs.get(1) || ' ').toInt()
    a >= 0x1f1e6 && a <= 0x1f1ff && b >= 0x1f1e6 && b <= 0x1f1ff
}

/// Incremental boundary detection, for callers that walk a string themselves.
/// A terminal string interleaves escape sequences with text, so `graphemes`
/// cannot be used directly on it; feed only the visible scalars here.
pub type Breaker = {
    at Scan
    started Bool
}

/// What `Breaker.step` reports.
pub type Boundary = {
    pub boundary Bool
    pub next Breaker
}

/// A breaker positioned before the first scalar.
pub pure fn breaker() -> Breaker {
    Breaker {
        at: start()
        started: false
    }
}

/// Feeds the next visible scalar. `boundary` is true when a new cluster starts
/// at c, which is always the case for the first scalar.
pub pure fn Breaker.step(self, c: Char) -> Boundary {
    let next = propOf(c.toInt())
    let cut = !self.started || breaks(&self.at, next)
    Boundary {
        boundary: cut
        next: Breaker {
            at: advance(&self.at, next, !cut)
            started: true
        }
    }
}

/// Cells the character occupies, from UCD 18.0.0 (see tables.kg).
///
/// 0 for general category Cc, Mn, Me, Cf, Zl and Zp, for every scalar whose
/// Grapheme_Cluster_Break is Control (which adds the unassigned default
/// ignorables), and for conjoining Hangul vowels and finals. Tab is 0 as well:
/// callers must expand tabs and strip controls before measuring.
/// 2 for East_Asian_Width W and F, 1 for the rest. A scalar that is both
/// zero-width and Wide (U+3099, U+302A..U+302D) is 0.
pub pure noalloc fn width(c: Char) -> Int {
    let p = c.toInt()
    if p >= 0x20 && p < 0x7f {
        return 1
    }
    digitAt(&widthBlocks, valueOffset(&widthIndex, &widthBlocks, 1, p))
}

/// Total display width of the text, measured one grapheme cluster at a time.
/// Per-scalar summing would count a ZWJ emoji sequence several times over.
pub pure fn stringWidth(s: String) -> Int {
    let mut total = 0
    for g in graphemes(s) {
        total = total + clusterWidth(g)
    }
    total
}

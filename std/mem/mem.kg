/// The only compiler-known interior-mutable primitive: holds a T inline with no extra allocation, header, or lock; every accessor needs `unsafe`.
/// Safety: moving an UnsafeCell[T] to another thread only ever moves the T inside, so doing so is sound exactly when T itself is.
@unsafeGuarantee(Send when T: Send)
pub type UnsafeCell[T]

/// Wraps value for interior mutation through shared references.
pub fn UnsafeCell.new[T](value: T) -> UnsafeCell[T]

/// A copy of the content as of this call. The caller rules out a
/// concurrent write through another alias of the same cell.
pub unsafe fn UnsafeCell[T: Copy].get(self) -> T

/// Replaces the content; the old value is dropped. The caller rules out
/// overlapping access through another alias of the same cell for the
/// duration of the call.
pub unsafe fn UnsafeCell[T].set(self, value: T)

/// Zeros the bytes behind region, surviving the optimizer, but not registers, the stack or reused memory;
/// a `let b = a` or by-value copy keeps its own bytes, a copy stored in or read from a container shares them.
pub pure fn secureErase(region: &mut Bytes)

/// Zeros region like secureErase, or AllocError when the allocator refuses
/// (secureErase panics instead; only an unowned region can hit this path).
pub pure fn trySecureErase(region: &mut Bytes) -> Result[Void, AllocError]

/// The memory order of an atomic operation; the argument must be written as one of these variants.
pub type AtomicOrder =
    | Relaxed
    | Acquire
    | Release
    | AcqRel
    | SeqCst

/// Atomically reads the `static mut` named by `place` (`&name`); an integer up to 64 bits or Bool, never Release or AcqRel.
pub noalloc unsafe fn atomicLoad[T](place: &T, order: AtomicOrder) -> T

/// Atomically writes value to the `static mut` named by `place` (`&mut name`); never Acquire or AcqRel.
pub noalloc unsafe fn atomicStore[T](place: &mut T, value: T, order: AtomicOrder)

/// Atomically replaces the `static mut` and returns the value it held.
pub noalloc unsafe fn atomicExchange[T](place: &mut T, value: T, order: AtomicOrder) -> T

/// Writes desired when the `static mut` holds expected; returns the value it held, so the exchange happened exactly when that equals expected. When it fails, the read uses the order without its release part.
pub noalloc unsafe fn atomicCompareExchange[T](place: &mut T, expected: T, desired: T, order: AtomicOrder) -> T

/// Adds value to the `static mut`, wrapping at the type's width, and returns the value it held.
pub noalloc unsafe fn atomicAdd[T](place: &mut T, value: T, order: AtomicOrder) -> T

/// Subtracts value from the `static mut`, wrapping at the type's width, and returns the value it held.
pub noalloc unsafe fn atomicSub[T](place: &mut T, value: T, order: AtomicOrder) -> T

/// Bitwise-ands value into the `static mut` and returns the value it held.
pub noalloc unsafe fn atomicAnd[T](place: &mut T, value: T, order: AtomicOrder) -> T

/// Bitwise-ors value into the `static mut` and returns the value it held.
pub noalloc unsafe fn atomicOr[T](place: &mut T, value: T, order: AtomicOrder) -> T

/// Bitwise-xors value into the `static mut` and returns the value it held.
pub noalloc unsafe fn atomicXor[T](place: &mut T, value: T, order: AtomicOrder) -> T

/// Atomically reads the cell; T is an integer up to 64 bits, Bool or a raw pointer. The cell must not be read or written through `get` / `set` at the same time.
pub unsafe fn UnsafeCell[T].atomicLoad(self, order: AtomicOrder) -> T

/// Atomically replaces the content of the cell.
pub unsafe fn UnsafeCell[T].atomicStore(self, value: T, order: AtomicOrder)

/// Atomically replaces the content and returns the value it held.
pub unsafe fn UnsafeCell[T].atomicExchange(self, value: T, order: AtomicOrder) -> T

/// Writes desired when the cell holds expected; returns the value it held, so the exchange happened exactly when that equals expected.
pub unsafe fn UnsafeCell[T].atomicCompareExchange(self, expected: T, desired: T, order: AtomicOrder) -> T

/// Adds value to the cell, wrapping at the type's width, and returns the value it held; T is an integer.
pub unsafe fn UnsafeCell[T].atomicAdd(self, value: T, order: AtomicOrder) -> T

/// Subtracts value from the cell, wrapping at the type's width, and returns the value it held; T is an integer.
pub unsafe fn UnsafeCell[T].atomicSub(self, value: T, order: AtomicOrder) -> T

/// Bitwise-ands value into the cell and returns the value it held; T is an integer.
pub unsafe fn UnsafeCell[T].atomicAnd(self, value: T, order: AtomicOrder) -> T

/// Bitwise-ors value into the cell and returns the value it held; T is an integer.
pub unsafe fn UnsafeCell[T].atomicOr(self, value: T, order: AtomicOrder) -> T

/// Bitwise-xors value into the cell and returns the value it held; T is an integer.
pub unsafe fn UnsafeCell[T].atomicXor(self, value: T, order: AtomicOrder) -> T

/// Reads the value at p in exactly one access that the optimizer neither drops, merges nor reorders against other volatile accesses; for memory-mapped registers. T is a fixed-width number, Bool, Char or a raw pointer. It orders nothing across threads.
pub noalloc unsafe fn volatileRead[T](p: *const T) -> T

/// Writes value at p in exactly one access like `volatileRead`.
pub noalloc unsafe fn volatileWrite[T](p: *mut T, value: T)

/// Reads the register at a fixed address like `volatileRead`, without forming a pointer; T is an integer up to 64 bits or Bool. It is called directly, never as a function value. The VM has no device memory: it keeps a table of the addresses written so far, and a register nobody wrote reads as zero.
pub noalloc unsafe fn volatileReadAt[T](address: usize) -> T

/// Writes value to the register at a fixed address like `volatileWrite`, without forming a pointer.
pub noalloc unsafe fn volatileWriteAt[T](address: usize, value: T)

/// Storage for one T that may or may not hold a value, with no flag saying which, so every state-dependent operation is `unsafe`.
/// Safety: moving an Uninit[T] to another thread moves at most one T, and sharing it shares at most one T.
@unsafeGuarantee(Send when T: Send, Sync when T: Sync)
pub type Uninit[T]

/// An empty slot. The cell behind it is allocated here, so unlike the operations below this is not `noalloc`.
pub pure fn uninit[T]() -> Uninit[T]

/// Moves value into the slot, which dropping the slot will not drop: empty it with takeInitialized or dropInitialized.
/// The caller rules out the slot already holding a value, which would be lost.
pub pure noalloc unsafe fn initialize[T](slot: &mut Uninit[T], value: T)

/// The value in the slot. The caller rules out an empty slot and any write to it while the borrow lives.
pub pure noalloc unsafe fn borrowInitialized['a, T](slot: &'a Uninit[T]) -> &'a T

/// A copy of the value in the slot. The caller rules out an empty slot.
pure noalloc unsafe fn copyInitialized[T: Copy](slot: &Uninit[T]) -> T

/// The value in the slot, exclusively. The caller rules out an empty slot and any other access while the borrow lives.
pub pure noalloc unsafe fn borrowInitializedMut['a, T](slot: &'a mut Uninit[T]) -> &'a mut T

/// Moves the value out and leaves the slot empty. The caller rules out an empty slot.
pub pure noalloc unsafe fn takeInitialized[T](slot: &mut Uninit[T]) -> T

/// Drops the value and leaves the slot empty. The caller rules out an empty slot.
pub pure noalloc unsafe fn dropInitialized[T](slot: &mut Uninit[T])

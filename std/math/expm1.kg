const overflowThreshold: Float = 709.782712893384
const em1Ln2Hi: Float = 0.6931471803691238
const em1Ln2Lo: Float = 1.9082149292705877e-10
const em1InvLn2: Float = 1.4426950408889634
const q1: Float = -0.03333333333333313
const q2: Float = 0.0015873015872548146
const q3: Float = -7.93650757867488e-05
const q4: Float = 4.008217827329362e-06
const q5: Float = -2.0109921818362437e-07

/// e^x - 1, accurate near zero, where exp(x) - 1 cancels.
pure noalloc fn expm1(x0: Float) -> Float {
    let hx = absHighWord(x0)
    let negative = (toBits(x0) >> 63) == 1
    if hx >= 0x4043687A {
        if isNaN(x0) {
            return x0
        }
        if negative {
            return -1.0
        }
        if x0 > overflowThreshold {
            return x0 * 8.98846567431158e+307
        }
    }
    if hx <= 0x3FD62E42 {
        if hx < 0x3C900000 {
            return x0
        }
        return expm1Reduced(x0, 0.0, 0)
    }
    if hx < 0x3FF0A2B2 {
        if !negative {
            let hi = x0 - em1Ln2Hi
            let x = hi - em1Ln2Lo
            return expm1Reduced(x, (hi - x) - em1Ln2Lo, 1)
        }
        let hi = x0 + em1Ln2Hi
        let lo = -em1Ln2Lo
        let x = hi - lo
        return expm1Reduced(x, (hi - x) - lo, -1)
    }
    let k = (em1InvLn2 * x0 + signed(0.5, negative)).toInt() || 0
    let t = k.toFloat()
    let hi = x0 - t * em1Ln2Hi
    let lo = t * em1Ln2Lo
    let x = hi - lo
    expm1Reduced(x, (hi - x) - lo, k)
}

/// e^(x + c) * 2^k - 1 for |x| <= ln2 / 2, where c is the error of the reduction that produced x.
pure noalloc fn expm1Reduced(x: Float, c: Float, k: Int) -> Float {
    let hfx = 0.5 * x
    let hxs = x * hfx
    let r1 = 1.0 + hxs * (q1 + hxs * (q2 + hxs * (q3 + hxs * (q4 + hxs * q5))))
    let t = 3.0 - r1 * hfx
    let e0 = hxs * ((r1 - t) / (6.0 - x * t))
    if k == 0 {
        return x - (x * e0 - hxs)
    }
    let e = x * (e0 - c) - c - hxs
    if k == -1 {
        return 0.5 * (x - e) - 0.5
    }
    if k == 1 {
        if x < -0.25 {
            return -2.0 * (e - (x + 0.5))
        }
        return 1.0 + 2.0 * (x - e)
    }
    let twopk = fromBits((0x3FF + k).truncate[u64]().wrappingShiftLeft(52))
    if k < 0 || k > 56 {
        let y = x - e + 1.0
        if k == 1024 {
            return y * 2.0 * 8.98846567431158e+307 - 1.0
        }
        return y * twopk - 1.0
    }
    let inverse = fromBits((0x3FF - k).truncate[u64]().wrappingShiftLeft(52))
    if k < 20 {
        return (x - e + (1.0 - inverse)) * twopk
    }
    (x - (e + inverse) + 1.0) * twopk
}

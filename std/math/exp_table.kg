// The table of musl 1.2.5 src/math/exp_data.c, tails as doubles in shortest round-trip form.
// Copyright (c) 2018, Arm Limited. SPDX-License-Identifier: MIT
/// (tail, sbits) where 2^(i/128) is about H * (1 + tail) and sbits is the pattern of H minus i << 45, so adding k << 45
/// for a k with k mod 128 = i gives the pattern of H * 2^(k div 128).
pure noalloc fn expEntry(i: u64) -> (Float, u64) {
    match i.wrappingShiftRight(4) {
        0 -> expEntry0(i & 15)
        1 -> expEntry1(i & 15)
        2 -> expEntry2(i & 15)
        3 -> expEntry3(i & 15)
        4 -> expEntry4(i & 15)
        5 -> expEntry5(i & 15)
        6 -> expEntry6(i & 15)
        _ -> expEntry7(i & 15)
    }
}


/// Square root of x; NaN for negative x.
pub pure noalloc fn sqrt(x: Float) -> Float

/// Largest integral value not greater than x.
pub pure noalloc fn floor(x: Float) -> Float

/// Smallest integral value not less than x.
pub pure noalloc fn ceil(x: Float) -> Float

/// x rounded to the nearest integral value, halfway cases away from zero.
pub pure noalloc fn round(x: Float) -> Float

/// The IEEE 754 binary64 bit pattern of x, NaN sign and payload included. The NaN a Float operator or `sqrt` makes has no
/// fixed sign or payload (hardware and constant folding differ); the other functions here return `nan()` for an
/// undefined result and keep the payload of a NaN argument, x's when two are NaN. A signaling NaN comes back quiet after
/// a Float return on 32-bit x86, whose ABI uses the x87 stack.
pub pure noalloc fn toBits(x: Float) -> u64

/// The Float whose IEEE 754 binary64 bit pattern is bits.
pub pure noalloc fn fromBits(bits: u64) -> Float

/// x truncated toward zero; None for NaN, an infinity or a value outside the Int range.
pub pure noalloc fn toInt(x: Float) -> Int? {
    x.toInt()
}

/// x as a Float (rounded above 2^53).
pub pure noalloc fn toFloat(x: Int) -> Float {
    x.toFloat()
}

/// Absolute value of x.
pub pure noalloc fn abs(x: f32) -> f32 {
    let z: f32 = 0.0
    if x == z {
        z
    } else if x < z {
        -x
    } else {
        x
    }
}

/// Absolute value of x; panics with integer overflow at the minimum representable value.
pub pure noalloc fn abs(x: i128) -> i128 {
    if x < 0 {
        -x
    } else {
        x
    }
}

/// Absolute value of x.
pub pure noalloc fn abs(x: u8) -> u8 {
    x
}

/// Absolute value of x.
pub pure noalloc fn abs(x: u16) -> u16 {
    x
}

/// Absolute value of x.
pub pure noalloc fn abs(x: u32) -> u32 {
    x
}

/// Absolute value of x.
pub pure noalloc fn abs(x: u64) -> u64 {
    x
}

/// The smaller of a and b.
pub pure noalloc fn min(a: Int, b: Int) -> Int {
    if a < b {
        a
    } else {
        b
    }
}

/// The larger of a and b.
pub pure noalloc fn max(a: Int, b: Int) -> Int {
    if a > b {
        a
    } else {
        b
    }
}

/// The smaller of a and b; NaN when either is NaN, and -0.0 when the two are zeros of opposite sign.
pub pure noalloc fn min(a: Float, b: Float) -> Float {
    if a != a {
        a
    } else if b != b {
        b
    } else if a < b {
        a
    } else if b < a {
        b
    } else if 1.0 / a < 0.0 {
        a
    } else {
        b
    }
}

/// The larger of a and b; NaN when either is NaN, and 0.0 when the two are zeros of opposite sign.
pub pure noalloc fn max(a: Float, b: Float) -> Float {
    if a != a {
        a
    } else if b != b {
        b
    } else if a > b {
        a
    } else if b > a {
        b
    } else if 1.0 / a > 0.0 {
        a
    } else {
        b
    }
}

/// x restricted to lo..hi; returns lo if lo > hi.
pub pure noalloc fn clamp(x: Int, lo: Int, hi: Int) -> Int {
    if lo > hi {
        lo
    } else if x < lo {
        lo
    } else if x > hi {
        hi
    } else {
        x
    }
}

/// x restricted to lo..hi; returns lo if lo > hi, and NaN when any argument is NaN.
pub pure noalloc fn clamp(x: Float, lo: Float, hi: Float) -> Float {
    if x != x {
        x
    } else if lo != lo {
        lo
    } else if hi != hi {
        hi
    } else if lo > hi {
        lo
    } else if x < lo {
        lo
    } else if x > hi {
        hi
    } else {
        x
    }
}

/// Absolute value of x; panics with integer overflow at the minimum representable value.
pub pure noalloc fn abs(x: Int) -> Int {
    if x < 0 {
        -x
    } else {
        x
    }
}

/// Absolute value of x.
pub pure noalloc fn abs(x: Float) -> Float {
    if x == 0.0 {
        0.0
    } else if x < 0.0 {
        -x
    } else {
        x
    }
}


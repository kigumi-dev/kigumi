import fmt from std/fmt

/// A point in time taken from the system clock.
pub type Instant = {
    ms i64
}

/// The instant ms milliseconds after 1970-01-01T00:00:00Z.
pub pure noalloc fn fromUnixMillis(ms: i64) -> Instant {
    Instant { ms: ms }
}

/// Milliseconds since 1970-01-01T00:00:00Z.
pub pure noalloc fn Instant.unixMillis(self) -> i64 {
    self.ms
}

/// The instant in UTC as RFC 3339 text with seconds, e.g. `2026-09-06T01:02:03Z`.
pub pure fn Instant.utc(self) -> String {
    let parts = self.parts()
    "${fmt.int(parts.year, 4)}-${fmt.int(parts.month, 2)}-${fmt.int(parts.day, 2)}T${fmt.int(parts.hour, 2)}:${fmt.int(parts.minute, 2)}:${fmt.int(parts.second, 2)}Z"
}

/// The instant as an RFC 9110 IMF-fixdate, e.g. `Sun, 06 Nov 1994 08:49:37 GMT`.
pub pure fn Instant.httpDate(self) -> String {
    let parts = self.parts()
    "${weekdayName(parts.weekday)}, ${fmt.int(parts.day, 2)} ${monthName(parts.month)} ${fmt.int(parts.year, 4)} ${fmt.int(parts.hour, 2)}:${fmt.int(parts.minute, 2)}:${fmt.int(parts.second, 2)} GMT"
}

type Parts = {
    year i64
    month i64
    day i64
    hour i64
    minute i64
    second i64
    // 0 is Sunday.
    weekday i64
}

pure noalloc fn Instant.parts(self) -> Parts {
    let secs = floorDiv(self.ms, 1000)
    let days = floorDiv(secs, 86400)
    let rem = floorMod(secs, 86400)
    let date = civilFromDays(days)
    Parts {
        year: date.year
        month: date.month
        day: date.day
        hour: rem / 3600
        minute: rem % 3600 / 60
        second: rem % 60
        weekday: floorMod(days + 4, 7)
    }
}

type Civil = {
    year i64
    month i64
    day i64
}

// Howard Hinnant's days-to-civil-date algorithm, for days since 1970-01-01.
pure noalloc fn civilFromDays(days: i64) -> Civil {
    let z = days + 719468
    let era = floorDiv(z, 146097)
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let month = if mp < 10 {
        mp + 3
    } else {
        mp - 9
    }
    Civil {
        year: yoe + era * 400 + (if month <= 2 {
            1
        } else {
            0
        })
        month: month
        day: doy - (153 * mp + 2) / 5 + 1
    }
}

// The inverse of civilFromDays; valid for every year a date parser accepts.
pure noalloc fn daysFromCivil(year: i64, month: i64, day: i64) -> i64 {
    let y = year - (if month <= 2 {
        1
    } else {
        0
    })
    let era = floorDiv(y, 400)
    let yoe = y - era * 400
    let mp = month + (if month > 2 {
        -3
    } else {
        9
    })
    let doy = (153 * mp + 2) / 5 + day - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468
}

pure noalloc fn floorDiv(a: i64, b: i64) -> i64 {
    let q = a / b
    if a % b < 0 {
        q - 1
    } else {
        q
    }
}

pure noalloc fn floorMod(a: i64, b: i64) -> i64 {
    let r = a % b
    if r < 0 {
        r + b
    } else {
        r
    }
}

pure noalloc fn leapYear(year: i64) -> Bool {
    year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

pure noalloc fn daysInMonth(year: i64, month: i64) -> i64 {
    match month {
        1 -> 31
        2 -> if leapYear(year) {
            29
        } else {
            28
        }
        3 -> 31
        4 -> 30
        5 -> 31
        6 -> 30
        7 -> 31
        8 -> 31
        9 -> 30
        10 -> 31
        11 -> 30
        12 -> 31
        _ -> 0
    }
}

pure noalloc fn monthName(month: i64) -> String {
    match month {
        1 -> "Jan"
        2 -> "Feb"
        3 -> "Mar"
        4 -> "Apr"
        5 -> "May"
        6 -> "Jun"
        7 -> "Jul"
        8 -> "Aug"
        9 -> "Sep"
        10 -> "Oct"
        11 -> "Nov"
        12 -> "Dec"
        _ -> "???"
    }
}

pure noalloc fn weekdayName(day: i64) -> String {
    match day {
        0 -> "Sun"
        1 -> "Mon"
        2 -> "Tue"
        3 -> "Wed"
        4 -> "Thu"
        5 -> "Fri"
        6 -> "Sat"
        _ -> "???"
    }
}

pure noalloc fn monthFromName(name: String) -> i64? {
    match name {
        "Jan" -> Some(1)
        "Feb" -> Some(2)
        "Mar" -> Some(3)
        "Apr" -> Some(4)
        "May" -> Some(5)
        "Jun" -> Some(6)
        "Jul" -> Some(7)
        "Aug" -> Some(8)
        "Sep" -> Some(9)
        "Oct" -> Some(10)
        "Nov" -> Some(11)
        "Dec" -> Some(12)
        _ -> None
    }
}

/// Parses an RFC 9110 HTTP-date in any form recipients must accept:
/// IMF-fixdate, RFC 850 and asctime. None for an invalid date or another zone.
pub pure fn parseDate(s: String) -> Instant? {
    if s.len() == 29 && byteAt(s, 3) == 44 && byteAt(s, 4) == 32 {
        return parseImf(s)
    }
    if s.len() == 24 && byteAt(s, 3) == 32 {
        return parseAsctime(s)
    }
    parseRfc850(s)
}

// Sun, 06 Nov 1994 08:49:37 GMT
pure fn parseImf(s: String) -> Instant? {
    if !commaSpaced(s, 3) {
        return None
    }
    let gmt = s.sliceBytes(25, 29) || return None
    if gmt != " GMT" {
        return None
    }
    let day = digits(s, 5, 2) || return None
    let monthText = s.sliceBytes(8, 11) || return None
    let month = monthFromName(monthText) || return None
    let year = digits(s, 12, 4) || return None
    let hour = digits(s, 17, 2) || return None
    let minute = digits(s, 20, 2) || return None
    let second = digits(s, 23, 2) || return None
    buildInstant(year, month, day, hour, minute, second)
}

// Sunday, 06-Nov-94 08:49:37 GMT
pure fn parseRfc850(s: String) -> Instant? {
    let comma = indexOfByte(s, 44) || return None
    if !commaSpaced(s, comma) || s.len() != comma + 24 {
        return None
    }
    if byteAt(s, comma + 4) != 45 || byteAt(s, comma + 8) != 45 || byteAt(s, comma + 11) != 32 || byteAt(s, comma + 14) != 58 || byteAt(s, comma + 17) != 58 {
        return None
    }
    let day = digits(s, comma + 2, 2) || return None
    let monthText = s.sliceBytes(comma + 5, comma + 8) || return None
    let month = monthFromName(monthText) || return None
    let yy = digits(s, comma + 9, 2) || return None
    let year = if yy < 70 {
        2000 + yy
    } else {
        1900 + yy
    }
    let hour = digits(s, comma + 12, 2) || return None
    let minute = digits(s, comma + 15, 2) || return None
    let second = digits(s, comma + 18, 2) || return None
    let gmt = s.sliceBytes(comma + 20, comma + 24) || return None
    if gmt != " GMT" {
        return None
    }
    buildInstant(year, month, day, hour, minute, second)
}

// Sun Nov  6 08:49:37 1994
pure fn parseAsctime(s: String) -> Instant? {
    if byteAt(s, 3) != 32 || byteAt(s, 7) != 32 || byteAt(s, 10) != 32 || byteAt(s, 13) != 58 || byteAt(s, 16) != 58 || byteAt(s, 19) != 32 {
        return None
    }
    let monthText = s.sliceBytes(4, 7) || return None
    let month = monthFromName(monthText) || return None
    let day = if byteAt(s, 8) == 32 {
        digits(s, 9, 1) || return None
    } else {
        digits(s, 8, 2) || return None
    }
    let hour = digits(s, 11, 2) || return None
    let minute = digits(s, 14, 2) || return None
    let second = digits(s, 17, 2) || return None
    let year = digits(s, 20, 4) || return None
    buildInstant(year, month, day, hour, minute, second)
}

pure noalloc fn buildInstant(year: i64, month: i64, day: i64, hour: i64, minute: i64, second: i64) -> Instant? {
    if month < 1 || month > 12 || day < 1 || day > daysInMonth(year, month) || hour > 23 || minute > 59 || second > 59 {
        return None
    }
    let days = daysFromCivil(year, month, day)
    Some(fromUnixMillis(((days * 24 + hour) * 60 + minute) * 60000 + second * 1000))
}

pure noalloc fn digits(s: String, at: usize, n: usize) -> i64? {
    if at + n > s.len() {
        return None
    }
    let mut value: i64 = 0
    for i in at..(at + n) {
        let d = s[i].toInt() - 48
        if d < 0 || d > 9 {
            return None
        }
        value = value * 10 + d
    }
    Some(value)
}

pure noalloc fn byteAt(s: String, at: usize) -> u8 {
    if at >= s.len() {
        0
    } else {
        s[at]
    }
}

pure noalloc fn indexOfByte(s: String, b: u8) -> usize? {
    for i in 0..s.len() {
        if s[i] == b {
            return Some(i)
        }
    }
    None
}

pure noalloc fn commaSpaced(s: String, comma: usize) -> Bool {
    comma + 1 < s.len() && byteAt(s, comma + 1) == 32
}

/// Milliseconds elapsed since this instant was taken.
pub fn Instant.elapsedMillis(self) -> i64 {
    saturatingSubMillis(now().unixMillis(), self.unixMillis())
}

// Saturates instead of trapping for readings near the ends of the i64 range.
fn saturatingSubMillis(current: i64, then: i64) -> i64 {
    let max = 9223372036854775807
    if then < 0 && current > max + then {
        return max
    }
    if then > 0 && current < -max - 1 + then {
        return -max - 1
    }
    current - then
}

/// A reading from a clock that only ever moves forward, unaffected by
/// clock adjustments (e.g. NTP). Unlike `Instant`, it carries no wall-clock
/// meaning; use it for ticks, timeouts and animation frame timing.
pub type Monotonic = {
    ticks i64
}

/// Milliseconds between two monotonic readings (self minus earlier).
pub pure noalloc fn Monotonic.diffMillis(self, earlier: Monotonic) -> i64 {
    saturatingSubMillis(self.ticks, earlier.ticks)
}

/// Milliseconds elapsed since this reading was taken.
pub fn Monotonic.elapsedMillis(self) -> i64 {
    monotonic().diffMillis(self)
}

/// A span of time in milliseconds.
pub type Duration = {
    ms i64
}

/// A span of ms milliseconds.
pub pure noalloc fn Duration.fromMillis(ms: i64) -> Duration {
    Duration { ms: ms }
}

/// A span of seconds, saturating at the ends of the i64 range.
pub pure fn Duration.fromSeconds(seconds: i64) -> Duration {
    Duration { ms: seconds.saturatingMul(1000) }
}

/// This span in milliseconds.
pub pure noalloc fn Duration.millis(self) -> i64 {
    self.ms
}

/// This span in whole seconds, truncated toward zero.
pub pure noalloc fn Duration.seconds(self) -> i64 {
    self.ms / 1000
}

/// The sum of two spans, saturating at the ends of the i64 range.
pub pure fn Duration.add(self, other: Duration) -> Duration {
    Duration { ms: self.ms.saturatingAdd(other.ms) }
}

/// Clock access as an explicit capability value from `host.clock()`.
/// Safety: holds no state; every reading is independent, so sharing or duplicating it is free.
pub type SystemClock = {
    // A unit marker; the capability has no mutable state.
    present Bool
}

/// A clock capability over the host's wall and monotonic clocks.
pub pure noalloc fn SystemClock.new() -> SystemClock {
    SystemClock { present: true }
}

/// The current time, like `now`.
pub fn SystemClock.now(self) -> Instant {
    now()
}

/// The current monotonic reading, like `monotonic`.
pub fn SystemClock.monotonic(self) -> Monotonic {
    monotonic()
}

import ffi from std/ffi

// POSIX struct timespec is time_t + long; both are pointer-sized on Linux and
// macOS, unlike i64, which the 32-bit Linux C ABI would truncate.
type Timespec layout(C) = {
    pub sec isize
    pub nsec isize
}

extern(C) {
    fn clock_gettime(clock: i32, ts: *mut Timespec) -> i32
    fn nanosleep(req: *const Timespec, rem: *mut Timespec) -> i32
}

/// The current time.
pub fn now() -> Instant {
    let cv = ffi.CValue.new(Timespec {
        sec: 0
        nsec: 0
    })
    _ = unsafe {
        clock_gettime(0, cv.ptr())
    }
    let ts = cv.get()
    Instant { ms: ts.sec.toInt() * 1000 + ts.nsec.toInt() / 1000000 }
}

/// The current reading of the monotonic clock (`CLOCK_MONOTONIC`).
pub fn monotonic() -> Monotonic {
    let cv = ffi.CValue.new(Timespec {
        sec: 0
        nsec: 0
    })
    _ = unsafe {
        clock_gettime(1, cv.ptr())
    }
    let ts = cv.get()
    Monotonic { ticks: ts.sec.toInt() * 1000 + ts.nsec.toInt() / 1000000 }
}

/// Pauses the current thread for millis milliseconds.
pub fn sleep(millis: i64) {
    if millis <= 0 {
        return
    }
    let cv = ffi.CValue.new(Timespec {
        sec: (millis / 1000).toIsize()
        nsec: (millis % 1000 * 1000000).toIsize()
    })
    _ = unsafe {
        nanosleep(ffi.toConst(cv.ptr()), ffi.toMut(ffi.null[Timespec]()))
    }
}

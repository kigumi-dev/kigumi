import ffi from std/ffi
import platform from std/platform

// POSIX struct timespec is time_t + long; both are pointer-sized on Linux and
// macOS, unlike i64, which the 32-bit Linux C ABI would truncate.
type Timespec layout(C) = {
    pub sec isize
    pub nsec isize
}

extern(C) {
    fn clock_gettime(clock: i32, ts: *mut Timespec) -> i32
    fn nanosleep(req: *const Timespec, rem: *mut Timespec) -> i32
}

/// The current time.
pub fn now() -> Instant {
    let cv = ffi.CValue.new(Timespec {
        sec: 0
        nsec: 0
    })
    let rc = unsafe {
        clock_gettime(0, cv.ptr())
    }
    if rc != 0 {
        panic("clock_gettime failed")
    }
    let ts = cv.get()
    Instant { ms: ts.sec.toInt() * 1000 + ts.nsec.toInt() / 1000000 }
}

/// The current reading of the monotonic clock (`CLOCK_MONOTONIC`).
pub fn monotonic() -> Monotonic {
    let cv = ffi.CValue.new(Timespec {
        sec: 0
        nsec: 0
    })
    let rc = unsafe {
        clock_gettime(1, cv.ptr())
    }
    if rc != 0 {
        panic("clock_gettime failed")
    }
    let ts = cv.get()
    Monotonic { ticks: ts.sec.toInt() * 1000 + ts.nsec.toInt() / 1000000 }
}

fn monotonicNanos() -> i64 {
    let cv = ffi.CValue.new(Timespec {
        sec: 0
        nsec: 0
    })
    let rc = unsafe {
        clock_gettime(1, cv.ptr())
    }
    if rc != 0 {
        panic("clock_gettime failed")
    }
    let ts = cv.get()
    ts.sec.toInt() * 1000000000 + ts.nsec.toInt()
}

/// Pauses the current thread for millis milliseconds; a signal handler running meanwhile does not shorten the pause.
pub fn sleep(millis: i64) {
    if millis <= 0 {
        return
    }
    let start = monotonicNanos()
    let req = ffi.CValue.new(Timespec {
        sec: (millis / 1000).toIsize()
        nsec: (millis % 1000 * 1000000).toIsize()
    })
    let mut waiting = true
    for waiting {
        let rc = unsafe {
            nanosleep(ffi.toConst(req.ptr()), ffi.toMut(ffi.null[Timespec]()))
        }
        if rc == 0 || ffi.errno() != platform.eintr() {
            waiting = false
        } else {
            let left = millis - (monotonicNanos() - start) / 1000000
            if left <= 0 {
                waiting = false
            } else {
                req.set(&Timespec {
                    sec: (left / 1000).toIsize()
                    nsec: (left % 1000 * 1000000).toIsize()
                })
            }
        }
    }
}

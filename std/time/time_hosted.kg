import ffi from std/ffi
import platform from std/platform

// Reads clock into a timespec, panicking when the C library refuses it; every
// caller has no better answer than a panic.
fn readClock(clock: i32) -> platform.Timespec {
    let cv = ffi.CValue.new(platform.Timespec {
        sec: 0
        nsec: 0
        pad: 0
    })
    let err = platform.clockGettime(clock, cv.ptr())
    if err != 0 {
        panic("clock_gettime failed")
    }
    cv.get()
}

/// The current time.
pub fn now() -> Instant {
    let ts = readClock(platform.clockRealtime())
    Instant { ms: ts.sec * 1000 + ts.nsec.toInt() / 1000000 }
}

/// The current reading of the monotonic clock.
pub fn monotonic() -> Monotonic {
    let ts = readClock(platform.clockMonotonic())
    Monotonic { ticks: ts.sec * 1000 + ts.nsec.toInt() / 1000000 }
}

fn monotonicNanos() -> i64 {
    let ts = readClock(platform.clockMonotonic())
    ts.sec * 1000000000 + ts.nsec.toInt()
}

/// Pauses the current thread for millis milliseconds; a signal handler running meanwhile does not shorten the pause.
pub fn sleep(millis: i64) {
    if millis <= 0 {
        return
    }
    let start = monotonicNanos()
    let req = ffi.CValue.new(platform.Timespec {
        sec: millis / 1000
        nsec: (millis % 1000 * 1000000).toI32() || 0
        pad: 0
    })
    let mut waiting = true
    for waiting {
        let rem = unsafe {
            ffi.toMut(ffi.null[platform.Timespec]())
        }
        let err = platform.nanosleep(ffi.toConst(req.ptr()), rem)
        if err == 0 {
            waiting = false
        } else if err != platform.eintr() {
            panic("nanosleep failed")
        } else {
            let left = millis - (monotonicNanos() - start) / 1000000
            if left <= 0 {
                waiting = false
            } else {
                req.set(&platform.Timespec {
                    sec: left / 1000
                    nsec: (left % 1000 * 1000000).toI32() || 0
                    pad: 0
                })
            }
        }
    }
}

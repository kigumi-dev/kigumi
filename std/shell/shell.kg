/// Ability to run external commands, obtained from `host.shell()`.
/// Safety: a stateless capability marker; every command it runs is independent, so sharing or duplicating it is free.
@unsafeGuarantee(Copy, Send, Sync)
pub type Shell

/// One piece of a plan; a `$"..."` literal pushes them in source order.
pub type Item =
    | Text(String)
    | Word
    | Pipe
    | Redirect(Int, Int)
    | Builtin(Filter)

/// An in-process stage that transforms its input without running a program:
/// the typed plans `std/shell/coreutil` builds. Payloads are kept primitive so
/// this stage format can stay in `std/shell` while coreutil moves out.
/// Payload order: `Wc` is lines/words/bytes/chars, `Sort` reverse/unique,
/// `Uniq` count/repeated/unique, `Cut` delimiter/1-based fields, `Tr`
/// from/to/squeeze/delete, and `Tee` path/append.
pub type Filter =
    | Cat
    | Head(Int)
    | Tail(Int)
    | Wc(Bool, Bool, Bool, Bool)
    | Grep(String)
    | Sort(Bool, Bool)
    | Uniq(Bool, Bool, Bool)
    | Cut(String, Array[Int])
    | Tr(String, String, Bool, Bool)
    | Tee(String, Bool)

/// Command pipeline built from `$"..."` literals; nothing runs until it is piped into `run`, `capture` or `runHere`.
pub type Plan = {
    mut items Array[Item]
}

/// Exit statuses of every stage of a pipeline that was run.
pub type PipelineResult = {
    pub statuses Array[Int]
}

/// Output collected by `capture`.
pub type Captured = {
    pub stdout Bytes
    pub stderr Bytes
}

/// A stage of a plan: an external command, or one in-process filter.
pub type Stage = {
    pub argv Array[String]
    pub redirs Array[Redir]
    pub filter Filter?
}

/// A redirection of one stage: op is the `<` (1), `>` (2), `>>` (3), `<&` (4) or `>&` (5) form.
pub type Redir = {
    pub op Int
    pub fd Int
    pub target String
}

/// Error from running a pipeline.
pub type Failure = {
    pub text String
}

/// The failure text.
pub fn Failure.message(self) -> String {
    self.text
}

/// An empty plan; the compiler starts every `$"..."` literal with one.
pub pure fn planNew() -> Plan {
    Plan { items: Array.empty() }
}

/// Appends one piece to a plan.
pub pure fn planPush(mut p: Plan, item: Item) -> Plan {
    p.items.push(item)
    p
}

/// Fails when any stage exited with a non-zero status.
pub pure fn check(result: PipelineResult) -> Void! {
    for status in result.statuses {
        if status != 0 {
            fail Failure { text: "command exited with status ${status}" }
        }
    }
}

type Building = {
    mut out Array[Stage]
    mut argv Array[String]
    mut redirs Array[Redir]
    mut word String
    mut inWord Bool
    mut rop Int
    mut rfd Int
}

fn Building.endWord(mut self) {
    if !self.inWord {
        return
    }
    if self.rop != 0 {
        self.redirs.push(Redir {
            op: self.rop
            fd: self.rfd
            target: self.word
        })
        self.rop = 0
    } else {
        self.argv.push(self.word)
    }
    self.word = ""
    self.inWord = false
}

fn Building.endStage(mut self, filter: Filter?) {
    self.endWord()
    if self.argv.len() > 0 || filter is Some(_) {
        self.out.push(Stage {
            argv: self.argv.clone()
            redirs: self.redirs.clone()
            filter: filter
        })
    }
    self.argv = Array.empty()
    self.redirs = Array.empty()
}

/// Splits a plan into its stages, joining the text pieces of each word.
pub pure fn stages(plan: &Plan) -> Array[Stage] {
    let mut b = Building {
        out: Array.empty()
        argv: Array.empty()
        redirs: Array.empty()
        word: ""
        inWord: false
        rop: 0
        rfd: 0
    }
    for item in &plan.items {
        match item {
            Text(s) -> {
                b.word = "${b.word}${s}"
            }
            Word -> {
                b.endWord()
                b.inWord = true
            }
            Redirect(op, fd) -> {
                b.endWord()
                b.rop = op
                b.rfd = fd
                b.inWord = true
            }
            Pipe -> {
                b.endStage(None)
            }
            Builtin(f) -> {
                b.endStage(None)
                b.endStage(Some(filterClone(f)))
            }
        }
    }
    b.endStage(None)
    b.out
}

/// A copy of `f`, for a plan piece that is read from a borrowed list. String
/// and Bool payloads copy; the field list is rebuilt element by element
/// because `Array[Int]` is move-only.
pub pure fn filterClone(f: &Filter) -> Filter {
    match f {
        Cat -> Cat
        Head(count) -> Head(count)
        Tail(count) -> Tail(count)
        Wc(lines, words, bytes, chars) -> Wc(lines, words, bytes, chars)
        Grep(pattern) -> Grep("${pattern}")
        Sort(reverse, unique) -> Sort(reverse, unique)
        Uniq(count, repeated, unique) -> Uniq(count, repeated, unique)
        Cut(delim, fields) -> Cut("${delim}", filterFieldsClone(fields))
        Tr(from, to, squeeze, delete) -> Tr("${from}", "${to}", squeeze, delete)
        Tee(path, append) -> Tee("${path}", append)
    }
}

fn filterFieldsClone(fields: &Array[Int]) -> Array[Int] {
    let mut out = Array.empty[Int]()
    for field in fields {
        out.push(field)
    }
    out
}

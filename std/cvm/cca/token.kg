// Tagged COSE_Sign1 parsing and the signature boundary.
//
// A CCA token is `#6.18([protected, unprotected, payload, signature])`. The
// parser insists on a protected algorithm header: an algorithm an attacker
// can rewrite without invalidating the signature is not a verification
// parameter. It also rejects detached payloads and any trailing bytes.
import p256 from std/crypto/p256
import sha256 from std/crypto/sha256

/// COSE algorithm ES256.
pub const es256: Int = -7

/// COSE algorithm ES384.
pub const es384: Int = -35

/// COSE algorithm ES512.
pub const es512: Int = -36

pub type CoseSign1 = {
    pub algorithm Int
    pub protectedHeader Bytes
    pub payload Bytes
    pub signature Bytes
    /// The exact `Sig_structure` bytes covered by `signature`.
    pub signed Bytes
}

pub type Token = {
    pub cose CoseSign1
    pub claims Claims
}

pub type PlatformToken = {
    pub cose CoseSign1
    pub claims PlatformClaims
}

pure fn signatureSize(algorithm: Int) -> Result[usize, Error] {
    if algorithm == es256 {
        return Ok(64)
    }
    if algorithm == es384 {
        return Ok(96)
    }
    if algorithm == es512 {
        return Ok(132)
    }
    fail UnsupportedAlgorithm(algorithm)
}

pure fn parseProtected(bytes: Bytes) -> Result[Int, Error] {
    let mut cursor = Cursor {
        data: bytes
        at: 0
    }
    let pairs = cursor.readMapHeader()?
    let mut algorithm: Int? = None
    let mut seen: Bool = false
    let mut i: usize = 0
    for i < pairs {
        let label = match cursor.readLabel()? {
            Some(label) -> label
            None -> 0
        }
        match label {
            1 -> {
                if seen {
                    fail Malformed("duplicate COSE algorithm header")
                }
                seen = true
                algorithm = Some(cursor.readInteger()?)
            }
            2 -> fail Unsupported("COSE critical header")
            _ -> cursor.skipValue(64)?
        }
        i = i + 1
    }
    if !cursor.finished() {
        fail Malformed("protected header trailing bytes")
    }
    match algorithm {
        Some(value) -> Ok(value)
        None -> fail Malformed("protected COSE algorithm header is missing")
    }
}

/// Builds the COSE `Sig_structure` for a Signature1 context.
pub pure fn sigStructure(protectedHeader: Bytes, payload: Bytes) -> Bytes {
    let mut out = Array.empty[u8]()
    putHead(&mut out, 4, 4)
    putTextString(&mut out, "Signature1")
    putByteString(&mut out, protectedHeader)
    putByteString(&mut out, Bytes.zeros(0))
    putByteString(&mut out, payload)
    Bytes.fromArray(&out)
}

/// Parses a tagged COSE_Sign1 envelope without interpreting its payload.
pub pure fn parseCoseSign1(data: Bytes) -> Result[CoseSign1, Error] {
    let mut cursor = Cursor {
        data: data
        at: 0
    }
    let tag = cursor.readTag()?
    if tag != coseSign1Tag {
        fail Malformed("COSE_Sign1 tag ${tag}")
    }
    let count = cursor.readArrayHeader()?
    if count != 4 {
        fail Malformed("COSE_Sign1 must hold four items")
    }
    let protectedHeader = cursor.readByteString()?
    if protectedHeader.len() == 0 {
        fail Malformed("COSE_Sign1 protected header is empty")
    }
    let algorithm = parseProtected(protectedHeader)?

    let unprotectedPairs = cursor.readMapHeader()?
    let mut i: usize = 0
    for i < unprotectedPairs {
        let _ = cursor.readLabel()?
        cursor.skipValue(64)?
        i = i + 1
    }

    let payload = cursor.readByteString()?
    if payload.len() == 0 {
        fail Malformed("COSE_Sign1 detached payload")
    }
    let signature = cursor.readByteString()?
    let expected = signatureSize(algorithm)?
    if signature.len() != expected {
        fail BadSize("COSE_Sign1 signature", signature.len())
    }
    if !cursor.finished() {
        fail Malformed("COSE_Sign1 trailing bytes")
    }
    let signed = sigStructure(protectedHeader, payload)
    Ok(CoseSign1 {
        algorithm: algorithm
        protectedHeader: protectedHeader
        payload: payload
        signature: signature
        signed: signed
    })
}

/// Parses a Realm Attestation Token and its realm claim set.
pub pure fn Token.parse(data: Bytes) -> Result[Token, Error] {
    let cose = parseCoseSign1(data)?
    let claims = parseClaims(cose.payload)?
    Ok(Token {
        cose: cose
        claims: claims
    })
}

/// Parses a CCA Platform token and its platform claim set.
pub pure fn PlatformToken.parse(data: Bytes) -> Result[PlatformToken, Error] {
    let cose = parseCoseSign1(data)?
    let claims = parsePlatformClaims(cose.payload)?
    Ok(PlatformToken {
        cose: cose
        claims: claims
    })
}

/// Verifies a token signature with a caller-supplied boundary. The verifier
/// receives the algorithm, the trusted key, the `Sig_structure` and the
/// signature. Returning false is `Forged`; returning an error preserves the
/// verifier's reason.
pub pure fn CoseSign1.verify(self, key: &CoseKey, verify: fn(Int, &CoseKey, Bytes, Bytes) -> Result[Bool, Error]) -> Result[Void, Error] {
    match verify(self.algorithm, key, self.signed, self.signature) {
        Ok(true) -> Ok(())
        Ok(false) -> fail Forged("COSE_Sign1 signature")
        Err(error) -> Err(error)
    }
}

/// Verifies a COSE_Sign1 whose verification key the caller already trusts.
/// No key travels in the token; `verify` must close over the pinned key.
pub pure fn CoseSign1.verifyKeyless(self, verify: fn(Int, Bytes, Bytes) -> Result[Bool, Error]) -> Result[Void, Error] {
    match verify(self.algorithm, self.signed, self.signature) {
        Ok(true) -> Ok(())
        Ok(false) -> fail Forged("COSE_Sign1 signature")
        Err(error) -> Err(error)
    }
}

/// Verifies ES256 with the Realm Attestation Key carried by the claim set.
///
/// This is the only algorithm `std/crypto` can check. A token using ES384 or
/// ES512 fails with `Unsupported`, and a direct-model token without a public
/// key cannot use this entry point at all: it needs the platform claim-set
/// binding, which the caller must verify explicitly.
pub pure fn Token.verifyEs256(self) -> Result[Void, Error] {
    let key = match self.claims.publicKey {
        Some(value) -> value
        None -> fail Unsupported("direct CCA realm token has no Realm Attestation Key")
    }
    match verifyEs256(self.cose.algorithm, &key, self.cose.signed, self.cose.signature) {
        Ok(true) -> Ok(())
        Ok(false) -> fail Forged("COSE_Sign1 signature")
        Err(error) -> Err(error)
    }
}

/// Verifies a realm token through an arbitrary verifier.
pub pure fn Token.verify(self, verify: fn(Int, &CoseKey, Bytes, Bytes) -> Result[Bool, Error]) -> Result[Void, Error] {
    let key = match self.claims.publicKey {
        Some(value) -> value
        None -> fail Unsupported("direct CCA realm token has no Realm Attestation Key")
    }
    match verify(self.cose.algorithm, &key, self.cose.signed, self.cose.signature) {
        Ok(true) -> Ok(())
        Ok(false) -> fail Forged("COSE_Sign1 signature")
        Err(error) -> Err(error)
    }
}

/// Borrowing form of `CoseSign1.verify`.
pub pure fn verifyCoseSign1(cose: &CoseSign1, key: &CoseKey, verify: fn(Int, &CoseKey, Bytes, Bytes) -> Result[Bool, Error]) -> Result[Void, Error] {
    match verify(cose.algorithm, key, cose.signed, cose.signature) {
        Ok(true) -> Ok(())
        Ok(false) -> fail Forged("COSE_Sign1 signature")
        Err(error) -> Err(error)
    }
}

/// Borrowing form of `CoseSign1.verifyKeyless`.
pub pure fn verifyCoseSign1Keyless(cose: &CoseSign1, verify: fn(Int, Bytes, Bytes) -> Result[Bool, Error]) -> Result[Void, Error] {
    match verify(cose.algorithm, cose.signed, cose.signature) {
        Ok(true) -> Ok(())
        Ok(false) -> fail Forged("COSE_Sign1 signature")
        Err(error) -> Err(error)
    }
}

/// Borrowing form of `Token.verify`: verifies the RAK signature with the key
/// carried by the claim set.
pub pure fn verifyToken(token: &Token, verify: fn(Int, &CoseKey, Bytes, Bytes) -> Result[Bool, Error]) -> Result[Void, Error] {
    let key = match token.claims.publicKey {
        Some(value) -> value
        None -> fail Unsupported("direct CCA realm token has no Realm Attestation Key")
    }
    verifyCoseSign1(&token.cose, &key, verify)
}

/// Borrowing form of `Token.verifyEs256`.
pub pure fn verifyTokenEs256(token: &Token) -> Result[Void, Error] {
    let key = match token.claims.publicKey {
        Some(value) -> value
        None -> fail Unsupported("direct CCA realm token has no Realm Attestation Key")
    }
    match verifyEs256(token.cose.algorithm, &key, token.cose.signed, token.cose.signature) {
        Ok(true) -> Ok(())
        Ok(false) -> fail Forged("COSE_Sign1 signature")
        Err(error) -> Err(error)
    }
}

/// Real ECDSA P-256 / SHA-256 verification for a COSE ES256 token.
///
/// This is a verifier boundary that can be passed directly to `Token.verify`
/// or used for a platform token whose key the caller pins.
pub pure fn verifyEs256(algorithm: Int, key: &CoseKey, signed: Bytes, signature: Bytes) -> Result[Bool, Error] {
    if algorithm != es256 {
        fail UnsupportedAlgorithm(algorithm)
    }
    let public = match key.sec1() {
        Some(value) -> value
        None -> fail Unsupported("ES256 requires an EC2 P-256 COSE_Key")
    }
    match p256.verify(public, sha256.sum(signed), signature) {
        Ok(value) -> Ok(value)
        Err(error) -> fail Forged("ES256 signature: ${error.message()}")
    }
}

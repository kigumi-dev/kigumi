// A message head: the request or status line and the header fields after it.
type Head = {
    first String
    headers Headers
}

fn crlf() -> Bytes {
    "\r\n".toBytes()
}

fn isTokenByte(c: u8) -> Bool {
    let d = c.toInt()
    if (d >= 48 && d <= 57) || (d >= 65 && d <= 90) || (d >= 97 && d <= 122) {
        return true
    }
    "!#$%&'*+-.^_`|~".bytes().contains(Bytes.fill(c, 1))
}

fn isToken(text: String) -> Bool {
    let b = text.bytes()
    if b.len() == 0 {
        return false
    }
    for i in 0..b.len() {
        if !isTokenByte(b.get(i) || 0) {
            return false
        }
    }
    true
}

// A field value may hold visible bytes, spaces and tabs, but no other control byte.
fn isFieldValue(text: String) -> Bool {
    let b = text.bytes()
    for i in 0..b.len() {
        let c = (b.get(i) || 0).toInt()
        if (c < 32 && c != 9) || c == 127 {
            return false
        }
    }
    true
}

fn hasControlOrSpace(text: String) -> Bool {
    let b = text.bytes()
    for i in 0..b.len() {
        let c = (b.get(i) || 0).toInt()
        if c <= 32 || c == 127 {
            return true
        }
    }
    false
}

// headEnd finds the offset just past the blank line ending a head, or None for more input; it resumes
// at from, where an earlier call stopped, and refuses a LF without its CR.
fn headEnd(data: &Bytes, from: usize) -> usize?! {
    let n = data.len()
    let mut i = from
    for i < n {
        if (data.get(i) || 0) == 10 {
            if i == 0 || (data.get(i - 1) || 0) != 13 {
                fail failure(400, "bare LF in message head")
            }
            if i >= 3 && (data.get(i - 2) || 0) == 10 && (data.get(i - 3) || 0) == 13 {
                return Some(i + 1)
            }
        }
        i = i + 1
    }
    None
}

// parseHead reads a head ending in CRLF CRLF; maxFields bounds the header count.
fn parseHead(raw: Bytes, maxFields: usize) -> Head! {
    let text = if String.fromBytes(raw) is Ok(t) {
        t
    } else {
        fail failure(400, "message head is not valid UTF-8")
    }
    let lines = text.split("\r\n")
    let first = lines.get(0) || ""
    let mut headers = Headers.new()
    let mut i: usize = 1
    for i < lines.len() {
        let line = lines.get(i) || ""
        i = i + 1
        if line == "" {
            continue
        }
        if line.startsWith(" ") || line.startsWith("\t") {
            fail failure(400, "folded header line")
        }
        let colon = indexOfByte(line, 58) || fail failure(400, "header line without a colon")
        let name = line.sliceBytes(0, colon) || ""
        if !isToken(name) {
            fail failure(400, "invalid header name")
        }
        let value = (line.sliceBytes(colon + 1, line.len()) || "").trim()
        if !isFieldValue(value) || value.contains("\r") {
            fail failure(400, "invalid header value")
        }
        if headers.len() >= maxFields {
            fail failure(431, "too many header fields")
        }
        headers.add(name, value)
    }
    Head {
        first: first
        headers: headers
    }
}

// How the body after a head is delimited.
type Framing =
    | NoBody
    | Sized(usize)
    | Chunked
    | UntilClose

// framingOf applies RFC 9112 section 6.3: a Transfer-Encoding
// other than chunked is refused, and so is one sent alongside Content-Length.
fn framingOf(headers: &Headers, request: Bool) -> Framing! {
    let te = headers.all("Transfer-Encoding")
    let cl = headers.all("Content-Length")
    if te.len() > 0 {
        if cl.len() > 0 {
            fail failure(400, "both Transfer-Encoding and Content-Length")
        }
        let mut codings = ""
        for s in &te {
            codings = if codings == "" {
                s
            } else {
                "${codings},${s}"
            }
        }
        if codings.trim().toLower() != "chunked" {
            fail failure(501, "unsupported transfer coding")
        }
        return Chunked
    }
    if cl.len() == 0 {
        return if request {
            NoBody
        } else {
            UntilClose
        }
    }
    let first = cl.get(0) || ""
    for v in &cl {
        if v != first {
            fail failure(400, "conflicting Content-Length")
        }
    }
    Sized(parseDecimal(first) || fail failure(400, "invalid Content-Length"))
}

fn parseDecimal(text: String) -> usize? {
    let b = text.bytes()
    if b.len() == 0 || b.len() > 15 {
        return None
    }
    let mut n: usize = 0
    for i in 0..b.len() {
        let d = b.get(i) || 0
        if d < 48 || d > 57 {
            return None
        }
        n = n * 10 + (d - 48).toUsize()
    }
    Some(n)
}

fn parseHex(text: String) -> usize? {
    let b = text.bytes()
    if b.len() == 0 || b.len() > 12 {
        return None
    }
    let mut n: usize = 0
    for i in 0..b.len() {
        let v = hexValue(b.get(i) || 0) || return None
        n = n * 16 + (v.toUsize() || 0)
    }
    Some(n)
}

fn noBodyStatus(status: Int) -> Bool {
    (status >= 100 && status < 200) || status == 204 || status == 304
}

// renderHead writes a head line and its fields; Content-Length, Transfer-Encoding
// and Connection are the caller's to set, so stale copies of them are dropped.
fn renderHead(first: String, headers: &Headers, bodyLen: usize?, close: Bool) -> Bytes! {
    let mut out = "${first}\r\n"
    for h in &headers.items {
        if !isToken(h.name) || !isFieldValue(h.value) {
            fail failure(500, "invalid header field ${h.name}")
        }
        let key = h.name.toLower()
        if key == "content-length" || key == "transfer-encoding" || key == "connection" {
            continue
        }
        out = "${out}${h.name}: ${h.value}\r\n"
    }
    if bodyLen is Some(n) {
        out = "${out}Content-Length: ${n}\r\n"
    }
    if close {
        out = "${out}Connection: close\r\n"
    }
    "${out}\r\n".toBytes()
}

// wantsClose reads the Connection field: HTTP/1.1 stays open unless it says close,
// and HTTP/1.0 is always closed here since its keep-alive is opt-in and rarely needed.
fn wantsClose(headers: &Headers, version: String) -> Bool {
    if version != "HTTP/1.1" {
        return true
    }
    for v in headers.all("Connection") {
        for part in v.split(",") {
            if part.trim().toLower() == "close" {
                return true
            }
        }
    }
    false
}

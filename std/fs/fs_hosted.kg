import array from std/array
import ffi from std/ffi

extern(C) {
    fn fopen(path: *const u8, mode: *const u8) -> *mut u8
    fn fdopen(fd: i32, mode: *const u8) -> *mut u8
    fn open(path: *const u8, flags: i32, ...) -> i32
    fn close(fd: i32) -> i32
    fn unlink(path: *const u8) -> i32
    fn rmdir(path: *const u8) -> i32
    fn fclose(f: *mut u8) -> i32
    fn fflush(f: *mut u8) -> i32
    fn fwrite(p: *const u8, size: usize, n: usize, f: *mut u8) -> usize
    fn fread(p: *mut u8, size: usize, n: usize, f: *mut u8) -> usize
    fn ferror(f: *mut u8) -> i32
    fn access(path: *const u8, mode: i32) -> i32
    fn mkdir(path: *const u8, mode: u32) -> i32
    fn opendir(path: *const u8) -> *mut u8
    fn readdir(dir: *mut u8) -> *mut u8
    fn closedir(dir: *mut u8) -> i32
    fn malloc(n: usize) -> *mut u8
    fn realloc(p: *mut u8, n: usize) -> *mut u8
    fn free(p: *mut u8)
}

fn openFile(path: &String, mode: String) -> File! {
    let c = ffi.CString.new(path)?
    let m = ffi.CString.new(&mode)?
    let f = unsafe {
        fopen(c.ptr(), m.ptr())
    }
    if ffi.isNull(ffi.toConst(f)) {
        fail ffi.lastError()
    }
    File { f: f }
}

/// Creates the file at path, truncating an existing one, and opens it for writing.
pub fn Files.create(self, path: Path) -> File! {
    openFile(&path.text, "w")
}

/// Opens the file at path for writing at its end, creating it when missing;
/// unlike create it never truncates, so a redirected /dev/stdout keeps its content.
pub fn Files.append(self, path: Path) -> File! {
    openFile(&path.text, "a")
}

/// Creates the file at path like `create`, with permission bits mode (before the umask is applied), for example 0o600 for a file only its owner can read.
pub fn Files.createWithMode(self, path: Path, mode: u32) -> File! {
    let c = ffi.CString.new(&path.text)?
    let fd = unsafe {
        open(c.ptr(), createFlags(), mode)
    }
    if fd < 0 {
        fail ffi.lastError()
    }
    let m = ffi.CString.new(&"w")?
    let f = unsafe {
        fdopen(fd, m.ptr())
    }
    if ffi.isNull(ffi.toConst(f)) {
        let err = ffi.lastError()
        _ = unsafe {
            close(fd)
        }
        fail err
    }
    File { f: f }
}

/// Deletes the file at path; a directory is an error, `removeDir` deletes an empty one.
pub fn Files.remove(self, path: Path) -> Void! {
    let c = ffi.CString.new(&path.text)?
    if unsafe {
        unlink(c.ptr())
    } != 0 {
        fail ffi.lastError()
    }
}

/// Deletes the empty directory at path.
pub fn Files.removeDir(self, path: Path) -> Void! {
    let c = ffi.CString.new(&path.text)?
    if unsafe {
        rmdir(c.ptr())
    } != 0 {
        fail ffi.lastError()
    }
}

/// Writes data to the file; may write fewer bytes than given (a short
/// write), matching std/io's Writer (writeAll loops for the rest).
pub fn File.write(mut self, data: Bytes) -> usize! {
    let n = data.len()
    if n == 0 {
        return 0
    }
    let got = unsafe {
        fwrite(ffi.bytesPtr(&data), 1, n, self.f)
    }
    if got < n && unsafe {
        ferror(self.f)
    } != 0 {
        fail ffi.lastError()
    }
    got
}

/// Flushes the file and reports any error; the drop then closes it.
pub fn File.close(move self) -> Void! {
    if unsafe {
        fflush(self.f)
    } != 0 {
        fail ffi.lastError()
    }
}

/// Closes the file when it goes out of scope, ignoring errors.
pub fn File.drop(move self) {
    _ = unsafe {
        fclose(self.f)
    }
}

/// Whole file as UTF-8 text; fails when the file is missing, longer than `defaultReadLimit` bytes or not valid UTF-8.
pub fn Files.read(self, path: Path) -> String! {
    String.fromBytes(self.readBytesUpTo(path, defaultReadLimit)?)
}

/// Whole file as bytes; fails when it is longer than `defaultReadLimit` bytes.
pub fn Files.readBytes(self, path: Path) -> Bytes! {
    self.readBytesUpTo(path, defaultReadLimit)
}

/// Whole file as bytes; fails once it turns out to hold more than limit bytes, so a device such as /dev/zero cannot exhaust memory.
pub fn Files.readBytesUpTo(self, path: Path, limit: usize) -> Bytes! {
    // fopen happily opens a directory; report it as EISDIR up front.
    let c = ffi.CString.new(&path.text)?
    let d = unsafe {
        opendir(c.ptr())
    }
    if !ffi.isNull(ffi.toConst(d)) {
        _ = unsafe {
            closedir(d)
        }
        fail ffi.CError {
            code: 21
            text: ffi.errorText(21)
        }
    }
    let file = openFile(&path.text, "rb")?
    let mut most = limit.wrappingAdd(1)
    if most == 0 {
        most = limit
    }
    let mut cap: usize = 65536
    if most < cap {
        cap = most
    }
    let mut len: usize = 0
    let mut buf = unsafe {
        malloc(cap)
    }
    if ffi.isNull(ffi.toConst(buf)) {
        fail ffi.CError {
            code: 12
            text: "out of memory"
        }
    }
    for true {
        if len == cap {
            cap = if cap > most / 2 {
                most
            } else {
                cap * 2
            }
            let grown = unsafe {
                realloc(buf, cap)
            }
            if ffi.isNull(ffi.toConst(grown)) {
                unsafe {
                    free(buf)
                }
                fail ffi.CError {
                    code: 12
                    text: "out of memory"
                }
            }
            buf = grown
        }
        let got = unsafe {
            fread(ffi.toMut(ffi.offset(ffi.toConst(buf), len.toInt() || 0)), 1, cap - len, file.f)
        }
        if got == 0 {
            if unsafe {
                ferror(file.f)
            } != 0 {
                unsafe {
                    free(buf)
                }
                fail ffi.lastError()
            }
            break
        }
        len = len + got
        if len > limit {
            unsafe {
                free(buf)
            }
            fail ffi.CError {
                code: 27
                text: "file is larger than the read limit of ${limit} bytes"
            }
        }
    }
    let out = unsafe {
        ffi.bytesFrom(ffi.toConst(buf), len)
    }
    unsafe {
        free(buf)
    }
    out
}

/// Creates the directory at path and any missing parents; an existing directory is fine, an existing file is an error.
pub fn Files.mkdir(self, path: Path) -> Void! {
    let parts = path.text.split("/")
    let mut cur = ""
    for i in 0..parts.len() {
        if i > 0 {
            cur = "${cur}/"
        }
        cur = "${cur}${parts.get(i) || ""}"
        if cur == "" || cur == "/" {
            continue
        }
        let c = ffi.CString.new(&cur)?
        if unsafe {
            mkdir(c.ptr(), 493)
        } != 0 {
            if ffi.errno() != eexist() {
                fail ffi.lastError()
            }
            let d = unsafe {
                opendir(c.ptr())
            }
            if ffi.isNull(ffi.toConst(d)) {
                let e = ffi.errno()
                if e == enotdir() {
                    fail ffi.lastError()
                }
                if e == enoent() || e == eloop() {
                    fail ffi.CError {
                        code: eexist()
                        text: ffi.errorText(eexist())
                    }
                }
            } else {
                _ = unsafe {
                    closedir(d)
                }
            }
        }
    }
}

/// Whether something exists at path.
pub fn Files.exists(self, path: Path) -> Bool {
    let c = ffi.CString.new(&path.text) || (_) => return false
    unsafe {
        access(c.ptr(), 0)
    } == 0
}

/// Paths of the entries directly inside the directory at path, sorted by name.
pub fn Files.list(self, path: Path) -> Array[Path]! {
    let c = ffi.CString.new(&path.text)?
    let d = unsafe {
        opendir(c.ptr())
    }
    if ffi.isNull(ffi.toConst(d)) {
        fail ffi.lastError()
    }
    let mut names: Array[String] = Array.empty()
    for true {
        ffi.clearErrno()
        let e = unsafe {
            readdir(d)
        }
        if ffi.isNull(ffi.toConst(e)) {
            if ffi.errno() == eintr() {
                continue
            }
            if ffi.errno() != 0 {
                let err = ffi.lastError()
                _ = unsafe {
                    closedir(d)
                }
                fail err
            }
            break
        }
        let name = unsafe {
            ffi.stringLossy(ffi.offset(ffi.toConst(e), direntNameOffset()))
        }
        if name != "." && name != ".." {
            names.push(name)
        }
    }
    _ = unsafe {
        closedir(d)
    }
    let dir = if path.text.endsWith("/") || path.text == "" {
        path.text
    } else {
        "${path.text}/"
    }
    let mut out: Array[Path] = Array.empty()
    for name in array.sortedBy(&names, (a, b) => a.compareTo(b)) {
        out.push(Path { text: "${dir}${name}" })
    }
    out
}

/// Opens the existing file at path for reading; read it with `File.read`, or wrap it in an `io.BufReader` to read line by line.
pub fn Files.open(self, path: Path) -> File! {
    openFile(&path.text, "rb")
}

/// Appends up to max bytes read from the file to into and returns how many; 0 means end of file (std/io's Reader).
pub fn File.read(mut self, into: &mut Array[u8], max: usize) -> usize! {
    if max == 0 {
        return 0
    }
    let want = if max < 65536 {
        max
    } else {
        65536
    }
    let buf = unsafe {
        malloc(want)
    }
    if ffi.isNull(ffi.toConst(buf)) {
        fail ffi.CError {
            code: 12
            text: "out of memory"
        }
    }
    let got = unsafe {
        fread(buf, 1, want, self.f)
    }
    if got == 0 && unsafe {
        ferror(self.f)
    } != 0 {
        let err = ffi.lastError()
        unsafe {
            free(buf)
        }
        fail err
    }
    let chunk = unsafe {
        ffi.bytesFrom(ffi.toConst(buf), got)
    }
    unsafe {
        free(buf)
    }
    for i in 0..got {
        into.push(chunk[i])
    }
    got
}

/// Renames or moves a file or directory. Fails when either path is missing,
/// when the destination exists on a system that does not replace it, or when
/// the two paths are on different file systems.
pub fn Files.rename(self, from: Path, to: Path) -> Void! {
    let a = ffi.CString.new(&from.text)?
    let b = ffi.CString.new(&to.text)?
    if unsafe {
        rename(a.ptr(), b.ptr())
    } != 0 {
        fail ffi.lastError()
    }
}

/// Size of the regular file at path in bytes.
pub fn Files.size(self, path: Path) -> i64! {
    let mut file = self.open(path)?
    if unsafe {
        fseek(file.f, 0, 2)
    } != 0 {
        fail ffi.lastError()
    }
    let end = unsafe {
        ftell(file.f)
    }
    if end < 0 {
        fail ffi.lastError()
    }
    end.toInt()
}

extern(C) {
    fn rename(old_path: *const u8, new_path: *const u8) -> i32
    fn fseek(f: *mut u8, offset: isize, whence: i32) -> i32
    fn ftell(f: *mut u8) -> isize
}

/// Moves the file cursor to offset bytes from the start and returns the new absolute offset.
pub fn File.seekStart(self, offset: i64) -> i64! {
    seekTo(self.f, offset, 0)
}

/// Moves the file cursor by offset bytes from its current position and returns the new absolute offset.
pub fn File.seekCurrent(self, offset: i64) -> i64! {
    seekTo(self.f, offset, 1)
}

/// Moves the file cursor to offset bytes from the end and returns the new absolute offset.
pub fn File.seekEnd(self, offset: i64) -> i64! {
    seekTo(self.f, offset, 2)
}

fn seekTo(f: *mut u8, offset: i64, whence: i32) -> i64! {
    let off = offset.toIsize()
    if off.toInt() != offset {
        fail ffi.CError {
            code: 22
            text: "seek offset is outside the platform range"
        }
    }
    if unsafe {
        fseek(f, off, whence)
    } != 0 {
        fail ffi.lastError()
    }
    let at = unsafe {
        ftell(f)
    }
    if at < 0 {
        fail ffi.lastError()
    }
    at.toInt()
}

/// Metadata for path: directory, regular file with its byte size, or another entry.
pub fn Files.stat(self, path: Path) -> Stat! {
    let c = ffi.CString.new(&path.text)?
    let cv = ffi.CValue.new(FsMeta {
        kind: 2
        size: 0
        mode: 0
        mtimeMillis: 0
    })
    let rc = unsafe {
        rt_fs_stat(c.ptr(), cv.ptr())
    }
    if rc != 0 {
        let code = 0 - rc
        fail ffi.CError {
            code: code
            text: ffi.errorText(code)
        }
    }
    let m = cv.get()
    let kind = match m.kind {
        0 -> Kind.Regular
        1 -> Kind.Directory
        _ -> Kind.Other
    }
    Stat {
        kind: kind
        size: if m.kind == 0 {
            m.size
        } else {
            0
        }
        mode: m.mode
        mtimeMillis: m.mtimeMillis
    }
}

/// Whether path names a directory.
pub fn Files.isDir(self, path: Path) -> Bool! {
    let st = self.stat(path)?
    st.kind is Kind.Directory
}

/// Whether path names a regular file.
pub fn Files.isFile(self, path: Path) -> Bool! {
    let st = self.stat(path)?
    st.kind is Kind.Regular
}

extern(C) {
    fn rt_fs_stat(path: *const u8, out: *mut FsMeta) -> i32
}

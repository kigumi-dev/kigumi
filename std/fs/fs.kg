import ffi from std/ffi
import os from std/os
import path from std/path

/// File system access, obtained from `host.files()`.
/// Safety: a stateless capability marker; every call it makes is independent, so sharing or duplicating it is free.
@unsafeGuarantee(Copy, Send, Sync)
pub type Files

/// The most bytes `Files.read` and `Files.readBytes` load; `Files.readBytesUpTo` takes another limit.
pub const defaultReadLimit: usize = 268435456

/// Validated file system path.
pub type Path = {
    text String
}

/// Open file, from `Files.open` (read) or `Files.create` / `Files.append` (write); close it explicitly or let the drop close it.
/// Safety: the handle names one open file and moving it to another thread transfers that one owner.
@unsafeGuarantee(Send)
pub type File = resource {
    f *mut u8
}

/// Parses s as a path; fails when it contains a NUL byte.
pub pure fn Path.fromString(s: String) -> Path! {
    let b = s.bytes()
    for i in 0..b.len() {
        if (b.get(i) || 1) == 0 {
            fail ffi.CError {
                code: 0
                text: "path contains NUL"
            }
        }
    }
    Path { text: s }
}

/// Parses an OS string as a path; fails when it contains a NUL byte, and
/// when it is not valid UTF-8 because a Path holds text.
pub pure fn Path.fromOsString(s: &os.OsString) -> Path! {
    match s.checkedString() {
        Some(text) -> Path.fromString(text)
        None -> fail ffi.CError {
            code: 0
            text: "path is not valid UTF-8"
        }
    }
}

/// The path as text.
pub pure noalloc fn Path.toString(self) -> String {
    self.text
}

/// Whether the path starts at the root.
pub pure fn Path.isAbsolute(self) -> Bool {
    path.isAbs(self.text)
}

/// The last element, without a trailing separator.
pub pure fn Path.fileName(self) -> String {
    path.base(self.text)
}

/// The parent directory.
pub pure fn Path.parent(self) -> Path {
    Path { text: path.dir(self.text) }
}

/// The last element without its extension.
pub pure fn Path.stem(self) -> String {
    path.stem(self.text)
}

/// The extension of the last element, dot included.
pub pure fn Path.extension(self) -> String {
    path.ext(self.text)
}

/// other appended below this path, with redundant separators and `.`/`..` cleaned.
pub pure fn Path.join(self, other: Path) -> Path {
    Path { text: path.join2(self.text, other.text) }
}

/// The lexical form with redundant separators and `.`/`..` removed.
pub pure fn Path.normalize(self) -> Path {
    Path { text: path.clean(self.text) }
}

/// The bytes of the path as an OS string.
pub pure fn Path.toOsString(self) -> os.OsString {
    os.OsString.fromString(self.text)
}

/// Creates or truncates the file at path and writes text into it; loops
/// over File.write's short writes to send all of it (std/io's writeAll law).
pub fn Files.writeText(self, path: Path, text: String) -> Void! {
    let mut file = self.create(path)?
    let data = text.toBytes()
    let mut sent: usize = 0
    for sent < data.len() {
        let n = file.write(data.slice(sent, data.len()).unwrap())?
        if n == 0 {
            fail ffi.CError {
                code: 0
                text: "write returned 0 with data remaining"
            }
        }
        sent += n
    }
    file.close()
}

/// The portable kind of a file-system entry.
pub type Kind =
    | Regular
    | Directory
    | Other

/// Portable metadata for a path: its kind and, for a regular file, its size in bytes.
pub type Stat = {
    pub kind Kind
    pub size i64
    pub mode u32
    pub mtimeMillis i64
}

type FsMeta layout(C) = {
    kind i32
    size i64
    mode u32
    mtimeMillis i64
}

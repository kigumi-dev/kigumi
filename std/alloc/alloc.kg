import {Display} from std/fmt

/// Arena allocator: everything allocated in its scope is freed together when the scope ends.
pub type Arena

/// Handle to an allocator, obtained from `Arena.create()`; `scope()` makes it current.
/// Its arena tracks live references with a plain counter, not an atomic one,
/// so it is neither Send nor Sync.
pub type AllocatorHandle

/// Value consumed by an `allocator ... { }` block to route its allocations.
pub type AllocatorScope

/// Reference-counted shared ownership of a T within one thread: every clone is the same cell, and `set` replaces its value. It is neither Send nor Sync.
pub type Shared[T]

/// Non-owning handle to a Shared cell; it breaks reference cycles.
pub type Weak[T]

/// Owned heap cell holding one T: exactly one owner, and dropping the Box drops the content. It is never copied
/// or cloned implicitly, and it is the way a type refers to itself (`Wrap(kid: Box[Node])`).
/// Safety: a Box is the only owner of its T, so sending it moves T and sharing it only shares T.
@unsafeGuarantee(Send when T: Send, Sync when T: Sync)
pub type Box[T]

/// Creates an arena; fails when the host cannot provide memory.
pub fn Arena.create() -> AllocatorHandle!

/// Creates an arena, reporting a refused allocation as AllocError.
pub fn Arena.tryCreate() -> Result[AllocatorHandle, AllocError] {
    if Arena.create() is Ok(handle) {
        return Ok(handle)
    }
    Err(AllocError.OutOfMemory)
}

/// Scope that makes this allocator current inside an `allocator` block; its
/// bookkeeping lives in this allocator, so no ambient allocator is needed.
pub noalloc fn AllocatorHandle.scope(self) -> AllocatorScope

/// Bytes handed out by this allocator so far; the interpreter reports 0.
pub fn AllocatorHandle.allocated(self) -> Int

/// Wraps a value in a shared cell.
pub fn Shared.new[T](value: T) -> Shared[T]

/// Wraps a value in a shared cell, or AllocError when the allocator refuses (new panics instead).
pub fn Shared.tryNew[T](value: T) -> Result[Shared[T], AllocError]

/// Another handle to the same cell.
pub fn Shared[T].clone(self) -> Shared[T]

/// A copy of the current content.
pub fn Shared[T: Copy].get(self) -> T

/// Replaces the content; the old value is dropped.
pub fn Shared[T].set(self, value: T) -> Unit

/// Calls f once with a borrow of the content and returns what it returns; f is not kept (non-escaping).
/// Panics on reentrant `withMut` into the same cell.
pub fn Shared[T].with[R](self, f: fn(&T) -> R) -> R

/// Calls f once with an exclusive borrow of the content, so f can mutate it in
/// place; f is not kept. Panics on reentrant `with`/`withMut` into the same cell.
pub fn Shared[T].withMut[R](self, f: fn(&mut T) -> R) -> R

/// A weak handle to the same cell.
pub fn Shared[T].downgrade(self) -> Weak[T]

/// The cell as a Shared while some Shared still owns it; None once the last one was dropped.
pub fn Weak[T].upgrade(self) -> Shared[T]?

/// Another weak handle to the same cell.
pub fn Weak[T].clone(self) -> Weak[T]

/// Moves value onto the heap.
pub pure fn Box.new[T](value: T) -> Box[T]

/// Moves value onto the heap, or AllocError when the allocator refuses (new panics instead).
pub pure fn Box.tryNew[T](value: T) -> Result[Box[T], AllocError]

/// A copy of the current content.
pub pure noalloc fn Box[T: Copy].get(self) -> T

/// Replaces the content; the old value is dropped.
pub pure fn Box[T].set(mut self, value: T) -> Unit

/// Calls f once with a borrow of the content and returns what it returns; f is not kept (non-escaping).
pub pure noalloc fn Box[T].with[R](self, f: fn(&T) -> R) -> R

/// Calls f once with an exclusive borrow of the content, so f can mutate it in place; f is not kept.
pub pure noalloc fn Box[T].withMut[R](mut self, f: fn(&mut T) -> R) -> R

/// Moves the content out and frees the cell; the only way to take ownership of the content back.
pub pure noalloc fn Box[T].into(move self) -> T

/// Equality of the contents; satisfies `Eq` when T does.
pub pure fn Box[T: Eq].equals(self, other: &Box[T]) -> Bool {
    self.with((a: &T) => other.with((b: &T) => a == b))
}

/// The hash of the content; satisfies `Hash` when T does.
pub pure fn Box[T: Hash].hash(self) -> u64 {
    self.with((a: &T) => a.hash())
}

/// Order of the contents; satisfies `Ord` when T does.
pub pure fn Box[T: Ord].compareTo(self, other: &Box[T]) -> Ordering {
    self.with((a: &T) => other.with((b: &T) => a.compareTo(b)))
}

/// The text of the content; satisfies `Display` when T does.
pub pure fn Box[T: Display].display(self) -> String {
    self.with((a: &T) => a.display())
}

pub fn f64.parseFlag(arg: &os.OsString) -> Result[f64, String] {
    let s = unicodeText(arg)?
    match text.parseFloat(s) {
        Some(f) -> Ok(f)
        None -> Err("expected a number")
    }
}

pub fn f64.absorbFlag(mut self, value: f64) {
    self = value
}

pub fn f64.flagInfo() -> ValueInfo {
    ValueInfo {
        name: "number"
        shape: Shape.Single
    }
}

pub fn f32.parseFlag(arg: &os.OsString) -> Result[f32, String] {
    let s = unicodeText(arg)?
    match text.parseFloat(s) {
        Some(f) -> {
            if f >= 3.4028235677973366e38 || f <= -3.4028235677973366e38 {
                return Err("out of range for f32")
            }
            Ok(f.toF32())
        }
        None -> Err("expected a number")
    }
}

pub fn f32.absorbFlag(mut self, value: f32) {
    self = value
}

pub fn f32.flagInfo() -> ValueInfo {
    ValueInfo {
        name: "number"
        shape: Shape.Single
    }
}

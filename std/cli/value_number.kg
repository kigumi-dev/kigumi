import os from std/os
import text from std/text

fn signedText(arg: &os.OsString) -> Result[Int, String] {
    let s = unicodeText(arg)?
    match text.parseInt(s) {
        Some(n) -> Ok(n)
        None -> Err("expected an integer")
    }
}

fn unsignedText(arg: &os.OsString) -> Result[u64, String] {
    let s = unicodeText(arg)?
    match text.parseUint(s) {
        Some(n) -> Ok(n)
        None -> Err("expected an unsigned integer")
    }
}

pub fn i64.parseFlag(arg: &os.OsString) -> Result[i64, String] {
    signedText(arg)
}

pub fn i64.absorbFlag(mut self, value: i64) {
    self = value
}

pub fn i64.flagInfo() -> ValueInfo {
    ValueInfo {
        name: "int"
        shape: Shape.Single
    }
}

pub fn i8.parseFlag(arg: &os.OsString) -> Result[i8, String] {
    let n = signedText(arg)?
    match n.toI8() {
        Some(v) -> Ok(v)
        None -> Err("${n} is out of range for i8")
    }
}

pub fn i8.absorbFlag(mut self, value: i8) {
    self = value
}

pub fn i8.flagInfo() -> ValueInfo {
    ValueInfo {
        name: "int"
        shape: Shape.Single
    }
}


/// Runs one task tree: on the thread driving it, and on its own workers when it has any.
/// Safety: every operation on the scheduler state takes its lock, and a drop on any lane leaves a busy pool to be joined by the driver.
@unsafeGuarantee(Send)
pub type Executor

/// A running task; await it for its result.
pub type Task[T]

/// An executor that drives tasks on the thread calling it.
pub fn currentThreadExecutor() -> Executor

/// An executor with `workers` (1 to 256) worker threads besides the one that drives it; migratable tasks run on any of them.
pub fn threadPoolExecutor(workers: usize) -> Executor

/// Starts the future as a child of the running task, but on this executor instead of the running task's own.
pub fn Executor.handoff[T](self, future: Future[T]) -> Task[T]

/// Drives the future, and everything it spawns, to a terminal state.
/// Internal SPI: the generated root bridge calls this.
pub fn Executor.runToCompletion[T](self, future: Future[T]) -> T

/// Starts the future as a child task. Its panic is raised where it is awaited; if nothing awaits it, the panic cancels the parent and its other children, and the parent fails with it.
pub fn spawn[T](future: Future[T]) -> Task[T]

/// Asks the task to stop at its next suspension point.
pub fn Task[T].cancel(self)

/// A Future whose first poll puts the running task behind the other runnable tasks of its executor.
pub fn yieldNow() -> Future[Void]

/// Whether the running task has been asked to stop.
pub fn cancelRequested() -> Bool

/// `cancelRequested` read as a context key; the executor binds it to every task, and `context (...)` cannot override it.
/// Internal SPI: the task runtime supplies this key.
pub context cancellation: Bool

/// A bounded, root-owned boundary for running direct-blocking work from an async body instead of calling it bare.
/// Safety: the pool's slots are synchronized, so a handle can move between workers.
@unsafeGuarantee(Copy, Send, Sync)
pub type BlockingPool

/// `run`'s only failure: the pool already has `capacity` results outstanding.
pub type BlockingError = | CapacityExhausted

pub fn BlockingError.message(self) -> String {
    match self {
        CapacityExhausted -> "blocking pool capacity exhausted"
    }
}

/// Creates a pool that admits at most capacity closures at once; a closure holds its slot from `run` until its result Future is awaited or dropped, not merely until the closure returns.
pub fn BlockingPool.new(capacity: usize) -> BlockingPool

/// Runs work through the pool's boundary instead of a bare direct call; work may capture move-only values such as a File or Conn, and is consumed. Work and its result must be Send under every executor: work may capture copies of Send values and Send values moved into it, but not a Shared or a borrow, not a variable written inside or outside it, and not a move-only value it only reads unless it is a `move` closure; an `Error` box cannot be its failure. Under a `threadPoolExecutor` it runs on a thread of its own, so awaiting the result suspends the task and the workers keep running other tasks; under `currentThreadExecutor`, or outside a running task, it runs on the caller before `run` returns. Dropping a result that is still pending waits for the closure, since blocking work cannot be interrupted.
pub fn BlockingPool.run[T: Send, F: FnOnce[fn() -> T] + Send](self, work: F) -> Result[Future[T], BlockingError]

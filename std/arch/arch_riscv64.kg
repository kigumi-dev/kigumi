pub fn pause() {
    panic("pause is only implemented on x86-64")
}

/// Halts the CPU; only x86-64 has this instruction.
pub unsafe fn hlt() {
    panic("hlt is only implemented on x86-64")
}

/// Reads a model-specific register; only x86-64 has this instruction.
pub unsafe fn rdmsr(msr: u32) -> u64 {
    panic("rdmsr is only implemented on x86-64")
}

/// Writes a model-specific register; only x86-64 has this instruction.
pub unsafe fn wrmsr(msr: u32, value: u64) {
    panic("wrmsr is only implemented on x86-64")
}

/// Invalidates a TLB entry; only x86-64 has this instruction.
pub unsafe fn invlpg(page: usize) {
    panic("invlpg is only implemented on x86-64")
}


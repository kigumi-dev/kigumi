type Tsc = {
    lo u32
    hi u32
}

/// Runs CPUID for leaf and subleaf.
pub fn cpuid(leaf: u32, subleaf: u32) -> Cpuid {
    // rbx is the code generator's own register, so the template parks it on the
    // stack and copies CPUID's output through r11.
    let r: Cpuid = unsafe {
        asm {
            "push rbx"
            "cpuid"
            "mov r11d, ebx"
            "pop rbx"
            eax: inout(eax) leaf
            ecx: inout(ecx) subleaf
            ebx: out(r11d)
            edx: out(edx)
        }
    }
    r
}

/// Reads the time-stamp counter.
pub fn rdtsc() -> u64 {
    let r: Tsc = unsafe {
        asm {
            "rdtsc"
            lo: out(eax)
            hi: out(edx)
            options nostack, preserves_flags
        }
    }
    (r.hi.toU64() << 32) | r.lo.toU64()
}

/// Spins the CPU until the next interrupt or memory write.
pub fn pause() {
    unsafe {
        asm {
            "pause"
            options nostack, preserves_flags
        }
    }
}

/// Halts the CPU until the next interrupt; privileged.
pub unsafe fn hlt() {
    unsafe {
        asm {
            "hlt"
            options nostack
        }
    }
}

type Msr = {
    eax u32
    edx u32
}

type PortByte = {
    value u8
}

/// Reads a model-specific register; privileged.
pub unsafe fn rdmsr(msr: u32) -> u64 {
    let r: Msr = unsafe {
        asm {
            "rdmsr"
            ecx: in(ecx) msr
            eax: out(eax)
            edx: out(edx)
            options nostack, preserves_flags
        }
    }
    (r.edx.toU64() << 32) | r.eax.toU64()
}

/// Writes a model-specific register; privileged.
pub unsafe fn wrmsr(msr: u32, value: u64) {
    unsafe {
        asm {
            "wrmsr"
            ecx: in(ecx) msr
            eax: in(eax) (value & 0xffffffff).toU32() || 0
            edx: in(edx) (value >> 32).toU32() || 0
            options nostack, preserves_flags
        }
    }
}

/// Invalidates the TLB entry for page; privileged.
pub unsafe fn invlpg(page: usize) {
    unsafe {
        asm {
            "invlpg [{page}]"
            page: in(reg) page
        }
    }
}

/// Reads a byte from an I/O port; privileged.
pub unsafe fn inb(port: u16) -> u8 {
    let r: PortByte = unsafe {
        asm {
            "in al, dx"
            port: in(dx) port
            value: out(al)
            options nostack
        }
    }
    r.value
}

/// Writes a byte to an I/O port; privileged.
pub unsafe fn outb(port: u16, value: u8) {
    unsafe {
        asm {
            "out dx, al"
            port: in(dx) port
            value: in(al) value
            options nostack
        }
    }
}

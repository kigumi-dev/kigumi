type Tsc = {
    lo u32
    hi u32
}

/// Runs CPUID for leaf and subleaf.
pub fn cpuid(leaf: u32, subleaf: u32) -> Cpuid {
    // rbx is the code generator's own register, so the template parks it on the
    // stack and copies CPUID's output through r11.
    let r: Cpuid = unsafe {
        asm {
            "push rbx"
            "cpuid"
            "mov r11d, ebx"
            "pop rbx"
            eax: inout(eax) leaf
            ecx: inout(ecx) subleaf
            ebx: out(r11d)
            edx: out(edx)
        }
    }
    r
}

/// Reads the time-stamp counter.
pub fn rdtsc() -> u64 {
    let r: Tsc = unsafe {
        asm {
            "rdtsc"
            lo: out(eax)
            hi: out(edx)
            options nostack, preserves_flags
        }
    }
    (r.hi.toU64() << 32) | r.lo.toU64()
}

/// Spins the CPU until the next interrupt or memory write.
pub fn pause() {
    unsafe {
        asm {
            "pause"
            options nostack, preserves_flags
        }
    }
}

/// Halts the CPU until the next interrupt; privileged.
pub unsafe fn hlt() {
    unsafe {
        asm {
            "hlt"
            options nostack
        }
    }
}

type Msr = {
    eax u32
    edx u32
}

type PortByte = {
    value u8
}

/// Reads a model-specific register; privileged.
pub unsafe fn rdmsr(msr: u32) -> u64 {
    let r: Msr = unsafe {
        asm {
            "rdmsr"
            ecx: in(ecx) msr
            eax: out(eax)
            edx: out(edx)
            options nostack, preserves_flags
        }
    }
    (r.edx.toU64() << 32) | r.eax.toU64()
}

/// Writes a model-specific register; privileged.
pub unsafe fn wrmsr(msr: u32, value: u64) {
    unsafe {
        asm {
            "wrmsr"
            ecx: in(ecx) msr
            eax: in(eax) (value & 0xffffffff).toU32() || 0
            edx: in(edx) (value >> 32).toU32() || 0
            options nostack, preserves_flags
        }
    }
}

/// Invalidates the TLB entry for page; privileged.
pub unsafe fn invlpg(page: usize) {
    unsafe {
        asm {
            "invlpg [{page}]"
            page: in(reg) page
        }
    }
}

/// Reads a byte from an I/O port; privileged.
pub unsafe fn inb(port: u16) -> u8 {
    let r: PortByte = unsafe {
        asm {
            "in al, dx"
            port: in(dx) port
            value: out(al)
            options nostack
        }
    }
    r.value
}

/// Writes a byte to an I/O port; privileged.
pub unsafe fn outb(port: u16, value: u8) {
    unsafe {
        asm {
            "out dx, al"
            port: in(dx) port
            value: in(al) value
            options nostack
        }
    }
}

type Random = {
    value u64
    ok u8
}

type Control = {
    value u64
}

fn readCr0() -> u64 {
    let r: Control = unsafe {
        asm {
            "mov {value}, cr0"
            value: out(r11)
        }
    }
    r.value
}

fn readCr2() -> u64 {
    let r: Control = unsafe {
        asm {
            "mov {value}, cr2"
            value: out(r11)
        }
    }
    r.value
}

fn readCr3() -> u64 {
    let r: Control = unsafe {
        asm {
            "mov {value}, cr3"
            value: out(r11)
        }
    }
    r.value
}

fn readCr4() -> u64 {
    let r: Control = unsafe {
        asm {
            "mov {value}, cr4"
            value: out(r11)
        }
    }
    r.value
}

fn readCr8() -> u64 {
    let r: Control = unsafe {
        asm {
            "mov {value}, cr8"
            value: out(r11)
        }
    }
    r.value
}

fn writeCr0(value: u64) {
    unsafe {
        asm {
            "mov cr0, {value}"
            value: in(r11) value
        }
    }
}

fn writeCr2(value: u64) {
    unsafe {
        asm {
            "mov cr2, {value}"
            value: in(r11) value
        }
    }
}

fn writeCr3(value: u64) {
    unsafe {
        asm {
            "mov cr3, {value}"
            value: in(r11) value
        }
    }
}

fn writeCr4(value: u64) {
    unsafe {
        asm {
            "mov cr4, {value}"
            value: in(r11) value
        }
    }
}

fn writeCr8(value: u64) {
    unsafe {
        asm {
            "mov cr8, {value}"
            value: in(r11) value
        }
    }
}

/// Reads a hardware random value; None when the CPU has no entropy ready.
pub fn rdrand() -> u64? {
    let r: Random = unsafe {
        asm {
            "rdrand {value}"
            "setc {ok}"
            value: out(r11)
            ok: out(r10b)
            options nostack
        }
    }
    if r.ok == 0 {
        None
    } else {
        Some(r.value)
    }
}

/// Reads control register n; privileged.
pub unsafe fn readCr(n: u32) -> usize {
    let v = match n {
        0 -> readCr0()
        2 -> readCr2()
        3 -> readCr3()
        4 -> readCr4()
        8 -> readCr8()
        _ -> panic("control register must be 0, 2, 3, 4 or 8")
    }
    v.toUsize()
}

/// Writes control register n; privileged.
pub unsafe fn writeCr(n: u32, value: usize) {
    let v = value.toU64()
    match n {
        0 -> writeCr0(v)
        2 -> writeCr2(v)
        3 -> writeCr3(v)
        4 -> writeCr4(v)
        8 -> writeCr8(v)
        _ -> panic("control register must be 0, 2, 3, 4 or 8")
    }
}

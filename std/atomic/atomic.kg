/// The orders an atomic load accepts.
pub type LoadOrder =
    | Relaxed
    | Acquire
    | SeqCst

/// The orders an atomic store accepts.
pub type StoreOrder =
    | Relaxed
    | Release
    | SeqCst

/// The orders a read-modify-write operation accepts.
pub type RmwOrder =
    | Relaxed
    | Acquire
    | Release
    | AcqRel
    | SeqCst

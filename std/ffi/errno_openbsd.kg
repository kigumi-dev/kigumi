extern(C) {
    fn strerror(code: i32) -> *const u8
    fn __errno() -> *mut i32
}

/// The C errno of the calling thread.
pub fn errno() -> i32 {
    unsafe {
        readI32(toConst(__errno()))
    }
}

/// Sets errno to 0; call before a C function that reports failure by
/// clearing errno and leaving it clear, e.g. readdir(3) at end of stream.
pub fn clearErrno() {
    unsafe {
        writeI32(__errno(), 0)
    }
}

fn osErrorText(code: i32) -> String {
    unsafe {
        string(strerror(code))
    }
}

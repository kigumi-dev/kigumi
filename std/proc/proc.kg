/// Child processes. POSIX targets implement `spawn`, `wait` and `signal` with
/// fork/execvp through `std/platform`; other targets report
/// `Error.Unsupported`. The VM has no fork, so process code is native-only.
/// A process is not reaped until `wait` is called, so keep the handle and wait.
import platform from std/platform

pub type Signal =
    | Interrupt
    | Terminate
    | Kill

/// The signal number this platform's wait status reports.
pub fn Signal.number(self) -> i32 {
    match self {
        Interrupt -> 2
        Terminate -> 15
        Kill -> 9
    }
}

/// The process-spawning capability obtained from `host.processes()`.
pub type Processes = {}

pub type Error = {
    pub text String
}

pub fn Error.message(self) -> String {
    self.text
}

/// A child process created by `spawn`; `pid` is public so a diagnostic can
/// identify it before the first wait.
pub type Process = {
    pub pid i32
    mut waited Bool
    mut status Int
}

pub fn Process.id(self) -> i32 {
    self.pid
}

pub fn Process.reaped(self) -> Bool {
    self.waited
}

pub fn Processes.spawn(self, program: String, args: Array[String]) -> Process! {
    let pid = match platform.spawnProcess(program, args) {
        Ok(pid) -> pid
        Err(e) -> fail Error { text: e.message() }
    }
    Process {
        pid: pid
        waited: false
        status: 0
    }
}

pub fn Process.wait(mut self) -> Int! {
    if self.waited {
        return self.status
    }
    self.status = match platform.waitProcess(self.pid) {
        Ok(status) -> status
        Err(e) -> fail Error { text: e.message() }
    }
    self.waited = true
    self.status
}

pub fn Process.signal(self, signal: Signal) -> Void! {
    if self.waited {
        return
    }
    match platform.signalProcess(self.pid, signal.number()) {
        Ok(_) -> {}
        Err(e) -> fail Error { text: e.message() }
    }
}

/// Spawns program, waits for it, and returns its status.
pub fn Processes.run(self, program: String, args: Array[String]) -> Int! {
    let mut child = self.spawn(program, args)?
    child.wait()
}

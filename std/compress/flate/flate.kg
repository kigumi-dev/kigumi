/// Largest output `inflate` and `Inflater.new` accept, in bytes.
pub const defaultLimit: usize = 268435456

/// Why a stream could not be decoded or a size limit was hit.
pub type Error = {
    pub text String
}

pub fn Error.message(self) -> String {
    self.text
}

/// What `inflateFrom` decoded, where the deflate stream ended, and the bytes
/// that followed it.
pub type InflateResult = {
    pub data Bytes
    pub end usize
    pub rest Bytes
}

/// Decodes one raw DEFLATE stream (RFC 1951) of stored, fixed-Huffman and
/// dynamic-Huffman blocks with the default output limit. Bytes after the
/// final block are ignored; a malformed stream is an `Error`, never a panic.
pub fn inflate(data: Bytes) -> Bytes! {
    inflateLimit(data, defaultLimit)
}

/// Decodes one raw DEFLATE stream, refusing to produce more than `limit` bytes.
pub fn inflateLimit(data: Bytes, limit: usize) -> Bytes! {
    let mut inf = Inflater.newLimit(limit)
    inf.update(data)?
    inf.finish()
}

/// Decodes the DEFLATE stream that starts at `start`, and reports the offset
/// just past it plus the remaining bytes, so a container format can read what
/// follows (the gzip trailer, or the next member). `before` bytes the caller
/// already decoded count toward `limit`, which an overrun error names.
pub fn inflateFrom(data: Bytes, start: usize, before: usize, limit: usize) -> InflateResult! {
    if start > data.len() {
        fail Error { text: "flate: start offset ${start} is past the ${data.len()} byte input" }
    }
    let mut inf = Inflater.within(before, limit)
    inf.bits.data = data
    inf.bits.pos = start
    inf.bits.ended = true
    if !inf.run()? {
        fail Error { text: "flate: input ends in the middle of the stream" }
    }
    let end = inf.streamEnd()
    let rest = inf.bits.data.slice(end, inf.bits.data.len()) || Bytes.zeros(0)
    InflateResult {
        data: Bytes.fromArray(&inf.out)
        end: end
        rest: rest
    }
}

/// Compresses `data` deterministically: one fixed-Huffman block with greedy
/// LZ77 matches, or stored blocks when those are smaller.
pub fn deflate(data: Bytes) -> Bytes {
    let fixed = encodeFixed(&data)
    if fixed.len() <= data.len() + 5 {
        return fixed
    }
    let stored = encodeStored(&data)
    if stored.len() < fixed.len() {
        stored
    } else {
        fixed
    }
}

/// Growable ordered sequence of T.
pub type Array[T]

/// A copy of the array; the elements are Copy, so nothing is shared.
pub pure fn Array[T: Copy].clone(self) -> Array[T] {
    self.tryClone() || panic("out of memory")
}

/// A copy of the array, or AllocError when the allocator refuses (clone panics instead).
pub pure fn Array[T: Copy].tryClone(self) -> Result[Array[T], AllocError]

/// A copy of the array whose elements f builds from a borrow of each original.
pub pure fn Array[T].cloneWith(self, f: fn(&T) -> T) -> Array[T] {
    self.map(f)
}

/// A copy whose elements f builds from a borrow of each original, or AllocError when the allocator refuses (cloneWith panics instead).
pub pure fn Array[T].tryCloneWith(self, f: fn(&T) -> T) -> Result[Array[T], AllocError] {
    self.tryMap(f)
}

/// Creates an empty array.
pub pure fn Array.empty[T]() -> Array[T]

/// Creates an array holding the given items in order.
pub pure fn Array.of[T](items: ...T) -> Array[T]

/// n copies of value.
pub pure fn Array.fill[T: Copy](value: T, n: usize) -> Array[T] {
    Array.tryFill(value, n) || panic("out of memory")
}

/// n copies of value, or AllocError when the allocator refuses (fill panics instead).
pub pure fn Array.tryFill[T: Copy](value: T, n: usize) -> Result[Array[T], AllocError] {
    let mut out = Array.tryWithCapacity[T](n)?
    let mut i: usize = 0
    for i < n {
        out.push(value)
        i = i + 1
    }
    AllocError.wrap(out)
}

/// An empty array with room for capacity elements, or AllocError when the allocator refuses.
pub pure fn Array.tryWithCapacity[T](capacity: usize) -> Result[Array[T], AllocError]

/// Copies of self[start..end], the range clamped to the array; AllocError when the allocator refuses.
pure fn Array[T: Copy].tryCopyRange(self, start: usize, end: usize) -> Result[Array[T], AllocError]

/// Copy with the elements in reverse order, or AllocError when the allocator refuses (reverse panics instead).
pub pure fn Array[T: Copy].tryReverse(self) -> Result[Array[T], AllocError]

/// Appends item at the end; panics when memory runs out (tryPush reports it instead).
pub pure fn Array[T].push(mut self, item: T)

/// Makes room for extra more elements; false when the allocator refuses.
pure fn Array[T].growBy(mut self, extra: usize) -> Bool

/// Appends item, or returns AllocError when memory runs out.
pub pure fn Array[T].tryPush(mut self, item: T) -> Result[Void, AllocError] {
    if !self.growBy(1) {
        return Err(AllocError.OutOfMemory)
    }
    self.push(item)
}

/// Reserves room for extra more elements without adding any.
pub pure fn Array[T].tryReserve(mut self, extra: usize) -> Result[Void, AllocError] {
    if !self.growBy(extra) {
        return Err(AllocError.OutOfMemory)
    }
}

/// Moves the elements of other into self.
pub pure fn Array[T].appendAll(mut self, other: Array[T]) {
    self.tryAppendAll(other) || panic("out of memory")
}

/// Moves the elements of other into self, or AllocError when the allocator refuses.
pub pure fn Array[T].tryAppendAll(mut self, other: Array[T]) -> Result[Void, AllocError]

/// Inserts item before the element at index, shifting the later ones up; false when index is past the end. Panics when memory runs out (tryInsertAt reports it instead).
pub pure fn Array[T].insertAt(mut self, index: usize, item: T) -> Bool {
    self.tryInsertAt(index, item) || panic("out of memory")
}

/// Same as insertAt, or AllocError when the allocator refuses; the array is unchanged then.
pub pure fn Array[T].tryInsertAt(mut self, index: usize, item: T) -> Result[Bool, AllocError]

/// Number of elements.
pub pure noalloc fn Array[T].len(self) -> usize

/// A copy of the element at index, or None when index is out of range.
pub pure noalloc fn Array[T: Copy].get(self, index: usize) -> T?

/// Calls f once with a borrow of the element at index and does not keep it (f is non-escaping); None when index is out of range.
pub pure fn Array[T].with[R](self, index: usize, f: fn(&T) -> R) -> R?

/// Calls f once with an exclusive borrow of the element at index, so f can mutate it in place, and does not keep it; None when index is out of range.
pub pure fn Array[T].withMut[R](mut self, index: usize, f: fn(&mut T) -> R) -> R?

/// Moves the element at index out, closing the gap; None when index is out of range.
pub pure fn Array[T].takeAt(mut self, index: usize) -> T?

/// The first count elements, or all of them when the array is shorter.
pub pure fn Array[T: Copy].take(self, count: usize) -> Array[T] {
    self.tryTake(count) || panic("out of memory")
}

/// The first count elements, or all of them when the array is shorter; AllocError when the allocator refuses (take panics instead).
pub pure fn Array[T: Copy].tryTake(self, count: usize) -> Result[Array[T], AllocError] {
    self.tryCopyRange(0, count)
}

/// Applies f to a borrow of every element and collects the results in order; f cannot move an element out (use `for` to consume them) and is not kept.
pub pure fn Array[T].map[U](self, f: fn(&T) -> U) -> Array[U] {
    self.tryMap(f) || panic("out of memory")
}

/// Applies f to every element and collects the results in order, or AllocError when the allocator refuses (map panics instead).
pub pure fn Array[T].tryMap[U](self, f: fn(&T) -> U) -> Result[Array[U], AllocError]

/// Sorted copy of items; order decides which of two elements comes first.
pub pure fn sortedBy[T: Copy](items: &Array[T], order: fn(&T, &T) -> Ordering) -> Array[T] {
    trySortedBy(items, order) || panic("out of memory")
}

/// Same as sortedBy, or AllocError when the allocator refuses (sortedBy panics instead).
pub pure fn trySortedBy[T: Copy](items: &Array[T], order: fn(&T, &T) -> Ordering) -> Result[Array[T], AllocError]

/// Elements for which keep returns true, in the original order.
pub pure fn Array[T: Copy].filter(self, keep: fn(&T) -> Bool) -> Array[T] {
    self.tryFilter(keep) || panic("out of memory")
}

/// Elements for which keep returns true, in the original order, or AllocError when the allocator refuses (filter panics instead).
pub pure fn Array[T: Copy].tryFilter(self, keep: fn(&T) -> Bool) -> Result[Array[T], AllocError]

/// Reduces the array left to right, starting from init; step borrows each element and cannot move it out (use `for` to consume them).
pub pure fn Array[T].fold[A, F: FnMut[fn(A, &T) -> A]](self, init: A, mut step: F) -> A {
    let mut acc = init
    for item in &self {
        acc = step(acc, item)
    }
    acc
}

/// Element-wise equality; satisfies `Eq` when T does.
pub pure fn Array[T: Eq].equals(self, other: &Array[T]) -> Bool {
    if self.len() != other.len() {
        return false
    }
    let mut i: usize = 0
    for i < self.len() {
        let same = self.with(i, (a: &T) => other.with(i, (b: &T) => a.equals(b)) is Some(true))
        if same is Some(true) {
            i = i + 1
        } else {
            return false
        }
    }
    true
}

/// Hash over the elements in order; satisfies `Hash` when T does.
pub pure fn Array[T: Hash].hash(self) -> u64 {
    let mut h: u64 = 14695981039346656037
    let mut i: usize = 0
    for i < self.len() {
        h = (h ^ (self.with(i, (a: &T) => hash(a)) || 0)).wrappingMul(1099511628211)
        i = i + 1
    }
    h
}

/// Whether some element equals item.
pub pure fn Array[T: Eq].contains(self, item: T) -> Bool {
    for x in &self {
        if x.equals(&item) {
            return true
        }
    }
    false
}

/// Copy with the elements in reverse order.
pub pure fn Array[T: Copy].reverse(self) -> Array[T] {
    self.tryReverse() || panic("out of memory")
}

/// The first element, or None when the array is empty.
pub pure noalloc fn Array[T: Copy].first(self) -> T?

/// The last element, or None when the array is empty.
pub pure noalloc fn Array[T: Copy].last(self) -> T?

/// Whether the array has no elements.
pub pure noalloc fn Array[T].isEmpty(self) -> Bool {
    self.len() == 0
}

/// Copies of self[start..end]; None unless start <= end <= self.len().
pub pure fn Array[T: Copy].slice(self, start: usize, end: usize) -> Array[T]? {
    self.trySlice(start, end) || panic("out of memory")
}

/// Copies of self[start..end]; Ok(None) unless start <= end <= self.len(), AllocError when the allocator refuses (slice panics instead).
pub pure fn Array[T: Copy].trySlice(self, start: usize, end: usize) -> Result[Array[T]?, AllocError]

/// New array holding the elements of self followed by those of other.
pub pure fn Array[T: Copy].concat(self, other: Array[T]) -> Array[T] {
    self.tryConcat(other) || panic("out of memory")
}

/// New array holding the elements of self followed by those of other, or AllocError when the allocator refuses (concat panics instead).
pub pure fn Array[T: Copy].tryConcat(self, other: Array[T]) -> Result[Array[T], AllocError]

/// Concatenates items with sep between consecutive elements.
pub pure fn join(items: &Array[String], sep: String) -> String {
    tryJoin(items, sep) || panic("out of memory")
}

/// Same as join, or AllocError when the allocator refuses (join panics instead).
pub pure fn tryJoin(items: &Array[String], sep: String) -> Result[String, AllocError] {
    let mut total: usize = 0
    for s in items {
        total = total + s.len()
    }
    if items.len() > 1 {
        total = total + (items.len() - 1) * sep.len()
    }
    let mut buf = ByteBuffer.tryNew(total)?
    let mut o: usize = 0
    let mut first = true
    for s in items {
        if !first {
            buf.copyFromString(o, sep, 0, sep.len())
            o = o + sep.len()
        }
        first = false
        buf.copyFromString(o, s, 0, s.len())
        o = o + s.len()
    }
    AllocError.wrap(buf.freezeString())
}

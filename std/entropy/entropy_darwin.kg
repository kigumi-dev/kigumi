import ffi from std/ffi

extern(C) {
    fn getentropy(buf: *mut u8, len: usize) -> i32
}

/// Fills buf with getentropy(2); the syscall accepts at most 256 bytes at a time.
fn fillEntropy(buf: *mut u8, n: usize) -> Void! {
    let mut off: usize = 0
    for off < n {
        let left = n - off
        let chunk = if left < 256 {
            left
        } else {
            256
        }
        let rc = unsafe {
            getentropy(ffi.toMut(ffi.offset(ffi.toConst(buf), off.toInt() || 0)), chunk)
        }
        if rc != 0 {
            fail ffi.lastError()
        }
        off = off + chunk
    }
}

import ffi from std/ffi
import platform from std/platform

extern(C) {
    fn getrandom(buf: *mut u8, buflen: usize, flags: u32) -> isize
    fn open(path: *const u8, flags: i32, ...) -> i32
    fn read(fd: i32, buf: *mut u8, n: usize) -> isize
    fn close(fd: i32) -> i32
}

fn fillFromUrandom(buf: *mut u8, start: usize, n: usize) -> Void! {
    let path = "/dev/urandom"
    let c = ffi.CString.new(&path)?
    let fd = unsafe {
        open(c.ptr(), 0)
    }
    if fd < 0 {
        fail ffi.lastError()
    }
    let mut off = start
    for off < n {
        let got = unsafe {
            read(fd, ffi.toMut(ffi.offset(ffi.toConst(buf), off.toInt() || 0)), n - off)
        }
        if got < 0 && ffi.errno() == platform.eintr() {
            continue
        }
        if got <= 0 {
            _ = unsafe {
                close(fd)
            }
            fail ffi.lastError()
        }
        off = off + (got.toUsize() || 0)
    }
    _ = unsafe {
        close(fd)
    }
}

/// Fills buf from getrandom(2), falling back to /dev/urandom for an old kernel.
fn fillEntropy(buf: *mut u8, n: usize) -> Void! {
    let mut off: usize = 0
    for off < n {
        let got = unsafe {
            getrandom(ffi.toMut(ffi.offset(ffi.toConst(buf), off.toInt() || 0)), n - off, 0)
        }
        if got < 0 && ffi.errno() == platform.eintr() {
            continue
        }
        if got <= 0 {
            break
        }
        off = off + (got.toUsize() || 0)
    }
    if off < n {
        fillFromUrandom(buf, off, n)?
    }
}

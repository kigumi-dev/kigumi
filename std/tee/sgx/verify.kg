/// The verifier's view of an enclave plus the QE that signed its quote.
pub type Claims = {
    pub cpuSvn Bytes
    pub miscSelect u32
    pub attributes Bytes
    pub mrEnclave Bytes
    pub mrSigner Bytes
    pub isvProdId u16
    pub isvSvn u16
    pub reportData Bytes
    pub debug Bool
    pub qeSvn u16
    pub pceSvn u16
    pub qeMrSigner Bytes
    pub qeIsvProdId u16
    pub qeIsvSvn u16
}

/// A quote the policy accepted; `advisoryIds` lists the platform's then the
/// QE's.
pub type VerificationResult = {
    pub status AcceptableStatus
    pub claims Claims
    pub appraisal Appraisal
    pub advisoryIds Array[String]
}

pure fn claimsOf(quoteReport: &Report, qeReport: &Report, qeSvn: u16, pceSvn: u16) -> Claims {
    Claims {
        cpuSvn: quoteReport.cpuSvn
        miscSelect: quoteReport.miscSelect
        attributes: quoteReport.attributes
        mrEnclave: quoteReport.mrEnclave
        mrSigner: quoteReport.mrSigner
        isvProdId: quoteReport.isvProdId
        isvSvn: quoteReport.isvSvn
        reportData: quoteReport.reportData
        debug: quoteReport.debug()
        qeSvn: qeSvn
        pceSvn: pceSvn
        qeMrSigner: qeReport.mrSigner
        qeIsvProdId: qeReport.isvProdId
        qeIsvSvn: qeReport.isvSvn
    }
}

pure fn terminalFailure(status: Status) -> Error {
    match status {
        Status.Unevaluated -> failure(MissingCollateral, "the quote is unevaluated: the policy supplies no collateral")
        _ -> failure(TcbRevoked, "TCB status ${status.name()} is terminal")
    }
}

/// Verifies a quote, its QE report and PCK chain, the policy claims and the
/// collateral; there is no Ok result without authenticated collateral.
pub fn verify(quoteBytes: Bytes, policy: &Policy) -> Result[VerificationResult, Error] {
    let quote = Quote.parse(quoteBytes)?
    verifyQuoteSignature(&quote)?
    if policy.requireIntelQeVendor && !isIntelQeVendorId(quote.header.qeVendorId) {
        fail failure(PolicyRejected, "QE vendor ID is not Intel's")
    }
    let qe = qeCertificationOf(&quote)?
    let verified = verifyQe(&qe, quote.attestationKey)?
    let anchors = parseAnchors(policy.pckAnchorsPem)?
    let qeReport = move verified.report
    let chain = move verified.chain
    let anchor = chain.verifyTo(&anchors, policy.nowMillis)?
    let claims = claimsOf(&quote.report, &qeReport, quote.header.qeSvn, quote.header.pceSvn)
    checkClaims(&claims, policy)?

    let collateral = match &policy.collateral {
        Some(value) -> value
        None -> fail terminalFailure(Status.Unevaluated)
    }
    let appraised = appraise(collateral, &chain, &anchors[anchor], &qeReport, policy)?
    let status = match appraised.status.acceptable() {
        Some(value) -> value
        None -> fail terminalFailure(appraised.status)
    }
    if !policy.accepts(status) {
        fail failure(StatusRejected, "TCB status ${status.name()} is not accepted by the policy")
    }
    let mut advisoryIds = appraised.appraisal.platform.advisoryIds.clone()
    advisoryIds.appendAll(appraised.appraisal.qe.advisoryIds.clone())
    Ok(VerificationResult {
        status: status
        claims: claims
        appraisal: move appraised.appraisal
        advisoryIds: advisoryIds
    })
}

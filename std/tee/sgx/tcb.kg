// TCB Info after Intel QVL TcbInfo; levels are kept in QVL's order, highest
// component SVNs first, so the first level a platform reaches is QVL's choice.
import hex from std/encoding/hex
import json from std/json

/// One SGX TCB level.
pub type TcbLevel = {
    pub components Bytes
    pub pceSvn u16
    pub tcbDate String
    pub tcbDateMillis Int
    pub status TcbStatus
    pub advisoryIds Array[String]
}

/// A structurally valid SGX TCB Info document (version 2 or 3). Only
/// `parseVerified` and the collateral appraisal check its signature.
pub type TcbInfo = {
    pub version u32
    pub issueDateMillis Int
    pub nextUpdateMillis Int
    pub fmspc Bytes
    pub pceId Bytes
    pub tcbEvaluationDataNumber u32
    pub tcbLevels Array[TcbLevel]
}

/// The TCB level a platform reached.
pub type TcbEvaluation = {
    pub status TcbStatus
    pub tcbDate String
    pub tcbDateMillis Int
    pub advisoryIds Array[String]
}

pure fn hexField(text: String, field: String, expected: usize, code: Code) -> Result[Bytes, Error] {
    let value = match hex.decode(text) {
        Ok(bytes) -> bytes
        Err(err) -> fail failure(code, "${field}: ${err.message()}")
    }
    if value.len() != expected {
        fail failure(code, "${field} must be ${expected} bytes, got ${value.len()}")
    }
    Ok(value)
}

/// Positive when `a` sorts above `b` in QVL's level order: component SVNs
/// compared lexicographically, then the PCE SVN.
pure fn levelOrder(a: &TcbLevel, b: &TcbLevel) -> Int {
    let mut i: usize = 0
    for i < 16 {
        if a.components[i] != b.components[i] {
            return a.components[i].toInt() - b.components[i].toInt()
        }
        i = i + 1
    }
    a.pceSvn.toInt() - b.pceSvn.toInt()
}

pure fn insertLevel(levels: &mut Array[TcbLevel], level: TcbLevel) -> Result[Void, Error] {
    let mut at: usize = 0
    for at < levels.len() {
        let order = levelOrder(&level, &levels[at])
        if order == 0 {
            fail failure(BadTcbInfo, "duplicate TCB level")
        }
        if order > 0 {
            break
        }
        at = at + 1
    }
    if !levels.insertAt(at, level) {
        fail failure(BadTcbInfo, "TCB level position is out of range")
    }
}

pure fn decodeLevel(level: &TcbLevelJson, version: u32) -> Result[TcbLevel, Error] {
    if level.tcb.shape != version {
        fail failure(BadTcbInfo, "TCB level layout does not match TCB Info version ${version}")
    }
    Ok(TcbLevel {
        components: level.tcb.components
        pceSvn: level.tcb.pcesvn
        tcbDate: level.tcbDate
        tcbDateMillis: collateralDate(level.tcbDate, "tcbDate", BadTcbInfo)?
        status: statusFromText(level.tcbStatus, BadTcbInfo)?
        advisoryIds: match &level.advisoryIDs {
            Some(ids) -> ids.clone()
            None -> Array.empty[String]()
        }
    })
}

pure fn checkTcbInfoShape(doc: &TcbInfoBodyJson) -> Result[Void, Error] {
    if doc.version != 2 && doc.version != 3 {
        fail failure(BadTcbInfo, "TCB Info version ${doc.version} is not supported (need 2 or 3)")
    }
    if doc.version == 3 {
        match doc.id {
            Some(id) -> {
                if id == "TDX" {
                    fail failure(TcbInfoMismatch, "TCB Info is issued for TDX, not SGX")
                }
                if id != "SGX" {
                    fail failure(BadTcbInfo, "TCB Info id `${id}` is not supported")
                }
            }
            None -> fail failure(BadTcbInfo, "TCB Info version 3 needs an id")
        }
    }
    if doc.tdxModule is Some(_) || doc.tdxModuleIdentities is Some(_) {
        fail failure(BadTcbInfo, "SGX TCB Info may not carry TDX module members")
    }
    if doc.tcbType != 0 {
        fail failure(BadTcbInfo, "TCB type ${doc.tcbType} is not supported")
    }
    if doc.tcbLevels.len() == 0 {
        fail failure(BadTcbInfo, "TCB Info has no TCB levels")
    }
}

/// Parses a PCS TCB Info document `{"tcbInfo": {...}, "signature": "..."}`
/// without checking the signature.
pub fn TcbInfo.parse(document: String) -> Result[TcbInfo, Error] {
    TcbInfo.fromSigned(splitSigned(document, "tcbInfo", BadTcbInfo, "TCB Info")?)
}

fn TcbInfo.fromSigned(signed: SignedJson) -> Result[TcbInfo, Error] {
    requireUniqueMembers(signed.body, BadTcbInfo, "TCB Info")?
    let doc = match json.decode[TcbInfoBodyJson](signed.body) {
        Ok(value) -> value
        Err(err) -> fail failure(BadTcbInfo, err.message())
    }
    checkTcbInfoShape(&doc)?
    let mut levels = Array.empty[TcbLevel]()
    for level in &doc.tcbLevels {
        insertLevel(&mut levels, decodeLevel(level, doc.version)?)?
    }
    Ok(TcbInfo {
        version: doc.version
        issueDateMillis: collateralDate(doc.issueDate, "issueDate", BadTcbInfo)?
        nextUpdateMillis: collateralDate(doc.nextUpdate, "nextUpdate", BadTcbInfo)?
        fmspc: hexField(doc.fmspc, "fmspc", 6, BadTcbInfo)?
        pceId: hexField(doc.pceId, "pceId", 2, BadTcbInfo)?
        tcbEvaluationDataNumber: doc.tcbEvaluationDataNumber
        tcbLevels: levels
    })
}

pure fn componentsReach(components: Bytes, level: &TcbLevel) -> Bool {
    if components.len() != 16 {
        return false
    }
    let mut i: usize = 0
    for i < 16 {
        if components[i] < level.components[i] {
            return false
        }
        i = i + 1
    }
    true
}

/// Selects the first level the PCK certificate's TCB reaches, as QVL does; a
/// platform below every level is `TcbNotSupported`.
pub fn TcbInfo.evaluate(self, components: Bytes, pceSvn: u16) -> Result[TcbEvaluation, Error] {
    for level in &self.tcbLevels {
        if componentsReach(components, level) && pceSvn >= level.pceSvn {
            return Ok(TcbEvaluation {
                status: level.status
                tcbDate: level.tcbDate
                tcbDateMillis: level.tcbDateMillis
                advisoryIds: level.advisoryIds.clone()
            })
        }
    }
    fail failure(TcbNotSupported, "no TCB level matches the platform TCB")
}

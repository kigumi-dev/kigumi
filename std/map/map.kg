/// Map from K to V; keys need `Eq` and `Hash`. Entries keep insertion order.
pub type Map[K: Eq + Hash, V] = {
    mut keyList Array[K]
    mut valueList Array[V]
    // slots is an open-addressing index of sequence number + 2 (0 free,
    // 1 removed); its length is a power of two.
    mut slots Array[usize]
    // seqList[pos] is the sequence number of entry pos after a removal; before that it is empty or the identity.
    mut seqList Array[usize]
    // meta is empty until the first insert, then [removals since the last reindex].
    mut meta Array[usize]
}

/// Same entries in any order; satisfies `Eq` when the values do.
pub pure fn Map[K: Eq + Hash, V: Eq].equals(self, other: &Map[K, V]) -> Bool {
    if self.len() != other.len() {
        return false
    }
    let mut i: usize = 0
    for i < self.keyList.len() {
        let same = self.keyList.with(i, (k: &K) => match other.position(k) {
            Some(pos) -> self.valueList.with(i, (v: &V) => other.valueList.with(pos, (ov: &V) => v.equals(ov)) is Some(true)) is Some(true)
            None -> false
        })
        if same is Some(true) {
            i = i + 1
        } else {
            return false
        }
    }
    true
}

/// Hash over the entries in any order; satisfies `Hash` when the values do.
pub pure fn Map[K: Eq + Hash, V: Hash].hash(self) -> u64 {
    let mut h: u64 = 0
    let mut i: usize = 0
    for i < self.keyList.len() {
        let kh = self.keyList.with(i, (k: &K) => hash(k)) || 0
        let vh = self.valueList.with(i, (v: &V) => hash(v)) || 0
        h = h.wrappingAdd((kh ^ vh.wrappingMul(31)).wrappingMul(1099511628211))
        i = i + 1
    }
    h
}

/// One key/value pair of a map, as returned by `entries`.
pub type Entry[K, V] = {
    pub key K
    pub value V
}

/// A copy of the map; keys and values are Copy, so nothing is shared.
pub pure fn Map[K: Copy, V: Copy].clone(self) -> Map[K, V] {
    self.tryClone() || panic("out of memory")
}

/// A copy of the map, or AllocError when the allocator refuses (clone panics instead); the original is untouched either way.
pub pure fn Map[K: Copy, V: Copy].tryClone(self) -> Result[Map[K, V], AllocError]

/// Creates an empty map.
pub pure fn empty[K: Eq + Hash, V]() -> Map[K, V] {
    tryEmpty() || panic("out of memory")
}

/// Creates an empty map, or AllocError when the allocator refuses (empty panics instead).
pub pure fn tryEmpty[K: Eq + Hash, V]() -> Result[Map[K, V], AllocError]

/// The per-process hash seed.
pure noalloc fn seed() -> u64

/// Spreads every bit of h over the low bits (the murmur3 finalizer), so hashes that agree only in their low bits do not share probe chains.
pure noalloc fn mix(h: u64) -> u64 {
    let a = h ^ h.wrappingShiftRight(33)
    let b = a.wrappingMul(0xff51afd7ed558ccd)
    let c = b ^ b.wrappingShiftRight(33)
    let d = c.wrappingMul(0xc4ceb9fe1a85ec53)
    d ^ d.wrappingShiftRight(33)
}

/// First slot of the probe sequence of a key with hash h in an index of size slots, under the per-process seed.
pure noalloc fn startSlot(h: u64, size: usize) -> usize {
    mix(h ^ seed()).toUsize() & (size - 1)
}

/// Entries removed since the last reindex; each left a dead slot and a gap in the sequence numbers.
pure noalloc fn gapOf(meta: &Array[usize]) -> usize {
    meta.get(0) || 0
}

/// The position of the entry with sequence number seq; the two agree until the first removal after a reindex.
pure fn seqPosition(seqList: &Array[usize], gap: usize, seq: usize) -> usize {
    if gap == 0 {
        return seq
    }
    let mut lo: usize = 0
    if seq > gap {
        lo = seq - gap
    }
    let mut hi = seqList.len()
    if seq + 1 < hi {
        hi = seq + 1
    }
    for lo + 1 < hi {
        let mid = lo + (hi - lo) / 2
        if seqList[mid] > seq {
            hi = mid
        } else {
            lo = mid
        }
    }
    lo
}

/// Records the entry with sequence number seq in the first free slot of its probe sequence; dead slots are not reused.
pure fn fileSlot(slots: &mut Array[usize], start: usize, seq: usize) {
    let mask = slots.len() - 1
    let mut i = start
    for slots[i] != 0 {
        i = (i + 1) & mask
    }
    slots[i] = seq + 2
}

/// Whether one more entry would fill the index past half, counting dead slots.
pure noalloc fn roomNeeded(live: usize, gap: usize, slots: usize) -> Bool {
    (live + gap + 1) * 2 > slots
}

/// The index size for live entries plus one; after removals it leaves at least as many free slots as live entries so rebuilding stays amortised.
pure noalloc fn indexSizeFor(live: usize, gap: usize) -> usize {
    let wanted = (live + 1) * 2
    let mut size: usize = 8
    for size < wanted {
        size = size * 2
    }
    if gap > 0 && wanted * 2 > size {
        size = size * 2
    }
    size
}

/// Opens the removal count on the first insert.
pure fn openMeta(meta: &mut Array[usize]) {
    if meta.len() == 0 {
        meta.push(0)
    }
}

/// The slot holding key, probing from start.
pure fn Map[K: Eq + Hash, V].findSlot(self, start: usize, key: &K) -> usize? {
    let mask = self.slots.len() - 1
    let mut i = start
    for {
        let s = self.slots[i]
        if s == 0 {
            return None
        }
        if s > 1 && (&self.keyList[seqPosition(&self.seqList, gapOf(&self.meta), s - 2)]).equals(key) {
            return Some(i)
        }
        i = (i + 1) & mask
    }
}

/// The position of the key with hash h among the entries, or None.
pure fn Map[K: Eq + Hash, V].positionHashed(self, h: u64, key: &K) -> usize? {
    if self.slots.len() == 0 {
        return None
    }
    let start = startSlot(h, self.slots.len())
    if self.findSlot(start, key) is Some(i) {
        return Some(seqPosition(&self.seqList, gapOf(&self.meta), self.slots[i] - 2))
    }
    None
}

/// The position of key among the entries, or None.
pure fn Map[K: Eq + Hash, V].position(self, key: &K) -> usize? {
    self.positionHashed(hash(key), key)
}

/// Installs a fresh index, renumbers the entries by position and files them all; allocates nothing.
pure fn Map[K: Eq + Hash, V].rebuild(mut self, slots: Array[usize]) {
    self.slots = slots
    self.meta[0] = 0
    let size = self.slots.len()
    let mut pos: usize = 0
    for pos < self.keyList.len() {
        if pos < self.seqList.len() {
            self.seqList[pos] = pos
        }
        let start = startSlot(hash(&self.keyList[pos]), size)
        fileSlot(&mut self.slots, start, pos)
        pos = pos + 1
    }
}

/// Appends a new entry with hash h; the index must have room.
pure fn Map[K: Eq + Hash, V].append(mut self, h: u64, key: K, value: V) {
    let gap = gapOf(&self.meta)
    let seq = self.keyList.len() + gap
    self.keyList.push(key)
    self.valueList.push(value)
    if gap > 0 {
        self.seqList.push(seq)
    }
    let start = startSlot(h, self.slots.len())
    fileSlot(&mut self.slots, start, seq)
}

/// Inserts value under key, replacing an existing value.
pub pure fn Map[K: Eq + Hash, V].set(mut self, key: K, value: V) {
    let h = hash(&key)
    if self.positionHashed(h, &key) is Some(pos) {
        self.valueList[pos] = value
        return
    }
    openMeta(&mut self.meta)
    if roomNeeded(self.keyList.len(), gapOf(&self.meta), self.slots.len()) {
        self.rebuild(Array.tryFill[usize](0, indexSizeFor(self.keyList.len(), gapOf(&self.meta))) || panic("out of memory"))
    }
    self.append(h, key, value)
}

/// Inserts value under key, or AllocError when the allocator refuses; the
/// map is left unchanged in that case (set panics instead).
pub pure fn Map[K: Eq + Hash, V].trySet(mut self, key: K, value: V) -> Result[Void, AllocError] {
    let h = hash(&key)
    if self.positionHashed(h, &key) is Some(pos) {
        self.valueList[pos] = value
    } else {
        if self.meta.len() == 0 {
            self.meta.tryReserve(1)?
        }
        self.keyList.tryReserve(1)?
        self.valueList.tryReserve(1)?
        if gapOf(&self.meta) > 0 {
            self.seqList.tryReserve(1)?
        }
        if roomNeeded(self.keyList.len(), gapOf(&self.meta), self.slots.len()) {
            // Build the bigger index before committing key/value, so a
            // refused allocation here still leaves the map untouched.
            let slots = Array.tryFill[usize](0, indexSizeFor(self.keyList.len(), gapOf(&self.meta)))?
            openMeta(&mut self.meta)
            self.rebuild(slots)
        }
        self.append(h, key, value)
    }
}

/// A copy of the value stored under key, or fallback when the key is absent.
pub pure fn Map[K: Eq + Hash, V: Copy].getOr(self, key: &K, fallback: V) -> V {
    self.get(key) || fallback
}

/// Replaces the value under key with f(old) in place, keeping its position, and returns the old value.
/// An absent key gets f(None) appended.
pub pure fn Map[K: Eq + Hash, V: Copy].update(mut self, key: K, f: fn(V?) -> V) -> V? {
    if self.position(&key) is Some(pos) {
        let old = self.valueList.get(pos)
        self.valueList[pos] = f(old)
        return old
    }
    self.set(key, f(None))
    None
}

/// A copy of the value stored under key, or None when the key is absent.
pub pure fn Map[K: Eq + Hash, V: Copy].get(self, key: &K) -> V? {
    if self.position(key) is Some(pos) {
        return self.valueList.get(pos)
    }
    None
}

/// Calls f with a borrow of the value under key; None when the key is absent.
pub pure fn Map[K: Eq + Hash, V].with[R](self, key: &K, f: fn(&V) -> R) -> R? {
    if self.position(key) is Some(pos) {
        return self.valueList.with(pos, f)
    }
    None
}

/// Moves the value under key out of the map; None when the key is absent.
/// The index slot is marked dead and the later entries shift down, so the cost is a copy of the tail rather than a rehash.
pub pure fn Map[K: Eq + Hash, V].take(mut self, key: &K) -> V? {
    if self.slots.len() == 0 {
        return None
    }
    let start = startSlot(hash(key), self.slots.len())
    if self.findSlot(start, key) is Some(i) {
        let pos = seqPosition(&self.seqList, gapOf(&self.meta), self.slots[i] - 2)
        for self.seqList.len() < self.keyList.len() {
            self.seqList.push(self.seqList.len())
        }
        self.slots[i] = 1
        _ = self.keyList.takeAt(pos)
        _ = self.seqList.takeAt(pos)
        self.meta[0] = self.meta[0] + 1
        return self.valueList.takeAt(pos)
    }
    None
}

/// Number of entries.
pub pure noalloc fn Map[K, V].len(self) -> usize {
    self.keyList.len()
}

/// Copies of all entries in insertion order.
pub pure fn Map[K: Copy, V: Copy].entries(self) -> Array[Entry[K, V]] {
    self.tryEntries() || panic("out of memory")
}

/// Copies of all entries in insertion order, or AllocError when the allocator refuses (entries panics instead).
pub pure fn Map[K: Copy, V: Copy].tryEntries(self) -> Result[Array[Entry[K, V]], AllocError]

/// Whether key is present.
pub pure fn Map[K: Eq + Hash, V].contains(self, key: &K) -> Bool {
    self.position(key) is Some(_)
}

/// Removes key and drops its value; does nothing when the key is absent.
pub pure fn Map[K: Eq + Hash, V].remove(mut self, key: &K) {
    _ = self.take(key)
}

/// Copies of all keys in insertion order; the values stay untouched.
pub pure fn Map[K: Copy, V].keys(self) -> Array[K] {
    self.keyList.clone()
}

/// Copies of all keys in insertion order, or AllocError when the allocator refuses (keys panics instead).
pub pure fn Map[K: Copy, V].tryKeys(self) -> Result[Array[K], AllocError] {
    self.keyList.tryClone()
}

/// Copies of all values in insertion order.
pub pure fn Map[K: Copy, V: Copy].values(self) -> Array[V] {
    self.valueList.clone()
}

/// Copies of all values in insertion order, or AllocError when the allocator refuses (values panics instead).
pub pure fn Map[K: Copy, V: Copy].tryValues(self) -> Result[Array[V], AllocError] {
    self.valueList.tryClone()
}

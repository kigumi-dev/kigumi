import chacha from std/crypto/chacha20poly1305
import secret from std/secret

/// An authenticated, encrypted bucket adapter.
///
/// Every page is sealed with ChaCha20-Poly1305. The additional data binds the
/// record to the public tree level and physical page index, and a fresh
/// nonce is derived from a caller-supplied seed and a strictly increasing
/// write counter. A modified, truncated, moved or forged page therefore fails
/// `open` before any block reaches the controller.
///
/// The adapter keeps the same public access shape as `MemoryStore`: a read or
/// write scans every page at the level, so the sequence of physical pages is a
/// function of the tree size and the operation, never of the secret bucket
/// index. Reads decrypt every page at the level so ciphertext equality cannot
/// reveal which page changed.
///
/// Replay of an older but otherwise valid page at the same level and index is
/// outside the single-page AEAD guarantee; use a Merkle root or an externally
/// monotonic version if the storage provider can roll back pages.
pub type SealedStore[P: PageStore] = resource {
    mut inner P
    mut key secret.SecretBuffer
    mut nonceSeed u64
    mut counter u64
    mut blockBytes usize
    mut children u64
    mut depth usize
    mut leaves usize
}

/// Wraps `inner` and seals every one of its pages. `key` must be 32 bytes.
/// `nonceSeed` must be distinct for every store lifetime under one key; the
/// adapter derives nonces from it and a write counter and never reuses one
/// within that lifetime.
pub fn SealedStore.new[P: PageStore](inner: P, key: secret.SecretBuffer, nonceSeed: u64, leaves: usize, blockBytes: usize) -> SealedStore[P]! {
    if key.len() != 32 {
        return Err(OramError.BadKey)
    }
    let stored = key.copy()
    SealedStore.fromKey(inner, stored, nonceSeed, leaves, blockBytes)
}

/// Builds a store around an owned key. The key stays in the secret domain;
/// every page seal and open uses it directly.
fn SealedStore.fromKey[P: PageStore](inner: P, key: secret.SecretBuffer, nonceSeed: u64, leaves: usize, blockBytes: usize) -> SealedStore[P]! {
    if key.len() != 32 {
        return Err(OramError.BadKey)
    }
    if leaves == 0 || (leaves & (leaves - 1)) != 0 {
        return Err(OramError.UnsupportedSize(leaves))
    }
    if inner.leafCount() != leaves {
        return Err(OramError.StoreShapeMismatch)
    }
    let depth = levelOf(leaves)
    let mut level: usize = 0
    for level <= depth {
        let one: usize = 1
        if inner.bucketCount(level) != (one << level) {
            return Err(OramError.StoreShapeMismatch)
        }
        level = level + 1
    }
    let mut store = SealedStore[P] {
        inner: inner
        key: key
        nonceSeed: nonceSeed
        counter: 0
        blockBytes: blockBytes
        children: 0
        depth: depth
        leaves: leaves
    }
    store.initialize()?
    Ok(store)
}

/// Seals an empty bucket into every page so a truncated page is a corruption,
/// not an empty slot.
fn SealedStore[P: PageStore].initialize(mut self) -> Void! {
    let mut level: usize = 0
    for level <= self.depth {
        let count = self.inner.bucketCount(level)
        let mut index: usize = 0
        for index < count {
            let sealed = self.sealPage(level, index.toU64(), Bucket.empty(self.blockBytes))?
            self.inner.writePage(level, pageIndex(index), sealed)?
            index = index + 1
        }
        level = level + 1
    }
}

pub fn SealedStore[P: PageStore].bucketCount(self, level: usize) -> usize {
    if level > self.depth {
        return 0
    }
    let one: usize = 1
    one << level
}

pub fn SealedStore[P: PageStore].payloadBytes(self) -> usize {
    self.blockBytes
}

pub fn SealedStore[P: PageStore].readBucket(mut self, level: usize, index: secret.SecretU32) -> Bucket! {
    if level > self.depth {
        return Ok(Bucket.empty(self.blockBytes))
    }
    let want = unsafe {
        index.declassify()
    }.toU64()
    let count = self.bucketCount(level)
    let mut out = Bucket.empty(self.blockBytes)
    let mut j: usize = 0
    for j < count {
        let page = self.inner.readPage(level, pageIndex(j), self.recordBytes())?
        let candidate = self.openPage(level, j.toU64(), page)?
        out = out.combine(maskEq(j.toU64(), want), &candidate)
        j = j + 1
    }
    Ok(out)
}

pub fn SealedStore[P: PageStore].writeBucket(mut self, level: usize, index: secret.SecretU32, bucket: Bucket) -> Void! {
    if level > self.depth {
        return Ok(())
    }
    let want = unsafe {
        index.declassify()
    }.toU64()
    let count = self.bucketCount(level)
    let mut j: usize = 0
    for j < count {
        let page = self.inner.readPage(level, pageIndex(j), self.recordBytes())?
        let mut current = self.openPage(level, j.toU64(), page)?
        let selected = current.combine(maskEq(j.toU64(), want), &bucket)
        let sealed = self.sealPage(level, j.toU64(), selected)?
        self.inner.writePage(level, pageIndex(j), sealed)?
        j = j + 1
    }
}

/// Reserves a fresh sealed child tree over the same untrusted provider. The
/// child gets a derived nonce seed, so two trees never share a nonce.
pub fn SealedStore[P: PageStore].split(move self, leaves: usize, blockBytes: usize) -> Split[SealedStore[P]]! {
    let key = self.key.copy()
    let childSeed = mixNonce(self.nonceSeed ^ self.children)
    let childKey = key.copy()
    let parts = move self.inner.split(leaves)?
    let root = SealedStore[P] {
        inner: move parts.root
        key: key
        nonceSeed: self.nonceSeed
        counter: self.counter
        blockBytes: self.blockBytes
        children: self.children.wrappingAdd(1)
        depth: self.depth
        leaves: self.leaves
    }
    let child = SealedStore.fromKey(parts.child, childKey, childSeed, leaves, blockBytes)?
    Ok(Split {
        root: root
        child: child
    })
}

/// The untrusted provider, read-only.
pub fn SealedStore[P: PageStore].withInner[R](self, f: fn(&P) -> R) -> R {
    f(&self.inner)
}

/// The untrusted provider, mutable. This is the seam a test uses to model a
/// tampering provider; application code has no reason to call it.
pub fn SealedStore[P: PageStore].withInnerMut[R](mut self, f: fn(&mut P) -> R) -> R {
    f(&mut self.inner)
}

/// The fixed record size: an eight-byte counter, the bucket and the tag.
fn SealedStore[P: PageStore].recordBytes(self) -> usize {
    8 + bucketBytes(self.blockBytes) + 16
}

fn SealedStore[P: PageStore].sealPage(mut self, level: usize, index: u64, bucket: Bucket) -> Bytes! {
    let counter = self.counter
    self.counter = counter.wrappingAdd(1)
    let plaintext = secret.SecretBuffer.fromBytes(encodeBucket(bucket, self.blockBytes))
    let nonce = nonceFor(self.nonceSeed, counter)
    let aad = pageAad(level, index)
    let sealed = chacha.seal(&self.key, nonce, aad, &plaintext) || return Err(OramError.CorruptPage(level))
    // The provider is the untrusted storage boundary: the sealed page leaves
    // the secret domain here, exactly as it does on a real disk.
    let sealedBytes = unsafe {
        sealed.declassify()
    }
    let mut out = Array.tryWithCapacity[u8](8 + sealedBytes.len()) || return Err(OramError.OutOfMemory)
    writeU64To(&mut out, counter)
    let mut i: usize = 0
    for i < sealedBytes.len() {
        out.push(sealedBytes[i])
        i = i + 1
    }
    Ok(Bytes.fromArray(&out))
}

fn SealedStore[P: PageStore].openPage(self, level: usize, index: u64, page: Bytes) -> Bucket! {
    if page.len() != self.recordBytes() {
        return Err(OramError.CorruptPage(level))
    }
    let counter = readU64At(page, 0)
    let sealed = page.slice(8, page.len()) || return Err(OramError.CorruptPage(level))
    let nonce = nonceFor(self.nonceSeed, counter)
    let aad = pageAad(level, index)
    let plaintext = match chacha.open(&self.key, nonce, aad, sealed) {
        Ok(value) -> value
        Err(_) -> return Err(OramError.CorruptPage(level))
    }
    // The page came from the untrusted provider; decoding it is the storage
    // adapter's boundary, so the bytes are released here.
    let plaintextBytes = unsafe {
        plaintext.declassify()
    }
    match decodeBucket(plaintextBytes, self.blockBytes) {
        Ok(bucket) -> Ok(bucket)
        Err(_) -> Err(OramError.CorruptPage(level))
    }
}

fn pageIndex(index: usize) -> secret.SecretU32 {
    secret.SecretU32.classify((index.toU32() || 0))
}

fn pageAad(level: usize, index: u64) -> Bytes {
    let mut out = Array.tryWithCapacity[u8](16) || panic("out of memory")
    writeU64To(&mut out, level.toU64())
    writeU64To(&mut out, index)
    Bytes.fromArray(&out)
}

fn nonceFor(seed: u64, counter: u64) -> Bytes {
    let mut out = Array.tryWithCapacity[u8](12) || panic("out of memory")
    writeU64To(&mut out, mixNonce(seed ^ counter))
    let tail = mixNonce(seed.wrappingAdd(counter))
    let mut i: usize = 0
    for i < 4 {
        out.push((tail.wrappingShiftRight((i * 8).toU64()) & 0xFF).truncate[u8]())
        i = i + 1
    }
    Bytes.fromArray(&out)
}

fn mixNonce(x: u64) -> u64 {
    let a = x ^ x.wrappingShiftRight(30)
    let b = a.wrappingMul(0xbf58476d1ce4e5b9)
    let c = b ^ b.wrappingShiftRight(27)
    let d = c.wrappingMul(0x94d049bb133111eb)
    d ^ d.wrappingShiftRight(31)
}

/// A sealed store over a fresh in-process page provider, for an eight-byte
/// `ObliviousArray` payload.
pub fn sealedMemory[const N: usize](key: secret.SecretBuffer, nonceSeed: u64) -> SealedStore[MemoryPageStore]! {
    let pages = MemoryPageStore.new(N)?
    SealedStore[MemoryPageStore].new(pages, key, nonceSeed, N, 8)
}

/// Like `sealedMemory` with a caller-chosen data-tree payload width, for
/// `ObliviousBuffer`.
pub fn sealedBuffer[const N: usize](key: secret.SecretBuffer, nonceSeed: u64, blockBytes: usize) -> SealedStore[MemoryPageStore]! {
    let pages = MemoryPageStore.new(N)?
    SealedStore[MemoryPageStore].new(pages, key, nonceSeed, N, blockBytes)
}

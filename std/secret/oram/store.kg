import subtle from std/crypto/subtle
import mem from std/mem
import secret from std/secret

/// The payload of one ORAM block.
///
/// `data` holds exactly `blockBytes` bytes for data trees and is empty for
/// position-map trees. Every block in one tree has the same `blockBytes`, so
/// an observer of the storage adapter cannot learn a payload length from the
/// page size. `leaves` holds the four child positions a position-map block
/// carries; data blocks leave it zero.
pub type Payload = {
    pub mut data Bytes
    pub mut l0 u64
    pub mut l1 u64
    pub mut l2 u64
    pub mut l3 u64
}

/// A Path ORAM block. `id` is 0 for an empty slot and `index + 1` for the
/// logical element at `index`; `pos` is the leaf the client assigned to it.
/// All fields are secret: the controller only ever compares them behind masks
/// and never uses them as an index or a branch condition.
pub type Block = {
    pub mut id u64
    pub mut pos u64
    pub mut payload Payload
}

/// One tree bucket: `BucketCapacity` blocks, in a fixed public slot order.
pub type Bucket = {
    pub mut slots FixedArray[Block, BucketCapacity]
}

/// Blocks per tree bucket. The capacity is public and part of the security
/// parameter, not part of the secret state.
pub const BucketCapacity: usize = 4

/// Client-side stash slots. A write that needs more slots fails with
/// `OramError.StashOverflow` instead of silently dropping a block.
pub const StashCapacity: usize = 64

/// Map fanout: one position-map block carries four child leaves.
pub const MapFanout: usize = 4

/// The largest leaf count the controller accepts.
pub const MaxLeaves: usize = 16777216

/// Why an ORAM operation was refused.
pub type OramError =
    | UnsupportedSize(size: usize)
    | SizeTooLarge(size: usize)
    | StoreShapeMismatch
    | StashOverflow
    | CorruptPosition(level: usize)
    | CorruptPositionMap
    | CorruptPayload
    | CorruptPage(level: usize)
    | BadKey
    | BadBlockSize(size: usize)
    | BlockTooLarge(size: usize)
    | OutOfMemory

pub fn OramError.message(self) -> String {
    match self {
        UnsupportedSize(size) -> "secret/oram: unsupported size ${size}; N must be a power of two"
        SizeTooLarge(size) -> "secret/oram: ${size} leaves exceed the ${MaxLeaves} limit"
        StoreShapeMismatch -> "secret/oram: the storage adapter's bucket counts do not match the tree"
        StashOverflow -> "secret/oram: the stash is full"
        CorruptPosition(level) -> "secret/oram: a block at level ${level} is not on its position path"
        CorruptPositionMap -> "secret/oram: a position-map leaf is out of range"
        CorruptPayload -> "secret/oram: a payload length is out of range"
        CorruptPage(level) -> "secret/oram: an authenticated page at level ${level} failed to verify"
        BadKey -> "secret/oram: the storage key must be 32 bytes"
        BadBlockSize(size) -> "secret/oram: block payload size ${size} does not match the store"
        BlockTooLarge(size) -> "secret/oram: ${size} bytes do not fit the block payload"
        OutOfMemory -> "secret/oram: out of memory"
    }
}

/// A bucket with every slot empty.
pub pure fn Payload.empty(blockBytes: usize) -> Payload {
    Payload {
        data: if blockBytes == 0 {
            "".toBytes()
        } else {
            Bytes.zeros(blockBytes)
        }
        l0: 0
        l1: 0
        l2: 0
        l3: 0
    }
}

/// A payload holding one u64 value in the first eight bytes.
pub pure fn Payload.value(blockBytes: usize, value: u64) -> Payload {
    let mut data = Array.empty[u8]()
    writeU64To(&mut data, value)
    let mut i: usize = 8
    for i < blockBytes {
        data.push(0)
        i = i + 1
    }
    Payload {
        data: Bytes.fromArray(&data)
        l0: 0
        l1: 0
        l2: 0
        l3: 0
    }
}

/// An empty slot: id 0 is never a logical element, so it cannot be selected.
pub pure fn Block.empty(blockBytes: usize) -> Block {
    Block {
        id: 0
        pos: 0
        payload: Payload.empty(blockBytes)
    }
}

/// A bucket with every slot empty.
pub pure fn Bucket.empty(blockBytes: usize) -> Bucket {
    Bucket { slots: FixedArray.filled[Block, BucketCapacity](Block.empty(blockBytes)) }
}

/// All ones when `a` and `b` are equal.
pub pure noalloc fn maskEq(a: u64, b: u64) -> u64 {
    ~secret.maskNonZeroU64(a ^ b)
}

/// All ones when `a` is zero.
pub pure noalloc fn maskZero(a: u64) -> u64 {
    ~secret.maskNonZeroU64(a)
}

/// a when `mask` is all ones and b when it is zero.
pub pure noalloc fn pick(mask: u64, a: u64, b: u64) -> u64 {
    secret.selectU64(mask, a, b)
}

/// Selects one byte sequence without a data-dependent branch or address.
/// The result is as long as the longer input; a missing byte reads as zero.
pub pure fn selectBytes(mask: u64, a: Bytes, b: Bytes) -> Bytes {
    let n = if a.len() > b.len() {
        a.len()
    } else {
        b.len()
    }
    let m = (mask & 0xFF).truncate[u8]()
    let mut out = Array.tryWithCapacity[u8](n) || panic("out of memory")
    let mut i: usize = 0
    for i < n {
        let av = a.get(i) || 0
        let bv = b.get(i) || 0
        out.push(subtle.selectU8(m, av, bv))
        i = i + 1
    }
    Bytes.fromArray(&out)
}

/// Selects between two payloads; every byte, leaf and field is read.
pub pure fn Payload.select(mask: u64, a: Payload, b: Payload) -> Payload {
    let data = if a.data.len() == 0 && b.data.len() == 0 {
        "".toBytes()
    } else {
        selectBytes(mask, a.data, b.data)
    }
    Payload {
        data: data
        l0: pick(mask, a.l0, b.l0)
        l1: pick(mask, a.l1, b.l1)
        l2: pick(mask, a.l2, b.l2)
        l3: pick(mask, a.l3, b.l3)
    }
}

/// Leaf `k` at a public index, for serialization and verification.
pub pure fn Payload.leafAt(self, k: usize) -> u64 {
    if k == 0 {
        return self.l0
    }
    if k == 1 {
        return self.l1
    }
    if k == 2 {
        return self.l2
    }
    self.l3
}

/// Replaces leaf `k` at a public index.
pub pure fn Payload.setLeafAt(mut self, k: usize, value: u64) -> Payload {
    if k == 0 {
        self.l0 = value
        return self
    }
    if k == 1 {
        self.l1 = value
        return self
    }
    if k == 2 {
        self.l2 = value
        return self
    }
    self.l3 = value
    self
}

/// Leaf selected by a secret slot without an index or branch.
pub pure fn Payload.leaf(self, slot: secret.SecretU32) -> u64 {
    let zero = secret.SecretU32.classify(0)
    let one = secret.SecretU32.classify(1)
    let two = secret.SecretU32.classify(2)
    let three = secret.SecretU32.classify(3)
    let m0 = slot.ctEq(zero).mask()
    let m1 = slot.ctEq(one).mask()
    let m2 = slot.ctEq(two).mask()
    let m3 = slot.ctEq(three).mask()
    pick(m0, self.l0, 0) | pick(m1, self.l1, 0) | pick(m2, self.l2, 0) | pick(m3, self.l3, 0)
}

/// Replaces the leaf selected by a secret slot; every slot is read.
pub pure fn Payload.setLeaf(mut self, slot: secret.SecretU32, value: u64) -> Payload {
    let zero = secret.SecretU32.classify(0)
    let one = secret.SecretU32.classify(1)
    let two = secret.SecretU32.classify(2)
    let three = secret.SecretU32.classify(3)
    let m0 = slot.ctEq(zero).mask()
    let m1 = slot.ctEq(one).mask()
    let m2 = slot.ctEq(two).mask()
    let m3 = slot.ctEq(three).mask()
    self.l0 = pick(m0, value, self.l0)
    self.l1 = pick(m1, value, self.l1)
    self.l2 = pick(m2, value, self.l2)
    self.l3 = pick(m3, value, self.l3)
    self
}

/// Slot-wise `Payload.select(mask, other, self)`: the shape a scanning adapter
/// uses to select one bucket without an index. The mask is secret-domain data.
pub pure fn Bucket.combine(mut self, mask: u64, other: &Bucket) -> Bucket {
    let mut slot: usize = 0
    for slot < BucketCapacity {
        let id = pick(mask, other.slots[slot].id, self.slots[slot].id)
        let pos = pick(mask, other.slots[slot].pos, self.slots[slot].pos)
        let payload = Payload.select(mask, other.slots[slot].payload, self.slots[slot].payload)
        self.slots[slot] = Block {
            id: id
            pos: pos
            payload: payload
        }
        slot = slot + 1
    }
    self
}

/// Reads a little-endian u64 from bytes; missing bytes read as zero.
pub pure fn readU64At(data: Bytes, at: usize) -> u64 {
    let mut out: u64 = 0
    let mut i: usize = 0
    for i < 8 {
        let b = data.get(at + i) || 0
        out = out | (b.toU64().wrappingShiftLeft((i * 8).toU64()))
        i = i + 1
    }
    out
}

/// A split of a storage adapter: the same root plus a fresh child region.
pub type Split[S] = {
    pub root S
    pub child S
}

/// A server-side bucket store. The level is public; the bucket index is a
/// secret leaf prefix, and an implementation must select it by scanning every
/// bucket at the level (see `Bucket.combine`), never with `index` as an array
/// subscript.
///
/// `split` reserves a fresh, disjoint tree of `leaves` leaf buckets for a
/// recursive position map. The root keeps all of its state; the child starts
/// empty for `blockBytes` payload bytes. A real adapter maps the two regions
/// to different storage offsets (or different vTPM-sealed pages).
pub interface BucketStore {
    /// Buckets at a level; a tree level `l` has `1 << l` buckets.
    fn bucketCount(self, level: usize) -> usize

    /// Bytes in each block payload. Position-map trees use zero.
    fn payloadBytes(self) -> usize

    /// Copies the bucket at a secret index, scanning all buckets at the level.
    fn readBucket(mut self, level: usize, index: secret.SecretU32) -> Bucket!

    /// Replaces the bucket at a secret index, scanning all buckets at the level.
    fn writeBucket(mut self, level: usize, index: secret.SecretU32, bucket: Bucket) -> Void!

    /// Reserves a fresh child store with `leaves` leaves and `blockBytes`
    /// payload bytes per block, keeping this store as the returned root.
    fn split(move self, leaves: usize, blockBytes: usize) -> Split[Self]!
}

/// The in-process adapter: a flat heap array of empty buckets. It is the
/// reference implementation for the interface and keeps no metadata of its
/// own, so all position state stays on the client.
pub type MemoryStore = resource {
    mut buckets Array[Bucket]
    mut depth usize
    mut blockBytes usize
}

/// A store with `leaves` leaf buckets and the usual `2 * leaves - 1` nodes.
/// The default block payload is eight bytes, the size `ObliviousArray` uses.
pub fn MemoryStore.new(leaves: usize) -> MemoryStore! {
    MemoryStore.withBlockBytes(leaves, 8)
}

/// A store whose data-tree blocks carry `blockBytes` payload bytes.
pub fn MemoryStore.withBlockBytes(leaves: usize, blockBytes: usize) -> MemoryStore! {
    if leaves == 0 || (leaves & (leaves - 1)) != 0 {
        return Err(OramError.UnsupportedSize(leaves))
    }
    if leaves > MaxLeaves {
        return Err(OramError.SizeTooLarge(leaves))
    }
    let total = 2 * leaves - 1
    let mut buckets = Array.tryWithCapacity[Bucket](total) || return Err(OramError.OutOfMemory)
    let mut i: usize = 0
    for i < total {
        buckets.push(Bucket.empty(blockBytes))
        i = i + 1
    }
    Ok(MemoryStore {
        buckets: buckets
        depth: levelOf(leaves)
        blockBytes: blockBytes
    })
}

/// The number of edges from the root to the leaves; `leaves` must be a power of two.
pub pure noalloc fn levelOf(leaves: usize) -> usize {
    let mut level: usize = 0
    let mut width = leaves
    for width > 1 {
        width = width >> 1
        level = level + 1
    }
    level
}

/// The next power of two at or above n.
pub pure noalloc fn nextPowerOfTwo(n: usize) -> usize {
    let mut width: usize = 1
    for width < n {
        width = width << 1
    }
    width
}

/// The flat array index of bucket 0 at a level.
pub pure noalloc fn levelOffset(level: usize) -> usize {
    let one: usize = 1
    (one << level) - 1
}

pub fn MemoryStore.bucketCount(self, level: usize) -> usize {
    if level > self.depth {
        return 0
    }
    let one: usize = 1
    one << level
}

pub fn MemoryStore.payloadBytes(self) -> usize {
    self.blockBytes
}

pub fn MemoryStore.readBucket(mut self, level: usize, index: secret.SecretU32) -> Bucket! {
    if level > self.depth {
        return Ok(Bucket.empty(self.blockBytes))
    }
    let want = unsafe {
        index.declassify()
    }.toU64()
    let count = self.bucketCount(level)
    let mut out = Bucket.empty(self.blockBytes)
    let mut j: usize = 0
    for j < count {
        let at = levelOffset(level) + j
        let candidate = self.buckets.get(at) || Bucket.empty(self.blockBytes)
        out = out.combine(maskEq(j.toU64(), want), &candidate)
        j = j + 1
    }
    Ok(out)
}

pub fn MemoryStore.writeBucket(mut self, level: usize, index: secret.SecretU32, bucket: Bucket) -> Void! {
    if level > self.depth {
        return Ok(())
    }
    let want = unsafe {
        index.declassify()
    }.toU64()
    let count = self.bucketCount(level)
    let mut j: usize = 0
    for j < count {
        let at = levelOffset(level) + j
        let mut current = self.buckets.get(at) || Bucket.empty(self.blockBytes)
        self.buckets[at] = current.combine(maskEq(j.toU64(), want), &bucket)
        j = j + 1
    }
}

pub fn MemoryStore.split(move self, leaves: usize, blockBytes: usize) -> Split[MemoryStore]! {
    let child = MemoryStore.withBlockBytes(leaves, blockBytes)?
    Ok(Split {
        root: self
        child: child
    })
}

/// The leaf count the store was built for.
pub fn MemoryStore.leaves(self) -> usize {
    let one: usize = 1
    one << self.depth
}

/// The level count; the root is level 0.
pub fn MemoryStore.levelCount(self) -> usize {
    self.depth
}

/// A raw page store: the untrusted side of an authenticated adapter. Pages are
/// opaque bytes of one fixed size per tree; implementations must not index by
/// a secret page number, and `split` must return a disjoint region.
pub interface PageStore {
    /// Buckets at a level; a tree level `l` has `1 << l` buckets.
    fn bucketCount(self, level: usize) -> usize

    /// Leaf count the store was built for.
    fn leafCount(self) -> usize

    /// Reads a page, scanning every page at the level.
    fn readPage(mut self, level: usize, index: secret.SecretU32, len: usize) -> Bytes!

    /// Replaces a page, scanning every page at the level.
    fn writePage(mut self, level: usize, index: secret.SecretU32, page: Bytes) -> Void!

    /// Reserves a fresh child region, keeping this store as the returned root.
    fn split(move self, leaves: usize) -> Split[Self]!
}

/// An in-process page store that models untrusted storage. Pages start empty;
/// an authenticated adapter writes a sealed empty bucket at construction so a
/// missing page is detectable.
pub type MemoryPageStore = resource {
    mut pages Array[Bytes]
    mut depth usize
    mut leafTotal usize
}

pub fn MemoryPageStore.new(leaves: usize) -> MemoryPageStore! {
    if leaves == 0 || (leaves & (leaves - 1)) != 0 {
        return Err(OramError.UnsupportedSize(leaves))
    }
    if leaves > MaxLeaves {
        return Err(OramError.SizeTooLarge(leaves))
    }
    let total = 2 * leaves - 1
    let mut pages = Array.tryWithCapacity[Bytes](total) || return Err(OramError.OutOfMemory)
    let mut i: usize = 0
    for i < total {
        pages.push("".toBytes())
        i = i + 1
    }
    Ok(MemoryPageStore {
        pages: pages
        depth: levelOf(leaves)
        leafTotal: leaves
    })
}

pub fn MemoryPageStore.bucketCount(self, level: usize) -> usize {
    if level > self.depth {
        return 0
    }
    let one: usize = 1
    one << level
}

pub fn MemoryPageStore.leafCount(self) -> usize {
    self.leafTotal
}

pub fn MemoryPageStore.readPage(mut self, level: usize, index: secret.SecretU32, len: usize) -> Bytes! {
    if level > self.depth {
        return Ok(Bytes.zeros(len))
    }
    let want = unsafe {
        index.declassify()
    }.toU64()
    let count = self.bucketCount(level)
    let mut out = Bytes.zeros(len)
    let mut j: usize = 0
    for j < count {
        let at = levelOffset(level) + j
        let candidate = self.pages.get(at) || "".toBytes()
        out = selectBytes(maskEq(j.toU64(), want), candidate, out)
        j = j + 1
    }
    Ok(out)
}

pub fn MemoryPageStore.writePage(mut self, level: usize, index: secret.SecretU32, page: Bytes) -> Void! {
    if level > self.depth {
        return Ok(())
    }
    let want = unsafe {
        index.declassify()
    }.toU64()
    let count = self.bucketCount(level)
    let mut j: usize = 0
    for j < count {
        let at = levelOffset(level) + j
        let current = self.pages.get(at) || "".toBytes()
        self.pages[at] = selectBytes(maskEq(j.toU64(), want), page, current)
        j = j + 1
    }
}

pub fn MemoryPageStore.split(move self, leaves: usize) -> Split[MemoryPageStore]! {
    let child = MemoryPageStore.new(leaves)?
    Ok(Split {
        root: self
        child: child
    })
}

/// Flips one byte of a stored page. This is a test hook that models a
/// malicious storage provider; it is not used by the adapter.
pub fn MemoryPageStore.corrupt(mut self, level: usize, index: usize, at: usize) {
    if level > self.depth {
        return
    }
    let count = self.bucketCount(level)
    if index >= count {
        return
    }
    let flat = levelOffset(level) + index
    let page = self.pages.get(flat) || "".toBytes()
    let byte = page.get(at) || 0
    let mut out = Array.empty[u8]()
    let mut i: usize = 0
    for i < page.len() {
        let v = if i == at {
            byte ^ 0xFF
        } else {
            page[i]
        }
        out.push(v)
        i = i + 1
    }
    self.pages[flat] = Bytes.fromArray(&out)
}

/// Serialized bytes of one bucket at a fixed payload width.
pub pure fn bucketBytes(blockBytes: usize) -> usize {
    BucketCapacity * (16 + blockBytes + 8 * MapFanout)
}

/// Encodes a bucket into a fixed-size byte record. The encoding is public and
/// only ever applied to plaintext before encryption.
pub pure fn encodeBucket(bucket: Bucket, blockBytes: usize) -> Bytes {
    let mut out = Array.tryWithCapacity[u8](bucketBytes(blockBytes)) || panic("out of memory")
    let mut slot: usize = 0
    for slot < BucketCapacity {
        let block = bucket.slots[slot]
        writeU64To(&mut out, block.id)
        writeU64To(&mut out, block.pos)
        let mut i: usize = 0
        for i < blockBytes {
            out.push(block.payload.data.get(i) || 0)
            i = i + 1
        }
        let mut k: usize = 0
        for k < MapFanout {
            writeU64To(&mut out, block.payload.leafAt(k))
            k = k + 1
        }
        slot = slot + 1
    }
    Bytes.fromArray(&out)
}

pure fn writeU64To(out: &mut Array[u8], value: u64) {
    let mut i: usize = 0
    for i < 8 {
        out.push((value.wrappingShiftRight((i * 8).toU64()) & 0xFF).truncate[u8]())
        i = i + 1
    }
}

/// Decodes a fixed-size bucket record. A wrong length is a corruption, not a
/// partial bucket.
pub pure fn decodeBucket(data: Bytes, blockBytes: usize) -> Bucket! {
    if data.len() != bucketBytes(blockBytes) {
        return Err(OramError.CorruptPage(0))
    }
    let mut slots = FixedArray.filled[Block, BucketCapacity](Block.empty(blockBytes))
    let mut at: usize = 0
    let mut slot: usize = 0
    for slot < BucketCapacity {
        let id = readU64At(data, at)
        at = at + 8
        let pos = readU64At(data, at)
        at = at + 8
        let payloadData = data.slice(at, at + blockBytes) || "".toBytes()
        at = at + blockBytes
        let mut payload = Payload {
            data: payloadData
            l0: 0
            l1: 0
            l2: 0
            l3: 0
        }
        let mut k: usize = 0
        for k < MapFanout {
            payload = payload.setLeafAt(k, readU64At(data, at))
            at = at + 8
            k = k + 1
        }
        slots[slot] = Block {
            id: id
            pos: pos
            payload: payload
        }
        slot = slot + 1
    }
    Ok(Bucket { slots: slots })
}

/// Erases a key buffer in place.
fn wipeBytes(mut data: Bytes) {
    mem.secureErase(&mut data)
}

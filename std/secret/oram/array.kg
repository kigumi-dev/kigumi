import secret from std/secret

/// A block removed from the stash or the path during an access.
pub type Found = {
    pub mut payload Payload
    pub mut present u64
}

/// A fetched position-map block. The block has been removed from its tree and
/// waits for `finishMapEntry`, so its caller can replace one child leaf.
pub type MapState = {
    pub mut index u64
    pub mut oldLeaf u64
    pub mut newLeaf u64
    pub mut payload Payload
}

/// All ones for a public 0/1 flag.
pure noalloc fn flagMask(flag: u64) -> u64 {
    flag.wrappingMul(allMask())
}

pure noalloc fn allMask() -> u64 {
    let all: u64 = 0xFFFFFFFFFFFFFFFF
    all
}

pure noalloc fn mix64(x: u64) -> u64 {
    let a = x ^ x.wrappingShiftRight(30)
    let b = a.wrappingMul(0xbf58476d1ce4e5b9)
    let c = b ^ b.wrappingShiftRight(27)
    let d = c.wrappingMul(0x94d049bb133111eb)
    d ^ d.wrappingShiftRight(31)
}

pure noalloc fn nextState(state: u64) -> u64 {
    state.wrappingAdd(0x9e3779b97f4a7c15)
}

/// Turns a secret comparison into an all-ones/all-zeros mask without
/// declassifying it.
pure noalloc fn choiceMask(c: secret.Choice) -> u64 {
    c.mask()
}

/// One Path ORAM tree over a caller-provided bucket store. The stash and the
/// stored leaf are client state.
pub type Tree[S: BucketStore] = resource {
    mut store S
    mut stash FixedArray[Block, StashCapacity]
    mut depth usize
    mut capacity usize
    mut blockBytes usize
}

pub fn Tree[S: BucketStore].new(store: S, capacity: usize, blockBytes: usize) -> Tree[S]! {
    if capacity == 0 || (capacity & (capacity - 1)) != 0 {
        return Err(OramError.UnsupportedSize(capacity))
    }
    if capacity > MaxLeaves {
        return Err(OramError.SizeTooLarge(capacity))
    }
    if store.payloadBytes() != blockBytes {
        return Err(OramError.BadBlockSize(store.payloadBytes()))
    }
    let depth = levelOf(capacity)
    let mut level: usize = 0
    for level <= depth {
        let one: usize = 1
        if store.bucketCount(level) != (one << level) {
            return Err(OramError.StoreShapeMismatch)
        }
        level = level + 1
    }
    Ok(Tree {
        store: store
        stash: FixedArray.filled[Block, StashCapacity](Block.empty(blockBytes))
        depth: depth
        capacity: capacity
        blockBytes: blockBytes
    })
}

/// Removes the block with `targetRaw` from the stash and every bucket on the
/// leaf's path, returning its payload and whether it was present.
fn Tree[S: BucketStore].fetch(mut self, targetRaw: u64, leaf: u64) -> Found! {
    let mut found = Found {
        payload: Payload.empty(self.blockBytes)
        present: 0
    }
    let mut s: usize = 0
    for s < StashCapacity {
        let block = self.stash[s]
        let hit = maskEq(block.id, targetRaw)
        found.present = found.present | hit
        found.payload = Payload.select(hit, block.payload, found.payload)
        self.stash[s].id = pick(hit, 0, block.id)
        self.stash[s].pos = pick(hit, 0, block.pos)
        self.stash[s].payload = Payload.select(hit, Payload.empty(self.blockBytes), block.payload)
        s = s + 1
    }
    let mut level: usize = 0
    for level <= self.depth {
        let node = self.nodeAt(level, leaf)
        let mut bucket = self.store.readBucket(level, node)?
        let mut slot: usize = 0
        for slot < BucketCapacity {
            let block = bucket.slots[slot]
            let hit = maskEq(block.id, targetRaw)
            found.present = found.present | hit
            found.payload = Payload.select(hit, block.payload, found.payload)
            bucket.slots[slot].id = pick(hit, 0, block.id)
            bucket.slots[slot].pos = pick(hit, 0, block.pos)
            bucket.slots[slot].payload = Payload.select(hit, Payload.empty(self.blockBytes), block.payload)
            slot = slot + 1
        }
        self.store.writeBucket(level, node, bucket)?
        level = level + 1
    }
    Ok(found)
}

/// Places a block into the first free stash slot. `active` is all ones when
/// the block must be stored; overflow is an audited failure assertion.
fn Tree[S: BucketStore].insertStash(mut self, block: Block, active: u64) -> Void! {
    let mut placed: u64 = 0
    let mut s: usize = 0
    for s < StashCapacity {
        let slot = self.stash[s]
        let take = active & maskZero(slot.id) & ~placed
        self.stash[s].id = pick(take, block.id, slot.id)
        self.stash[s].pos = pick(take, block.pos, slot.pos)
        self.stash[s].payload = Payload.select(take, block.payload, slot.payload)
        placed = placed | take
        s = s + 1
    }
    let failed = active & ~placed
    if unsafe {
        secret.SecretU64.classify(failed).declassify()
    } != 0 {
        return Err(OramError.StashOverflow)
    }
}

/// Greedily drops stash blocks into the path of `leaf`, from the leaf to the
/// root, so a block only enters a bucket on its own position path.
fn Tree[S: BucketStore].evict(mut self, leaf: u64) -> Void! {
    let mut level = self.depth + 1
    for level > 0 {
        level = level - 1
        let node = self.nodeAt(level, leaf)
        let bucket = self.store.readBucket(level, node)?
        let merged = self.merge(bucket, level, leaf)
        self.store.writeBucket(level, node, merged)?
    }
}

fn Tree[S: BucketStore].merge(mut self, mut bucket: Bucket, level: usize, leaf: u64) -> Bucket {
    let shift = (self.depth - level).toU64()
    let leafNode = leaf.wrappingShiftRight(shift)
    let mut slot: usize = 0
    for slot < BucketCapacity {
        let mut taken: u64 = 0
        let free = maskZero(bucket.slots[slot].id)
        let mut s: usize = 0
        for s < StashCapacity {
            let block = self.stash[s]
            let occupied = ~maskZero(block.id)
            let eligible = maskEq(block.pos.wrappingShiftRight(shift), leafNode)
            let take = free & ~taken & occupied & eligible
            bucket.slots[slot].id = pick(take, block.id, bucket.slots[slot].id)
            bucket.slots[slot].pos = pick(take, block.pos, bucket.slots[slot].pos)
            bucket.slots[slot].payload = Payload.select(take, block.payload, bucket.slots[slot].payload)
            self.stash[s].id = pick(take, 0, block.id)
            self.stash[s].pos = pick(take, 0, block.pos)
            self.stash[s].payload = Payload.select(take, Payload.empty(self.blockBytes), block.payload)
            taken = taken | take
            s = s + 1
        }
        slot = slot + 1
    }
    bucket
}

/// Checks every bucket and stash slot. `childCapacity` is 0 for a data tree;
/// otherwise every packed leaf must be below it.
fn Tree[S: BucketStore].verify(mut self, childCapacity: usize) -> Void! {
    let capMask = (self.capacity - 1).toU64()
    let childMask = if childCapacity == 0 {
        0
    } else {
        (childCapacity - 1).toU64()
    }
    let all: u64 = 0xFFFFFFFFFFFFFFFF
    let checkLeaves = if childCapacity == 0 {
        0
    } else {
        all
    }
    let mut level: usize = 0
    for level <= self.depth {
        let count = self.store.bucketCount(level)
        let shift = (self.depth - level).toU64()
        let mut index: usize = 0
        for index < count {
            let bucket = self.store.readBucket(level, secret.SecretU32.classify(index.toU64().truncate[u32]()))?
            let mut slot: usize = 0
            for slot < BucketCapacity {
                let bad = self.blockBad(bucket.slots[slot], capMask, childMask, checkLeaves, shift, index.toU64())
                if unsafe {
                    secret.SecretU64.classify(bad).declassify()
                } != 0 {
                    return Err(OramError.CorruptPosition(level))
                }
                slot = slot + 1
            }
            index = index + 1
        }
        level = level + 1
    }
    let mut s: usize = 0
    for s < StashCapacity {
        let block = self.stash[s]
        let occupied = ~maskZero(block.id)
        // A stash block is not on a public node, so only its identity and its
        // stored leaf range are checked here.
        let idOk = maskEq(block.id.wrappingSub(1) & ~capMask, 0)
        let posOk = maskEq(block.pos & ~capMask, 0)
        let stashBad = occupied & ~(idOk & posOk & self.payloadOk(block.payload, childMask, checkLeaves))
        if unsafe {
            secret.SecretU64.classify(stashBad).declassify()
        } != 0 {
            return Err(OramError.CorruptPosition(0))
        }
        s = s + 1
    }
}

fn Tree[S: BucketStore].payloadOk(self, payload: Payload, childMask: u64, checkLeaves: u64) -> u64 {
    let lenOk = maskEq(payload.data.len().toU64(), self.blockBytes.toU64())
    let all: u64 = 0xFFFFFFFFFFFFFFFF
    let mut leavesOk: u64 = all
    let mut k: usize = 0
    for k < MapFanout {
        let leaf = payload.leafAt(k)
        let inRange = maskEq(leaf & ~childMask, 0)
        leavesOk = leavesOk & pick(checkLeaves, inRange, all)
        k = k + 1
    }
    lenOk & leavesOk
}

fn Tree[S: BucketStore].blockBad(self, block: Block, capMask: u64, childMask: u64, checkLeaves: u64, shift: u64, node: u64) -> u64 {
    let occupied = ~maskZero(block.id)
    let index = block.id.wrappingSub(1)
    let inRange = maskEq(index & ~capMask, 0)
    let posOk = maskEq(block.pos & ~capMask, 0)
    let nodeOk = maskEq(block.pos.wrappingShiftRight(shift), node)
    let payloadOk = self.payloadOk(block.payload, childMask, checkLeaves)
    occupied & ~(inRange & posOk & nodeOk & payloadOk)
}

/// The secret node index at `level` on the path of `leaf`.
fn Tree[S: BucketStore].nodeAt(self, level: usize, leaf: u64) -> secret.SecretU32 {
    let shift = (self.depth - level).toU64()
    secret.SecretU32.classify(leaf.wrappingShiftRight(shift).truncate[u32]())
}

/// Base-case position map entries kept on the client.
pub const BaseCapacity: usize = 16

/// A Path ORAM table of fixed-size byte payloads over `N` slots.
///
/// The position map is recursive: tree 0 holds the payloads, tree 1 holds the
/// leaves of tree 0's blocks (four per block), tree 2 holds tree 1's leaves,
/// and so on until at most `BaseCapacity` leaves fit in a client array. A
/// table therefore keeps no O(N) position table. Every access walks a fixed
/// number of pages per level regardless of the secret index.
///
/// The guarantee is limited to the bucket address sequence at the storage
/// adapter: reading or writing index `a` and index `b` makes the adapter see
/// the same level/index sequence. It does not hide the number of accesses, the
/// table length, physical page faults, cache lines, or storage contents that
/// are not authenticated by the adapter.
pub type ObliviousBuffer[S: BucketStore, const N: usize] = resource {
    mut trees Array[Tree[S]]
    mut caps Array[usize]
    mut base FixedArray[u64, BaseCapacity]
    mut levels usize
    mut rng u64
    mut blockBytes usize
}

/// A buffer over a fresh in-process store.
pub fn bufferOnMemory[const N: usize](seed: u64, blockBytes: usize) -> ObliviousBuffer[MemoryStore, N]! {
    let store = MemoryStore.withBlockBytes(N, blockBytes)?
    ObliviousBuffer[MemoryStore, N].withStore(store, seed, blockBytes)
}

/// A buffer over a caller-provided storage adapter. The adapter's block width
/// and bucket counts must match the tree the `N` leaves need.
pub fn ObliviousBuffer[S: BucketStore, const N: usize].withStore(store: S, seed: u64, blockBytes: usize) -> ObliviousBuffer[S, N]! {
    if N == 0 || (N & (N - 1)) != 0 {
        return Err(OramError.UnsupportedSize(N))
    }
    if N > MaxLeaves {
        return Err(OramError.SizeTooLarge(N))
    }
    if store.payloadBytes() != blockBytes {
        return Err(OramError.BadBlockSize(store.payloadBytes()))
    }
    let mut caps = Array.tryWithCapacity[usize](32) || return Err(OramError.OutOfMemory)
    caps.push(N)
    let mut cap = N
    for cap > BaseCapacity {
        let groups = (cap + MapFanout - 1) / MapFanout
        cap = nextPowerOfTwo(groups)
        caps.push(cap)
    }
    let levels = caps.len() - 1
    let mut rootStore = store
    let mut children = Array.tryWithCapacity[Tree[S]](levels) || return Err(OramError.OutOfMemory)
    let mut l: usize = 1
    for l <= levels {
        let split = rootStore.split(caps[l], 0)?
        rootStore = move split.root
        children.push(Tree[S].new(split.child, caps[l], 0)?)
        l = l + 1
    }
    let mut trees = Array.tryWithCapacity[Tree[S]](levels + 1) || return Err(OramError.OutOfMemory)
    trees.push(Tree[S].new(rootStore, N, blockBytes)?)
    for child in children {
        trees.push(child)
    }
    let baseSize = if levels == 0 {
        N
    } else {
        caps[levels]
    }
    let mask = (baseSize - 1).toU64()
    let mut base = FixedArray.filled[u64, BaseCapacity](0)
    let mut state = nextState(seed)
    let mut i: usize = 0
    for i < BaseCapacity {
        state = nextState(state)
        _ = base.set(i, mix64(state) & mask)
        i = i + 1
    }
    Ok(ObliviousBuffer {
        trees: trees
        caps: caps
        base: base
        levels: levels
        rng: nextState(seed ^ 0xa5a5a5a5a5a5a5a5)
        blockBytes: blockBytes
    })
}

/// The public slot count.
pub fn ObliviousBuffer[S: BucketStore, N].capacity(self) -> usize {
    N
}

/// The number of recursive position-map trees above the data tree.
pub fn ObliviousBuffer[S: BucketStore, N].levelCount(self) -> usize {
    self.levels
}

/// Payload width in bytes.
pub fn ObliviousBuffer[S: BucketStore, N].payloadBytes(self) -> usize {
    self.blockBytes
}

/// Accesses the storage adapter without exposing the position map or stash.
pub fn ObliviousBuffer[S: BucketStore, N].withStore[R](self, f: fn(&S) -> R) -> R {
    f(&self.trees[0].store)
}

pub fn ObliviousBuffer[S: BucketStore, N].withStoreMut[R](mut self, f: fn(&mut S) -> R) -> R {
    f(&mut self.trees[0].store)
}

/// Reads the payload at a secret index. An unwritten slot reads as zeros.
pub fn ObliviousBuffer[S: BucketStore, N].read(mut self, index: secret.SecretIndex[N]) -> Payload! {
    self.access(index.secret(), Payload.empty(self.blockBytes), 0)
}

/// Writes a payload at a secret index, replacing any earlier payload.
pub fn ObliviousBuffer[S: BucketStore, N].write(mut self, index: secret.SecretIndex[N], value: Payload) -> Payload! {
    self.access(index.secret(), value, 1)
}

/// Writes a secret byte string. The four-byte length header and the copied
/// bytes are padded to the public block width, so the page size does not
/// reveal the value length. A value longer than `blockBytes - 4` is refused.
pub fn ObliviousBuffer[S: BucketStore, N].writeSecret(mut self, index: secret.SecretIndex[N], value: secret.SecretBuffer) -> Void! {
    if self.blockBytes < 4 {
        return Err(OramError.BadBlockSize(self.blockBytes))
    }
    let n = value.len()
    if n + 4 > self.blockBytes {
        return Err(OramError.BlockTooLarge(n))
    }
    let mut raw = unsafe {
        value.declassify()
    }
    let mut data = Array.empty[u8]()
    let mut i: usize = 0
    for i < 4 {
        data.push((n.toU64().wrappingShiftRight((i * 8).toU64()) & 0xFF).truncate[u8]())
        i = i + 1
    }
    i = 0
    for i < n {
        data.push(raw.get(i) || 0)
        i = i + 1
    }
    for data.len() < self.blockBytes {
        data.push(0)
    }
    wipeBytes(raw)
    let payload = Payload {
        data: Bytes.fromArray(&data)
        l0: 0
        l1: 0
        l2: 0
        l3: 0
    }
    _ = self.access(index.secret(), payload, 1)?
}

/// Reads a secret byte string written by `writeSecret`.
pub fn ObliviousBuffer[S: BucketStore, N].readSecret(mut self, index: secret.SecretIndex[N]) -> secret.SecretBuffer! {
    let payload = self.access(index.secret(), Payload.empty(self.blockBytes), 0)?
    if payload.data.len() < 4 {
        return Err(OramError.CorruptPayload)
    }
    let n = (readU64At(payload.data, 0) & 0xFFFFFFFF).truncate[usize]()
    if n + 4 > self.blockBytes {
        return Err(OramError.CorruptPayload)
    }
    let bytes = payload.data.slice(4, 4 + n) || return Err(OramError.CorruptPayload)
    Ok(secret.SecretBuffer.fromBytes(bytes))
}

/// Checks the recursive position map and every stored block. Reading every
/// bucket also authenticates every page of an encrypted adapter.
pub fn ObliviousBuffer[S: BucketStore, N].verify(mut self) -> Void! {
    let baseSize = if self.levels == 0 {
        N
    } else {
        self.caps[self.levels]
    }
    let mask = (baseSize - 1).toU64()
    let mut i: usize = 0
    for i < BaseCapacity {
        let out = ~maskEq(self.base[i] & ~mask, 0)
        if unsafe {
            secret.SecretU64.classify(out).declassify()
        } != 0 {
            return Err(OramError.CorruptPositionMap)
        }
        i = i + 1
    }
    let mut l: usize = 0
    for l <= self.levels {
        let child = if l == 0 {
            0
        } else {
            self.caps[l - 1]
        }
        let bad = self.trees.withMut(l, (t: &mut Tree[S]) => t.verify(child))
        if bad is None {
            return Err(OramError.StoreShapeMismatch)
        }
        match bad {
            None -> return Err(OramError.StoreShapeMismatch)
            Some(Err(e)) -> return Err(e)
            Some(Ok(_)) -> {}
        }
        l = l + 1
    }
}

/// The next random leaf for a tree level, kept inside the public capacity.
fn ObliviousBuffer[S: BucketStore, N].nextLeaf(mut self, level: usize) -> u64 {
    self.rng = nextState(self.rng)
    mix64(self.rng) & (self.caps[level] - 1).toU64()
}

fn ObliviousBuffer[S: BucketStore, N].treeFetch(mut self, level: usize, target: u64, leaf: u64) -> Found! {
    let result = self.trees.withMut(level, (t: &mut Tree[S]) => t.fetch(target, leaf))
    if result is None {
        return Err(OramError.StoreShapeMismatch)
    }
    match result {
        Some(found) -> found
        None -> Err(OramError.StoreShapeMismatch)
    }
}

fn ObliviousBuffer[S: BucketStore, N].treeInsert(mut self, level: usize, block: Block, active: u64) -> Void! {
    let result = self.trees.withMut(level, (t: &mut Tree[S]) => t.insertStash(block, active))
    if result is None {
        return Err(OramError.StoreShapeMismatch)
    }
    match result {
        Some(inner) -> inner
        None -> Err(OramError.StoreShapeMismatch)
    }
}

fn ObliviousBuffer[S: BucketStore, N].treeEvict(mut self, level: usize, leaf: u64) -> Void! {
    let result = self.trees.withMut(level, (t: &mut Tree[S]) => t.evict(leaf))
    if result is None {
        return Err(OramError.StoreShapeMismatch)
    }
    match result {
        Some(inner) -> inner
        None -> Err(OramError.StoreShapeMismatch)
    }
}

// The read/write core. `writing` is a public 0/1 flag: the control flow and
// every storage access are identical for reads and writes.
fn ObliviousBuffer[S: BucketStore, N].access(mut self, index: secret.SecretU32, value: Payload, writing: u64) -> Payload! {
    let limit = secret.SecretU32.classify((N.toU32() || 0))
    let inRange = index.ctLt(limit)
    let inRangeMask = choiceMask(inRange)
    let safe = inRange.selectU32(index, secret.SecretU32.classify(0))
    let id = unsafe {
        safe.declassify()
    }.toU64().wrappingAdd(1)
    let mut old = Payload.empty(self.blockBytes)
    if self.levels == 0 {
        let idx = secret.SecretIndex[BaseCapacity].from(safe)
        let leaf = secret.ctLookupU64(&self.base, idx)
        let found = self.treeFetch(0, id, leaf)?
        old = found.payload
        let newLeaf = self.nextLeaf(0)
        secret.ctUpdateU64(&mut self.base, idx, newLeaf)
        let active = (found.present | flagMask(writing)) & inRangeMask
        let block = Block {
            id: pick(active, id, 0)
            pos: pick(active, newLeaf, 0)
            payload: Payload.select(active, value, Payload.empty(self.blockBytes))
        }
        self.treeInsert(0, block, active)?
        self.treeEvict(0, leaf)?
    } else {
        let parentIndex = safe.shiftRight(2)
        let mut parent = self.fetchMapEntry(1, parentIndex)?
        let slot = safe & secret.SecretU32.classify(((MapFanout - 1).toU32() || 0))
        let leaf = parent.payload.leaf(slot)
        let found = self.treeFetch(0, id, leaf)?
        old = found.payload
        let newLeaf = self.nextLeaf(0)
        parent.payload = parent.payload.setLeaf(slot, newLeaf)
        self.finishMapEntry(1, parent)?
        let active = (found.present | flagMask(writing)) & inRangeMask
        let block = Block {
            id: pick(active, id, 0)
            pos: pick(active, newLeaf, 0)
            payload: Payload.select(active, value, Payload.empty(self.blockBytes))
        }
        self.treeInsert(0, block, active)?
        self.treeEvict(0, leaf)?
    }
    Ok(old)
}

/// Fetches the position-map block at `idx` in tree `level`, re-randomizes the
/// block's own leaf in its parent map, and leaves the block out of the tree
/// for `finishMapEntry` to reinsert.
fn ObliviousBuffer[S: BucketStore, N].fetchMapEntry(mut self, level: usize, idx: secret.SecretU32) -> MapState! {
    let mut oldLeaf: u64 = 0
    let mut newLeaf: u64 = 0
    if level == self.levels {
        let baseIdx = secret.SecretIndex[BaseCapacity].from(idx)
        oldLeaf = secret.ctLookupU64(&self.base, baseIdx)
        newLeaf = self.nextLeaf(level)
        secret.ctUpdateU64(&mut self.base, baseIdx, newLeaf)
    } else {
        let parentIndex = idx.shiftRight(2)
        let mut parent = self.fetchMapEntry(level + 1, parentIndex)?
        let slot = idx & secret.SecretU32.classify(((MapFanout - 1).toU32() || 0))
        oldLeaf = parent.payload.leaf(slot)
        newLeaf = self.nextLeaf(level)
        parent.payload = parent.payload.setLeaf(slot, newLeaf)
        self.finishMapEntry(level + 1, parent)?
    }
    let raw = unsafe {
        idx.declassify()
    }.toU64()
    let id = raw.wrappingAdd(1)
    let found = self.treeFetch(level, id, oldLeaf)?
    Ok(MapState {
        index: raw
        oldLeaf: oldLeaf
        newLeaf: newLeaf
        payload: found.payload
    })
}

/// Reinserts a fetched position-map block with its new leaf and evicts the
/// tree along the path that was just read.
fn ObliviousBuffer[S: BucketStore, N].finishMapEntry(mut self, level: usize, state: MapState) -> Void! {
    let block = Block {
        id: state.index.wrappingAdd(1)
        pos: state.newLeaf
        payload: state.payload
    }
    self.treeInsert(level, block, allMask())?
    self.treeEvict(level, state.oldLeaf)?
}

/// A client-facing oblivious table of `N` u64 values.
///
/// This is the `ObliviousBuffer` with an eight-byte payload, so its recursive
/// position map, stash, recursive levels and adapter contract are shared. Values
/// of slots that were never written read as 0.
pub type ObliviousArray[S: BucketStore, const N: usize] = resource {
    mut inner ObliviousBuffer[S, N]
}

/// An array backed by a fresh in-process store.
pub fn onMemory[const N: usize](seed: u64) -> ObliviousArray[MemoryStore, N]! {
    let core = bufferOnMemory[N](seed, 8)?
    Ok(ObliviousArray { inner: core })
}

/// An array over a caller-provided storage adapter.
pub fn ObliviousArray[S: BucketStore, const N: usize].withStore(store: S, seed: u64) -> ObliviousArray[S, N]! {
    let core = ObliviousBuffer[S, N].withStore(store, seed, 8)?
    Ok(ObliviousArray { inner: core })
}

/// Reads the value at a secret index. A slot that was never written is 0.
pub fn ObliviousArray[S: BucketStore, N].read(mut self, index: secret.SecretIndex[N]) -> u64! {
    let payload = self.inner.read(index)?
    Ok(readU64At(payload.data, 0))
}

/// Writes a value at a secret index, replacing any earlier value.
pub fn ObliviousArray[S: BucketStore, N].write(mut self, index: secret.SecretIndex[N], value: u64) -> Void! {
    _ = self.inner.write(index, Payload.value(8, value))?
}

/// Checks the position map and every stored block against the tree shape.
pub fn ObliviousArray[S: BucketStore, N].verify(mut self) -> Void! {
    self.inner.verify()
}

pub fn ObliviousArray[S: BucketStore, N].withStore[R](self, f: fn(&S) -> R) -> R {
    self.inner.withStore(f)
}

pub fn ObliviousArray[S: BucketStore, N].withStoreMut[R](mut self, f: fn(&mut S) -> R) -> R {
    self.inner.withStoreMut(f)
}

/// The public leaf count.
pub fn ObliviousArray[S: BucketStore, N].capacity(self) -> usize {
    N
}

/// The number of recursive position-map trees above the data tree.
pub fn ObliviousArray[S: BucketStore, N].levelCount(self) -> usize {
    self.inner.levelCount()
}

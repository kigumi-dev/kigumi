import secret from std/secret

// Path ORAM (O3) over the secret-index primitives.
//
// Clients hold the position map (`positions`) and the stash; the tree lives
// behind `BucketStore`. Every access walks the same public control flow:
//
//   fetch:  one read and one write per level, 0..=depth
//   evict:  one read and one write per level, depth..=0
//
// The leaf, the block id, the stash occupancy and every position are secret.
// They only feed mask comparisons (`maskEq`) and masked selects. The adapter
// receives the leaf node as a `SecretU32` and is required to select it by
// scanning every bucket at the level, so the physical address sequence is a
// function of `N` and the operation alone. No `if` in the normal path tests a
// secret; the two branches that leave the mask domain are audited failure
// assertions: stash overflow and a failed integrity check.
/// The result of removing a logical element's block from the stash and path.
type Found = {
    value u64
    present u64
}

/// All ones for a public 0/1 flag.
pure noalloc fn flagMask(flag: u64) -> u64 {
    flag.wrappingMul(0xFFFFFFFFFFFFFFFF)
}

pure noalloc fn mix64(x: u64) -> u64 {
    let a = x ^ x.wrappingShiftRight(30)
    let b = a.wrappingMul(0xbf58476d1ce4e5b9)
    let c = b ^ b.wrappingShiftRight(27)
    let d = c.wrappingMul(0x94d049bb133111eb)
    d ^ d.wrappingShiftRight(31)
}

pure noalloc fn nextState(state: u64) -> u64 {
    state.wrappingAdd(0x9e3779b97f4a7c15)
}

/// A client-facing oblivious table of `N` u64 values.
///
/// `N` is public and must be a power of two no larger than `MaxLeaves`.
/// Values of slots that were never written read as 0; a first write stores the
/// block, so a table of all zeros behaves exactly like a fully initialized
/// table of zeros. The resource is move-only and exposes neither the position
/// map nor the stash.
///
/// The guarantee is limited to the block address sequence at `BucketStore`:
/// reading or writing index `a` and index `b` makes the adapter see the same
/// level/index sequence. It does not hide the number of accesses, the table
/// length, physical page faults, cache lines, or storage contents that are not
/// authenticated by the adapter.
pub type ObliviousArray[S: BucketStore, const N: usize] = resource {
    mut store S
    mut positions FixedArray[u64, N]
    mut stash FixedArray[Block, StashCapacity]
    mut depth usize
    mut rng u64
}

/// An array backed by a fresh in-process store.
pub fn onMemory[const N: usize](seed: u64) -> ObliviousArray[MemoryStore, N]! {
    let store = MemoryStore.new(N)?
    withStore(store, seed)
}

/// An array over a caller-provided storage adapter. The adapter's bucket
/// counts must match the tree the `N` leaves need.
pub fn withStore[S: BucketStore, const N: usize](store: S, seed: u64) -> ObliviousArray[S, N]! {
    if N == 0 || (N & (N - 1)) != 0 {
        return Err(OramError.UnsupportedSize(N))
    }
    if N > MaxLeaves {
        return Err(OramError.SizeTooLarge(N))
    }
    let depth = levelOf(N)
    let mut mutStore = store
    let mut level: usize = 0
    for level <= depth {
        let one: usize = 1
        if mutStore.bucketCount(level) != (one << level) {
            return Err(OramError.StoreShapeMismatch)
        }
        level = level + 1
    }
    let mut positions = FixedArray.filled[u64, N](0)
    let mask = (N - 1).toU64()
    let mut state = nextState(seed)
    let mut i: usize = 0
    for i < N {
        state = nextState(state)
        positions[i] = mix64(state) & mask
        i = i + 1
    }
    Ok(ObliviousArray {
        store: mutStore
        positions: positions
        stash: FixedArray.filled[Block, StashCapacity](Block.empty())
        depth: depth
        rng: nextState(seed ^ 0xa5a5a5a5a5a5a5a5)
    })
}

/// Reads the value at a secret index. A slot that was never written is 0.
pub fn ObliviousArray[S: BucketStore, N].read(mut self, index: secret.SecretIndex[N]) -> u64! {
    self.access(index, 0, 0)
}

/// Writes a value at a secret index, replacing any earlier value.
pub fn ObliviousArray[S: BucketStore, N].write(mut self, index: secret.SecretIndex[N], value: u64) -> Void! {
    _ = self.access(index, value, 1)?
}

/// Checks the position map and every stored block against the tree shape.
///
/// The check is an audited failure assertion: a corrupt block is declassified
/// only to choose the error, never to choose an address.
pub fn ObliviousArray[S: BucketStore, N].verify(mut self) -> Void! {
    let mask = (N - 1).toU64()
    let mut i: usize = 0
    for i < N {
        let out = ~maskEq(self.positions[i] & ~mask, 0)
        if unsafe {
            secret.SecretU64.classify(out).declassify()
        } != 0 {
            return Err(OramError.CorruptPositionMap)
        }
        i = i + 1
    }
    let mut level: usize = 0
    for level <= self.depth {
        let count = self.store.bucketCount(level)
        let shift = (self.depth - level).toU64()
        let mut index: usize = 0
        for index < count {
            let bucket = self.store.readBucket(level, secret.SecretU32.classify(index.toU64().truncate[u32]()))
            let mut slot: usize = 0
            for slot < BucketCapacity {
                let block = bucket.slots[slot]
                let occupied = ~maskZero(block.id)
                let inRange = maskEq(block.pos & ~mask, 0)
                let nodeOk = maskEq(block.pos.wrappingShiftRight(shift), index.toU64())
                let bad = occupied & ~(inRange & nodeOk)
                if unsafe {
                    secret.SecretU64.classify(bad).declassify()
                } != 0 {
                    return Err(OramError.CorruptPosition(level))
                }
                slot = slot + 1
            }
            index = index + 1
        }
        level = level + 1
    }
    let mut s: usize = 0
    for s < StashCapacity {
        let block = self.stash[s]
        let occupied = ~maskZero(block.id)
        let bad = occupied & ~maskEq(block.pos & ~mask, 0)
        if unsafe {
            secret.SecretU64.classify(bad).declassify()
        } != 0 {
            return Err(OramError.CorruptPosition(0))
        }
        s = s + 1
    }
}

/// Accesses the storage adapter without exposing the position map or stash;
/// the callback result cannot keep a borrow.
pub fn ObliviousArray[S: BucketStore, N].withStore[R](self, f: fn(&S) -> R) -> R {
    f(&self.store)
}

pub fn ObliviousArray[S: BucketStore, N].withStoreMut[R](mut self, f: fn(&mut S) -> R) -> R {
    f(&mut self.store)
}

/// The public leaf count.
pub fn ObliviousArray[S: BucketStore, N].capacity(self) -> usize {
    N
}

/// The next random leaf, kept inside the mask width because `N` is a power of two.
fn ObliviousArray[S: BucketStore, N].nextLeaf(mut self) -> u64 {
    self.rng = nextState(self.rng)
    mix64(self.rng) & (N - 1).toU64()
}

// The read/write core. `writing` is a public 0/1 flag: the control flow and
// every storage access are identical for reads and writes.
fn ObliviousArray[S: BucketStore, N].access(mut self, index: secret.SecretIndex[N], value: u64, writing: u64) -> u64! {
    let target = index.secret().toU64()
    let targetRaw = unsafe {
        target.declassify()
    }
    let id = targetRaw.wrappingAdd(1)
    let leaf = secret.ctLookupU64(&self.positions, index)
    let found = self.fetch(id, leaf)
    let writingMask = flagMask(writing)
    let active = found.present | writingMask
    let newLeaf = self.nextLeaf()
    secret.ctUpdateU64(&mut self.positions, index, newLeaf)
    let block = Block {
        id: pick(active, id, 0)
        value: pick(writingMask, value, found.value)
        pos: pick(active, newLeaf, 0)
    }
    self.insertStash(block, active)?
    self.evict(newLeaf)
    Ok(pick(found.present, found.value, 0))
}

/// Removes the block with `target` from the stash and from every bucket on the
/// leaf's path, returning its value and whether it was present.
fn ObliviousArray[S: BucketStore, N].fetch(mut self, targetRaw: u64, leaf: u64) -> Found {
    let mut present: u64 = 0
    let mut value: u64 = 0
    let mut s: usize = 0
    for s < StashCapacity {
        let block = self.stash[s]
        let hit = maskEq(block.id, targetRaw)
        present = present | hit
        value = pick(hit, block.value, value)
        self.stash[s].id = pick(hit, 0, block.id)
        self.stash[s].value = pick(hit, 0, block.value)
        self.stash[s].pos = pick(hit, 0, block.pos)
        s = s + 1
    }
    let mut level: usize = 0
    for level <= self.depth {
        let node = self.nodeAt(level, leaf)
        let mut bucket = self.store.readBucket(level, node)
        let mut slot: usize = 0
        for slot < BucketCapacity {
            let block = bucket.slots[slot]
            let hit = maskEq(block.id, targetRaw)
            present = present | hit
            value = pick(hit, block.value, value)
            bucket.slots[slot].id = pick(hit, 0, block.id)
            bucket.slots[slot].value = pick(hit, 0, block.value)
            bucket.slots[slot].pos = pick(hit, 0, block.pos)
            slot = slot + 1
        }
        self.store.writeBucket(level, node, bucket)
        level = level + 1
    }
    Found {
        value: value
        present: present
    }
}

/// Places a block into the first free stash slot. `active` is all ones when
/// the block must be stored; the overflow branch is a failure assertion.
fn ObliviousArray[S: BucketStore, N].insertStash(mut self, block: Block, active: u64) -> Void! {
    let mut placed: u64 = 0
    let mut s: usize = 0
    for s < StashCapacity {
        let slot = self.stash[s]
        let take = active & maskZero(slot.id) & ~placed
        self.stash[s].id = pick(take, block.id, slot.id)
        self.stash[s].value = pick(take, block.value, slot.value)
        self.stash[s].pos = pick(take, block.pos, slot.pos)
        placed = placed | take
        s = s + 1
    }
    let failed = active & ~placed
    if unsafe {
        secret.SecretU64.classify(failed).declassify()
    } != 0 {
        return Err(OramError.StashOverflow)
    }
}

/// Greedily drops stash blocks into the path of `leaf`, from the leaf to the
/// root, so a block only goes into a bucket that lies on its own position path.
fn ObliviousArray[S: BucketStore, N].evict(mut self, leaf: u64) {
    let mut level = self.depth + 1
    for level > 0 {
        level = level - 1
        let node = self.nodeAt(level, leaf)
        let bucket = self.store.readBucket(level, node)
        let merged = self.merge(bucket, level, leaf)
        self.store.writeBucket(level, node, merged)
    }
}

fn ObliviousArray[S: BucketStore, N].merge(mut self, mut bucket: Bucket, level: usize, leaf: u64) -> Bucket {
    let shift = (self.depth - level).toU64()
    let leafNode = leaf.wrappingShiftRight(shift)
    let mut slot: usize = 0
    for slot < BucketCapacity {
        let mut taken: u64 = 0
        let free = maskZero(bucket.slots[slot].id)
        let mut s: usize = 0
        for s < StashCapacity {
            let block = self.stash[s]
            let occupied = ~maskZero(block.id)
            let eligible = maskEq(block.pos.wrappingShiftRight(shift), leafNode)
            let take = free & ~taken & occupied & eligible
            bucket.slots[slot].id = pick(take, block.id, bucket.slots[slot].id)
            bucket.slots[slot].value = pick(take, block.value, bucket.slots[slot].value)
            bucket.slots[slot].pos = pick(take, block.pos, bucket.slots[slot].pos)
            self.stash[s].id = pick(take, 0, block.id)
            self.stash[s].value = pick(take, 0, block.value)
            self.stash[s].pos = pick(take, 0, block.pos)
            taken = taken | take
            s = s + 1
        }
        slot = slot + 1
    }
    bucket
}

/// The secret node index at `level` on the path of `leaf`.
fn ObliviousArray[S: BucketStore, N].nodeAt(self, level: usize, leaf: u64) -> secret.SecretU32 {
    let shift = (self.depth - level).toU64()
    secret.SecretU32.classify(leaf.wrappingShiftRight(shift).truncate[u32]())
}

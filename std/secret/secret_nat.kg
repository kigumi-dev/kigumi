// Fixed-width naturals for constant-time arithmetic.
//
// A `SecretNat[N]` is exactly N little-endian 64-bit limbs. Nothing in the
// type checks which values are secret: keeping secrets out of branches and
// indices is the caller's discipline, and the modular helpers in
// `std/crypto/bigint` are the ones that hold it. There is deliberately no
// division, no normalization loop and no limb comparison that returns Bool;
// the only branches here test public lengths and N.
/// Why a fixed-width conversion was refused.
pub type NatError = | TooManyBytes

pub fn NatError.message(self) -> String {
    match self {
        TooManyBytes -> "secret: value does not fit N limbs"
    }
}

/// N little-endian 64-bit limbs of an unsigned integer. The modulus helpers
/// in `std/crypto/bigint` keep every value in [0, m).
pub type SecretNat[const N: usize] = {
    limbs FixedArray[u64, N]
}

/// Wraps N limbs without normalizing or checking them.
pub pure fn SecretNat[N].fromLimbs(limbs: FixedArray[u64, N]) -> SecretNat[N] {
    SecretNat { limbs: limbs }
}

/// Zero, as N zero limbs.
pub pure fn SecretNat[N].zero() -> SecretNat[N] {
    SecretNat { limbs: FixedArray.filled[u64, N](0) }
}

/// The public value `v` in the low limb and zeros above it.
pub pure fn SecretNat[N].fromU64(v: u64) -> SecretNat[N] {
    let mut limbs = FixedArray.filled[u64, N](0)
    if N > 0 {
        limbs[0] = v
    }
    SecretNat { limbs: limbs }
}

/// A big-endian byte string read as N limbs. More than 8*N bytes is an error,
/// so the caller's buffer and the limb width stay in step.
pub pure fn SecretNat[N].fromBytesBE(b: &Bytes) -> Result[SecretNat[N], NatError] {
    if b.len() > N * 8 {
        return Err(NatError.TooManyBytes)
    }
    let mut limbs = FixedArray.filled[u64, N](0)
    let mut pos: usize = 0
    let mut at: usize = 0
    for at < N {
        let mut k: usize = 0
        let mut word: u64 = 0
        for k < 8 {
            if pos < b.len() {
                let byte = b[b.len() - 1 - pos].toU64()
                word = word | byte.wrappingShiftLeft((k * 8).toU64())
                pos = pos + 1
            }
            k = k + 1
        }
        limbs[at] = word
        at = at + 1
    }
    Ok(SecretNat { limbs: limbs })
}

/// The limb at a public index. Callers pass loop counters, never secret
/// values, so the access itself does not leak.
pub pure fn SecretNat[N].limb(self, index: usize) -> u64 {
    self.limbs[index]
}

/// How many limbs the value occupies: always N.
pub pure fn SecretNat[N].limbCount(self) -> usize {
    N
}

/// Hands the limbs out of the secret domain. Only an audited boundary may
/// call this.
pub pure unsafe fn SecretNat[N].declassify(self) -> FixedArray[u64, N] {
    self.limbs
}

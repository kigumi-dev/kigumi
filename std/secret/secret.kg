/// A 64-bit all-ones or all-zeros mask. The field is private so ordinary code
/// cannot turn a secret comparison into a Bool.
pub type Choice = {
    m u64
}

/// An 8-bit value whose operations are meant for constant-time code.
pub type SecretU8 = {
    v u8
}

/// A 16-bit value whose operations are meant for constant-time code.
pub type SecretU16 = {
    v u16
}

/// A 32-bit value whose operations are meant for constant-time code.
pub type SecretU32 = {
    v u32
}

/// A 64-bit value whose operations are meant for constant-time code.
pub type SecretU64 = {
    v u64
}

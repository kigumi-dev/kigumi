/// A secret index for a fixed-size table. Construction is total: an index at
/// or past N selects nothing and leaves a table unchanged.
pub type SecretIndex[const N: usize] = {
    idx SecretU32
}

/// Wraps a secret integer as an index; no range is assumed or checked.
pub pure noalloc fn SecretIndex[N].from(idx: SecretU32) -> SecretIndex[N] {
    SecretIndex { idx: idx }
}

/// Selects one u64 from a fixed table without a secret-dependent branch,
/// address or index. N is public and every element is read.
pub pure fn ctLookupU64[const N: usize](table: &FixedArray[u64, N], idx: SecretIndex[N]) -> u64 {
    let mut out: u64 = 0
    let mut i: usize = 0
    for i < N {
        let slot = table.get(i) || 0
        let mask = SecretU32.classify((i.toU32() || 0)).ctEq(idx.idx)
        out = (mask.selectU64(SecretU64.classify(slot), SecretU64.classify(out))).v
        i = i + 1
    }
    out
}

/// Replaces one u64 with value when the secret index is in range; every public
/// element is updated through a mask.
pub pure fn ctUpdateU64[const N: usize](table: &mut FixedArray[u64, N], idx: SecretIndex[N], value: u64) {
    let mut i: usize = 0
    for i < N {
        let slot = table.get(i) || 0
        let mask = SecretU32.classify((i.toU32() || 0)).ctEq(idx.idx)
        let next = (mask.selectU64(SecretU64.classify(value), SecretU64.classify(slot))).v
        _ = table.set(i, next)
        i = i + 1
    }
}

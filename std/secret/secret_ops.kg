pub pure noalloc fn SecretU8.ctEq(self, other: SecretU8) -> Choice {
    Choice { m: ~maskNonZeroU64((self.v ^ other.v).toU64()) }
}

pub pure noalloc fn SecretU16.ctEq(self, other: SecretU16) -> Choice {
    Choice { m: ~maskNonZeroU64((self.v ^ other.v).toU64()) }
}

pub pure noalloc fn SecretU32.ctEq(self, other: SecretU32) -> Choice {
    Choice { m: ~maskNonZeroU64((self.v ^ other.v).toU64()) }
}

pub pure noalloc fn SecretU64.ctEq(self, other: SecretU64) -> Choice {
    Choice { m: ~maskNonZeroU64(self.v ^ other.v) }
}

pub pure noalloc fn Choice.ctEq(self, other: Choice) -> Choice {
    Choice { m: ~maskNonZeroU64(self.m ^ other.m) }
}

pub pure noalloc fn SecretU8.ctLt(self, other: SecretU8) -> Choice {
    Choice { m: maskLtU64(self.v.toU64(), other.v.toU64()) }
}

pub pure noalloc fn SecretU16.ctLt(self, other: SecretU16) -> Choice {
    Choice { m: maskLtU64(self.v.toU64(), other.v.toU64()) }
}


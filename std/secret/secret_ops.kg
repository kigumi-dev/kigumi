}

pub pure noalloc fn SecretU64.ctLt(self, other: SecretU64) -> Choice {
    Choice { m: maskLtU64(self.v, other.v) }
}

pub pure noalloc fn SecretU8.ctIsZero(self) -> Choice {
    Choice { m: ~maskNonZeroU64(self.v.toU64()) }
}

pub pure noalloc fn SecretU16.ctIsZero(self) -> Choice {
    Choice { m: ~maskNonZeroU64(self.v.toU64()) }
}

pub pure noalloc fn SecretU32.ctIsZero(self) -> Choice {

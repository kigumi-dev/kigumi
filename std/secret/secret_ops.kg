}

pub pure noalloc fn SecretU64.ctIsZero(self) -> Choice {
    Choice { m: ~maskNonZeroU64(self.v) }
}

pub pure noalloc fn Choice.selectU8(self, a: SecretU8, b: SecretU8) -> SecretU8 {
    SecretU8 { v: (selectU64(self.m, a.v.toU64(), b.v.toU64())).truncate[u8]() }
}

pub pure noalloc fn Choice.selectU16(self, a: SecretU16, b: SecretU16) -> SecretU16 {
    SecretU16 { v: (selectU64(self.m, a.v.toU64(), b.v.toU64())).truncate[u16]() }
}

pub pure noalloc fn Choice.selectU32(self, a: SecretU32, b: SecretU32) -> SecretU32 {
    SecretU32 { v: (selectU64(self.m, a.v.toU64(), b.v.toU64())).truncate[u32]() }
}

pub pure noalloc fn Choice.selectU64(self, a: SecretU64, b: SecretU64) -> SecretU64 {
    SecretU64 { v: selectU64(self.m, a.v, b.v) }
}

pub pure noalloc fn Choice.&(a: Choice, b: Choice) -> Choice {
    Choice { m: a.m & b.m }
}

pub pure noalloc fn Choice.|(a: Choice, b: Choice) -> Choice {
    Choice { m: a.m | b.m }
}

pub pure noalloc fn Choice.~(a: Choice) -> Choice {
    Choice { m: ~a.m }
}

pub pure noalloc fn ctEqBytes(a: &Bytes, b: &Bytes) -> Choice {
    Choice { m: eqBytes(a, b) }
}


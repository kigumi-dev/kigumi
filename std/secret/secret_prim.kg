/// Keeps the value opaque to the optimiser while returning it unchanged.
pub pure noalloc fn barrierU64(x: u64) -> u64

/// All ones when x is non-zero, otherwise zero.
pub pure noalloc fn maskNonZeroU64(x: u64) -> u64

/// All ones when a is unsigned-less than b, otherwise zero.
pub pure noalloc fn maskLtU64(a: u64, b: u64) -> u64

/// a when m is all ones and b when m is zero; m must be one of those two.
pub pure noalloc fn selectU64(m: u64, a: u64, b: u64) -> u64

/// All ones when the byte strings have equal length and bytes, otherwise zero.
pub pure noalloc fn eqBytes(a: &Bytes, b: &Bytes) -> u64

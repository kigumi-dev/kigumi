import mem from std/mem

/// An owned byte sequence that is wiped before it is released. It is not Copy
/// and exposes no way to read the bytes except through `unsafe declassify`.
pub type SecretBuffer = resource {
    units Bytes
}

/// Copies the bytes of s into a new buffer.
pub pure fn SecretBuffer.fromString(s: String) -> SecretBuffer {
    SecretBuffer { units: s.toBytes() }
}

/// Number of bytes; the length is public.
pub pure noalloc fn SecretBuffer.len(self) -> usize {
    self.units.len()
}

/// Whether both buffers have the same length and bytes, without a data-dependent branch.
pub pure noalloc fn SecretBuffer.ctEq(self, other: &SecretBuffer) -> Choice {
    ctEqBytes(&self.units, &other.units)
}

/// The owned bytes. The caller accepts that the bytes become visible.
pub pure unsafe fn SecretBuffer.declassify(move self) -> Bytes {
    // `self.units` shares the storage the drop wipes, and a swap frees it unwiped, so the bytes leave as a copy.
    declassifyBytes(&self.units)
}

/// Wipes the contents before the resource is released.
pub fn SecretBuffer.drop(move self) {
    let mut units = move self.units
    mem.secureErase(&mut units)
}

pub pure noalloc fn SecretBuffer.equals(self, other: &SecretBuffer) -> Choice {
    self.ctEq(other)
}

pub pure noalloc fn SecretBuffer.hash(self) -> Choice {
    ctEqBytes(&self.units, &self.units)
}

pub pure noalloc fn SecretBuffer.display(self) -> Choice {
    ctEqBytes(&self.units, &self.units)
}

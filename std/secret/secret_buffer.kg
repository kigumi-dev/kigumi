import mem from std/mem

/// An owned byte sequence that is wiped before it is released. It is not Copy
/// and exposes no way to read the bytes except through `unsafe declassify`.
pub type SecretBuffer = resource {
    units Bytes
}

/// Copies the bytes of s into a new buffer.
pub pure fn SecretBuffer.fromString(s: String) -> SecretBuffer {
    SecretBuffer { units: s.toBytes() }
}

/// Wraps bytes the caller already owns as a secret buffer.
pub pure fn SecretBuffer.fromBytes(b: Bytes) -> SecretBuffer {
    SecretBuffer { units: b }
}

/// Number of bytes; the length is public.
pub pure noalloc fn SecretBuffer.len(self) -> usize {
    self.units.len()
}

/// Whether both buffers have the same length and bytes, without a data-dependent branch.
pub pure noalloc fn SecretBuffer.ctEq(self, other: &SecretBuffer) -> Choice {
    ctEqBytes(&self.units, &other.units)
}

/// The owned bytes. The caller accepts that the bytes become visible.
pub pure unsafe fn SecretBuffer.declassify(move self) -> Bytes {
    // `self.units` shares the storage the drop wipes, and a swap frees it unwiped, so the bytes leave as a copy.
    declassifyBytes(&self.units)
}

/// Wipes the contents before the resource is released.
pub fn SecretBuffer.drop(move self) {
    let mut units = move self.units
    mem.secureErase(&mut units)
}

pub pure noalloc fn SecretBuffer.equals(self, other: &SecretBuffer) -> Choice {
    self.ctEq(other)
}

pub pure noalloc fn SecretBuffer.hash(self) -> Choice {
    ctEqBytes(&self.units, &self.units)
}

pub pure noalloc fn SecretBuffer.display(self) -> Choice {
    ctEqBytes(&self.units, &self.units)
}

/// An independent copy; the source is wiped when it is released, so the copy
/// owns its own storage.
pub pure fn SecretBuffer.copy(self) -> SecretBuffer {
    let mut out = ByteBuffer.tryNew(self.units.len()) || panic("out of memory")
    let mut i: usize = 0
    for i < self.units.len() {
        out.set(i, self.units[i])
        i = i + 1
    }
    SecretBuffer { units: out.freeze() }
}

/// A buffer holding the bytes of `items`, which stay in the secret domain.
pub pure fn SecretBuffer.fromSecretArray(items: Array[SecretU8]) -> SecretBuffer {
    let mut out = ByteBuffer.tryNew(items.len()) || panic("out of memory")
    let mut i: usize = 0
    for i < items.len() {
        out.set(i, items[i].v)
        i = i + 1
    }
    SecretBuffer { units: out.freeze() }
}

/// The byte at a public index, staying in the secret domain.
pub pure noalloc fn SecretBuffer.byteAt(self, at: usize) -> SecretU8 {
    SecretU8 { v: self.units[at] }
}

/// The four-byte little-endian word at a public index. The byte shifts stay
/// in the `SecretU32` domain, so no checked plain shift sees a secret byte.
pub pure noalloc fn SecretBuffer.wordLE(self, at: usize) -> SecretU32 {
    let b0 = SecretU8 { v: self.units[at] }.toU32()
    let b1 = SecretU8 { v: self.units[at + 1] }.toU32()
    let b2 = SecretU8 { v: self.units[at + 2] }.toU32()
    let b3 = SecretU8 { v: self.units[at + 3] }.toU32()
    b0 | b1.shiftLeft(8) | b2.shiftLeft(16) | b3.shiftLeft(24)
}

/// The four-byte big-endian word at a public index.
pub pure noalloc fn SecretBuffer.wordBE(self, at: usize) -> SecretU32 {
    let b0 = SecretU8 { v: self.units[at] }.toU32()
    let b1 = SecretU8 { v: self.units[at + 1] }.toU32()
    let b2 = SecretU8 { v: self.units[at + 2] }.toU32()
    let b3 = SecretU8 { v: self.units[at + 3] }.toU32()
    b0.shiftLeft(24) | b1.shiftLeft(16) | b2.shiftLeft(8) | b3
}

/// Whether the secret bytes equal public bytes, in constant time.
pub pure noalloc fn SecretBuffer.ctEqPublic(self, other: &Bytes) -> Choice {
    ctEqBytes(&self.units, other)
}

/// A new buffer holding self's bytes each XORed with the public byte `pad`.
pub pure fn SecretBuffer.xorByte(self, pad: u8) -> SecretBuffer {
    let mut out = ByteBuffer.tryNew(self.units.len()) || panic("out of memory")
    let mut i: usize = 0
    for i < self.units.len() {
        out.set(i, self.units[i] ^ pad)
        i = i + 1
    }
    SecretBuffer { units: out.freeze() }
}

/// A new buffer holding self's bytes followed by other's.
pub pure fn SecretBuffer.concat(self, other: SecretBuffer) -> SecretBuffer {
    let n = self.units.len() + other.units.len()
    let mut out = ByteBuffer.tryNew(n) || panic("out of memory")
    let mut i: usize = 0
    for i < self.units.len() {
        out.set(i, self.units[i])
        i = i + 1
    }
    let mut j: usize = 0
    for j < other.units.len() {
        out.set(self.units.len() + j, other.units[j])
        j = j + 1
    }
    SecretBuffer { units: out.freeze() }
}

/// A new buffer holding self[start..end]; the range is public.
pub pure fn SecretBuffer.sliceSecret(self, start: usize, end: usize) -> SecretBuffer {
    let mut out = ByteBuffer.tryNew(end - start) || panic("out of memory")
    let mut i: usize = start
    for i < end {
        out.set(i - start, self.units[i])
        i = i + 1
    }
    SecretBuffer { units: out.freeze() }
}

/// Constant-time comparison of a secret buffer with public bytes, exported as
/// a CT conformance shape. It has no loop or branch.
pub pure noalloc fn secretEqPublic(a: &SecretBuffer, b: &Bytes) -> Choice {
    a.ctEqPublic(b)
}

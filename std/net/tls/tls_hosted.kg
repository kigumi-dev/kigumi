import p256 from std/crypto/p256
import sha256 from std/crypto/sha256
import x25519 from std/crypto/x25519
import x509 from std/crypto/x509
import binary from std/encoding/binary
import net from std/net
import sec from std/secret
import task from std/task

/// The TLS client entry point: `Client.connect(conn, config)`.
pub type Client

type Message = {
    typ u8
    body Bytes
    raw Bytes
}

fn noKeys() -> Direction {
    Direction {
        secret: sec.SecretBuffer.fromBytes(Bytes.zeros(hashSize))
        key: sec.SecretBuffer.fromBytes(Bytes.zeros(keySize))
        iv: sec.SecretBuffer.fromBytes(Bytes.zeros(ivSize))
    }
}

fn alertError(payload: Bytes) -> Error {
    if payload.len() != 2 {
        return Error.BadRecord("alert record has ${payload.len()} bytes")
    }
    Error.Alert(payload[0], payload[1])
}

fn outboundAlert(level: u8, description: u8) -> Bytes {
    let mut body = Array.empty[u8]()
    putU8(&mut body, level)
    putU8(&mut body, description)
    freeze(&body)
}

// The alert a fatal error maps to (RFC 8446 §6.2).
fn alertDescription(e: &Error) -> u8 {
    match e {
        BadCertificate(_) -> 42
        BadSignature -> 51
        BadFinished -> 51
        UnexpectedMessage(_) -> 10
        Unsupported(_) -> 40
        MalformedHandshake(_) -> 50
        RecordOverflow -> 22
        HandshakeOverflow -> 50
        BadRecord(_) -> 50
        TicketReplay -> 47
        TicketExpired -> 47
        EarlyDataRejected(_) -> 47
        ClientAuthRequired -> 116
        _ -> 80
    }
}

fn allZero(b: Bytes) -> Bool {
    let mut diff: u8 = 0
    let mut i: usize = 0
    for i < b.len() {
        diff = diff | b[i]
        i = i + 1
    }
    diff == 0
}

/// The public half of an ephemeral ECDH secret for a group this client
/// supports. The first ClientHello uses x25519; secp256r1 is only reached
/// when a HelloRetryRequest selects it.
/// The P-256 scalar parser still takes public limbs; the TLS key exchange
/// releases a copy at this explicit boundary.
fn p256Scalar(secret: &sec.SecretBuffer) -> Bytes {
    unsafe {
        secret.copy().declassify()
    }
}

/// Whether a secret buffer is all zero, compared without a data-dependent
/// branch. The answer is the public accept/reject decision.
fn secretAllZero(b: &sec.SecretBuffer) -> Bool {
    unsafe {
        b.ctEqPublic(&Bytes.zeros(b.len())).declassify()
    }
}

fn ephemeralPublic(group: u16, secret: &sec.SecretBuffer) -> Result[Bytes, Error] {
    if group == x25519Group {
        if secret.len() != x25519.keySize {
            fail Error.MalformedHandshake("x25519 secret must be 32 bytes")
        }
        let public = match x25519.publicKey(secret) {
            Ok(value) -> value
            Err(e) -> fail Error.KeySchedule(e.message())
        }
        if allZero(public) {
            fail Error.KeySchedule("x25519 public key is all zero")
        }
        Ok(public)
    } else if group == secp256r1Group {
        if secret.len() != p256.scalarSize {
            fail Error.MalformedHandshake("secp256r1 secret must be 32 bytes")
        }
        match p256.publicKey(p256Scalar(secret)) {
            Ok(value) -> Ok(value)
            Err(e) -> fail Error.KeySchedule(e.message())
        }
    } else {
        fail Error.Unsupported("key exchange group ${group} is not supported")
    }
}

/// The ECDH shared secret for a group, with the peer's public key checked
/// by the curve implementation.
fn keyExchangeShared(group: u16, secret: &sec.SecretBuffer, peer: Bytes) -> Result[sec.SecretBuffer, Error] {
    if group == x25519Group {
        if peer.len() != 32 {
            fail Error.MalformedHandshake("x25519 key share must be 32 bytes")
        }
        let shared = match x25519.sharedSecret(secret, peer) {
            Ok(value) -> value
            Err(e) -> fail Error.KeySchedule(e.message())
        }
        if secretAllZero(&shared) {
            fail Error.KeySchedule("x25519 shared secret is all zero")
        }
        Ok(shared)
    } else if group == secp256r1Group {
        match p256.sharedSecret(p256Scalar(secret), peer) {
            Ok(value) -> Ok(sec.SecretBuffer.fromBytes(value))
            Err(e) -> fail Error.KeySchedule(e.message())
        }
    } else {
        fail Error.Unsupported("key exchange group ${group} is not supported")
    }
}

/// One TLS session. It owns the connection; dropping the session closes it.
pub type Session = resource {
    mut conn net.Conn
    mut pending Bytes
    mut hsBuf Array[u8]
    mut appBuf sec.SecretBuffer
    mut readKeys Direction
    mut writeKeys Direction
    mut readSeq u64
    mut writeSeq u64
    mut readProtected Bool
    mut writeProtected Bool
    mut open Bool
    mut established Bool
    maxRecordBytes usize
    maxHandshakeBytes usize
    maxCertificateBytes usize
    mut negotiatedProtocol String
    mut serverName String
    // The resumption master secret and the tickets the peer issued. Both
    // are only meaningful after the handshake.
    mut resumptionMaster sec.SecretBuffer
    mut resumptionTranscript Bytes
    mut ticket SessionTicket?
    mut resumedSession Bool
    mut nowMillis Int
    // 0-RTT state: client early write keys or server early read keys. The
    // sequence numbers are separate from the handshake and application
    // spaces, as RFC 8446 §5.3 requires.
    mut earlyReadKeys Direction
    mut earlyWriteKeys Direction
    mut earlyReadSeq u64
    mut earlyWriteSeq u64
    mut earlyReadOpen Bool
    mut earlyWriteOpen Bool
    mut earlyOk Bool
    mut sentEarlyData Bool
    // A record read while probing for 0-RTT but not decrypted under the
    // early keys, replayed to the handshake reader.
    mut pendingRaw RawRecord?
}

/// A raw record as it arrived, before any protection is removed.
pub type RawRecord = {
    typ u8
    header Bytes
    payload Bytes
}

/// Runs the handshake over conn and returns a session ready for application
/// data. Any failure closes the connection, so no plaintext path remains.
pub async fn Client.connect(conn: net.Conn, config: Config) -> Result[Session, Error] {
    let mut session = newSession(conn, config.maxRecordBytes, config.maxHandshakeBytes, config.maxCertificateBytes)
    match (await session.runHandshake(config)) {
        Ok(_) -> {}
        Err(e) -> {
            // Best effort: the peer should learn the connection is over even
            // when the failure was ours, then the session drops the socket.
            await session.sendAlert(2, alertDescription(&e))
            session.open = false
            return Err(e)
        }
    }
    Ok(session)
}

// A session with no keys installed, shared by the client and server entry
// points so both start from the same bounded state.
fn newSession(conn: net.Conn, maxRecordBytes: usize, maxHandshakeBytes: usize, maxCertificateBytes: usize) -> Session {
    Session {
        conn: conn
        pending: Bytes.zeros(0)
        hsBuf: Array.empty[u8]()
        appBuf: sec.SecretBuffer.fromBytes(Bytes.zeros(0))
        readKeys: noKeys()
        writeKeys: noKeys()
        readSeq: 0
        writeSeq: 0
        readProtected: false
        writeProtected: false
        open: true
        established: false
        maxRecordBytes: maxRecordBytes
        maxHandshakeBytes: maxHandshakeBytes
        maxCertificateBytes: maxCertificateBytes
        negotiatedProtocol: ""
        serverName: ""
        resumptionMaster: sec.SecretBuffer.fromBytes(Bytes.zeros(0))
        resumptionTranscript: Bytes.zeros(0)
        ticket: None
        resumedSession: false
        nowMillis: 0
        earlyReadKeys: noKeys()
        earlyWriteKeys: noKeys()
        earlyReadSeq: 0
        earlyWriteSeq: 0
        earlyReadOpen: false
        earlyWriteOpen: false
        earlyOk: false
        sentEarlyData: false
        pendingRaw: None
    }
}

/// The ALPN protocol the server selected, or "" when it did not send one.
pub fn Session.alpn(self) -> String {
    self.negotiatedProtocol
}

/// Whether the handshake completed and the session was not closed.
pub fn Session.ready(self) -> Bool {
    self.established && self.open
}

/// Whether this session resumed from a PSK, so no server certificate was
/// sent.
pub fn Session.resumed(self) -> Bool {
    self.resumedSession
}

/// Whether the server accepted the 0-RTT data this client offered.
pub fn Session.earlyDataAccepted(self) -> Bool {
    self.earlyOk
}

/// The newest resumption ticket the server issued, if any.
pub fn Session.resumptionTicket(self) -> SessionTicket? {
    match &self.ticket {
        Some(value) -> Some(SessionTicket {
            serverName: value.serverName
            alpn: value.alpn
            ticket: value.ticket
            psk: value.psk
            lifetimeMillis: value.lifetimeMillis
            issuedAtMillis: value.issuedAtMillis
            ageAdd: value.ageAdd
            maxEarlyData: value.maxEarlyData
        })
        None -> None
    }
}

// ---- transport ----------------------------------------------------------
type Filled = More | Eof

async fn Session.fill(mut self) -> Result[Filled, Error] {
    let mut chunk = Array.empty[u8]()
    for true {
        match self.conn.pollRead(&mut chunk, 16384) {
            Ok(Some(0)) -> return Eof
            Ok(Some(_)) -> {
                self.pending = self.pending.concat(Bytes.fromArray(&chunk))
                return More
            }
            Ok(None) -> await task.yieldNow()
            Err(e) -> fail Error.Io(e.message())
        }
    }
    Eof
}

async fn Session.ensure(mut self, needed: usize) -> Result[Void, Error] {
    for self.pending.len() < needed {
        if (await self.fill())? is Eof {
            fail Error.ConnectionClosed
        }
    }
}

async fn Session.writeRaw(mut self, data: Bytes) -> Result[Void, Error] {
    let mut off: usize = 0
    for off < data.len() {
        let rest = data.slice(off, data.len()) || fail Error.Io("write slice out of bounds")
        match self.conn.pollWrite(rest) {
            Ok(Some(n)) -> {
                off = off + n
            }
            Ok(None) -> await task.yieldNow()
            Err(e) -> fail Error.Io(e.message())
        }
    }
}

async fn Session.readRawRecord(mut self) -> Result[RawRecord, Error] {
    (await self.ensure(5))?
    let header = self.pending.slice(0, 5) || fail Error.BadRecord("truncated record header")
    let typ = header[0]
    let version = binary.u16Be(header, 1) || fail Error.BadRecord("truncated record version")
    let length = (binary.u16Be(header, 3) || 0).toUsize()
    if length > self.maxRecordBytes || length > maxCiphertext {
        fail Error.RecordOverflow
    }
    if typ == changeCipherSpecType {
        // RFC 8446 §5: a compatibility change_cipher_spec may still arrive
        // in plaintext after the ServerHello, so it is accepted even once
        // the read keys are installed. It carries exactly one 0x01.
        if version != 0x0301 && version != 0x0303 {
            fail Error.BadRecord("change_cipher_spec legacy_version ${version}")
        }
        if length != 1 {
            fail Error.BadRecord("change_cipher_spec length is ${length}, not 1")
        }
    } else if self.readProtected {
        if version != legacyVersion {
            fail Error.BadRecord("protected record legacy_version ${version} is not 0x0303")
        }
        if typ != protectedType {
            fail Error.BadRecord("protected record has outer content type ${typ}")
        }
    } else {
        if version != 0x0301 && version != 0x0303 {
            fail Error.BadRecord("plaintext record legacy_version ${version}")
        }
        if typ != handshakeType && typ != alertType && typ != changeCipherSpecType && typ != applicationDataType {
            fail Error.BadRecord("unknown plaintext content type ${typ}")
        }
        if length > maxPlaintext {
            fail Error.RecordOverflow
        }
    }
    (await self.ensure(5 + length))?
    let payload = self.pending.slice(5, 5 + length) || fail Error.BadRecord("truncated record body")
    self.pending = self.pending.slice(5 + length, self.pending.len()) || Bytes.zeros(0)
    Ok(RawRecord {
        typ: typ
        header: header
        payload: payload
    })
}

async fn Session.readRecord(mut self) -> Result[Record, Error] {
    for true {
        let raw = match self.pendingRaw {
            Some(value) -> {
                self.pendingRaw = None
                value
            }
            None -> (await self.readRawRecord())?
        }
        if raw.typ == changeCipherSpecType {
            if raw.payload.len() != 1 || raw.payload[0] != 1 {
                fail Error.BadRecord("change_cipher_spec must carry exactly one 0x01 byte")
            }
            continue
        }
        if self.readProtected {
            if self.readSeq == 18446744073709551615 {
                fail Error.BadRecord("record sequence number exhausted")
            }
            let record = openRecord(&self.readKeys, self.readSeq, raw.header, raw.payload)?
            self.readSeq = self.readSeq.wrappingAdd(1)
            return record
        }
        return Record {
            typ: raw.typ
            payload: sec.SecretBuffer.fromBytes(raw.payload)
        }
    }
    fail Error.ConnectionClosed
}

// ---- handshake message stream ------------------------------------------
fn Session.takeHandshake(mut self) -> Result[Message?, Error] {
    if self.hsBuf.len() < 4 {
        return None
    }
    // The header is read in place: concatenating every record into one
    // Bytes value would copy the buffer once per record.
    let length = (self.hsBuf[1].toUsize() << 16) | (self.hsBuf[2].toUsize() << 8) | self.hsBuf[3].toUsize()
    if length > self.maxHandshakeBytes {
        fail Error.HandshakeOverflow
    }
    let total = 4 + length
    if self.hsBuf.len() < total {
        return None
    }
    let rawBytes = self.hsBuf.slice(0, total) || fail Error.BadRecord("handshake slice out of bounds")
    self.hsBuf = self.hsBuf.slice(total, self.hsBuf.len()) || fail Error.BadRecord("handshake slice out of bounds")
    let raw = Bytes.fromArray(&rawBytes)
    Some(Message {
        typ: raw[0]
        body: raw.slice(4, total) || fail Error.BadRecord("handshake body out of bounds")
        raw: raw
    })
}

async fn Session.nextHandshake(mut self) -> Result[Message, Error] {
    for true {
        if let Some(message) = self.takeHandshake()? {
            return message
        }
        if self.hsBuf.len() > self.maxHandshakeBytes {
            fail Error.HandshakeOverflow
        }
        let record = (await self.readRecord())?
        if record.typ == handshakeType {
            // Handshake messages are protocol data: the parser is the
            // explicit boundary where record plaintext becomes public.
            append(&mut self.hsBuf, unsafe {
                record.payload.declassify()
            })
        } else if record.typ == alertType {
            fail alertError(unsafe {
                record.payload.declassify()
            })
        } else if record.typ == applicationDataType {
            fail Error.UnexpectedMessage("application data arrived during the handshake")
        } else {
            fail Error.UnexpectedMessage("content type ${record.typ} arrived during the handshake")
        }
    }
    fail Error.ConnectionClosed
}

async fn Session.sendHandshake(mut self, message: Bytes) -> Result[Void, Error] {
    if !self.writeProtected {
        (await self.writeRaw((sealPlaintext(handshakeType, message))?))?
        return Ok(())
    }
    if self.writeSeq == 18446744073709551615 {
        fail Error.BadRecord("record sequence number exhausted")
    }
    let record = sealRecord(&self.writeKeys, self.writeSeq, handshakeType, &sec.SecretBuffer.fromBytes(message))?
    self.writeSeq = self.writeSeq.wrappingAdd(1)
    await self.writeRaw(record)
}

// Sends a run of handshake messages as consecutive protected records,
// fragmenting at the plaintext cap so a large certificate chain still
// fits. A handshake message may span records (RFC 8446 §5.1); the peer
// reassembles it from the stream.
async fn Session.sendHandshakeFlight(mut self, flight: Bytes) -> Result[Void, Error] {
    let mut off: usize = 0
    for off < flight.len() {
        let left = flight.len() - off
        let take = if left < maxPlaintext {
            left
        } else {
            maxPlaintext
        }
        if self.writeSeq == 18446744073709551615 {
            fail Error.BadRecord("record sequence number exhausted")
        }
        let chunk = flight.slice(off, off + take) || fail Error.BadRecord("flight slice out of bounds")
        let record = sealRecord(&self.writeKeys, self.writeSeq, handshakeType, &sec.SecretBuffer.fromBytes(chunk))?
        self.writeSeq = self.writeSeq.wrappingAdd(1)
        (await self.writeRaw(record))?
        off = off + take
    }
    Ok(())
}

async fn Session.sendAlert(mut self, level: u8, description: u8) {
    let body = outboundAlert(level, description)
    if !self.writeProtected {
        if sealPlaintext(alertType, body) is Ok(record) {
            _ = await self.writeRaw(record)
        }
    } else if self.writeSeq != 18446744073709551615 {
        if sealRecord(&self.writeKeys, self.writeSeq, alertType, &sec.SecretBuffer.fromBytes(body)) is Ok(record) {
            _ = await self.writeRaw(record)
        }
    }
}

// ---- handshake ----------------------------------------------------------
async fn Session.runHandshake(mut self, config: Config) -> Result[Void, Error] {
    if config.serverName == "" {
        fail Error.BadCertificate("server name is empty")
    }
    if config.alpn.len() == 0 {
        fail Error.Unsupported("no ALPN protocol was configured")
    }
    let nowMillis = config.nowMillis
    let randomFn = config.random
    let serverName = config.serverName
    let anchors = move config.anchors
    let alpn = move config.alpn
    let sessionOffer = move config.session
    let earlyPayload = move config.earlyData
    let earlyMaxAge = config.earlyDataMaxAgeMillis
    let clientCertificates = move config.clientCertificates
    let clientKey = move config.clientKey
    if sessionOffer is None && anchors.len() == 0 {
        fail Error.BadCertificate("no trust anchors were supplied")
    }
    self.nowMillis = nowMillis
    self.serverName = serverName

    let random = match randomFn(32) {
        Ok(value) -> value
        Err(e) -> fail Error.Random(e.message())
    }
    if random.len() != 32 {
        fail Error.MalformedHandshake("random source returned ${random.len()} bytes, not 32")
    }
    let sessionId = match randomFn(32) {
        Ok(value) -> value
        Err(e) -> fail Error.Random(e.message())
    }
    if sessionId.len() > 32 {
        fail Error.MalformedHandshake("session id from the random source is too long")
    }
    let mut group = x25519Group
    let mut secret = sec.SecretBuffer.fromBytes(match randomFn(32) {
        Ok(value) -> value
        Err(e) -> fail Error.Random(e.message())
    })
    let mut public = ephemeralPublic(group, &secret)?
    let offeredAlpn = alpn.clone()

    // A ticket is offered only to the server and protocol that issued it,
    // while it is live, and 0-RTT is attempted only inside its age window.
    let mut pskOffer: PskOffer? = None
    let mut pskValue = sec.SecretBuffer.fromBytes(Bytes.zeros(0))
    let mut earlyBytes = sec.SecretBuffer.fromBytes(Bytes.zeros(0))
    if let Some(ticket) = sessionOffer {
        let age = nowMillis - ticket.issuedAtMillis
        let live = ticket.lifetimeMillis > 0 && age >= 0 && age <= ticket.lifetimeMillis
        let mut sameAlpn = ticket.alpn == ""
        for candidate in &alpn {
            if candidate == ticket.alpn {
                sameAlpn = true
            }
        }
        if ticket.serverName == serverName && sameAlpn && live {
            pskValue = ticket.psk.toBuffer()
            if earlyPayload.len() != 0 && age <= earlyMaxAge && earlyPayload.len().toU64() <= ticket.maxEarlyData.toU64() {
                earlyBytes = earlyPayload
            }
            let obfuscated = (((age.toU64() || 0) + ticket.ageAdd.toU64()) & 0xffffffff).toU32() || 0
            pskOffer = Some(PskOffer {
                identity: ticket.ticket
                obfuscatedAge: obfuscated
                psk: ticket.psk.toBuffer()
                earlyData: earlyBytes.len() != 0
            })
        }
    }
    let mut pskActive = pskOffer is Some(_)

    let hello = match pskOffer {
        Some(offer) -> clientHelloPsk(group, random, sessionId, public, None, serverName, offeredAlpn.clone(), offer)?
        None -> clientHello(random, sessionId, public, serverName, offeredAlpn.clone())?
    }
    (await self.writeRaw((sealPlaintext(handshakeType, hello))?))?

    // 0-RTT records follow the ClientHello immediately, under the early
    // traffic secret, which is the only key the server can use before it
    // answers.
    if earlyBytes.len() != 0 {
        self.earlyWriteKeys = deriveEarlyTraffic(&pskValue, sha256.sum(hello))?
        self.earlyWriteSeq = 0
        self.earlyWriteOpen = true
        self.sentEarlyData = true
        (await self.sendEarlyData(&earlyBytes))?
    }

    let mut transcript = hello
    let mut retried = false
    let mut hrrSuite: u16 = 0
    let mut serverHello: ParsedServerHello? = None
    for true {
        let message = (await self.nextHandshake())?
        if message.typ != serverHelloType {
            fail Error.UnexpectedMessage("expected ServerHello, got handshake type ${message.typ}")
        }
        match parseServerHello(message.body, pskActive)? {
            Retry(hrr) -> {
                if retried {
                    fail Error.UnexpectedMessage("server sent a second HelloRetryRequest")
                }
                if self.sentEarlyData {
                    fail Error.EarlyDataRejected("a HelloRetryRequest cannot be combined with 0-RTT")
                }
                if !hrr.sessionId.equals(&sessionId) {
                    fail Error.MalformedHandshake("HelloRetryRequest did not echo the client session id")
                }
                // RFC 8446 §4.4.1: the transcript restarts with a synthetic
                // message_hash over ClientHello1, followed by the
                // HelloRetryRequest and the second ClientHello.
                transcript = (encodeHandshake(messageHashType, sha256.sum(transcript))?).concat(message.raw)
                let nextGroup = match hrr.selectedGroup {
                    Some(value) -> value
                    None -> group
                }
                if nextGroup != group {
                    group = nextGroup
                    secret = sec.SecretBuffer.fromBytes(match randomFn(32) {
                        Ok(value) -> value
                        Err(e) -> fail Error.Random(e.message())
                    })
                    public = ephemeralPublic(group, &secret)?
                }
                // A second ClientHello never carries the PSK: the server
                // did not select it in the first exchange.
                pskActive = false
                let retryHello = clientHelloWithShare(group, random, sessionId, public, hrr.cookie, serverName, offeredAlpn.clone())?
                (await self.sendHandshake(retryHello))?
                transcript = transcript.concat(retryHello)
                hrrSuite = hrr.cipherSuite
                retried = true
            }
            Hello(parsed) -> {
                if !parsed.sessionId.equals(&sessionId) {
                    fail Error.MalformedHandshake("ServerHello did not echo the client session id")
                }
                if parsed.group != group {
                    fail Error.MalformedHandshake("ServerHello selected key share group ${parsed.group}, but the ClientHello sent group ${group}")
                }
                if retried && parsed.cipherSuite != hrrSuite {
                    fail Error.MalformedHandshake("ServerHello changed the cipher suite from the HelloRetryRequest")
                }
                transcript = transcript.concat(message.raw)
                serverHello = Some(parsed)
                break
            }
        }
    }
    let helloParsed = match serverHello {
        Some(value) -> value
        None -> fail Error.UnexpectedMessage("server sent no ServerHello")
    }
    let resumed = match helloParsed.selectedIdentity {
        Some(index) -> {
            if !pskActive || index != 0 {
                fail Error.MalformedHandshake("server selected PSK identity ${index}, which was not offered")
            }
            true
        }
        None -> false
    }
    if !resumed {
        self.earlyOk = false
    }
    // Everything after the ServerHello must arrive under the record layer
    // this client is about to install; a plaintext message already buffered
    // would otherwise be read as if it were protected.
    if self.hsBuf.len() != 0 {
        fail Error.UnexpectedMessage("plaintext handshake bytes follow the ServerHello")
    }

    let sharedSecret = keyExchangeShared(group, &secret, helloParsed.keyShare)?
    let secrets = match if resumed {
        deriveHandshakePsk(&pskValue, &sharedSecret, sha256.sum(transcript))
    } else {
        deriveHandshake(&sharedSecret, sha256.sum(transcript))
    } {
        Ok(value) -> value
        Err(e) -> fail e
    }
    self.readKeys = move secrets.server
    self.writeKeys = move secrets.client
    self.readProtected = true
    self.writeProtected = true
    self.readSeq = 0
    self.writeSeq = 0
    self.resumedSession = resumed

    let eeMessage = (await self.nextHandshake())?
    if eeMessage.typ != encryptedExtensionsType {
        fail Error.UnexpectedMessage("expected EncryptedExtensions, got handshake type ${eeMessage.typ}")
    }
    let ee = parseEncryptedExtensions(eeMessage.body)?
    if let Some(protocol) = ee.alpn {
        let mut offered = false
        for candidate in &offeredAlpn {
            if candidate == protocol {
                offered = true
            }
        }
        if !offered {
            fail Error.Unsupported("server selected ALPN protocol `${protocol}`, which was not offered")
        }
        self.negotiatedProtocol = protocol
    }
    if ee.earlyData {
        if !resumed || !self.sentEarlyData {
            fail Error.Unsupported("server accepted early data this client never offered")
        }
        self.earlyOk = true
    }
    transcript = transcript.concat(eeMessage.raw)

    // A CertificateRequest may precede the server's authentication flight
    // (or its Finished, on resumption).
    let mut request: ParsedCertificateRequest? = None
    let mut next = (await self.nextHandshake())?
    if next.typ == certificateRequestType {
        request = Some(parseCertificateRequest(next.body)?)
        transcript = transcript.concat(next.raw)
        next = (await self.nextHandshake())?
    }

    if resumed {
        if next.typ != finishedType {
            fail Error.UnexpectedMessage("expected Finished for a resumed handshake, got handshake type ${next.typ}")
        }
    } else {
        if next.typ != certificateType {
            fail Error.UnexpectedMessage("expected Certificate, got handshake type ${next.typ}")
        }
        let certificates = parseCertificate(next.body, self.maxCertificateBytes, 16)?
        let leaf = verifyServerChain(&anchors, &certificates, serverName, nowMillis)?
        transcript = transcript.concat(next.raw)

        let cvMessage = (await self.nextHandshake())?
        if cvMessage.typ != certificateVerifyType {
            fail Error.UnexpectedMessage("expected CertificateVerify, got handshake type ${cvMessage.typ}")
        }
        let cv = parseCertificateVerify(cvMessage.body)?
        verifyCertificateVerify(&leaf, cv.scheme, cv.signature, sha256.sum(transcript))?
        transcript = transcript.concat(cvMessage.raw)

        next = (await self.nextHandshake())?
        if next.typ != finishedType {
            fail Error.UnexpectedMessage("expected Finished, got handshake type ${next.typ}")
        }
    }

    let claimed = parseFinished(next.body)?
    let expected = finishedVerifyData(&self.readKeys.secret, sha256.sum(transcript))?
    if !unsafe {
        expected.ctEqPublic(&claimed).declassify()
    } {
        fail Error.BadFinished
    }
    transcript = transcript.concat(next.raw)

    // RFC 8446 §7.1: application secrets cover the transcript through the
    // server Finished, before any client authentication flight.
    let application = match deriveApplication(&secrets.master, sha256.sum(transcript)) {
        Ok(value) -> value
        Err(e) -> fail e
    }

    if let Some(cr) = request {
        let hasCredential = clientCertificates.len() != 0 && clientKey is Some(_)
        if hasCredential {
            let mut schemeOffered = false
            for scheme in &cr.schemes {
                if scheme == ecdsaSecp256r1Sha256 {
                    schemeOffered = true
                }
            }
            if !schemeOffered {
                fail Error.Unsupported("server requested no signature scheme the client key can produce")
            }
            let leafDer = clientCertificates.get(0) || fail Error.BadCertificate("client certificate chain is empty")
            let leaf = match x509.parse(leafDer) {
                Ok(value) -> value
                Err(e) -> fail Error.BadCertificate(e.message())
            }
            let key = match clientKey {
                Some(value) -> value
                None -> fail Error.ClientAuthRequired
            }
            let keySecret = match key {
                ClientKey.EcP256(secret) -> secret
            }
            // Deriving the public half needs the limb parser; the signing
            // call below keeps the private scalar secret-typed.
            let keyBytes = p256Scalar(&keySecret)
            let public = match leaf.publicKey {
                x509.PublicKey.EcP256(bytes) -> bytes
                x509.PublicKey.Rsa(_) -> fail Error.Unsupported("an RSA client key is not implemented")
            }
            let expectedPublic = match p256.publicKey(keyBytes) {
                Ok(value) -> value
                Err(_) -> fail Error.BadSignature
            }
            if !public.equals(&expectedPublic) {
                fail Error.BadCertificate("client key does not match the leaf certificate")
            }
            let responseMessage = certificateMessage(cr.context, clientCertificates.clone())?
            transcript = transcript.concat(responseMessage)
            (await self.sendHandshake(responseMessage))?
            // RFC 8446 §4.4.3: the client signature covers the transcript
            // through the client Certificate message just sent.
            let signature = match p256.signMessage(&keySecret, clientCertificateVerifyMessage(sha256.sum(transcript))) {
                Ok(value) -> value
                Err(e) -> fail Error.KeySchedule(e.message())
            }
            let verifyMessage = certificateVerifyMessageWithSignature(ecdsaSecp256r1Sha256, signature)?
            transcript = transcript.concat(verifyMessage)
            (await self.sendHandshake(verifyMessage))?
        } else {
            // RFC 8446 §4.4.2: a client with no suitable certificate sends
            // an empty Certificate message. The server decides whether that
            // is acceptable.
            let empty = certificateMessage(cr.context, Array.empty[Bytes]())?
            transcript = transcript.concat(empty)
            (await self.sendHandshake(empty))?
        }
    }

    let finalHash = sha256.sum(transcript)
    let clientVerify = finishedVerifyData(&self.writeKeys.secret, finalHash)?
    // The Finished value is public handshake wire data.
    let clientFinished = encodeHandshake(finishedType, unsafe {
        clientVerify.declassify()
    })?
    (await self.sendHandshake(clientFinished))?
    transcript = transcript.concat(clientFinished)

    // From here the handshake keys are dead: both directions use the
    // application traffic secrets, whose sequence numbers restart at zero.
    self.writeKeys = move application.client
    self.readKeys = move application.server
    self.writeSeq = 0
    self.readSeq = 0
    let resumption = deriveResumptionMaster(&secrets.master, sha256.sum(transcript))?
    self.resumptionMaster = resumption
    self.resumptionTranscript = sha256.sum(transcript)
    self.established = true
}

/// Sends 0-RTT plaintext under the early traffic keys, fragmenting at the
/// plaintext cap. The early sequence number is separate from the handshake
/// and application spaces.
async fn Session.sendEarlyData(mut self, data: &sec.SecretBuffer) -> Result[Void, Error] {
    let mut off: usize = 0
    for off < data.len() {
        let left = data.len() - off
        let take = if left < maxPlaintext {
            left
        } else {
            maxPlaintext
        }
        if self.earlyWriteSeq == 18446744073709551615 {
            fail Error.BadRecord("early record sequence number exhausted")
        }
        let chunk = data.sliceSecret(off, off + take)
        let record = sealRecord(&self.earlyWriteKeys, self.earlyWriteSeq, applicationDataType, &chunk)?
        self.earlyWriteSeq = self.earlyWriteSeq.wrappingAdd(1)
        (await self.writeRaw(record))?
        off = off + take
    }
    Ok(())
}

/// Server side of 0-RTT: reads protected records under the early traffic
/// keys until one fails to authenticate (the client's first handshake
/// record), then hands that record back to the handshake reader.
///
/// `limit` bounds the plaintext kept for the application; `keep` false
/// discards a rejected offer under the same keys. Exceeding the limit is a
/// fatal `EarlyDataRejected`, never a truncated delivery.
async fn Session.drainEarlyData(mut self, limit: usize, keep: Bool) -> Result[Void, Error] {
    let mut total: usize = 0
    for true {
        let raw = (await self.readRawRecord())?
        if raw.typ != protectedType {
            // Not a 0-RTT record: replay it to the handshake path.
            self.pendingRaw = Some(raw)
            return Ok(())
        }
        if self.earlyReadSeq == 18446744073709551615 {
            fail Error.BadRecord("early record sequence number exhausted")
        }
        let opened = openRecord(&self.earlyReadKeys, self.earlyReadSeq, raw.header, raw.payload)
        match opened {
            Ok(record) -> {
                if record.typ != applicationDataType {
                    fail Error.BadRecord("early record has inner content type ${record.typ}")
                }
                if keep {
                    let got = record.payload.len()
                    if total + got > limit {
                        fail Error.EarlyDataRejected("early data exceeds the ticket limit")
                    }
                    if got != 0 {
                        self.appBuf = self.appBuf.concat(record.payload)
                    }
                    total = total + got
                }
                self.earlyReadSeq = self.earlyReadSeq.wrappingAdd(1)
            }
            Err(_) -> {
                // The first record under the handshake keys cannot open with
                // the early keys; leave it for nextHandshake.
                self.pendingRaw = Some(raw)
                return Ok(())
            }
        }
    }
    Ok(())
}

// ---- application data ---------------------------------------------------
fn Session.takeApplication(mut self, max: usize) -> sec.SecretBuffer {
    let n = if self.appBuf.len() < max {
        self.appBuf.len()
    } else {
        max
    }
    let head = self.appBuf.sliceSecret(0, n)
    self.appBuf = self.appBuf.sliceSecret(n, self.appBuf.len())
    head
}

/// Reads up to max plaintext bytes. An empty result means the peer sent
/// close_notify; any other alert is a typed error.
pub async fn Session.read(mut self, max: usize) -> Result[sec.SecretBuffer, Error] {
    if !self.open {
        fail Error.Closed
    }
    if !self.established {
        fail Error.NotEstablished
    }
    if max == 0 {
        return sec.SecretBuffer.fromBytes(Bytes.zeros(0))
    }
    for true {
        if self.appBuf.len() != 0 {
            return self.takeApplication(max)
        }
        if let Some(message) = self.takeHandshake()? {
            if message.typ == newSessionTicketType {
                if self.resumptionMaster.len() == 0 {
                    fail Error.UnexpectedMessage("NewSessionTicket before the handshake finished")
                }
                let parsed = parseNewSessionTicket(message.body)?
                if parsed.lifetime != 0 {
                    let pskBuffer = resumptionPsk(&self.resumptionMaster, parsed.nonce)?
                    let psk = match sec.SecretNat[4].fromBuffer(&pskBuffer) {
                        Ok(value) -> value
                        Err(_) -> fail Error.KeySchedule("resumption PSK is not 32 bytes")
                    }
                    self.ticket = Some(SessionTicket {
                        serverName: self.serverName
                        alpn: self.negotiatedProtocol
                        ticket: parsed.ticket
                        psk: psk
                        lifetimeMillis: parsed.lifetime.toInt() * 1000
                        issuedAtMillis: self.nowMillis
                        ageAdd: parsed.ageAdd
                        maxEarlyData: parsed.maxEarlyData.toUsize()
                    })
                }
                continue
            } else if message.typ == keyUpdateType {
                fail Error.Unsupported("KeyUpdate is not implemented")
            } else if message.typ == certificateRequestType {
                fail Error.Unsupported("post-handshake client authentication is not implemented")
            } else {
                fail Error.UnexpectedMessage("post-handshake message type ${message.typ}")
            }
        }
        let record = match await self.readRecord() {
            Ok(value) -> value
            Err(e) -> {
                self.open = false
                fail e
            }
        }
        if record.typ == applicationDataType {
            if record.payload.len() != 0 {
                self.appBuf = move record.payload
            }
        } else if record.typ == handshakeType {
            append(&mut self.hsBuf, unsafe {
                record.payload.declassify()
            })
        } else if record.typ == alertType {
            let alertBytes = unsafe {
                record.payload.declassify()
            }
            let err = alertError(alertBytes)
            self.open = false
            if alertBytes.len() == 2 && alertBytes[1] == 0 {
                return sec.SecretBuffer.fromBytes(Bytes.zeros(0))
            }
            fail err
        } else {
            fail Error.UnexpectedMessage("content type ${record.typ} after the handshake")
        }
    }
    fail Error.Closed
}

/// Writes plaintext, splitting it into records of at most 2^14 bytes.
pub async fn Session.write(mut self, data: &sec.SecretBuffer) -> Result[Void, Error] {
    if !self.open {
        fail Error.Closed
    }
    if !self.established {
        fail Error.NotEstablished
    }
    let mut off: usize = 0
    for off < data.len() {
        let left = data.len() - off
        let take = if left < maxPlaintext {
            left
        } else {
            maxPlaintext
        }
        if self.writeSeq == 18446744073709551615 {
            fail Error.BadRecord("record sequence number exhausted")
        }
        let chunk = data.sliceSecret(off, off + take)
        let record = sealRecord(&self.writeKeys, self.writeSeq, applicationDataType, &chunk)?
        self.writeSeq = self.writeSeq.wrappingAdd(1)
        (await self.writeRaw(record))?
        off = off + take
    }
}

/// Sends close_notify (best effort) and closes the connection.
pub async fn Session.close(mut self) {
    if self.open && self.established {
        await self.sendAlert(1, 0)
    }
    self.open = false
}

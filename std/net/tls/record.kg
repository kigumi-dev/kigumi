import poly from std/crypto/chacha20poly1305
import subtle from std/crypto/subtle
// TLS 1.3 record protection (RFC 8446 §5.2, §5.3) with
// AEAD_CHACHA20_POLY1305.
//
// The outer record always carries content type application_data (23), a
// legacy version of 0x0303 and the ciphertext; the real content type is the
// last non-zero byte of the decrypted inner plaintext. The additional data is
// the five-byte outer header, so a flipped type, version or length fails the
// tag.
//
// Record keys and IVs are `SecretBuffer`s and the record payload is secret.
// Ciphertext, headers and sequence numbers are public. The only declassify
// points here are the wire boundary (emitting a sealed record) and the
// protocol metadata of an opened record (its content type and padding
// length); the padding scan itself is mask arithmetic with no branch.
import sec from std/secret

/// Content types that may appear inside a TLS 1.3 record.
pub const changeCipherSpecType: u8 = 20

pub const alertType: u8 = 21

pub const handshakeType: u8 = 22

pub const applicationDataType: u8 = 23

/// The outer content type of every protected record.
pub const protectedType: u8 = 23

/// Outer legacy version written for every record.
pub const legacyVersion: u16 = 0x0303

/// Largest TLSPlaintext a peer may send (RFC 8446 §5.1).
pub const maxPlaintext: usize = 16384

/// Largest TLSCiphertext accepted: plaintext plus the tag.
pub const maxCiphertext: usize = 16384 + 256

/// A decrypted record: its content type and secret payload, with padding
/// removed.
pub type Record = {
    pub typ u8
    pub payload sec.SecretBuffer
}

/// A record's five-byte header.
pub pure fn recordHeader(typ: u8, length: usize) -> Result[Bytes, Error] {
    if length > 65535 {
        fail Error.RecordOverflow
    }
    let mut out = Array.empty[u8]()
    putU8(&mut out, typ)
    putU16(&mut out, legacyVersion)
    putU16(&mut out, length.toU16() || 0)
    Ok(freeze(&out))
}

/// The per-record nonce: the IV with the record sequence number XORed into
/// its low eight bytes (RFC 8446 §5.3). The nonce is public, so the IV copy
/// is released at this boundary; the original IV stays secret.
pub fn recordNonce(iv: &sec.SecretBuffer, seq: u64) -> Result[Bytes, Error] {
    if iv.len() != ivSize {
        fail Error.BadRecord("record IV must be ${ivSize} bytes")
    }
    let mut raw = unsafe {
        iv.copy().declassify()
    }
    let mut out = Array.empty[u8]()
    let mut i: usize = 0
    for i < ivSize {
        out.push(raw[i])
        i = i + 1
    }
    let mut b: usize = 0
    for b < 8 {
        let shift = (7 - b) * 8
        let byte = ((seq >> shift) & 255).toU8() || 0
        let at = ivSize - 8 + b
        out[at] = raw[at] ^ byte
        b = b + 1
    }
    Ok(freeze(&out))
}

/// Seals one secret `payload`. `payload` must already be no longer than
/// `maxPlaintext`; no padding is added, so the inner plaintext is
/// payload || contentType. The sealed bytes are public wire data and leave
/// the secret domain at this boundary.
pub fn sealRecord(keys: &Direction, seq: u64, typ: u8, payload: &sec.SecretBuffer) -> Result[Bytes, Error] {
    if payload.len() > maxPlaintext {
        fail Error.RecordOverflow
    }
    let nonce = recordNonce(&keys.iv, seq)?
    let inner = payload.concat(sec.SecretBuffer.fromBytes(Bytes.fill(typ, 1)))
    let header = recordHeader(protectedType, inner.len() + tagSize)?
    let sealed = match poly.seal(&keys.key, nonce, header, &inner) {
        Ok(value) -> value
        Err(e) -> fail Error.BadRecord(e.message())
    }
    let sealedBytes = unsafe {
        sealed.declassify()
    }
    Ok(header.concat(sealedBytes))
}

/// Opens a protected record whose outer header is `header` (the five wire
/// bytes) and whose ciphertext, tag included, is `sealed`.
///
/// Padding is the run of zero bytes before the content type; the scan visits
/// every byte through a secret mask, so its timing does not depend on where
/// the type byte is. The type and payload length are then released as
/// protocol metadata.
pub fn openRecord(keys: &Direction, seq: u64, header: Bytes, sealed: Bytes) -> Result[Record, Error] {
    if sealed.len() < tagSize + 1 {
        fail Error.BadRecord("protected record is shorter than its tag and type")
    }
    if sealed.len() > maxCiphertext {
        fail Error.RecordOverflow
    }
    let nonce = recordNonce(&keys.iv, seq)?
    let inner = match poly.open(&keys.key, nonce, header, sealed) {
        Ok(value) -> value
        Err(e) -> fail Error.BadRecord(e.message())
    }
    let mut end = sec.SecretU32.classify(0)
    let mut at: usize = 0
    for at < inner.len() {
        let nz = ~inner.byteAt(at).ctIsZero()
        end = nz.selectU32(sec.SecretU32.classify(at.toU32() || 0), end)
        at = at + 1
    }
    let endAt = (unsafe {
        end.declassify()
    }).toUsize()
    let typ = unsafe {
        inner.byteAt(endAt).declassify()
    }
    if typ != alertType && typ != handshakeType && typ != applicationDataType {
        fail Error.BadRecord("inner content type ${typ} is not allowed")
    }
    Ok(Record {
        typ: typ
        payload: inner.sliceSecret(0, endAt)
    })
}

/// A plaintext record header and payload, for alerts and the ClientHello.
pub pure fn sealPlaintext(typ: u8, payload: Bytes) -> Result[Bytes, Error] {
    if payload.len() > maxPlaintext {
        fail Error.RecordOverflow
    }
    let header = recordHeader(typ, payload.len())?
    Ok(header.concat(payload))
}

/// Compares two equal-length public byte strings without an early exit.
pub pure fn equalConstantTime(a: Bytes, b: Bytes) -> Bool {
    subtle.constantTimeEq(a, b)
}

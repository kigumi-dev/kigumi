// TLS 1.3 handshake messages (RFC 8446 §4): building the ClientHello and
// parsing the server's flight.
//
// Parsing is deliberately narrow. A ServerHello must negotiate TLS 1.3 with
// the one cipher suite this module implements and a key share this client
// offered; pre_shared_key is accepted only when the client offered one, and
// an extension the client did not offer is refused. ClientHello parsing
// covers psk_dhe_ke resumption, early_data, client authentication messages,
// NewSessionTicket and binder verification, each with the bounds and
// ordering rules RFC 8446 states.
//
// A HelloRetryRequest is recognised by its fixed random. It may request a
// secp256r1 share (the first ClientHello offers only x25519) and attach a
// cookie, both of which the second ClientHello carries; requesting a group
// the client did not advertise, or one it already sent a share for, is
// refused.
import binary from std/encoding/binary
import sha256 from std/crypto/sha256

/// Handshake message type numbers used here.
pub const clientHelloType: u8 = 1

pub const serverHelloType: u8 = 2

pub const newSessionTicketType: u8 = 4

pub const encryptedExtensionsType: u8 = 8

pub const certificateType: u8 = 11

pub const certificateRequestType: u8 = 13

pub const certificateVerifyType: u8 = 15

pub const finishedType: u8 = 20

pub const keyUpdateType: u8 = 24

/// The synthetic message that replaces ClientHello1 in the transcript after
/// a HelloRetryRequest (RFC 8446 §4.4.1).
pub const messageHashType: u8 = 254

/// Extension types.
pub const serverNameExt: u16 = 0

pub const supportedGroupsExt: u16 = 10

pub const signatureAlgorithmsExt: u16 = 13

pub const alpnExt: u16 = 16

pub const preSharedKeyExt: u16 = 41

pub const earlyDataExt: u16 = 42

pub const supportedVersionsExt: u16 = 43

pub const cookieExt: u16 = 44

pub const pskKeyExchangeModesExt: u16 = 45

pub const certificateAuthoritiesExt: u16 = 47

pub const keyShareExt: u16 = 51

/// Groups and signature schemes.
pub const x25519Group: u16 = 0x001D

pub const secp256r1Group: u16 = 0x0017

pub const rsaPssRsaeSha256: u16 = 0x0804

pub const ecdsaSecp256r1Sha256: u16 = 0x0403

/// TLS_CHACHA20_POLY1305_SHA256.
pub const chacha20Poly1305Sha256: u16 = 0x1303

/// psk_dhe_ke, the only PSK key exchange mode this implementation offers.
pub const pskDheKe: u8 = 1

/// TLS 1.3 in the supported_versions encoding.
pub const tls13Version: u16 = 0x0304

/// The ServerHello.random value that marks a HelloRetryRequest.
pub fn helloRetryRequestRandom() -> Bytes {
    let raw = Array.of[u8](0xcf, 0x21, 0xad, 0x74, 0xe5, 0x9a, 0x61, 0x11, 0xbe, 0x1d, 0x8c, 0x02, 0x1e, 0x65, 0xb8, 0x91, 0xc2, 0xa2, 0x11, 0x16, 0x7a, 0xbb, 0x8c, 0x5e, 0x07, 0x9e, 0x09, 0xe2, 0xc8, 0xa8, 0x33, 0x9c)
    Bytes.fromArray(&raw)
}

const spaces64: String = "                                                                "

/// A complete handshake message: four-byte header followed by body.
pub pure fn encodeHandshake(typ: u8, body: Bytes) -> Result[Bytes, Error] {
    if body.len() > 0xFFFFFF {
        fail Error.HandshakeOverflow
    }
    let mut out = Array.empty[u8]()
    putU8(&mut out, typ)
    putU24(&mut out, body.len())
    append(&mut out, body)
    Ok(freeze(&out))
}

/// Whether a name is an address literal, which SNI must not carry.
pub pure fn isIpLiteral(name: String) -> Bool {
    if name.contains(":") {
        return true
    }
    let parts = name.split(".")
    if parts.len() != 4 {
        return false
    }
    for part in &parts {
        if part.len() == 0 || part.len() > 3 {
            return false
        }
        let mut value: Int = 0
        let mut i: usize = 0
        for i < part.len() {
            let c = part[i]
            if c < 48 || c > 57 {
                return false
            }
            value = value * 10 + (c.toInt() - 48)
            i = i + 1
        }
        if value > 255 {
            return false
        }
    }
    true
}

// A vector body: its byte length followed by the bytes.
pure fn wrap16(body: &Array[u8]) -> Result[Array[u8], Error] {
    if body.len() > 65535 {
        fail Error.MalformedHandshake("vector of ${body.len()} bytes does not fit a 16-bit length")
    }
    let mut out = Array.empty[u8]()
    putU16(&mut out, body.len().toU16() || 0)
    append(&mut out, freeze(body))
    Ok(out)
}

pure fn wrap8(body: &Array[u8]) -> Result[Array[u8], Error] {
    if body.len() > 255 {
        fail Error.MalformedHandshake("vector of ${body.len()} bytes does not fit an 8-bit length")
    }
    let mut out = Array.empty[u8]()
    putU8(&mut out, body.len().toU8() || 0)
    append(&mut out, freeze(body))
    Ok(out)
}

/// Builds the first ClientHello handshake message for an (EC)DHE-only TLS
/// 1.3 handshake with one x25519 key share. secp256r1 is advertised in
/// supported_groups so a server may ask for it in a HelloRetryRequest.
pub pure fn clientHello(random: Bytes, sessionId: Bytes, keyShare: Bytes, serverName: String, alpn: Array[String]) -> Result[Bytes, Error] {
    clientHelloWithShare(x25519Group, random, sessionId, keyShare, None, serverName, alpn)
}

/// A resumption offer carried by the ClientHello: the ticket identity, its
/// obfuscated age, the PSK the binder is derived from, and whether the
/// client wants to send 0-RTT data.
pub type PskOffer = {
    pub identity Bytes
    pub obfuscatedAge u32
    pub psk Bytes
    pub earlyData Bool
}

/// Builds a ClientHello with the key share for one group and an optional
/// cookie. The supported_groups order is fixed, and the key share must be
/// for one of those groups; the retried ClientHello carries the group the
/// server selected instead of the initial x25519 share.
pub pure fn clientHelloWithShare(group: u16, random: Bytes, sessionId: Bytes, keyShare: Bytes, cookie: Bytes?, serverName: String, alpn: Array[String]) -> Result[Bytes, Error] {
    buildClientHello(group, random, sessionId, keyShare, cookie, serverName, alpn, None)
}

/// Builds a ClientHello that offers one resumption PSK, optionally with
/// early data. The pre_shared_key extension is last, as RFC 8446 §4.2.11
/// requires, and its binder is computed over the truncated ClientHello.
pub pure fn clientHelloPsk(group: u16, random: Bytes, sessionId: Bytes, keyShare: Bytes, cookie: Bytes?, serverName: String, alpn: Array[String], offer: PskOffer) -> Result[Bytes, Error] {
    buildClientHello(group, random, sessionId, keyShare, cookie, serverName, alpn, Some(offer))
}

pure fn buildClientHello(group: u16, random: Bytes, sessionId: Bytes, keyShare: Bytes, cookie: Bytes?, serverName: String, alpn: Array[String], offer: PskOffer?) -> Result[Bytes, Error] {
    if random.len() != 32 {
        fail Error.MalformedHandshake("client random must be 32 bytes")
    }
    if sessionId.len() > 32 {
        fail Error.MalformedHandshake("session id is longer than 32 bytes")
    }
    if group != x25519Group && group != secp256r1Group {
        fail Error.Unsupported("key share group ${group} is not supported")
    }
    let expectedShare: usize = if group == x25519Group {
        32
    } else {
        65
    }
    if keyShare.len() != expectedShare {
        fail Error.MalformedHandshake("group ${group} key share must be ${expectedShare} bytes")
    }
    if alpn.len() == 0 {
        fail Error.Unsupported("no ALPN protocol was offered")
    }
    let mut exts = Array.empty[u8]()

    if serverName != "" && !isIpLiteral(serverName) {
        let name = serverName.toBytes()
        if name.len() > 253 {
            fail Error.MalformedHandshake("server name is longer than 253 bytes")
        }
        let mut entry = Array.empty[u8]()
        putU8(&mut entry, 0)
        putVec16(&mut entry, name)?
        let mut list = Array.empty[u8]()
        putVec16(&mut list, freeze(&entry))?
        putExtension(&mut exts, serverNameExt, list)?
    }

    let mut groupList = Array.empty[u8]()
    putU16(&mut groupList, x25519Group)
    putU16(&mut groupList, secp256r1Group)
    putExtension(&mut exts, supportedGroupsExt, wrap16(&groupList)?)?

    let mut schemes = Array.empty[u8]()
    putU16(&mut schemes, rsaPssRsaeSha256)
    putU16(&mut schemes, ecdsaSecp256r1Sha256)
    putExtension(&mut exts, signatureAlgorithmsExt, wrap16(&schemes)?)?

    let mut protocols = Array.empty[u8]()
    for p in &alpn {
        let bytes = p.toBytes()
        if p.len() == 0 || p.len() > 255 {
            fail Error.MalformedHandshake("ALPN protocol names must be 1..255 bytes")
        }
        putVec8(&mut protocols, bytes)?
    }
    if protocols.len() > 65533 {
        fail Error.MalformedHandshake("ALPN protocol list is longer than 65533 bytes")
    }
    putExtension(&mut exts, alpnExt, wrap16(&protocols)?)?

    let mut versions = Array.empty[u8]()
    putU16(&mut versions, tls13Version)
    putExtension(&mut exts, supportedVersionsExt, wrap8(&versions)?)?

    let mut shares = Array.empty[u8]()
    putU16(&mut shares, group)
    putVec16(&mut shares, keyShare)?
    putExtension(&mut exts, keyShareExt, wrap16(&shares)?)?

    if let Some(value) = cookie {
        if value.len() == 0 {
            fail Error.MalformedHandshake("cookie from the HelloRetryRequest is empty")
        }
        let mut body = Array.empty[u8]()
        putVec16(&mut body, value)?
        putExtension(&mut exts, cookieExt, body)?
    }

    if let Some(pskOffer) = offer {
        if pskOffer.identity.len() == 0 {
            fail Error.MalformedHandshake("resumption ticket identity is empty")
        }
        let mut modes = Array.empty[u8]()
        putU8(&mut modes, pskDheKe)
        putExtension(&mut exts, pskKeyExchangeModesExt, wrap8(&modes)?)?

        if pskOffer.earlyData {
            putExtension(&mut exts, earlyDataExt, Array.empty[u8]())?
        }

        let mut identities = Array.empty[u8]()
        putVec16(&mut identities, pskOffer.identity)?
        putU32(&mut identities, pskOffer.obfuscatedAge)
        let mut binders = Array.empty[u8]()
        putU8(&mut binders, 32)
        let mut zero = 0
        for zero < 32 {
            binders.push(0)
            zero = zero + 1
        }
        let mut pskBody = Array.empty[u8]()
        putVec16(&mut pskBody, freeze(&identities))?
        putVec16(&mut pskBody, freeze(&binders))?
        putExtension(&mut exts, preSharedKeyExt, pskBody)?
    }

    let mut body = Array.empty[u8]()
    putU16(&mut body, 0x0303)
    append(&mut body, random)
    putVec8(&mut body, sessionId)?
    let mut suites = Array.empty[u8]()
    putU16(&mut suites, chacha20Poly1305Sha256)
    putVec16(&mut body, freeze(&suites))?
    putU8(&mut body, 1)
    putU8(&mut body, 0)
    if exts.len() > 65535 {
        fail Error.MalformedHandshake("ClientHello extensions are longer than 65535 bytes")
    }
    putVec16(&mut body, freeze(&exts))?
    let message = encodeHandshake(clientHelloType, freeze(&body))?
    match offer {
        Some(pskOffer) -> {
            // Truncate(ClientHello) removes the binders list, that is its
            // two-byte length and the single binder entry.
            if message.len() < 35 {
                fail Error.MalformedHandshake("ClientHello is too short to carry a binder")
            }
            let truncated = message.slice(0, message.len() - 35) || fail Error.MalformedHandshake("binder slice out of bounds")
            let binder = binderVerifyData(pskOffer.psk, sha256.sum(truncated))?
            let mut sealed = Array.empty[u8]()
            append(&mut sealed, message.slice(0, message.len() - 32) || fail Error.MalformedHandshake("binder slice out of bounds"))
            append(&mut sealed, binder)
            Ok(freeze(&sealed))
        }
        None -> Ok(message)
    }
}

/// One pre_shared_key identity: the opaque ticket and its obfuscated age.
pub type PskIdentity = {
    pub identity Bytes
    pub obfuscatedAge u32
}

/// The pre_shared_key offer of a ClientHello. `bindersAt` is the offset in
/// the ClientHello body of the binders vector, so a server can hash the
/// truncated ClientHello without re-parsing it.
pub type ParsedPsk = {
    pub identities Array[PskIdentity]
    pub binders Array[Bytes]
    pub bindersAt usize
}

/// The fields of a ClientHello this implementation acts on.
pub type ParsedClientHello = {
    pub sessionId Bytes
    /// The group whose share the server answers with: x25519 when the
    /// client sent one, secp256r1 otherwise.
    pub group u16
    pub keyShare Bytes
    /// The SNI host name, or "" when the extension is absent.
    pub serverName String
    /// The ALPN protocols the client offered, in its preference order.
    pub alpn Array[String]
    /// The resumption offer, or None when the client sent no pre_shared_key.
    pub psk ParsedPsk?
    /// Whether the client offered 0-RTT early data.
    pub earlyData Bool
}

// Whether a big-endian 16-bit list holds `value`. An odd length means the
// peer framed the list wrong, which is always a malformed message.
pure fn listHas16(list: Bytes, value: u16) -> Result[Bool, Error] {
    if list.len() % 2 != 0 {
        fail Error.MalformedHandshake("16-bit list has ${list.len()} bytes")
    }
    let mut at: usize = 0
    for at < list.len() {
        if (binary.u16Be(list, at) || 0) == value {
            return Ok(true)
        }
        at = at + 2
    }
    false
}

// The key share the server answers with.
type ChosenShare = {
    group u16
    keyShare Bytes
}

// Parses one key_share entry list, preferring x25519 and refusing a group
// the client listed twice.
pure fn parseKeyShares(data: Bytes) -> Result[ChosenShare, Error] {
    let mut r = Reader.new(data)
    let list = r.vec16()?
    r.end("key_share")?
    let mut lr = Reader.new(list)
    let mut haveX25519 = false
    let mut x25519Share = Bytes.zeros(0)
    let mut haveP256 = false
    let mut p256Share = Bytes.zeros(0)
    for !lr.done() {
        let group = lr.u16()?
        let share = lr.vec16()?
        if group == x25519Group {
            if haveX25519 {
                fail Error.MalformedHandshake("key_share lists group ${group} twice")
            }
            if share.len() != 32 {
                fail Error.MalformedHandshake("x25519 key share must be 32 bytes")
            }
            haveX25519 = true
            x25519Share = share
        } else if group == secp256r1Group {
            if haveP256 {
                fail Error.MalformedHandshake("key_share lists group ${group} twice")
            }
            if share.len() != 65 {
                fail Error.MalformedHandshake("secp256r1 key share must be 65 bytes")
            }
            haveP256 = true
            p256Share = share
        }
        // A group this server does not implement is skipped: RFC 8446 §4.2.8
        // lets the server choose any group the client offered a share for.
    }
    if haveX25519 {
        return Ok(ChosenShare {
            group: x25519Group
            keyShare: x25519Share
        })
    }
    if haveP256 {
        return Ok(ChosenShare {
            group: secp256r1Group
            keyShare: p256Share
        })
    }
    fail Error.Unsupported("client offered no key share for x25519 or secp256r1")
}

// Parses PreSharedKeyExtension.client_hello. `bodyLen` is the length of the
// enclosing ClientHello body, which locates the binders vector because the
// pre_shared_key extension must be last.
pure fn parsePskExtension(data: Bytes, bodyLen: usize) -> Result[ParsedPsk, Error] {
    let mut r = Reader.new(data)
    let identitiesBlock = r.vec16()?
    let mut ir = Reader.new(identitiesBlock)
    let mut identities = Array.empty[PskIdentity]()
    for !ir.done() {
        let identity = ir.vec16()?
        if identity.len() == 0 {
            fail Error.MalformedHandshake("pre_shared_key identity is empty")
        }
        let age = ir.u32()?
        identities.push(PskIdentity {
            identity: identity
            obfuscatedAge: age
        })
    }
    if identities.len() == 0 {
        fail Error.MalformedHandshake("pre_shared_key has no identities")
    }
    let bindersBlock = r.vec16()?
    r.end("pre_shared_key")?
    if bindersBlock.len() + 2 > bodyLen {
        fail Error.MalformedHandshake("pre_shared_key binders run past the ClientHello")
    }
    let mut br = Reader.new(bindersBlock)
    let mut binders = Array.empty[Bytes]()
    for !br.done() {
        let binder = br.vec8()?
        if binder.len() != 32 {
            fail Error.MalformedHandshake("PSK binder must be 32 bytes")
        }
        binders.push(binder)
    }
    if binders.len() != identities.len() {
        fail Error.MalformedHandshake("pre_shared_key has ${identities.len()} identities and ${binders.len()} binders")
    }
    Ok(ParsedPsk {
        identities: identities
        binders: binders
        bindersAt: bodyLen - 2 - bindersBlock.len()
    })
}

/// The Transcript-Hash(Truncate(ClientHello)) a binder is computed over.
/// `bindersAtBody` is the offset of the binders vector within the
/// ClientHello body, before the four-byte handshake header.
pub pure fn clientHelloBinderHash(fullHello: Bytes, bindersAtBody: usize) -> Result[Bytes, Error] {
    let end = bindersAtBody + 4
    if end > fullHello.len() {
        fail Error.MalformedHandshake("binder truncation point is past the ClientHello")
    }
    let truncated = fullHello.slice(0, end) || fail Error.MalformedHandshake("binder slice out of bounds")
    Ok(sha256.sum(truncated))
}

/// Checks one PSK binder in constant time.
pub pure fn verifyPskBinder(fullHello: Bytes, bindersAtBody: usize, psk: Bytes, binder: Bytes) -> Result[Void, Error] {
    let hash = clientHelloBinderHash(fullHello, bindersAtBody)?
    let expected = binderVerifyData(psk, hash)?
    if !equalConstantTime(expected, binder) {
        fail Error.BadSignature
    }
    Ok(())
}

/// Parses and checks a ClientHello body (the four-byte handshake header
/// already removed) for a TLS 1.3 handshake with
/// TLS_CHACHA20_POLY1305_SHA256 and an ecdsa_secp256r1_sha256 certificate.
///
/// The parse is strict about everything the server acts on and about the
/// extensions TLS 1.3 requires. A pre_shared_key offer is parsed together
/// with its psk_dhe_ke mode and binders; a cookie (which only a
/// HelloRetryRequest may provoke) is refused. Extensions the server does not
/// recognise are skipped, as RFC 8446 §4.2 requires of a server.
pub pure fn parseClientHello(body: Bytes) -> Result[ParsedClientHello, Error] {
    let mut r = Reader.new(body)
    let version = r.u16()?
    if version != 0x0303 {
        fail Error.MalformedHandshake("ClientHello legacy_version ${version} is not TLS 1.2")
    }
    _ = r.take(32)?
    let sessionId = r.vec8()?
    if sessionId.len() > 32 {
        fail Error.MalformedHandshake("ClientHello session id is longer than 32 bytes")
    }
    let suites = r.vec16()?
    if suites.len() == 0 || suites.len() % 2 != 0 {
        fail Error.MalformedHandshake("cipher suite list has ${suites.len()} bytes")
    }
    if !(listHas16(suites, chacha20Poly1305Sha256)?) {
        fail Error.Unsupported("client did not offer TLS_CHACHA20_POLY1305_SHA256")
    }
    let compression = r.vec8()?
    if compression.len() == 0 {
        fail Error.MalformedHandshake("ClientHello compression method list is empty")
    }
    let mut nullCompression = false
    let mut ci: usize = 0
    for ci < compression.len() {
        if compression[ci] == 0 {
            nullCompression = true
        }
        ci = ci + 1
    }
    if !nullCompression {
        fail Error.MalformedHandshake("client did not offer the null compression method")
    }
    let extBlock = r.vec16()?
    r.end("ClientHello")?
    let exts = parseExtensions(extBlock)?

    let mut versionFound = false
    let mut sigsFound = false
    let mut shareFound = false
    let mut group: u16 = 0
    let mut keyShare = Bytes.zeros(0)
    let mut groupsFound = false
    let mut groups = Bytes.zeros(0)
    let mut serverName = ""
    let mut alpn = Array.empty[String]()
    let mut pskData: Bytes? = None
    let mut pskModesFound = false
    let mut earlyData = false

    for e in &exts {
        if e.typ == supportedVersionsExt {
            let mut vr = Reader.new(e.data)
            let versions = vr.vec8()?
            vr.end("supported_versions")?
            versionFound = listHas16(versions, tls13Version)?
        } else if e.typ == keyShareExt {
            let parsed = parseKeyShares(e.data)?
            group = parsed.group
            keyShare = parsed.keyShare
            shareFound = true
        } else if e.typ == supportedGroupsExt {
            let mut gr = Reader.new(e.data)
            groups = gr.vec16()?
            gr.end("supported_groups")?
            if groups.len() % 2 != 0 {
                fail Error.MalformedHandshake("supported_groups has ${groups.len()} bytes")
            }
            groupsFound = true
        } else if e.typ == signatureAlgorithmsExt {
            let mut sr = Reader.new(e.data)
            let schemes = sr.vec16()?
            sr.end("signature_algorithms")?
            if !(listHas16(schemes, ecdsaSecp256r1Sha256)?) {
                fail Error.Unsupported("client offered no ecdsa_secp256r1_sha256 signature scheme")
            }
            sigsFound = true
        } else if e.typ == serverNameExt {
            let mut nr = Reader.new(e.data)
            let list = nr.vec16()?
            nr.end("server_name")?
            let mut lr = Reader.new(list)
            let nameType = lr.u8()?
            if nameType != 0 {
                fail Error.MalformedHandshake("server_name type ${nameType} is not host_name")
            }
            let name = lr.vec16()?
            lr.end("server_name list")?
            if name.len() == 0 {
                fail Error.MalformedHandshake("server_name is empty")
            }
            serverName = match String.fromBytes(name) {
                Ok(value) -> value
                Err(_) -> fail Error.MalformedHandshake("server_name is not valid UTF-8")
            }
        } else if e.typ == alpnExt {
            let mut ar = Reader.new(e.data)
            let list = ar.vec16()?
            ar.end("ALPN")?
            let mut lr = Reader.new(list)
            for !lr.done() {
                let protocol = lr.vec8()?
                if protocol.len() == 0 {
                    fail Error.MalformedHandshake("ALPN protocol name is empty")
                }
                let text = match String.fromBytes(protocol) {
                    Ok(value) -> value
                    Err(_) -> fail Error.MalformedHandshake("ALPN protocol is not valid UTF-8")
                }
                alpn.push(text)
            }
            if alpn.len() == 0 {
                fail Error.MalformedHandshake("ALPN protocol list is empty")
            }
        } else if e.typ == preSharedKeyExt {
            pskData = Some(e.data)
        } else if e.typ == pskKeyExchangeModesExt {
            let mut mr = Reader.new(e.data)
            let modes = mr.vec8()?
            mr.end("psk_key_exchange_modes")?
            let mut i: usize = 0
            for i < modes.len() {
                if modes[i] == pskDheKe {
                    pskModesFound = true
                }
                i = i + 1
            }
        } else if e.typ == earlyDataExt {
            if e.data.len() != 0 {
                fail Error.MalformedHandshake("early_data in a ClientHello must be empty")
            }
            earlyData = true
        } else if e.typ == cookieExt {
            fail Error.MalformedHandshake("ClientHello carries a cookie without a HelloRetryRequest")
        }
    }
    if earlyData && (pskData is None) {
        fail Error.MalformedHandshake("early_data was offered without a pre_shared_key")
    }
    let mut psk: ParsedPsk? = None
    if let Some(data) = pskData {
        let last = &exts[exts.len() - 1]
        if last.typ != preSharedKeyExt {
            fail Error.MalformedHandshake("pre_shared_key is not the last ClientHello extension")
        }
        if !pskModesFound {
            fail Error.Unsupported("pre_shared_key was offered without psk_dhe_ke")
        }
        psk = Some(parsePskExtension(data, body.len())?)
    }
    if !versionFound {
        fail Error.Unsupported("client did not offer TLS 1.3")
    }
    if !sigsFound && (psk is None) {
        fail Error.MalformedHandshake("ClientHello has no signature_algorithms")
    }
    if !shareFound {
        fail Error.MalformedHandshake("ClientHello has no key_share")
    }
    if groupsFound && !(listHas16(groups, group)?) {
        fail Error.MalformedHandshake("key_share group ${group} is not in supported_groups")
    }
    Ok(ParsedClientHello {
        sessionId: sessionId
        group: group
        keyShare: keyShare
        serverName: serverName
        alpn: alpn
        psk: psk
        earlyData: earlyData
    })
}

/// The fields of a ServerHello this implementation acts on.
pub type ParsedServerHello = {
    pub random Bytes
    pub sessionId Bytes
    pub cipherSuite u16
    /// The group of the key share the server selected; the client checks it
    /// against the share it sent.
    pub group u16
    pub keyShare Bytes
    /// The pre_shared_key identity the server selected, when it resumed.
    pub selectedIdentity u16?
}

/// The fields of a HelloRetryRequest this implementation acts on.
pub type HelloRetryRequest = {
    pub sessionId Bytes
    pub cipherSuite u16
    /// The group the server asks a new key share for, when it named one.
    pub selectedGroup u16?
    /// The cookie the second ClientHello must echo, when the server set one.
    pub cookie Bytes?
}

/// A server's first handshake reply: either a ServerHello that lets the key
/// schedule start or a HelloRetryRequest that demands a second ClientHello.
pub type ServerReply =
    | Hello(ParsedServerHello)
    | Retry(HelloRetryRequest)

/// Parses and checks a ServerHello body (the four-byte handshake header
/// already removed). The fixed ServerHello.random value marks a
/// HelloRetryRequest, whose extensions are checked separately. A
/// pre_shared_key extension is accepted only when this client actually
/// offered one.
pub pure fn parseServerHello(body: Bytes, pskOffered: Bool) -> Result[ServerReply, Error] {
    let mut r = Reader.new(body)
    let version = r.u16()?
    if version != 0x0303 {
        fail Error.Unsupported("ServerHello legacy_version ${version} is not TLS 1.2")
    }
    let random = r.take(32)?
    let retry = random.equals(&helloRetryRequestRandom())
    let sessionId = r.vec8()?
    if sessionId.len() > 32 {
        fail Error.MalformedHandshake("ServerHello session id is longer than 32 bytes")
    }
    let suite = r.u16()?
    let compression = r.u8()?
    if compression != 0 {
        fail Error.MalformedHandshake("ServerHello compression method is not null")
    }
    let extBlock = r.vec16()?
    r.end("ServerHello")?
    let exts = parseExtensions(extBlock)?
    if suite != chacha20Poly1305Sha256 {
        fail Error.Unsupported("server selected cipher suite ${suite}, only TLS_CHACHA20_POLY1305_SHA256 is supported")
    }
    if retry {
        return parseHelloRetryRequest(sessionId, suite, exts)
    }
    let mut selectedVersion: u16 = 0
    let mut keyShare: Bytes? = None
    let mut group: u16 = 0
    let mut selectedIdentity: u16? = None
    for e in &exts {
        if e.typ == supportedVersionsExt {
            if e.data.len() != 2 {
                fail Error.MalformedHandshake("supported_versions in ServerHello must hold one version")
            }
            selectedVersion = binary.u16Be(e.data, 0) || 0
        } else if e.typ == keyShareExt {
            let mut kr = Reader.new(e.data)
            group = kr.u16()?
            let share = kr.vec16()?
            kr.end("key_share")?
            if group != x25519Group && group != secp256r1Group {
                fail Error.Unsupported("server selected key share group ${group}, only x25519 and secp256r1 are supported")
            }
            let expected: usize = if group == x25519Group {
                32
            } else {
                65
            }
            if share.len() != expected {
                fail Error.MalformedHandshake("group ${group} key share must be ${expected} bytes")
            }
            keyShare = Some(share)
        } else if e.typ == preSharedKeyExt {
            if !pskOffered {
                fail Error.Unsupported("server selected a PSK this client never offered")
            }
            if e.data.len() != 2 {
                fail Error.MalformedHandshake("ServerHello pre_shared_key must hold one identity")
            }
            selectedIdentity = Some(binary.u16Be(e.data, 0) || 0)
        } else if e.typ == earlyDataExt {
            fail Error.Unsupported("early_data belongs in EncryptedExtensions, not ServerHello")
        } else {
            fail Error.Unsupported("unexpected ServerHello extension ${e.typ}")
        }
    }
    if selectedVersion != tls13Version {
        fail Error.Unsupported("server did not select TLS 1.3")
    }
    let share = match keyShare {
        Some(value) -> value
        None -> fail Error.MalformedHandshake("ServerHello has no key_share")
    }
    Ok(Hello(ParsedServerHello {
        random: random
        sessionId: sessionId
        cipherSuite: suite
        group: group
        keyShare: share
        selectedIdentity: selectedIdentity
    }))
}

/// Checks the extensions of a HelloRetryRequest: supported_versions is
/// mandatory, key_share may name one newly requested group, and cookie may
/// carry an opaque value. Anything else, or a request that would not change
/// the second ClientHello, is refused.
pure fn parseHelloRetryRequest(sessionId: Bytes, suite: u16, exts: Array[Extension]) -> Result[ServerReply, Error] {
    let mut versionFound = false
    let mut selectedVersion: u16 = 0
    let mut selectedGroup: u16? = None
    let mut cookie: Bytes? = None
    for e in &exts {
        if e.typ == supportedVersionsExt {
            if e.data.len() != 2 {
                fail Error.MalformedHandshake("supported_versions in HelloRetryRequest must hold one version")
            }
            selectedVersion = binary.u16Be(e.data, 0) || 0
            versionFound = true
        } else if e.typ == keyShareExt {
            // KeyShareHelloRetryRequest is just the selected group.
            if e.data.len() != 2 {
                fail Error.MalformedHandshake("HelloRetryRequest key_share must hold only the selected group")
            }
            let group = binary.u16Be(e.data, 0) || 0
            if group != x25519Group && group != secp256r1Group {
                fail Error.Unsupported("server requested key share group ${group}, only x25519 and secp256r1 are supported")
            }
            if group == x25519Group {
                fail Error.MalformedHandshake("HelloRetryRequest requested x25519, which the first ClientHello already offered")
            }
            selectedGroup = Some(group)
        } else if e.typ == cookieExt {
            let mut cr = Reader.new(e.data)
            let value = cr.vec16()?
            cr.end("cookie")?
            if value.len() == 0 {
                fail Error.MalformedHandshake("HelloRetryRequest cookie is empty")
            }
            cookie = Some(value)
        } else {
            fail Error.Unsupported("unexpected HelloRetryRequest extension ${e.typ}")
        }
    }
    if !versionFound {
        fail Error.MalformedHandshake("HelloRetryRequest has no supported_versions")
    }
    if selectedVersion != tls13Version {
        fail Error.Unsupported("server did not select TLS 1.3")
    }
    if (selectedGroup is None) && (cookie is None) {
        fail Error.MalformedHandshake("HelloRetryRequest would not change the ClientHello")
    }
    Ok(Retry(HelloRetryRequest {
        sessionId: sessionId
        cipherSuite: suite
        selectedGroup: selectedGroup
        cookie: cookie
    }))
}

/// The negotiated EncryptedExtensions fields this client acts on.
pub type EncryptedExtensions = {
    /// The selected ALPN protocol, or None when the server sent none.
    pub alpn String?
    /// Whether the server accepted the client's 0-RTT offer.
    pub earlyData Bool
}

/// Parses EncryptedExtensions: the ALPN selection and the early_data
/// acknowledgement. Extensions that carry no negotiation are checked and
/// ignored; anything else is refused.
pub pure fn parseEncryptedExtensions(body: Bytes) -> Result[EncryptedExtensions, Error] {
    let mut r = Reader.new(body)
    let extBlock = r.vec16()?
    r.end("EncryptedExtensions")?
    let exts = parseExtensions(extBlock)?
    let mut selected: String? = None
    let mut earlyData = false
    for e in &exts {
        if e.typ == alpnExt {
            let mut ar = Reader.new(e.data)
            let list = ar.vec16()?
            ar.end("ALPN")?
            let mut lr = Reader.new(list)
            let first = lr.vec8()?
            lr.end("ALPN protocol list")?
            let protocol = match String.fromBytes(first) {
                Ok(value) -> value
                Err(_) -> fail Error.MalformedHandshake("ALPN protocol is not valid UTF-8")
            }
            selected = Some(protocol)
        } else if e.typ == supportedGroupsExt {
            // The server may state the groups it supports; it is
            // informational and carries no negotiation.
            let mut gr = Reader.new(e.data)
            _ = gr.vec16()?
            gr.end("supported_groups")?
        } else if e.typ == serverNameExt {
            // An empty server_name extension acknowledges SNI.
            if e.data.len() != 0 {
                fail Error.MalformedHandshake("server_name acknowledgement is not empty")
            }
        } else if e.typ == earlyDataExt {
            if e.data.len() != 0 {
                fail Error.MalformedHandshake("early_data acknowledgement is not empty")
            }
            earlyData = true
        } else {
            fail Error.Unsupported("unexpected EncryptedExtensions extension ${e.typ}")
        }
    }
    Ok(EncryptedExtensions {
        alpn: selected
        earlyData: earlyData
    })
}

/// Parses a Certificate message into the chain's DER certificates, leaf
/// first. Enforces the empty server request context, the outer byte cap and
/// the certificate count.
pub pure fn parseCertificate(body: Bytes, maxBytes: usize, maxCount: usize) -> Result[Array[Bytes], Error] {
    parseCertificateResponse(body, maxBytes, maxCount, Bytes.zeros(0), true)
}

/// Parses a Certificate message whose certificate_request_context must equal
/// `expectedContext`. `requireNonEmpty` is true for a server chain and false
/// for a client that answered CertificateRequest with no suitable
/// certificate.
pub pure fn parseCertificateResponse(body: Bytes, maxBytes: usize, maxCount: usize, expectedContext: Bytes, requireNonEmpty: Bool) -> Result[Array[Bytes], Error] {
    if body.len() > maxBytes {
        fail Error.BadCertificate("certificate message is larger than ${maxBytes} bytes")
    }
    let mut r = Reader.new(body)
    let context = r.vec8()?
    if !context.equals(&expectedContext) {
        fail Error.BadCertificate("certificate_request_context does not match the request")
    }
    let list = r.vec24()?
    r.end("Certificate")?
    let mut lr = Reader.new(list)
    let mut out = Array.empty[Bytes]()
    for !lr.done() {
        if out.len() >= maxCount {
            fail Error.BadCertificate("certificate chain has more than ${maxCount} certificates")
        }
        let cert = lr.vec24()?
        if cert.len() == 0 {
            fail Error.BadCertificate("certificate entry is empty")
        }
        let ext = lr.vec16()?
        let mut er = Reader.new(ext)
        // Per-certificate extensions are parsed only to prove they are a
        // well-formed list; none are required for authentication.
        for !er.done() {
            let typ = er.u16()?
            let data = er.vec16()?
            if typ == earlyDataExt {
                fail Error.Unsupported("early data in a certificate extension")
            }
            _ = data
        }
        out.push(cert)
    }
    if requireNonEmpty && out.len() == 0 {
        fail Error.BadCertificate("certificate chain is empty")
    }
    Ok(out)
}

/// A CertificateRequest this client can answer.
pub type ParsedCertificateRequest = {
    /// The opaque context the Certificate message must echo.
    pub context Bytes
    /// The signature schemes the server will accept.
    pub schemes Array[u16]
}

/// Parses a CertificateRequest body: the request context, the mandatory
/// signature_algorithms list and optional certificate_authorities. An
/// extension this implementation does not know is skipped; early data in a
/// CertificateRequest is refused.
pub pure fn parseCertificateRequest(body: Bytes) -> Result[ParsedCertificateRequest, Error] {
    let mut r = Reader.new(body)
    let context = r.vec8()?
    let extBlock = r.vec16()?
    r.end("CertificateRequest")?
    let exts = parseExtensions(extBlock)?
    let mut schemesFound = false
    let mut schemes = Array.empty[u16]()
    for e in &exts {
        if e.typ == signatureAlgorithmsExt {
            let mut sr = Reader.new(e.data)
            let list = sr.vec16()?
            sr.end("signature_algorithms")?
            if list.len() % 2 != 0 {
                fail Error.MalformedHandshake("signature_algorithms has ${list.len()} bytes")
            }
            let mut at: usize = 0
            for at < list.len() {
                schemes.push(binary.u16Be(list, at) || 0)
                at = at + 2
            }
            if schemes.len() == 0 {
                fail Error.MalformedHandshake("CertificateRequest signature_algorithms is empty")
            }
            schemesFound = true
        } else if e.typ == certificateAuthoritiesExt {
            let mut cr = Reader.new(e.data)
            let names = cr.vec16()?
            cr.end("certificate_authorities")?
            let mut nr = Reader.new(names)
            for !nr.done() {
                _ = nr.vec16()?
            }
        } else if e.typ == earlyDataExt {
            fail Error.MalformedHandshake("early_data in a CertificateRequest")
        }
    }
    if !schemesFound {
        fail Error.MalformedHandshake("CertificateRequest has no signature_algorithms")
    }
    Ok(ParsedCertificateRequest {
        context: context
        schemes: schemes
    })
}

/// A NewSessionTicket this client acts on.
pub type ParsedNewSessionTicket = {
    pub lifetime u32
    pub ageAdd u32
    pub nonce Bytes
    pub ticket Bytes
    pub maxEarlyData u32
}

/// Parses a NewSessionTicket body (RFC 8446 §4.6.1). A lifetime of zero
/// deletes the ticket. Unknown extensions are skipped; early_data carries
/// the maximum 0-RTT size.
pub pure fn parseNewSessionTicket(body: Bytes) -> Result[ParsedNewSessionTicket, Error] {
    let mut r = Reader.new(body)
    let lifetime = r.u32()?
    let ageAdd = r.u32()?
    let nonce = r.vec8()?
    let ticket = r.vec16()?
    if ticket.len() == 0 {
        fail Error.MalformedHandshake("NewSessionTicket identity is empty")
    }
    let extBlock = r.vec16()?
    r.end("NewSessionTicket")?
    let exts = parseExtensions(extBlock)?
    let mut maxEarlyData: u32 = 0
    for e in &exts {
        if e.typ == earlyDataExt {
            if e.data.len() != 4 {
                fail Error.MalformedHandshake("early_data in NewSessionTicket must be 4 bytes")
            }
            maxEarlyData = binary.u32Be(e.data, 0) || 0
        }
    }
    Ok(ParsedNewSessionTicket {
        lifetime: lifetime
        ageAdd: ageAdd
        nonce: nonce
        ticket: ticket
        maxEarlyData: maxEarlyData
    })
}

/// A CertificateVerify message's scheme and signature.
pub type ParsedCertificateVerify = {
    pub scheme u16
    pub signature Bytes
}

/// Parses a CertificateVerify body.
pub pure fn parseCertificateVerify(body: Bytes) -> Result[ParsedCertificateVerify, Error] {
    let mut r = Reader.new(body)
    let scheme = r.u16()?
    let signature = r.vec16()?
    r.end("CertificateVerify")?
    Ok(ParsedCertificateVerify {
        scheme: scheme
        signature: signature
    })
}

/// Parses a Finished body.
pub pure fn parseFinished(body: Bytes) -> Result[Bytes, Error] {
    if body.len() != 32 {
        fail Error.MalformedHandshake("Finished verify_data must be 32 bytes")
    }
    body
}

/// The bytes a CertificateVerify signature covers (RFC 8446 §4.4.3): 64
/// spaces, the context string, a zero byte and the transcript hash.
pub pure fn certificateVerifyMessage(transcriptHash: Bytes) -> Bytes {
    certificateVerifyMessageFor("TLS 1.3, server CertificateVerify", transcriptHash)
}

/// The CertificateVerify input for the client role.
pub pure fn clientCertificateVerifyMessage(transcriptHash: Bytes) -> Bytes {
    certificateVerifyMessageFor("TLS 1.3, client CertificateVerify", transcriptHash)
}

pure fn certificateVerifyMessageFor(context: String, transcriptHash: Bytes) -> Bytes {
    let mut out = Array.empty[u8]()
    append(&mut out, spaces64.toBytes())
    append(&mut out, context.toBytes())
    putU8(&mut out, 0)
    append(&mut out, transcriptHash)
    freeze(&out)
}

/// A Certificate message with an explicit certificate_request_context and a
/// chain leaf first. Each entry carries an empty per-certificate extension
/// list.
pub pure fn certificateMessage(context: Bytes, certificates: Array[Bytes]) -> Result[Bytes, Error] {
    let mut list = Array.empty[u8]()
    for der in &certificates {
        if der.len() == 0 {
            fail Error.BadCertificate("certificate entry is empty")
        }
        if der.len() > 0xFFFFFF {
            fail Error.HandshakeOverflow
        }
        putU24(&mut list, der.len())
        append(&mut list, der)
        putU16(&mut list, 0)
    }
    if list.len() > 0xFFFFFF {
        fail Error.HandshakeOverflow
    }
    let mut body = Array.empty[u8]()
    putVec8(&mut body, context)?
    putU24(&mut body, list.len())
    append(&mut body, freeze(&list))
    encodeHandshake(certificateType, freeze(&body))
}

/// DER-encodes one ECDSA integer (RFC 3279): strip leading zero bytes, then
/// prefix 0x00 when the high bit would otherwise make it negative.
pure fn derInteger(raw: Bytes) -> Result[Array[u8], Error] {
    let mut start: usize = 0
    for start + 1 < raw.len() && raw[start] == 0 {
        start = start + 1
    }
    let mut body = Array.empty[u8]()
    if (raw[start] & 0x80) != 0 {
        body.push(0)
    }
    let mut i = start
    for i < raw.len() {
        body.push(raw[i])
        i = i + 1
    }
    if body.len() > 127 {
        fail Error.BadSignature
    }
    let mut out = Array.empty[u8]()
    putU8(&mut out, 2)
    putU8(&mut out, body.len().toU8() || 0)
    append(&mut out, freeze(&body))
    Ok(out)
}

// DER-encodes an ECDSA r || s signature as ECDSA-Sig-Value, which is what
// CertificateVerify carries (RFC 8446 §4.4.3).
pure fn derSignature(signature: Bytes) -> Result[Bytes, Error] {
    if signature.len() != 64 {
        fail Error.BadSignature
    }
    let r = derInteger(signature.slice(0, 32) || fail Error.BadSignature)?
    let s = derInteger(signature.slice(32, 64) || fail Error.BadSignature)?
    let mut body = Array.empty[u8]()
    body.appendAll(r)
    body.appendAll(s)
    if body.len() > 127 {
        fail Error.BadSignature
    }
    let mut out = Array.empty[u8]()
    putU8(&mut out, 0x30)
    putU8(&mut out, body.len().toU8() || 0)
    append(&mut out, freeze(&body))
    Ok(freeze(&out))
}

/// A CertificateVerify message carrying an ecdsa_secp256r1_sha256 signature
/// over the supplied message bytes.
pub pure fn certificateVerifyMessageWithSignature(scheme: u16, signature: Bytes) -> Result[Bytes, Error] {
    if scheme != ecdsaSecp256r1Sha256 {
        fail Error.Unsupported("certificate signature scheme ${scheme} is not implemented")
    }
    let der = derSignature(signature)?
    let mut body = Array.empty[u8]()
    putU16(&mut body, scheme)
    putVec16(&mut body, der)?
    encodeHandshake(certificateVerifyType, freeze(&body))
}

/// A CertificateRequest asking for an ECDSA P-256 client certificate. The
/// context is empty during the handshake.
pub pure fn certificateRequestMessage(context: Bytes, schemes: Array[u16]) -> Result[Bytes, Error] {
    let mut list = Array.empty[u8]()
    for scheme in &schemes {
        putU16(&mut list, scheme)
    }
    let mut extBody = Array.empty[u8]()
    putVec16(&mut extBody, freeze(&list))?
    let mut exts = Array.empty[u8]()
    putExtension(&mut exts, signatureAlgorithmsExt, extBody)?
    let mut body = Array.empty[u8]()
    putVec8(&mut body, context)?
    putVec16(&mut body, freeze(&exts))?
    encodeHandshake(certificateRequestType, freeze(&body))
}

/// A NewSessionTicket carrying one resumption PSK identity.
pub pure fn newSessionTicketMessage(lifetime: u32, ageAdd: u32, nonce: Bytes, ticket: Bytes, maxEarlyData: u32) -> Result[Bytes, Error] {
    let mut exts = Array.empty[u8]()
    if maxEarlyData > 0 {
        let mut early = Array.empty[u8]()
        putU32(&mut early, maxEarlyData)
        putExtension(&mut exts, earlyDataExt, early)?
    }
    let mut body = Array.empty[u8]()
    putU32(&mut body, lifetime)
    putU32(&mut body, ageAdd)
    putVec8(&mut body, nonce)?
    putVec16(&mut body, ticket)?
    putVec16(&mut body, freeze(&exts))?
    encodeHandshake(newSessionTicketType, freeze(&body))
}

import x509 from std/crypto/x509
import secret from std/secret
// A TLS 1.3 client and server (RFC 8446) over an existing `net.Conn`, with
// AEAD_CHACHA20_POLY1305 and x25519 / secp256r1 ECDHE. `Client`, `Server`
// and `Session` need `net.Conn`, so they exist only on hosted targets
// (tls_hosted.kg, server_hosted.kg).
//
// The client handshake is a strict, authenticated exchange. Without a ticket
// it verifies the server chain and CertificateVerify against the configured
// anchors; with a `Config.session` ticket it offers psk_dhe_ke resumption and,
// when the ticket allows it, 0-RTT early data. A server that asks for a
// client certificate gets the configured ECDSA P-256 chain and a
// CertificateVerify; without one it sends an empty Certificate and the
// server decides. One HelloRetryRequest is handled: its cookie is echoed and
// the requested key share replaces the initial x25519 one before the
// handshake continues; a second HelloRetryRequest is refused, and a retry
// after 0-RTT is a fatal error. A server that does not select TLS 1.3 with
// TLS_CHACHA20_POLY1305_SHA256 is refused rather than downgraded, and there
// is no plaintext fallback. The negotiated cipher suites are exactly the one
// this module implements; everything else is an `Unsupported` error.
//
// The server handshake (`Server.handshake`) accepts a ClientHello that
// offers TLS 1.3 with the same cipher suite and an
// ecdsa_secp256r1_sha256 signature (or a valid resumption PSK), and answers
// with ServerHello, EncryptedExtensions, optional CertificateRequest,
// optional Certificate/CertificateVerify and Finished. Resumption state
// lives in a `TicketStore`; NewSessionTicket messages are issued after the
// handshake, and a 0-RTT ticket is single use. A replayed, expired or
// over-limit 0-RTT offer is a fatal error. A client Finished is checked in
// constant time before the application keys are installed. No
// HelloRetryRequest is sent: the server answers whichever of x25519 and
// secp256r1 the client offered a share for, and refuses a client that offers
// neither.
//
// Randomness comes from `Config.random` / `ServerConfig.random`; a caller
// that stores keys must pass a CSPRNG such as
// `(n) => host.entropy().bytes(n)`. Tests pass a deterministic source
// deliberately.
//
// Record sizes are capped, handshake messages are bounded, and every
// unexpected message type, extension or ordering is an `Error`. An inbound
// alert is an error and a close_notify is end of stream; either way the
// session stops reading. On a handshake failure a fatal alert is sent
// best-effort before the connection is dropped.
//
// Not implemented, and refused rather than negotiated down: TLS 1.2,
// KeyUpdate, record padding on send, post-handshake authentication, and
// every cipher suite other than TLS_CHACHA20_POLY1305_SHA256. The only
// CertificateVerify schemes accepted are rsa_pss_rsae_sha256 (client side)
// and ecdsa_secp256r1_sha256 (both sides). SNI is omitted for an IP-literal
// server name, and a certificate chain must reach one of the supplied
// anchors.
import time from std/time

/// Why a TLS operation failed.
pub type Error =
    | Closed
    | ConnectionClosed
    | NotEstablished
    | MalformedHandshake(String)
    | UnexpectedMessage(String)
    | Unsupported(String)
    | BadCertificate(String)
    | BadSignature
    | BadFinished
    | BadRecord(String)
    | RecordOverflow
    | HandshakeOverflow
    | Alert(u8, u8)
    | Io(String)
    | Random(String)
    | KeySchedule(String)
    | TicketReplay
    | TicketExpired
    | EarlyDataRejected(String)
    | ClientAuthRequired

/// A short, fixed explanation of the error.
pub fn Error.message(self) -> String {
    match self {
        Closed -> "tls: session is closed"
        ConnectionClosed -> "tls: connection closed"
        NotEstablished -> "tls: handshake has not finished"
        MalformedHandshake(why) -> "tls: malformed handshake: ${why}"
        UnexpectedMessage(why) -> "tls: unexpected message: ${why}"
        Unsupported(why) -> "tls: unsupported: ${why}"
        BadCertificate(why) -> "tls: bad certificate: ${why}"
        BadSignature -> "tls: CertificateVerify signature does not verify"
        BadFinished -> "tls: Finished verify_data does not match"
        BadRecord(why) -> "tls: bad record: ${why}"
        RecordOverflow -> "tls: record is larger than the configured limit"
        HandshakeOverflow -> "tls: handshake message is larger than the configured limit"
        Alert(level, description) -> "tls: peer sent alert ${description} (level ${level})"
        Io(why) -> "tls: ${why}"
        Random(why) -> "tls: random source failed: ${why}"
        KeySchedule(why) -> "tls: key schedule: ${why}"
        TicketReplay -> "tls: session ticket was replayed"
        TicketExpired -> "tls: session ticket is expired or outside its age window"
        EarlyDataRejected(why) -> "tls: early data was rejected: ${why}"
        ClientAuthRequired -> "tls: the server requires a client certificate"
    }
}

/// A client authentication key. Only ECDSA P-256 is implemented, and the
/// key must match the leaf of the configured client certificate chain.
pub type ClientKey = | EcP256(secret.SecretBuffer)

/// A resumption ticket a client can offer on a later connection. The PSK is
/// derived from the NewSessionTicket nonce and never leaves the process.
pub type SessionTicket = {
    pub serverName String
    pub alpn String
    pub ticket Bytes
    pub psk secret.SecretNat[4]
    pub lifetimeMillis Int
    pub issuedAtMillis Int
    pub ageAdd u32
    pub maxEarlyData usize
}

/// A copy of the ticket, so one client can offer it on a later connection.
pub fn SessionTicket.clone(self) -> SessionTicket {
    SessionTicket {
        serverName: self.serverName
        alpn: self.alpn
        ticket: self.ticket
        psk: self.psk
        lifetimeMillis: self.lifetimeMillis
        issuedAtMillis: self.issuedAtMillis
        ageAdd: self.ageAdd
        maxEarlyData: self.maxEarlyData
    }
}

/// Client settings. `anchors` are the trusted roots, `serverName` is the
/// name checked against the leaf certificate, and `random` must return
/// cryptographically random bytes.
pub type Config = {
    pub serverName String
    pub anchors Array[x509.Certificate]
    pub random fn(usize) -> Bytes!
    // ALPN protocols in preference order; a server selecting anything else
    // is refused.
    pub mut alpn Array[String]
    // Wall clock for certificate validity, in milliseconds since the epoch.
    pub mut nowMillis Int
    // Largest TLSCiphertext accepted from the peer.
    pub mut maxRecordBytes usize
    // Largest handshake message accepted (certificate chains dominate this).
    pub mut maxHandshakeBytes usize
    // Largest Certificate message accepted.
    pub mut maxCertificateBytes usize
    // A ticket to offer for PSK resumption. It is ignored when it names a
    // different server, ALPN protocol or curve, or when it has expired.
    pub mut session SessionTicket?
    // 0-RTT bytes sent with the ClientHello when the ticket allows them.
    pub mut earlyData secret.SecretBuffer
    // Oldest ticket age at which this client still attempts 0-RTT.
    pub mut earlyDataMaxAgeMillis Int
    // Client certificate chain, DER leaf first, sent when the server asks.
    pub mut clientCertificates Array[Bytes]
    // The key that signs the client CertificateVerify.
    pub mut clientKey ClientKey?
}

/// A configuration with TLS 1.3 defaults, ALPN "http/1.1" and the current
/// time. `random` is the only mandatory capability.
pub fn Config.new(serverName: String, anchors: Array[x509.Certificate], random: escaping fn(usize) -> Bytes!) -> Config {
    Config {
        serverName: serverName
        anchors: anchors
        random: random
        alpn: Array.of("http/1.1")
        nowMillis: time.now().unixMillis()
        maxRecordBytes: maxCiphertext
        maxHandshakeBytes: 1048576
        maxCertificateBytes: 1048576
        session: None
        earlyData: secret.SecretBuffer.fromBytes(Bytes.zeros(0))
        earlyDataMaxAgeMillis: 60000
        clientCertificates: Array.empty[Bytes]()
        clientKey: None
    }
}

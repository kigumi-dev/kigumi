import x509 from std/crypto/x509
// A TLS 1.3 client and server (RFC 8446) over an existing `net.Conn`, with
// AEAD_CHACHA20_POLY1305 and x25519 / secp256r1 ECDHE. `Client`, `Server`
// and `Session` need `net.Conn`, so they exist only on hosted targets
// (tls_hosted.kg, server_hosted.kg).
//
// The client handshake is a strict, certificate-authenticated exchange: no
// PSK, no session resumption, no 0-RTT and no client certificate. One
// HelloRetryRequest is handled: its cookie is echoed and the requested key
// share replaces the initial x25519 one before the handshake continues; a
// second HelloRetryRequest is refused. A server that does not select TLS 1.3
// with TLS_CHACHA20_POLY1305_SHA256 is refused rather than downgraded, and
// there is no plaintext fallback. The negotiated cipher suites are exactly
// the one this module implements; everything else is an `Unsupported` error.
//
// The server handshake (`Server.handshake`) accepts a ClientHello that
// offers TLS 1.3 with the same cipher suite and an
// ecdsa_secp256r1_sha256 signature, and answers with ServerHello,
// EncryptedExtensions, Certificate, CertificateVerify and Finished. The
// configured chain is sent as-is and the configured secp256r1 key must match
// the leaf. A client Finished is checked in constant time before the
// application keys are installed. No HelloRetryRequest is sent: the server
// answers whichever of x25519 and secp256r1 the client offered a share for,
// and refuses a client that offers neither.
//
// Randomness comes from `Config.random` / `ServerConfig.random`; a caller
// that stores keys must pass a CSPRNG such as
// `(n) => host.entropy().bytes(n)`. Tests pass a deterministic source
// deliberately.
//
// Record sizes are capped, handshake messages are bounded, and every
// unexpected message type, extension or ordering is an `Error`. An inbound
// alert is an error and a close_notify is end of stream; either way the
// session stops reading. On a handshake failure a fatal alert is sent
// best-effort before the connection is dropped.
//
// Not implemented, and refused rather than negotiated down: PSK resumption
// and 0-RTT, client certificates, KeyUpdate, record padding on send, and
// every cipher suite other than TLS_CHACHA20_POLY1305_SHA256. The only
// CertificateVerify schemes accepted are rsa_pss_rsae_sha256 (client side)
// and ecdsa_secp256r1_sha256 (both sides). NewSessionTicket messages are
// ignored by the client. SNI is omitted for an IP-literal server name, and a
// certificate chain must reach one of the supplied anchors.
import time from std/time

/// Why a TLS operation failed.
pub type Error =
    | Closed
    | ConnectionClosed
    | NotEstablished
    | MalformedHandshake(String)
    | UnexpectedMessage(String)
    | Unsupported(String)
    | BadCertificate(String)
    | BadSignature
    | BadFinished
    | BadRecord(String)
    | RecordOverflow
    | HandshakeOverflow
    | Alert(u8, u8)
    | Io(String)
    | Random(String)
    | KeySchedule(String)

/// A short, fixed explanation of the error.
pub fn Error.message(self) -> String {
    match self {
        Closed -> "tls: session is closed"
        ConnectionClosed -> "tls: connection closed"
        NotEstablished -> "tls: handshake has not finished"
        MalformedHandshake(why) -> "tls: malformed handshake: ${why}"
        UnexpectedMessage(why) -> "tls: unexpected message: ${why}"
        Unsupported(why) -> "tls: unsupported: ${why}"
        BadCertificate(why) -> "tls: bad certificate: ${why}"
        BadSignature -> "tls: CertificateVerify signature does not verify"
        BadFinished -> "tls: Finished verify_data does not match"
        BadRecord(why) -> "tls: bad record: ${why}"
        RecordOverflow -> "tls: record is larger than the configured limit"
        HandshakeOverflow -> "tls: handshake message is larger than the configured limit"
        Alert(level, description) -> "tls: peer sent alert ${description} (level ${level})"
        Io(why) -> "tls: ${why}"
        Random(why) -> "tls: random source failed: ${why}"
        KeySchedule(why) -> "tls: key schedule: ${why}"
    }
}

/// Client settings. `anchors` are the trusted roots, `serverName` is the
/// name checked against the leaf certificate, and `random` must return
/// cryptographically random bytes.
pub type Config = {
    pub serverName String
    pub anchors Array[x509.Certificate]
    pub random fn(usize) -> Bytes!
    // ALPN protocols in preference order; a server selecting anything else
    // is refused.
    pub mut alpn Array[String]
    // Wall clock for certificate validity, in milliseconds since the epoch.
    pub mut nowMillis Int
    // Largest TLSCiphertext accepted from the peer.
    pub mut maxRecordBytes usize
    // Largest handshake message accepted (certificate chains dominate this).
    pub mut maxHandshakeBytes usize
    // Largest Certificate message accepted.
    pub mut maxCertificateBytes usize
}

/// A configuration with TLS 1.3 defaults, ALPN "http/1.1" and the current
/// time. `random` is the only mandatory capability.
pub fn Config.new(serverName: String, anchors: Array[x509.Certificate], random: escaping fn(usize) -> Bytes!) -> Config {
    Config {
        serverName: serverName
        anchors: anchors
        random: random
        alpn: Array.of("http/1.1")
        nowMillis: time.now().unixMillis()
        maxRecordBytes: maxCiphertext
        maxHandshakeBytes: 1048576
        maxCertificateBytes: 1048576
    }
}

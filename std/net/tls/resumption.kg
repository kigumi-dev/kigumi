// Server-side resumption state: the opaque ticket, its PSK and the age and
// replay bookkeeping a TLS 1.3 server needs (RFC 8446 §4.6.1, §8).
//
// Tickets are stateful: the identity is random bytes handed to the client and
// the store owns the matching PSK, so no ticket key has to be rotated and a
// removed ticket cannot be decrypted. Early-data tickets are single use:
// `consume(... early: true)` refuses a second use and reports replay instead
// of falling back, which keeps a replayed 0-RTT flight from being accepted.
import alloc from std/alloc

/// One issued resumption ticket.
pub type StoredTicket = {
    pub ticket Bytes
    pub psk Bytes
    pub issuedAtMillis Int
    pub lifetimeMillis Int
    pub ageAdd u32
    pub alpn String
    pub maxEarlyData usize
    pub mut used Bool
}

/// The mutable state behind a `TicketStore`.
pub type TicketState = {
    mut entries Array[StoredTicket]
}

/// The server's ticket table. `Shared` lets one table serve every accepted
/// connection without being moved into the first handshake.
pub type TicketStore = {
    pub inner alloc.Shared[TicketState]
}

/// A second handle to the same table.
pub fn TicketStore.clone(self) -> TicketStore {
    TicketStore {
        inner: self.inner.clone()
    }
}

/// An empty ticket table.
pub fn TicketStore.new() -> TicketStore {
    TicketStore {
        inner: alloc.Shared.new(TicketState {
            entries: Array.empty[StoredTicket]()
        })
    }
}

/// Records a freshly issued ticket. The caller generates a unique identity.
pub fn TicketStore.insert(self, value: StoredTicket) {
    self.inner.withMut[Void]((state: &mut TicketState) => {
        state.entries.push(value)
    })
}

/// Looks up a ticket and, for 0-RTT, enforces single use and the age window.
///
/// An unknown ticket returns None so a server can fall back to a full
/// handshake. A ticket that exists but is expired, too old for early data or
/// already used is a `TicketExpired` / `TicketReplay` error: a peer that
/// offers such a ticket is refused rather than silently downgraded.
pub fn TicketStore.consume(self, ticket: Bytes, nowMillis: Int, early: Bool, maxEarlyAgeMillis: Int) -> Result[StoredTicket?, Error] {
    self.inner.withMut[Result[StoredTicket?, Error]]((state: &mut TicketState) => {
        let mut index: usize? = None
        let mut i: usize = 0
        for i < state.entries.len() {
            if state.entries[i].ticket.equals(&ticket) {
                index = Some(i)
            }
            i = i + 1
        }
        match index {
            None -> Ok(None)
            Some(at) -> {
                let entry = match state.entries.takeAt(at) {
                    Some(value) -> value
                    None -> fail Error.TicketExpired
                }
                let age = nowMillis - entry.issuedAtMillis
                if entry.lifetimeMillis <= 0 || age < 0 || age > entry.lifetimeMillis {
                    fail Error.TicketExpired
                }
                if early && entry.used {
                    state.entries.push(entry)
                    fail Error.TicketReplay
                }
                if early && entry.maxEarlyData == 0 {
                    state.entries.push(entry)
                    fail Error.EarlyDataRejected("the ticket does not allow early data")
                }
                if early && age > maxEarlyAgeMillis {
                    state.entries.push(entry)
                    fail Error.TicketExpired
                }
                let mut kept = entry
                if early {
                    kept.used = true
                }
                let result = StoredTicket {
                    ticket: kept.ticket
                    psk: kept.psk
                    issuedAtMillis: kept.issuedAtMillis
                    lifetimeMillis: kept.lifetimeMillis
                    ageAdd: kept.ageAdd
                    alpn: kept.alpn
                    maxEarlyData: kept.maxEarlyData
                    used: kept.used
                }
                state.entries.push(kept)
                Ok(Some(result))
            }
        }
    })
}

import p256 from std/crypto/p256
import sha256 from std/crypto/sha256
import x509 from std/crypto/x509
// A TLS 1.3 server (RFC 8446) over an existing `net.Conn`, the mirror of
// the client in tls_hosted.kg: TLS_CHACHA20_POLY1305_SHA256, an x25519 or
// secp256r1 key share, and a certificate chain signed with a secp256r1 key.
//
// Resumption is psk_dhe_ke: a NewSessionTicket carries a resumption PSK and
// the server keeps the matching state in a `TicketStore`, so it can validate
// the ClientHello binder and resume without a certificate. 0-RTT data is
// decrypted with the early traffic secret only when the ticket is live,
// within its age window and unused; a replayed or stale early-data ticket is
// a fatal error, never a silent fallback. A client certificate is requested
// when `requireClientAuth` is set and its chain is validated against
// `clientAnchors` before CertificateVerify is checked.
//
// `certificates` is the DER chain, leaf first; `key` is the leaf's secp256r1
// scalar and is checked against the leaf's public key before anything is
// sent, so a misconfigured pair fails instead of sending a flight the peer
// cannot authenticate. Randomness comes from `ServerConfig.random`; a caller
// that stores keys must pass a CSPRNG such as
// `(n) => host.entropy().bytes(n)`. Tests pass a deterministic source
// deliberately.
//
// The server flight is one protected run of EncryptedExtensions,
// [CertificateRequest], [Certificate, CertificateVerify] and Finished,
// fragmented at the plaintext cap. The client Finished is checked in
// constant time; only then are the application traffic keys installed and
// NewSessionTicket messages sent. close_notify is end of stream, and on any
// handshake failure a fatal alert is sent best-effort before the connection
// is dropped.
import binary from std/encoding/binary
import net from std/net
import sec from std/secret
import time from std/time

/// The server's signing key. Only ECDSA P-256 is implemented, and the key
/// must match the leaf certificate's public key.
pub type ServerKey = | EcP256(sec.SecretBuffer)

/// Server settings. `certificates` is the DER chain leaf first, `key` signs
/// CertificateVerify, and `random` must return cryptographically random
/// bytes.
pub type ServerConfig = {
    pub certificates Array[Bytes]
    pub key ServerKey
    pub random fn(usize) -> Bytes!
    // ALPN protocols in server preference order; an empty list disables
    // ALPN. A client that offers protocols with no overlap is refused.
    pub mut alpn Array[String]
    // Largest TLSCiphertext accepted from the peer.
    pub mut maxRecordBytes usize
    // Largest handshake message accepted; it bounds the ClientHello and the
    // certificate chain the server sends.
    pub mut maxHandshakeBytes usize
    // Wall clock for ticket age checks, in milliseconds since the epoch.
    pub mut nowMillis Int
    // Tickets issued after a successful handshake. Zero disables resumption.
    pub mut tickets usize
    // Lifetime of an issued ticket, in milliseconds.
    pub mut ticketLifetimeMillis Int
    // Largest 0-RTT payload accepted, and the oldest ticket age at which it
    // is accepted. Zero disables 0-RTT.
    pub mut maxEarlyData usize
    pub mut maxEarlyDataAgeMillis Int
    // The table that owns resumption PSKs and replay state. Required when
    // `tickets` is non-zero.
    pub mut store TicketStore?
    // Request and verify a client certificate against `clientAnchors`.
    pub mut requireClientAuth Bool
    pub mut clientAnchors Array[x509.Certificate]
}

/// A configuration with TLS 1.3 defaults, no ALPN and no resumption.
/// `certificates`, `key` and `random` are the mandatory capabilities.
pub fn ServerConfig.new(certificates: Array[Bytes], key: ServerKey, random: escaping fn(usize) -> Bytes!) -> ServerConfig {
    ServerConfig {
        certificates: certificates
        key: key
        random: random
        alpn: Array.empty[String]()
        maxRecordBytes: maxCiphertext
        maxHandshakeBytes: 1048576
        nowMillis: time.now().unixMillis()
        tickets: 0
        ticketLifetimeMillis: 86400000
        maxEarlyData: 0
        maxEarlyDataAgeMillis: 60000
        store: None
        requireClientAuth: false
        clientAnchors: Array.empty[x509.Certificate]()
    }
}

/// The TLS server entry point: `Server.handshake(conn, config)`.
pub type Server

/// Runs the server side of the handshake over conn and returns a session
/// ready for application data. Any failure closes the connection, so no
/// plaintext path remains.
pub async fn Server.handshake(conn: net.Conn, config: ServerConfig) -> Result[Session, Error] {
    // The server never parses a Certificate message, so the client-side
    // certificate cap is inert here and simply matches the handshake bound.
    let mut session = newSession(conn, config.maxRecordBytes, config.maxHandshakeBytes, config.maxHandshakeBytes)
    match (await session.runServerHandshake(config)) {
        Ok(_) -> {}
        Err(e) -> {
            // Best effort: the peer should learn the connection is over even
            // when the failure was ours, then the session drops the socket.
            await session.sendAlert(2, alertDescription(&e))
            session.open = false
            return Err(e)
        }
    }
    Ok(session)
}

// The ServerHello: TLS 1.3, TLS_CHACHA20_POLY1305_SHA256, the echoed
// session id, the server's key share and, on resumption, the selected PSK
// identity as the last extension.
pure fn serverHello(random: Bytes, sessionId: Bytes, group: u16, keyShare: Bytes, selectedIdentity: u16?) -> Result[Bytes, Error] {
    let mut versions = Array.empty[u8]()
    putU16(&mut versions, tls13Version)
    let mut exts = Array.empty[u8]()
    putExtension(&mut exts, supportedVersionsExt, versions)?

    let mut share = Array.empty[u8]()
    putU16(&mut share, group)
    putVec16(&mut share, keyShare)?
    putExtension(&mut exts, keyShareExt, share)?

    if let Some(identity) = selectedIdentity {
        let mut psk = Array.empty[u8]()
        putU16(&mut psk, identity)
        putExtension(&mut exts, preSharedKeyExt, psk)?
    }

    let mut body = Array.empty[u8]()
    putU16(&mut body, 0x0303)
    append(&mut body, random)
    putVec8(&mut body, sessionId)?
    putU16(&mut body, chacha20Poly1305Sha256)
    putU8(&mut body, 0)
    putVec16(&mut body, freeze(&exts))?
    encodeHandshake(serverHelloType, freeze(&body))
}

// EncryptedExtensions: the selected ALPN protocol (if any) and the 0-RTT
// acknowledgement.
pure fn encryptedExtensions(alpn: String?, earlyData: Bool) -> Result[Bytes, Error] {
    let mut exts = Array.empty[u8]()
    if let Some(protocol) = alpn {
        let mut list = Array.empty[u8]()
        putVec8(&mut list, protocol.toBytes())?
        let mut body = Array.empty[u8]()
        putVec16(&mut body, freeze(&list))?
        putExtension(&mut exts, alpnExt, body)?
    }
    if earlyData {
        putExtension(&mut exts, earlyDataExt, Array.empty[u8]())?
    }
    let mut message = Array.empty[u8]()
    putVec16(&mut message, freeze(&exts))?
    encodeHandshake(encryptedExtensionsType, freeze(&message))
}

// Chooses the first configured ALPN protocol the client offered. A client
// that offers none, or a server with no protocols configured, negotiates
// nothing; a client that offers protocols with no overlap is refused.
pure fn selectAlpn(configured: &Array[String], offered: &Array[String]) -> Result[String?, Error] {
    if configured.len() == 0 || offered.len() == 0 {
        return Ok(None)
    }
    for preferred in configured {
        for candidate in offered {
            if preferred == candidate {
                return Ok(Some(preferred))
            }
        }
    }
    fail Error.Unsupported("client and server have no ALPN protocol in common")
}

async fn Session.runServerHandshake(mut self, config: ServerConfig) -> Result[Void, Error] {
    let certificates = move config.certificates
    if certificates.len() == 0 {
        fail Error.BadCertificate("no certificate chain was configured")
    }
    let keySecret = match config.key {
        ServerKey.EcP256(secret) -> secret
    }
    // The P-256 public-key derivation still takes public limbs; signing keeps
    // the private scalar secret-typed.
    let key = p256Scalar(&keySecret)
    if key.len() != p256.scalarSize {
        fail Error.BadCertificate("server key must be 32 bytes")
    }
    let public = match p256.publicKey(key) {
        Ok(value) -> value
        Err(e) -> fail Error.BadCertificate(e.message())
    }
    let leafDer = match certificates.get(0) {
        Some(value) -> value
        None -> fail Error.BadCertificate("no certificate chain was configured")
    }
    let leaf = match x509.parse(leafDer) {
        Ok(value) -> value
        Err(e) -> fail Error.BadCertificate(e.message())
    }
    let keyMatches = match leaf.publicKey {
        x509.PublicKey.EcP256(certPublic) -> certPublic.equals(&public)
        x509.PublicKey.Rsa(_) -> fail Error.Unsupported("an RSA server key is not implemented")
    }
    if !keyMatches {
        fail Error.BadCertificate("server key does not match the leaf certificate")
    }

    let randomFn = config.random
    let nowMillis = config.nowMillis
    let ticketCount = config.tickets
    let ticketLifetimeMillis = config.ticketLifetimeMillis
    let maxEarlyData = config.maxEarlyData
    let maxEarlyAgeMillis = config.maxEarlyDataAgeMillis
    let requireClientAuth = config.requireClientAuth
    let clientAnchors = move config.clientAnchors
    let offeredStore = move config.store
    if ticketCount > 0 && (offeredStore is None) {
        fail Error.Unsupported("resumption tickets need a TicketStore")
    }
    if requireClientAuth && clientAnchors.len() == 0 {
        fail Error.BadCertificate("client authentication needs trust anchors")
    }
    let ticketStore: TicketStore? = match &offeredStore {
        Some(value) -> Some(value.clone())
        None -> None
    }

    let serverRandom = match randomFn(32) {
        Ok(value) -> value
        Err(e) -> fail Error.Random(e.message())
    }
    if serverRandom.len() != 32 {
        fail Error.Random("random source returned ${serverRandom.len()} bytes, not 32")
    }
    if serverRandom.equals(&helloRetryRequestRandom()) {
        fail Error.Random("random source produced the HelloRetryRequest value")
    }
    let secret = sec.SecretBuffer.fromBytes(match randomFn(32) {
        Ok(value) -> value
        Err(e) -> fail Error.Random(e.message())
    })
    if secret.len() != 32 {
        fail Error.Random("random source returned ${secret.len()} bytes, not 32")
    }

    // The ClientHello arrives in plaintext. Any CCS is skipped by
    // readRecord, and any other record type is a handshake error.
    let hello = (await self.nextHandshake())?
    if hello.typ != clientHelloType {
        fail Error.UnexpectedMessage("expected ClientHello, got handshake type ${hello.typ}")
    }
    let parsed = parseClientHello(hello.body)?
    // Everything after the ClientHello must arrive under the record layer
    // this server is about to install; a plaintext message already buffered
    // would otherwise be read as if it were protected.
    if self.hsBuf.len() != 0 {
        fail Error.UnexpectedMessage("plaintext handshake bytes follow the ClientHello")
    }
    let mut transcript = hello.raw

    let selectedAlpn = selectAlpn(&config.alpn, &parsed.alpn)?
    let group = parsed.group
    let serverPublic = ephemeralPublic(group, &secret)?
    let sharedSecret = keyExchangeShared(group, &secret, parsed.keyShare)?

    // Resolve and authenticate a resumption offer before touching the key
    // schedule. An unknown ticket falls back to a full handshake; a ticket
    // that exists but is stale, replayed or bound to another ALPN protocol
    // is refused rather than silently downgraded.
    let mut resumed = false
    let mut ticketPsk = sec.SecretBuffer.fromBytes(Bytes.zeros(0))
    let mut selectedIdentity: u16? = None
    let mut earlyRequested = parsed.earlyData
    let mut earlyAccepted = false
    let mut earlyLimit: usize = 0
    if let Some(offer) = parsed.psk {
        let mut i: usize = 0
        for i < offer.identities.len() && !resumed {
            let identity = offer.identities[i]
            let lookedUp = match &ticketStore {
                Some(store) -> store.consume(identity.identity, nowMillis, false, maxEarlyAgeMillis)?
                None -> None
            }
            if let Some(ticket) = lookedUp {
                let alpnMatches = match selectedAlpn {
                    Some(protocol) -> ticket.alpn == protocol
                    None -> ticket.alpn == ""
                }
                if alpnMatches {
                    let binderPsk = ticket.psk.toBuffer()
                    verifyPskBinder(hello.raw, offer.bindersAt, &binderPsk, offer.binders[i])?
                    resumed = true
                    ticketPsk = ticket.psk.toBuffer()
                    selectedIdentity = Some((i.toU16() || 0))
                    if earlyRequested {
                        if maxEarlyData == 0 || ticket.maxEarlyData == 0 {
                            fail Error.EarlyDataRejected("the server or ticket does not allow 0-RTT")
                        }
                        let used = match &ticketStore {
                            Some(store) -> store.consume(identity.identity, nowMillis, true, maxEarlyAgeMillis)?
                            None -> None
                        }
                        match used {
                            Some(limited) -> {
                                earlyAccepted = true
                                earlyLimit = if limited.maxEarlyData < maxEarlyData {
                                    limited.maxEarlyData
                                } else {
                                    maxEarlyData
                                }
                            }
                            None -> fail Error.EarlyDataRejected("the ticket disappeared during the handshake")
                        }
                    }
                }
            }
            i = i + 1
        }
        if !resumed && earlyRequested {
            // Without the PSK the early records cannot be decrypted, so a
            // server cannot safely skip them.
            fail Error.EarlyDataRejected("the ticket was not recognised")
        }
        if !resumed {
            earlyRequested = false
        }
    }

    let serverHelloMessage = serverHello(serverRandom, parsed.sessionId, group, serverPublic, selectedIdentity)?
    (await self.writeRaw((sealPlaintext(handshakeType, serverHelloMessage))?))?
    transcript = transcript.concat(serverHelloMessage)

    let secrets = match if resumed {
        deriveHandshakePsk(&ticketPsk, &sharedSecret, sha256.sum(transcript))
    } else {
        deriveHandshake(&sharedSecret, sha256.sum(transcript))
    } {
        Ok(value) -> value
        Err(e) -> fail e
    }
    self.readKeys = move secrets.client
    self.writeKeys = move secrets.server
    self.readProtected = true
    self.writeProtected = true
    self.readSeq = 0
    self.writeSeq = 0
    self.resumedSession = resumed
    if let Some(protocol) = selectedAlpn {
        self.negotiatedProtocol = protocol
    }

    let eeMessage = encryptedExtensions(selectedAlpn, earlyAccepted)?
    transcript = transcript.concat(eeMessage)
    let mut flight = eeMessage

    if requireClientAuth {
        let request = certificateRequestMessage(Bytes.zeros(0), Array.of(ecdsaSecp256r1Sha256, rsaPssRsaeSha256))?
        transcript = transcript.concat(request)
        flight = flight.concat(request)
    }

    if !resumed {
        let certMessage = certificateMessage(Bytes.zeros(0), certificates)?
        if certMessage.len() > self.maxHandshakeBytes {
            fail Error.HandshakeOverflow
        }
        transcript = transcript.concat(certMessage)
        flight = flight.concat(certMessage)

        let signature = match p256.signMessage(&keySecret, certificateVerifyMessage(sha256.sum(transcript))) {
            Ok(value) -> value
            Err(e) -> fail Error.KeySchedule(e.message())
        }
        let cvMessage = certificateVerifyMessageWithSignature(ecdsaSecp256r1Sha256, signature)?
        transcript = transcript.concat(cvMessage)
        flight = flight.concat(cvMessage)
    }

    let serverVerify = finishedVerifyData(&self.writeKeys.secret, sha256.sum(transcript))?
    let finishedMessage = encodeHandshake(finishedType, unsafe {
        serverVerify.declassify()
    })?
    transcript = transcript.concat(finishedMessage)
    flight = flight.concat(finishedMessage)
    // RFC 8446 §7.1: application secrets cover the transcript through the
    // server Finished, before any client authentication flight.
    let applicationTranscript = sha256.sum(transcript)
    (await self.sendHandshakeFlight(flight))?

    // 0-RTT records use their own key and sequence space. They are drained
    // before the client Finished so the handshake reader sees the next
    // protected handshake record; a rejected offer is discarded under the
    // same keys instead of being handed to the application.
    if earlyRequested {
        self.earlyReadKeys = deriveEarlyTraffic(&ticketPsk, sha256.sum(hello.raw))?
        self.earlyReadSeq = 0
        self.earlyReadOpen = true
        (await self.drainEarlyData(earlyLimit, earlyAccepted))?
        self.earlyOk = earlyAccepted
    }

    let mut clientTranscript = transcript
    if requireClientAuth {
        let certMessageIn = (await self.nextHandshake())?
        if certMessageIn.typ != certificateType {
            fail Error.UnexpectedMessage("expected client Certificate, got handshake type ${certMessageIn.typ}")
        }
        let chain = parseCertificateResponse(certMessageIn.body, self.maxCertificateBytes, 16, Bytes.zeros(0), false)?
        clientTranscript = clientTranscript.concat(certMessageIn.raw)
        if chain.len() == 0 {
            fail Error.ClientAuthRequired
        }
        let clientLeaf = verifyClientChain(&clientAnchors, &chain, nowMillis)?
        let cvMessage = (await self.nextHandshake())?
        if cvMessage.typ != certificateVerifyType {
            fail Error.UnexpectedMessage("expected client CertificateVerify, got handshake type ${cvMessage.typ}")
        }
        let cv = parseCertificateVerify(cvMessage.body)?
        verifyClientCertificateVerify(&clientLeaf, cv.scheme, cv.signature, sha256.sum(clientTranscript))?
        clientTranscript = clientTranscript.concat(cvMessage.raw)
    }

    // The client Finished is protected with the client handshake keys, so a
    // forged or replayed one fails the AEAD tag or this constant-time check.
    let clientFinished = (await self.nextHandshake())?
    if clientFinished.typ != finishedType {
        fail Error.UnexpectedMessage("expected Finished, got handshake type ${clientFinished.typ}")
    }
    let claimed = parseFinished(clientFinished.body)?
    let expected = finishedVerifyData(&self.readKeys.secret, sha256.sum(clientTranscript))?
    if !unsafe {
        expected.ctEqPublic(&claimed).declassify()
    } {
        fail Error.BadFinished
    }
    clientTranscript = clientTranscript.concat(clientFinished.raw)

    let application = match deriveApplication(&secrets.master, applicationTranscript) {
        Ok(value) -> value
        Err(e) -> fail e
    }
    self.readKeys = move application.client
    self.writeKeys = move application.server
    self.readSeq = 0
    self.writeSeq = 0
    self.established = true

    let resumption = deriveResumptionMaster(&secrets.master, sha256.sum(clientTranscript))?
    self.resumptionMaster = resumption.copy()
    self.resumptionTranscript = sha256.sum(clientTranscript)

    if ticketCount > 0 {
        let lifetimeSeconds = (ticketLifetimeMillis / 1000).toU32() || 0
        if lifetimeSeconds == 0 {
            fail Error.Unsupported("ticket lifetime must be at least one second")
        }
        let earlyForTicket = if maxEarlyData > 0 {
            maxEarlyData.toU32() || 0
        } else {
            0
        }
        let mut issued: usize = 0
        for issued < ticketCount {
            let ticketBytes = match randomFn(32) {
                Ok(value) -> value
                Err(e) -> fail Error.Random(e.message())
            }
            let nonce = match randomFn(8) {
                Ok(value) -> value
                Err(e) -> fail Error.Random(e.message())
            }
            let ageRandom = match randomFn(4) {
                Ok(value) -> value
                Err(e) -> fail Error.Random(e.message())
            }
            let ageAdd = binary.u32Be(ageRandom, 0) || 0
            let pskBuffer = resumptionPsk(&resumption, nonce)?
            let psk = match sec.SecretNat[4].fromBuffer(&pskBuffer) {
                Ok(value) -> value
                Err(_) -> fail Error.KeySchedule("resumption PSK is not 32 bytes")
            }
            match &ticketStore {
                Some(store) -> store.insert(StoredTicket {
                    ticket: ticketBytes
                    psk: psk
                    issuedAtMillis: nowMillis
                    lifetimeMillis: ticketLifetimeMillis
                    ageAdd: ageAdd
                    alpn: self.negotiatedProtocol
                    maxEarlyData: maxEarlyData
                    used: false
                })
                None -> fail Error.Unsupported("resumption tickets need a TicketStore")
            }
            let message = newSessionTicketMessage(lifetimeSeconds, ageAdd, nonce, ticketBytes, earlyForTicket)?
            (await self.sendHandshake(message))?
            issued = issued + 1
        }
    }
    Ok(())
}

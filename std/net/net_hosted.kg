import ffi from std/ffi
import platform from std/platform

extern(C) {
    fn getaddrinfo(host: *const u8, port: *const u8, hints: *const AddrInfo, out: *mut PtrBox) -> i32
    fn freeaddrinfo(res: *const u8)
    fn socket(family: i32, socktype: i32, protocol: i32) -> i32
    fn connect(fd: i32, addr: *const u8, len: u32) -> i32
    fn bind(fd: i32, addr: *const u8, len: u32) -> i32
    fn listen(fd: i32, backlog: i32) -> i32
    fn accept(fd: i32, addr: *mut u8, len: *mut u32) -> i32
    fn setsockopt(fd: i32, level: i32, name: i32, value: *const OptBox, len: u32) -> i32
    fn setsockopt(fd: i32, level: i32, name: i32, value: *const Timeval, len: u32) -> i32
    fn getsockopt(fd: i32, level: i32, name: i32, value: *mut OptBox, len: *mut LenBox) -> i32
    fn getsockname(fd: i32, addr: *mut SockAddrIn, len: *mut LenBox) -> i32
    fn close(fd: i32) -> i32
    fn read(fd: i32, buf: *mut u8, n: usize) -> isize
    fn send(fd: i32, buf: *const u8, n: usize, flags: i32) -> isize
    fn poll(fds: *mut u8, n: usize, timeout: i32) -> i32
    fn fcntl(fd: i32, cmd: i32, ...) -> i32
    fn malloc(n: usize) -> *mut u8
    fn free(p: *mut u8)
    fn ntohs(v: u16) -> u16
}

// struct sockaddr_in (IPv4) as every target in addrinfo_*.kg lays it out;
// only Listener.port reads it, to learn the port after binding to 0.
type SockAddrIn layout(C) = {
    pub family u16
    pub port u16
    pub addr u32
    pub zero u64
}

// setsockopt/getsockname take a plain scalar in or out; ffi.CValue[T]
// needs T's own layout(C) record, so scalars go through one-field boxes.
type OptBox layout(C) = {
    pub v i32
}

type LenBox layout(C) = {
    pub v u32
}

// getaddrinfo's out-param (struct addrinfo**) as a one-field box, so
// ffi.CValue sizes the slot to the target's real pointer width instead
// of a hardcoded byte count.
type PtrBox layout(C) = {
    pub v *const u8
}

// poll(2)'s struct pollfd, matching std/shell's copy field for field.
type Pollfd layout(C) = {
    pub fd i32
    pub events i16
    pub revents i16
}

type Failure = {
    text String
}

fn Failure.message(self) -> String {
    self.text
}

fn fails(text: String) -> Failure {
    Failure { text: text }
}

// getaddrinfo reports failure through its own EAI_* code space, not errno,
// so its text comes from gaiText rather than ffi.lastError().
fn gaiFails(code: i32) -> Failure {
    fails("cannot resolve host: ${gaiText(code)}")
}

fn pollFdPtr(buf: *mut u8) -> *mut Pollfd {
    unsafe {
        ffi.toMut(ffi.cast[Pollfd](ffi.toConst(buf)))
    }
}

// connectSocket connects s to addr, bounding the wait to timeoutSeconds
// with a non-blocking connect() plus poll(2) for POLLOUT, then restores
// s's original blocking mode; timeoutSeconds <= 0 keeps a plain blocking
// connect() (Net.connect makes no timeout promise, so it passes 0). Every
// failure path reports the errno connect() (or SO_ERROR) actually left
// behind, and poll's EINTR is retried rather than surfaced as a failure.
fn connectSocket(s: i32, addr: *const u8, addrlen: u32, timeoutSeconds: i32) -> Void! {
    if timeoutSeconds <= 0 {
        if unsafe {
            connect(s, addr, addrlen)
        } != 0 {
            fail ffi.lastError()
        }
    } else {
        let flags = unsafe {
            fcntl(s, fcntlGetFl())
        }
        _ = unsafe {
            fcntl(s, fcntlSetFl(), flags | oNonBlock())
        }
        let rc = unsafe {
            connect(s, addr, addrlen)
        }
        let code = if rc == 0 {
            0
        } else {
            ffi.errno()
        }
        let pending = code == platform.einprogress() || code == platform.eintr()
        let outcome = if code == 0 {
            0
        } else if !pending {
            code
        } else {
            let pbuf = unsafe {
                malloc(8)
            }
            let mut ready = false
            for true {
                unsafe {
                    ffi.writeRecord(pollFdPtr(pbuf), &Pollfd {
                        fd: s
                        events: pollOut()
                        revents: 0
                    })
                }
                let r = unsafe {
                    poll(pbuf, 1, timeoutSeconds * 1000)
                }
                if r < 0 {
                    if ffi.errno() == platform.eintr() {
                        continue
                    }
                    break
                }
                ready = r > 0
                break
            }
            unsafe {
                free(pbuf)
            }
            if ready {
                connectSucceeded(s)
            } else {
                -1
            }
        }
        _ = unsafe {
            fcntl(s, fcntlSetFl(), flags)
        }
        if outcome > 0 {
            fail ffi.CError {
                code: outcome
                text: ffi.errorText(outcome)
            }
        }
        if outcome < 0 {
            fail fails("connect timed out")
        }
    }
}

// connectSucceeded reads SO_ERROR on a socket a poll(2) just reported
// ready for writing: 0 means connect() finished, anything else is the
// errno connect() would have failed with.
fn connectSucceeded(s: i32) -> i32 {
    let errRaw = OptBox { v: 0 }
    let errLen = ffi.sizeOf(&errRaw).toU32() || 0
    let errBoxed = ffi.CValue.new(errRaw)
    let lenBoxed = ffi.CValue.new(LenBox { v: errLen })
    _ = unsafe {
        getsockopt(s, solSocket(), soError(), errBoxed.ptr(), lenBoxed.ptr())
    }
    errBoxed.get().v
}

// connectTo resolves host:port and connects to the first address that
// accepts, bounding each attempt to timeoutSeconds (0 for unbounded).
fn connectTo(host: String, port: String, timeoutSeconds: i32) -> i32! {
    let h = ffi.CString.new(&host)?
    let p = ffi.CString.new(&port)?
    let hints = ffi.CValue.new(AddrInfo {
        flags: 0
        family: 0
        socktype: 1
        protocol: 0
        addrlen: 0
        addr: ffi.null[u8]()
        canonname: ffi.null[u8]()
        next: ffi.null[u8]()
    })
    let slot = ffi.CValue.new(PtrBox { v: ffi.null[u8]() })
    let gaiCode = unsafe {
        getaddrinfo(h.ptr(), p.ptr(), ffi.toConst(hints.ptr()), slot.ptr())
    }
    if gaiCode != 0 {
        fail gaiFails(gaiCode)
    }
    let head = slot.get().v
    let mut cur = head
    let mut fd: i32 = -1
    let mut lastErr = fails("cannot connect")
    for !ffi.isNull(cur) && fd < 0 {
        let ai = unsafe {
            ffi.readRecord(ffi.cast[AddrInfo](cur))
        }
        let s = unsafe {
            socket(ai.family, ai.socktype, ai.protocol)
        }
        if s >= 0 {
            let attempt = connectSocket(s, ai.addr, ai.addrlen, timeoutSeconds)
            if attempt is Err(e) {
                lastErr = fails(e.message())
                _ = unsafe {
                    close(s)
                }
            } else {
                fd = s
            }
        } else {
            lastErr = fails(ffi.lastError().message())
        }
        cur = ai.next
    }
    unsafe {
        freeaddrinfo(head)
    }
    if fd < 0 {
        fail lastErr
    }
    fd
}

fn sendAll(fd: i32, data: Bytes) -> Void! {
    let n = data.len()
    let mut off: usize = 0
    for off < n {
        let w = unsafe {
            send(fd, ffi.offset(ffi.bytesPtr(&data), off.toInt() || 0), n - off, msgNoSignal())
        }
        if w <= 0 {
            if w < 0 && ffi.errno() == platform.eintr() {
                continue
            }
            fail ffi.lastError()
        }
        off = off + (w.toUsize() || 0)
    }
}

// readLine stops at LF, EOF or 64 bytes; a real read error (including a timeout
// once setTimeout has armed SO_RCVTIMEO) fails. The line stays bytes: a Latin-1 or cut reason phrase must not fail a POST that took effect.
fn readLine(fd: i32) -> Bytes! {
    let buf = unsafe {
        malloc(1)
    }
    let mut acc = "".toBytes()
    for acc.len() < 64 {
        let got = unsafe {
            read(fd, buf, 1)
        }
        if got < 0 {
            if ffi.errno() == platform.eintr() {
                continue
            }
            unsafe {
                free(buf)
            }
            fail ffi.lastError()
        }
        if got == 0 || unsafe {
            ffi.readU8(ffi.toConst(buf))
        } == 10 {
            break
        }
        acc = acc.concat(unsafe {
            ffi.bytesFrom(ffi.toConst(buf), 1)
        })
    }
    unsafe {
        free(buf)
    }
    acc
}

// setTimeout bounds send/recv on fd so a peer that accepts a connection
// but never answers cannot hang the caller forever; the connect() phase
// is bounded separately, by connectSocket's poll(2) (SO_SNDTIMEO set
// before connect() is not a portable connect timeout on its own).
fn setTimeout(fd: i32, seconds: i32) {
    let raw = timeoutValue(seconds)
    let len = ffi.sizeOf(&raw).toU32() || 0
    let boxed = ffi.CValue.new(raw)
    _ = unsafe {
        setsockopt(fd, solSocket(), soRcvTimeo(), ffi.toConst(boxed.ptr()), len)
    }
    _ = unsafe {
        setsockopt(fd, solSocket(), soSndTimeo(), ffi.toConst(boxed.ptr()), len)
    }
}

fn requestTimeoutSeconds() -> i32 {
    10
}

fn hasUnsafeByte(text: String) -> Bool {
    let b = text.bytes()
    let mut i: usize = 0
    for i < b.len() {
        let c = b.get(i) || 0
        if c <= 32 || c == 127 {
            return true
        }
        i = i + 1
    }
    false
}

type HostPort = {
    host String
    header String
    port String
}

// Splits an authority (`host[:port]`, `[v6]:port`, or a rejected
// `user:pass@host`) into a resolver host, a Host-header form (brackets
// kept for IPv6), and a port.
fn parseAuthority(authority: String) -> HostPort! {
    if indexOf(authority, "@") is Some(_) {
        fail fails("userinfo in URL is not supported")
    }
    if authority.startsWith("[") {
        let i = indexOf(authority, "]") || fail fails("malformed IPv6 host")
        let host = authority.sliceBytes(1, i) || ""
        let after = authority.sliceBytes(i + 1, authority.len()) || ""
        let port = if after == "" {
            "80"
        } else if after.startsWith(":") {
            after.sliceBytes(1, after.len()) || "80"
        } else {
            fail fails("malformed IPv6 host")
        }
        return finishAuthority(host, "[${host}]", port)
    }
    let colon = indexOf(authority, ":")
    let host = if colon is Some(i) {
        authority.sliceBytes(0, i) || ""
    } else {
        authority
    }
    let port = if colon is Some(i) {
        authority.sliceBytes(i + 1, authority.len()) || "80"
    } else {
        "80"
    }
    finishAuthority(host, host, port)
}

fn validPort(port: Int) -> Bool {
    port >= 0 && port <= 65535
}

// An empty port means the default, as in RFC 3986; anything but 1 to 5
// digits within 0..65535 is refused before it can reach the resolver.
fn finishAuthority(host: String, header: String, port: String) -> HostPort! {
    if host == "" {
        fail fails("invalid URL: empty host")
    }
    if port == "" {
        return HostPort {
            host: host
            header: header
            port: "80"
        }
    }
    let digits = port.bytes()
    let mut n = 0
    for i in 0..digits.len() {
        let d = (digits.get(i) || 0).toInt()
        if d < 48 || d > 57 || i >= 5 {
            fail fails("invalid URL: bad port")
        }
        n = n * 10 + (d - 48)
    }
    if !validPort(n) {
        fail fails("invalid URL: bad port")
    }
    HostPort {
        host: host
        header: header
        port: port
    }
}

fn indexOf(text: String, sub: String) -> usize? {
    let mut i: usize = 0
    for i + sub.len() <= text.len() {
        if text.matchesAt(sub, i) {
            return Some(i)
        }
        i = i + 1
    }
    None
}

fn statusOf(line: Bytes) -> Int? {
    // "HTTP/1.1 200 OK": the status is the second space-separated word, exactly three digits.
    let prefix = "HTTP/".bytes()
    if line.len() < prefix.len() {
        return None
    }
    for i in 0..prefix.len() {
        if (line.get(i) || 0) != (prefix.get(i) || 0) {
            return None
        }
    }
    let mut space: usize = 0
    for space < line.len() && (line.get(space) || 0) != 32 {
        space = space + 1
    }
    if space + 4 > line.len() {
        return None
    }
    if space + 4 < line.len() && (line.get(space + 4) || 0) != 32 {
        return None
    }
    let mut n = 0
    for i in 1..4 {
        let d = (line.get(space + i) || 0).toInt()
        if d < 48 || d > 57 {
            return None
        }
        n = n * 10 + (d - 48)
    }
    Some(n)
}

/// TCP connection; `read`/`write` match std/io's Reader/Writer shape.
/// Safety: the handle names one socket and moving it to another thread transfers that one owner.
@unsafeGuarantee(Send)
pub type Conn = resource {
    fd i32
}

/// TCP listening socket, from `Net.listen`.
/// Safety: the handle names one listening socket and moving it transfers that one owner.
@unsafeGuarantee(Send)
pub type Listener = resource {
    fd i32
}

/// Connects to host:port over IPv4, refusing a port outside 0..65535; no timeout; this
/// call blocks until the OS gives up or a peer answers).
pub fn Net.connect(self, host: String, port: Int) -> Conn! {
    if !validPort(port) {
        fail fails("port must be between 0 and 65535")
    }
    let fd = connectTo(host, "${port}", 0)?
    Conn { fd: fd }
}

/// Binds host:port (SO_REUSEADDR set) and starts listening; a modest,
/// fixed backlog, matching the rest of std/net's lack of tuning knobs.
/// family is forced to AF_INET (2) so SockAddrIn's fixed layout matches
/// what the kernel later hands back from getsockname.
pub fn Net.listen(self, host: String, port: Int) -> Listener! {
    if !validPort(port) {
        fail fails("port must be between 0 and 65535")
    }
    // An empty host means "every interface", matching internal/backend/vm/host/net.Listen.
    let host = if host == "" {
        "0.0.0.0"
    } else {
        host
    }
    let portStr = "${port}"
    let h = ffi.CString.new(&host)?
    let p = ffi.CString.new(&portStr)?
    let hints = ffi.CValue.new(AddrInfo {
        flags: 0
        family: 2
        socktype: 1
        protocol: 0
        addrlen: 0
        addr: ffi.null[u8]()
        canonname: ffi.null[u8]()
        next: ffi.null[u8]()
    })
    let slot = ffi.CValue.new(PtrBox { v: ffi.null[u8]() })
    let gaiCode = unsafe {
        getaddrinfo(h.ptr(), p.ptr(), ffi.toConst(hints.ptr()), slot.ptr())
    }
    if gaiCode != 0 {
        fail gaiFails(gaiCode)
    }
    let head = slot.get().v
    if ffi.isNull(head) {
        fail fails("cannot resolve host")
    }
    let ai = unsafe {
        ffi.readRecord(ffi.cast[AddrInfo](head))
    }
    let fd = unsafe {
        socket(ai.family, ai.socktype, ai.protocol)
    }
    if fd < 0 {
        let err = ffi.lastError()
        unsafe {
            freeaddrinfo(head)
        }
        fail err
    }
    let optRaw = OptBox { v: 1 }
    let optLen = ffi.sizeOf(&optRaw).toU32() || 0
    let opt = ffi.CValue.new(optRaw)
    _ = unsafe {
        setsockopt(fd, solSocket(), soReuseAddr(), ffi.toConst(opt.ptr()), optLen)
    }
    let bound = unsafe {
        bind(fd, ai.addr, ai.addrlen)
    } == 0
    if !bound {
        let err = ffi.lastError()
        unsafe {
            freeaddrinfo(head)
        }
        _ = unsafe {
            close(fd)
        }
        fail err
    }
    unsafe {
        freeaddrinfo(head)
    }
    if unsafe {
        listen(fd, 16)
    } != 0 {
        let err = ffi.lastError()
        _ = unsafe {
            close(fd)
        }
        fail err
    }
    Listener { fd: fd }
}

/// Accepts the next incoming connection, blocking until one arrives.
pub fn Listener.accept(mut self) -> Conn! {
    let mut fd: i32 = -1
    for fd < 0 {
        fd = unsafe {
            accept(self.fd, ffi.toMut(ffi.null[u8]()), ffi.toMut(ffi.null[u32]()))
        }
        if fd < 0 && ffi.errno() != platform.eintr() {
            fail ffi.lastError()
        }
    }
    Conn { fd: fd }
}

/// The local port bound, or 0 when it cannot be read; lets a caller bind
/// port 0 and learn which port the OS picked.
pub fn Listener.port(self) -> Int {
    let blank = SockAddrIn {
        family: 0
        port: 0
        addr: 0
        zero: 0
    }
    let length = ffi.sizeOf(&blank).toU32() || 0
    let addr = ffi.CValue.new(blank)
    let lenBox = ffi.CValue.new(LenBox { v: length })
    if unsafe {
        getsockname(self.fd, addr.ptr(), lenBox.ptr())
    } != 0 {
        return 0
    }
    (unsafe {
        ntohs(addr.get().port)
    }).toInt()
}

/// Reads up to max bytes into into; 0 with no error is end of input,
/// matching std/io's Reader (POSIX read semantics).
pub fn Conn.read(mut self, into: &mut Array[u8], max: usize) -> usize! {
    if max == 0 {
        return 0
    }
    let buf = unsafe {
        malloc(max)
    }
    if ffi.isNull(ffi.toConst(buf)) {
        fail fails("out of memory")
    }
    let mut got: isize = -1
    for got < 0 {
        got = unsafe {
            read(self.fd, buf, max)
        }
        if got < 0 && ffi.errno() != platform.eintr() {
            unsafe {
                free(buf)
            }
            fail ffi.lastError()
        }
    }
    let n = got.toUsize() || 0
    let data = unsafe {
        ffi.bytesFrom(ffi.toConst(buf), n)
    }
    unsafe {
        free(buf)
    }
    let mut i: usize = 0
    for i < n {
        into.push(data.get(i) || 0)
        i = i + 1
    }
    n
}

/// Writes data; may send fewer bytes than given, matching send(2) and
/// std/io's Writer (writeAll loops for the rest).
pub fn Conn.write(mut self, data: Bytes) -> usize! {
    let n = data.len()
    if n == 0 {
        return 0
    }
    let mut w: isize = -1
    for w < 0 {
        w = unsafe {
            send(self.fd, ffi.bytesPtr(&data), n, msgNoSignal())
        }
        if w < 0 && ffi.errno() != platform.eintr() {
            fail ffi.lastError()
        }
    }
    w.toUsize() || 0
}

// setNonBlocking is idempotent, so each try* call can make sure of the mode
// without the Conn or Listener having to remember it.
fn setNonBlocking(fd: i32) -> Void! {
    let flags = unsafe {
        fcntl(fd, fcntlGetFl())
    }
    if flags < 0 {
        fail ffi.lastError()
    }
    if (flags & oNonBlock()) == 0 && unsafe {
        fcntl(fd, fcntlSetFl(), flags | oNonBlock())
    } < 0 {
        fail ffi.lastError()
    }
}

/// Accepts a waiting connection without blocking, or None when none is
/// waiting; the listener and the accepted connection stay non-blocking.
pub fn Listener.pollAccept(mut self) -> Conn?! {
    setNonBlocking(self.fd)?
    for true {
        let fd = unsafe {
            accept(self.fd, ffi.toMut(ffi.null[u8]()), ffi.toMut(ffi.null[u32]()))
        }
        if fd >= 0 {
            let conn = Conn { fd: fd }
            setNonBlocking(fd)?
            return Some(conn)
        }
        let code = ffi.errno()
        if code == platform.eagain() {
            return None
        }
        if code != platform.eintr() {
            fail ffi.lastError()
        }
    }
    None
}

/// Reads like `read` without blocking, or None when no input is ready yet;
/// Some(0) is end of input. The connection stays non-blocking.
pub fn Conn.pollRead(mut self, into: &mut Array[u8], max: usize) -> usize?! {
    if max == 0 {
        return Some(0)
    }
    setNonBlocking(self.fd)?
    let buf = unsafe {
        malloc(max)
    }
    if ffi.isNull(ffi.toConst(buf)) {
        fail fails("out of memory")
    }
    let mut got: isize = -1
    for got < 0 {
        got = unsafe {
            read(self.fd, buf, max)
        }
        if got < 0 {
            let code = ffi.errno()
            if code == platform.eagain() {
                unsafe {
                    free(buf)
                }
                return None
            }
            if code != platform.eintr() {
                unsafe {
                    free(buf)
                }
                fail ffi.lastError()
            }
        }
    }
    let n = got.toUsize() || 0
    let data = unsafe {
        ffi.bytesFrom(ffi.toConst(buf), n)
    }
    unsafe {
        free(buf)
    }
    let mut i: usize = 0
    for i < n {
        into.push(data.get(i) || 0)
        i = i + 1
    }
    Some(n)
}

/// Writes like `write` without blocking, or None when the send buffer is
/// full. The connection stays non-blocking.
pub fn Conn.pollWrite(mut self, data: Bytes) -> usize?! {
    let n = data.len()
    if n == 0 {
        return Some(0)
    }
    setNonBlocking(self.fd)?
    for true {
        let w = unsafe {
            send(self.fd, ffi.bytesPtr(&data), n, msgNoSignal())
        }
        if w >= 0 {
            return Some(w.toUsize() || 0)
        }
        let code = ffi.errno()
        if code == platform.eagain() {
            return None
        }
        if code != platform.eintr() {
            fail ffi.lastError()
        }
    }
    None
}

/// Nothing to flush for a socket; the drop closes it, as File.close's does.
pub fn Conn.close(move self) -> Void! {}

/// Closes the connection when it goes out of scope, ignoring errors.
///
/// Bodiless unlike File.drop: the VM runs a resource's real lowered body
/// on an implicit drop even when an accelerator exists for it, so a body
/// here would hit the unsupported extern(C) close on the first Conn ever
/// dropped without an explicit close().
pub fn Conn.drop(move self)

/// Closes the listening socket when it goes out of scope, ignoring errors;
/// see Conn.drop for why this is bodiless.
pub fn Listener.drop(move self)

fn crlf() -> Bytes {
    "\r\n".toBytes()
}

fn isTokenByte(c: u8) -> Bool {
    let d = c.toInt()
    if (d >= 48 && d <= 57) || (d >= 65 && d <= 90) || (d >= 97 && d <= 122) {
        return true
    }
    "!#$%&'*+-.^_`|~".bytes().contains(Bytes.fill(c, 1))
}

fn isToken(text: String) -> Bool {
    let b = text.bytes()
    if b.len() == 0 {
        return false
    }
    for i in 0..b.len() {
        if !isTokenByte(b.get(i) || 0) {
            return false
        }
    }
    true
}

// A field value may hold visible bytes, spaces and tabs, but no other control byte.
fn isFieldValue(text: String) -> Bool {
    let b = text.bytes()
    for i in 0..b.len() {
        let c = (b.get(i) || 0).toInt()
        if (c < 32 && c != 9) || c == 127 {
            return false
        }
    }
    true
}

fn isAscii(text: String) -> Bool {
    let b = text.bytes()
    for i in 0..b.len() {
        if (b.get(i) || 0) >= 128 {
            return false
        }
    }
    true
}

fn hasControlOrSpace(text: String) -> Bool {
    let b = text.bytes()
    for i in 0..b.len() {
        let c = (b.get(i) || 0).toInt()
        if c <= 32 || c == 127 {
            return true
        }
    }
    false
}

// validHost checks the RFC 9112 Host grammar: an IPv4/reg-name or a bracketed
// IPv6 literal, optionally followed by a decimal port.
fn validHost(v: String) -> Bool {
    if v.len() == 0 || hasControlOrSpace(v) {
        return false
    }
    if v.startsWith("[") {
        let close = indexOfByte(v, 93) || return false
        if close <= 1 {
            return false
        }
        let inner = v.sliceBytes(1, close) || ""
        if !validIpv6(inner) {
            return false
        }
        let after = v.sliceBytes(close + 1, v.len()) || ""
        if after == "" {
            return true
        }
        if !after.startsWith(":") {
            return false
        }
        return validPort(after.sliceBytes(1, after.len()) || "")
    }
    let colon = indexOfByte(v, 58)
    let host = if colon is Some(i) {
        v.sliceBytes(0, i) || ""
    } else {
        v
    }
    if host == "" {
        return false
    }
    for i in 0..host.len() {
        let c = host[i]
        if c <= 32 || c >= 127 || c == 47 || c == 92 || c == 64 || c == 91 || c == 93 || c == 35 || c == 63 || c == 58 {
            return false
        }
    }
    if colon is Some(i) {
        return validPort(v.sliceBytes(i + 1, v.len()) || "")
    }
    true
}

fn validPort(text: String) -> Bool {
    match parseDecimal(text) {
        Some(p) -> p <= 65535
        None -> false
    }
}

fn parseDecimal(text: String) -> usize? {
    let b = text.bytes()
    if b.len() == 0 {
        return None
    }
    let mut start: usize = 0
    for start + 1 < b.len() && (b.get(start) || 0) == 48 {
        start = start + 1
    }
    if b.len() - start > 15 {
        return None
    }
    let mut n: usize = 0
    for i in start..b.len() {
        let d = b.get(i) || 0
        if d < 48 || d > 57 {
            return None
        }
        n = n * 10 + (d - 48).toUsize()
    }
    Some(n)
}

fn parseHex(text: String) -> usize? {
    let b = text.bytes()
    if b.len() == 0 || b.len() > 12 {
        return None
    }
    let mut n: usize = 0
    for i in 0..b.len() {
        let v = hexValue(b.get(i) || 0) || return None
        n = n * 16 + (v.toUsize() || 0)
    }
    Some(n)
}

fn noBodyStatus(status: Int) -> Bool {
    (status >= 100 && status < 200) || status == 204 || status == 205 || status == 304
}

// renderHead writes a head line and its fields; Content-Length, Transfer-Encoding
// and Connection are the caller's to set, so stale copies of them are dropped.
// keepAlive asks for `Connection: keep-alive`, which an HTTP/1.0 peer needs to
// know the connection stays open (RFC 9112 6.3).
fn renderHead(first: String, headers: &Headers, bodyLen: usize?, close: Bool, keepAlive: Bool) -> Bytes! {
    let mut out = "${first}\r\n"
    for h in &headers.items {
        if !isToken(h.name) || !isFieldValue(h.value) {
            fail failure(500, "invalid header field ${h.name}")
        }
        let key = h.name.toLower()
        if key == "content-length" || key == "transfer-encoding" || key == "connection" {
            continue
        }
        out = "${out}${h.name}: ${h.value}\r\n"
    }
    if bodyLen is Some(n) {
        out = "${out}Content-Length: ${n}\r\n"
    }
    if close {
        out = "${out}Connection: close\r\n"
    } else if keepAlive {
        out = "${out}Connection: keep-alive\r\n"
    }
    "${out}\r\n".toBytes()
}

// wantsClose reads the Connection field: HTTP/1.1 stays open unless it says close,
// while HTTP/1.0 stays open only when it explicitly asks for keep-alive.
fn wantsClose(headers: &Headers, version: String) -> Bool {
    if connectionHas(headers, "close") {
        return true
    }
    version != "HTTP/1.1" && !connectionHas(headers, "keep-alive")
}

fn connectionHas(headers: &Headers, option: String) -> Bool {
    for v in headers.all("Connection") {
        for part in v.split(",") {
            if part.trim().toLower() == option {
                return true
            }
        }
    }
    false
}

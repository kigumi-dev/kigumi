import gzip from std/compress/gzip
import zlib from std/compress/zlib

// A response, its version and how its body was delimited.
type Received = {
    response Response
    version String
    framing Framing
    desynced Bool
}

fn Framing.carriesBody(self) -> Bool {
    match self {
        NoBody -> false
        Sized(n) -> n > 0
        _ -> true
    }
}

fn maxResponseFields() -> usize {
    1000
}

// How a response body is delimited and whether the bytes after the head still belong to this response.
type Decision = {
    framing Framing
    desynced Bool
}

// Message framing of a response (RFC 9112 6.3): fields are validated even without a body, except
// after a 101; a 204 announcing a body, like a 101, leaves the connection unusable.
fn responseFraming(headers: &Headers, status: Int, headOnly: Bool) -> Decision! {
    if status == 101 {
        return Decision {
            framing: NoBody
            desynced: true
        }
    }
    let announced = match framingOf(headers, false) {
        Ok(framing) -> framing
        Err(e) -> fail MalformedResponse(e.message())
    }
    let announcesBody = match announced {
        Sized(n) -> n > 0
        Chunked -> true
        _ -> false
    }
    let bodiless = headOnly || status == 101 || status == 204 || status == 304
    Decision {
        framing: if bodiless {
            NoBody
        } else {
            announced
        }
        desynced: status == 204 && announcesBody
    }
}

// Each decoder's message already names its format, so it is not prefixed with the coding again.
fn undoCoding(coding: String, body: Bytes, maxBody: usize) -> Bytes! {
    let decoded = match coding {
        "identity" -> return body
        "gzip" | "x-gzip" -> gzip.decodeLimit(body, maxBody)
        "deflate" -> zlib.decodeLimit(body, maxBody)
        other -> fail MalformedResponse("unsupported content-encoding `${other}`")
    }
    match decoded {
        Ok(out) -> out
        Err(e) -> fail MalformedResponse(e.message())
    }
}

// decodeBody undoes every Content-Encoding coding, last applied first; a response without a body has nothing to decode,
// and a 206 holds a range of the encoded representation.
fn decodeBody(headers: &Headers, status: Int, framing: Framing, body: Bytes, maxBody: usize) -> Bytes! {
    if status == 206 || !framing.carriesBody() || body.len() == 0 {
        return body
    }
    let mut codings = Array.empty[String]()
    for line in headers.all("Content-Encoding") {
        for part in line.split(",") {
            let coding = part.trim().toLower()
            if coding != "" {
                codings.push(coding)
            }
        }
    }
    let mut out = body
    let mut i = codings.len()
    for i > 0 {
        i = i - 1
        out = undoCoding(codings.get(i) || "", out, maxBody)?
    }
    out
}

async fn Wire.readResponse(mut self, headOnly: Bool, timeout: i64, maxBody: usize, maxHead: usize) -> Received! {
    let deadline = deadlineIn(timeout)
    let mut scanned: usize = 0
    for true {
        let found = match headEnd(&self.pending, scanned) {
            Ok(at) -> at
            Err(e) -> fail MalformedResponse(e.message())
        }
        if found is Some(end) {
            if end > maxHead {
                fail MalformedResponse("head too large")
            }
            let head = match parseHead(self.consume(end), maxResponseFields(), ResponseHead) {
                Ok(h) -> h
                Err(e) -> fail MalformedResponse(e.message())
            }
            scanned = 0
            let version = if (head.first.split(" ").get(0) || "") == "HTTP/1.0" {
                "HTTP/1.0"
            } else {
                "HTTP/1.1"
            }
            let status = statusOf(head.first) || fail MalformedResponse("bad status line")
            if status < 200 && status != 101 {
                continue
            }
            let decision = responseFraming(&head.headers, status, headOnly)?
            let framing = decision.framing
            let rawBody = (await self.responseBody(framing, deadline, maxBody, maxHead))?
            let body = decodeBody(&head.headers, status, framing, rawBody, maxBody)?
            let mut resp = Response.new(status)
            resp.headers = move head.headers
            resp.body = body
            return Received {
                response: resp
                version: version
                framing: framing
                desynced: decision.desynced
            }
        }
        if self.pending.len() > maxHead {
            fail MalformedResponse("head too large")
        }
        scanned = self.pending.len()
        match (await self.fill(deadline, Shutdown.new()))? {
            Got -> {}
            Expired -> fail TimedOut
            _ -> fail Closed
        }
    }
    fail TimedOut
}

async fn Wire.responseBody(mut self, framing: Framing, deadline: Deadline, maxBody: usize, maxHead: usize) -> Bytes! {
    let mut d = Dechunker.new(ResponseHead, maxResponseFields(), maxHead)
    let mut raw: usize = 0
    for true {
        let ready = match framing {
            NoBody -> return "".toBytes()
            Sized(n) -> {
                if n > maxBody {
                    fail MalformedResponse("body too large")
                }
                if self.pending.len() >= n {
                    return self.consume(n)
                }
                false
            }
            Chunked -> {
                let used = match d.step(&self.pending, maxBody) {
                    Ok(n) -> n
                    Err(e) -> fail MalformedResponse(e.message())
                }
                raw = raw + used
                _ = self.consume(used)
                if d.done() {
                    return d.body()
                }
                if raw.saturatingAdd(self.pending.len()) > rawCap(maxBody, 65536) {
                    fail MalformedResponse("body too large")
                }
                false
            }
            UntilClose -> {
                if self.pending.len() > maxBody {
                    fail MalformedResponse("body too large")
                }
                false
            }
        }
        match (await self.fill(deadline, Shutdown.new()))? {
            Got -> {}
            Eof -> {
                if framing is UntilClose {
                    return self.consume(self.pending.len())
                }
                fail MalformedResponse("body cut short")
            }
            _ -> fail TimedOut
        }
    }
    "".toBytes()
}

fn statusOf(line: String) -> Int? {
    let parts = line.split(" ")
    let version = parts.get(0) || ""
    if parts.len() < 2 || !version.startsWith("HTTP/1.") {
        return None
    }
    let code = parts.get(1) || ""
    if code.len() != 3 {
        return None
    }
    let n = parseDecimal(code) || return None
    if n < 100 || n > 599 {
        return None
    }
    n.toInt()
}

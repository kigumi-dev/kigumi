import fs from std/fs
import net from std/net
import shell from std/shell

/// The process environment and working directory; `host` is the predeclared instance in the entry file.
/// Its mutating methods (`chdir`, `setEnv`, `unsetEnv`) change process-wide state that later
/// cells and child processes inherit, so callers coordinate those effects themselves.
/// Safety: a stateless capability marker; it owns nothing, so sharing or duplicating it is free
/// (the process-wide calls it exposes may still race each other).
@unsafeGuarantee(Copy, Send, Sync)
pub type Host

/// Command line arguments; index 0 is the program path.
/// Safety: a read-only view of the process argv; duplicating or sharing it touches nothing.
@unsafeGuarantee(Copy, Send, Sync)
pub type Args

/// Shell for running external commands.
pub fn Host.shell(self) -> shell.Shell

/// Command line arguments of the process.
pub fn Host.args(self) -> Args

/// Argument at index, or None when there are fewer arguments or it is not valid UTF-8;
/// `getOsString` keeps every argument and tells the two cases apart.
pub pure noalloc fn Args.get(self, index: usize) -> String?

pure fn Args.getBytes(self, index: usize) -> Bytes?

/// Argument at index exactly as the OS passed it, valid UTF-8 or not; None only when
/// there are fewer arguments. A native argv cannot hold NUL, so the value never does there.
pub pure fn Args.getOsString(self, index: usize) -> OsString? {
    match self.getBytes(index) {
        Some(bytes) -> Some(OsString.fromUnixBytes(bytes))
        None -> None
    }
}

/// Value of the environment variable name exactly as the OS holds it,
/// valid UTF-8 or not; None only when it is unset or name contains NUL.
pub fn Host.envOsString(self, name: String) -> OsString? {
    match self.envBytes(name) {
        Some(bytes) -> Some(OsString.fromUnixBytes(bytes))
        None -> None
    }
}

/// File system access.
pub fn Host.files(self) -> fs.Files

/// Network access.
pub fn Host.net(self) -> net.Net

/// Standard input of the process, obtained from `host.stdin()`.
/// Safety: holds no state of its own; it may be handed off to one other thread at a time (reads through a shared reference are not coordinated, so Sync is not claimed).
@unsafeGuarantee(Send)
pub type Stdin

/// Standard input.
pub fn Host.stdin(self) -> Stdin

/// Number of arguments, the program path included.
pub pure noalloc fn Args.len(self) -> usize

/// Standard output of the process, obtained from `host.stdout()`.
/// Safety: holds no state of its own; it may be handed off to one other thread at a time (writes through a shared reference are not coordinated, so Sync is not claimed).
@unsafeGuarantee(Send)
pub type Stdout

/// Standard output.
pub fn Host.stdout(self) -> Stdout

/// Standard error of the process, obtained from `host.stderr()`.
/// Safety: holds no state of its own; it may be handed off to one other thread at a time (writes through a shared reference are not coordinated, so Sync is not claimed).
@unsafeGuarantee(Send)
pub type Stderr

/// Standard error.
pub fn Host.stderr(self) -> Stderr

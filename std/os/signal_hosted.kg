import ffi from std/ffi

/// OS signals the process can watch for.
pub type Signal = Interrupt | Terminate | WindowChange

// Signal's wire value for rt_sys_signal_*; rt_signal_hosted.c maps it to the
// platform's SIG* macro, so no signal number needs to agree with Kigumi.
fn Signal.code(self) -> i32 {
    match self {
        Interrupt -> 0
        Terminate -> 1
        WindowChange -> 2
    }
}

extern(C) {
    fn rt_sys_signal_watch(which: i32) -> i32
    fn rt_sys_signal_unwatch(which: i32) -> i32
    fn rt_sys_signal_pending(which: i32) -> i32
}

/// Signal delivery, obtained from `host.signals()`.
/// Safety: a stateless capability marker; every call it makes targets process-wide signal state, so sharing or duplicating the handle is free.
@unsafeGuarantee(Copy, Send, Sync)
pub type Signals

/// A live watch on one signal: it owns the disposition `watch` installed, so
/// a delivery only sets the pending flag until the guard is dropped.
/// Safety: the runtime keeps one disposition per signal, so two copies of one
/// guard would restore it twice; the type is not Copy and drop restores what
/// this watch replaced.
pub type Watch = resource {
    which i32
}

/// Signal handling.
pub fn Host.signals(self) -> Signals

/// Starts watching which; a later delivery sets its pending flag until
/// `pending` reads and clears it. The C handler only sets that flag
/// (rt_signal_hosted.c), so it never re-enters this refcounted runtime. The
/// returned guard owns the watch: keep it alive while the flag matters, and
/// its drop restores the disposition `watch` replaced (the process default
/// unless something else had installed a handler).
pub fn Signals.watch(self, which: Signal) -> Watch! {
    let code = which.code()
    let r = unsafe {
        rt_sys_signal_watch(code)
    }
    if r != 0 {
        fail ffi.lastError()
    }
    Watch { which: code }
}

/// Whether which was delivered since the last call; clears the flag.
pub fn Signals.pending(self, which: Signal) -> Bool {
    unsafe {
        rt_sys_signal_pending(which.code())
    } != 0
}

/// Restores the disposition this watch replaced, so SIGINT/SIGTERM act on the
/// process again unless another watch still holds the signal.
pub fn Watch.drop(move self) {
    unsafe {
        _ = rt_sys_signal_unwatch(self.which)
    }
}

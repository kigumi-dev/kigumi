/// Ends the process; a bare target has no process to end.
pub fn Host.exit(self, code: u8) -> Never {
    panic()
}

/// Everything left on stdin; a bare target has no stdin.
pub fn Stdin.readAll(self) -> String! {
    panic()
}

/// Next line of stdin; a bare target has no stdin.
pub fn Stdin.readLine(self) -> String?! {
    panic()
}

/// Waits for stdin data; a bare target has no stdin.
pub fn Stdin.readSome(self, timeoutMs: Int) -> Bytes! {
    panic()
}

/// Reads from stdin; a bare target has no stdin.
pub fn Stdin.read(mut self, into: &mut Array[u8], max: usize) -> usize! {
    panic()
}

/// Writes to standard output; a bare target has no stdout.
pub fn Stdout.write(mut self, data: Bytes) -> usize! {
    panic()
}

/// Writes to standard error; a bare target has no stderr.
pub fn Stderr.write(mut self, data: Bytes) -> usize! {
    panic()
}

/// Value of an environment variable; a bare target has no environment.
pub fn Host.env(self, name: String) -> String? {
    panic()
}

fn Host.envBytes(self, name: String) -> Bytes? {
    panic()
}

/// Changes the process's working directory; a bare target has no file system.
pub fn Host.chdir(self, path: String) -> Void! {
    panic()
}

/// The process's working directory; a bare target has none.
pub fn Host.cwd(self) -> String {
    panic()
}

/// Sets an environment variable for this process; a bare target has no environment.
pub fn Host.setEnv(self, name: String, value: String) -> Void! {
    panic()
}

/// Removes an environment variable from this process; a bare target has no environment.
pub fn Host.unsetEnv(self, name: String) -> Void! {
    panic()
}

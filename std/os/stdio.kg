import io from std/io

/// Reads from the process's standard input.
pub context stdin: io.Reader

/// Writes to the process's standard output; `print` depends on it directly.
pub context stdout: io.Writer

/// Writes to the process's standard error; `eprint` depends on it directly.
pub context stderr: io.Writer

/// Bundles stdin, stdout and stderr for a single `context (...)` provider; the three keys stay separate requirements, so a print-only function never needs `stdin` authority.
@provides(stdin, stdout, stderr)
pub type Stdio = {
    pub mut stdin io.Reader
    pub mut stdout io.Writer
    pub mut stderr io.Writer
}

/// The host's standard streams, from `stdio.hostStdio(host)`.
pub fn hostStdio(host: Host) -> Stdio {
    Stdio {
        stdin: host.stdin()
        stdout: host.stdout()
        stderr: host.stderr()
    }
}

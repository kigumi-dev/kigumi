// FN-DSA (FIPS 206 draft) over the Falcon-512 parameter set.
//
// SCOPE (SEC-24): this package implements the Falcon-512 subset of FN-DSA:
// deterministic key generation, deterministic signing and verification.
// Key generation samples f and g, solves f*G - g*F = q over
// Z[x]/(x^512 + 1) with the recursive NTRU solver and Babai reduction, and
// emits the Falcon private-key encoding. Signing accepts that private key,
// recovers G modulo q, and samples the signature with the reference Fourier
// sampler. Verification follows the Falcon-512 encoding and norm bound.
//
// Randomness is explicit: `keyGen` expands the caller's 56-byte seed with
// SHAKE256, and `sign` expands the caller's 40-byte salt together with the
// message. Each output is a pure function of its inputs, so the VM and
// native engines produce identical keys and signatures. Verification is
// public-data-only and does not promise constant time; key generation and
// signing use secret-dependent indices and inherit the backend's timing
// behaviour.
/// A freshly generated Falcon-512 key pair in Falcon's wire encodings.
pub type KeyPair = {
    pub publicKey Bytes
    pub secretKey Bytes
}

/// The public entry point: verify a padded Falcon-512 signature.
pub pure fn verify(publicKey: Bytes, message: Bytes, signature: Bytes) -> Result[Bool, Error] {
    verifySignature(publicKey, message, signature)
}

/// Deterministically signs `message` with the 40-byte `salt`.
///
/// The signature is a pure function of the secret key, message and salt.
pub pure fn sign(secretKey: Bytes, message: Bytes, salt: Bytes) -> Result[Bytes, Error] {
    signMessage(secretKey, message, salt)
}

/// Derives the Falcon-512 public key from a secret key.
pub pure fn publicKeyOf(secretKey: Bytes) -> Result[Bytes, Error] {
    derivePublicKey(secretKey)
}

/// Generates a Falcon-512 key pair from a 56-byte seed.
pub pure fn keyGen(seed: Bytes) -> Result[KeyPair, Error] {
    generateKeyPair(seed)
}

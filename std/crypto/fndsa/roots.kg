/// FFT roots for a power-of-two transform length.
pub pure fn rootsFft(n: usize) -> Array[C] {
    match n {
        2 -> rootsFft2()
        4 -> rootsFft4()
        8 -> rootsFft8()
        16 -> rootsFft16()
        32 -> rootsFft32()
        64 -> rootsFft64()
        128 -> rootsFft128()
        256 -> rootsFft256()
        512 -> rootsFft512()
        _ -> panic("fndsa: unsupported FFT length")
    }
}

pure fn rootsZq2() -> Array[u16] {
    Array.of[u16](1479, 10810)
}

pure fn rootsZq4() -> Array[u16] {
    Array.of[u16](4043, 8246, 5146, 7143)
}

pure fn rootsZq8() -> Array[u16] {
    Array.of[u16](5736, 6553, 4134, 8155, 722, 11567, 1305, 10984)
}


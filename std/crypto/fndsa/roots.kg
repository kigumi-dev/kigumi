/// NTT roots for a power-of-two transform length.
pub pure fn rootsZq(n: usize) -> Array[u16] {
    match n {
        2 -> rootsZq2()
        4 -> rootsZq4()
        8 -> rootsZq8()
        16 -> rootsZq16()
        32 -> rootsZq32()
        64 -> rootsZq64()
        128 -> rootsZq128()
        256 -> rootsZq256()
        512 -> rootsZq512()
        _ -> panic("fndsa: unsupported NTT length")
    }
}

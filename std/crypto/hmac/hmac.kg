import hash from std/crypto/hash
import subtle from std/crypto/subtle

const ipad: u8 = 0x36
const opad: u8 = 0x5C

/// Keyed MAC over any `hash.Digest` (RFC 2104, FIPS 198-1).
pub type Hmac[D: hash.Digest] = {
    mut inner D
    outer Bytes
}

/// Appends every byte of data to out.
pure fn appendBytes(out: &mut Array[u8], data: Bytes) {
    let mut i: usize = 0
    for i < data.len() {
        out.push(data[i])
        i = i + 1
    }
}

/// Key padded or hashed to one block, as RFC 2104 §2 requires.
pure fn blockKey[D: hash.Digest](key: Bytes) -> Bytes {
    let n = D.blockSize()
    let short = if key.len() > n {
        hash.sum[D](key)
    } else {
        key
    }
    let mut out = Array.empty[u8]()
    appendBytes(&mut out, short)
    out.appendAll(Array.fill[u8](0, n - short.len()))
    Bytes.fromArray(&out)
}

pure fn padded(key: Bytes, pad: u8) -> Bytes {
    let mut out = Array.empty[u8]()
    let mut i: usize = 0
    for i < key.len() {
        out.push(key[i] ^ pad)
        i = i + 1
    }
    Bytes.fromArray(&out)
}

/// A MAC that has consumed no message bytes yet.
pub pure fn Hmac.new[D: hash.Digest](key: Bytes) -> Hmac[D] {
    let k = blockKey[D](key)
    let mut inner = D.new()
    inner.update(padded(k, ipad))
    Hmac {
        inner: inner
        outer: padded(k, opad)
    }
}

/// Adds message bytes.
pub pure fn Hmac[D: hash.Digest].update(mut self, data: Bytes) {
    self.inner.update(data)
}

/// The MAC of everything added so far.
pub pure fn Hmac[D: hash.Digest].finish(move self) -> Bytes {
    let digest = self.inner.finish()
    let mut outer = D.new()
    outer.update(self.outer)
    outer.update(digest)
    outer.finish()
}

/// MAC of data under key in one call.
pub pure fn sum[D: hash.Digest](key: Bytes, data: Bytes) -> Bytes {
    let mut m = Hmac.new[D](key)
    m.update(data)
    m.finish()
}

/// Whether tag is the MAC of data under key, compared in constant time.
pub pure fn verify[D: hash.Digest](key: Bytes, data: Bytes, tag: Bytes) -> Bool {
    subtle.constantTimeEq(sum[D](key, data), tag)
}

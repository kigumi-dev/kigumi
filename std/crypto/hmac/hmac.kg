import hash from std/crypto/hash
// HMAC (RFC 2104, FIPS 198-1) over a secret-input digest.
//
// The key and every key-derived pad stay in `SecretBuffer`; the digest is a
// `hash.SecretDigest`, so the key is never handed to a public `Bytes` slot.
// The tag is secret, and `verify` compares it with public wire bytes through
// a `Choice`, never a Bool.
import secret from std/secret

const ipad: u8 = 0x36
const opad: u8 = 0x5C

/// A MAC that has consumed no message bytes yet. `outer` is the opad block,
/// secret for the life of the MAC.
pub type Hmac[D: hash.SecretDigest] = {
    mut inner D
    outer secret.SecretBuffer
}

/// Key padded or hashed to one block, as RFC 2104 §2 requires. Its length is
/// public; its bytes are not.
pure fn blockKey[D: hash.SecretDigest](key: &secret.SecretBuffer) -> secret.SecretBuffer {
    let n = D.blockSize()
    let short = if key.len() > n {
        hash.sumSecret[D](key)
    } else {
        key.copy()
    }
    short.concat(secret.SecretBuffer.fromBytes(Bytes.zeros(n - short.len())))
}

pure fn padded(key: &secret.SecretBuffer, pad: u8) -> secret.SecretBuffer {
    key.xorByte(pad)
}

/// A MAC that has consumed no message bytes yet.
pub pure fn Hmac.new[D: hash.SecretDigest](key: &secret.SecretBuffer) -> Hmac[D] {
    let k = blockKey[D](key)
    let innerPad = padded(&k, ipad)
    let outerPad = padded(&k, opad)
    let mut inner = D.new()
    inner.updateSecret(&innerPad)
    Hmac {
        inner: inner
        outer: outerPad
    }
}

/// Adds secret message bytes.
pub pure fn Hmac[D: hash.SecretDigest].update(mut self, data: &secret.SecretBuffer) {
    self.inner.updateSecret(data)
}

/// The secret MAC of everything added so far.
pub pure fn Hmac[D: hash.SecretDigest].finish(move self) -> secret.SecretBuffer {
    let digest = self.inner.finishSecret()
    let mut outer = D.new()
    outer.updateSecret(&self.outer)
    outer.updateSecret(&digest)
    outer.finishSecret()
}

/// MAC of secret data under a secret key in one call.
pub pure fn sum[D: hash.SecretDigest](key: &secret.SecretBuffer, data: &secret.SecretBuffer) -> secret.SecretBuffer {
    let mut m = Hmac.new[D](key)
    m.update(data)
    m.finish()
}

/// Whether `tag` is the MAC of `data` under `key`, compared in constant time
/// and without releasing the computed tag.
pub pure fn verify[D: hash.SecretDigest](key: &secret.SecretBuffer, data: &secret.SecretBuffer, tag: Bytes) -> secret.Choice {
    sum[D](key, data).ctEqPublic(&tag)
}

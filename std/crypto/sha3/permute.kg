// Keccak-f[1600] (FIPS 202 §3): theta, rho+pi, chi and iota over 24 rounds.
// Every index and branch below derives from a round counter or a fixed table,
// never from absorbed bytes.
/// Rounds of Keccak-f[1600].
const rounds: usize = 24

/// Applies Keccak-f[1600] to the 25 lanes in `Core.a` in place.
pure fn Core.permute(mut self) {
    let mut bc = Array.fill[u64](0, 5)
    let mut round: usize = 0
    for round < rounds {
        // theta: XOR each column's parity into its two neighbouring columns.
        let mut x: usize = 0
        for x < 5 {
            bc[x] = self.a[x] ^ self.a[x + 5] ^ self.a[x + 10] ^ self.a[x + 15] ^ self.a[x + 20]
            x = x + 1
        }
        x = 0
        for x < 5 {
            let d = bc[(x + 4) % 5] ^ bc[(x + 1) % 5].rotateLeft(1)
            let mut j: usize = 0
            for j < 25 {
                self.a[j + x] = self.a[j + x] ^ d
                j = j + 5
            }
            x = x + 1
        }
        // rho and pi: rotate the 24 non-zero lanes along one fixed cycle.
        let mut t = self.a[1]
        let mut i: usize = 0
        for i < 24 {
            let j = self.piln[i]
            let rot = self.rotc[i]
            let saved = self.a[j]
            self.a[j] = t.rotateLeft(rot)
            t = saved
            i = i + 1
        }
        // chi: the only non-linear step, applied to each row in turn.
        let mut row: usize = 0
        for row < 25 {
            let mut k: usize = 0
            for k < 5 {
                bc[k] = self.a[row + k]
                k = k + 1
            }
            k = 0
            for k < 5 {
                self.a[row + k] = self.a[row + k] ^ ((~bc[(k + 1) % 5]) & bc[(k + 2) % 5])
                k = k + 1
            }
            row = row + 5
        }
        // iota: break the symmetry between rounds.
        let rc = self.rc[round]
        self.a[0] = self.a[0] ^ rc
        round = round + 1
    }
}

/// Rotation, in bits, of each lane in the rho+pi cycle.
pure fn rotationConstants() -> Array[u64] {
    Array.of[u64](1, 3, 6, 10, 15, 21, 28, 36, 45, 55, 2, 14, 27, 41, 56, 8, 25, 43, 62, 18, 39, 61, 20, 44)
}

/// Lane visited at each step of the rho+pi cycle, indexed x + 5y.
pure fn laneOrder() -> Array[usize] {
    Array.of[usize](10, 7, 11, 17, 18, 3, 5, 16, 8, 21, 24, 4, 15, 23, 19, 13, 12, 2, 20, 14, 22, 9, 6, 1)
}

/// Iota round constants (FIPS 202 §3.2.5).
pure fn roundConstants() -> Array[u64] {
    Array.of[u64](0x0000000000000001, 0x0000000000008082, 0x800000000000808A, 0x8000000080008000, 0x000000000000808B, 0x0000000080000001, 0x8000000080008081, 0x8000000000008009, 0x000000000000008A, 0x0000000000000088, 0x0000000080008009, 0x000000008000000A, 0x000000008000808B, 0x800000000000008B, 0x8000000000008089, 0x8000000000008003, 0x8000000000008002, 0x8000000000000080, 0x000000000000800A, 0x800000008000000A, 0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008)
}

/// SHA3-256 (FIPS 202 §6.1): the 1088-bit-rate sponge with the `0x06`
/// domain suffix, squeezed to 32 bytes. Satisfies `hash.Digest`.
pub type Hasher256 = {
    mut c Core
}

/// A hasher with an empty sponge and no message bytes yet.
pub pure fn Hasher256.new() -> Hasher256 {
    Hasher256 { c: Core.new(rate256) }
}

/// Adds message bytes; buffers whole blocks and permutes each one.
pub pure fn Hasher256.update(mut self, data: Bytes) {
    self.c.update(data)
}

/// Appends the FIPS 202 padding and returns the 32-byte digest.
pub pure fn Hasher256.finish(move self) -> Bytes {
    let mut h = self
    h.c.output(size256, suffixSha3)
}

/// Bytes absorbed per permutation; satisfies `hash.Digest`.
pub pure noalloc fn Hasher256.blockSize() -> usize {
    rate256
}

/// Bytes of output; satisfies `hash.Digest`.
pub pure noalloc fn Hasher256.size() -> usize {
    size256
}

/// SHA3-256 of `data` in one call.
pub pure fn sum256(data: Bytes) -> Bytes {
    let mut h = Hasher256.new()
    h.update(data)
    h.finish()
}

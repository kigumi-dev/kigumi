// Poly1305 one-time authenticator (RFC 8439 §2.5) over secret key material.
//
// The accumulator uses five 26-bit limbs, so every product fits in u64. The
// r, s and pad words and the accumulator stay in the `SecretU32`/`SecretU64`
// domain; the final reduction between `h` and `h + -p` is selected with a
// secret mask. No branch, array index, loop bound or panic condition depends
// on the key or on a message byte.
import secret from std/secret

/// Poly1305 state. Every word that depends on the key or on message content
/// is in the secret domain; `buf` holds at most one secret block.
pub type Poly1305 = {
    mut h0 secret.SecretU32
    mut h1 secret.SecretU32
    mut h2 secret.SecretU32
    mut h3 secret.SecretU32
    mut h4 secret.SecretU32
    r0 secret.SecretU32
    r1 secret.SecretU32
    r2 secret.SecretU32
    r3 secret.SecretU32
    r4 secret.SecretU32
    s1 secret.SecretU32
    s2 secret.SecretU32
    s3 secret.SecretU32
    s4 secret.SecretU32
    pad0 secret.SecretU32
    pad1 secret.SecretU32
    pad2 secret.SecretU32
    pad3 secret.SecretU32
    mut buf secret.SecretBuffer
}

/// Low 26 bits of a limb.
const limbMask: u32 = 0x3FFFFFF

/// The implicit 2^128 bit of a full sixteen-byte block, in limb four.
const highBit: u32 = 1 << 24

/// Bytes of a Poly1305 key: `r` then `s`.
const macKeySize: usize = 32

/// Bytes of the tag.
pub const tagSize: usize = 16

pure noalloc fn pWord(v: u32) -> secret.SecretU32 {
    secret.SecretU32.classify(v)
}

pure noalloc fn pWide(v: u64) -> secret.SecretU64 {
    secret.SecretU64.classify(v)
}

pure noalloc fn pMaskWord() -> secret.SecretU32 {
    pWord(limbMask)
}

pure noalloc fn pMaskWide() -> secret.SecretU64 {
    pWide(limbMask.toU64())
}

/// The four-byte little-endian word at `at` of public data.
pure noalloc fn pLeWord(data: Bytes, at: usize) -> u32 {
    let mut w = data[at].toU32()
    w = w | (data[at + 1].toU32() << 8)
    w = w | (data[at + 2].toU32() << 16)
    w | (data[at + 3].toU32() << 24)
}


/// A MAC that has consumed no message bytes yet.
/// The key is `r` followed by `s`, clamped as RFC 8439 §2.5 requires.
pub pure fn Poly1305.new(key: &secret.SecretBuffer) -> Poly1305 {
    if key.len() != macKeySize {
        panic("poly1305: key must be 32 bytes")
    }
    // Clamp before splitting into limbs: r[3], r[7], r[11], r[15] lose their
    // top four bits and r[4], r[8], r[12] their bottom two.
    let c0 = key.wordLE(0) & pWord(0x0FFFFFFF)
    let c1 = key.wordLE(4) & pWord(0x0FFFFFFC)
    let c2 = key.wordLE(8) & pWord(0x0FFFFFFC)
    let c3 = key.wordLE(12) & pWord(0x0FFFFFFC)
    let w0 = c0.toU64()
    let w1 = c1.toU64()
    let w2 = c2.toU64()
    let w3 = c3.toU64()
    let m = pMaskWide()
    let r0 = (w0 & m).truncateU32()
    let r1 = ((w1.shiftLeft(6)) | (w0.shiftRight(26))).truncateU32() & pMaskWord()
    let r2 = ((w2.shiftLeft(12)) | (w1.shiftRight(20))).truncateU32() & pMaskWord()
    let r3 = ((w3.shiftLeft(18)) | (w2.shiftRight(14))).truncateU32() & pMaskWord()
    let r4 = (w3.shiftRight(8)).truncateU32() & pMaskWord()
    Poly1305 {
        h0: pWord(0)
        h1: pWord(0)
        h2: pWord(0)
        h3: pWord(0)
        h4: pWord(0)
        r0: r0
        r1: r1
        r2: r2
        r3: r3
        r4: r4
        s1: r1.wrappingMul(pWord(5))
        s2: r2.wrappingMul(pWord(5))
        s3: r3.wrappingMul(pWord(5))
        s4: r4.wrappingMul(pWord(5))
        pad0: key.wordLE(16)
        pad1: key.wordLE(20)
        pad2: key.wordLE(24)
        pad3: key.wordLE(28)
        buf: secret.SecretBuffer.fromBytes(Bytes.zeros(0))
    }
}

/// Adds secret message bytes.
pub pure fn Poly1305.update(mut self, data: &secret.SecretBuffer) {
    self.absorbRangeSecret(data, 0, data.len())
}

/// Adds public message bytes (additional data, or ciphertext read from a
/// wire). The bytes are classified; the MAC state stays secret.
pub pure fn Poly1305.updatePublic(mut self, data: Bytes) {
    self.absorbRangePublic(data, 0, data.len())
}

/// Appends one secret byte to the partial block; its length is public.
pure fn Poly1305.appendBuffered(mut self, b: secret.SecretU8) {
    let mut one = Array.tryWithCapacity[secret.SecretU8](1) || panic("out of memory")
    one.push(b)
    self.buf = self.buf.concat(secret.SecretBuffer.fromSecretArray(one))
}

/// Adds secret `data[start..end]` without slicing it.
pure fn Poly1305.absorbRangeSecret(mut self, data: &secret.SecretBuffer, start: usize, end: usize) {
    let mut at = start
    if self.buf.len() > 0 {
        for at < end && self.buf.len() < tagSize {
            let b = data.byteAt(at)
            self.appendBuffered(b)
            at = at + 1
        }
        if self.buf.len() == tagSize {
            self.absorbBuffered()
        }
    }
    for at + tagSize <= end {
        self.absorbWords(data.wordLE(at), data.wordLE(at + 4), data.wordLE(at + 8), data.wordLE(at + 12), pWord(highBit))
        at = at + tagSize
    }
    for at < end {
        let b = data.byteAt(at)
        self.appendBuffered(b)
        at = at + 1
    }
}

/// Adds public `data[start..end]` without slicing it, for ciphertext that is
/// already on the wire.
pure fn Poly1305.absorbRangePublic(mut self, data: Bytes, start: usize, end: usize) {
    let mut at = start
    if self.buf.len() > 0 {
        for at < end && self.buf.len() < tagSize {
            let b = secret.SecretU8.classify(data[at])
            self.appendBuffered(b)
            at = at + 1
        }
        if self.buf.len() == tagSize {
            self.absorbBuffered()
        }
    }
    for at + tagSize <= end {
        self.absorbWords(pWord(pLeWord(data, at)), pWord(pLeWord(data, at + 4)), pWord(pLeWord(data, at + 8)), pWord(pLeWord(data, at + 12)), pWord(highBit))
        at = at + tagSize
    }
    for at < end {
        let b = secret.SecretU8.classify(data[at])
        self.appendBuffered(b)
        at = at + 1
    }
}

/// Adds one secret message byte; the AEAD feeds ciphertext here as it is
/// produced.
pure fn Poly1305.absorb(mut self, b: secret.SecretU8) {
    self.appendBuffered(b)
    if self.buf.len() == tagSize {
        self.absorbBuffered()
    }
}

/// Adds `count` zero bytes, the AEAD padding between fields. `count` is
/// public.
pub pure fn Poly1305.padZeros(mut self, count: usize) {
    let mut left = count
    if self.buf.len() > 0 {
        let mut take = tagSize - self.buf.len()
        if take > left {
            take = left
        }
        let mut i: usize = 0
        for i < take {
            let zero = secret.SecretU8.classify(0)
            self.appendBuffered(zero)
            i = i + 1
        }
        left = left - take
        if self.buf.len() == tagSize {
            self.absorbBuffered()
        }
    }
    for left >= tagSize {
        self.absorbWords(pWord(0), pWord(0), pWord(0), pWord(0), pWord(highBit))
        left = left - tagSize
    }
    let mut i: usize = 0
    for i < left {
        let zero = secret.SecretU8.classify(0)
        self.appendBuffered(zero)
        i = i + 1
    }
}

/// Adds the two 64-bit little-endian lengths that close an AEAD message.
/// The caller has already completed any partial block with padding.
pub pure fn Poly1305.absorbLengths(mut self, aadLen: usize, textLen: usize) {
    let a = aadLen.toU64()
    let c = textLen.toU64()
    self.absorbWords(pWord(a.truncate[u32]()), pWord((a >> 32).truncate[u32]()), pWord(c.truncate[u32]()), pWord((c >> 32).truncate[u32]()), pWord(highBit))
}

/// Adds the sixteen secret bytes already buffered as a full message block.
pure fn Poly1305.absorbBuffered(mut self) {
    self.absorbWords(self.buf.wordLE(0), self.buf.wordLE(4), self.buf.wordLE(8), self.buf.wordLE(12), pWord(highBit))
    self.buf = secret.SecretBuffer.fromBytes(Bytes.zeros(0))
}

/// Adds one 16-byte block as four secret words plus the implicit 2^128 bit,
/// which is zero for the final padded block (its 0x01 byte carries that bit
/// instead).
/// The five secret limbs after one Poly1305 block.
pub type SecretLimbs = {
    pub h0 secret.SecretU32
    pub h1 secret.SecretU32
    pub h2 secret.SecretU32
    pub h3 secret.SecretU32
    pub h4 secret.SecretU32
}

/// One Poly1305 block on secret limbs; the CT conformance shape. No branch,
/// index or divide depends on a limb.
pub pure fn secretBlock(h0v: secret.SecretU32, h1v: secret.SecretU32, h2v: secret.SecretU32, h3v: secret.SecretU32, h4v: secret.SecretU32, r0v: secret.SecretU32, r1v: secret.SecretU32, r2v: secret.SecretU32, r3v: secret.SecretU32, r4v: secret.SecretU32, s1v: secret.SecretU32, s2v: secret.SecretU32, s3v: secret.SecretU32, s4v: secret.SecretU32, w0: secret.SecretU32, w1: secret.SecretU32, w2: secret.SecretU32, w3: secret.SecretU32, high: secret.SecretU32) -> SecretLimbs {
    let m = pMaskWide()
    let x0 = w0.toU64()
    let x1 = w1.toU64()
    let x2 = w2.toU64()
    let x3 = w3.toU64()
    let h0 = h0v.toU64().wrappingAdd(x0 & m)
    let h1 = h1v.toU64().wrappingAdd(((x1.shiftLeft(6)) | (x0.shiftRight(26))) & m)
    let h2 = h2v.toU64().wrappingAdd(((x2.shiftLeft(12)) | (x1.shiftRight(20))) & m)
    let h3 = h3v.toU64().wrappingAdd(((x3.shiftLeft(18)) | (x2.shiftRight(14))) & m)
    let h4 = h4v.toU64().wrappingAdd((x3.shiftRight(8)) | high.toU64())

    let r0 = r0v.toU64()
    let r1 = r1v.toU64()
    let r2 = r2v.toU64()
    let r3 = r3v.toU64()
    let r4 = r4v.toU64()
    let s1 = s1v.toU64()
    let s2 = s2v.toU64()
    let s3 = s3v.toU64()
    let s4 = s4v.toU64()

    let d0 = h0.wrappingMul(r0).wrappingAdd(h1.wrappingMul(s4)).wrappingAdd(h2.wrappingMul(s3)).wrappingAdd(h3.wrappingMul(s2)).wrappingAdd(h4.wrappingMul(s1))
    let mut c = d0.shiftRight(26)
    let d1 = h0.wrappingMul(r1).wrappingAdd(h1.wrappingMul(r0)).wrappingAdd(h2.wrappingMul(s4)).wrappingAdd(h3.wrappingMul(s3)).wrappingAdd(h4.wrappingMul(s2)).wrappingAdd(c)
    let n0 = d0 & m
    c = d1.shiftRight(26)
    let d2 = h0.wrappingMul(r2).wrappingAdd(h1.wrappingMul(r1)).wrappingAdd(h2.wrappingMul(r0)).wrappingAdd(h3.wrappingMul(s4)).wrappingAdd(h4.wrappingMul(s3)).wrappingAdd(c)
    let n1 = d1 & m
    c = d2.shiftRight(26)
    let d3 = h0.wrappingMul(r3).wrappingAdd(h1.wrappingMul(r2)).wrappingAdd(h2.wrappingMul(r1)).wrappingAdd(h3.wrappingMul(r0)).wrappingAdd(h4.wrappingMul(s4)).wrappingAdd(c)
    let n2 = d2 & m
    c = d3.shiftRight(26)
    let d4 = h0.wrappingMul(r4).wrappingAdd(h1.wrappingMul(r3)).wrappingAdd(h2.wrappingMul(r2)).wrappingAdd(h3.wrappingMul(r1)).wrappingAdd(h4.wrappingMul(r0)).wrappingAdd(c)
    let n3 = d3 & m
    c = d4.shiftRight(26)
    let n4 = d4 & m

    let carried = n0.wrappingAdd(c.wrappingMul(pWide(5)))
    SecretLimbs {
        h0: (carried & m).truncateU32()
        h1: (n1.wrappingAdd(carried.shiftRight(26))).truncateU32()
        h2: n2.truncateU32()
        h3: n3.truncateU32()
        h4: n4.truncateU32()
    }
}

pure fn Poly1305.absorbWords(mut self, w0: secret.SecretU32, w1: secret.SecretU32, w2: secret.SecretU32, w3: secret.SecretU32, high: secret.SecretU32) {
    let n = secretBlock(self.h0, self.h1, self.h2, self.h3, self.h4, self.r0, self.r1, self.r2, self.r3, self.r4, self.s1, self.s2, self.s3, self.s4, w0, w1, w2, w3, high)
    self.h0 = n.h0
    self.h1 = n.h1
    self.h2 = n.h2
    self.h3 = n.h3
    self.h4 = n.h4
}

/// Appends a secret 32-bit word in little-endian order.
pure fn pushWordLE(out: &mut Array[secret.SecretU8], w: secret.SecretU32) {
    let b0 = w.truncateU8()
    let b1 = w.shiftRight(8).truncateU8()
    let b2 = w.shiftRight(16).truncateU8()
    let b3 = w.shiftRight(24).truncateU8()
    out.push(b0)
    out.push(b1)
    out.push(b2)
    out.push(b3)
}

/// The tag of everything added so far, with the final reduction and the
/// addition of `s` modulo 2^128 (RFC 8439 §2.5.2). The tag stays secret; only
/// an explicit boundary may release it.
pub pure fn Poly1305.finish(move self) -> secret.SecretBuffer {
    let mut mac = self
    if mac.buf.len() > 0 {
        // The last block is the remaining bytes, a 0x01 byte at their end, and
        // zeroes; that byte carries the 2^(8n) bit, so no implicit high bit.
        let one = secret.SecretU8.classify(1)
        mac.appendBuffered(one)
        for mac.buf.len() < tagSize {
            let zero = secret.SecretU8.classify(0)
            mac.appendBuffered(zero)
        }
        mac.absorbWords(mac.buf.wordLE(0), mac.buf.wordLE(4), mac.buf.wordLE(8), mac.buf.wordLE(12), pWord(0))
        mac.buf = secret.SecretBuffer.fromBytes(Bytes.zeros(0))
    }

    // Fully carry h.
    let m = pMaskWide()
    let mut h0 = mac.h0.toU64()
    let mut h1 = mac.h1.toU64()
    let mut h2 = mac.h2.toU64()
    let mut h3 = mac.h3.toU64()
    let mut h4 = mac.h4.toU64()
    let mut c = h1.shiftRight(26)
    h1 = h1 & m
    h2 = h2.wrappingAdd(c)
    c = h2.shiftRight(26)
    h2 = h2 & m
    h3 = h3.wrappingAdd(c)
    c = h3.shiftRight(26)
    h3 = h3 & m
    h4 = h4.wrappingAdd(c)
    c = h4.shiftRight(26)
    h4 = h4 & m
    h0 = h0.wrappingAdd(c.wrappingMul(pWide(5)))
    c = h0.shiftRight(26)
    h0 = h0 & m
    h1 = h1.wrappingAdd(c)

    // Compute h + -p, where p = 2^130 - 5.
    let mut g0 = h0.wrappingAdd(pWide(5))
    c = g0.shiftRight(26)
    g0 = g0 & m
    let mut g1 = h1.wrappingAdd(c)
    c = g1.shiftRight(26)
    g1 = g1 & m
    let mut g2 = h2.wrappingAdd(c)
    c = g2.shiftRight(26)
    g2 = g2 & m
    let mut g3 = h3.wrappingAdd(c)
    c = g3.shiftRight(26)
    g3 = g3 & m
    let g4 = h4.wrappingAdd(c)
    let negative = g4.wrappingSub(pWide(1).shiftLeft(26)).shiftRight(63)

    // Select g (mask all ones) when h >= p, h (mask zero) otherwise. Neither
    // the comparison nor the selection branches on the value.
    let select = negative.wrappingSub(pWide(1))
    let keep = ~select
    h0 = (h0 & keep) | (g0 & select)
    h1 = (h1 & keep) | (g1 & select)
    h2 = (h2 & keep) | (g2 & select)
    h3 = (h3 & keep) | (g3 & select)
    h4 = (h4 & keep) | (g4 & m & select)

    // h fits in 130 bits; write its low 128 bits, then add s with carries.
    let w0 = (h0 | (h1.shiftLeft(26))) & pWide(0xFFFFFFFF)
    let w1 = ((h1.shiftRight(6)) | (h2.shiftLeft(20))) & pWide(0xFFFFFFFF)
    let w2 = ((h2.shiftRight(12)) | (h3.shiftLeft(14))) & pWide(0xFFFFFFFF)
    let w3 = ((h3.shiftRight(18)) | (h4.shiftLeft(8))) & pWide(0xFFFFFFFF)
    let f0 = w0.wrappingAdd(mac.pad0.toU64())
    let o0 = f0 & pWide(0xFFFFFFFF)
    let f1 = w1.wrappingAdd(mac.pad1.toU64()).wrappingAdd(f0.shiftRight(32))
    let o1 = f1 & pWide(0xFFFFFFFF)
    let f2 = w2.wrappingAdd(mac.pad2.toU64()).wrappingAdd(f1.shiftRight(32))
    let o2 = f2 & pWide(0xFFFFFFFF)
    let f3 = w3.wrappingAdd(mac.pad3.toU64()).wrappingAdd(f2.shiftRight(32))
    let o3 = f3 & pWide(0xFFFFFFFF)

    let mut out = Array.tryWithCapacity[secret.SecretU8](tagSize) || panic("out of memory")
    pushWordLE(&mut out, o0.truncateU32())
    pushWordLE(&mut out, o1.truncateU32())
    pushWordLE(&mut out, o2.truncateU32())
    pushWordLE(&mut out, o3.truncateU32())
    secret.SecretBuffer.fromSecretArray(out)
}

/// MAC of secret `data` under `key` in one call.
pub pure fn sum(key: &secret.SecretBuffer, data: &secret.SecretBuffer) -> secret.SecretBuffer {
    let mut mac = Poly1305.new(key)
    mac.update(data)
    mac.finish()
}

/// MAC of public `data` under `key`, for an unkeyed boundary such as a wire
/// ciphertext. The tag stays secret.
pub pure fn sumPublic(key: &secret.SecretBuffer, data: Bytes) -> secret.SecretBuffer {
    let mut mac = Poly1305.new(key)
    mac.updatePublic(data)
    mac.finish()
}

/// Whether `tag` is the MAC of secret `data` under `key`, compared in
/// constant time.
pub pure fn verify(key: &secret.SecretBuffer, data: &secret.SecretBuffer, tag: Bytes) -> secret.Choice {
    sum(key, data).ctEqPublic(&tag)
}

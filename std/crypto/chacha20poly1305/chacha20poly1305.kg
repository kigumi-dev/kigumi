// AEAD_CHACHA20_POLY1305 (RFC 8439 §2.8): ChaCha20 encryption with a
// Poly1305 tag over the additional data and the ciphertext.
//
// The key and the plaintext are `SecretBuffer` values and both the sealed
// text and the tag stay secret. `open` accepts public sealed bytes (the wire
// form), authenticates them in constant time and returns no plaintext when
// the tag differs. Only the accept/reject decision of `open` leaves the
// secret domain; that is the AEAD authentication boundary.
import secret from std/secret

/// Why an AEAD call was refused.
pub type Error =
    | BadKeySize
    | BadNonceSize
    | ShortInput
    | TagMismatch

/// A short, fixed explanation of the error.
pub fn Error.message(self) -> String {
    match self {
        BadKeySize -> "chacha20poly1305: key must be 32 bytes"
        BadNonceSize -> "chacha20poly1305: nonce must be 12 bytes"
        ShortInput -> "chacha20poly1305: sealed input is shorter than the tag"
        TagMismatch -> "chacha20poly1305: authentication tag mismatch"
    }
}

/// Zeroes to the next multiple of sixteen. `n` is public.
pure fn pad16(n: usize) -> usize {
    (tagSize - n % tagSize) % tagSize
}

/// Encrypts secret `plaintext` and returns ciphertext followed by the tag,
/// bound to public `aad`. `key` is 32 bytes and `nonce` 12; a nonce MUST NOT
/// repeat under one key.
pub pure fn seal(key: &secret.SecretBuffer, nonce: Bytes, aad: Bytes, plaintext: &secret.SecretBuffer) -> Result[secret.SecretBuffer, Error] {
    if key.len() != keySize {
        return Err(Error.BadKeySize)
    }
    if nonce.len() != nonceSize {
        return Err(Error.BadNonceSize)
    }
    let otk = poly1305Key(key, nonce)
    let mut mac = Poly1305.new(&otk)
    mac.updatePublic(aad)
    mac.padZeros(pad16(aad.len()))

    let mut out = Array.tryWithCapacity[secret.SecretU8](plaintext.len() + tagSize) || panic("out of memory")
    // Counter zero produced the one-time key; the message starts at one.
    let mut st = Array.fill[secret.SecretU32](word(0), 16)
    let mut counter: u32 = 1
    let mut at: usize = 0
    for at < plaintext.len() {
        fillBlock(&mut st, key, counter, nonce)
        let left = plaintext.len() - at
        let take = if left < blockSize {
            left
        } else {
            blockSize
        }
        let mut i: usize = 0
        for i < take {
            let b = plaintext.byteAt(at + i) ^ blockByte(&st, i)
            out.push(b)
            mac.absorb(b)
            i = i + 1
        }
        at = at + take
        counter = counter.wrappingAdd(1)
    }

    mac.padZeros(pad16(plaintext.len()))
    mac.absorbLengths(aad.len(), plaintext.len())
    let tag = mac.finish()
    let mut i: usize = 0
    for i < tagSize {
        out.push(tag.byteAt(i))
        i = i + 1
    }
    Ok(secret.SecretBuffer.fromSecretArray(out))
}

/// Verifies the tag of public `sealed` (ciphertext then tag) under public
/// `aad` and returns secret plaintext only when it matches.
pub fn open(key: &secret.SecretBuffer, nonce: Bytes, aad: Bytes, sealed: Bytes) -> Result[secret.SecretBuffer, Error] {
    if key.len() != keySize {
        return Err(Error.BadKeySize)
    }
    if nonce.len() != nonceSize {
        return Err(Error.BadNonceSize)
    }
    if sealed.len() < tagSize {
        return Err(Error.ShortInput)
    }
    let textLen = sealed.len() - tagSize
    let otk = poly1305Key(key, nonce)
    let mut mac = Poly1305.new(&otk)
    mac.updatePublic(aad)
    mac.padZeros(pad16(aad.len()))
    mac.absorbRangePublic(sealed, 0, textLen)
    mac.padZeros(pad16(textLen))
    mac.absorbLengths(aad.len(), textLen)
    let tag = mac.finish()
    let claimed = sealed.slice(textLen, sealed.len()).expect("tag range is within sealed")
    if !unsafe { tag.ctEqPublic(&claimed).declassify() } {
        return Err(Error.TagMismatch)
    }
    Ok(xorRangePublic(key, 1, nonce, sealed, 0, textLen))
}

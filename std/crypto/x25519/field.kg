// Arithmetic in GF(2^255 - 19), the field under the X25519 Montgomery
// ladder (RFC 7748 §5).
//
// A field element is twelve 22-bit limbs holding 264 bits, so every
// representation is congruent modulo p = 2^255 - 19 even when it exceeds p.
// Convolution terms fit in i64: the widest is 9728 * (2^22 - 1)^2 * 12 < 2^61.
// `9728` is 2^264 mod p, i.e. 2^9 * 19.
//
// Every operation returns limbs in [0, 2^22); no branch, shift count or index
// depends on a limb value, so the arithmetic is branchless in the secret.
const limbCount: usize = 12

const limbBits: usize = 22

const topBits: usize = 13

const limbMask: Int = (1 << 22) - 1

const topMask: Int = (1 << 13) - 1

const wrap: Int = 9728

// 1024 * p in limb form. Subtracting two canonical elements can make a limb
// negative; adding a multiple of p large enough for the widest limb keeps
// every limb positive without changing the residue.
const subBias0: Int = 1024 * ((1 << 22) - 19)

const subBiasMid: Int = 1024 * ((1 << 22) - 1)

const subBiasTop: Int = 1024 * ((1 << 13) - 1)

type Fe = {
    l0 Int
    l1 Int
    l2 Int
    l3 Int
    l4 Int
    l5 Int
    l6 Int
    l7 Int
    l8 Int
    l9 Int
    l10 Int
    l11 Int
}

pure fn zero() -> Fe {
    Fe {
        l0: 0
        l1: 0
        l2: 0
        l3: 0
        l4: 0
        l5: 0
        l6: 0
        l7: 0
        l8: 0
        l9: 0
        l10: 0
        l11: 0
    }
}

pure fn one() -> Fe {
    Fe {
        l0: 1
        l1: 0
        l2: 0
        l3: 0
        l4: 0
        l5: 0
        l6: 0
        l7: 0
        l8: 0
        l9: 0
        l10: 0
        l11: 0
    }
}

/// Carries limbs into [0, 2^22). The first pass folds the spilled top bits
/// back with the 2^264 weight; a fold can make limb zero wide again, so two
/// more passes propagate it. Three passes always leave every limb canonical.
pure fn normalize(v: Fe) -> Fe {
    let mut h0 = v.l0
    let mut h1 = v.l1
    let mut h2 = v.l2
    let mut h3 = v.l3
    let mut h4 = v.l4
    let mut h5 = v.l5
    let mut h6 = v.l6
    let mut h7 = v.l7
    let mut h8 = v.l8
    let mut h9 = v.l9
    let mut h10 = v.l10
    let mut h11 = v.l11
    let mut pass: usize = 0
    for pass < 3 {
        let c0 = h0 >> limbBits
        h0 = h0 & limbMask
        h1 = h1 + c0
        let c1 = h1 >> limbBits
        h1 = h1 & limbMask
        h2 = h2 + c1
        let c2 = h2 >> limbBits
        h2 = h2 & limbMask
        h3 = h3 + c2
        let c3 = h3 >> limbBits
        h3 = h3 & limbMask
        h4 = h4 + c3
        let c4 = h4 >> limbBits
        h4 = h4 & limbMask
        h5 = h5 + c4
        let c5 = h5 >> limbBits
        h5 = h5 & limbMask
        h6 = h6 + c5
        let c6 = h6 >> limbBits
        h6 = h6 & limbMask
        h7 = h7 + c6
        let c7 = h7 >> limbBits
        h7 = h7 & limbMask
        h8 = h8 + c7
        let c8 = h8 >> limbBits
        h8 = h8 & limbMask
        h9 = h9 + c8
        let c9 = h9 >> limbBits
        h9 = h9 & limbMask
        h10 = h10 + c9
        let c10 = h10 >> limbBits
        h10 = h10 & limbMask
        h11 = h11 + c10
        let c11 = h11 >> limbBits
        h11 = h11 & limbMask
        h0 = h0 + c11 * wrap
        pass = pass + 1
    }
    Fe {
        l0: h0
        l1: h1
        l2: h2
        l3: h3
        l4: h4
        l5: h5
        l6: h6
        l7: h7
        l8: h8
        l9: h9
        l10: h10
        l11: h11
    }
}

pure fn add(a: Fe, b: Fe) -> Fe {
    normalize(Fe {
        l0: a.l0 + b.l0
        l1: a.l1 + b.l1
        l2: a.l2 + b.l2
        l3: a.l3 + b.l3
        l4: a.l4 + b.l4
        l5: a.l5 + b.l5
        l6: a.l6 + b.l6
        l7: a.l7 + b.l7
        l8: a.l8 + b.l8
        l9: a.l9 + b.l9
        l10: a.l10 + b.l10
        l11: a.l11 + b.l11
    })
}

pure fn sub(a: Fe, b: Fe) -> Fe {
    normalize(Fe {
        l0: a.l0 - b.l0 + subBias0
        l1: a.l1 - b.l1 + subBiasMid
        l2: a.l2 - b.l2 + subBiasMid
        l3: a.l3 - b.l3 + subBiasMid
        l4: a.l4 - b.l4 + subBiasMid
        l5: a.l5 - b.l5 + subBiasMid
        l6: a.l6 - b.l6 + subBiasMid
        l7: a.l7 - b.l7 + subBiasMid
        l8: a.l8 - b.l8 + subBiasMid
        l9: a.l9 - b.l9 + subBiasMid
        l10: a.l10 - b.l10 + subBiasMid
        l11: a.l11 - b.l11 + subBiasTop
    })
}

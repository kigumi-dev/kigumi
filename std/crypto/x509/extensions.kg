// X.509 v3 extension decoding for the Web PKI subset: subject alternative
// names, basic constraints, key usage, extended key usage, subject key
// identifier and authority key identifier. Any other critical extension is
// recorded and makes path validation fail.
import asn1 from std/crypto/asn1

type Extensions = {
    basicConstraints BasicConstraints
    keyUsage KeyUsage
    extKeyUsage ExtKeyUsage
    subjectAltNamesPresent Bool
    dnsNames Array[String]
    ipAddresses Array[Bytes]
    subjectKeyId Bytes?
    authorityKeyId Bytes?
    unsupportedCritical Array[String]
}

pure fn noBasicConstraints() -> BasicConstraints {
    BasicConstraints {
        present: false
        ca: false
        pathLen: None
    }
}

pure fn noKeyUsage() -> KeyUsage {
    KeyUsage {
        present: false
        digitalSignature: false
        contentCommitment: false
        keyEncipherment: false
        dataEncipherment: false
        keyAgreement: false
        keyCertSign: false
        crlSign: false
        encipherOnly: false
        decipherOnly: false
    }
}

pure fn noExtKeyUsage() -> ExtKeyUsage {
    ExtKeyUsage {
        present: false
        serverAuth: false
        clientAuth: false
        codeSigning: false
        emailProtection: false
        timeStamping: false
        ocspSigning: false
        anyPurpose: false
        other: Array.empty[String]()
    }
}

pure fn innerElement(value: Bytes) -> Result[asn1.Element, ParseError] {
    let element = match asn1.parse(value) {
        Ok(parsed) -> parsed
        Err(err) -> fail parseFailure(err.message())
    }
    if element.totalLen() != value.len() {
        fail parseFailure("extension value has trailing bytes")
    }
    Ok(element)
}

pure fn basicConstraintsValue(value: Bytes) -> Result[BasicConstraints, ParseError] {
    let fields = sequence(innerElement(value)?)?
    if fields.len() > 2 {
        fail parseFailure("basicConstraints has too many fields")
    }
    let mut ca = false
    let mut pathLen: Int? = None
    let mut at: usize = 0
    if at < fields.len() && universal(fields[at]) && fields[at].tag == 1 {
        ca = booleanOf(fields[at])?
        at = at + 1
    }
    if at < fields.len() {
        let raw = uintOf(fields[at])?
        pathLen = Some(raw.toInt() || fail parseFailure("path length is too large"))
        at = at + 1
    }
    if at != fields.len() {
        fail parseFailure("basicConstraints has an unexpected field")
    }
    if pathLen is Some(_) && !ca {
        fail parseFailure("basicConstraints pathLen requires cA")
    }
    Ok(BasicConstraints {
        present: true
        ca: ca
        pathLen: pathLen
    })
}

pure fn bitSet(bits: Bytes, index: usize) -> Bool {
    let byte = index / 8
    if byte >= bits.len() {
        return false
    }
    ((bits[byte].toInt() >> (7 - (index % 8))) & 1) != 0
}

pure fn keyUsageValue(value: Bytes) -> Result[KeyUsage, ParseError] {
    let bits = bitStringOf(innerElement(value)?)?
    Ok(KeyUsage {
        present: true
        digitalSignature: bitSet(bits.bytes, 0)
        contentCommitment: bitSet(bits.bytes, 1)
        keyEncipherment: bitSet(bits.bytes, 2)
        dataEncipherment: bitSet(bits.bytes, 3)
        keyAgreement: bitSet(bits.bytes, 4)
        keyCertSign: bitSet(bits.bytes, 5)
        crlSign: bitSet(bits.bytes, 6)
        encipherOnly: bitSet(bits.bytes, 7)
        decipherOnly: bitSet(bits.bytes, 8)
    })
}

pure fn extKeyUsageValue(value: Bytes) -> Result[ExtKeyUsage, ParseError] {
    let fields = sequence(innerElement(value)?)?
    let mut serverAuth = false
    let mut clientAuth = false
    let mut codeSigning = false
    let mut emailProtection = false
    let mut timeStamping = false
    let mut ocspSigning = false
    let mut anyPurpose = false
    let mut other = Array.empty[String]()
    let mut i: usize = 0
    for i < fields.len() {
        let oid = oidOf(fields[i])?
        match oid {
            "1.3.6.1.5.5.7.3.1" -> {
                serverAuth = true
            }
            "1.3.6.1.5.5.7.3.2" -> {
                clientAuth = true
            }
            "1.3.6.1.5.5.7.3.3" -> {
                codeSigning = true
            }
            "1.3.6.1.5.5.7.3.4" -> {
                emailProtection = true
            }
            "1.3.6.1.5.5.7.3.8" -> {
                timeStamping = true
            }
            "1.3.6.1.5.5.7.3.9" -> {
                ocspSigning = true
            }
            "2.5.29.37.0" -> {
                anyPurpose = true
            }
            _ -> {
                other.push(oid)
            }
        }
        i = i + 1
    }
    Ok(ExtKeyUsage {
        present: true
        serverAuth: serverAuth
        clientAuth: clientAuth
        codeSigning: codeSigning
        emailProtection: emailProtection
        timeStamping: timeStamping
        ocspSigning: ocspSigning
        anyPurpose: anyPurpose
        other: other
    })
}

pure fn subjectAltNameValue(value: Bytes, dns: &mut Array[String], ips: &mut Array[Bytes]) -> Result[Void, ParseError] {
    let fields = sequence(innerElement(value)?)?
    let mut i: usize = 0
    for i < fields.len() {
        let name = fields[i]
        if !(name.tagClass is asn1.TagClass.Context) || name.constructed {
            fail parseFailure("GeneralName must be a primitive context-tagged value")
        }
        match name.tag {
            2 -> {
                dns.push(ia5Content(name)?)
            }
            7 -> ips.push(name.content)
            _ -> {}
        }
        i = i + 1
    }
}

pure fn subjectKeyIdValue(value: Bytes) -> Result[Bytes, ParseError] {
    octetsOf(innerElement(value)?)
}

pure fn authorityKeyIdValue(value: Bytes) -> Result[Bytes, ParseError] {
    let fields = sequence(innerElement(value)?)?
    let mut i: usize = 0
    for i < fields.len() {
        let field = fields[i]
        if field.tagClass is asn1.TagClass.Context && field.tag == 0 && !field.constructed {
            return Ok(field.content)
        }
        i = i + 1
    }
    fail parseFailure("authorityKeyId has no keyIdentifier")
}

/// Decodes the `[3] EXPLICIT Extensions` field of a TBSCertificate.
pure fn parseExtensions(e: asn1.Element) -> Result[Extensions, ParseError] {
    if !(e.tagClass is asn1.TagClass.Context) || !e.constructed || e.tag != 3 {
        fail parseFailure("extensions field must be [3] EXPLICIT")
    }
    let wrapper = match e.children() {
        Ok(value) -> value
        Err(err) -> fail parseFailure(err.message())
    }
    if wrapper.len() != 1 {
        fail parseFailure("extensions wrapper must hold one SEQUENCE")
    }
    let entries = sequence(wrapper[0])?

    let mut basicConstraints = noBasicConstraints()
    let mut keyUsage = noKeyUsage()
    let mut extKeyUsage = noExtKeyUsage()
    let mut subjectAltNamesPresent = false
    let mut dns = Array.empty[String]()
    let mut ips = Array.empty[Bytes]()
    let mut subjectKeyId: Bytes? = None
    let mut authorityKeyId: Bytes? = None
    let mut unsupported = Array.empty[String]()
    let mut seen = Array.empty[String]()

    let mut i: usize = 0
    for i < entries.len() {
        let parts = sequence(entries[i])?
        if parts.len() < 2 || parts.len() > 3 {
            fail parseFailure("Extension must have two or three fields")
        }
        let oid = oidOf(parts[0])?
        if seen.contains(oid) {
            fail parseFailure("duplicate extension ${oid}")
        }
        seen.push(oid)
        let mut critical = false
        let mut valueIndex: usize = 1
        if parts.len() == 3 {
            critical = booleanOf(parts[1])?
            valueIndex = 2
        }
        let value = octetsOf(parts[valueIndex])?
        match oid {
            "2.5.29.17" -> {
                subjectAltNamesPresent = true
                subjectAltNameValue(value, &mut dns, &mut ips)?
            }
            "2.5.29.19" -> {
                basicConstraints = basicConstraintsValue(value)?
            }
            "2.5.29.15" -> {
                keyUsage = keyUsageValue(value)?
            }
            "2.5.29.37" -> {
                extKeyUsage = extKeyUsageValue(value)?
            }
            "2.5.29.14" -> {
                subjectKeyId = Some(subjectKeyIdValue(value)?)
            }
            "2.5.29.35" -> {
                authorityKeyId = authorityKeyIdValue(value)?
            }
            _ -> {
                if critical {
                    unsupported.push(oid)
                }
            }
        }
        i = i + 1
    }
    Ok(Extensions {
        basicConstraints: basicConstraints
        keyUsage: keyUsage
        extKeyUsage: extKeyUsage
        subjectAltNamesPresent: subjectAltNamesPresent
        dnsNames: dns
        ipAddresses: ips
        subjectKeyId: subjectKeyId
        authorityKeyId: authorityKeyId
        unsupportedCritical: unsupported
    })
}

/// The extension set of a certificate with no extensions.
pure fn emptyExtensions() -> Extensions {
    Extensions {
        basicConstraints: noBasicConstraints()
        keyUsage: noKeyUsage()
        extKeyUsage: noExtKeyUsage()
        subjectAltNamesPresent: false
        dnsNames: Array.empty[String]()
        ipAddresses: Array.empty[Bytes]()
        subjectKeyId: None
        authorityKeyId: None
        unsupportedCritical: Array.empty[String]()
    }
}

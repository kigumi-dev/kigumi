import binary from std/encoding/binary

/// SHA-256 (FIPS 180-4).
pub const size: usize = 32

/// Bytes per compression block.
pub const blockSize: usize = 64

/// SHA-256 state; satisfies `hash.Digest`.
pub type Hasher = {
    mut h Array[u32]
    mut buf Array[u8]
    mut total usize
    k Array[u32]
}

/// A hasher with the FIPS 180-4 initial state and no message bytes yet.
pub pure fn Hasher.new() -> Hasher {
    Hasher {
        h: Array.of[u32](0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A, 0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19)
        buf: Array.empty()
        total: 0
        k: roundConstants()
    }
}

/// Hash of `data` in one call.
pub pure fn sum(data: Bytes) -> Bytes {
    let mut hs = Hasher.new()
    hs.update(data)
    hs.finish()
}

/// Adds message bytes; buffers whole blocks at a time and compresses each one.
pub pure fn Hasher.update(mut self, data: Bytes) {
    let mut i: usize = 0
    for i < data.len() {
        self.buf.push(data[i])
        if self.buf.len() == blockSize {
            self.compress()
        }
        i = i + 1
    }
    self.total = self.total + data.len()
}

/// Appends the FIPS 180-4 length padding and returns the 32-byte digest.
pub pure fn Hasher.finish(move self) -> Bytes {
    let mut hs = self
    let bits = hs.total * 8
    hs.buf.push(0x80)
    for hs.buf.len() != blockSize - 8 {
        if hs.buf.len() == blockSize {
            hs.compress()
        }
        hs.buf.push(0)
    }
    let mut tail = Array.empty[u8]()
    binary.putU64Be(&mut tail, bits.toU64())
    hs.buf.appendAll(tail)
    hs.compress()

    let mut out = Array.empty[u8]()
    let mut i: usize = 0
    for i < hs.h.len() {
        binary.putU32Be(&mut out, hs.h[i])
        i = i + 1
    }
    Bytes.fromArray(&out)
}

fn Hasher.compress(mut self) {
    let block = Bytes.fromArray(&self.buf)
    let mut w = Array.empty[u32]()
    let mut i: usize = 0
    for i < 16 {
        w.push(binary.u32Be(block, i * 4).expect("block is 64 bytes"))
        i = i + 1
    }
    for i < 64 {
        let w15 = w[i - 15]
        let w2 = w[i - 2]
        let s0 = w15.rotateRight(7) ^ w15.rotateRight(18) ^ (w15 >> 3)
        let s1 = w2.rotateRight(17) ^ w2.rotateRight(19) ^ (w2 >> 10)
        w.push((w[i - 16].wrappingAdd(s0)).wrappingAdd(w[i - 7].wrappingAdd(s1)))
        i = i + 1
    }

    let mut a = self.h[0]
    let mut b = self.h[1]
    let mut c = self.h[2]
    let mut d = self.h[3]
    let mut e = self.h[4]
    let mut f = self.h[5]
    let mut g = self.h[6]
    let mut hh = self.h[7]

    let mut r: usize = 0
    for r < 64 {
        let s1 = e.rotateRight(6) ^ e.rotateRight(11) ^ e.rotateRight(25)
        let ch = (e & f) ^ (~e & g)
        let t1 = (hh.wrappingAdd(s1)).wrappingAdd((ch.wrappingAdd(self.k[r])).wrappingAdd(w[r]))
        let s0 = a.rotateRight(2) ^ a.rotateRight(13) ^ a.rotateRight(22)
        let maj = (a & b) ^ (a & c) ^ (b & c)
        let t2 = s0.wrappingAdd(maj)
        hh = g
        g = f
        f = e
        e = d.wrappingAdd(t1)
        d = c
        c = b
        b = a
        a = t1.wrappingAdd(t2)
        r = r + 1
    }

    self.h[0] = self.h[0].wrappingAdd(a)
    self.h[1] = self.h[1].wrappingAdd(b)
    self.h[2] = self.h[2].wrappingAdd(c)
    self.h[3] = self.h[3].wrappingAdd(d)
    self.h[4] = self.h[4].wrappingAdd(e)
    self.h[5] = self.h[5].wrappingAdd(f)
    self.h[6] = self.h[6].wrappingAdd(g)
    self.h[7] = self.h[7].wrappingAdd(hh)
    self.buf = Array.empty()
}

pure fn roundConstants() -> Array[u32] {
    Array.of[u32](0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5, 0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5, 0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3, 0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174, 0xE49B69C1, 0xEFBE4786, 0x0FC19DC6, 0x240CA1CC, 0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA, 0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7, 0xC6E00BF3, 0xD5A79147, 0x06CA6351, 0x14292967, 0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13, 0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85, 0xA2BFE8A1, 0xA81A664B, 0xC24B8B70, 0xC76C51A3, 0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070, 0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5, 0x391C0CB3, 0x4ED8AA4A, 0x5B9CCA4F, 0x682E6FF3, 0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208, 0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2)
}

/// Bytes per compression block; satisfies `hash.Digest`.
pub pure noalloc fn Hasher.blockSize() -> usize {
    blockSize
}

/// Bytes of output; satisfies `hash.Digest`.
pub pure noalloc fn Hasher.size() -> usize {
    size
}

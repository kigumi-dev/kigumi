import binary from std/encoding/binary
import secret from std/secret

/// SHA-512 (FIPS 180-4): 64 bytes of output from a 128-byte block. SHA-384
/// shares the compression and differs only in its initial state and in how
/// much of it `finish` returns.
pub const size: usize = 64

/// Bytes of SHA-384 output.
pub const size384: usize = 48

/// Bytes per compression block, shared by SHA-512 and SHA-384.
pub const blockSize: usize = 128

type Core = {
    mut h Array[u64]
    mut buf Array[u8]
    mut total usize
    k Array[u64]
}

pure fn Core.new(iv: Array[u64]) -> Core {
    Core {
        h: iv
        buf: Array.empty()
        total: 0
        k: roundConstants()
    }
}

pure fn Core.update(mut self, data: Bytes) {
    let mut i: usize = 0
    for i < data.len() {
        self.buf.push(data[i])
        if self.buf.len() == blockSize {
            self.compress()
        }
        i = i + 1
    }
    self.total = self.total + data.len()
}

/// Appends the FIPS 180-4 padding and returns the eight state words.
pure fn Core.finishWords(mut self) -> Array[u64] {
    let bits = self.total * 8
    self.buf.push(0x80)
    for self.buf.len() != blockSize - 16 {
        if self.buf.len() == blockSize {
            self.compress()
        }
        self.buf.push(0)
    }
    // The length field is 128 bits wide; `total` is a usize, so the high half is zero.
    let mut tail = Array.empty[u8]()
    tail.appendAll(Array.fill[u8](0, 8))
    binary.putU64Be(&mut tail, bits.toU64())
    let mut j: usize = 0
    for j < tail.len() {
        self.buf.push(tail[j])
        j = j + 1
    }
    self.compress()
    // Why not `self.h`: a field cannot be moved out of `mut self`, and
    // eight u64 copies are cheaper than restructuring the state.
    self.h.clone()
}

pure fn Core.compress(mut self) {
    let mut w = Array.empty[u64]()
    let mut i: usize = 0
    for i < 16 {
        let mut v: u64 = 0
        let mut b: usize = 0
        for b < 8 {
            v = (v << 8) | (self.buf[i * 8 + b]).toU64()
            b = b + 1
        }
        w.push(v)
        i = i + 1
    }
    for i < 80 {
        let w15 = w[i - 15]
        let w2 = w[i - 2]
        let s0 = w15.rotateRight(1) ^ w15.rotateRight(8) ^ (w15 >> 7)
        let s1 = w2.rotateRight(19) ^ w2.rotateRight(61) ^ (w2 >> 6)
        let next = (w[i - 16].wrappingAdd(s0)).wrappingAdd(w[i - 7].wrappingAdd(s1))
        w.push(next)
        i = i + 1
    }

    let mut a = self.h[0]
    let mut b = self.h[1]
    let mut c = self.h[2]
    let mut d = self.h[3]
    let mut e = self.h[4]
    let mut f = self.h[5]
    let mut g = self.h[6]
    let mut hh = self.h[7]

    let mut r: usize = 0
    for r < 80 {
        let bigS1 = e.rotateRight(14) ^ e.rotateRight(18) ^ e.rotateRight(41)
        let ch = (e & f) ^ (~e & g)
        let t1 = (hh.wrappingAdd(bigS1)).wrappingAdd((ch.wrappingAdd(self.k[r])).wrappingAdd(w[r]))
        let bigS0 = a.rotateRight(28) ^ a.rotateRight(34) ^ a.rotateRight(39)
        let maj = (a & b) ^ (a & c) ^ (b & c)
        let t2 = bigS0.wrappingAdd(maj)
        hh = g
        g = f
        f = e
        e = d.wrappingAdd(t1)
        d = c
        c = b
        b = a
        a = t1.wrappingAdd(t2)
        r = r + 1
    }

    self.h[0] = self.h[0].wrappingAdd(a)
    self.h[1] = self.h[1].wrappingAdd(b)
    self.h[2] = self.h[2].wrappingAdd(c)
    self.h[3] = self.h[3].wrappingAdd(d)
    self.h[4] = self.h[4].wrappingAdd(e)
    self.h[5] = self.h[5].wrappingAdd(f)
    self.h[6] = self.h[6].wrappingAdd(g)
    self.h[7] = self.h[7].wrappingAdd(hh)
    self.buf = Array.empty()
}

pure fn wordsToBytes(words: &Array[u64], want: usize) -> Bytes {
    let mut out = Array.empty[u8]()
    let mut i: usize = 0
    for i < words.len() {
        binary.putU64Be(&mut out, words[i])
        i = i + 1
    }
    let all = Bytes.fromArray(&out)
    all.slice(0, want) || all
}

/// SHA-512 state; satisfies `hash.Digest`.
pub type Hasher = {
    mut c Core
}

/// A hasher with the SHA-512 initial state and no message bytes yet.
pub pure fn Hasher.new() -> Hasher {
    Hasher { c: Core.new(iv512()) }
}

/// Bytes per compression block; satisfies `hash.Digest`.
pub pure noalloc fn Hasher.blockSize() -> usize {
    blockSize
}

/// Bytes of output; satisfies `hash.Digest`.
pub pure noalloc fn Hasher.size() -> usize {
    size
}

/// Adds message bytes.
pub pure fn Hasher.update(mut self, data: Bytes) {
    self.c.update(data)
}

/// Appends the FIPS 180-4 length padding and returns the 64-byte digest.
pub pure fn Hasher.finish(move self) -> Bytes {
    let mut h = self
    wordsToBytes(&h.c.finishWords(), size)
}

/// SHA-384: the same compression from a different start, truncated to 48 bytes.
/// Satisfies `hash.Digest`.
pub type Hasher384 = {
    mut c Core
}

/// A hasher with the SHA-384 initial state and no message bytes yet.
pub pure fn Hasher384.new() -> Hasher384 {
    Hasher384 { c: Core.new(iv384()) }
}

/// Bytes per compression block; satisfies `hash.Digest`.
pub pure noalloc fn Hasher384.blockSize() -> usize {
    blockSize
}

/// Bytes of output; satisfies `hash.Digest`.
pub pure noalloc fn Hasher384.size() -> usize {
    size384
}

/// Adds message bytes.
pub pure fn Hasher384.update(mut self, data: Bytes) {
    self.c.update(data)
}

/// Appends the FIPS 180-4 length padding and returns the 48-byte digest.
pub pure fn Hasher384.finish(move self) -> Bytes {
    let mut h = self
    wordsToBytes(&h.c.finishWords(), size384)
}

/// SHA-512 of data in one call.
pub pure fn sum(data: Bytes) -> Bytes {
    let mut h = Hasher.new()
    h.update(data)
    h.finish()
}

/// SHA-384 of data in one call.
pub pure fn sum384(data: Bytes) -> Bytes {
    let mut h = Hasher384.new()
    h.update(data)
    h.finish()
}

pure fn roundConstants() -> Array[u64] {
    Array.of[u64](0x428A2F98D728AE22, 0x7137449123EF65CD, 0xB5C0FBCFEC4D3B2F, 0xE9B5DBA58189DBBC, 0x3956C25BF348B538, 0x59F111F1B605D019, 0x923F82A4AF194F9B, 0xAB1C5ED5DA6D8118, 0xD807AA98A3030242, 0x12835B0145706FBE, 0x243185BE4EE4B28C, 0x550C7DC3D5FFB4E2, 0x72BE5D74F27B896F, 0x80DEB1FE3B1696B1, 0x9BDC06A725C71235, 0xC19BF174CF692694, 0xE49B69C19EF14AD2, 0xEFBE4786384F25E3, 0x0FC19DC68B8CD5B5, 0x240CA1CC77AC9C65, 0x2DE92C6F592B0275, 0x4A7484AA6EA6E483, 0x5CB0A9DCBD41FBD4, 0x76F988DA831153B5, 0x983E5152EE66DFAB, 0xA831C66D2DB43210, 0xB00327C898FB213F, 0xBF597FC7BEEF0EE4, 0xC6E00BF33DA88FC2, 0xD5A79147930AA725, 0x06CA6351E003826F, 0x142929670A0E6E70, 0x27B70A8546D22FFC, 0x2E1B21385C26C926, 0x4D2C6DFC5AC42AED, 0x53380D139D95B3DF, 0x650A73548BAF63DE, 0x766A0ABB3C77B2A8, 0x81C2C92E47EDAEE6, 0x92722C851482353B, 0xA2BFE8A14CF10364, 0xA81A664BBC423001, 0xC24B8B70D0F89791, 0xC76C51A30654BE30, 0xD192E819D6EF5218, 0xD69906245565A910, 0xF40E35855771202A, 0x106AA07032BBD1B8, 0x19A4C116B8D2D0C8, 0x1E376C085141AB53, 0x2748774CDF8EEB99, 0x34B0BCB5E19B48A8, 0x391C0CB3C5C95A63, 0x4ED8AA4AE3418ACB, 0x5B9CCA4F7763E373, 0x682E6FF3D6B2B8A3, 0x748F82EE5DEFB2FC, 0x78A5636F43172F60, 0x84C87814A1F0AB72, 0x8CC702081A6439EC, 0x90BEFFFA23631E28, 0xA4506CEBDE82BDE9, 0xBEF9A3F7B2C67915, 0xC67178F2E372532B, 0xCA273ECEEA26619C, 0xD186B8C721C0C207, 0xEADA7DD6CDE0EB1E, 0xF57D4F7FEE6ED178, 0x06F067AA72176FBA, 0x0A637DC5A2C898A6, 0x113F9804BEF90DAE, 0x1B710B35131C471B, 0x28DB77F523047D84, 0x32CAAB7B40C72493, 0x3C9EBE0A15C9BEBC, 0x431D67C49C100D4C, 0x4CC5D4BECB3E42B6, 0x597F299CFC657E2A, 0x5FCB6FAB3AD6FAEC, 0x6C44198C4A475817)
}

pure fn iv512() -> Array[u64] {
    Array.of[u64](0x6A09E667F3BCC908, 0xBB67AE8584CAA73B, 0x3C6EF372FE94F82B, 0xA54FF53A5F1D36F1, 0x510E527FADE682D1, 0x9B05688C2B3E6C1F, 0x1F83D9ABFB41BD6B, 0x5BE0CD19137E2179)
}

pure fn iv384() -> Array[u64] {
    Array.of[u64](0xCBBB9D5DC1059ED8, 0x629A292A367CD507, 0x9159015A3070DD17, 0x152FECD8F70E5939, 0x67332667FFC00B31, 0x8EB44A8768581511, 0xDB0C2E0D64F98FA7, 0x47B5481DBEFA4FA4)
}

// --- secret-input SHA-512 ------------------------------------------------
//
// Used by HMAC/HKDF when the key is secret. The chaining state, the message
// buffer and the digest stay in the `SecretU64` domain; only the round
// counter and the public constants are ordinary values.
/// SHA-512 state for secret input; satisfies `hash.SecretDigest`.
pub type SecretHasher = {
    mut h Array[secret.SecretU64]
    mut buf Array[secret.SecretU8]
    mut total secret.SecretU64
    k Array[u64]
}

/// A hasher with the SHA-512 initial state and no secret bytes yet.
pub pure fn SecretHasher.new() -> SecretHasher {
    let iv = iv512()
    let mut h = Array.empty[secret.SecretU64]()
    let mut i: usize = 0
    for i < iv.len() {
        h.push(secret.SecretU64.classify(iv[i]))
        i = i + 1
    }
    SecretHasher {
        h: h
        buf: Array.empty()
        total: secret.SecretU64.classify(0)
        k: roundConstants()
    }
}

/// Bytes per compression block; satisfies `hash.SecretDigest`.
pub pure noalloc fn SecretHasher.blockSize() -> usize {
    blockSize
}

/// Bytes of output; satisfies `hash.SecretDigest`.
pub pure noalloc fn SecretHasher.size() -> usize {
    size
}

/// Adds secret message bytes, buffering whole blocks at a time.
pub pure fn SecretHasher.updateSecret(mut self, data: &secret.SecretBuffer) {
    let mut i: usize = 0
    for i < data.len() {
        let b = data.byteAt(i)
        self.buf.push(b)
        if self.buf.len() == blockSize {
            self.compressSecret()
        }
        i = i + 1
    }
    self.total = self.total.wrappingAdd(secret.SecretU64.classify(data.len().toU64()))
}

pure noalloc fn secretWord(v: u64) -> secret.SecretU64 {
    secret.SecretU64.classify(v)
}

pure fn pushU64BE(out: &mut Array[secret.SecretU8], w: secret.SecretU64) {
    let b0 = w.shiftRight(56).truncateU8()
    let b1 = w.shiftRight(48).truncateU8()
    let b2 = w.shiftRight(40).truncateU8()
    let b3 = w.shiftRight(32).truncateU8()
    let b4 = w.shiftRight(24).truncateU8()
    let b5 = w.shiftRight(16).truncateU8()
    let b6 = w.shiftRight(8).truncateU8()
    let b7 = w.truncateU8()
    out.push(b0)
    out.push(b1)
    out.push(b2)
    out.push(b3)
    out.push(b4)
    out.push(b5)
    out.push(b6)
    out.push(b7)
}

/// Appends the FIPS 180-4 length padding and returns the 64-byte secret
/// digest.
pub pure fn SecretHasher.finishSecret(move self) -> secret.SecretBuffer {
    let mut hs = self
    let bits = hs.total.wrappingMul(secret.SecretU64.classify(8))
    hs.buf.push(secret.SecretU8.classify(0x80))
    for hs.buf.len() != blockSize - 16 {
        if hs.buf.len() == blockSize {
            hs.compressSecret()
        }
        hs.buf.push(secret.SecretU8.classify(0))
    }
    // The length field is 128 bits; `total` is a usize, so the high half is
    // zero.
    let mut z: usize = 0
    for z < 8 {
        hs.buf.push(secret.SecretU8.classify(0))
        z = z + 1
    }
    let mut k: usize = 0
    for k < 8 {
        let byte = bits.shiftRight(((7 - k) * 8).toU32() || 0).truncateU8()
        hs.buf.push(byte)
        k = k + 1
    }
    hs.compressSecret()

    let mut out = Array.empty[secret.SecretU8]()
    let mut i: usize = 0
    for i < hs.h.len() {
        pushU64BE(&mut out, hs.h[i])
        i = i + 1
    }
    secret.SecretBuffer.fromSecretArray(out)
}

fn SecretHasher.compressSecret(mut self) {
    let mut w = Array.empty[secret.SecretU64]()
    let mut i: usize = 0
    for i < 16 {
        let mut v = secret.SecretU64.classify(0)
        let mut b: usize = 0
        for b < 8 {
            let byte = self.buf[i * 8 + b].toU64()
            v = v.shiftLeft(8) | byte
            b = b + 1
        }
        w.push(v)
        i = i + 1
    }
    for i < 80 {
        let w15 = w[i - 15]
        let w2 = w[i - 2]
        let s0 = w15.rotateRight(1) ^ w15.rotateRight(8) ^ w15.shiftRight(7)
        let s1 = w2.rotateRight(19) ^ w2.rotateRight(61) ^ w2.shiftRight(6)
        let next = (w[i - 16].wrappingAdd(s0)).wrappingAdd(w[i - 7].wrappingAdd(s1))
        w.push(next)
        i = i + 1
    }

    let mut a = self.h[0]
    let mut b = self.h[1]
    let mut c = self.h[2]
    let mut d = self.h[3]
    let mut e = self.h[4]
    let mut f = self.h[5]
    let mut g = self.h[6]
    let mut hh = self.h[7]

    let mut r: usize = 0
    for r < 80 {
        let bigS1 = e.rotateRight(14) ^ e.rotateRight(18) ^ e.rotateRight(41)
        let ch = (e & f) ^ ((~e) & g)
        let t1 = (hh.wrappingAdd(bigS1)).wrappingAdd((ch.wrappingAdd(secretWord(self.k[r]))).wrappingAdd(w[r]))
        let bigS0 = a.rotateRight(28) ^ a.rotateRight(34) ^ a.rotateRight(39)
        let maj = (a & b) ^ (a & c) ^ (b & c)
        let t2 = bigS0.wrappingAdd(maj)
        hh = g
        g = f
        f = e
        e = d.wrappingAdd(t1)
        d = c
        c = b
        b = a
        a = t1.wrappingAdd(t2)
        r = r + 1
    }

    self.h[0] = self.h[0].wrappingAdd(a)
    self.h[1] = self.h[1].wrappingAdd(b)
    self.h[2] = self.h[2].wrappingAdd(c)
    self.h[3] = self.h[3].wrappingAdd(d)
    self.h[4] = self.h[4].wrappingAdd(e)
    self.h[5] = self.h[5].wrappingAdd(f)
    self.h[6] = self.h[6].wrappingAdd(g)
    self.h[7] = self.h[7].wrappingAdd(hh)
    self.buf = Array.empty()
}

// HKDF (RFC 5869) over a secret-input HMAC.
//
// The input keying material, the PRK and every output key are
// `SecretBuffer`s. Salt is an HMAC key, so it is secret-typed too; a public
// salt is wrapped explicitly with `SecretBuffer.fromBytes` at the caller.
import secret from std/secret
import hash from std/crypto/hash
import hmac from std/crypto/hmac

/// An HKDF failure: a request past the RFC 5869 §2.3 length limit, or a short
/// final output slice.
pub type HkdfError = {
    pub text String
}

pub fn HkdfError.message(self) -> String {
    self.text
}

/// Extract step: a pseudorandom key of one digest from the input keying
/// material. An empty salt means HashLen zero bytes, as RFC 5869 §2.2
/// specifies; the output stays secret.
pub pure fn extract[D: hash.SecretDigest](salt: &secret.SecretBuffer, ikm: &secret.SecretBuffer) -> secret.SecretBuffer {
    let s = if salt.len() == 0 {
        secret.SecretBuffer.fromBytes(Bytes.zeros(D.size()))
    } else {
        salt.copy()
    }
    hmac.sum[D](&s, ikm)
}

/// Expand step: `length` bytes of output keyed by the secret `prk` and bound
/// to public `info`. Fails when `length` exceeds the RFC 5869 §2.3 limit of
/// 255 digests.
pub pure fn expand[D: hash.SecretDigest](prk: &secret.SecretBuffer, info: Bytes, length: usize) -> Result[secret.SecretBuffer, HkdfError] {
    let n = D.size()
    if length > n * 255 {
        return Err(HkdfError { text: "hkdf: requested length exceeds 255 digests" })
    }
    let mut out = secret.SecretBuffer.fromBytes(Bytes.zeros(0))
    let mut previous = secret.SecretBuffer.fromBytes(Bytes.zeros(0))
    // Counted from the block index: the last legal counter is 255, and `+ 1`
    // on a u8 panics on overflow rather than wrapping.
    let mut i: usize = 0
    for out.len() < length {
        let block = previous.concat(secret.SecretBuffer.fromBytes(info)).concat(secret.SecretBuffer.fromBytes(Bytes.fill((i + 1).toU8() || 0, 1)))
        previous = hmac.sum[D](prk, &block)
        out = out.concat(previous.copy())
        i = i + 1
    }
    Ok(out.sliceSecret(0, length))
}

/// Extract followed by expand, the usual one-call form.
pub pure fn derive[D: hash.SecretDigest](salt: &secret.SecretBuffer, ikm: &secret.SecretBuffer, info: Bytes, length: usize) -> Result[secret.SecretBuffer, HkdfError] {
    expand[D](&extract[D](salt, ikm), info, length)
}

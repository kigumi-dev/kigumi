// Fixed-exponent exponentiation in Montgomery form.
//
// The exponent is a public constant, so its bits may steer the multiply step.
// Squaring always runs, which keeps the work independent of the base.
/// base^e in Montgomery form, with e given in four little-endian limbs.
pure noalloc fn powMod(base: U256, e: U256, md: Mod) -> U256 {
    let mut r = U256 {
        l0: md.o0
        l1: md.o1
        l2: md.o2
        l3: md.o3
    }
    let mut i: usize = 0
    for i < 256 {
        r = montMul(r, r, md)
        let pos = 255 - i
        let word = if pos < 64 {
            e.l0
        } else if pos < 128 {
            e.l1
        } else if pos < 192 {
            e.l2
        } else {
            e.l3
        }
        let bit = (word >> (pos & 63)) & 1
        if bit == 1 {
            r = montMul(r, base, md)
        }
        i = i + 1
    }
    r
}

/// a^(p-2) in Montgomery form, the inverse of a modulo p.
pure noalloc fn invP(a: U256) -> U256 {
    let e = U256 {
        l0: 0xFFFFFFFFFFFFFFFD
        l1: 0x00000000FFFFFFFF
        l2: 0x0000000000000000
        l3: 0xFFFFFFFF00000001
    }
    powMod(a, e, modulusP())
}

/// a^(n-2) in Montgomery form, the inverse of a modulo n.
pure noalloc fn invN(a: U256) -> U256 {
    let e = U256 {
        l0: 0xF3B9CAC2FC63254F
        l1: 0xBCE6FAADA7179E84
        l2: 0xFFFFFFFFFFFFFFFF
        l3: 0xFFFFFFFF00000000
    }
    powMod(a, e, modulusN())
}

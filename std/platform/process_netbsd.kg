import ffi from std/ffi

/// Why a process wait, spawn or signal failed at the OS layer.
pub type ProcessError = {
    pub text String
}

pub fn ProcessError.message(self) -> String {
    self.text
}

extern(C) {
    fn fork() -> i32
    fn execvp(file: *const u8, argv: *const u8) -> i32
    fn waitpid(pid: i32, status: *mut u8, options: i32) -> i32
    fn kill(pid: i32, signal: i32) -> i32
    fn malloc(n: usize) -> *mut u8
    fn free(p: *mut u8)
    fn _exit(code: i32) -> Never
}

fn hasNul(s: String) -> Bool {
    for b in s.bytes() {
        if b == 0 {
            return true
        }
    }
    false
}

/// Spawns program with argv[0] = program and the given arguments, inheriting
/// stdin, stdout and stderr. PATH lookup follows execvp.
pub fn spawnProcess(program: String, args: Array[String]) -> i32! {
    if hasNul(program) {
        fail ProcessError { text: "process program contains a NUL byte" }
    }
    let mut argv = Array.empty[ffi.CString]()
    argv.push(ffi.CString.new(&program)?)
    for i in 0..args.len() {
        let arg = args.get(i) || ""
        if hasNul(arg) {
            fail ProcessError { text: "process argument contains a NUL byte" }
        }
        argv.push(ffi.CString.new(&arg)?)
    }
    let n = argv.len()
    let nullPtr = ffi.null[u8]()
    let ptrSize = ffi.sizeOf(&nullPtr)
    let table = unsafe {
        malloc((n + 1) * ptrSize)
    }
    if ffi.isNull(ffi.toConst(table)) {
        fail ProcessError { text: "process spawn: out of memory" }
    }
    let mut i: usize = 0
    for i < n {
        unsafe {
            ffi.writePtr(ffi.toMut(ffi.offset(ffi.toConst(table), (i * ptrSize).toInt() || 0)), argv[i].ptr())
        }
        i = i + 1
    }
    unsafe {
        ffi.writePtr(ffi.toMut(ffi.offset(ffi.toConst(table), (n * ptrSize).toInt() || 0)), nullPtr)
    }
    let pid = unsafe {
        fork()
    }
    if pid == 0 {
        let prog = unsafe {
            ffi.readPtr(ffi.toConst(table))
        }
        _ = unsafe {
            execvp(prog, ffi.toConst(table))
        }
        unsafe {
            _exit(127)
        }
    }
    unsafe {
        free(table)
    }
    if pid < 0 {
        fail ProcessError { text: "process spawn failed: ${ffi.errorText(ffi.errno())}" }
    }
    pid
}

fn decodeStatus(raw: i32) -> Int {
    if (raw & 127) == 0 {
        ((raw >> 8) & 255).toInt()
    } else {
        128 + (raw & 127).toInt()
    }
}

/// Waits for pid and returns its exit code, or 128 + signal number when a
/// signal ended it.
pub fn waitProcess(pid: i32) -> Int! {
    let status = unsafe {
        malloc(4)
    }
    if ffi.isNull(ffi.toConst(status)) {
        fail ProcessError { text: "process wait: out of memory" }
    }
    let mut got: i32 = -1
    for true {
        got = unsafe {
            waitpid(pid, status, 0)
        }
        if got >= 0 || ffi.errno() != eintr() {
            break
        }
    }
    if got < 0 {
        let why = ffi.errorText(ffi.errno())
        unsafe {
            free(status)
        }
        fail ProcessError { text: "process wait failed: ${why}" }
    }
    let raw = unsafe {
        ffi.readI32(ffi.cast[i32](ffi.toConst(status)))
    }
    unsafe {
        free(status)
    }
    decodeStatus(raw)
}

/// Reports pid's exit code once it has exited without blocking, or None while
/// it still runs. A wait for a pid someone already reaped is not retried: the
/// caller owns the child, so ECHILD stays an error instead of inventing a
/// status.
pub fn tryWaitProcess(pid: i32) -> Int?! {
    let status = unsafe {
        malloc(4)
    }
    if ffi.isNull(ffi.toConst(status)) {
        fail ProcessError { text: "process wait: out of memory" }
    }
    let mut got: i32 = -1
    for true {
        // WNOHANG is 1 on every POSIX target this package builds for.
        got = unsafe {
            waitpid(pid, status, 1)
        }
        if got >= 0 || ffi.errno() != eintr() {
            break
        }
    }
    if got == 0 {
        unsafe {
            free(status)
        }
        return None
    }
    if got < 0 {
        let why = ffi.errorText(ffi.errno())
        unsafe {
            free(status)
        }
        fail ProcessError { text: "process wait failed: ${why}" }
    }
    let raw = unsafe {
        ffi.readI32(ffi.cast[i32](ffi.toConst(status)))
    }
    unsafe {
        free(status)
    }
    Some(decodeStatus(raw))
}

/// Sends sig to pid. A process that exited between the caller's check and the
/// signal is already gone; ESRCH is not a failure there. A child that exited
/// but has not been waited for is a zombie, which kill still accepts.
pub fn signalProcess(pid: i32, sig: i32) -> Void! {
    if unsafe {
        kill(pid, sig)
    } != 0 {
        // errno(3) ESRCH: no process or zombie with that pid.
        if ffi.errno() == 3 {
            return
        }
        fail ProcessError { text: "process signal failed: ${ffi.errorText(ffi.errno())}" }
    }
}

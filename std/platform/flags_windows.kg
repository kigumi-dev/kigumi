/// open(2) flags for creating a file for writing on this platform.
pub fn createFlags() -> i32 {
    769
}

/// fopen mode with close-on-exec on POSIX; other targets ignore the flag.
pub fn fopenMode(mode: String) -> String {
    mode
}

/// Whether the OS keeps a file name's bytes exactly as given. Windows entry
/// points take UTF-16 text, so a name that is not valid UTF-8 cannot be carried;
/// callers reject it instead of converting it to some other path.
pub fn exactPathNames() -> Bool {
    false
}

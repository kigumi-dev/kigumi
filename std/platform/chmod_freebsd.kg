import ffi from std/ffi

extern(C) {
    fn chmod(path: *const u8, mode: u32) -> i32
}

/// Changes the permission bits of path to mode (before the umask, which chmod does not apply).
pub fn chmodFile(path: String, mode: u32) -> Void! {
    let c = ffi.CString.new(&path)?
    if unsafe {
        chmod(c.ptr(), mode)
    } != 0 {
        fail ffi.lastError()
    }
}

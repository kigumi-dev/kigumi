/// errno(3) constants for this platform, shared by the OS-facing packages.
/// errno(3) EEXIST.
pub fn eexist() -> i32 {
    20
}

/// errno(3) EINTR.
pub fn eintr() -> i32 {
    27
}

/// errno(3) ENOTDIR.
pub fn enotdir() -> i32 {
    54
}

/// errno(3) ENOENT.
pub fn enoent() -> i32 {
    44
}

/// errno(3) ELOOP.
pub fn eloop() -> i32 {
    32
}

/// errno(3) EAGAIN.
pub fn eagain() -> i32 {
    6
}

/// errno(3) EINPROGRESS.
pub fn einprogress() -> i32 {
    26
}

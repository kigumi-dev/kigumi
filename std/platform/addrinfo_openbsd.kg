import ffi from std/ffi

extern(C) {
    fn gai_strerror(code: i32) -> *const u8
}

// struct addrinfo as this platform lays it out: OpenBSD's netdb.h puts
// ai_addr before ai_canonname, the reverse of Darwin/FreeBSD/NetBSD/
// Windows (which all match Linux/wasi's canonname-then-addr order).
pub type AddrInfo layout(C) = {
    pub flags i32
    pub family i32
    pub socktype i32
    pub protocol i32
    pub addrlen u32
    pub addr *const u8
    pub canonname *const u8
    pub next *const u8
}

pub fn gaiText(code: i32) -> String {
    unsafe {
        ffi.stringLossy(gai_strerror(code))
    }
}

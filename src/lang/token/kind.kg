pub type Kind =
    | Invalid
    | BOF
    | EOF
    | Newline
    | Comment
    | BlockComment
    | DocComment
    | Ident
    | IntKind
    | FloatKind
    | StringKind
    | ByteString
    | CharKind
    | Lifetime
    | Operator
    | LParen
    | RParen
    | LBracket
    | RBracket
    | LBrace
    | RBrace
    | Comma
    | Dot
    | DotDot
    | DotDotEq
    | Ellipsis
    | Colon
    | Semicolon
    | At
    | Dollar
    | Question
    | QuestionDot
    | Arrow
    | FatArrow
    | Assign
    | Plus
    | Minus
    | Star
    | Slash
    | Percent
    | Amp
    | Pipe
    | Caret
    | Shl
    | Shr
    | Bang
    | Tilde
    | EqEq
    | NotEq
    | Lt
    | LtEq
    | Gt
    | GtEq
    | AndAnd
    | OrOr
    | PipeGt
    | PlusAssign
    | MinusAssign
    | StarAssign
    | SlashAssign
    | PercentAssign
    | AmpAssign
    | PipeAssign
    | CaretAssign
    | ShlAssign
    | ShrAssign
    | KwFn
    | KwLet
    | KwConst
    | KwMut
    | KwType
    | KwInterface
    | KwPub
    | KwImport
    | KwIf
    | KwElse
    | KwMatch
    | KwIs
    | KwFor
    | KwIn
    | KwReturn
    | KwBreak
    | KwContinue
    | KwDefer
    | KwFail
    | KwPure
    | KwNoalloc
    | KwAsync
    | KwAwait
    | KwUnsafe
    | KwMove
    | KwExtern
    | KwComptime
    | KwTrue
    | KwFalse

pub fn Kind.name(self) -> String {
    match self {
        Invalid -> "invalid"
        BOF -> "BOF"
        EOF -> "EOF"
        Newline -> "newline"
        Comment -> "comment"
        BlockComment -> "block comment"
        DocComment -> "doc comment"
        Ident -> "identifier"
        IntKind -> "integer"
        FloatKind -> "float"
        StringKind -> "string"
        ByteString -> "byte string"
        CharKind -> "char"
        Lifetime -> "lifetime"
        Operator -> "operator"
        LParen -> "("
        RParen -> ")"
        LBracket -> "["
        RBracket -> "]"
        LBrace -> "{"
        RBrace -> "}"
        Comma -> ","
        Dot -> "."
        DotDot -> ".."
        DotDotEq -> "..="
        Ellipsis -> "..."
        Colon -> ":"
        Semicolon -> ";"
        At -> "@"
        Dollar -> "$"
        Question -> "?"
        QuestionDot -> "?."
        Arrow -> "->"
        FatArrow -> "=>"
        Assign -> "="
        Plus -> "+"
        Minus -> "-"
        Star -> "*"
        Slash -> "/"
        Percent -> "%"
        Amp -> "&"
        Pipe -> "|"
        Caret -> "^"
        Shl -> "<<"
        Shr -> ">>"
        Bang -> "!"
        Tilde -> "~"
        EqEq -> "=="
        NotEq -> "!="
        Lt -> "<"
        LtEq -> "<="
        Gt -> ">"
        GtEq -> ">="
        AndAnd -> "&&"
        OrOr -> "||"
        PipeGt -> "|>"
        PlusAssign -> "+="
        MinusAssign -> "-="
        StarAssign -> "*="
        SlashAssign -> "/="
        PercentAssign -> "%="
        AmpAssign -> "&="
        PipeAssign -> "|="
        CaretAssign -> "^="
        ShlAssign -> "<<="
        ShrAssign -> ">>="
        KwFn -> "fn"
        KwLet -> "let"
        KwConst -> "const"
        KwMut -> "mut"
        KwType -> "type"
        KwInterface -> "interface"
        KwPub -> "pub"
        KwImport -> "import"
        KwIf -> "if"
        KwElse -> "else"
        KwMatch -> "match"
        KwIs -> "is"
        KwFor -> "for"
        KwIn -> "in"
        KwReturn -> "return"
        KwBreak -> "break"
        KwContinue -> "continue"
        KwDefer -> "defer"
        KwFail -> "fail"
        KwPure -> "pure"
        KwNoalloc -> "noalloc"
        KwAsync -> "async"
        KwAwait -> "await"
        KwUnsafe -> "unsafe"
        KwMove -> "move"
        KwExtern -> "extern"
        KwComptime -> "comptime"
        KwTrue -> "true"
        KwFalse -> "false"
    }
}

pub fn Kind.isKeyword(self) -> Bool {
    match self {
        KwFn | KwLet | KwConst | KwMut | KwType | KwInterface | KwPub | KwImport | KwIf | KwElse | KwMatch | KwIs | KwFor | KwIn | KwReturn | KwBreak | KwContinue | KwDefer | KwFail | KwPure | KwNoalloc | KwAsync | KwAwait | KwUnsafe | KwMove | KwExtern | KwComptime | KwTrue | KwFalse -> true
        _ -> false
    }
}

pub fn Kind.isTrivia(self) -> Bool {
    match self {
        Comment | BlockComment | DocComment -> true
        _ -> false
    }
}

pub fn Kind.isLiteral(self) -> Bool {
    match self {
        IntKind | FloatKind | StringKind | ByteString | CharKind | KwTrue | KwFalse -> true
        _ -> false
    }
}

pub fn Kind.isCompoundAssign(self) -> Bool {
    match self {
        PlusAssign | MinusAssign | StarAssign | SlashAssign | PercentAssign | AmpAssign | PipeAssign | CaretAssign | ShlAssign | ShrAssign -> true
        _ -> false
    }
}

pub fn Kind.binaryOf(self) -> Kind {
    match self {
        PlusAssign -> Plus
        MinusAssign -> Minus
        StarAssign -> Star
        SlashAssign -> Slash
        PercentAssign -> Percent
        AmpAssign -> Amp
        PipeAssign -> Pipe
        CaretAssign -> Caret
        ShlAssign -> Shl
        ShrAssign -> Shr
        _ -> Invalid
    }
}

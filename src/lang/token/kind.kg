pub type Kind = alias u8

pub const Invalid: Kind = 0
pub const BOF: Kind = 1
pub const EOF: Kind = 2
pub const Newline: Kind = 3
pub const Comment: Kind = 4
pub const BlockComment: Kind = 5
pub const DocComment: Kind = 6
pub const Ident: Kind = 7
pub const IntKind: Kind = 8
pub const FloatKind: Kind = 9
pub const StringKind: Kind = 10
pub const ByteString: Kind = 11
pub const CharKind: Kind = 12
pub const Lifetime: Kind = 13
pub const Operator: Kind = 14
pub const LParen: Kind = 15
pub const RParen: Kind = 16
pub const LBracket: Kind = 17
pub const RBracket: Kind = 18
pub const LBrace: Kind = 19
pub const RBrace: Kind = 20
pub const Comma: Kind = 21
pub const Dot: Kind = 22
pub const DotDot: Kind = 23
pub const DotDotEq: Kind = 24
pub const Ellipsis: Kind = 25
pub const Colon: Kind = 26
pub const Semicolon: Kind = 27
pub const At: Kind = 28
pub const Dollar: Kind = 29
pub const Question: Kind = 30
pub const QuestionDot: Kind = 31
pub const Arrow: Kind = 32
pub const FatArrow: Kind = 33
pub const Assign: Kind = 34
pub const Plus: Kind = 35
pub const Minus: Kind = 36
pub const Star: Kind = 37
pub const Slash: Kind = 38
pub const Percent: Kind = 39
pub const Amp: Kind = 40
pub const Pipe: Kind = 41
pub const Caret: Kind = 42
pub const Shl: Kind = 43
pub const Shr: Kind = 44
pub const Bang: Kind = 45
pub const Tilde: Kind = 46
pub const EqEq: Kind = 47
pub const NotEq: Kind = 48
pub const Lt: Kind = 49
pub const LtEq: Kind = 50
pub const Gt: Kind = 51
pub const GtEq: Kind = 52
pub const AndAnd: Kind = 53
pub const OrOr: Kind = 54
pub const PipeGt: Kind = 55
pub const PlusAssign: Kind = 56
pub const MinusAssign: Kind = 57
pub const StarAssign: Kind = 58
pub const SlashAssign: Kind = 59
pub const PercentAssign: Kind = 60
pub const AmpAssign: Kind = 61
pub const PipeAssign: Kind = 62
pub const CaretAssign: Kind = 63
pub const ShlAssign: Kind = 64
pub const ShrAssign: Kind = 65
pub const KwFn: Kind = 66
pub const KwLet: Kind = 67
pub const KwConst: Kind = 68
pub const KwMut: Kind = 69
pub const KwType: Kind = 70
pub const KwInterface: Kind = 71
pub const KwPub: Kind = 72
pub const KwImport: Kind = 73
pub const KwIf: Kind = 74
pub const KwElse: Kind = 75
pub const KwMatch: Kind = 76
pub const KwIs: Kind = 77
pub const KwFor: Kind = 78
pub const KwIn: Kind = 79
pub const KwReturn: Kind = 80
pub const KwBreak: Kind = 81
pub const KwContinue: Kind = 82
pub const KwDefer: Kind = 83
pub const KwFail: Kind = 84
pub const KwPure: Kind = 85
pub const KwNoalloc: Kind = 86
pub const KwAsync: Kind = 87
pub const KwAwait: Kind = 88
pub const KwUnsafe: Kind = 89
pub const KwMove: Kind = 90
pub const KwExtern: Kind = 91
pub const KwComptime: Kind = 92
pub const KwTrue: Kind = 93
pub const KwFalse: Kind = 94

const KindCount: Kind = 95

pub pure fn name(kind: Kind) -> String {
    if kind == Invalid { return "invalid" }
    if kind == BOF { return "BOF" }
    if kind == EOF { return "EOF" }
    if kind == Newline { return "newline" }
    if kind == Comment { return "comment" }
    if kind == BlockComment { return "block comment" }
    if kind == DocComment { return "doc comment" }
    if kind == Ident { return "identifier" }
    if kind == IntKind { return "integer" }
    if kind == FloatKind { return "float" }
    if kind == StringKind { return "string" }
    if kind == ByteString { return "byte string" }
    if kind == CharKind { return "char" }
    if kind == Lifetime { return "lifetime" }
    if kind == Operator { return "operator" }
    if kind == LParen { return "(" }
    if kind == RParen { return ")" }
    if kind == LBracket { return "[" }
    if kind == RBracket { return "]" }
    if kind == LBrace { return "{" }
    if kind == RBrace { return "}" }
    if kind == Comma { return "," }
    if kind == Dot { return "." }
    if kind == DotDot { return ".." }
    if kind == DotDotEq { return "..=" }
    if kind == Ellipsis { return "..." }
    if kind == Colon { return ":" }
    if kind == Semicolon { return ";" }
    if kind == At { return "@" }
    if kind == Dollar { return "$" }
    if kind == Question { return "?" }
    if kind == QuestionDot { return "?." }
    if kind == Arrow { return "->" }
    if kind == FatArrow { return "=>" }
    if kind == Assign { return "=" }
    if kind == Plus { return "+" }
    if kind == Minus { return "-" }
    if kind == Star { return "*" }
    if kind == Slash { return "/" }
    if kind == Percent { return "%" }
    if kind == Amp { return "&" }
    if kind == Pipe { return "|" }
    if kind == Caret { return "^" }
    if kind == Shl { return "<<" }
    if kind == Shr { return ">>" }
    if kind == Bang { return "!" }
    if kind == Tilde { return "~" }
    if kind == EqEq { return "==" }
    if kind == NotEq { return "!=" }
    if kind == Lt { return "<" }
    if kind == LtEq { return "<=" }
    if kind == Gt { return ">" }
    if kind == GtEq { return ">=" }
    if kind == AndAnd { return "&&" }
    if kind == OrOr { return "||" }
    if kind == PipeGt { return "|>" }
    if kind == PlusAssign { return "+=" }
    if kind == MinusAssign { return "-=" }
    if kind == StarAssign { return "*=" }
    if kind == SlashAssign { return "/=" }
    if kind == PercentAssign { return "%=" }
    if kind == AmpAssign { return "&=" }
    if kind == PipeAssign { return "|=" }
    if kind == CaretAssign { return "^=" }
    if kind == ShlAssign { return "<<=" }
    if kind == ShrAssign { return ">>=" }
    if kind == KwFn { return "fn" }
    if kind == KwLet { return "let" }
    if kind == KwConst { return "const" }
    if kind == KwMut { return "mut" }
    if kind == KwType { return "type" }
    if kind == KwInterface { return "interface" }
    if kind == KwPub { return "pub" }
    if kind == KwImport { return "import" }
    if kind == KwIf { return "if" }
    if kind == KwElse { return "else" }
    if kind == KwMatch { return "match" }
    if kind == KwIs { return "is" }
    if kind == KwFor { return "for" }
    if kind == KwIn { return "in" }
    if kind == KwReturn { return "return" }
    if kind == KwBreak { return "break" }
    if kind == KwContinue { return "continue" }
    if kind == KwDefer { return "defer" }
    if kind == KwFail { return "fail" }
    if kind == KwPure { return "pure" }
    if kind == KwNoalloc { return "noalloc" }
    if kind == KwAsync { return "async" }
    if kind == KwAwait { return "await" }
    if kind == KwUnsafe { return "unsafe" }
    if kind == KwMove { return "move" }
    if kind == KwExtern { return "extern" }
    if kind == KwComptime { return "comptime" }
    if kind == KwTrue { return "true" }
    if kind == KwFalse { return "false" }
    "kind(${kind.toInt()})"
}

pub pure noalloc fn isKeyword(kind: Kind) -> Bool {
    kind >= KwFn && kind < KindCount
}

pub pure noalloc fn isTrivia(kind: Kind) -> Bool {
    kind == Comment || kind == BlockComment || kind == DocComment
}

pub pure noalloc fn isLiteral(kind: Kind) -> Bool {
    kind == IntKind || kind == FloatKind || kind == StringKind || kind == ByteString || kind == CharKind || kind == KwTrue || kind == KwFalse
}

pub pure noalloc fn isCompoundAssign(kind: Kind) -> Bool {
    kind >= PlusAssign && kind <= ShrAssign
}

pub pure noalloc fn binaryOf(kind: Kind) -> Kind {
    if kind == PlusAssign { return Plus }
    if kind == MinusAssign { return Minus }
    if kind == StarAssign { return Star }
    if kind == SlashAssign { return Slash }
    if kind == PercentAssign { return Percent }
    if kind == AmpAssign { return Amp }
    if kind == PipeAssign { return Pipe }
    if kind == CaretAssign { return Caret }
    if kind == ShlAssign { return Shl }
    if kind == ShrAssign { return Shr }
    Invalid
}

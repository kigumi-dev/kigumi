import math from std/math
import test from std/test

fn nan() -> Float {
    math.sqrt(-1.0)
}

test "FNV-1a-64 vectors" {
    test.expectEq(sum64(b""), 0xcbf29ce484222325)?
    test.expectEq(sum64(b"a"), 0xaf63dc4c8601ec8c)?
    test.expectEq(sum64(b"abc"), 0xe71fa2190541574b)?
    test.expectEq(sum64(b"foobar"), 0x85944171f73967e8)?
}

test "canonical float" {
    test.expectEq(canonicalFloat64(-0.0) == 0.0, true)?
    test.expectEq(totalEqualFloat64(canonicalFloat64(nan()), nan()), true)?
}

test "float total equality" {
    test.expectEq(totalEqualFloat64(-0.0, 0.0), true)?
    test.expectEq(totalEqualFloat64(nan(), nan()), true)?
    test.expectEq(totalEqualFloat64(nan(), 1.0), false)?
    test.expectEq(totalEqualFloat64(1.0, 2.0), false)?
}

test "float total order" {
    test.expectEq(totalCompareFloat64(nan(), 1.0), 1)?
    test.expectEq(totalCompareFloat64(1.0, nan()), -1)?
    test.expectEq(totalCompareFloat64(nan(), nan()), 0)?
    test.expectEq(totalCompareFloat64(-0.0, 0.0), 0)?
    test.expectEq(totalCompareFloat64(-1.0, 1.0), -1)?
    test.expectEq(totalCompareFloat64(2.0, 1.0), 1)?
}

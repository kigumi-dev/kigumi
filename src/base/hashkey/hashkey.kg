import math from std/math

const offset64: u64 = 0xcbf29ce484222325
const prime64: u64 = 0x100000001b3

pub pure noalloc fn sum64(data: Bytes) -> u64 {
    let mut h: u64 = offset64
    for b in data {
        h = (h ^ b.toU64()).wrappingMul(prime64)
    }
    h
}

pub pure noalloc fn canonicalFloat64(f: Float) -> Float {
    if f == 0.0 {
        return 0.0
    }
    if f != f {
        return math.nan()
    }
    f
}

pub pure noalloc fn totalEqualFloat64(a: Float, b: Float) -> Bool {
    let an = a != a
    let bn = b != b
    if an || bn {
        an && bn
    } else {
        canonicalFloat64(a) == canonicalFloat64(b)
    }
}

pub pure noalloc fn totalCompareFloat64(a: Float, b: Float) -> Int {
    let an = a != a
    let bn = b != b
    if an && bn {
        return 0
    }
    if an {
        return 1
    }
    if bn {
        return -1
    }
    let ca = canonicalFloat64(a)
    let cb = canonicalFloat64(b)
    if ca < cb {
        -1
    } else if ca > cb {
        1
    } else {
        0
    }
}

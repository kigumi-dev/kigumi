import test from std/test

test "splitLine extracts both columns" {
    let c = splitLine(1, "Alice\t2026-08-01")?
    test.expectEq(c.author, "Alice")?
    test.expectEq(c.day, "2026-08-01")?
}

test "parseAll skips blank lines" {
    let commits = parseAll("Alice\t2026-08-01\n\nBob\t2026-08-02\n")?
    test.expectEq(commits.len(), 2)?
}

test "a line without a tab is rejected" {
    if splitLine(1, "garbage") is Ok(_) {
        fail test.failure("should not parse")
    }
}

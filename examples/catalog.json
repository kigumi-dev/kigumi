{
  "examples": [
    {
      "name": "tour",
      "kind": "tutorial",
      "order": 1,
      "level": "beginner",
      "entry": "main.kg",
      "oracle": "run-output",
      "backends": [
        "vm",
        "native"
      ],
      "features": [
        "lang.entry",
        "lang.binding",
        "lang.numeric",
        "lang.numeric.i128",
        "lang.numeric.ops",
        "lang.text",
        "lang.text.buffers",
        "lang.record",
        "lang.adt",
        "lang.pattern",
        "lang.option",
        "lang.generics",
        "lang.error",
        "lang.loop",
        "lang.comptime"
      ],
      "shows": "A guided tour of Kigumi: entry, numeric widths, text, records, patterns, generics, errors, loops and comptime."
    },
    {
      "name": "ownership",
      "kind": "tutorial",
      "order": 2,
      "level": "intermediate",
      "entry": "main.kg",
      "oracle": "run-output",
      "backends": [
        "vm",
        "native"
      ],
      "features": [
        "mem.resource",
        "mem.move",
        "mem.borrow",
        "mem.rc",
        "mem.box",
        "mem.arena",
        "mem.effects",
        "mem.fixed"
      ],
      "shows": "Ownership and memory: resources, defer, partial moves, borrows, Box, Shared/Weak, arenas and stack arrays."
    },
    {
      "name": "data_tools",
      "kind": "tutorial",
      "order": 3,
      "level": "intermediate",
      "entry": "main.kg",
      "oracle": "run-output",
      "backends": [
        "vm",
        "native"
      ],
      "requires": [
        "filesystem",
        "shell"
      ],
      "features": [
        "io.cli",
        "io.stdin",
        "io.fs",
        "io.shell",
        "io.json",
        "module.visibility",
        "module.require",
        "module.test",
        "lang.error"
      ],
      "shows": "A data tool: std/cli, stdin, files, a shell pipeline, JSON/schema, visibility, Require/Replace and module tests."
    },
    {
      "name": "concurrency",
      "kind": "tutorial",
      "order": 4,
      "level": "advanced",
      "entry": "main.kg",
      "oracle": "run-output",
      "backends": [
        "vm",
        "native"
      ],
      "features": [
        "async.future",
        "async.cancel",
        "async.blocking",
        "sync.atomic"
      ],
      "shows": "Async, await, task.spawn, structured children, cancellation, a blocking pool and atomics.",
      "modes": [
        "default",
        "blocking-executor"
      ]
    },
    {
      "name": "ffi_native",
      "kind": "platform",
      "order": 5,
      "level": "advanced",
      "entry": "main.kg",
      "oracle": "run-output",
      "backends": [
        "native"
      ],
      "requires": [
        "c-compiler",
        "linux-x86-64"
      ],
      "features": [
        "ffi.extern",
        "ffi.layout",
        "ffi.export",
        "ffi.memory",
        "ffi.link",
        "ffi.asm",
        "ffi.dl"
      ],
      "shows": "The C ABI: Header/Source/Link, extern(C), layout(C), export(C), CString/CValue/Pin, asm and dl."
    },
    {
      "name": "build_system",
      "kind": "build-graph",
      "order": 6,
      "level": "advanced",
      "oracle": "build-graph",
      "backends": [
        "native"
      ],
      "modes": [
        "reproducible"
      ],
      "requires": [
        "c-compiler",
        "shell"
      ],
      "features": [
        "build.graph",
        "build.freestanding",
        "build.reproducible"
      ],
      "reason": "a build.kg module: configure records the graph and the build-graph oracle executes it instead of running a main.kg.",
      "build": {
        "args": [
          "--big"
        ],
        "produces": [
          "core.a",
          "app"
        ],
        "plan_contains": [
          "\"name\": \"core\"",
          "\"tool\": \"gen\"",
          "\"kind\": \"executable\""
        ],
        "run": {
          "path": "app"
        }
      },
      "shows": "build.kg: a Framework, a code-generating Tool, a freestanding archive and a linked host executable."
    },
    {
      "name": "http_service",
      "kind": "tutorial",
      "order": 7,
      "level": "advanced",
      "entry": "main.kg",
      "oracle": "run-output",
      "backends": [
        "vm",
        "native"
      ],
      "requires": [
        "network-loopback"
      ],
      "features": [
        "net.http",
        "io.json"
      ],
      "shows": "std/net/http: a loopback server and client with routing, middleware, JSON, status codes, timeouts and shutdown."
    },
    {
      "name": "secret",
      "kind": "tutorial",
      "order": 8,
      "level": "advanced",
      "entry": "main.kg",
      "oracle": "run-output",
      "backends": [
        "vm"
      ],
      "modes": [
        "default",
        "secret-san"
      ],
      "features": [
        "secret.ct",
        "secret.buffer",
        "crypto.hash"
      ],
      "shows": "std/secret and std/crypto: SecretU, Choice, constant-time compare/select, SecretBuffer, SecretIndex, SHA-256 and HMAC."
    }
  ]
}

#!/usr/bin/env kigumi

import error from std/error
import {Display} from std/fmt
import text from std/text
import {Ticket} from tour/model
import {banner, clip} from tour/text

// A guided tour in nine sections. As the entry file, its top-level statements
// form an implicit `fn main() -> Void!`, executed in order.
// 1. Entry: consts, immutable and mutable bindings, a discard, and stderr.
const TOUR = "tour"
let host = "kigumi"
let mut stops = 0
stops += 1
_ = TOUR.len()
eprint "note: stderr is ignored by the run-output oracle"
print "1. entry: ${host} ${TOUR}, stop ${stops}"

// 2. Numerics: Int is i64 and Float is f64; every width is explicit.
let i8v: i8 = -128
let i16v: i16 = 32767
let i32v: i32 = -2147483648
let i64v: i64 = 9223372036854775807
let u8v: u8 = 255
let u16v: u16 = 65535
let u32v: u32 = 4294967295
let u64v: u64 = 18446744073709551615
let usizev: usize = 42
let isizev: isize = -42
let f32v: f32 = 1.5
let f64v: Float = 2.25
let bytev: byte = 0x41
print "2. widths: i8=${i8v} i16=${i16v} i32=${i32v} i64=${i64v} u8=${u8v} u16=${u16v} u32=${u32v} u64=${u64v} usize=${usizev} isize=${isizev} f32=${f32v} Float=${f64v} byte=${bytev}"
// `+` panics on overflow; wrapping, rotate, saturating and the flag are methods.
let sum = u8v.addWithOverflow(1)
print "   wrap=${u8v.wrappingAdd(200)} rotate=${u8v.rotateLeft(3)} saturate=${i16v.saturatingAdd(1)}"
print "   overflow=${sum.value}/${sum.overflowed} checked=${300.toU8() || 0}/${65.toU8() || 0}"
let wide: i128 = 170141183460469231731687303715884105727
let uwide: u128 = 340282366920938463463374607431768211455
print "   i128=${wide} plus1=${wide.wrappingAdd(1)} u128=${uwide} high=${uwide >> 64}"

// 3. Text: String is UTF-8, Bytes is raw, Char is one scalar value.
let word = "Kigumi 言語"
let raw: Bytes = word.bytes()
let scalars: Array[Char] = word.chars()
print "3. text: bytes=${raw.len()} chars=${scalars.len()} first=${raw[0]} last=${scalars[scalars.len() - 1]}"
let clusters = text.graphemes("a👍🏽b")
print "   graphemes=${clusters.len()} middle=${clusters[1]} back=${String.fromBytes(raw) || "<invalid>"} clip=${clip(word, 6)}"
// StringBuilder grows a String; ByteBuffer writes bytes in place.
let mut sb = text.StringBuilder.new()
sb.push("built from ${clusters.len()} clusters")
print "   builder=${sb.freeze() || "<invalid>"}"
print "   buffer=${banner("tour", word) || "<oom>"}"

// 4. Records, a private field, self/mut self methods and a Display impl.
let mut ticket = Ticket.new(7, "wire the tour")
print "4. record: ${ticket.display()} status=${ticket.status().display()}"
_ = ticket.advance()
let stage = ticket.advance()
print "   advanced twice: ${ticket.display()} final=${stage.display()}"

// 5. Patterns: match, alternatives, ranges, if let, let else, is, `?.`, T??.
fn classify(n: Int) -> String {
    match n {
        -1 | 0 | 1 -> "unit"
        2..=9 -> "digit"
        _ -> "wide"
    }
}

fn head(xs: Array[String]) -> String {
    let Some(first) = xs.first() else {
        return "<empty>"
    }
    first
}

print "5. patterns: ${classify(-1)} ${classify(5)} ${classify(42)} head=${head(Array.of("first"))}"

type Locker = {
    tag String?
}

let name: String? = Some("A-17")
if let Some(tag) = name {
    print "   if let=${tag}"
}
if name is Some(tag) {
    print "   is=${tag} len=${name?.len() || 0}"
}
let maybe: Locker? = Some(Locker { tag: name })
let nested: String?? = maybe?.tag
let shown = match nested {
    Some(Some(t)) -> "some(some(${t}))"
    Some(None) -> "some(none)"
    None -> "none"
}
print "   optional=${shown}"

// 6. Generics: interface bounds, const parameters, closures, escaping fn.
fn repeated[T: Display, const N: usize](value: T) -> String {
    let mut out = text.StringBuilder.new()
    let mut i: usize = 0
    for i < N {
        out.push("${value.display()} ")
        i = i + 1
    }
    out.freeze() || ""
}

fn adder(base: Int) -> fn(Int) -> Int {
    (x) => x + base
}

print "6. generics: repeat=${repeated[Ticket, 2](ticket)}"
print "   closures=${Array.of(1, 2, 3).map((x) => x * 2).fold(0, (a, b) => a + b)} adder=${adder(10)(5)}"

// 7. Errors: custom Error, `?`, `||`, fail, context and error.as.
type ParseError = NotANumber(text: String) | TooBig(n: Int)

fn ParseError.message(self) -> String {
    match self {
        NotANumber(t) -> "not a number: ${t}"
        TooBig(n) -> "too big: ${n}"
    }
}

fn parseSmall(s: String) -> Result[Int, ParseError] {
    let n = text.parseInt(s) || fail NotANumber(s)
    if n > 99 {
        fail TooBig(n)
    }
    n
}

fn load(s: String) -> Result[Int, ParseError] {
    let n = parseSmall(s)?
    n
}

print "7. errors: load=${load("42") || -1}"
let fallback = load("1000") || (e) => {
    print "   fallback: ${error.context(e, "load").message()}"
    -1
}
print "   fallback=${fallback}"
match load("abc") {
    Ok(n) -> print "   parsed ${n}"
    Err(e) -> {
        match error.as[ParseError](&e) {
            Some(NotANumber(t)) -> print "   as=NotANumber(${t})"
            Some(TooBig(n)) -> print "   as=TooBig(${n})"
            None -> print "   as=none"
        }
    }
}

// 8. Loops: `for cond`, `for x in`, a value-carrying `for {}`, break/continue/return.
fn firstBig(xs: Array[Int]) -> Int {
    for x in xs {
        if x > 3 {
            return x
        }
    }
    0
}

let mut i = 0
let mut evens = 0
for i < 10 {
    i += 1
    if i % 2 == 1 {
        continue
    }
    evens += 1
    if evens == 3 {
        break
    }
}
let found = for {
    i += 1
    if i > 12 {
        break i
    }
}
print "8. loops: i=${i} evens=${evens} found=${found} firstBig=${firstBig(Array.of(3, 4, 5))}"

// 9. Comptime folds a table; a state machine ties the tour together.
const STEPS = 5

fn rule(n: Int) -> Int {
    (n * 7 + 3) % 11
}

let table = comptime {
    let mut line = ""
    for n in 0..STEPS {
        line = "${line}${rule(n)} "
    }
    line
}

type Light = Red | Green | Amber

fn Light.next(self) -> Light {
    match self {
        Red -> Green
        Green -> Amber
        Amber -> Red
    }
}

let mut light = Red
let mut elapsed = 0
let mut story = ""
let stopped = for {
    story = "${story}${debug(&light)} "
    elapsed += 1
    if elapsed >= 8 {
        break elapsed
    }
    light = light.next()
}
print "9. comptime table: ${table}"
print "   lights: ${story}stopped at ${stopped} ticks"

import http from std/net/http
import net from std/net
import task from std/task

pub type TimeoutError = {
    pub url String
}

pub fn TimeoutError.message(self) -> String {
    // Errorへ構造的に適合
    "webhook timeout: ${self.url}"
}

pub type RejectedError = {
    pub status Int
}

pub fn RejectedError.message(self) -> String {
    "webhook rejected: status ${self.status}"
}

pub fn send(n: net.Net, url: String, body: String) -> Void! {
    let client = http.Client.new(n, task.BlockingPool.new(1))
    let res = task.currentThreadExecutor().runToCompletion(client.post(url, body))?
    if res.status >= 400 {
        fail RejectedError { status: res.status }
    }
}

#!/usr/bin/env kigumi

// An async fn call is a lazy Future; await drives it inside another async fn,
// task.spawn starts a child, and the current-thread executor runs the root.
import task from std/task

async fn fetchScore(name: String) -> Int {
    print "fetching ${name}"
    (name.len().toInt() || 0) * 10
}

async fn report(names: Array[String]) -> Int {
    let mut total = 0
    for name in names {
        total = total + await fetchScore(name)
    }
    total
}

async fn runAll() -> Int {
    let job = report(Array.of("ada", "grace"))
    print "nothing has run yet"
    let background = task.spawn(fetchScore("linus"))
    let total = await job
    print "total ${total}"
    let extra = await background
    print "background ${extra}"
    total + extra
}

let ex = task.currentThreadExecutor()
print "sum ${ex.runToCompletion(runAll())}"

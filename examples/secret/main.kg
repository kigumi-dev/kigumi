#!/usr/bin/env kigumi

// Constant-time secret handling and hashing.
//
// No branch below tests a secret value: comparisons stay inside `Choice` masks
// until an explicit declassify. Everything printed is public or declassified,
// so the VM run and the --secret-san shadow run print the same bytes.

import hmac from std/crypto/hmac
import sha256 from std/crypto/sha256
import hex from std/encoding/hex
import secret from std/secret

// -------------------------------------------------------------- helpers

// The print boundary for a u64 that is only secret-labelled. classify and
// declassify keep the exit explicit and visible to the shadow checker.
fn reveal(v: u64) -> u64 {
    unsafe {
        secret.SecretU64.classify(v).declassify()
    }
}

fn revealSecret(v: secret.SecretU64) -> u64 {
    unsafe {
        v.declassify()
    }
}

fn revealU32(v: secret.SecretU32) -> u32 {
    unsafe {
        v.declassify()
    }
}

fn boolText(c: secret.Choice) -> String {
    if unsafe {
        c.declassify()
    } {
        "true"
    } else {
        "false"
    }
}

fn text(b: Bytes) -> String {
    match String.fromBytes(b) {
        Ok(s) -> s
        Err(_) -> "<invalid utf-8>"
    }
}

// ------------------------------------------------------- secret scalars
let a8 = secret.SecretU8.classify(0x2a)
let same8 = a8.ctEq(secret.SecretU8.classify(0x2a))
let other8 = a8.ctEq(secret.SecretU8.classify(0x2b))
print "u8 eq=${boolText(same8)} neq=${boolText(other8)}"

let low16 = secret.SecretU16.classify(1000)
let high16 = secret.SecretU16.classify(2000)
print "u16 lt=${boolText(low16.ctLt(high16))} gt=${boolText(high16.ctLt(low16))}"

// A ctLt mask is all ones when a < b, so selectU32 becomes a branch-free
// minimum or maximum depending on which side it keeps.
fn ctMinU32(x: u32, y: u32) -> secret.SecretU32 {
    let a = secret.SecretU32.classify(x)
    let b = secret.SecretU32.classify(y)
    let lt = a.ctLt(b)
    lt.selectU32(a, b)
}

fn ctMaxU32(x: u32, y: u32) -> secret.SecretU32 {
    let a = secret.SecretU32.classify(x)
    let b = secret.SecretU32.classify(y)
    let lt = a.ctLt(b)
    lt.selectU32(b, a)
}

print "u32 min=${revealU32(ctMinU32(17, 42))} max=${revealU32(ctMaxU32(17, 42))}"

let stored = secret.SecretU64.classify(0x1122334455667788)
let guess = secret.SecretU64.classify(0x1122334455667788)
let hit = stored.ctEq(guess)
// selectU64 keeps the value in the secret domain; only revealSecret opens it.
print "u64 select=${revealSecret(hit.selectU64(stored, secret.SecretU64.classify(0)))}"

// Choices compose with &, | and ~; none of it becomes a Bool early.
let both = same8 & hit
let either = same8 | other8
print "choice and=${boolText(both)} or=${boolText(either)}"

// --------------------------------------------------------- secret buffer
fn passphrase(s: String) -> secret.SecretBuffer {
    secret.SecretBuffer.fromString(s)
}

// Both arguments are owned, compared in constant time, then dropped and
// wiped inside the call; only the declassified Bool leaves.
fn samePassphrase(given: secret.SecretBuffer, expected: secret.SecretBuffer) -> Bool {
    let same = given.ctEq(&expected)
    unsafe {
        same.declassify()
    }
}

print "buffer eq=${samePassphrase(passphrase("correct horse"), passphrase("correct horse"))}"
print "buffer neq=${samePassphrase(passphrase("correct horse"), passphrase("correct horsf"))}"

// length is public; the bytes leave only through declassify, whose copy is
// what remains after the drop wipes the buffer.
let note = secret.SecretBuffer.fromString("release after review")
print "buffer len=${note.len()} text=${text(unsafe { note.declassify() })}"

// ---------------------------------------------------------- secret index
const slots = 4

let mut table = FixedArray.filled[u64, slots](0)
_ = table.set(0, 10)
_ = table.set(1, 20)
_ = table.set(2, 30)
_ = table.set(3, 40)

// The index stays secret: every slot is read and masked, never addressed.
let hidden = secret.SecretIndex[slots].from(secret.SecretU32.classify(2))
print "lookup=${reveal(secret.ctLookupU64(&table, hidden))}"

// An index past the end selects nothing instead of trapping.
let past = secret.SecretIndex[slots].from(secret.SecretU32.classify(9))
print "lookup past end=${reveal(secret.ctLookupU64(&table, past))}"

// ctUpdateU64 rewrites every slot through the same mask, so only slot 2 moves.
secret.ctUpdateU64(&mut table, hidden, 99)
print "after update=${reveal(table.get(2) || 0)} untouched=${reveal(table.get(0) || 0)}"

// --------------------------------------------------------------- hashing
const message = "the quick brown fox jumps over the lazy dog"
const macKey = "kigumi-secret-example"

print "sha256 ${hex.encode(sha256.sum(message.toBytes()))}"

let macKeyBuf = secret.SecretBuffer.fromString(macKey)
let macMessage = secret.SecretBuffer.fromString(message)
let macOther = secret.SecretBuffer.fromString("${message}!")
let tagSecret = hmac.sum[sha256.SecretHasher](&macKeyBuf, &macMessage)
let tag = unsafe {
    tagSecret.copy().declassify()
}
print "hmac ${hex.encode(tag)}"
print "hmac verify=${(unsafe { hmac.verify[sha256.SecretHasher](&macKeyBuf, &macMessage, tag).declassify() })}"
print "hmac reject=${(unsafe { hmac.verify[sha256.SecretHasher](&macKeyBuf, &macOther, tag).declassify() })}"

// Hashing a declassified buffer yields a public digest; the secret itself is
// gone by then.
let blob = secret.SecretBuffer.fromString("audit-me")
print "sha256 declassified=${hex.encode(sha256.sum(unsafe { blob.declassify() }))}"

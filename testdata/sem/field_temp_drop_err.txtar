-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn mk(id: Int) -> Res {
    Res { id: id }
}

fn eat(r: Res) {}

type Inner = {
    pub a Res
    pub b Res
}

type Guard = resource {
    pub inner Inner
    pub a2 Res
    pub o Res?
}

fn Guard.drop(move self) {}

fn mkg(i: Int) -> Guard {
    Guard { inner: Inner { a: mk(i), b: mk(i + 1) }, a2: mk(i + 2), o: None }
}

type Maker = {
    pub n Int
}

fn Maker.guard(self) -> Guard {
    mkg(self.n)
}

type W = {
    pub g Guard
}

fn mkw(i: Int) -> W {
    W { g: mkg(i) }
}

fn plainTail() -> Res {
    mkg(1).a2 //~ ERROR cannot move `mkg(1).a2` out of `Guard`
}

fn viaOr(o: Res?) -> Res {
    o || mkg(2).a2 //~ ERROR cannot move `mkg(2).a2` out of `Guard`
}

fn viaIf(c: Bool, y: Res) -> Res {
    if c { mkg(3).a2 } else { y } //~ ERROR cannot move `mkg(3).a2` out of `Guard`
}

fn viaLet() -> Res {
    let r = mkg(4).a2 //~ ERROR cannot move `mkg(4).a2` out of `Guard`
    r
}

fn viaPayload(y: Res) -> Res {
    mkg(5).o || y //~ ERROR cannot move `mkg(5).o` out of `Guard`
}

fn viaArg() {
    eat(mkg(6).a2) //~ ERROR cannot move `mkg(6).a2` out of `Guard`
}

fn nested(o: Res?) -> Res {
    o || mkg(7).inner.a //~ ERROR cannot move `mkg(7).inner.a` out of `Guard`
}

fn chained(m: Maker) -> Res {
    m.guard().inner.a //~ ERROR cannot move `m.guard().inner.a` out of `Guard`
}

fn middleLink() -> Res {
    mkw(8).g.inner.a //~ ERROR cannot move `mkw(8).g.inner.a` out of `Guard`
}

fn moveNested(o: Res?) -> Res {
    o || move mkg(9).inner.a //~ ERROR cannot move `mkg(9).inner.a` out of `Guard`
}

fn moveChained(m: Maker) -> Res {
    move m.guard().inner.a //~ ERROR cannot move `m.guard().inner.a` out of `Guard`
}

fn moveMiddleLink() -> Res {
    let r = move mkw(10).g.inner.a //~ ERROR cannot move `mkw(10).g.inner.a` out of `Guard`
    r
}

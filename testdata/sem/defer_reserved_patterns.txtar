-- module --
mir: planned
-- src --
type Handle = resource {
    pub id Int
}

fn Handle.drop(move self) {}

fn Handle.close(move self) {}

fn Handle.peek(self) -> Int {
    self.id
}

type Pack = {
    pub mut inner Handle
    pub mut other Handle
    pub mut n Int
}

type Outer = {
    pub pack Pack
    pub tag Int
}

type Shape = Boxed(Handle) | Empty

fn sink(n: Int) {}

fn mkh(n: Int) -> Handle {
    Handle { id: n }
}

fn mk() -> Pack {
    Pack { inner: mkh(1), other: mkh(2), n: 0 }
}

fn matchField() {
    let b = mk()
    defer { b.inner.close() }
    match b { //~ ERROR
        Pack { inner, other: _, n: _ } -> inner.close()
    }
}

fn matchFieldRenamed() {
    let b = mk()
    defer { b.inner.close() }
    match b { //~ ERROR
        Pack { inner: taken, other: _, n: _ } -> taken.close()
    }
}

fn ifLetField() {
    let b = mk()
    defer { b.inner.close() }
    if let Pack { inner, other: _, n: _ } = b { //~ ERROR
        inner.close()
    }
}

fn isPattern() {
    let s = Boxed(mkh(1))
    defer {
        match s {
            Boxed(h) -> h.close()
            Empty -> {}
        }
    }
    if s is Boxed(h) { //~ ERROR
        h.close()
    }
}

fn letDestructure() {
    let b = mk()
    defer { b.inner.close() }
    let Pack { inner, other: _, n: _ } = b //~ ERROR
    inner.close()
}

fn matchWholeBinding() {
    let b = mk()
    defer { b.inner.close() }
    match b { //~ ERROR
        whole -> whole.other.close()
    }
}

fn matchWholeHandle() {
    let h = mkh(1)
    defer { h.close() }
    match h { //~ ERROR
        taken -> taken.close()
    }
}

fn nestedPattern() {
    let o = Outer { pack: mk(), tag: 0 }
    defer { o.pack.inner.close() }
    match o { //~ ERROR
        Outer { pack: Pack { inner, other: _, n: _ }, tag: _ } -> inner.close()
    }
}

fn nestedBindsParent() {
    let o = Outer { pack: mk(), tag: 0 }
    defer { o.pack.inner.close() }
    match o { //~ ERROR
        Outer { pack, tag: _ } -> pack.other.close()
    }
}

fn variantPayload() {
    let s = Boxed(mkh(1))
    defer {
        match s {
            Boxed(h) -> h.close()
            Empty -> {}
        }
    }
    match s { //~ ERROR
        Boxed(h) -> h.close()
        Empty -> {}
    }
}

fn failMatchField() -> Void! {
    let b = mk()
    defer(fail) { b.inner.close() }
    match b { //~ ERROR
        Pack { inner, other: _, n: _ } -> inner.close()
    }
    sink(0)
}

fn failMatchFieldAsSuccessExit() -> Void! {
    let b = mk()
    defer(fail) { b.inner.close() }
    match b {
        Pack { inner, other: _, n: _ } -> inner.close()
    }
}

fn cleanupDestructuresThenMoves() {
    let b = mk()
    defer {
        match b {
            Pack { inner, other: _, n: _ } -> inner.close()
        }
    }
    b.inner.close() //~ ERROR
}

fn assignerBeforeConsumer() {
    let mut h = mkh(1)
    defer { h = mkh(2) } //~ ERROR
    defer { h.close() }
}

fn failAssignerBeforeConsumer() -> Void! {
    let mut h = mkh(1)
    defer(fail) { h = mkh(2) } //~ ERROR
    defer { h.close() }
}

fn assignerOfWholeBeforeFieldConsumer() {
    let mut b = mk()
    defer { b = mk() } //~ ERROR
    defer { b.inner.close() }
}

fn siblingFieldDestructure() {
    let b = mk()
    defer { b.inner.close() }
    match b {
        Pack { other, inner: _, n: _ } -> other.close()
    }
}

fn copyFieldDestructure() {
    let b = mk()
    defer { b.inner.close() }
    match b {
        Pack { n, inner: _, other: _ } -> sink(n)
    }
}

fn borrowedScrutinee() {
    let b = mk()
    defer { b.inner.close() }
    match &b {
        Pack { inner, other: _, n: _ } -> sink(inner.peek())
    }
}

fn borrowedParam(b: &Pack) {
    match b {
        Pack { inner, other: _, n: _ } -> sink(inner.peek())
    }
}

fn wildcardArm() {
    let b = mk()
    defer { b.inner.close() }
    match b {
        Pack { inner: _, other: _, n: _ } -> {}
    }
}

fn lambdaReadsReservedField() {
    let b = mk()
    defer { b.inner.close() }
    let f = () => b.inner.peek()
    sink(f())
}

fn lambdaReadsSiblingThenReturnsReserved() {
    let b = mk()
    defer { b.inner.close() }
    let f = () => {
        sink(b.other.peek())
        b.inner //~ ERROR
    }
    _ = f
}

fn lambdaReadsSiblingField() {
    let b = mk()
    defer { b.inner.close() }
    let f = () => b.other.peek()
    sink(f())
}

fn lambdaReadsSiblingTwice() {
    let b = mk()
    defer { b.inner.close() }
    let f = () => b.other.peek() + b.n
    sink(f())
}

fn failLambdaReadsSiblingField() -> Void! {
    let b = mk()
    defer(fail) { b.inner.close() }
    let f = () => b.other.peek()
    sink(f())
}

fn assignerWithoutConsumer() {
    let mut h = mkh(1)
    defer { h = mkh(2) }
    sink(h.peek())
}

fn assignerOfSiblingField() {
    let mut b = mk()
    defer { b.other = mkh(5) }
    defer { b.inner.close() }
}

fn assignerAfterBorrowOnlyConsumer() {
    let mut h = mkh(1)
    defer { sink(h.peek()) }
    defer { h = mkh(2) }
}

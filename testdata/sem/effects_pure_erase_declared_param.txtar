-- src --
pure fn add1(x: Int) -> Int {
    x + 1
}

// The callback is declared pure, so erasing the relay to a pure fn type leaves nothing to defer.
fn relayP(f: pure fn(Int) -> Int, x: Int) -> Int {
    f(x)
}

fn relayForward(f: pure fn(Int) -> Int, x: Int) -> Int {
    relayP(f, x)
}

fn relayPlain(f: fn(Int) -> Int, x: Int) -> Int {
    f(x)
}

fn erased() -> Int {
    let g: pure fn(pure fn(Int) -> Int, Int) -> Int = relayP
    let h: pure fn(pure fn(Int) -> Int, Int) -> Int = relayForward
    g(add1, 1) + h(add1, 2)
}

fn plainParam() -> Int {
    let g: pure fn(fn(Int) -> Int, Int) -> Int = relayPlain //~ ERROR `relayPlain` is not `pure`
    g((x: Int) => x, 1)
}

fn main() -> Void! {
    print "${erased()}"
}
-- expect --
error[E1060]: `relayPlain` is not `pure` (calls `f`, whose effect is not fixed)
  --> main/main.kg:25:50
   |
25 |     let g: pure fn(fn(Int) -> Int, Int) -> Int = relayPlain //~ ERROR `relayPlain` is not `pure`
   |                                                  ^^^^^^^^^^
   = help: declare `f` as `pure fn(...)`, or call `relayPlain` directly instead of using it as a value


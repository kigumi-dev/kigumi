}

type Secret[T] = T

type Twice[T] = Secret[Secret[T]]

fn count(w: &W[Int]) -> Int {
    w.value.len()
}

fn make() -> Int {
    let w: W[Int] = W(Array.empty())
    w.value.len()
}

fn main() {

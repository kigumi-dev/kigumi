pub fn holeInPlace['a](k1: Sink['a], k2: Sink['a]) -> usize {
    let hn = Hn { n: 1 }
    let ra: R0['a, fn(&'a String, Sink['a]) -> Void] = R0 { cb: nop, k: k1 }
    let rb: R0['a, fn(&'a String, Sink['a]) -> Void] = R0 { cb: keep, k: k2 }
    let x = hn.measure2(1, ra)
    x + (rb |> (hn.measure2)(1, _)) //~ ERROR cannot be erased
}
pub fn inClosure['a](k2: Sink['a]) -> usize {
    let hn = Hn { n: 1 }
    let cl = (k: Sink['a]) => {
        let r: R0['a, fn(&'a String, Sink['a]) -> Void] = R0 { cb: keep, k: k }
        let f = hn.measure
        f(r) //~ ERROR cannot be erased
    }
    cl(k2)
}

-- src --
const UBIG = 1 << 70

type R = { v Int }

fn keep[T: Copy](x: T) -> T { x }

fn main() {
    let a: Int? = 1 << 64 //~ ERROR `18446744073709551616` does not fit `Int`
    let b: Int? = 18446744073709551616 //~ ERROR `18446744073709551616` does not fit `Int`
    let c: Int? = (1 << 70) >> 5 //~ ERROR `36893488147419103232` does not fit `Int`
    let d: Int? = UBIG //~ ERROR `1180591620717411303424` does not fit `Int`
    let u: u8? = 300 //~ ERROR `300` does not fit `u8`
    let r: Result[u8, String] = 256 //~ ERROR `256` does not fit `u8`
    let arr: Array[Int] = Array.of(1 << 64) //~ ERROR `18446744073709551616` does not fit `Int`
    let rec = R { v: 1 << 64 } //~ ERROR `18446744073709551616` does not fit `Int`
    let k: Int = keep(1 << 64) //~ ERROR `18446744073709551616` does not fit `Int`
    let ok: Int? = (1 << 63) - 1
    let ok2: u8? = 255
    let ok3: Result[u8, String] = 255
}

-- src --
type Pair = {
    a Int
    b Int
}

fn widen(x: u16) -> u32 {
    x.truncate[u32]() //~ ERROR cannot be the target
}

fn float_target(x: u64) -> f64 {
    x.truncate[f64]() //~ ERROR cannot be the target
}

fn bool_target(x: u8) -> Bool {
    x.truncate[Bool]() //~ ERROR cannot be the target
}

fn record_target(x: u8) -> Pair {
    x.truncate[Pair]() //~ ERROR cannot be the target
}

fn generic_target[T](x: u64) -> T {
    x.truncate[T]() //~ ERROR cannot be the target
}

fn missing(x: u32) -> u8 {
    x.truncate() //~ ERROR needs its target type
}

fn missing_with_hint(x: u32) -> u8 {
    let y: u8 = x.truncate() //~ ERROR needs its target type
    y
}

fn too_many(x: u32) -> u8 {
    x.truncate[u8, u16]() //~ ERROR takes 1 type argument
}

fn float_source(x: f64) -> u8 {
    x.truncate[u8]() //~ ERROR no field or method
}

fn usize_is_64(x: u32) -> usize {
    x.truncate[usize]() //~ ERROR cannot be the target
}

fn borrow_target(x: u32) -> u8 {
    x.truncate[&u8]() //~ ERROR borrow types cannot appear
}

fn missing_open(x: u32) {
    let q = x.truncate() //~ ERROR needs its target type
    let _ = q
}

fn missing_empty(x: u32) {
    let q = x.truncate[]() //~ ERROR needs its target type
    let _ = q
}

fn ok(a: u64, b: i8, c: usize, d: Int) -> u8 {
    let w = a.truncate[u32]()
    let s = b.truncate[u8]()
    let z = c.truncate[u64]()
    let i = d.truncate[byte]()
    w.truncate[u8]() + s + z.truncate[u8]() + i
}

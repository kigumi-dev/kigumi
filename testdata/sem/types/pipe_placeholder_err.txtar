fn sub(a: Int, b: Int) -> Int { a - b }
fn g(a: Int) -> Int { a }
fn log(tag: String, rest: ...Int) -> usize { rest.len() }

fn use() {
    _ = 1 |> sub(_, _) //~ ERROR this stage has more than one `_` placeholder
    _ = 1 |> sub(a: _, b: _) //~ ERROR this stage has more than one `_` placeholder
    _ = 1 |> sub(_ + 1, 2) //~ ERROR `_` here is not a whole direct argument of this stage's call
    _ = 1 |> sub(g(_), 2) //~ ERROR `_` here is not a whole direct argument of this stage's call
    _ = 1 |> sub(2, 3) //~ ERROR `sub` expects 2 arguments, 3 given
    _ = sub(_, 2) //~ ERROR `_` is only a pattern or an assignment target
    _ = 1 |> log("t", ..._) //~ ERROR `_` here is not a whole direct argument of this stage's call
    _ = 1 |> sub(c: _, a: 2) //~ ERROR `sub` has no parameter named `c`
    _ = 1 |> sub(a: 2, a: _) //~ ERROR argument `a` given more than once
    _ = "s" |> sub(_, 1) //~ ERROR expected `Int`, found `String`
    _ = 1 |> g(_)
    _ = 1 |> log("t", _, _) //~ ERROR this stage has more than one `_` placeholder
}

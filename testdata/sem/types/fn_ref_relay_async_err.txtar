-- module --
mir: planned
-- src --
import task from std/task

async fn pushA(v: &mut Array[String]) { v.push("A") }
async fn pushB(v: &mut Array[String]) {
    await task.yieldNow()
    v.push("B-written-${40 + 2}")
}
fn sel[T, F: Fn[fn() -> T]](x: T, g: F) -> T { g() }
fn id[T](x: T) -> T { x }
fn consume(a: Array[String]) -> usize { a.len() }

interface Maker[T] { fn make(self) -> T }
type MakeB = { pub n Int }
fn MakeB.make(self) -> fn(&mut Array[String]) -> Future[Void] { pushB }
fn viaMaker[T, M: Maker[T]](x: T, m: M) -> T { m.make() }

pub fn viaClosure() {
    let ex = task.currentThreadExecutor()
    let h = sel(pushA, () => pushB)
    let mut v = Array.of("init-${1}")
    let fut = h(&mut v)
    v.push("during") //~ ERROR `v` is exclusively borrowed
    ex.runToCompletion(fut)
}

pub fn viaInterface() {
    let ex = task.currentThreadExecutor()
    let h = viaMaker(pushA, MakeB { n: 1 })
    let mut v = Array.of("init-${1}")
    let fut = h(&mut v)
    v.push("during") //~ ERROR `v` is exclusively borrowed
    ex.runToCompletion(fut)
}

pub fn movedAway() {
    let ex = task.currentThreadExecutor()
    let h = sel(pushA, () => pushB)
    let mut v = Array.of("init-${1}")
    let fut = h(&mut v)
    let n = consume(v) //~ ERROR `v` is borrowed and cannot be moved
    ex.runToCompletion(fut)
}

pub fn viaId() {
    let ex = task.currentThreadExecutor()
    let h = id(pushA)
    let mut v = Array.of("init-${1}")
    let fut = h(&mut v)
    v.push("during") //~ ERROR `v` is exclusively borrowed
    ex.runToCompletion(fut)
}

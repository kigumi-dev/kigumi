mir: planned
-- src --
pub type V['a] = { pub s &'a String }
pub type Sink['a] = { pub mut items &'a mut Array[V['a]] }

fn keep['a](x: &'a String, k: Sink['a]) { k.items.push(V { s: x }) }
fn mkKeep['a](s: &'a Int) -> fn(&'a String, Sink['a]) -> Void { keep }

fn drive['a, F: Fn[fn(&String, Sink['a]) -> Void]](f: F, k: Sink['a]) {
    let loc = "local-${40 + 2}"
    f(&loc, k)
}

fn drive2['a, F: Fn[fn(&'a Int) -> fn(&String, Sink['a]) -> Void]](f: F, n: &'a Int, k: Sink['a]) {
    let loc = "local-${40 + 2}"
    let g = f(n)
    g(&loc, k)
}

fn outer['a, G: Fn[fn(&'a String, Sink['a]) -> Void]](g: G, k: Sink['a]) {
    drive(g, k) //~ ERROR reference lifetime of `function value` cannot be erased
}

fn outer2['a, G: Fn[fn(&'a Int) -> fn(&'a String, Sink['a]) -> Void]](g: G, n: &'a Int, k: Sink['a]) {
    drive2(g, n, k) //~ ERROR reference lifetime of `function value` cannot be erased
}

pub fn attack['a](k: Sink['a]) { outer(keep, k) }

pub fn attack2['a](n: &'a Int, k: Sink['a]) { outer2(mkKeep, n, k) }

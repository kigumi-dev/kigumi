pub type V['a] = { pub s &'a String }
pub type Sink['a] = { pub mut items &'a mut Array[V['a]] }
fn keep['a](x: &'a String, k: Sink['a]) { k.items.push(V { s: x }) }
fn nop['a](x: &'a String, k: Sink['a]) { }
fn mkKeep['a](n: Int) -> fn(&'a String, Sink['a]) -> Void { keep }
fn mkNop['a](n: Int) -> fn(&'a String, Sink['a]) -> Void { nop }
pub interface Feeder['a] { fn feed(self, f: fn(Int) -> fn(&'a String, Sink['a]) -> Void, k: Sink['a]) }
pub type R4['a, F: Fn[fn(Int) -> fn(&String, Sink['a]) -> Void]] = { pub cb F }
pub fn R4['a, F].feed(self, f: F, k: Sink['a]) { }
fn useF['a, R: Feeder['a]](r: R, k: Sink['a]) { r.feed(mkKeep, k) }
pub fn annotated['a](k: Sink['a]) {
    let r: R4['a, fn(Int) -> fn(&'a String, Sink['a]) -> Void] = R4 { cb: mkNop }
    useF(r, k) //~ ERROR cannot be erased
}
pub fn inferred['a](k: Sink['a]) {
    let r = R4 { cb: mkNop }
    useF(r, k) //~ ERROR cannot be erased
}


pub type HN['a] = { pub n Int }
fn HN['a].useF1[R: Feeder1['a]](self, r: R) { r.feed1(mkKeep) }
fn useF1['a, R: Feeder1['a]](r: R) { r.feed1(mkKeep) }
pub fn method['a](k: Sink['a]) {
    let r: R5['a, fn(Int) -> fn(&'a String, Sink['a]) -> Void] = R5 { cb: mkNop }
    let hn: HN['a] = HN { n: 1 }

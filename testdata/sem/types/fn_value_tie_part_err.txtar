-- module --
mir: planned
-- src --
type V['a] = { pub s &'a String }
type R2['a] = { pub mut v V['a], pub mut w V['a] }
fn mkV['a](s: &'a String) -> V['a] { V { s: s } }
fn putMut[U](out: &mut U, items: &mut Array[String], f: fn(&String) -> U) { out = f(&items[0]) }
fn putSome[U](out: &mut U, items: &mut Array[String], f: fn(&String) -> U, go: Bool) { if go { out = f(&items[0]) } }
fn R2['a].swap(mut self) {
    let t = self.v
    self.v = self.w
    self.w = t
}
fn swapped() -> usize {
    let k = "k"
    let mut items = Array.of("i1", "i22")
    let mut other = Array.of("o1", "o2")
    let mut r = R2 { v: mkV(&k), w: mkV(&k) }
    putMut(&mut r.v, &mut items, mkV)
    r.swap()
    putMut(&mut r.v, &mut other, mkV)
    items.push("x") //~ ERROR `items` is borrowed and cannot be mutated
    r.w.s.len()
}
fn inserted() -> usize {
    let k = "k"
    let mut items = Array.of("i1", "i22")
    let mut other = Array.of("o1", "o2")
    let mut arr = Array.of(mkV(&k))
    putMut(&mut arr[0], &mut items, mkV)
    let ok = arr.insertAt(0, mkV(&k))
    putMut(&mut arr[0], &mut other, mkV)
    items.push("x") //~ ERROR `items` is borrowed and cannot be mutated
    arr[1].s.len()
}
fn looped() -> usize {
    let k = "k"
    let mut items = Array.of("i1", "i22")
    let mut other = Array.of("o1", "o2")
    let mut arr = Array.of(mkV(&k), mkV(&k))
    for i in 0..2 {
        putMut(&mut arr[i], &mut items, mkV) //~ ERROR `items` is borrowed and cannot be mutated
    }
    putMut(&mut arr[0], &mut other, mkV)
    items.push("x") //~ ERROR `items` is borrowed and cannot be mutated
    arr[1].s.len()
}
fn otherField() -> usize {
    let k = "k"
    let mut items = Array.of("i1", "i22")
    let mut other = Array.of("o1", "o2")
    let mut r = R2 { v: mkV(&k), w: mkV(&k) }
    putMut(&mut r.v, &mut items, mkV)
    putMut(&mut r.w, &mut other, mkV)
    items.push("x") //~ ERROR `items` is borrowed and cannot be mutated
    r.v.s.len()
}
fn otherIndex() -> usize {
    let k = "k"
    let mut items = Array.of("i1", "i22")
    let mut other = Array.of("o1", "o2")
    let mut arr = Array.of(mkV(&k), mkV(&k))
    putMut(&mut arr[0], &mut items, mkV)
    putMut(&mut arr[1], &mut other, mkV)
    items.push("x") //~ ERROR `items` is borrowed and cannot be mutated
    arr[0].s.len()
}
fn some() -> usize {
    let k = "k"
    let mut items = Array.of("i1", "i22")
    let mut other = Array.of("o1", "o2")
    let mut r = R2 { v: mkV(&k), w: mkV(&k) }
    putMut(&mut r.v, &mut items, mkV)
    putSome(&mut r.v, &mut other, mkV, false)
    items.push("x") //~ ERROR `items` is borrowed and cannot be mutated
    r.v.s.len()
}
fn copied() -> usize {
    let k = "k"
    let mut items = Array.of("i1", "i22")
    let mut other = Array.of("o1", "o2")
    let mut r = R2 { v: mkV(&k), w: mkV(&k) }
    putMut(&mut r.v, &mut items, mkV)
    r.w = r.v
    putMut(&mut r.v, &mut other, mkV)
    items.push("x") //~ ERROR `items` is borrowed and cannot be mutated
    r.w.s.len()
}
fn main() { print "${swapped()} ${inserted()} ${looped()} ${otherField()} ${otherIndex()} ${some()} ${copied()}" }

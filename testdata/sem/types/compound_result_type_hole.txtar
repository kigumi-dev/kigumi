pub type Money = {
    pub cents Int
}

pub pure fn Money.+(a: Money, b: Money) -> Int {
    a.cents + b.cents
}

fn use(a: Money, b: Money) {
    let mut m = a
    m += b //~ ERROR `+` on (`Money`, `Money`) yields `Int`, not `Money`
}

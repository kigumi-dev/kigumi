import a from lib/a

fn use(n: Int, s: String) -> Int {
    let one = match n {
        a.K -> 1
        _ -> 0
    }
    let two = match n {
        a.Nope -> 1 //~ ERROR package `lib/a` has no visible `Nope`
        _ -> 0
    }
    let three = match s {
        a.K -> 1 //~ ERROR literal pattern `K` does not fit `String`
        _ -> 0
    }
    let four = match n {
        a.K(x) -> 1 //~ ERROR `K` has 0 payloads, 1 pattern given
        _ -> 0
    }
    let five = match n {
        a.Flag -> 1 //~ ERROR literal pattern `Flag` does not fit `Int`
        _ -> 0
    }
    one + two + three + four + five
}

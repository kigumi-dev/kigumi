pub type R0['a, F] = { pub n Int }
pub fn R0['a, F: Fn[fn(Int) -> fn(&String, Sink['a]) -> Void]].run(self, f: F) { }
pub type Hn = { pub n Int }
fn Hn.useR3['a, R: Runner2[fn(Int) -> fn(&'a String, Sink['a]) -> Void]](self, r: R, k: Sink['a]) { r.run(mkKeep) }
pub fn declBound['a](k: Sink['a]) {
    let r: R1['a, fn(Int) -> fn(&'a String, Sink['a]) -> Void] = R1 { n: 1 }
    let hn = Hn { n: 1 }
    let f = hn.useR3

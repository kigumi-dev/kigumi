const XF: Float = 8
const F: f32 = 5
const Y = XF << 1 //~ ERROR no operator `<<` for (Float, {integer})
const Z = 1 << XF //~ ERROR shift count must be `usize`, found `Float`

fn main() {
    let a = XF << 1 //~ ERROR
    let b = XF % 3
    let c = XF & 1 //~ ERROR
    let d = ~XF //~ ERROR
    let e = 1 << XF //~ ERROR
    let f = F << 2 //~ ERROR
    print "${a} ${b} ${c} ${d} ${e} ${f}"
}

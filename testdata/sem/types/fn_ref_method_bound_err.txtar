    let x: &Runner2[fn(Int) -> fn(&'a String, Sink['a]) -> Void] = &r //~ ERROR cannot be erased
    x.run(mkKeep)
}
pub interface Sized2 { fn size(self) -> Int }
pub fn R0['a, F: Fn[fn(Int) -> fn(&String, Sink['a]) -> Void]].size(self) -> Int { 1 }
fn useS[R: Sized2](r: R) -> Int { r.size() }
pub fn sized['a](k: Sink['a]) -> Int {
    let r: R0['a, fn(Int) -> fn(&'a String, Sink['a]) -> Void] = R0 { n: 1 }

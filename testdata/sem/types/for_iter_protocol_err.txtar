type Boxed[T] = {
    pub limit Int
}

type BoxedCursor[T] = {
    mut i Int
    limit Int
}

fn Boxed[T].iter(self) -> BoxedCursor[T] {
    BoxedCursor { i: 0, limit: self.limit }
}

fn BoxedCursor[T].next(mut self) -> Int? {
    if self.i >= self.limit {
        None
    } else {
        let v = self.i
        self.i = self.i + 1
        Some(v)
    }
}

fn genericNext(b: Boxed[String]) {
    for v in b { _ = v } //~ ERROR a `for` iterator whose `next` is a method of a generic iterator type
}

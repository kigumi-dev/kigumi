-- module --
mir: planned
-- src --
pub type V['a] = { pub s &'a String }
pub type Sink['a] = { pub mut items &'a mut Array[V['a]] }

fn keep['a](x: &'a String, k: Sink['a]) { k.items.push(V { s: x }) }
fn nop['a](x: &'a String, k: Sink['a]) { }
fn mkKeep['a](n: Int) -> fn(&'a String, Sink['a]) -> Void { keep }
fn mkNop['a](n: Int) -> fn(&'a String, Sink['a]) -> Void { nop }
fn drive['a, F: Fn[fn(&String, Sink['a]) -> Void]](f: F, k: Sink['a]) {
    let loc = "local-${40 + 2}"
    f(&loc, k)
}

pub type Box[F] = { pub mut cb F }
pub interface Driver { fn run['a, F: Fn[fn(Int) -> fn(&String, Sink['a]) -> Void]](self, o: Option[F], k: Sink['a]) }
pub interface DriverB { fn run['a, F: Fn[fn(Int) -> fn(&String, Sink['a]) -> Void]](self, o: Box[F], k: Sink['a]) }

pub fn requirementOption['a, D: Driver](d: D, k: Sink['a]) {
    d.run(Some(mkKeep), k) //~ ERROR cannot be erased
}

pub fn requirementBox['a, D: DriverB](d: D, k: Sink['a]) {
    d.run(Box { cb: mkKeep }, k) //~ ERROR cannot be erased
}

pub fn requirementSafe['a, D: Driver](d: D, k: Sink['a]) { d.run(Some(mkNop), k) }

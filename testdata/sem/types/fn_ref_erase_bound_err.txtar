fn keepVia['a](x: &'a String, cb: fn(&'a String) -> Void) { cb(x) }
fn nopVia['a](x: &'a String, cb: fn(&'a String) -> Void) { }
fn callErased['b](f: fn(&String, fn(&'b String) -> Void) -> Void, cb: fn(&'b String) -> Void) {
    let loc = "local${40 + 2}"
    f(&loc, cb)
}
fn apply2[T, F: Fn[fn(T) -> T]](x: T, f: F) -> T { f(x) }
fn sel2[T, F: Fn[fn() -> T]](x: T, g: F, flag: Bool) -> T { if flag { x } else { g() } }
fn id[T](x: T) -> T { x }

pub fn direct['a](cb: fn(&'a String) -> Void) {

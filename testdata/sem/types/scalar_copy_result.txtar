fn id[T](x: T) -> T { x }

fn tupleThroughCall(b: &mut B) {
    let B { n, m } = b
    let t = id((n, 0)) //~ ERROR `n` holds a copy of the scalar from a `&mut` match, so a callee's write through it is lost
    let (r, _) = t

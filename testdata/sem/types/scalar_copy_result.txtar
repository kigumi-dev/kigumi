type B = { pub mut n Int, pub mut m Int }

fn pick(b: &mut B) -> &mut Int {
    match b {
        B { n } -> n //~ ERROR `n` holds a copy of the scalar from a `&mut` match
    }
}

fn pickReturn(b: &mut B) -> &mut Int {
    match b {
        B { n } -> {
            return n //~ ERROR `n` holds a copy of the scalar from a `&mut` match
        }
    }
}

fn pickLet(b: &mut B) -> &mut Int {
    match b {
        B { m } -> {
            let r = m
            r //~ ERROR `r` holds a copy of the scalar from a `&mut` match
        }
    }
}

type H['a] = { pub r &'a mut Int }

fn pickStore['a](b: &'a mut B) -> H['a] {
    match b {
        B { n } -> H { r: n } //~ ERROR `n` holds a copy of the scalar from a `&mut` match
    }
}

fn pickLetStore['a](b: &'a mut B) -> H['a] {
    let B { n, m } = b
    H { r: n } //~ ERROR `n` holds a copy of the scalar from a `&mut` match
}

fn bump(x: &mut Int) { x = x + 1 }

fn pickTuple(b: &mut B) {
    match b {
        B { n } -> {
            let t = (n, 0)
            let (r, _) = t
            bump(r) //~ ERROR `r` holds a copy of the scalar from a `&mut` match, so a callee's write through it is lost
        }
    }
}

fn readTupleByValue(b: &mut B) -> Int {
    match b {
        B { n } -> {
            let t = (n + 0, 1)
            let (x, _) = t
            x + 0
        }
    }
}

fn readTuple(b: &mut B) -> Int {
    match b {
        B { n } -> {
            let t = (n, 1)
            let (x, _) = t
            x + 0
        }
    }
}

fn pickIf(b: &mut B, c: Bool) -> &mut Int {
    let B { n, m } = b
    let k = if c { n } else { m }
    k //~ ERROR `k` holds a copy of the scalar from a `&mut` match
}

type HM['a] = { pub mut r &'a mut Int }

fn storeField['a](b: &'a mut B, h: &mut HM['a]) {
    match b {
        B { n } -> { h.r = n } //~ ERROR `n` holds a copy of the scalar from a `&mut` match
    }
}

fn readPair(b: &mut B) -> Int {
    let B { n, m } = b
    let t = (n, m)
    let (x, y) = t
    x + y
}

fn readPairMatch(b: &mut B) -> Int {
    match b {
        B { n, m } -> {
            let t = ((n, 1), m)
            let ((p, q), r) = t
            p + q + r
        }
    }
}

fn tupleField(b: &mut B) {
    let B { n, m } = b
    let t = (n, 0)
    bump(t._0) //~ ERROR `n` holds a copy of the scalar from a `&mut` match, so a callee's write through it is lost
}

fn tupleMatch(b: &mut B) {

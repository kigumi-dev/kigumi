-- lib/fv.kg --
interface Shower {
    fn show(self) -> String
}

type Pt = {
    x Int
    y Int
}

fn Pt.show(self) -> String { "pt" }

fn identity[T](x: T) -> T { x }
fn describe[T: Shower](x: T) -> String { x.show() }
fn collect(xs: ...Int) -> Int { 0 }

fn use() {
    let a = identity[Pt] //~ TYPE a : fn(Pt) -> Pt
    let b: fn(Pt) -> Pt = identity
    let c = describe[Pt] //~ TYPE c : fn(Pt) -> String
    let d: fn(Pt) -> String = describe
    let e = Array.of[Int] //~ TYPE e : pure fn(...Int) -> Array[Int]
    let f = collect //~ TYPE f : fn(...Int) -> Int
    let g = describe(Pt { x: 1, y: 2 }) //~ TYPE g : String
}
-- expect --

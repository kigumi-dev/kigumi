pub type V['a] = { pub s &'a String }
pub type Sink['a] = { pub mut items &'a mut Array[V['a]] }
fn keep['a](x: &'a String, k: Sink['a]) { k.items.push(V { s: x }) }
fn nop['a](x: &'a String, k: Sink['a]) { }
fn mkNop['a]() -> fn(&'a String, Sink['a]) -> Void { nop }
fn mkKeep['a]() -> fn(&'a String, Sink['a]) -> Void { keep }
pub type Box[T] = { pub mut cb T }
fn put[T](b: &mut Box[T], v: T) { b.cb = v }
pub fn Box[T].set(mut self, v: T) { self.cb = v }
fn swapIn[T](a: &mut Box[T], b: &mut Box[T]) { }
fn fillFrom[T, M: Fn[fn() -> T]](b: &mut Box[T], m: M) { b.cb = m() }
pub type Runner['a, F: Fn[fn(&String, Sink['a]) -> Void] + Copy] = {
    pub mut n Int,
    pub mut cbs Array[F],
    pub mut b Box[F],
    pub mut other fn(&'a String, Sink['a]) -> Void,
}
pub fn Runner['a, F].run(self, k: Sink['a]) {
    let loc = "local-${40 + 2}"
    (self.cbs[self.cbs.len() - 1])(&loc, k)
}
pub fn Runner['a, F].fill(mut self, mk: escaping fn() -> F) { self.b.cb = mk() }
fn setAll['a](r: &mut Runner['a, fn(&'a String, Sink['a]) -> Void]) { r.cbs.push(keep) }

pub fn intField['a](k: Sink['a]) {
    let mut r: Runner['a, fn(&'a String, Sink['a]) -> Void] = Runner { n: 0, cbs: Array.of(nop), b: Box { cb: nop }, other: nop }
    r.n = 1
    r.run(k)
}
pub fn pushSafe['a](k: Sink['a]) {
    let mut r: Runner['a, fn(&'a String, Sink['a]) -> Void] = Runner { n: 0, cbs: Array.of(nop), b: Box { cb: nop }, other: nop }
    r.cbs.push(nop)
    r.run(k)
}
pub fn otherField['a](k: Sink['a]) {
    let mut r: Runner['a, fn(&'a String, Sink['a]) -> Void] = Runner { n: 0, cbs: Array.of(nop), b: Box { cb: nop }, other: nop }
    r.other = keep
    r.run(k)
}


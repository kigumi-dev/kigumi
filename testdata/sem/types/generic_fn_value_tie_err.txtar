type V['a] = { pub s &'a String }
type B['a] = { pub b &'a Bytes }
fn churn() -> Int {
    let mut arr: Array[String] = Array.of("x")
    for i in 100..3000 {
        arr.push("w${i}")
    }
    arr.len().toInt() || 0
}
fn mkV['a](s: &'a String) -> V['a] { V { s: s } }
fn mkB['a](b: &'a Bytes) -> B['a] { B { b: b } }
fn lastV['a](acc: V['a], s: &'a String) -> V['a] { V { s: s } }
fn showR['a](v: &V['a], k: Int) -> String { "${v.s.len()} ${v.s}" }
fn collect[U](items: &Array[String], f: fn(&String) -> U) -> Array[U] {
    let mut out: Array[U] = Array.empty()
    for s in items {
        out.push(f(s))
    }
    out
}
fn collectNested[U](items: &Array[Array[String]], f: fn(&String) -> U) -> Array[U] {
    let mut out: Array[U] = Array.empty()
    for row in items {
        for s in row {
            out.push(f(s))
        }
    }
    out
}
fn collectBytes[U](items: &Array[Bytes], f: fn(&Bytes) -> U) -> Array[U] {
    let mut out: Array[U] = Array.empty()
    for b in items {
        out.push(f(b))
    }
    out
}
fn putV[U](out: &mut U, items: &Array[String], f: fn(&String) -> U) {
    for s in items {
        out = f(s)
    }
}
fn foldItems[A](items: &Array[String], init: A, step: fn(A, &String) -> A) -> A {
    let mut acc = init
    for s in items {
        acc = step(acc, s)
    }
    acc
}
fn one[U](items: &Array[String], f: fn(&String) -> U) -> U {
    f(&items[0])
}

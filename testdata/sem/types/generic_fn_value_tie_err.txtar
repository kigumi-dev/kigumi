    items.push("x${churn()}") //~ ERROR `items` is borrowed and cannot be mutated
    showR(&out, churn())
}

fn putValTie[U](out: &mut U, v: U, items: &mut Array[String], f: fn(&String) -> U) {
    out = v
}

fn storeCopyBack() -> String {
    let base = "q"
    let mut items = Array.of("a${churn()}", "bcd")
    let mut other = Array.of("o")
    let mut out = mkV(&base)
    putMut(&mut out, &mut items, mkV)
    let c = out
    putValTie(&mut out, c, &mut other, mkV)
    items.push("x${churn()}") //~ ERROR `items` is borrowed and cannot be mutated
    showR(&out, churn())
}

fn assignCopyBack() -> String {
    let base = "q"
    let mut items = Array.of("a${churn()}", "bcd")
    let mut other = Array.of("o")
    let mut out = mkV(&base)
    putMut(&mut out, &mut items, mkV)
    let c = out
    putMut(&mut out, &mut other, mkV)
    out = c
    items.push("x${churn()}") //~ ERROR `items` is borrowed and cannot be mutated
    showR(&out, churn())
}

fn idTie[T](x: T) -> T {
    x
}

fn Sack.passTie[T](self, x: T) -> T {
    x
}

fn storeCallBack() -> String {
    let base = "q"
    let mut items = Array.of("a${churn()}", "bcd")
    let mut other = Array.of("o")
    let sack = Sack { xs: Array.of("s") }
    let mut out = mkV(&base)
    putMut(&mut out, &mut items, mkV)
    let c = out
    putValTie(&mut out, idTie(c), &mut other, mkV)
    items.push("x${churn()}") //~ ERROR `items` is borrowed and cannot be mutated
    showR(&out, churn())
}

fn assignCallBack() -> String {
    let base = "q"
    let mut items = Array.of("a${churn()}", "bcd")
    let mut other = Array.of("o")
    let sack = Sack { xs: Array.of("s") }
    let mut out = mkV(&base)
    putMut(&mut out, &mut items, mkV)
    let c = out
    putMut(&mut out, &mut other, mkV)
    out = idTie(c)
    items.push("x${churn()}") //~ ERROR `items` is borrowed and cannot be mutated
    showR(&out, churn())
}

fn methodCallBack() -> String {
    let base = "q"
    let mut items = Array.of("a${churn()}", "bcd")
    let mut other = Array.of("o")
    let sack = Sack { xs: Array.of("s") }
    let mut out = mkV(&base)
    putMut(&mut out, &mut items, mkV)
    let c = out
    putMut(&mut out, &mut other, mkV)
    out = sack.passTie(c)
    items.push("x${churn()}") //~ ERROR `items` is borrowed and cannot be mutated
    showR(&out, churn())
}

type WTie['a] = { pub inner V['a], pub n Int }

fn runTie[T](f: fn() -> T) -> T {
    f()
}

fn wrapTie['a](x: V['a]) -> WTie['a] {
    WTie { inner: x, n: 1 }
}

fn closureCallBack() -> String {
    let base = "q"
    let mut items = Array.of("a${churn()}", "bcd")
    let mut other = Array.of("o")
    let mut out = mkV(&base)
    putMut(&mut out, &mut items, mkV)
    let c = out
    putMut(&mut out, &mut other, mkV)
    out = runTie(() => c)
    items.push("x${churn()}") //~ ERROR `items` is borrowed and cannot be mutated
    showR(&out, churn())
}

fn fieldCallBack() -> String {
    let base = "q"
    let mut items = Array.of("a${churn()}", "bcd")
    let mut other = Array.of("o")
    let mut out = mkV(&base)
    putMut(&mut out, &mut items, mkV)
    let c = out
    putMut(&mut out, &mut other, mkV)
    out = wrapTie(c).inner
    items.push("x${churn()}") //~ ERROR `items` is borrowed and cannot be mutated
    showR(&out, churn())
}

fn main() {
    print "${collectAssign()} ${collectPush()} ${putAssign()} ${foldAssign()} ${nestedAssign()} ${bytesAssign()} ${oneAssign()} ${readOnly()} ${mapThenPush()} ${viaArray()} ${viaField()} ${viaCallee()} ${lenField()} ${fwdKeep(mkV, showVR)} ${fwdLen(lenOf)} ${carrierParamMut()} ${carrierParamRef()} ${closureCapture()} ${closureLocal()} ${closureCopy()} ${closureMade()} ${closureMap()} ${closureOtherFn()} ${copyAfterTie()}"
}
fn maybeLateTie[U](out: &mut U, items: &mut Array[String], f: fn(&String) -> U, c: Bool) {
    if c {
        out = f(&items[0])
    }
}

fn fwdMaybeLateTie[U](out: &mut U, items: &mut Array[String], f: fn(&String) -> U) {
    maybeLateTie(out, items, f, false)
}

fn pingTie[U](out: &mut U, items: &mut Array[String], f: fn(&String) -> U, n: Int) {
    if n > 100 {
        out = f(&items[0])
    } else {
        pongTie(out, items, f, n)
    }
}

fn pongTie[U](out: &mut U, items: &mut Array[String], f: fn(&String) -> U, n: Int) {
    if n > 0 {
        pingTie(out, items, f, n - 1)
    }
}

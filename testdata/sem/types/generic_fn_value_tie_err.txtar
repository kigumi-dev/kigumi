    let mut items = Array.of("a${churn()}", "bcd")
    let mut other = Array.of("o")
    let mut out = mkV(&base)
    putMut(&mut out, &mut items, mkV)
    putEarly(&mut out, &mut other, mkV, true)
    items.push("x${churn()}") //~ ERROR `items` is borrowed and cannot be mutated
    showR(&out, churn())
}

fn writeBackInLoop() -> String {
    let base = "q"
    let mut items = Array.of("a${churn()}", "bcd")
    let mut other = Array.of("o")
    let mut out = mkV(&base)
    for i in 0..2 {
        putMut(&mut out, &mut items, mkV)
        maybePut(&mut out, &mut other, mkV, false)
    }
    items.push("x${churn()}") //~ ERROR `items` is borrowed and cannot be mutated
    showR(&out, churn())
}

fn writeBackRecv() -> String {
    let base = "q"
    let mut sack = Sack { xs: Array.of("a${churn()}", "bcd") }
    let other = Sack { xs: Array.of("o") }
    let mut out = mkV(&base)
    sack.putInto(&mut out, mkV)
    other.maybeInto(&mut out, mkV)
    sack.xs.push("zzz${churn()}") //~ ERROR `sack` is borrowed and cannot be mutated
    showR(&out, churn())
}

type FnBox[F] = { pub f F }

fn makerSome() -> String {
    let base = "q"
    let mut other = "o${churn()}"
    let mut items = Array.of("a")
    let mut out = mkV(&base)
    let mk = () => Some((s: &String) => mkV(&other))
    let g = mk()
    if g is Some(h) {
        putMut(&mut out, &mut items, h)
    }
    other = "zzz${churn()}" //~ ERROR `other` is borrowed and cannot be mutated
    showR(&out, churn())
}

fn makerSomeNested() -> String {
    let base = "q"
    let mut other = "o${churn()}"
    let mut items = Array.of("a")
    let mut out = mkV(&base)
    let mk = () => Some(Some((s: &String) => mkV(&other)))
    let g = mk()
    if g is Some(g2) {
        if g2 is Some(h) {
            putMut(&mut out, &mut items, h)
        }
    }
    other = "zzz${churn()}" //~ ERROR `other` is borrowed and cannot be mutated
    showR(&out, churn())
}

fn makerSomeMaker() -> String {
    let base = "q"
    let mut other = "o${churn()}"
    let mut items = Array.of("a")
    let mut out = mkV(&base)
    let mk = () => Some(() => (s: &String) => mkV(&other))
    let g = mk()
    if g is Some(m) {
        let h = m()
        putMut(&mut out, &mut items, h)
    }
    other = "zzz${churn()}" //~ ERROR `other` is borrowed and cannot be mutated
    showR(&out, churn())
}

fn makerRecord() -> String {
    let base = "q"
    let mut other = "o${churn()}"
    let mut items = Array.of("a")
    let mut out = mkV(&base)
    let mk = () => FnBox { f: (s: &String) => mkV(&other) }
    let g = mk()
    putMut(&mut out, &mut items, g.f)
    other = "zzz${churn()}" //~ ERROR `other` is borrowed and cannot be mutated
    showR(&out, churn())
}

fn makerArray() -> String {
    let base = "q"
    let mut other = "o${churn()}"
    let mut items = Array.of("a")
    let mut out = mkV(&base)
    let mk = () => Array.of((s: &String) => mkV(&other))
    let g = mk()
    putMut(&mut out, &mut items, g[0])
    other = "zzz${churn()}" //~ ERROR `other` is borrowed and cannot be mutated
    showR(&out, churn())
}

fn fwdMaybeTie[U](out: &mut U, items: &mut Array[String], f: fn(&String) -> U) {
    maybePut(out, items, f, false)
}

fn writeBackFwdMaybe() -> String {
    let base = "q"
    let mut items = Array.of("a${churn()}", "bcd")
    let mut other = Array.of("o")
    let mut out = mkV(&base)
    putMut(&mut out, &mut items, mkV)
    fwdMaybeTie(&mut out, &mut other, mkV)
    items.push("x${churn()}") //~ ERROR `items` is borrowed and cannot be mutated
    showR(&out, churn())
}


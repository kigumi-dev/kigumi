const Z = 0

fn first[T](a: T, b: T) -> T { a }

fn main() {
    let v1: Float = -(-(0)) //~ ERROR expected `Float`, found `Int`
    let x: Float = 3.0
    let q = x / -(0) //~ ERROR `Float` and `Int` cannot be mixed
    let g: Float = first(-(0), -Z) //~ ERROR expected `Float`, found `Int`
    let e: Float = -(0) + -(0) //~ ERROR expected `Float`, found `Int`
    let o: Float? = -(0) //~ ERROR expected `Float?`, found `Int`
    let d: Float = -(0)
    let z: f32 = -Z
    print "${d} ${z}"
}

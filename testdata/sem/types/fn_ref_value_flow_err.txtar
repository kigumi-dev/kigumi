pub fn loopCall['a](k1: Sink['a], k2: Sink['a]) -> usize {
    let hn = Hn { n: 1 }
    let ra: R0['a, fn(&'a String, Sink['a]) -> Void] = R0 { cb: nop, k: k1 }
    let mut g = zero
    let mut x: usize = 0
    let mut o = Some(R0 { cb: keep, k: k2 })
    for i in 0..2 {
        if i == 1 {
            match o.take() {
                Some(r) -> { x = x + g(r) } //~ ERROR cannot be erased
                None -> {}
            }
        }
        g = hn.measure
    }
    x + g(ra)
}

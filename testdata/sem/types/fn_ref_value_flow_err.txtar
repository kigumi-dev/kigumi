    let set = () => { g = zero }
    x + g(rb)
}
pub fn escapeThenDrop['a](k1: Sink['a], k2: Sink['a]) -> usize {
    let hn = Hn { n: 1 }
    let ra: R0['a, fn(&'a String, Sink['a]) -> Void] = R0 { cb: nop, k: k1 }
    let rb: R0['a, fn(&'a String, Sink['a]) -> Void] = R0 { cb: keep, k: k2 }
    let mut g = hn.measure
    let x = g(ra) //~ ERROR cannot be erased
    let y = apply(g, rb)
    g = zero
    x + y
}
pub fn aliasThenDrop['a](k1: Sink['a], k2: Sink['a]) -> usize {
    let hn = Hn { n: 1 }
    let ra: R0['a, fn(&'a String, Sink['a]) -> Void] = R0 { cb: nop, k: k1 }
    let rb: R0['a, fn(&'a String, Sink['a]) -> Void] = R0 { cb: keep, k: k2 }

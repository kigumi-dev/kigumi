type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

type Cell = {
    pub v Res
    pub n Int
}

type HC = {
    pub oc Cell?
}

type HR = {
    pub r Result[Res, Int]
}

fn me(h: &HC) -> &HC {
    h
}

fn viaCall(h: &HC, y: Res) -> Res {
    me(h).oc?.v || y //~ ERROR reading `me(h).oc?.v` by value
}

fn viaCallLet(h: &HC) -> Res? {
    let x = me(h).oc?.v //~ ERROR reading `me(h).oc?.v` by value
    x
}

fn viaCallCopy(h: &HC) -> Int {
    me(h).oc?.n || 0
}

fn HR.get(self) -> Result[Res, Int] {
    let x = self.r? //~ ERROR reading `self.r` by value
    Ok(x)
}

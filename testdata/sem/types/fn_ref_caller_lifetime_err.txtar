-- src --
pub type View['a] = { pub value &'a String }

pub fn direct['a](g: fn(&'a String) -> View['a]) -> usize {
    let loc = "local${1}"
    let v = g(&loc) //~ ERROR cannot be passed as `&'a String`
    v.value.len()
}

pub fn bound['a, F: Fn[fn(&'a String) -> View['a]]](g: F) -> usize {
    let loc = "local${1}"
    let v = g(&loc) //~ ERROR cannot be passed as `&'a String`
    v.value.len()
}

pub fn lent['a](g: fn(&'a String) -> View['a], value: &'a String) -> usize {
    let v = g(value)
    v.value.len()
}

pub fn mixedIf['a](g: fn(&'a String) -> usize, a: &'a String, c: Bool) -> usize {
    let loc = "loc${1}"
    let s = if c { a } else { &loc }
    g(s) //~ ERROR cannot be passed as `&'a String`
}

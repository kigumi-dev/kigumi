pub type V['a] = { pub s &'a String }
pub type Sink['a] = { pub mut items &'a mut Array[V['a]] }
fn keep['a](x: &'a String, k: Sink['a]) { k.items.push(V { s: x }) }
fn nop['a](x: &'a String, k: Sink['a]) { }
fn ten(n: Int) -> usize { 10 }
fn mkKeep['a]() -> fn(&'a String, Sink['a]) -> Void { keep }
fn mkNop['a]() -> fn(&'a String, Sink['a]) -> Void { nop }
pub type Box[F] = { pub cb F }
pub type R7['a, F: Fn[fn(&String, Sink['a]) -> Void] + Copy] = { pub cb F, pub g fn(Int) -> usize }
pub type R2['a, F: Fn[fn(&String, Sink['a]) -> Void] + Copy] = { pub a F, pub b F }
pub type RO['a, F: Fn[fn(&String, Sink['a]) -> Void] + Copy] = { pub o Option[F], pub n Int }
pub type E['a, F: Fn[fn(&String, Sink['a]) -> Void] + Copy] = A(f: F) | B(n: Int) | C(g: F, h: F)
pub type RM['a, F: Fn[fn(&String, Sink['a]) -> Void] + Copy] = { pub mk fn() -> F, pub n Int }
pub type RB['a, F: Fn[fn(&String, Sink['a]) -> Void] + Copy] = { pub b Box[F], pub n Int }
pub type RG['a, F: Fn[fn(&String, Sink['a]) -> Void] + Copy, G: Fn[fn() -> F] + Copy] = { pub mk G, pub n Int }
pub type RA['a, F: Fn[fn(&String, Sink['a]) -> Void] + Copy] = { pub xs Array[F] }
fn use7['a, F: Fn[fn(&String, Sink['a]) -> Void] + Copy](r: R7['a, F], k: Sink['a]) { }
fn use2['a, F: Fn[fn(&String, Sink['a]) -> Void] + Copy](r: R2['a, F], k: Sink['a]) { }
fn useO['a, F: Fn[fn(&String, Sink['a]) -> Void] + Copy](r: RO['a, F], k: Sink['a]) { }
fn useE['a, F: Fn[fn(&String, Sink['a]) -> Void] + Copy](e: E['a, F], k: Sink['a]) { }
fn useOpt['a, F: Fn[fn(&String, Sink['a]) -> Void] + Copy](o: Option[F], k: Sink['a]) { }
fn useM['a, F: Fn[fn(&String, Sink['a]) -> Void] + Copy](r: RM['a, F], k: Sink['a]) { }
fn useB['a, F: Fn[fn(&String, Sink['a]) -> Void] + Copy](r: RB['a, F], k: Sink['a]) { }
fn useG['a, F: Fn[fn(&String, Sink['a]) -> Void] + Copy, G: Fn[fn() -> F] + Copy](r: RG['a, F, G], k: Sink['a]) { }
fn useA['a, F: Fn[fn(&String, Sink['a]) -> Void] + Copy](r: RA['a, F], k: Sink['a]) { }


const N: Int = 1
const I: f32 = 0.1
const T: f32 = 1.5

const Mixed = N + 0.5 //~ ERROR float literal `0.5` cannot be `Int`
const MixedLeft = 0.5 * N //~ ERROR float literal `0.5` cannot be `Int`
const Whole = N * 2.0 //~ ERROR float literal `2` cannot be `Int`
const Declared: Float = N + 0.5 //~ ERROR float literal `0.5` cannot be `Int`
const IntAsFloat: Float = N + 1 //~ ERROR expected `Float`, found `Int`
const Narrow: Float = I //~ ERROR expected `Float`, found `f32`
const Inexact = T + 16777217 //~ ERROR `16777217` does not fit `f32`
const Huge = T * 1e300 //~ ERROR `1e+300` does not fit `f32`
const Twice = T * 2
const Sum: f32 = T + 0.25
const Untyped = 2 + 0.5
const Compare: Bool = T > 1.4

fn uses() -> Bool {
    let a: f32 = Twice
    let b: f32 = Sum
    let c: Float = Untyped
    a > b && c > 2.0 && Compare
}

-- src --
const K = 1 << 70
const K2 = (1 << 64) + 32
const K3 = 1 << 10
const KF = 1 << 1024

fn main() {
    let x: Int = 0
    match x {
        K -> print "K" //~ ERROR `1180591620717411303424` does not fit `Int`
        K2 -> print "K2" //~ ERROR `18446744073709551648` does not fit `Int`
        K3 -> print "K3"
        _ -> print "other"
    }
    let b: u8 = 3
    match b {
        K3 -> print "K3" //~ ERROR `1024` does not fit `u8`
        _ -> print "other"
    }
    let f: Float = 0.0
    match f {
        KF -> print "KF" //~ ERROR does not fit `Float`
        _ -> print "other"
    }
}

-- src --
pub context port: Int

@provides(port)
pub type Cfg = {
    pub port Int
}

fn read() -> Int {
    port
}

static mut last: Int = 0

export(C) {
    pub fn direct() -> Int {
        port //~ ERROR exported function `direct` requires context key `port`
    }

    pub fn indirect() -> Int {
        read() //~ ERROR exported function `indirect` requires context key `port`
    }

    pub fn bound() -> Int {
        context (Cfg { port: 3 }) {
            read()
        }
    }

    pub fn printsOnly() {
        print "hi"
    }
}

export(interrupt) {
    pub fn tick() {
        unsafe { last = port } //~ ERROR interrupt handler `tick` requires context key `port`
    }
}

test "bare" {
    _ = read() //~ ERROR context key `port` is required here but nothing supplies it
}

test "bound" {
    context (Cfg { port: 4 }) {
        _ = read()
    }
}

context (Cfg { port: 5 }) {
    print "${direct()} ${indirect()} ${bound()}"
}

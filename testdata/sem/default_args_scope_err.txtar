type Res = resource {
    pub n Int
}

fn Res.drop(move self) {}

type Logger = {
    pub mut level Int
}

fn later(a: Int = b, b: Int = 1) -> Int { a } //~ ERROR undefined name `b`
fn selfRef(a: Int = a) -> Int { a } //~ ERROR undefined name `a`
fn consume(r: Res, other: Res = r) -> Int { 1 } //~ ERROR expected `Res`, found `&Res`
fn borrow(r: Res, n: Int = r.n) -> Int { n }
fn Logger.bump(mut self, by: Int = self.level) {} //~ ERROR a `mut self` method whose default reads `self`
fn Logger.show(self, by: Int = self.level) -> Int { by }
fn effectful(a: Int = impure()) -> Int { a }
noalloc fn quiet(a: Int = 1) -> Int { a }
noalloc fn allocs(a: Array[Int] = Array.of(1)) -> Int { 1 } //~ ERROR `of` is not `noalloc` //~ ERROR listed variadic arguments allocate
fn impure() -> Int { 1 }

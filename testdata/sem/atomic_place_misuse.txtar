import {atomicAdd, atomicLoad, volatileReadAt, AtomicOrder} from std/mem

static mut hits: u32 = 0
static version: u32 = 1

fn outside() -> u32 {
    atomicLoad(&hits, AtomicOrder.SeqCst) //~ ERROR calling `atomicLoad` requires an `unsafe { }` block //~ ERROR accessing `static mut hits` requires an `unsafe { }` block
}

fn run(mut local: u32) {
    unsafe {
        _ = atomicAdd(&mut local, 1, AtomicOrder.SeqCst) //~ ERROR the place of `atomicAdd` is not a bare static
        _ = atomicAdd(&mut hits, 1, AtomicOrder.SeqCst)
        _ = atomicLoad(&version, AtomicOrder.SeqCst) //~ ERROR `version` is not a Kigumi-owned `static mut`
        let load = atomicLoad[u32] //~ ERROR `atomicLoad` is lowered at its call site and cannot be used as a function value
        let read = volatileReadAt[u8] //~ ERROR `volatileReadAt` is lowered at its call site and cannot be used as a function value
    }
}


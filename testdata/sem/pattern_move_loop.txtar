-- module --
mir: planned
-- src --
type Handle = resource {
    pub id Int
}

fn Handle.drop(move self) -> Unit {}

fn Handle.close(move self) -> Unit {}

fn Handle.peek(self) -> Int {
    self.id
}

type Pack = {
    pub inner Handle
    pub other Handle
    pub n Int
}

fn mkh(n: Int) -> Handle {
    Handle { id: n }
}

fn mk(n: Int) -> Pack {
    Pack { inner: mkh(n), other: mkh(n + 1), n: n * 2 }
}

fn sink(n: Int) -> Unit {}

fn tupleElementInLoop() -> Unit {
    let t = (mkh(1), mkh(2))
    for i in 0..2 {
        match t {
            (_, b) -> b.close() //~ ERROR `t._1` was moved
        }
    }
}

fn tupleElementInLoopUnderCleanup() -> Unit {
    let t = (mkh(1), mkh(2))
    defer { t._0.close() }
    for i in 0..2 {
        match t {
            (_, b) -> b.close() //~ ERROR `t._1` was moved
        }
    }
}

fn recordFieldInLoop() -> Unit {
    let b = mk(1)
    for i in 0..2 {
        match b {
            Pack { other, inner: _, n: _ } -> other.close() //~ ERROR `b.other` was moved
        }
    }
}

fn letFieldInLoop() -> Unit {
    let b = mk(1)
    for i in 0..2 {
        let x = move b.other //~ ERROR `b.other` was moved
        x.close()
    }
}

fn perIterationTuple(ts: Array[(Handle, Handle)]) -> Unit {
    for t in ts {
        match t {
            (a, b) -> {
                a.close()
                b.close()
            }
        }
    }
}

fn perIterationRecord() -> Unit {
    for i in 0..2 {
        let b = mk(i)
        match b {
            Pack { other, inner, n: _ } -> {
                other.close()
                inner.close()
            }
        }
    }
}

fn referenceScrutinee() -> Unit {
    let t = (mkh(1), mkh(2))
    defer { t._0.close() }
    for i in 0..2 {
        match &t {
            (_, b) -> sink(b.peek())
        }
    }
}

fn copyFieldInLoop() -> Unit {
    let b = mk(1)
    for i in 0..2 {
        match b {
            Pack { other: _, inner: _, n } -> sink(n)
        }
    }
}

fn movedOnceAfterLoop() -> Unit {
    let t = (mkh(1), mkh(2))
    for i in 0..2 {
        sink(i)
    }
    match t {
        (a, b) -> {
            a.close()
            b.close()
        }
    }
}

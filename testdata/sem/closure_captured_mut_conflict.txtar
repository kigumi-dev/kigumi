-- app/t/t.kg --
type Item = {
    pub mut count Int
}

fn Item.update(mut self, delta: Int) {
    self.count = self.count + delta
}

fn closureCalledAfter() {
    let mut item = Item { count: 0 }
    let touch = () => { item.update(1) }
    item.update(1)
    touch()
}

// touch only changes the storage the call holds, so its write is kept.
fn closureCalledInArgument() {
    let mut item = Item { count: 0 }
    let touch = () => {
        item.update(1)
        1
    }
    item.update(touch())
}

fn reassignCalledAfter() {
    let mut item = Item { count: 0 }
    let reset = () => { item = Item { count: 0 } }
    item.update(1)
    reset()
}

// reset replaces item after the call read it, so the call's write would be lost.
fn reassignCalledInArgument() {
    let mut item = Item { count: 0 }
    let reset = () => {
        item = Item { count: 0 }
        2
    }
    item.update(reset() + 1) //~ ERROR a `mut self` call on `item` conflicts
}

fn onlyThroughClosure() {
    let mut item = Item { count: 0 }
    let touch = () => { item.update(1) }
    touch()
    touch()
}

fn noCapture() {
    let mut item = Item { count: 0 }
    item.update(1)
    item.update(1)
}

fn readOnlyCapture() {
    let mut item = Item { count: 0 }
    let peek = () => item.count
    item.update(1)
    let _ = peek()
}

-- app/t/t.kg --
type Item = {
    pub mut count Int
}

fn Item.update(mut self, delta: Int) {
    self.count = self.count + delta
}

fn conflict() {
    let mut item = Item { count: 0 }
    let touch = () => { item.update(1) }
    item.update(1) //~ ERROR a `mut self` call on `item` conflicts
    touch()
}

fn conflictViaReassign() {
    let mut item = Item { count: 0 }
    let reset = () => { item = Item { count: 0 } }
    item.update(1) //~ ERROR a `mut self` call on `item` conflicts
    reset()
}

fn onlyThroughClosure() {
    let mut item = Item { count: 0 }
    let touch = () => { item.update(1) }
    touch()
    touch()
}

fn noCapture() {
    let mut item = Item { count: 0 }
    item.update(1)
    item.update(1)
}

fn readOnlyCapture() {
    let mut item = Item { count: 0 }
    let peek = () => item.count
    item.update(1)
    let _ = peek()
}

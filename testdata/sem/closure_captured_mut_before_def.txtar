-- app/t/t.kg --
type Item = {
    pub mut count Int
}

fn Item.update(mut self, delta: Int) {
    self.count = self.count + delta
}

fn beforeDefinition() -> Int {
    let mut item = Item { count: 0 }
    item.update(1) //~ ERROR a `mut self` call on `item` conflicts
    let touch = () => { item.update(1) }
    touch()
    item.count
}

fn aliasBeforeDefinition() -> Int {
    let mut item = Item { count: 0 }
    item.update(2) //~ ERROR a `mut self` call on `item` conflicts
    let touch = () => { item.update(1) }
    let alias = touch
    alias()
    item.count
}

fn onlyThroughClosure() -> Int {
    let mut item = Item { count: 0 }
    let touch = () => { item.update(1) }
    touch()
    touch()
    item.count
}

fn readOnlyCapture() -> Int {
    let mut item = Item { count: 0 }
    let peek = () => item.count
    item.update(1)
    let _ = peek()
    item.count
}

fn otherRootCapture() -> Int {
    let mut item = Item { count: 0 }
    let other = Item { count: 0 }
    let readOther = () => other.count
    item.update(1)
    let _ = readOther()
    item.count
}

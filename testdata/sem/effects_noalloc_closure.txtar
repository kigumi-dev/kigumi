-- lib/clo.kg --
type Point = {
    pub x Int
    pub y Int
}

noalloc fn apply(f: noalloc fn(Int) -> Int, v: Int) -> Int {
    f(v) //~ ERROR this call goes through a function value or an interface, so the `Int` it returns arrives in a box
}

noalloc fn applyGen[F: Fn[noalloc fn(Int) -> Int]](f: F, v: Int) -> Int {
    f(v)
}

// A closure over register-wide values keeps its environment inline, so
// building, copying and calling it costs nothing.
noalloc fn directScalars(n: Int) -> Int {
    let k = n + 1
    let on = n > 0
    let f = (x: Int) => if on { x + k } else { x }
    let g = f
    g(2) + f(3) //~ ERROR `g` is not `noalloc` //~ ERROR `f` is not `noalloc`
}

noalloc fn directRecord(p: Point) -> Int {
    let f = (d: Int) => p.x * d + p.y
    f(1) //~ ERROR `f` is not `noalloc`
}

noalloc fn directNested(n: Int) -> Int {
    let inner = (x: Int) => x + n
    let outer = (x: Int) => inner(x) * 2
    outer(1) //~ ERROR `outer` is not `noalloc`
}

noalloc fn carrierCapture(s: String) -> Int {
    let f = () => s.len() //~ ERROR constructing `closure fn() -> usize` allocates
    f().toInt() || 0 //~ ERROR `f` is not `noalloc`
}

noalloc fn erases(n: Int) -> Int {
    apply((x: Int) => x + n, 1) //~ ERROR boxing `closure fn(Int) -> Int` into `noalloc fn(Int) -> Int` allocates //~ ERROR closure is not `noalloc` (allocates)
}

// The instantiation for this closure type takes its environment unboxed.
noalloc fn toGeneric(n: Int) -> Int {
    applyGen((x: Int) => x + n, 1) //~ ERROR closure is not `noalloc` (allocates)
}

noalloc fn mutCapture() -> Int {
    let mut c = 0
    let f = () => { c = c + 1 } //~ ERROR constructing `closure fn() -> Void` allocates
    f() //~ ERROR `f` is not `noalloc`
    c
}

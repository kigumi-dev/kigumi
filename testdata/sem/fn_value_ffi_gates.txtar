import ffi from std/ffi

type Plain = { a Int }

type Wide layout(C) = {
    pub a i32
    pub b i32
}

fn sizeIn[T](v: &T) -> usize {
    let f = ffi.sizeOf[T] //~ ERROR `T` cannot be passed to `sizeOf`
    f(v)
}

fn cellIn[U](v: U) -> Unit {
    let mk = ffi.CValue.new[U] //~ ERROR `U` cannot be a `CValue` element
}

fn lease() -> Unit {
    let a: fn(&Plain) -> usize = ffi.sizeOf //~ ERROR `Plain` cannot be passed to `sizeOf`
    let b = ffi.sizeOf[String] //~ ERROR `String` cannot be passed to `sizeOf`
    let c = ffi.alignOf[Plain] //~ ERROR `Plain` cannot be passed to `alignOf`
    let d = ffi.CValue.new[Plain] //~ ERROR `Plain` cannot be a `CValue` element
    let ok = ffi.sizeOf[Wide]
    let ok2 = ffi.sizeOf[i32]
    let ok3 = ffi.CValue.new[i64]
    let w = ffi.withAddress[i32, *mut i32] //~ ERROR `withAddress`'s callback returns
    let w2: fn(&mut i32, fn(*mut i32) -> *mut i32) -> *mut i32 = ffi.withAddress //~ ERROR `withAddress`'s callback returns
    let okw = ffi.withAddress[i32, i32]
}

-- module --
mir: planned
-- src --
import test from std/test

type Handle = resource {
    pub id Int
}

fn Handle.drop(move self) -> Unit {}

fn Handle.close(move self) -> Unit {}

fn Handle.peek(self) -> Int {
    self.id
}

fn take(h: Handle) -> Unit {}

fn movedAfterRegistration() -> Unit {
    let h = Handle { id: 1 }
    defer { print "peek ${h.peek()}" } //~ ERROR a cleanup reads `h`
    take(h)
}

fn movedOnOnePath(flag: Bool) -> Unit {
    let h = Handle { id: 1 }
    defer { print "peek ${h.peek()}" } //~ ERROR a cleanup reads `h`
    if flag {
        take(h)
    }
}

fn discardedBeforeExit() -> Unit! {
    let h = Handle { id: 1 }
    defer(fail) { print "peek ${h.peek()}" } //~ ERROR a cleanup reads `h`
    _ = h
    fail test.failure("late")
}

fn movedIntoRecord() -> Unit {
    let h = Handle { id: 1 }
    defer { print "peek ${h.peek()}" } //~ ERROR a cleanup reads `h`
    let w = Wrapper { inner: h }
    print "wrapped ${w.inner.id}"
}

type Wrapper = {
    pub inner Handle
}

fn readsCopyAfterMove() -> Unit {
    let mut n = 1
    let h = Handle { id: 1 }
    defer { print "n=${n}" }
    take(h)
    n = 2
}

fn movedBeforeRegistration() -> Unit {
    let h = Handle { id: 1 }
    take(h)
    let g = Handle { id: 2 }
    defer { print "peek ${g.peek()}" }
}

readsCopyAfterMove()
movedBeforeRegistration()

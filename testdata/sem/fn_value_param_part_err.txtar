-- module --
mir: planned
-- src --
import {Shared} from std/alloc

pub type V['a] = {
    pub s &'a String
}

pub type Sink['a] = {
    pub mut items &'a mut Array[V['a]]
}

pub type Box[F] = {
    pub mut cb F
}

pub type Outer[F] = {
    pub inner Box[F]
    pub n Int
}

fn nop['a](x: &'a String, k: Sink['a]) {
}

fn keep['a](x: &'a String, k: Sink['a]) {
    k.items.push(V { s: x })
}

fn viaField['a](b: Box[fn(&'a String, Sink['a]) -> Void], x: &'a String, k: Sink['a]) {
    (b.cb)(x, k)
}

fn viaIndex['a](fs: Array[fn(&'a String, Sink['a]) -> Void], x: &'a String, k: Sink['a]) {
    fs[0](x, k)
}

fn boxed['a](x: &'a String, k: Sink['a]) {
    viaField(Box { cb: nop }, x, k)
}

fn boxedKeep['a](x: &'a String, k: Sink['a]) {
    viaField(Box { cb: keep }, x, k)
}

fn listed['a](x: &'a String, k: Sink['a]) {
    viaIndex(Array.of(nop, keep), x, k)
}

async fn grow(a: &mut Array[String]) -> usize {
    a.push("b")
    a.len()
}

fn putIn(s: Shared[Future[usize]?], f: Future[usize]) {
    s.set(Some(f))
}

fn drop2(s: Shared[Future[usize]?], f: Future[usize]) {
}

fn handOn(b: Box[fn(Shared[Future[usize]?], Future[usize]) -> Void], s: Shared[Future[usize]?], f: Future[usize]) {
    (b.cb)(s, f)
}

fn quietHand(s: Shared[Future[usize]?]) {
    let mut a = Array.of("x")
    handOn(Box { cb: drop2 }, s, grow(&mut a))
}

fn setCb['a](b: &mut Box[fn(&'a String, Sink['a]) -> Void]) {
    b.cb = keep
}

fn copiedSet['a](b: Box[fn(&'a String, Sink['a]) -> Void], k: Sink['a]) {
    let loc = "local-${40 + 2}"
    let mut b2 = b
    b2.cb = keep
    (b2.cb)(&loc, k) //~ ERROR a value borrowing `loc` cannot be passed as
}

fn copiedLent['a](b: Box[fn(&'a String, Sink['a]) -> Void], k: Sink['a]) {
    let loc = "local-${40 + 2}"
    let mut b2 = b
    setCb(&mut b2)
    (b2.cb)(&loc, k) //~ ERROR a value borrowing `loc` cannot be passed as
}

fn copiedArray['a](fs: Array[fn(&'a String, Sink['a]) -> Void], k: Sink['a]) {
    let loc = "local-${40 + 2}"
    let mut fs2 = fs
    fs2[0] = keep
    fs2[0](&loc, k) //~ ERROR a value borrowing `loc` cannot be passed as
}

fn copiedPart['a](b: Outer[fn(&'a String, Sink['a]) -> Void], k: Sink['a]) {
    let loc = "local-${40 + 2}"
    let mut c = b.inner
    c.cb = keep
    (c.cb)(&loc, k) //~ ERROR a value borrowing `loc` cannot be passed as
}

fn copiedUntouched['a](b: Box[fn(&'a String, Sink['a]) -> Void], k: Sink['a]) {
    let loc = "local-${40 + 2}"
    let b2 = b
    (b2.cb)(&loc, k)
}

fn handOnCopied(b: Box[fn(Shared[Future[usize]?], Future[usize]) -> Void], s: Shared[Future[usize]?], f: Future[usize]) {
    let mut b2 = b
    b2.cb = putIn
    (b2.cb)(s, f)
}

fn quietCopied(s: Shared[Future[usize]?]) {
    let mut a = Array.of("x")
    handOnCopied(Box { cb: drop2 }, s, grow(&mut a)) //~ ERROR a value borrowing `a` cannot go into shared storage
}

fn unbound['a](b: Box[fn(V['a]) -> Void]) {
    let loc = "frame-local"
    (b.cb)(V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}

fn unboundIndex['a](fs: Array[fn(V['a]) -> Void]) {
    let loc = "frame-local"
    fs[0](V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}

fn unboundLoop['a](fs: Array[fn(V['a]) -> Void]) {
    let loc = "frame-local"
    for f in fs {
        f(V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
    }
}

fn storingHand(s: Shared[Future[usize]?]) {
    let mut a = Array.of("x")
    handOn(Box { cb: putIn }, s, grow(&mut a)) //~ ERROR a value borrowing `a` cannot go into shared storage
}

let text = "hello"
let more = "more"
let mut items = Array.of(V { s: &text })
boxed(&more, Sink { items: &mut items })
boxedKeep(&more, Sink { items: &mut items })
listed(&more, Sink { items: &mut items })
copiedSet(Box { cb: nop }, Sink { items: &mut items }) //~ ERROR a value borrowing `items` cannot go into shared storage
copiedLent(Box { cb: nop }, Sink { items: &mut items }) //~ ERROR a value borrowing `items` cannot go into shared storage
copiedArray(Array.of(nop), Sink { items: &mut items }) //~ ERROR a value borrowing `items` cannot go into shared storage
copiedPart(Outer { inner: Box { cb: nop }, n: 0 }, Sink { items: &mut items }) //~ ERROR a value borrowing `items` cannot go into shared storage
copiedUntouched(Box { cb: nop }, Sink { items: &mut items })
print "${items.len()}"

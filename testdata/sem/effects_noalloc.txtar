type MyErr = {
    pub code Int
}

fn MyErr.message(self) -> String {
    "e"
}

noalloc fn interp(x: Int) -> String {
    "x=${x}" //~ ERROR string interpolation allocates
}

noalloc fn variadic() -> Array[Int] {
    Array.of(1, 2) //~ ERROR `of` is not `noalloc` //~ ERROR listed variadic arguments allocate
}

noalloc fn widen() -> Unit! {
    fail MyErr { code: 1 } //~ ERROR boxing `MyErr` into `Error` allocates //~ ERROR constructing `Unit!` allocates
}

pure noalloc fn ok(data: Bytes) -> usize {
    data.len()
}

// A record of register-wide fields has no storage of its own, so building,
// copying, reading and returning one costs nothing.
noalloc fn buildsDirect(n: Int) -> MyErr {
    let a = MyErr { code: n }
    let b = a
    MyErr { code: a.code + b.code }
}

noalloc fn directPair(n: Int) -> Int {
    let (x, y) = (n, n + 1)
    x + y
}

fn MyErr.doubled(self) -> MyErr {
    MyErr { code: self.code * 2 }
}

noalloc fn directMethod(n: Int) -> Int {
    MyErr { code: n }.doubled().code
}

noalloc fn directBorrowed(n: Int) -> Int {
    let p = MyErr { code: n }
    let r = &p //~ ERROR handing `MyErr` to a slot that holds a reference allocates a box for it
    r.code
}

noalloc fn directIntoAnArray(n: Int, mut xs: Array[MyErr]) -> Unit {
    xs.push(MyErr { code: n }) //~ ERROR `push` is not `noalloc` //~ ERROR handing `MyErr` to a slot that holds a reference allocates a box for it
}

type Mark = Cold | Hot

noalloc fn nullaryVariant() -> Mark {
    Cold
}

noalloc fn optionNone() -> Int? {
    None
}

type Slot = Free | Busy

fn Slot.release(mut self) -> Unit {
    self = Free
}

noalloc fn wholeAssignedVariant() -> Slot {
    Free
}

noalloc fn payloadVariant(x: Int) -> Int? {
    Some(x)
}

// Every payload is register-wide, so the tag and the payload area live in
// the caller's own frame; matching one reads them back out.
type Shape = Circle(r: Int) | Square(side: Int, filled: Bool) | Dot

noalloc fn directVariant(n: Int) -> Int {
    let s = Square(n, true)
    match s {
        Circle(r) -> r
        Square(side, filled) -> if filled { side } else { 0 }
        Dot -> 0
    }
}

noalloc fn directVariantPropagates(x: Result[Int, Int]) -> Result[Int, Int] {
    let v = x?
    Ok(v + 1)
}

// A payload with storage of its own keeps the whole ADT boxed.
type Tagged = Labelled(name: String) | Blank

noalloc fn carrierVariant(s: String) -> Tagged {
    Labelled(s) //~ ERROR constructing `Tagged` allocates
}

noalloc fn directVariantIntoAnArray(n: Int, mut xs: Array[Int?]) -> Unit {
    xs.push(Some(n)) //~ ERROR `push` is not `noalloc` //~ ERROR handing `Int?` to a slot that holds a reference allocates a box for it
}

noalloc fn bytes(s: String) -> Bytes {
    s.toBytes()
}

noalloc fn pushes(mut xs: Array[Int]) -> Unit {
    xs.push(1) //~ ERROR `push` is not `noalloc`
}

noalloc fn cb(f: fn() -> Unit) -> Unit {
    f()
}

fn grows() -> Unit {
    let mut xs = Array.empty[Int]()
    xs.push(1)
}

noalloc fn cbCaller() -> Unit {
    cb(() => grows()) //~ ERROR closure is not `noalloc` (calls `grows`)
}

noalloc fn noop(n: Int) -> Unit {}

noalloc fn cbCapturing(n: Int) -> Unit {
    cb(() => noop(n)) //~ ERROR boxing `closure fn() -> Unit` into `fn() -> Unit` allocates
}

noalloc fn cbOk(f: noalloc fn() -> Unit) -> Unit {
    f()
}

noalloc fn dropsErr(e: Error) -> Unit {
    _ = e //~ ERROR dropping `Error` may allocate or deallocate
}

noalloc fn dropsErrUnused(e: Error) -> Unit {} //~ ERROR dropping `Error` may allocate or deallocate

noalloc fn dropsLocalUnused(e: Error) -> Unit {
    let local = e //~ ERROR dropping `Error` may allocate or deallocate
}

noalloc fn passThrough(e: Error) -> Error {
    e
}

noalloc fn tailReturn(e: Error) -> Error {
    return e
}

fn helper(xs: Array[Int]) -> usize {
    xs.len()
}

noalloc fn inferred(xs: Array[Int]) -> usize {
    helper(xs)
}

fn helper2(x: Int) -> String {
    "${x}"
}

noalloc fn viaInferredAlloc(x: Int) -> String {
    helper2(x) //~ ERROR `helper2` is not `noalloc`
}

pure fn pureOnly(xs: Array[Int]) -> usize {
    xs.len()
}

noalloc fn callsDeclaredPure(xs: Array[Int]) -> usize {
    pureOnly(xs) //~ ERROR `pureOnly` is not `noalloc`
}

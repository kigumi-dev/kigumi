-- src --
type R = resource {
    pub mut id Int
}

fn R.drop(move self) {
    _ = self
}

fn see(n: Int) -> Int {
    n
}

fn seeName(s: &String) -> Bool {
    s == "z"
}

type E = A(r: R) | C

type W = {
    pub mut items Array[R]
    pub mut tag Int
}

fn W.clear(mut self) {
    self.items = Array.empty[R]()
}

type Cfg = {
    pub mut name String
    pub mut port Int
}

fn matchRef() {
    let mut e = A(R { id: 1 })
    let r = &e
    match r {
        A(x) -> {
            e = C
            _ = see(x.id)
        }
        C -> {}
    }
}

fn isRef() {
    let mut e = A(R { id: 2 })
    let r = &e
    if r is A(x) {
        e = C
        _ = see(x.id)
    }
}

fn recordMutRef() -> usize {
    let mut w = W { items: Array.of(R { id: 3 }), tag: 0 }
    let r = &mut w
    match r {
        W { items, tag } -> {
            w.clear()
            items.len()
        }
    }
}

fn fieldOfRef() {
    let mut c = Cfg { name: "a", port: 1 }
    let r = &c
    let n = &r.name
    c.name = "z"
    _ = seeName(n)
}

fn isInLoopStillLive() {
    let mut o = Some(R { id: 4 })
    for i in 0..2 {
        if &o is Some(s) {
            o = None
            _ = see(s.id)
        }
    }
}

fn flagReassigned(ok: Bool) {
    let mut v = Array.of("a")
    let r = &v
    let mut go = ok
    if go {
        v.push("b")
    }
    go = !go
    if go {
        _ = see(1)
    } else {
        _ = r.len()
    }
}

fn otherFlag(ok: Bool, other: Bool) {
    let mut v = Array.of("a")
    let r = &v
    if ok {
        v.push("b")
    }
    if other {
        _ = see(1)
    } else {
        _ = r.len()
    }
}

fn sameFlagSameSide(ok: Bool) {
    let mut v = Array.of("a")
    let r = &v
    if ok {
        v.push("b")
    }
    if ok {
        _ = r.len()
    }
}

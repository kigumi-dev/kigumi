-- lib/fields.kg --
type Handle = resource {
    pub id Int
}

fn Handle.drop(move self) {}

fn Handle.close(move self) {}

fn Handle.peek(self) -> Int {
    self.id
}

fn take(h: Handle) {}

fn takePack(p: Pack) {}

type Pack = {
    pub mut inner Handle
    pub mut other Handle
    pub mut n Int
}

type Outer = {
    pub mut pack Pack
}

fn mk() -> Pack {
    Pack { inner: Handle { id: 1 }, other: Handle { id: 2 }, n: 0 }
}

fn reassignWhole() {
    let mut b = mk()
    defer { take(b.inner) }
    b = mk() //~ ERROR `b.inner` is reserved by a cleanup that consumes it and cannot be assigned
}

fn reassignField() {
    let mut b = mk()
    defer { take(b.inner) }
    b.inner = Handle { id: 3 } //~ ERROR `b.inner` is reserved by a cleanup that consumes it and cannot be assigned
}

fn reassignFailField() -> Void! {
    let mut b = mk()
    defer(fail) { take(b.inner) }
    b.inner = Handle { id: 3 } //~ ERROR `b.inner` is reserved by a cleanup that consumes it and cannot be assigned
}

fn reassignNestedField() {
    let mut o = Outer { pack: mk() }
    defer { take(o.pack.inner) }
    o.pack = mk() //~ ERROR `o.pack.inner` is reserved by a cleanup that consumes it and cannot be assigned
}

fn moveWhole() {
    let b = mk()
    defer { take(b.inner) }
    let c = b //~ ERROR `b.inner` is reserved by a cleanup that consumes it and cannot be moved
    _ = c.n
}

fn moveField() {
    let b = mk()
    defer { take(b.inner) }
    take(b.inner) //~ ERROR `b.inner` is reserved by a cleanup that consumes it and cannot be moved
}

fn moveFieldByClose() {
    let b = mk()
    defer { b.inner.close() }
    b.inner.close() //~ ERROR `b.inner` is reserved by a cleanup that consumes it and cannot be moved
}

fn secondCleanupSameField() {
    let b = mk()
    defer { take(b.inner) }
    defer { take(b.inner) } //~ ERROR `b.inner` is already consumed by an earlier cleanup
}

fn secondCleanupWholeBinding() {
    let b = mk()
    defer { take(b.inner) }
    defer { takePack(b) } //~ ERROR `b.inner` is already consumed by an earlier cleanup
}

fn outerBindingAssignedAfterConsume() {
    let mut h = Handle { id: 1 }
    defer {
        h.close()
        h = Handle { id: 2 } //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be assigned
    }
}

fn outerFieldAssignedAfterConsume() {
    let mut b = mk()
    defer {
        take(b.inner)
        b.inner = Handle { id: 2 } //~ ERROR `b.inner` is reserved by a cleanup that consumes it and cannot be assigned
    }
}

fn lambdaMovesReserved() {
    let h = Handle { id: 1 }
    defer { h.close() }
    let f = () => h //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
    _ = f
}

fn lambdaMovesFailReserved() -> Void! {
    let h = Handle { id: 1 }
    defer(fail) { h.close() }
    let f = () => h //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
    _ = f
}

fn lambdaMovesWholeOfFieldReserved() {
    let b = mk()
    defer { take(b.inner) }
    let f = () => b //~ ERROR `b.inner` is reserved by a cleanup that consumes it and cannot be moved
    _ = f
}

fn breakMovesReserved() {
    let h = Handle { id: 1 }
    defer { h.close() }
    let r = for { break h } //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
    _ = r
}

fn breakMovesFailReserved() -> Void! {
    let h = Handle { id: 1 }
    defer(fail) { h.close() }
    let r = for { break h } //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
    _ = r
}

fn siblingFieldStaysUsable() {
    let mut b = mk()
    defer { take(b.inner) }
    take(b.other)
    b.other = Handle { id: 5 }
    b.n = 3
    _ = b.inner.peek()
}

fn siblingCleanups() {
    let b = mk()
    defer { take(b.inner) }
    defer { take(b.other) }
}

fn siblingAfterFailCleanup() -> Void! {
    let b = mk()
    defer(fail) { take(b.inner) }
    take(b.other)
}

fn closureBorrowsReservedBinding() {
    let h = Handle { id: 1 }
    defer { h.close() }
    let n = h.peek()
    _ = n
}

fn assignBeforeConsumeInCleanup() {
    let mut h = Handle { id: 1 }
    defer {
        h = Handle { id: 2 }
        h.close()
    }
}

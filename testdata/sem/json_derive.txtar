-- app/t/t.kg --
import json from std/json

type Point = {
    pub x Int
    pub y Int
}

type Handler = {
    pub run fn(Int) -> Int
}

type Boxed = {
    pub items Array[Point]
}

fn useIt() -> Void! {
    let p = Point { x: 1, y: 2 }
    let text = json.encode(p)?
    _ = text
    let back = json.decode[Point]("{}")?
    _ = back
    let h = Handler { run: (n: Int) => n }
    let bad = json.encode(h)? //~ ERROR `Handler` does not satisfy `Encode`
    _ = bad
}

pub fn i64.trim(self) -> Int { //~ ERROR member functions of `i64` must be declared in package
    self
}

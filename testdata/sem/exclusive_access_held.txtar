-- app/t/t.kg --
type Item = {
    pub mut count Int
}

fn Item.update(mut self, d: Int) {
    self.count = self.count + d
}

fn Item.run[F: FnMut[fn() -> Void]](mut self, f: F) {
    f()
}

interface Cb {
    fn call(mut self)
}

@impl(Cb)
type Box[F: FnMut[fn() -> Void]] = {
    pub cb F
}

fn Box[F].call(mut self) {
    self.cb()
}

fn Item.runBox[F: FnMut[fn() -> Void]](mut self, b: Box[F]) {
    let mut b2 = b
    b2.call()
}

fn Item.runT[T: Cb](mut self, t: T) {
    let mut t2 = t
    t2.call()
}

fn Item.runDyn(mut self, t: Cb) {
    let mut t2 = t
    t2.call()
}

fn Item.runPair[F: FnMut[fn() -> Void]](mut self, p: (F, Int)) {
    let (f, _) = p
    f()
}

fn Item.runArr[F: FnMut[fn() -> Void]](mut self, p: Array[F]) {
    let _ = p
}

fn id[T](x: T) -> T {
    x
}

type Res = resource {
    pub mut xs Array[Int]
}

fn Res.drop(move self) {}

fn Res.runBox[F: FnMut[fn() -> Void]](mut self, b: Box[F]) {
    let mut b2 = b
    b2.call()
}

fn recordInline() {
    let mut v = Item { count: 0 }
    v.runBox(Box { cb: () => { v.update(1) } }) //~ ERROR an argument of this call holds a closure that captures `v`
}

fn recordViaLet() {
    let mut v = Item { count: 0 }
    let b = Box { cb: () => { v.update(1) } }
    v.runBox(b) //~ ERROR a `mut self` call on `v` conflicts //~ ERROR an argument of this call holds a closure that captures `v`
}

fn viaGenericCall() {
    let mut v = Item { count: 0 }
    v.runBox(id(Box { cb: () => { v.update(1) } })) //~ ERROR an argument of this call holds a closure that captures `v`
}

fn viaWitness() {
    let mut v = Item { count: 0 }
    v.runT(Box { cb: () => { v.update(1) } }) //~ ERROR an argument of this call holds a closure that captures `v`
}

fn viaExistentialInline() {
    let mut v = Item { count: 0 }
    v.runDyn(Box { cb: () => { v.update(1) } }) //~ ERROR an argument of this call holds a closure that captures `v`
}

fn viaExistentialLet() {
    let mut v = Item { count: 0 }
    let c: Cb = Box { cb: () => { v.update(1) } }
    v.runDyn(c) //~ ERROR a `mut self` call on `v` conflicts //~ ERROR an argument of this call holds a closure that captures `v`
}

fn viaTuple() {
    let mut v = Item { count: 0 }
    v.runPair((() => { v.update(1) }, 1)) //~ ERROR an argument of this call holds a closure that captures `v`
}

fn viaArray() {
    let mut v = Item { count: 0 }
    v.runArr(Array.of(() => { v.update(1) })) //~ ERROR an argument of this call holds a closure that captures `v`
}

fn readOnlyCapture() {
    let mut r = Res { xs: Array.of(1) }
    r.runBox(Box { cb: () => { let _ = r.xs.len() } }) //~ ERROR an argument of this call holds a closure that captures `r`
}

fn twoLevels() {
    let mut v = Item { count: 0 }
    let inner = () => { v.update(1) }
    let middle = () => { inner() }
    let outer = () => { middle() }
    v.run(outer) //~ ERROR a `mut self` call on `v` conflicts //~ ERROR a closure argument cannot capture `v`
}

fn insideClosureBody() {
    let mut v = Item { count: 0 }
    let inner = () => { v.update(1) } //~ ERROR a `mut self` call on `v` conflicts
    let outer = () => { v.run(inner) } //~ ERROR a `mut self` call on `v` conflicts //~ ERROR a closure argument cannot capture `v`
    outer()
}

fn callAfterLoopClosure() {
    let mut v = Item { count: 0 }
    for _ in 0..2 {
        v.update(1) //~ ERROR a `mut self` call on `v` conflicts
        let touch = () => { v.update(1) }
        touch()
    }
}

fn apply[F: FnMut[fn() -> Void]](x: &mut Item, f: F) {
    f()
}

fn mutRefArgument() {
    let mut v = Item { count: 0 }
    apply(&mut v, () => { v.update(1) }) //~ ERROR a closure argument cannot capture `v`
}

fn mutRefNamedClosure() {
    let mut v = Item { count: 0 }
    let touch = () => { v.update(1) }
    apply(&mut v, touch) //~ ERROR a closure argument cannot capture `v` //~ ERROR `&mut v` conflicts with a closure
}

fn mutRefAlias() {
    let mut v = Item { count: 0 }
    let r = &mut v
    r.run(() => { v.update(1) }) //~ ERROR a closure argument cannot capture `v`
}

fn lostInformation() {
    let mut v = Item { count: 0 }
    let touch = () => { v.update(1) }
    let mut c: Cb = Box { cb: () => {} }
    c = Box { cb: touch }
    v.runDyn(c) //~ ERROR a `mut self` call on `v` conflicts //~ ERROR cannot see which closures `c` holds
}

fn forLoopAlias() {
    let mut xs = Array.of(Item { count: 0 })
    for x in &mut xs {
        x.run(() => { xs.push(Item { count: 1 }) }) //~ ERROR a closure argument cannot capture `xs`
    }
}

type Holder = {
    pub c Cb
}

fn Item.runHolder(mut self, h: Holder) {
    let mut c2 = move h.c
    c2.call()
}

fn lostInRecordField() {
    let mut v = Item { count: 0 }
    let touch = () => { v.update(1) }
    let mut c: Cb = Box { cb: () => {} }
    c = Box { cb: touch }
    v.runHolder(Holder { c: c }) //~ ERROR a `mut self` call on `v` conflicts //~ ERROR cannot see which closures `c` holds
}

-- src --
type In = {
    pub mut v Int
}

type B = {
    pub mut n Int
    pub mut m Int
    pub mut i In
}

fn viaMatch(b: &mut B) -> Unit {
    match b {
        B { n } -> {
            n = n + 1 //~ ERROR
        }
    }
}

fn viaRename(b: &mut B) -> Unit {
    match b {
        B { n: k } -> {
            k = 2 //~ ERROR
        }
    }
}

fn viaNested(b: &mut B) -> Unit {
    match b {
        B { i: In { v } } -> {
            v = 3 //~ ERROR
        }
    }
}

fn viaIs(b: &mut B) -> Unit {
    if b is (B { n }) {
        n = 1 //~ ERROR
    }
}

fn viaPayload(o: &mut Int?) -> Unit {
    match o {
        Some(n) -> {
            n = 3 //~ ERROR
        }
        None -> {}
    }
}

fn bump(x: &mut Int) -> Unit {
    x = x + 1
}

fn viaCall(b: &mut B) -> Unit {
    match b {
        B { n } -> {
            bump(n) //~ ERROR
        }
    }
}

fn viaCallPayload(o: &mut Int?) -> Unit {
    match o {
        Some(n) -> bump(n) //~ ERROR
        None -> {}
    }
}

fn viaCallField(b: &mut B) -> Unit {
    match b {
        B { n } -> {
            bump(&mut b.n)
            b.m = n + 1
        }
    }
}

fn throughField(b: &mut B) -> Unit {
    match b {
        B { n, i } -> {
            b.m = n + 1
            i.v = n + 2
        }
    }
}

fn readOnly(b: &mut B) -> Int {
    match b {
        B { n, m } -> n + m
    }
}

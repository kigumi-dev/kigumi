-- lib/esc.kg --
pub type Handler[F] = { pub callback F }

fn keep[F: Fn[fn() -> Unit]](callback: escaping F) -> Handler[F] {
    Handler { callback: callback }
}

fn storePlain[F: Fn[fn() -> Unit]](callback: F) -> Handler[F] {
    Handler { callback: callback } //~ ERROR cannot be stored
}

fn returnPlain[F: Fn[fn() -> Unit]](callback: F) -> F {
    callback //~ ERROR cannot be returned
}

fn capturePlain[F: Fn[fn() -> Unit] + Copy](callback: F) -> fn() -> Unit {
    () => callback() //~ ERROR cannot be captured
}

fn forwardPlain[F: Fn[fn() -> Unit]](callback: F) -> Handler[F] {
    keep(callback) //~ ERROR cannot be passed to `keep`
}

fn viaRegister[F: Fn[fn() -> Unit]](register: fn(escaping F) -> Unit, callback: F) -> Unit {
    register(callback) //~ ERROR cannot be passed to `this function`
}

fn narrowRegister[F: Fn[fn() -> Unit]](register: escaping fn(escaping F) -> Unit) -> fn(F) -> Unit {
    register //~ ERROR may keep its callback
}

fn unbounded[T](value: escaping T) -> Unit {} //~ ERROR is not bounded by

fn notCallable(value: escaping Int) -> Unit {} //~ ERROR not `Int`

fn optionOfF[F: Fn[fn() -> Unit]](value: escaping Option[F]) -> Unit {} //~ ERROR not `F?`

type Wrapped = fn() -> Unit

fn notAlias(callback: escaping Wrapped) -> Unit {} //~ ERROR not `Wrapped`

fn badFnType[T](register: fn(escaping T) -> Unit) -> Unit {} //~ ERROR is not bounded by

pub interface Registry[F: Fn[fn() -> Unit]] {
    fn add(self, callback: F) -> Unit
}

@impl(Registry[F]) //~ ERROR `Slots` does not implement `Registry[F]`
pub type Slots[F: Fn[fn() -> Unit]] = {
    pub n Int
}

pub fn Slots[F].add(self, callback: escaping F) -> Unit {}
pub type Slot[F] = { pub mut cb F }

fn setG[F: Fn[fn() -> Unit]](s: &mut Slot[F], cb: escaping F) -> Unit {
    s.cb = cb
}

fn viaItem[F: Fn[fn() -> Unit]](cb: F, s: &mut Slot[F]) -> Unit {
    let k: fn(&mut Slot[F], F) -> Unit = setG //~ ERROR may keep its callback
    k(s, cb)
}

fn needPlainF[F: Fn[fn() -> Unit]](reg: fn(F) -> Unit, f: F) -> Unit {
    reg(f)
}

fn eager[G: Fn[fn() -> Unit]](cb: escaping G) -> Unit {}

fn viaArg[F: Fn[fn() -> Unit]](f: F) -> Unit {
    needPlainF(eager, f) //~ ERROR may keep its callback
}

pub type Reg = { pub n Int }

pub fn Reg.add[F: Fn[fn() -> Unit]](self, cb: escaping F) -> Handler[F] {
    Handler { callback: cb }
}

fn viaMethod(r: Reg) -> Unit {
    let k: fn(fn() -> Unit) -> Handler[fn() -> Unit] = r.add //~ ERROR may keep its callback
}

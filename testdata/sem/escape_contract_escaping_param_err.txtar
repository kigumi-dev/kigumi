-- lib/esc.kg --
pub type Handler[F] = { pub callback F }

fn keep[F: Fn[fn() -> Void]](callback: escaping F) -> Handler[F] {
    Handler { callback: callback }
}

fn storePlain[F: Fn[fn() -> Void]](callback: F) -> Handler[F] {
    Handler { callback: callback } //~ ERROR cannot be stored
}

fn returnPlain[F: Fn[fn() -> Void]](callback: F) -> F {
    callback //~ ERROR cannot be returned
}

fn capturePlain[F: Fn[fn() -> Void] + Copy](callback: F) -> fn() -> Void {
    () => callback() //~ ERROR cannot be captured
}

fn forwardPlain[F: Fn[fn() -> Void]](callback: F) -> Handler[F] {
    keep(callback) //~ ERROR cannot be passed to `keep`
}

fn viaRegister[F: Fn[fn() -> Void]](register: fn(escaping F) -> Void, callback: F) {
    register(callback) //~ ERROR cannot be passed to `this function`
}

fn narrowRegister[F: Fn[fn() -> Void]](register: escaping fn(escaping F) -> Void) -> fn(F) -> Void {
    register //~ ERROR may keep its callback
}

fn unbounded[T](value: escaping T) {} //~ ERROR is not bounded by

fn notCallable(value: escaping Int) {} //~ ERROR not `Int`

fn optionOfF[F: Fn[fn() -> Void]](value: escaping Option[F]) {} //~ ERROR not `F?`

type Wrapped = fn() -> Void

fn notAlias(callback: escaping Wrapped) {} //~ ERROR not `Wrapped`

fn badFnType[T](register: fn(escaping T) -> Void) {} //~ ERROR is not bounded by

pub interface Registry[F: Fn[fn() -> Void]] {
    fn add(self, callback: F)
}

@impl(Registry[F]) //~ ERROR `Slots` does not implement `Registry[F]`
pub type Slots[F: Fn[fn() -> Void]] = {
    pub n Int
}

pub fn Slots[F].add(self, callback: escaping F) {}
pub type Slot[F] = { pub mut cb F }

fn setG[F: Fn[fn() -> Void]](s: &mut Slot[F], cb: escaping F) {
    s.cb = cb
}

fn viaItem[F: Fn[fn() -> Void]](cb: F, s: &mut Slot[F]) {
    let k: fn(&mut Slot[F], F) -> Void = setG //~ ERROR may keep its callback
    k(s, cb)
}

fn needPlainF[F: Fn[fn() -> Void]](reg: fn(F) -> Void, f: F) {
    reg(f)
}

fn eager[G: Fn[fn() -> Void]](cb: escaping G) {}

fn viaArg[F: Fn[fn() -> Void]](f: F) {
    needPlainF(eager, f) //~ ERROR may keep its callback
}

pub type Reg = { pub n Int }

pub fn Reg.add[F: Fn[fn() -> Void]](self, cb: escaping F) -> Handler[F] {
    Handler { callback: cb }
}

fn viaMethod(r: Reg) {
    let k: fn(fn() -> Void) -> Handler[fn() -> Void] = r.add //~ ERROR may keep its callback
}

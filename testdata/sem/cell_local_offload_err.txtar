type FnRec = { pub f fn(Future[Int]) -> Void }
fn wrapFn(f: escaping fn(Future[Int]) -> Void) -> FnRec { FnRec { f: f } }
fn callFirst(a: Array[fn(Future[Int]) -> Void], h: Future[Int]) { a[0](h) }
fn callWrapped(b: FnRec, h: Future[Int]) { (b.f)(h) }
fn passInArray(g: fn(Array[fn(Future[Int]) -> Void], Future[Int]) -> Void, f: escaping fn(Future[Int]) -> Void, h: Future[Int]) { g(Array.of(f), h) }
fn passPushed(g: fn(Array[fn(Future[Int]) -> Void], Future[Int]) -> Void, f: escaping fn(Future[Int]) -> Void, h: Future[Int]) {
    let mut a = Array.empty[fn(Future[Int]) -> Void]()
    a.push(f)
    g(a, h)
}
fn passCopied(g: fn(Array[fn(Future[Int]) -> Void], Future[Int]) -> Void, f: escaping fn(Future[Int]) -> Void, h: Future[Int]) {
    let a = Array.of(f)
    let b = a
    g(b, h)
}
fn passWrapped(g: fn(FnRec, Future[Int]) -> Void, f: escaping fn(Future[Int]) -> Void, h: Future[Int]) { g(wrapFn(f), h) }
fn passTwoHops(g: fn(Array[fn(Future[Int]) -> Void], Future[Int]) -> Void, f: escaping fn(Future[Int]) -> Void, h: Future[Int]) { passInArray(g, f, h) }
fn callAfter[F: FnOnce[fn() -> Void]](c: F) { c() }
fn spawnLaterIn(h: Future[Int]) { callAfter(move () => { spawnTask(h) }) }
fn spawnLaterNamed(h: Future[Int]) {
    let c = move () => { spawnTask(h) }
    callAfter(c)
}
fn spawnLaterNested(h: Future[Int]) { callAfter(move () => { callAfter(move () => { spawnTask(h) }) }) }
async fn spawnLaterAsync(h: Future[Int]) -> Int {
    callAfter(move () => { spawnTask(h) })
    0
}
fn spawnLaterOuter(h: Future[Int]) { spawnLaterIn(h) }
fn dropLaterIn(h: Future[Int]) { callAfter(move () => { dropTask(h) }) }


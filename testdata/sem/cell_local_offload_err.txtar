    let mut other = "o"
    let c = () => { spawnTask(pool.run(() => { other = "x"; 1 }).unwrap()) } //~ ERROR closure captures
    c()
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    r.len().toInt() || 0
}


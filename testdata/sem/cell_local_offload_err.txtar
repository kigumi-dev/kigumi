async fn countedPassThrough() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut calls = 0
    let pass = (h: Future[Int]) => {
        calls = calls + 1
        h
    }
    let h2 = pass(pool.run(() => { other = "x"; 1 }).unwrap())
    let n = await h2
    let r = &other
    n + calls + (r.len().toInt() || 0)
}

async fn awaitedInAppliedClosure() -> Int {
    let pool = task.BlockingPool.new(1)

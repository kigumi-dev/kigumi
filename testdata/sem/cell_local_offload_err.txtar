type SlotHolder = { pub mut b FnSlot }
fn pickSlot['a](h: &'a mut SlotHolder) -> &'a mut FnSlot {
    h.b.f = spawnTask
    &mut h.b
}
fn pickSlotTwice['a](h: &'a mut SlotHolder) -> &'a mut FnSlot { pickSlot(h) }
fn pickSlotDrop['a](h: &'a mut SlotHolder) -> &'a mut FnSlot {
    h.b.f = dropTask
    &mut h.b
}
fn FnSlot.pickSpawn(mut self) -> &mut FnSlot {
    self.f = spawnTask
    &mut self
}
fn runPickedSlot(h: Future[Int]) {
    let mut hd = SlotHolder { b: FnSlot { f: dropTask } }
    let m = pickSlot(&mut hd)
    (m.f)(h)
}

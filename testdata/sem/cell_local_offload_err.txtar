    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let n = match pool.run(() => { other = "x"; 1 }) {
        Ok(f) -> 1,
        Err(e) -> 0
    }
    n + (other.len().toInt() || 0)
}

async fn awaitedAfterQuestion() -> Int! {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let n = await pool.run(() => { other = "x"; 1 })?
    Ok(n + (other.len().toInt() || 0))
}

async fn storedFromResult() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut keep = Array.empty[Future[Int]]()
    let n = match pool.run(() => { other = "x"; 1 }) {
        Ok(f) -> {
            keep.push(f)
            0
        },
        Err(e) -> 0
    }
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    n + (r.len().toInt() || 0) + (keep.len().toInt() || 0)
}

async fn errCheckedFirst() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let res = pool.run(() => { other = "x"; 1 })
    if res is Err(e) {
        return 0
    }
    let k = other.len().toInt() || 0 //~ ERROR `other` is written by a closure that may still be running on another thread
    let n = match res {
        Ok(f) -> await f,
        Err(e) -> 0
    }
    n + k
}

fn twice(n: Int) -> Int { n * 2 }

fn spawnThrough(h: Future[Int], sp: fn(Future[Int]) -> task.Task[Int]) -> Int {
    let t = sp(h)
    0
}

fn applyTo[T, G: FnOnce[fn(T) -> task.Task[Int]]](x: T, g: G) -> Int {
    let t = g(x)
    0
}

async fn spawnedThroughFnValue() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let h = pool.run(() => { other = "x"; 1 }).unwrap()
    let sp: fn(Future[Int]) -> task.Task[Int] = task.spawn[Int]
    let _ = sp(h)
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    r.len().toInt() || 0
}

async fn spawnedInHelperThroughParam() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let h = pool.run(() => { other = "x"; 1 }).unwrap()
    let n = spawnThrough(h, task.spawn[Int])
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    n + (r.len().toInt() || 0)
}

async fn spawnedInGenericHelper() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let h = pool.run(() => { other = "x"; 1 }).unwrap()
    let n = applyTo(h, (f: Future[Int]) => task.spawn(f))
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    n + (r.len().toInt() || 0)
}

async fn intFnValueBeside() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let h = pool.run(() => { other = "x"; 1 }).unwrap()
    let g: fn(Int) -> Int = twice
    let k = g(3)
    let n = await waitIn(h)
    let r = &other
    n + k + (r.len().toInt() || 0)
}

fn applyOnce[F: FnOnce[fn() -> Int]](f: F) -> Int { f() }
fn applyFuture[F: FnOnce[fn() -> Future[Int]]](f: F) -> Future[Int] { f() }

async fn storedByCalledClosure() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut held = Array.empty[Future[Int]]()
    let adder = (h: Future[Int]) => { held.push(h) }
    adder(pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    r.len().toInt() || 0
}

async fn storedThenReassigned() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut held = Array.empty[Future[Int]]()
    let adder = (h: Future[Int]) => { held.push(h) }
    adder(pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    let m = r.len().toInt() || 0
    held = Array.empty[Future[Int]]()
    m
}

async fn spawnedByAppliedClosure() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let h = pool.run(() => { other = "x"; 1 }).unwrap()
    let n = applyOnce(move () => {
        let t = task.spawn(h)
        0
    })
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    n + (r.len().toInt() || 0)
}

async fn spawnedByNamedClosure() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let h = pool.run(() => { other = "x"; 1 }).unwrap()
    let c = move () => {
        let t = task.spawn(h)
        0
    }
    let n = applyOnce(c)
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    n + (r.len().toInt() || 0)
}

async fn countedPassThrough() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut calls = 0
    let pass = (h: Future[Int]) => {
        calls = calls + 1
        h
    }
    let h2 = pass(pool.run(() => { other = "x"; 1 }).unwrap())
    let n = await h2
    let r = &other
    n + calls + (r.len().toInt() || 0)
}

async fn awaitedInAppliedClosure() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let h = pool.run(() => { other = "x"; 1 }).unwrap()
    let n = await applyFuture(move () => waitIn(h))
    let r = &other
    n + (r.len().toInt() || 0)
}

async fn storedInOwnedCell() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut held = Array.empty[Future[Int]]()
    let h = pool.run(() => { other = "x"; 1 }).unwrap()
    let n = applyOnce(move () => {
        held.push(h)
        0
    })
    let r = &other
    n + (r.len().toInt() || 0)
}

type Hd[F] = { pub f F }

async fn storedThroughOuterClosure() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut held = Array.empty[Future[Int]]()
    let inner = (h: Future[Int]) => { held.push(h) }
    let outer = (h: Future[Int]) => { inner(h) }
    outer(pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    r.len().toInt() || 0
}

async fn storedByClosureBuiltInside() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut held = Array.empty[Future[Int]]()
    let outer = (h: Future[Int]) => {
        let inner = (g: Future[Int]) => { held.push(g) }
        inner(h)
    }
    outer(pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    r.len().toInt() || 0
}

async fn storedThroughRecordField() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut held = Array.empty[Future[Int]]()
    let hd = Hd { f: (h: Future[Int]) => { held.push(h) } }
    (hd.f)(pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    r.len().toInt() || 0
}

async fn storedThroughCopiedRecord() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut held = Array.empty[Future[Int]]()
    let hd = Hd { f: (h: Future[Int]) => { held.push(h) } }
    let hh = hd
    (hh.f)(pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    r.len().toInt() || 0
}


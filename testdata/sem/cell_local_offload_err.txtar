    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let o = Some(pool.run(() => { other = "x"; 1 }).unwrap())
    let n = match o {
        Some(f) -> 1,
        None -> 0
    }
    n + (other.len().toInt() || 0) //~ ERROR `other` is written by a closure that may still be running on another thread
}


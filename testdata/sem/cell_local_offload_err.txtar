    putSlot(b.me(), dropTask)
    (b.f)(h)
}
fn storeDropViaBranch(h: Future[Int], c: Bool) {
    let mut b1 = FnSlot { f: dropTask }
    let mut b2 = FnSlot { f: dropTask }
    let m = if c { &mut b1 } else { &mut b2 }
    m.f = dropTask
    (b1.f)(h)
}
fn storeDropViaCapture(h: Future[Int]) {
    let mut g: fn(Future[Int]) -> Void = dropTask
    let st = () => { g = dropTask }
    st()
    g(h)
}


type FnSlot = { pub mut f fn(Future[Int]) -> Void }
fn FnSlot.me(mut self) -> &mut FnSlot { &mut self }
fn putSlot(b: &mut FnSlot, f: escaping fn(Future[Int]) -> Void) { b.f = f }
fn storeSpawnViaReturnedRef(h: Future[Int]) {
    let mut b = FnSlot { f: dropTask }
    let m = b.me()
    m.f = spawnTask
    (b.f)(h)
}
fn storeSpawnViaReturnedRefCall(h: Future[Int]) {
    let mut b = FnSlot { f: dropTask }
    putSlot(b.me(), spawnTask)
    (b.f)(h)
}
fn storeSpawnViaBranch(h: Future[Int], c: Bool) {
    let mut b1 = FnSlot { f: dropTask }
    let mut b2 = FnSlot { f: dropTask }
    let m = if c { &mut b1 } else { &mut b2 }
    m.f = spawnTask
    (b1.f)(h)
}
fn storeSpawnViaCapture(h: Future[Int]) {
    let mut g: fn(Future[Int]) -> Void = dropTask
    let st = () => { g = spawnTask }
    st()
    g(h)
}
fn storeSpawnViaCaptureLater(h: Future[Int]) {
    let mut g: fn(Future[Int]) -> Void = dropTask
    callAfter(() => { g = spawnTask })
    g(h)
}
fn storeDropViaReturnedRef(h: Future[Int]) {

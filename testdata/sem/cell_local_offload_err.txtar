fn applyForwarder(g: fn(fn(Future[Int]) -> Void, Future[Int]) -> Void, f: fn(Future[Int]) -> Void, h: Future[Int]) { g(f, h) }
fn applyForwarderTwice(g: fn(fn(Future[Int]) -> Void, Future[Int]) -> Void, f: fn(Future[Int]) -> Void, h: Future[Int]) { applyForwarder(g, f, h) }
type FnBox = { pub f fn(Future[Int]) -> Void }
fn applyBoxed(g: fn(FnBox, Future[Int]) -> Void, f: escaping fn(Future[Int]) -> Void, h: Future[Int]) { g(FnBox { f: f }, h) }
fn callBoxed(b: FnBox, h: Future[Int]) { (b.f)(h) }

async fn spawningClosureRunInLoop() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let c = () => { spawnTask(pool.run(() => { other = "x"; 1 }).unwrap()) } //~ ERROR closure captures
    for i in 0..1 {

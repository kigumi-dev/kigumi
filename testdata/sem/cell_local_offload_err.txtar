async fn storedThroughOuterThenAwaited() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let h = pool.run(() => { other = "x"; 1 }).unwrap()
    let n = {
        let mut held = Array.empty[Future[Int]]()
        let inner = (g: Future[Int]?) => {
            match g {
                Some(x) -> {
                    held.push(x)
                    None
                },
                None -> held.takeAt(0)
            }
        }
        let outer = (g: Future[Int]?) => inner(g)
        let _ = outer(Some(h))
        match outer(None) {
            Some(f) -> await f,
            None -> 0
        }
    }
    let r = &other
    n + (r.len().toInt() || 0)
}

async fn storedThroughFieldThenAwaited() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let h = pool.run(() => { other = "x"; 1 }).unwrap()
    let n = {
        let mut held = Array.empty[Future[Int]]()
        let hd = Hd { f: (g: Future[Int]?) => {
            match g {
                Some(x) -> {
                    held.push(x)
                    None
                },
                None -> held.takeAt(0)
            }
        } }
        let _ = (hd.f)(Some(h))
        match (hd.f)(None) {
            Some(f) -> await f,
            None -> 0
        }
    }
    let r = &other
    n + (r.len().toInt() || 0)
}

fn forwardTo[F: FnOnce[fn(Future[Int]) -> Void]](f: F, h: Future[Int]) { f(h) }
fn forwardTwice[F: FnOnce[fn(Future[Int]) -> Void]](f: F, h: Future[Int]) { forwardTo(f, h) }
async fn forwardAsync[F: FnOnce[fn(Future[Int]) -> Void]](f: F, h: Future[Int]) -> Int {
    f(h)
    0
}
fn spawnTask(h: Future[Int]) {
    let t = task.spawn(h)
}

async fn forwardedToStoringClosure() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut held = Array.empty[Future[Int]]()
    let add = (h: Future[Int]) => { held.push(h) }
    forwardTo(add, pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other
    r.len().toInt() || 0
}


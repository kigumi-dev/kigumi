async fn awaitedFromOption() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let o = Some(pool.run(() => { other = "x"; 1 }).unwrap())
    let n = match o {
        Some(f) -> await f,
        None -> 0
    }
    let r = &other
    n + (r.len().toInt() || 0)
}

async fn storedFromOption() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut keep = Array.empty[Future[Int]]()
    let o = Some(pool.run(() => { other = "x"; 1 }).unwrap())
    let n = match o {
        Some(f) -> {
            keep.push(f)
            0
        },
        None -> 0
    }
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    n + (r.len().toInt() || 0) + (keep.len().toInt() || 0)
}

fn twice(n: Int) -> Int { n * 2 }

fn spawnThrough(h: Future[Int], sp: fn(Future[Int]) -> task.Task[Int]) -> Int {
    let t = sp(h)
    0
}

fn applyTo[T, G: FnOnce[fn(T) -> task.Task[Int]]](x: T, g: G) -> Int {
    let t = g(x)
    0
}


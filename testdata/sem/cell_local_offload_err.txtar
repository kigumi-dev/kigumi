    let mut other = "o"
    let mut held = Array.empty[Future[Int]]()
    let add = (h: Future[Int]) => { held.push(h) }
    let fu = forwardAsync(add, pool.run(() => { other = "x"; 1 }).unwrap())
    let n = await fu
    let r = &other

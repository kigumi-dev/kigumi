-- module --
mir: planned
-- src --
import task from std/task

fn offload[F: FnOnce[fn() -> Int]](pool: task.BlockingPool, f: escaping F) -> Future[Int] { pool.run(f).unwrap() }
async fn runOn[F: FnOnce[fn() -> Int]](pool: task.BlockingPool, f: escaping F) -> Int { await pool.run(f).unwrap() }
fn peekLen(s: &String) { let n = s.len() }

async fn borrowWhileRunning() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let w = () => { other = "x"; 1 }
    let fut = pool.run(w).unwrap()
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    let l = r.len().toInt() || 0
    l + await fut
}

async fn throughHelper() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let fut = offload(pool, () => { other = "x"; 1 })
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    let l = r.len().toInt() || 0
    l + await fut
}

async fn throughMethodValue() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let run = pool.run
    let fut = run(() => { other = "x"; 1 }).unwrap()
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    let l = r.len().toInt() || 0
    l + await fut
}

async fn throughQuestion() -> Int! {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let fut = pool.run(() => { other = "x"; 1 })?
    let k = other.len().toInt() || 0 //~ ERROR `other` is written by a closure that may still be running on another thread
    k + await fut
}

async fn writeWhileReading() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let fut = pool.run(() => other.len().toInt() || 0).unwrap() //~ ERROR closure captures
    let k = other.len().toInt() || 0
    other = "y" //~ ERROR `other` is read by a closure that may still be running on another thread, and cannot be mutated here
    k + await fut
}

async fn twoWriters() -> Int {
    let pool = task.BlockingPool.new(2)
    let mut other = "o"
    let a = pool.run(() => { other = "a"; 1 }).unwrap()
    let b = pool.run(() => { other = "b"; 2 }).unwrap() //~ ERROR `other` is written by a closure that may still be running on another thread
    (await a) + (await b)
}

async fn writersInLoop() -> Int {
    let pool = task.BlockingPool.new(2)
    let mut other = "o"
    let mut futs = Array.empty[Future[Int]]()
    for i in 0..2 {
        futs.push(pool.run(() => { other = "l${i}"; i }).unwrap()) //~ ERROR `other` is written by a closure that may still be running on another thread
    }
    let mut t = 0
    for f in futs {
        t = t + await f
    }
    t
}

async fn spawnedResult() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let fut = pool.run(() => { other = "s"; 1 }).unwrap()
    let t = task.spawn(fut)
    let k = other.len().toInt() || 0 //~ ERROR `other` is written by a closure that may still be running on another thread
    k + await t
}

async fn spawnedHelper() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let t = task.spawn(runOn(pool, () => { other = "s"; 1 }))
    let _ = await task.yieldNow()
    let k = other.len().toInt() || 0 //~ ERROR `other` is written by a closure that may still be running on another thread
    k + await t
}

async fn deferredRead() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let fut = pool.run(() => { other = "x"; 1 }).unwrap()
    defer peekLen(&other) //~ ERROR `other` is written by a closure that may still be running on another thread
    2
}

async fn borrowEndsFirst() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let r = &other
    let l = r.len().toInt() || 0
    let fut = pool.run(() => { other = "x"; 1 }).unwrap()
    l + await fut
}

async fn awaitedBeforeBorrow() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let n = await offload(pool, () => { other = "x"; 1 })
    let r = &other
    n + (r.len().toInt() || 0)
}

async fn lazyHelperFuture() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let f = runOn(pool, () => { other = "x"; 1 })
    let r = &other
    let l = r.len().toInt() || 0
    l + await f
}

async fn deferredAfterAwait() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let fut = pool.run(() => { other = "x"; 1 }).unwrap()
    defer peekLen(&other)
    await fut
}

async fn readersShare() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let fut = pool.run(() => other.len().toInt() || 0).unwrap()
    let r = &other
    let l = r.len().toInt() || 0

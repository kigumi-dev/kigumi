-- module --
mir: planned
send-bounds: off
-- src --
import task from std/task

fn offload[F: FnOnce[fn() -> Int]](pool: task.BlockingPool, f: escaping F) -> Future[Int] { pool.run(f).unwrap() }
async fn runOn[F: FnOnce[fn() -> Int]](pool: task.BlockingPool, f: escaping F) -> Int { await pool.run(f).unwrap() }
fn peekLen(s: &String) { let n = s.len() }

async fn borrowWhileRunning() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let w = () => { other = "x"; 1 }
    let fut = pool.run(w).unwrap()
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    let l = r.len().toInt() || 0
    l + await fut
}

async fn throughHelper() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let fut = offload(pool, () => { other = "x"; 1 })
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    let l = r.len().toInt() || 0
    l + await fut
}

async fn throughMethodValue() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let run = pool.run
    let fut = run(() => { other = "x"; 1 }).unwrap()
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    let l = r.len().toInt() || 0
    l + await fut
}

async fn throughQuestion() -> Int! {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let fut = pool.run(() => { other = "x"; 1 })?
    let k = other.len().toInt() || 0 //~ ERROR `other` is written by a closure that may still be running on another thread
    k + await fut
}

async fn writeWhileReading() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let fut = pool.run(() => other.len().toInt() || 0).unwrap() //~ ERROR closure captures
    let k = other.len().toInt() || 0
    other = "y" //~ ERROR `other` is read by a closure that may still be running on another thread, and cannot be mutated here
    k + await fut
}

async fn twoWriters() -> Int {
    let pool = task.BlockingPool.new(2)
    let mut other = "o"
    let a = pool.run(() => { other = "a"; 1 }).unwrap()
    let b = pool.run(() => { other = "b"; 2 }).unwrap() //~ ERROR `other` is written by a closure that may still be running on another thread
    (await a) + (await b)
}

async fn writersInLoop() -> Int {
    let pool = task.BlockingPool.new(2)
    let mut other = "o"
    let mut futs = Array.empty[Future[Int]]()
    for i in 0..2 {
        futs.push(pool.run(() => { other = "l${i}"; i }).unwrap()) //~ ERROR `other` is written by a closure that may still be running on another thread
    }
    let mut t = 0
    for f in futs {
        t = t + await f
    }
    t
}

async fn spawnedResult() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let fut = pool.run(() => { other = "s"; 1 }).unwrap()
    let t = task.spawn(fut)
    let k = other.len().toInt() || 0 //~ ERROR `other` is written by a closure that may still be running on another thread
    k + await t
}

async fn spawnedHelper() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let t = task.spawn(runOn(pool, () => { other = "s"; 1 }))
    let _ = await task.yieldNow()
    let k = other.len().toInt() || 0 //~ ERROR `other` is written by a closure that may still be running on another thread
    k + await t
}

async fn deferredRead() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let fut = pool.run(() => { other = "x"; 1 }).unwrap()
    defer peekLen(&other) //~ ERROR `other` is written by a closure that may still be running on another thread
    2
}

async fn borrowEndsFirst() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let r = &other
    let l = r.len().toInt() || 0
    let fut = pool.run(() => { other = "x"; 1 }).unwrap()
    l + await fut
}

async fn awaitedBeforeBorrow() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let n = await offload(pool, () => { other = "x"; 1 })
    let r = &other
    n + (r.len().toInt() || 0)
}

async fn lazyHelperFuture() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let f = runOn(pool, () => { other = "x"; 1 })
    let r = &other
    let l = r.len().toInt() || 0
    l + await f
}

async fn deferredAfterAwait() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let fut = pool.run(() => { other = "x"; 1 }).unwrap()
    defer peekLen(&other)
    await fut
}

async fn readersShare() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let fut = pool.run(() => other.len().toInt() || 0).unwrap()
    let r = &other
    let l = r.len().toInt() || 0
    l + await fut
}

async fn freshCellPerIteration() -> Int {
    let pool = task.BlockingPool.new(4)
    let mut futs = Array.empty[Future[Int]]()
    for i in 0..3 {
        let mut acc = 0
        futs.push(pool.run(() => { acc = acc + i; acc }).unwrap())
    }
    let mut t = 0
    for f in futs {
        t = t + await f
    }
    t
}

async fn waitIn(h: Future[Int]) -> Int { await h }

async fn detachIn(h: Future[Int]) -> Int {
    let t = task.spawn(h)
    0
}

async fn awaitedInHelper() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let h = pool.run(() => { other = "x"; 1 }).unwrap()
    let n = await waitIn(h)
    let r = &other
    n + (r.len().toInt() || 0)
}

async fn detachedInHelper() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let h = pool.run(() => { other = "x"; 1 }).unwrap()
    let n = await detachIn(h)
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    n + (r.len().toInt() || 0)
}

async fn awaitedFromOption() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let o = Some(pool.run(() => { other = "x"; 1 }).unwrap())
    let n = match o {
        Some(f) -> await f,
        None -> 0
    }
    let r = &other
    n + (r.len().toInt() || 0)
}

async fn storedFromOption() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut keep = Array.empty[Future[Int]]()
    let o = Some(pool.run(() => { other = "x"; 1 }).unwrap())
    let n = match o {
        Some(f) -> {
            keep.push(f)
            0
        },
        None -> 0
    }
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    n + (r.len().toInt() || 0) + (keep.len().toInt() || 0)
}

async fn awaitedFromResult() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let n = match pool.run(() => { other = "x"; 1 }) {
        Ok(f) -> await f,
        Err(e) -> 0
    }
    n + (other.len().toInt() || 0)
}

async fn awaitedFromNamedResult() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let res = pool.run(() => { other = "x"; 1 })
    let n = match res {
        Ok(f) -> await f,
        Err(e) -> 0
    }
    n + (other.len().toInt() || 0)
}

async fn errArmFirst() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let res = pool.run(() => { other = "x"; 1 })
    let n = match res {
        Err(e) -> 0,
        Ok(f) -> await f
    }
    n + (other.len().toInt() || 0)
}

async fn droppedFromNamedResult() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let res = pool.run(() => { other = "x"; 1 })
    let n = match res {
        Ok(f) -> 1,
        Err(e) -> 0
    }
    n + (other.len().toInt() || 0) //~ ERROR `other` is written by a closure that may still be running on another thread
}


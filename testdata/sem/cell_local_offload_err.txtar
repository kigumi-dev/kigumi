    let mut hd = SlotHolder { b: FnSlot { f: dropTask } }
    let g = pickSlot(&mut hd).f
    g(h)
}
fn runPickedSelf(h: Future[Int]) {
    let mut b = FnSlot { f: dropTask }
    let m = b.pickSpawn()
    (m.f)(h)
}
fn runPickedSlotTwice(h: Future[Int]) {
    let mut hd = SlotHolder { b: FnSlot { f: dropTask } }
    let m = pickSlotTwice(&mut hd)
    (m.f)(h)
}
fn runClosureStoredParam(h: Future[Int]) {
    let mut b = FnSlot { f: dropTask }
    let st = (x: &mut FnSlot) => { x.f = spawnTask }
    st(&mut b)
    (b.f)(h)
}
fn runPickedSlotDrop(h: Future[Int]) {
    let mut hd = SlotHolder { b: FnSlot { f: dropTask } }
    let m = pickSlotDrop(&mut hd)
    (m.f)(h)
}
fn runClosureStoredParamDrop(h: Future[Int]) {
    let mut b = FnSlot { f: dropTask }
    let st = (x: &mut FnSlot) => { x.f = dropTask }
    st(&mut b)
    (b.f)(h)
}


}

async fn freshCellPerIteration() -> Int {
    let pool = task.BlockingPool.new(4)
    let mut futs = Array.empty[Future[Int]]()
    for i in 0..3 {
        let mut acc = 0
        futs.push(pool.run(() => { acc = acc + i; acc }).unwrap())
    }
    let mut t = 0
    for f in futs {
        t = t + await f
    }
    t
}

async fn waitIn(h: Future[Int]) -> Int { await h }

async fn detachIn(h: Future[Int]) -> Int {
    let t = task.spawn(h)
    0
}


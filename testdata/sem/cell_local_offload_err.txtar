    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut held = Array.empty[Future[Int]]()
    let hd = Hd { f: move (h: Future[Int]) => { held.push(h) } }
    (hd.f)(pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    r.len().toInt() || 0
}

async fn storedThroughFieldWrapper() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut held = Array.empty[Future[Int]]()
    let hd = Hd { f: (h: Future[Int]) => { held.push(h) } }
    let ap = (h: Future[Int]) => { (hd.f)(h) }
    ap(pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    r.len().toInt() || 0
}

async fn storedThroughOuterThenAwaited() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let h = pool.run(() => { other = "x"; 1 }).unwrap()
    let n = {
        let mut held = Array.empty[Future[Int]]()
        let inner = (g: Future[Int]?) => {
            match g {
                Some(x) -> {
                    held.push(x)
                    None
                },
                None -> held.takeAt(0)
            }
        }
        let outer = (g: Future[Int]?) => inner(g)
        let _ = outer(Some(h))
        match outer(None) {
            Some(f) -> await f,
            None -> 0
        }
    }
    let r = &other
    n + (r.len().toInt() || 0)
}

async fn storedThroughFieldThenAwaited() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let h = pool.run(() => { other = "x"; 1 }).unwrap()
    let n = {
        let mut held = Array.empty[Future[Int]]()
        let hd = Hd { f: (g: Future[Int]?) => {
            match g {
                Some(x) -> {
                    held.push(x)
                    None
                },
                None -> held.takeAt(0)
            }
        } }
        let _ = (hd.f)(Some(h))
        match (hd.f)(None) {
            Some(f) -> await f,
            None -> 0
        }
    }
    let r = &other
    n + (r.len().toInt() || 0)
}

fn forwardTo[F: FnOnce[fn(Future[Int]) -> Void]](f: F, h: Future[Int]) { f(h) }
fn forwardTwice[F: FnOnce[fn(Future[Int]) -> Void]](f: F, h: Future[Int]) { forwardTo(f, h) }
async fn forwardAsync[F: FnOnce[fn(Future[Int]) -> Void]](f: F, h: Future[Int]) -> Int {
    f(h)
    0
}
fn spawnTask(h: Future[Int]) {
    let t = task.spawn(h)
}

async fn forwardedToStoringClosure() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut held = Array.empty[Future[Int]]()
    let add = (h: Future[Int]) => { held.push(h) }
    forwardTo(add, pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other
    r.len().toInt() || 0
}

async fn forwardedTwiceToMoveLiteral() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut held = Array.empty[Future[Int]]()
    forwardTwice(move (h: Future[Int]) => { held.push(h) }, pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other
    r.len().toInt() || 0
}

async fn forwardedAsyncAwaited() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut held = Array.empty[Future[Int]]()
    let add = (h: Future[Int]) => { held.push(h) }
    let fu = forwardAsync(add, pool.run(() => { other = "x"; 1 }).unwrap())
    let n = await fu
    let r = &other
    n + (r.len().toInt() || 0)
}

async fn forwardedToSpawningClosure() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    forwardTo((h: Future[Int]) => { let t = task.spawn(h) }, pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    r.len().toInt() || 0
}

async fn forwardedTwiceToSpawningFn() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    forwardTwice(spawnTask, pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    r.len().toInt() || 0
}

async fn forwardedAsyncToSpawningClosure() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let n = await forwardAsync((h: Future[Int]) => { let t = task.spawn(h) }, pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    n + (r.len().toInt() || 0)
}

async fn forwardedToUnknownFn(sp: fn(Future[Int]) -> Void) -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    forwardTo(sp, pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    r.len().toInt() || 0
}

fn forwardPlain(f: fn(Future[Int]) -> Void, h: Future[Int]) { f(h) }
fn dropTask(h: Future[Int]) { }
fn setToSpawn(f: &mut fn(Future[Int]) -> Void) { f = spawnTask }
fn helperSpawns(h: Future[Int]) { forwardPlain(spawnTask, h) }
fn helperDrops(h: Future[Int]) { forwardPlain(dropTask, h) }
async fn helperSpawnsAsync(h: Future[Int]) -> Int {
    forwardTwice(spawnTask, h)
    0
}
fn helperRunsAndSpawns[F: FnOnce[fn() -> Int]](pool: task.BlockingPool, w: escaping F) { forwardPlain(spawnTask, pool.run(w).unwrap()) }
fn helperRunsAndDrops[F: FnOnce[fn() -> Int]](pool: task.BlockingPool, w: escaping F) { forwardPlain(dropTask, pool.run(w).unwrap()) }

async fn helperForwardsToSpawn() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    helperSpawns(pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    r.len().toInt() || 0
}

async fn asyncHelperForwardsToSpawn() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"

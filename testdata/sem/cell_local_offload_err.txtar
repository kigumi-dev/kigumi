}

fn forwardPlain(f: fn(Future[Int]) -> Void, h: Future[Int]) { f(h) }
fn dropTask(h: Future[Int]) { }
fn setToSpawn(f: &mut fn(Future[Int]) -> Void) { f = spawnTask }
fn helperSpawns(h: Future[Int]) { forwardPlain(spawnTask, h) }
fn helperDrops(h: Future[Int]) { forwardPlain(dropTask, h) }
async fn helperSpawnsAsync(h: Future[Int]) -> Int {
    forwardTwice(spawnTask, h)
    0
}
fn helperRunsAndSpawns[F: FnOnce[fn() -> Int]](pool: task.BlockingPool, w: escaping F) { forwardPlain(spawnTask, pool.run(w).unwrap()) }
fn helperRunsAndDrops[F: FnOnce[fn() -> Int]](pool: task.BlockingPool, w: escaping F) { forwardPlain(dropTask, pool.run(w).unwrap()) }

async fn helperForwardsToSpawn() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    helperSpawns(pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    r.len().toInt() || 0
}

async fn asyncHelperForwardsToSpawn() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let n = await helperSpawnsAsync(pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    n + (r.len().toInt() || 0)
}

async fn helperOffloadsAndSpawns() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    helperRunsAndSpawns(pool, () => { other = "x"; 1 })
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    r.len().toInt() || 0
}


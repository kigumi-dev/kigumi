async fn storedThroughFieldWrapper() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut held = Array.empty[Future[Int]]()
    let hd = Hd { f: (h: Future[Int]) => { held.push(h) } }
    let ap = (h: Future[Int]) => { (hd.f)(h) }
    ap(pool.run(() => { other = "x"; 1 }).unwrap())
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread

-- app/t/t.kg --
import task from std/task

async fn work() -> Int {
    0
}

fn syncRoot() -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(work())
}

fn safeFn() -> Int {
    9
}

interface Calc {
    fn value(self) -> Int
}

type SafeCalc = {
    pub n Int
}

type RiskyCalc = {
    pub n Int
}

fn SafeCalc.value(self) -> Int {
    self.n
}

fn RiskyCalc.value(self) -> Int {
    syncRoot()
}

type Holder = {
    mut cb fn() -> Int
}

// Declared before the types and fns it uses: the verdict must not depend on order.
async fn riskyEarlyLiteralBorrow() -> Int {
    let mut o = O { c: SafeCalc { n: 1 } }
    lateMutate(&mut o)
    let w = W { inner: o }
    call2(w) //~ ERROR cannot run inside an `async fn`
}

async fn riskyEarlyAlias() -> Int {
    let mut h = Holder { cb: safeFn }
    let r = &mut h
    lateSetSync(r)
    callH(h) //~ ERROR cannot run inside an `async fn`
}

fn lateMutate(o: &mut O) {
    o.c = RiskyCalc { n: 3 }
}

fn lateSetSync(h: &mut Holder) {
    h.cb = syncRoot
}

type O = {
    mut c Calc
}

type W = {
    inner O
}

type HW = {
    mut inner Holder
}

type HR = {
    inner Holder
}

fn call2(w: W) -> Int {
    w.inner.c.value()
}

fn callO(o: O) -> Int {
    o.c.value()
}

fn callH(h: Holder) -> Int {
    h.cb()
}

fn O.arm(mut self) {
    self.c = RiskyCalc { n: 3 }
}

fn O.calm(mut self) {
    self.c = SafeCalc { n: 3 }
}

fn mutate(o: &mut O) {
    o.c = RiskyCalc { n: 3 }
}

fn soothe(o: &mut O) {
    o.c = SafeCalc { n: 3 }
}

fn setSync(h: &mut Holder) {
    h.cb = syncRoot
}

fn setSafe(h: &mut Holder) {
    h.cb = safeFn
}

async fn riskyLiteralMethodNested() -> Int {
    let mut o = O { c: SafeCalc { n: 1 } }
    o.arm()
    let w = W { inner: o }
    call2(w) //~ ERROR cannot run inside an `async fn`
}

async fn safeLiteralMethodNested() -> Int {
    let mut o = O { c: SafeCalc { n: 1 } }
    o.calm()
    let w = W { inner: o }
    call2(w)
}

fn unrelatedRiskyLiteralMethodNested() -> Int {
    let mut o = O { c: SafeCalc { n: 1 } }
    o.arm()
    let w = W { inner: o }
    call2(w)
}

async fn riskyLiteralMethodFlat() -> Int {
    let mut o = O { c: SafeCalc { n: 1 } }
    o.arm()
    callO(o) //~ ERROR cannot run inside an `async fn`
}

async fn riskyLiteralBorrowNested() -> Int {
    let mut o = O { c: SafeCalc { n: 1 } }
    mutate(&mut o)
    let w = W { inner: o }
    call2(w) //~ ERROR cannot run inside an `async fn`
}

async fn safeLiteralBorrowNested() -> Int {
    let mut o = O { c: SafeCalc { n: 1 } }
    soothe(&mut o)
    let w = W { inner: o }
    call2(w)
}

fn unrelatedRiskyLiteralBorrowNested() -> Int {
    let mut o = O { c: SafeCalc { n: 1 } }
    mutate(&mut o)
    let w = W { inner: o }
    call2(w)
}

async fn riskyLiteralBorrowDirect() -> Int {
    let mut o = O { c: SafeCalc { n: 1 } }
    mutate(&mut o)
    o.c.value() //~ ERROR cannot run inside an `async fn`
}

async fn safeLiteralBorrowDirect() -> Int {
    let mut o = O { c: SafeCalc { n: 1 } }
    soothe(&mut o)
    o.c.value()
}

fn unrelatedRiskyLiteralBorrowDirect() -> Int {
    let mut o = O { c: SafeCalc { n: 1 } }
    mutate(&mut o)
    o.c.value()
}

async fn riskyBorrowAlias() -> Int {
    let mut h = Holder { cb: safeFn }
    let r = &mut h
    setSync(r)
    callH(h) //~ ERROR cannot run inside an `async fn`
}

async fn safeBorrowAlias() -> Int {
    let mut h = Holder { cb: safeFn }
    let r = &mut h
    setSafe(r)
    callH(h)
}

fn unrelatedRiskyBorrowAlias() -> Int {
    let mut h = Holder { cb: safeFn }
    let r = &mut h
    setSync(r)
    callH(h)
}

async fn riskyBorrowAliasWrite() -> Int {
    let mut h = Holder { cb: safeFn }
    let r = &mut h
    r.cb = syncRoot
    callH(h) //~ ERROR cannot run inside an `async fn`
}

async fn safeBorrowAliasWrite() -> Int {
    let mut h = Holder { cb: safeFn }
    let r = &mut h
    r.cb = safeFn
    callH(h)
}

async fn riskyFnValueBorrow() -> Int {
    let mut h = Holder { cb: safeFn }
    let f = setSync
    f(&mut h)
    callH(h) //~ ERROR cannot run inside an `async fn`
}

async fn safeFnValueBorrow() -> Int {
    let mut h = Holder { cb: safeFn }
    let f = setSafe
    f(&mut h)
    callH(h)
}

fn unrelatedRiskyFnValueBorrow() -> Int {
    let mut h = Holder { cb: safeFn }
    let f = setSync
    f(&mut h)
    callH(h)
}

async fn riskyNestedPlaceBorrow() -> Int {
    let mut w = HW { inner: Holder { cb: safeFn } }
    setSync(&mut w.inner)
    callH(w.inner) //~ ERROR cannot run inside an `async fn`
}

async fn safeNestedPlaceBorrow() -> Int {
    let mut w = HW { inner: Holder { cb: safeFn } }
    setSafe(&mut w.inner)
    callH(w.inner)
}

fn unrelatedRiskyNestedPlaceBorrow() -> Int {
    let mut w = HW { inner: Holder { cb: safeFn } }
    setSync(&mut w.inner)
    callH(w.inner)
}

async fn riskyNestedDirectRead() -> Int {
    let h = Holder { cb: syncRoot }
    let w = HR { inner: h }
    w.inner.cb() //~ ERROR cannot run inside an `async fn`
}

async fn safeNestedDirectRead() -> Int {
    let h = Holder { cb: safeFn }
    let w = HR { inner: h }
    w.inner.cb()
}

fn unrelatedRiskyNestedDirectRead() -> Int {
    let h = Holder { cb: syncRoot }
    let w = HR { inner: h }
    w.inner.cb()
}

fn supply() -> Int {
    let ex = task.currentThreadExecutor()
    let a = ex.runToCompletion(riskyLiteralMethodNested())
    let b = ex.runToCompletion(safeLiteralMethodNested())
    let c = ex.runToCompletion(riskyLiteralMethodFlat())
    let d = ex.runToCompletion(riskyLiteralBorrowNested())
    let e = ex.runToCompletion(safeLiteralBorrowNested())
    let f = ex.runToCompletion(riskyLiteralBorrowDirect())
    let g = ex.runToCompletion(safeLiteralBorrowDirect())
    let h = ex.runToCompletion(riskyBorrowAlias())
    let i = ex.runToCompletion(safeBorrowAlias())
    let j = ex.runToCompletion(riskyBorrowAliasWrite())
    let k = ex.runToCompletion(safeBorrowAliasWrite())
    let l = ex.runToCompletion(riskyFnValueBorrow())
    let m = ex.runToCompletion(safeFnValueBorrow())
    let n = ex.runToCompletion(riskyNestedPlaceBorrow())
    let o = ex.runToCompletion(safeNestedPlaceBorrow())
    let p = ex.runToCompletion(riskyNestedDirectRead())
    let q = ex.runToCompletion(safeNestedDirectRead())
    let r = ex.runToCompletion(riskyEarlyLiteralBorrow())
    let s = ex.runToCompletion(riskyEarlyAlias())
    a + b + c + d + e + f + g + h + i + j + k + l + m + n + o + p + q + r + s +
        unrelatedRiskyLiteralMethodNested() + unrelatedRiskyLiteralBorrowNested() +
        unrelatedRiskyLiteralBorrowDirect() + unrelatedRiskyBorrowAlias() +
        unrelatedRiskyFnValueBorrow() + unrelatedRiskyNestedPlaceBorrow() +
        unrelatedRiskyNestedDirectRead()
}

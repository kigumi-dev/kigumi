-- module --
stage: driver
-- src --
import {Map} from std/map
import map from std/map

type View['a] = { pub data &'a Bytes, pub off usize }

fn View['a].byte(self) -> u8 { self.data[self.off] }

fn bytes() -> Bytes {
    Bytes.fromArray(&Array.of(1, 2, 3))
}

fn dies() -> usize {
    let mut m: Map[String, View['a]] = map.empty()
    {
        let buf = bytes()
        m.set("x", View { data: &buf, off: 0 })
    }
    m.len()
}

fn mutated() -> u8 {
    let mut buf = bytes()
    let mut m: Map[String, View['a]] = map.empty()
    m.set("x", View { data: &buf, off: 0 })
    let v = m.get(&"x")
    buf = bytes()
    if v is Some(w) { w.byte() } else { 0 }
}

fn returned['a](b: &'a Bytes) -> Map[String, View['a]] {
    let local = bytes()
    let mut m: Map[String, View['a]] = map.empty()
    m.set("b", View { data: b, off: 0 })
    m.set("local", View { data: &local, off: 0 })
    m
}

fn intoCaller['a](m: &mut Map[String, View['a]]) {
    let local = bytes()
    m.set("local", View { data: &local, off: 0 })
}

fn fine() -> usize {
    let buf = bytes()
    let mut m: Map[String, View['a]] = map.empty()
    m.set("x", View { data: &buf, off: 0 })
    m.len()
}

let n = dies() + fine()

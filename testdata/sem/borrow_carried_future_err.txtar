-- module --
stage: driver
-- src --
import task from std/task
import {Task} from std/task

type Res = resource {
    pub mut id Int
}

fn Res.drop(move self) {
    _ = self
}

type Pool = {
    pub mut fs Array[Future[Int]]
}

fn Pool.add(mut self, f: Future[Int]) {
    self.fs.push(f)
}

async fn bump(r: &mut Res) -> Int {
    r.id += 1
    r.id
}

async fn show(r: &Res) -> Int {
    r.id
}

fn twoInArray() -> Int {
    let ex = task.currentThreadExecutor()
    let mut x = Res { id: 100 }
    let mut fs = Array.empty[Future[Int]]()
    fs.push(bump(&mut x))
    fs.push(bump(&mut x))
    let mut s = 0
    for f in fs {
        s += ex.runToCompletion(f)
    }
    s
}

fn writeAfterPush() -> Int {
    let ex = task.currentThreadExecutor()
    let mut x = Res { id: 100 }
    let mut fs = Array.empty[Future[Int]]()
    fs.push(show(&x))
    x.id = 5
    let mut s = 0
    for f in fs {
        s += ex.runToCompletion(f)
    }
    s
}

fn outlivesBlock() -> Int {
    let ex = task.currentThreadExecutor()
    let mut fs = Array.empty[Future[Int]]()
    {
        let x = Res { id: 7 }
        fs.push(show(&x))
    }
    let mut s = 0
    for f in fs {
        s += ex.runToCompletion(f)
    }
    s
}

fn intoRecordMethod() -> usize {
    let ex = task.currentThreadExecutor()
    let mut x = Res { id: 1 }
    let mut p = Pool { fs: Array.empty[Future[Int]]() }
    p.add(bump(&mut x))
    x.id = 2
    p.fs.len()
}

fn intoCaller(fs: &mut Array[Future[Int]]) {
    let mut x = Res { id: 9 }
    fs.push(bump(&mut x))
}

fn Pool.addLocal(mut self) {
    let x = Res { id: 9 }
    self.fs.push(show(&x))
}

async fn spawnThenWrite() -> Int {
    let mut x = Res { id: 100 }
    let mut ts = Array.empty[Task[Int]]()
    ts.push(task.spawn(bump(&mut x)))
    x.id = 5
    0
}

async fn twoFutures() -> Int {
    let mut x = Res { id: 100 }
    let mut fs = Array.empty[Future[Int]]()
    fs.push(bump(&mut x))
    fs.push(bump(&mut x))
    let mut s = 0
    for f in fs {
        s += await f
    }
    s
}

async fn writeAfterSpawn() -> Int {
    let mut x = Res { id: 100 }
    let mut ts = Array.empty[Task[Int]]()
    ts.push(task.spawn(bump(&mut x)))
    x.id = 5
    let mut s = 0
    for t in ts {
        s += await t
    }
    s
}

async fn outlives() -> Int {
    let mut ts = Array.empty[Task[Int]]()
    {
        let x = Res { id: 7 }
        ts.push(task.spawn(show(&x)))
    }
    let mut s = 0
    for t in ts {
        s += await t
    }
    s
}

-- src --
interface Eater {
    fn eat(move self) -> String
}

interface Shower {
    fn show(self, k: Int) -> String
}

type R = resource {
    pub n Int
}

fn R.drop(move self) -> Unit {}

fn R.eat(move self) -> String { "ate" }

fn R.show(self, k: Int) -> String { "show" }

fn viaParam[T: Eater](t: T) -> String {
    let m = t.eat //~ ERROR consumes its receiver
    m()
}

// A Copy receiver hands every call a copy of its own, the way a concrete Copy type's method value does.
fn viaCopyParam[T: Eater + Copy](t: T) -> String {
    let m = t.eat
    m()
}

fn viaExistential(t: Eater) -> String {
    let m = t.eat //~ ERROR consumes its receiver
    m()
}

fn directCall[T: Eater](t: T) -> String {
    t.eat()
}

fn plainSelf[T: Shower](t: T) -> String {
    let m = t.show
    m(1)
}

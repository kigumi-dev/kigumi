-- app/t/t.kg --
import {atomicAdd, atomicExchange, atomicLoad, volatileRead, volatileReadAt, volatileWrite, volatileWriteAt, AtomicOrder, UnsafeCell} from std/mem

static mut wide: i128 = 0
static mut ratio: f64 = 1.0
static mut flag: Bool = false
static mut count: Int = 0

type Pair = {
    a Int
    b Int
}

fn run(p: *const Pair, q: *mut i128, u: *mut u32, s: UnsafeCell[String], f: UnsafeCell[f32], w: UnsafeCell[u128], b: UnsafeCell[Bool], r: UnsafeCell[*mut u8]) {
    unsafe {
        _ = atomicAdd(&mut wide, 1, AtomicOrder.SeqCst) //~ ERROR `i128` cannot be the type of `atomicAdd`
        _ = atomicLoad(&ratio, AtomicOrder.SeqCst) //~ ERROR `Float` cannot be the type of `atomicLoad`
        _ = atomicAdd(&mut flag, true, AtomicOrder.SeqCst) //~ ERROR `Bool` cannot be the type of `atomicAdd`
        _ = atomicExchange(&mut flag, true, AtomicOrder.SeqCst)
        _ = atomicAdd(&mut count, 1, AtomicOrder.SeqCst)
        _ = s.atomicLoad(AtomicOrder.SeqCst) //~ ERROR `String` cannot be the type of `atomicLoad`
        _ = f.atomicLoad(AtomicOrder.SeqCst) //~ ERROR `f32` cannot be the type of `atomicLoad`
        _ = w.atomicAdd(1, AtomicOrder.SeqCst) //~ ERROR `u128` cannot be the type of `atomicAdd`
        _ = b.atomicAdd(true, AtomicOrder.SeqCst) //~ ERROR `Bool` cannot be the type of `atomicAdd`
        _ = b.atomicExchange(true, AtomicOrder.SeqCst)
        _ = r.atomicAdd(r.atomicLoad(AtomicOrder.SeqCst), AtomicOrder.SeqCst) //~ ERROR `*mut u8` cannot be the type of `atomicAdd`
        _ = r.atomicLoad(AtomicOrder.SeqCst)
        _ = volatileRead(p) //~ ERROR `Pair` cannot be the type of `volatileRead`
        volatileWrite(q, 1) //~ ERROR `i128` cannot be the type of `volatileWrite`
        volatileWrite(u, 1)
        _ = volatileReadAt[f32](0x10) //~ ERROR `f32` cannot be the type of `volatileReadAt`
        volatileWriteAt(0x10, 'c') //~ ERROR `Char` cannot be the type of `volatileWriteAt`
        volatileWriteAt(0x10, 7)
        _ = volatileReadAt[u8](0x10)
    }
}


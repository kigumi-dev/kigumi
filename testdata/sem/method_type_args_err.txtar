-- src --
type Foo = {
    x Int
    pub items Array[fn(Int) -> Int]
}

fn Foo.conv[T](self, v: T) -> T {
    v
}

fn Foo.tag[T](self) -> Int {
    3
}

fn Foo.pair[A, B](self, a: A, b: B) -> A {
    a
}

fn ok(f: Foo) -> Int {
    let a = f.conv[Int](2)
    let b = f.tag[u8]()
    let c = f.pair[Int, String](4, "s")
    let d = f.items[0](5)
    a + b + c + d
}

fn too_many(f: Foo) -> Int {
    f.tag[u8, u16]() //~ ERROR takes 1 type argument
}

fn too_few(f: Foo) -> Int {
    f.pair[Int](1, 2) //~ ERROR takes 2 type arguments
}

fn value_as_type(f: Foo) -> Int {
    f.tag[3]() //~ ERROR is an expression, not a type
}

fn unknown_method(f: Foo) -> Int {
    f.nope[u8]() //~ ERROR no field or method
}

fn mismatched(f: Foo) -> Int {
    f.conv[String](2) //~ ERROR expected `Int`, found `String` //~ ERROR expected `String`, found `Int`
}

fn Foo.plain(self) -> Int {
    self.x
}

fn method_refs(f: Foo) -> Int {
    let g = f.conv[Int]
    let h = f.tag[u8]
    let p = f.pair[Int, String]
    g(1) + h() + p(2, "s")
}

fn method_ref_errors(f: Foo) {
    let _ = f.tag[u8, u16] //~ ERROR takes 1 type argument
    let _ = f.plain[Int] //~ ERROR takes 0 type arguments
    let _ = f.conv[&Int] //~ ERROR borrow types cannot appear
    let g = f.conv[String]
    let _ = g(1) //~ ERROR expected `String`, found `Int`
}

fn borrow_arg(f: Foo) -> Int {
    f.conv[&Int](1) //~ ERROR borrow types cannot appear
}

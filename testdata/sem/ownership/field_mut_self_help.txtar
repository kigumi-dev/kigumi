-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn mk(id: Int) -> Res {
    Res { id: id }
}

fn eat(r: Res) {}

type H = {
    pub mut r Res
    pub mut o Res?
}

fn H.swapImplicit(mut self) {
    eat(self.r) //~ ERROR reading `self.r` by value
    self.r = mk(2)
}

fn H.tailImplicit(mut self) -> Res {
    self.r //~ ERROR reading `self.r` by value
}

fn H.swapMove(mut self) {
    eat(move self.r)
    self.r = mk(4)
}

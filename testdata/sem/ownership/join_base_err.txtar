-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn mk(id: Int) -> Res {
    Res { id: id }
}

type PA = {
    pub xs Array[Res]
}

type W2 = resource {
    pub pa PA
}

fn W2.drop(move self) {}

fn mkw2(i: Int) -> W2 {
    W2 { pa: PA { xs: Array.of(mk(i)) } }
}

type HPA = {
    pub pa PA
}

type H['a] = {
    pub r &'a HPA
}

fn viaIf(c: Bool) -> Int {
    let mut s = 0
    for r in &(if c { PA { xs: Array.of(mk(0)) } } else { mkw2(5).pa }).xs { //~ ERROR cannot move `mkw2(5).pa` out of `W2`
        s = s + r.id
    }
    s
}

fn viaOr(o: PA?) -> Int {
    let mut s = 0
    for r in &(o || mkw2(6).pa).xs { //~ ERROR cannot move `mkw2(6).pa` out of `W2`
        s = s + r.id
    }
    s
}

fn viaLen(c: Bool) -> usize {
    (if c { PA { xs: Array.of(mk(0)) } } else { mkw2(7).pa }).xs.len() //~ ERROR cannot move `mkw2(7).pa` out of `W2`
}

fn viaMatchBorrow(c: Bool) -> usize {
    match &(if c { PA { xs: Array.of(mk(0)) } } else { mkw2(8).pa }).xs { //~ ERROR cannot move `mkw2(8).pa` out of `W2`
        xs -> xs.len()
    }
}

fn viaLink['a](h: H['a], c: Bool) -> usize {
    (if c { PA { xs: Array.of(mk(0)) } } else { h.r.pa }).xs.len() //~ ERROR reading `h.r.pa` by value
}

fn ownedPicksAreReads(c: Bool, a: PA, b: PA) -> usize {
    (if c { a } else { b }).xs.len()
}

-- module --
mir: planned
-- src --
type Handle = resource {
    pub id Int
}

fn Handle.drop(move self) {}

fn Handle.close(move self) {}

fn Handle.peek(self) -> Int {
    self.id
}

fn take(h: Handle) {}

fn step() -> Void! {}

fn movedBeforeTheEnd() -> Void! {
    let h = Handle { id: 1 }
    defer(fail) { print "peek ${h.peek()}" } //~ ERROR a cleanup reads `h`
    take(h)
    print "done"
}

fn movedOnOnePath(flag: Bool) -> Void! {
    let h = Handle { id: 1 }
    defer(fail) { print "peek ${h.peek()}" } //~ ERROR a cleanup reads `h`
    if flag {
        take(h)
    }
    print "done"
}

fn movedBeforeReturn(flag: Bool) -> Void! {
    let h = Handle { id: 1 }
    defer(fail) { print "peek ${h.peek()}" } //~ ERROR a cleanup reads `h`
    take(h)
    if flag {
        return Ok(())
    }
    print "done"
}

fn movedInInnerBlock() -> Void! {
    let h = Handle { id: 1 }
    if h.peek() > 0 {
        defer(fail) { print "peek ${h.peek()}" } //~ ERROR a cleanup reads `h`
        take(h)
        print "inner"
    }
}

fn movedAndTailIsPlain() -> Void! {
    let h = Handle { id: 1 }
    defer(fail) { print "peek ${h.peek()}" } //~ ERROR a cleanup reads `h`
    take(h)
    print "done"
    ()
}

fn movedByTail() -> Void! {
    let h = Handle { id: 1 }
    defer(fail) { print "peek ${h.peek()}" }
    take(h)
}

fn movedByReturnOperand() -> Void! {
    let h = Handle { id: 1 }
    defer(fail) { print "peek ${h.peek()}" }
    return Ok(take(h))
}

fn returnedAsValue() -> Handle! {
    let h = Handle { id: 1 }
    defer(fail) { print "peek ${h.peek()}" }
    print "ready"
    h
}

fn readsCopyOnly() -> Void! {
    let h = Handle { id: 1 }
    let n = h.peek()
    defer(fail) { print "n=${n}" }
    take(h)
    print "done"
}

fn failingExitStillChecked() -> Void! {
    let h = Handle { id: 1 }
    defer(fail) { print "peek ${h.peek()}" } //~ ERROR a cleanup reads `h`
    take(h)
    step()?
}

fn failingExitWithoutMove() -> Void! {
    let h = Handle { id: 1 }
    defer(fail) { print "peek ${h.peek()}" }
    step()?
    take(h)
}

print "ok"

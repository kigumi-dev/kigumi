-- lib/esc.kg --
pub type Handler[F] = { pub callback F }

fn keepP(cb: escaping fn() -> Int) -> Handler[fn() -> Int] {
    Handler { callback: cb }
}

type Reg = { pub on fn(fn() -> Int) -> Handler[fn() -> Int] }

fn takesEscaping(f: fn(escaping fn() -> Int) -> Handler[fn() -> Int]) -> Int { 0 }

fn launder(f: fn(fn() -> Int) -> Handler[fn() -> Int], cb: fn() -> Int) -> Int {
    f(cb).callback()
}

fn returned() -> fn(fn() -> Int) -> Handler[fn() -> Int] {
    let f = (c: escaping fn() -> Int) => keepP(c)
    f //~ ERROR may keep its callback at parameter 1
}

fn stored() -> Reg {
    let f = (c: escaping fn() -> Int) => keepP(c)
    Reg { on: f } //~ ERROR may keep its callback at parameter 1
}

fn passed(cb: fn() -> Int) -> Int {
    let f = (c: escaping fn() -> Int) => keepP(c)
    launder(f, cb) //~ ERROR may keep its callback at parameter 1
}

fn annotated(cb: fn() -> Int) -> Int {
    let f = (c: escaping fn() -> Int) => keepP(c)
    let g: fn(fn() -> Int) -> Handler[fn() -> Int] = f //~ ERROR may keep its callback at parameter 1
    launder(g, cb)
}

// Accepted: the target also allows keeping the callback, or the lambda is used as itself.
fn toEscaping() -> Int {
    let f = (c: escaping fn() -> Int) => keepP(c)
    takesEscaping(f)
}

fn plainLambda(cb: fn() -> Int) -> Int {
    launder((c) => Handler { callback: () => 1 }, cb)
}

fn direct(cb: escaping fn() -> Int) -> Int {
    let f = (c: escaping fn() -> Int) => keepP(c)
    f(cb).callback()
}

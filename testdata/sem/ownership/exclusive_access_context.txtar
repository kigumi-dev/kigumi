-- app/t/t.kg --
type Item = {
    pub mut count Int
    pub mut items Array[Int]
}

fn Item.update(mut self, d: Int) {
    self.count = self.count + d
}

fn Item.run[F: FnMut[fn() -> Void]](mut self, f: F) {
    f()
}

fn bump(x: &mut Item) {
    x.count = x.count + 1
}

fn nop() {}

context acc: Item
context other: Item

@provides(acc, other)
type Both = {
    pub mut acc Item
    pub mut other Item
}

fn fresh() -> Both {
    Both { acc: Item { count: 0, items: Array.of(1) }, other: Item { count: 0, items: Array.of(1) } }
}

fn pokeAcc() {
    acc.update(1)
}

fn peekAcc() -> Int {
    acc.count
}

fn pokeOther() {
    other.update(1)
}

fn implicitWrite() -> Int {
    context (fresh()) {
        acc.run(() => { pokeAcc() }) //~ ERROR a closure argument cannot capture
        acc.count
    }
}

fn implicitRead() -> Int {
    context (fresh()) {
        acc.run(() => { let seen = peekAcc() }) //~ ERROR a closure argument cannot capture
        acc.count
    }
}

fn implicitThroughNamedClosure() -> Int {
    context (fresh()) {
        let g = () => { pokeAcc() }
        acc.run(g) //~ ERROR a closure argument cannot capture
        acc.count
    }
}

fn implicitInsideNestedClosure() -> Int {
    context (fresh()) {
        acc.run(() => { let inner = () => { pokeAcc() } }) //~ ERROR a closure argument cannot capture
        acc.count
    }
}

fn explicitBareInClosure() -> Int {
    context (fresh()) {
        acc.run(() => { bump(&mut acc) }) //~ ERROR a closure argument cannot capture
        acc.count
    }
}

fn otherKeyImplicit() -> Int {
    context (fresh()) {
        acc.run(() => { pokeOther() })
        acc.count + other.count
    }
}

fn otherKeyExplicit() -> Int {
    context (fresh()) {
        acc.run(() => { other.update(1) })
        acc.count + other.count
    }
}

fn otherKeyBare() -> Int {
    context (fresh()) {
        acc.run(() => { bump(&mut other) })
        acc.count + other.count
    }
}

fn closureNotPassed() -> Int {
    context (fresh()) {
        let g = () => { pokeAcc() }
        acc.run(nop)
        g()
        acc.count
    }
}

fn createdAfter() -> Int {
    context (fresh()) {
        acc.run(nop)
        let g = () => { pokeAcc() }
        g()
        acc.count
    }
}

type Hub = {
    pub mut count Int
    pub mut log Array[Int]
    pub mut cb Option[fn() -> Void]
}

fn Hub.bump(mut self) {
    self.count = self.count + 1
}

fn Hub.fire(mut self) {
    match self.cb {
        Some(f) -> f()
        None -> {}
    }
}

type Wrap = {
    pub cb fn() -> Void
}

fn Hub.fireWrap(mut self, w: Wrap) {
    w.cb()
}

fn Hub.fireOpt(mut self, o: Option[fn() -> Void]) {
    match o {
        Some(f) -> f()
        None -> {}
    }
}

context hub: Hub

@provides(hub)
type HubProvider = {
    pub mut hub Hub
}

fn freshHub() -> HubProvider {
    HubProvider { hub: Hub { count: 0, log: Array.of(1), cb: None } }
}

fn pokeHub() {
    hub.bump()
}

fn idle() {}

fn implicitInWrappedRecord() -> Int {
    context (freshHub()) {
        hub.fireWrap(Wrap { cb: () => { pokeHub() } }) //~ ERROR an argument of this call holds a closure
        hub.count
    }
}

fn implicitInNamedThenWrapped() -> Int {
    context (freshHub()) {
        let g = () => { pokeHub() }
        hub.fireWrap(Wrap { cb: g }) //~ ERROR an argument of this call holds a closure //~ ERROR may hold a closure that captures it
        hub.count
    }
}

fn implicitInOption() -> Int {
    context (freshHub()) {
        hub.fireOpt(Some(() => { pokeHub() })) //~ ERROR an argument of this call holds a closure
        hub.count
    }
}

fn implicitStoredInProvider() -> Int {
    context (freshHub()) {
        hub.cb = Some(() => { pokeHub() })
        hub.fire() //~ ERROR may hold a closure that captures it
        hub.count
    }
}

fn wrappedPlainFnItem() -> Int {
    context (freshHub()) {
        hub.fireWrap(Wrap { cb: idle })
        let keep = () => { pokeHub() }
        hub.count
    }
}

fn wrappedCaptureFreeClosure() -> Int {
    context (freshHub()) {
        hub.fireWrap(Wrap { cb: () => {} })
        let keep = () => { pokeHub() }
        hub.count
    }
}

fn implicitStoredThenOtherMutCall() -> Int {
    context (freshHub()) {
        hub.cb = Some(() => { pokeHub() })
        hub.bump() //~ ERROR may hold a closure that captures it
        hub.count
    }
}

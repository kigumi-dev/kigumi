-- module --
mir: planned
-- src --
type P = { pub mut a String, pub mut b String }

fn setS(s: &mut String) { s = "q" }
fn two(a: &mut String, b: &mut String) { a = "1"; b = "2" }

fn sharedThenLent() -> usize {
    let mut other = "o"
    let r = &other
    setS(&mut other) //~ ERROR `other` is borrowed and cannot be mutated here
    r.len()
}

fn sharedFieldThenLent() -> usize {
    let mut p = P { a: "a", b: "b" }
    let r = &p.a
    setS(&mut p.a) //~ ERROR `p` is borrowed and cannot be mutated here
    r.len()
}

fn lentTwice() -> String {
    let mut s = "x"
    two(&mut s, &mut s) //~ ERROR `s` is passed twice as `&mut`
    s
}

fn disjointFields() -> String {
    let mut p = P { a: "a", b: "b" }
    two(&mut p.a, &mut p.b)
    "${p.a}${p.b}"
}

fn indexPlaces() -> usize {
    let mut xs = Array.of("a", "b")
    two(&mut xs[0], &mut xs[1])
    xs.len()
}

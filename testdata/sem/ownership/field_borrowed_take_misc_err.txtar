-- src --
type Inner = resource {
    pub id Int
}

fn Inner.drop(move self) {}

type Outer = {
    pub inner Inner
    pub n Int
}

type Wrap = {
    pub inner Inner
}

type Boxed = Wrapped(Inner)

type Maybe = {
    pub v Inner?
}

fn Maybe.branch(move self) -> Branch[Inner, Void] {
    match self.v {
        Some(r) -> Branch.Hit(r)
        None -> Branch.Miss(())
    }
}

type Holder = {
    pub m Maybe
}

fn apply(f: fn(Inner?) -> Inner) -> Inner {
    f(None)
}

fn record(o: &Outer) -> Wrap {
    Wrap { inner: o.inner } //~ ERROR reading `o.inner` by value
}

fn variant(o: &Outer) -> Boxed {
    Wrapped(o.inner) //~ ERROR reading `o.inner` by value
}

fn tuple(o: &Outer) -> (Inner, Int) {
    (o.inner, o.n) //~ ERROR reading `o.inner` by value
}

fn lambdaRef(o: &Outer) -> Inner {
    apply((x) => x || o.inner) //~ ERROR reading `o.inner` by value
}

fn Outer.lambdaSelf(self) -> Inner {
    apply((x) => x || self.inner) //~ ERROR reading `self.inner` by value
}

fn lambdaLent() -> Inner {
    let w = Outer { inner: Inner { id: 1 }, n: 0 }
    apply((x) => x || w.inner) //~ ERROR reading `w.inner` by value
}

fn Holder.witnessSelf(self, x: Inner) -> Inner {
    self.m || x //~ ERROR reading `self.m` by value
}

fn witnessRef(h: &Holder, x: Inner) -> Inner {
    h.m || x //~ ERROR reading `h.m` by value
}

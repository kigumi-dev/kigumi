-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn Res.close(move self) {}

fn Res.peek(self) -> Int {
    self.id
}

fn say(n: Int) {}

fn sayRef(n: &Int) {}

fn mkr(n: Int) -> Res {
    Res { id: n }
}
type SB = {
    pub mut o Res?
    pub n Int
}

fn peekRef(o: &Res?) {
    match o {
        Some(q) -> say(q.peek())
        None -> {}
    }
}

fn borrowThenMatch() {
    let o = Some(mkr(1))
    let r = &o
    match o {
        Some(q) -> q.close() //~ ERROR `o` is borrowed and cannot be moved or dropped here
        None -> {}
    }
    peekRef(r)
}

fn fieldBorrowThenMatch(s: SB) {
    let r = &s.o
    match s.o {
        Some(q) -> q.close() //~ ERROR `s` is borrowed and cannot be moved or dropped here
        None -> {}
    }
    peekRef(r)
}

fn wholeBorrowThenMatch(s: SB) {
    let r = &s
    match s.o {
        Some(q) -> q.close() //~ ERROR `s` is borrowed and cannot be moved or dropped here
        None -> {}
    }
    say(r.n)
}

fn borrowThenIfLet(o: Res?) {
    let r = &o
    if let Some(q) = o { //~ ERROR `o` is borrowed and cannot be moved or dropped here
        q.close()
    }
    peekRef(r)
}

fn borrowThenIs(o: Res?) {
    let r = &o
    if o is Some(q) { //~ ERROR `o` is borrowed and cannot be moved or dropped here
        q.close()
    }
    peekRef(r)
}

fn borrowThenOr(o: Res?) {
    let r = &o
    let a = o || mkr(0) //~ ERROR `o` is borrowed and cannot be moved or dropped here
    a.close()
    peekRef(r)
}

fn borrowThenTry(r: Result[Res, String]) -> Result[Int, String] {
    let b = &r
    let a = r? //~ ERROR `r` is borrowed and cannot be moved or dropped here
    a.close()
    match b {
        Ok(q) -> say(q.peek())
        Err(e) -> {}
    }
    Ok(1)
}

fn borrowEndsThenMatch(o: Res?) {
    let r = &o
    peekRef(r)
    match o {
        Some(q) -> q.close()
        None -> {}
    }
}

fn disjointFieldBorrow(s: SB) {
    let r = &s.n
    match s.o {
        Some(q) -> q.close()
        None -> {}
    }
    sayRef(r)
}

fn eatWhole(o: Res?) {
    match o {
        Some(r) -> r.close()
        None -> {}
    }
}

fn borrowThenCatchAll(o: Res?) {
    let r = &o
    match o {
        x -> eatWhole(x) //~ ERROR `o` is borrowed and cannot be moved or dropped here
    }
    peekRef(r)
}

fn borrowThenCatchAllAlias(o: Res?) {
    let r = &o
    match o {
        x -> match x { //~ ERROR `o` is borrowed and cannot be moved or dropped here
            Some(q) -> q.close()
            None -> {}
        }
    }
    peekRef(r)
}

fn borrowThenGuardedCatchAll(o: Res?, g: Bool) {
    let r = &o
    match o {
        x if g -> eatWhole(x) //~ ERROR `o` is borrowed and cannot be moved or dropped here
        _ -> {}
    }
    peekRef(r)
}

fn borrowEndsThenCatchAll(o: Res?) {
    let r = &o
    peekRef(r)
    match o {
        x -> eatWhole(x)
    }
}

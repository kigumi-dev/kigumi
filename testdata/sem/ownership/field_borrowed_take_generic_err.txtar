type Box[T] = {
    pub v T
    pub o T?
}

fn Box[T].fallbackSelf(self, c: Bool, o: T?, r: Result[T, Int], k: Int?, y: T) -> T {
    o || self.v //~ ERROR reading `self.v` by value
}

fn Box[T].handlerSelf(self, c: Bool, o: T?, r: Result[T, Int], k: Int?, y: T) -> T {
    r || (e) => self.v //~ ERROR reading `self.v` by value
}

fn Box[T].lhsSelf(self, c: Bool, o: T?, r: Result[T, Int], k: Int?, y: T) -> T {
    self.o || y //~ ERROR reading `self.o` by value
}

fn Box[T].ifArmSelf(self, c: Bool, o: T?, r: Result[T, Int], k: Int?, y: T) -> T {
    if c { self.v } else { y } //~ ERROR reading `self.v` by value
}

fn Box[T].matchArmSelf(self, c: Bool, o: T?, r: Result[T, Int], k: Int?, y: T) -> T {
    match k {
        Some(_) -> self.v //~ ERROR reading `self.v` by value
        None -> y
    }
}

fn Box[T].plainSelf(self, c: Bool, o: T?, r: Result[T, Int], k: Int?, y: T) -> T {
    self.v //~ ERROR reading `self.v` by value
}

fn Box[T].letSelf(self, c: Bool, o: T?, r: Result[T, Int], k: Int?, y: T) -> T {
    let z = o || self.v //~ ERROR reading `self.v` by value
    z
}

fn Box[T].retSelf(self, c: Bool, o: T?, r: Result[T, Int], k: Int?, y: T) -> T {
    if c {
        return o || self.v //~ ERROR reading `self.v` by value
    }
    y
}


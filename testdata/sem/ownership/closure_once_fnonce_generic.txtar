-- src --
type Handle = resource {
    pub mut id Int
}

fn Handle.drop(move self) {}

fn Handle.close(move self) {}

fn Handle.peek(self) -> Int {
    self.id
}

type Pack = {
    pub mut inner Handle
    pub mut other Handle
    pub mut n Int
}

fn mkh(n: Int) -> Handle {
    Handle { id: n }
}

fn mk(n: Int) -> Pack {
    Pack { inner: mkh(n), other: mkh(n + 1), n: 0 }
}

fn take(h: Handle) {}

fn sink(n: Int) {}

fn callOnceTwice[F: FnOnce[fn() -> Void]](f: F) {
    f()
    f() //~ ERROR cannot be called
}

fn callOnceInLoop[F: FnOnce[fn() -> Void]](f: F) {
    for i in 0..2 {
        f() //~ ERROR cannot be called
    }
}

fn callOnceMaybeTwice[F: FnOnce[fn() -> Void]](f: F, c: Bool) {
    if c {
        f()
    }
    f() //~ ERROR cannot be called
}

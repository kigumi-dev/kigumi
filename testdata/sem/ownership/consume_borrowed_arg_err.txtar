-- src --
import {Box} from std/alloc

type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

type Cell = {
    pub v Res
}

fn Cell.take(move self) -> Res {
    self.v
}

type H = {
    pub b Box[Cell]
    pub c Cell
    pub oc Cell?
}

fn eat(r: Res) {}

fn intoRef(h: &H) -> Cell {
    h.b.into() //~ ERROR reading `h.b` by value
}

fn intoFallback(h: &H, o: Res?) -> Res {
    o || h.b.into().v //~ ERROR reading `h.b` by value
}

fn intoLet(h: &H, o: Res?) -> Res {
    let c = h.b.into() //~ ERROR reading `h.b` by value
    o || move c.v
}

fn H.intoSelf(self) -> Cell {
    self.b.into() //~ ERROR reading `self.b` by value
}

fn userMoveSelf(h: &H) -> Res {
    h.c.take() //~ ERROR reading `h.c` by value
}

fn stdMoveSelf(h: &H) -> Cell {
    h.oc.unwrap() //~ ERROR reading `h.oc` by value
}

fn userArg(h: &H) {
    eat(h.c.v) //~ ERROR reading `h.c.v` by value
}

fn primitiveArg(h: &H, mut xs: Array[Res]) {
    xs.push(h.c.v) //~ ERROR reading `h.c.v` by value
}

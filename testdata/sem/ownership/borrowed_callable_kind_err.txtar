fn sharedMut[F: FnMut[fn(Int) -> Int]](f: &F, x: Int) -> Int {
    f(x) //~ ERROR `F` is only `FnMut`
}

fn mutOnce[F: FnOnce[fn(Int) -> Int]](f: &mut F, x: Int) -> Int {
    f(x) //~ ERROR `F` is only `FnOnce`
}

fn sharedAssigning() -> Int {
    let mut t = 0
    let mut h = (x: Int) => {
        t += x
        t
    }
    let r = &h
    r(1) //~ ERROR the closure assigns `t`
}

fn notCallable(n: &Int) -> Int {
    n(1) //~ ERROR is not callable
}

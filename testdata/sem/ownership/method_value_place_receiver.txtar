-- lib/mv.kg --
type Res = resource {
    pub n Int
}

fn Res.drop(move self) {}

fn Res.get(self, k: Int) -> Int { self.n + k }

fn Res.put(self, k: Int) -> Int { k }

fn Res.peek[U](self, f: fn(Int) -> U) -> U { f(self.n) }

fn Res.bumpWith[U: Show](mut self, u: U) -> Int { 0 }

async fn Res.laterShow[U: Show](self, u: U) -> Int { 0 }

fn Res.label[U: Show](self, u: U) -> String { u.show() }

interface Show {
    fn show(self) -> String
}

type Tag = {
    pub s String
}

pub fn Tag.show(self) -> String { self.s }

type Pair = {
    pub tag Int
    pub left Res
    pub right Res
}

type Outer = {
    pub inner Pair
}

type Guarded = resource {
    pub r Res
}

fn Guarded.drop(move self) {}

type Shown[T] = resource {
    pub v T
}

fn Shown[T: Show].say(self, pre: String) -> String { "${pre}${self.v.show()}" }

fn mk(n: Int) -> Res? { Res { n: n } }

fn both[F: Fn[fn(Int) -> Int]](f: F, g: F) -> Int { f(1) + g(2) }

fn useShow[F: Fn[fn(Tag) -> String]](f: F) -> String { f(Tag { s: "t" }) }

fn fieldOfParam(p: Pair) -> Int {
    let f = p.left.get //~ TYPE f : closure fn(Int) -> Int
    f(1) + p.tag
}

fn fieldOfLocal() -> Int {
    let p = Pair { tag: 1, left: Res { n: 1 }, right: Res { n: 2 } }
    let f = p.left.get
    let g = p.right.get
    f(1) + g(2) + p.tag
}

fn deepField(o: Outer) -> Int {
    both(o.inner.left.get, o.inner.right.get)
}

fn temporaries() -> Int {
    let f = mk(1)?.get //~ TYPE f : closure fn(Int) -> Int?
    let g = { Res { n: 2 } }.get //~ TYPE g : closure fn(Int) -> Int
    let h = (if true { Res { n: 3 } } else { Res { n: 4 } }).get
    g(1) + h(2)
}

fn reassigned(a: Res, b: Res) -> Int {
    let mut f = a.get
    f = b.get
    f(1)
}

fn branches(c: Bool, a: Res, b: Res) -> Int {
    let f = if c { a.get } else { b.get }
    f(1)
}

fn twoForOneF(a: Res, b: Res) -> Int {
    both(a.get, b.get)
}

fn witnessBound(r: Res) -> String {
    useShow(r.label)
}

fn ownerBound[T: Show](s: Shown[T]) -> String {
    let f = s.say //~ TYPE f : closure fn(String) -> String
    "${f("a")}${f("b")}"
}

fn inferredLater(r: Res) -> String {
    let p = r.peek
    let s = p((k: Int) => "${k}") //~ TYPE s : String
    s
}

fn inferredNested(xs: Array[Int]) -> usize {
    let m = xs.map
    if true {
        let ys = m((x: &Int) => true)
        return ys.len()
    }
    0
}

fn dropContainer(g: Guarded) -> Int {
    let f = g.r.get //~ ERROR would move `g.r` out of `Guarded`, which defines a custom `drop`
    f(1)
}

fn element(xs: Array[Res]) -> Int {
    let f = xs[0].get //~ ERROR cannot be moved out of an element, since indexing never moves a value out
    f(1)
}

fn elementField(xs: Array[Pair]) -> Int {
    let f = xs[0].left.get //~ ERROR cannot be moved out of a field of an element
    f(1)
}

fn borrowedField(p: &Pair) -> Int {
    let f = p.left.get //~ ERROR this receiver is borrowed here
    f(1)
}

fn neverFixed(r: Res) {
    let p = r.peek //~ ERROR cannot infer type parameter `U`
}

fn lambdaVsMethod(a: Res) -> Int {
    let mut f = a.get
    f = (k: Int) => k //~ ERROR expected `closure fn(Int) -> Int`, found `closure fn(Int) -> Int`
    f(1)
}

fn twoMethods(c: Bool, a: Res, b: Res) -> Int {
    let f = if c { a.get } else { b.put } //~ ERROR branches have different types
    f(1)
}

fn stillRejected(mut r: Res, s: Res) {
    let a = r.bumpWith //~ ERROR cannot form a method value on move-only `Res`
    let b = s.laterShow //~ ERROR cannot take its move-only `Res` receiver
}

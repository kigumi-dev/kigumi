type Counter = Off | N(n: Int)

fn Counter.reset(mut self) {
    self = N(7)
}

fn Counter.resetVia(mut self) {
    self.reset()
}

fn Counter.keep(mut self) {
    match self {
        Off -> {}
        N(n) -> {}
    }
}

fn local() {
    let mut d = Off
    let f = d.reset //~ ERROR `reset` takes `mut self`, but a method value runs it on its own copy of the receiver
    f()
}

fn forwarded() {
    let mut d = Off
    let f = d.resetVia //~ ERROR `resetVia` takes `mut self`, but a method value runs it on its own copy of the receiver
    f()
}

fn Counter.viaValue(mut self) {
    let f = self.reset //~ ERROR `reset` takes `mut self`, but a method value runs it on its own copy of the receiver
    f()
}

fn keeps() {
    let mut d = Off
    let f = d.keep //~ ERROR `keep` takes `mut self`, but a method value runs it on its own copy of the receiver
    f()
}

fn optionTake() -> Int? {
    let mut opt: Int? = Some(5)
    let take = opt.take //~ ERROR `take` takes `mut self`, but a method value runs it on its own copy of the receiver
    take()
}

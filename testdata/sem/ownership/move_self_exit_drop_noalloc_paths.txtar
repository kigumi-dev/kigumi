-- src --
type Buf = resource { pub n Int }

fn Buf.drop(move self) {
    let xs = Array.of(self.n)
    print "drop ${xs.len()}"
}

type W = resource { pub mut h Buf, pub k Int }

noalloc fn W.swap(move self, fresh: Buf) -> Buf { //~ ERROR dropping `W` may allocate or deallocate
    let b = move self.h
    self.h = fresh
    b
}

noalloc fn W.early(move self, flag: Bool, put: fn(Buf) -> Bool) -> Int { //~ ERROR dropping `W` may allocate or deallocate
    if flag {
        return 0
    }
    let ok = put(move self.h)
    1
}

noalloc fn W.late(move self, flag: Bool) -> Buf {
    let b = move self.h
    if flag {
        return b
    }
    b
}

noalloc fn W.failBefore(move self, flag: Bool, put: fn(Buf) -> Bool) -> Result[Bool, Int] { //~ ERROR dropping `W` may allocate or deallocate
    if flag {
        fail 1
    }
    Ok(put(move self.h))
}

noalloc fn W.failAfter(move self, flag: Bool, put: fn(Buf) -> Bool) -> Result[Bool, Int] {
    let ok = put(move self.h)
    if flag {
        fail 1
    }
    Ok(ok)
}

noalloc fn W.bareReturn(move self, flag: Bool, put: fn(Buf) -> Bool) { //~ ERROR dropping `W` may allocate or deallocate
    if flag {
        return
    }
    let ok = put(move self.h)
}

noalloc fn earlyWhole(b: Buf, flag: Bool, put: fn(Buf) -> Bool) -> Bool { //~ ERROR dropping `Buf` may allocate or deallocate
    if flag {
        return false
    }
    put(b)
}

noalloc fn earlyLocal(flag: Bool, mk: fn() -> Buf, put: fn(Buf) -> Bool) -> Bool {
    let b = mk() //~ ERROR dropping `Buf` may allocate or deallocate
    if flag {
        return false
    }
    put(b)
}

noalloc fn earlyTry(r: Result[Int, Int], b: Buf, put: fn(Buf) -> Bool) -> Result[Bool, Int] { //~ ERROR dropping `Buf` may allocate or deallocate
    let v = r?
    Ok(put(b))
}

noalloc fn afterExit(flag: Bool, mk: fn() -> Buf, put: fn(Buf) -> Bool) -> Bool {
    if flag {
        return false
    }
    let b = mk()
    put(b)
}

noalloc fn movedByExit(b: Buf, flag: Bool, put: fn(Buf) -> Bool) -> Bool {
    if flag {
        return put(b)
    }
    put(b)
}

type V = resource { pub h Buf, pub k Int }

fn V.drop(move self) {
    print "V drop ${self.k}"
}

type M = resource { pub v V, pub k Int }

noalloc fn M.inner(move self) -> Buf { //~ ERROR dropping `V` may allocate or deallocate
    self.v.h
}

let w = W { h: Buf { n: 1 }, k: 2 }
let b = w.late(true)
print "${b.n}"

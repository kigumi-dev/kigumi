-- module --
stage: driver
-- src --
type Box = resource { pub mut n Int, tag Int }

fn Box.drop(move self) -> Void {}

type Holder['a] = { pub mut r &'a mut Box }

type Owning['a] = { pub mut r &'a mut Box, pub other Box }

fn flag() -> Bool {
    true
}

fn storedBorrow() -> Int {
    let mut a = Box { n: 1, tag: 1 }
    let mut b = Box { n: 10, tag: 2 }
    let mut h = Holder { r: &mut a }
    h.r = &mut b
    b.n = 100
    h.r.n
}

fn storedOnOnePath() -> Int {
    let mut a = Box { n: 1, tag: 1 }
    let mut b = Box { n: 10, tag: 2 }
    let mut h = Holder { r: &mut a }
    if flag() {
        h.r = &mut b
    }
    a.n = 100
    h.r.n
}

fn storedBack() -> Int {
    let mut a = Box { n: 1, tag: 1 }
    let mut b = Box { n: 10, tag: 2 }
    let mut h = Holder { r: &mut a }
    h.r = &mut b
    h.r = &mut a
    a.n = 5
    h.r.n
}

fn storedThroughRef() -> Int {
    let mut a = Box { n: 1, tag: 1 }
    let mut b = Box { n: 10, tag: 2 }
    let mut h = Holder { r: &mut a }
    let hr = &mut h
    hr.r = &mut b
    a.n = 100
    h.r.n
}

fn ownsAnother() -> Int {
    let mut a = Box { n: 1, tag: 1 }
    let mut b = Box { n: 10, tag: 2 }
    let mut h = Owning { r: &mut a, other: Box { n: 0, tag: 9 } }
    h.r = &mut b
    a.n = 100
    h.r.n
}

type Two['a] = { pub mut r &'a Box, pub mut s &'a Box }

type Mixed['a] = { pub mut r &'a mut Box, pub mut s &'a Box }

fn eat(b: Box) -> Void {}

fn secondRefMoved() -> Int {
    let a = Box { n: 1, tag: 1 }
    let b = Box { n: 10, tag: 2 }
    let mut h = Two { r: &a, s: &a }
    h.r = &b
    eat(a)
    h.s.n
}

fn secondRefMutated() -> Int {
    let mut a = Box { n: 1, tag: 1 }
    let b = Box { n: 10, tag: 2 }
    let mut h = Two { r: &a, s: &a }
    h.r = &b
    a.n = 100
    h.s.n
}

fn mixedRefs() -> Int {
    let mut a = Box { n: 1, tag: 1 }
    let mut b = Box { n: 10, tag: 2 }
    let mut c = Box { n: 20, tag: 3 }
    let mut h = Mixed { r: &mut a, s: &c }
    h.r = &mut b
    c.n = 5
    h.s.n
}

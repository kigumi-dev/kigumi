-- module --
mir: planned
-- src --
pub type V['a] = { pub s &'a String }
fn apply['a](g: fn(V['a]) -> Void, x: V['a]) { g(x) }
fn applyIn['a](g: fn(V['a]) -> Void, x: V['a]) { g(x) }

fn direct['a](g: fn(V['a]) -> Void) {
    let loc = "frame-local"
    g(V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}

fn forwarded['a](g: fn(V['a]) -> Void) {
    let loc = "frame-local"
    apply(g, V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}

fn nested['a](g: fn(V['a]) -> Void) {
    let loc = "frame-local"
    apply((x: V['a]) => { applyIn((y: V['a]) => { g(y) }, x) }, V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}

fn aliased['a](g: fn(V['a]) -> Void) {
    let loc = "frame-local"
    let h = g
    h(V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}

fn read['a](x: V['a]) { _ = x.s }
fn replaced['a](mut g: fn(V['a]) -> Void, h: fn(V['a]) -> Void, b: Bool) {
    if b { g = h } else { g = h }
    let loc = "frame-local"
    g(V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}

fn wrapped['a](g: fn(V['a]) -> Void) {
    let loc = "frame-local"
    g(V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}
fn proxy['a](g: fn(V['a]) -> Void) {
    wrapped((x: V['a]) => { g(x) })
}

fn caller['a](u: &'a String) {
    let mut arr = Array.of(V { s: u })
    let r = &mut arr
    direct((y: V['a]) => { r.push(y) })
    forwarded((y: V['a]) => { r.push(y) })
    nested((y: V['a]) => { r.push(y) })
    aliased((y: V['a]) => { r.push(y) })
    replaced(read, (y: V['a]) => { r.push(y) }, true)
    proxy((y: V['a]) => { r.push(y) })
    _ = arr.len()
}

fn unbound['a](g: fn(V['a]) -> Void) {
    let loc = "frame-local"
    g(V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}

let u = "caller"
caller(&u)

fn twoWays['a](g: fn(V['a]) -> Void, h: fn(V['a]) -> Void, b: Bool) {
    let loc = "frame-local"
    apply((x: V['a]) => { applyIn((y: V['a]) => { if b { g(y) } else { h(y) } }, x) }, V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}
fn threeWays['a](g: fn(V['a]) -> Void, h: fn(V['a]) -> Void, j: fn(V['a]) -> Void, n: Int) {
    let loc = "frame-local"
    apply((x: V['a]) => { applyIn((y: V['a]) => { match n { 0 -> g(y), 1 -> h(y), _ -> j(y) } }, x) }, V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}
fn mixed['a](g: fn(V['a]) -> Void, b: Bool) {
    let loc = "frame-local"
    let h = (v: V['a]) => { _ = v.s }
    apply((x: V['a]) => { applyIn((y: V['a]) => { if b { g(y) } else { h(y) } }, x) }, V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}
fn storeRead['a](g: fn(V['a]) -> Void, h: fn(V['a]) -> Void, b: Bool) {
    let loc = "frame-local"
    apply((x: V['a]) => { applyIn((y: V['a]) => { if b { h(y) } else { g(y) } }, x) }, V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}
fn dispatchCaller['a](s: &'a String) {
    let mut arr1 = Array.of(V { s: s })
    let mut arr2 = Array.of(V { s: s })
    let mut arr3 = Array.of(V { s: s })
    let r1 = &mut arr1
    let r2 = &mut arr2
    let r3 = &mut arr3
    twoWays((v: V['a]) => { r1.push(v) }, (v: V['a]) => { r2.push(v) }, true)
    threeWays((v: V['a]) => { r1.push(v) }, (v: V['a]) => { r2.push(v) }, (v: V['a]) => { r3.push(v) }, 2)
    mixed((v: V['a]) => { r1.push(v) }, true)
    storeRead((v: V['a]) => { r1.push(v) }, read, false)
}

pub fn viaRef['a](g: fn(&V['a]) -> Void) {
    let loc = "frame-local"
    let v = V { s: &loc }
    g(&v) //~ ERROR a value borrowing `loc` cannot go into shared storage
}
pub fn viaRefArr['a](g: fn(&Array[V['a]]) -> Void) {
    let loc = "frame-local"
    let arr = Array.of(V { s: &loc })
    g(&arr) //~ ERROR a value borrowing `loc` cannot go into shared storage
}
dispatchCaller(&u)

fn unknownRelay['a](g: fn(V['a]) -> Void, h: fn(V['a]) -> Void, b: Bool) {
    let mut k = g
    if b { k = h }
    let loc = "frame-local"
    apply((x: V['a]) => { applyIn((y: V['a]) => { k(y) }, x) }, V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}

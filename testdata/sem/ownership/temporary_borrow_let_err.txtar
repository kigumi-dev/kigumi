-- src --
type R = resource { pub id Int }

fn R.drop(move self) {}

type H = { pub r R, pub s String }

fn mk(i: Int) -> R {
    R { id: i }
}

fn mkh(i: Int) -> H {
    H { r: R { id: i }, s: "s" }
}

fn mkn(i: Int) -> Int {
    i
}

type P = { pub x Int }

fn run() -> Int {
    let a = &mk(13) //~ ERROR borrow of the result of `mk(..)`
    let b = &mkh(1).r //~ ERROR borrow of the result of `mkh(..)`
    let c = &Array.of(mk(2))[0] //~ ERROR borrow of the result of `Array.of(..)`
    let d = &H { r: R { id: 3 }, s: "t" } //~ ERROR borrow of a temporary `H`
    let e = &mkn(4)
    let f = &(e + 1)
    let g = &"lit"
    let h = &"lit${e}" //~ ERROR borrow of a temporary `String`
    let p = &P { x: 5 } //~ ERROR borrow of a temporary `P`
    let q = { &mk(6) } //~ ERROR borrow of the result of `mk(..)`
    let s = { let j = 7; &mk(j) } //~ ERROR borrow of the result of `mk(..)`
    a.id + b.id + c.id + d.r.id + e + f + p.x + q.id + s.id + (g.len().toInt() || 0) + (h.len().toInt() || 0)
}

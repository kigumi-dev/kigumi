-- src --
type Shape = Circle(r: Int) | Dot

fn Shape.flatten(mut self) {
    self = Dot
}

fn Shape.widen(mut self, k: Int) {
    self = Circle(k)
}

type Counter = {
    pub mut n Int
}

fn Counter.inc(mut self) {
    self.n = self.n + 1
}

async fn Counter.incLater(mut self) {
    self = Counter { n: self.n + 1 } //~ ERROR assigns `self` as a whole in an `async` body
}

async fn Counter.bumpLater(mut self) {
    self.n = self.n + 1
}

fn viaBorrowIsFine(s: &mut Shape) {
    s.flatten()
}

fn viaBorrowNestedIsFine(s: &mut Shape, k: Int) {
    s.widen(k)
}

fn takeViaBorrowIsFine(o: &mut Int?) -> Int {
    o.take() || 0
}

fn fieldWriteIsFine(c: &mut Counter) {
    c.inc()
}

type Holder = {
    mut shape Shape
}

fn placeIsFine(h: &mut Holder) {
    h.shape.flatten()
}

fn ownedIsFine() {
    let mut s: Shape = Circle(1)
    s.flatten()
}

fn Counter.escapingRead(mut self) -> fn() -> Int {
    () => self.n //~ ERROR cannot be a plain `fn`
}

fn Counter.closureIsFine(mut self) -> Int {
    let add = (k: Int) => { self.n = self.n + k }
    add(3)
    self.n
}

interface Widener {
    fn widen(mut self, k: Int)
}

fn widenViaBorrowedParamIsFine[W: Widener](w: &mut W, k: Int) {
    w.widen(k)
}

fn widenOwnedParamIsFine[W: Widener](mut w: W, k: Int) {
    w.widen(k)
}

interface Bumper {
    fn inc(mut self)
}

fn incViaBorrowedParamIsFine[B: Bumper](b: &mut B) {
    b.inc()
}

type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn Res.escapingRead(self) -> fn() -> Int {
    () => self.id //~ ERROR move-only //~ ERROR cannot capture the borrow `self`
}

fn Res.readVia(self, f: fn(Int) -> Int) -> Int {
    f(self.id)
}

fn Res.localReadIsFine(self) -> Int {
    self.readVia((x: Int) => x + self.id)
}

interface Replacer {
    fn grow(mut self, k: Int)
    fn size(self) -> Int
}

type Tank = {
    pub mut amount Int
}

fn Tank.grow(mut self, k: Int) {
    self.amount = self.amount + k
}

fn Tank.size(self) -> Int { self.amount }

type Fuse = {
    pub mut armed Bool
}

// Same name/arity/recv as Replacer.grow, but Fuse has no `size`, so it can
// never instantiate G: Replacer; the precise conformance check excludes it.
fn Fuse.grow(mut self, k: Int) {
    self = Fuse { armed: k > 0 }
}

fn growViaBorrowedParamIsFine[G: Replacer](g: &mut G, k: Int) -> Int {
    g.grow(k)
    g.size()
}

fn growViaWitnessValue[G: Replacer](mut g: G) {
    let h = g.grow //~ ERROR is an interface requirement with no single implementation
    h(1)
}

-- src --
type Shape = Circle(r: Int) | Dot

context seat: Shape

@provides(seat)
type Env = {
    pub seat Shape
}

fn Shape.flatten(mut self) {
    self = Dot
}

fn Shape.area(self) -> Int {
    match self {
        Circle(r) -> r
        Dot -> 0
    }
}

fn reset(s: &mut Shape, k: Int) {
    s = Circle(k)
}

fn forwardIsFine(s: &mut Shape, k: Int) {
    reset(s, k)
}

fn recvIsFine(s: &mut Shape) {
    s.flatten()
}

fn readIsFine(s: &mut Shape) -> Int {
    s.area()
}

type Holder = {
    pub mut shape Shape
}

fn fieldIsFine(h: &mut Holder) {
    reset(&mut h.shape, 1)
    h.shape.flatten()
}

fn ownedIsFine() {
    let mut s: Shape = Circle(1)
    reset(&mut s, 2)
    s.flatten()
}

fn letBoundAssign() {
    let mut s: Shape = Circle(1)
    let r = &mut s
    r = Dot //~ ERROR with no owner a whole new value could go back to
}

fn letBoundForward() {
    let mut s: Shape = Circle(1)
    let r = &mut s
    reset(r, 2) //~ ERROR with no owner a whole new value could go back to
}

fn letBoundRecv() {
    let mut s: Shape = Circle(1)
    let r = &mut s
    r.flatten() //~ ERROR with no owner a whole new value could go back to
}

fn forLoopBinding() {
    let mut xs = Array.of[Shape](Circle(1), Dot)
    for s in &mut xs {
        s = Dot //~ ERROR with no owner a whole new value could go back to
    }
}

fn letBoundReadIsFine() -> Int {
    let mut s: Shape = Circle(1)
    let r = &mut s
    r.area()
}

async fn resetLater(s: &mut Shape, k: Int) {
    s = Circle(k)
}

async fn awaitsReset() {
    let mut s: Shape = Circle(1)
    await resetLater(&mut s, 3) //~ ERROR cannot be lent to an `async` call
}

fn viaLease() -> Int {
    seat.flatten() //~ ERROR context key `seat` cannot be the receiver of `mut self` method `flatten`
    seat.area()
}

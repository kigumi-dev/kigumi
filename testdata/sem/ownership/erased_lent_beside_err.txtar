-- module --
mir: planned
-- src --
type H[F] = { pub mut f F }
type P = { pub mut a Int, pub mut b Int }
type Q = { pub mut xs Array[Int] }

fn H[F: FnMut[fn() -> Void]].run(mut self, r: fn() -> Int) -> Int { self.f(); r() }
fn both2[F: FnMut[fn() -> Void]](f: fn() -> Int, mut g: F) -> Int { g(); f() }
fn both2r[F: FnMut[fn() -> Void]](mut g: F, f: fn() -> Int) -> Int { g(); f() }
fn bothFn(f: fn() -> Int, g: fn() -> Void) -> Int { g(); f() }
fn bothRef[F: FnMut[fn() -> Void]](f: fn() -> Int, g: &mut F) -> Int { g(); f() }
fn bothOpt[F: FnMut[fn() -> Void]](f: fn() -> Int, g: Option[F]) -> Int {
    if let Some(h) = g {
        let mut hh = h
        hh()
    }
    f()
}
fn packed[F: FnMut[fn() -> Void]](mut g: F, fs: ...fn() -> Int) -> Int { g(); fs[0]() }
fn keepOnly[T](f: fn() -> Int, x: T) -> Int { f() }
fn bump(k: &mut Int) { k = k + 1 }

fn besideWriter() -> Int {
    let mut k = 1
    both2(() => k, () => { k = k + 1 }) //~ ERROR closure captures `k` (written outside this closure
}

fn besideReader() -> Int {
    let mut k = 1
    let a = both2(() => k, () => { _ = k + 1 })
    a + both2(() => 0, () => { k = k + 1 })
}

fn besideNamedReader() -> Int {
    let mut k = 1
    let r = () => k
    both2(r, () => { k = k + 1 }) //~ ERROR closure captures `k` (written outside this closure
}

fn besideNamedReaderReads() -> Int {
    let mut k = 1
    let r = () => k
    let a = both2(r, () => { _ = k + 1 })
    a + both2(() => 0, () => { k = k + 1 })
}

fn writerFirst() -> Int {
    let mut k = 1
    both2r(() => { k = k + 1 }, () => k) //~ ERROR closure captures `k` (written outside this closure
}

fn readerFirstReads() -> Int {
    let mut k = 1
    let a = both2r(() => { _ = k + 1 }, () => k)
    a + both2(() => 0, () => { k = k + 1 })
}

fn namedWriter() -> Int {
    let mut k = 1
    let w = () => { k = k + 1 }
    both2(() => k, w) //~ ERROR closure captures `k` (written outside this closure
}

fn namedSiblingReads() -> Int {
    let mut k = 1
    let w = () => { _ = k + 1 }
    let a = both2(() => k, w)
    a + both2(() => 0, () => { k = k + 1 })
}

fn writerCapturedBeside() -> Int {
    let mut k = 1
    let w = () => { k = k + 1 }
    both2(() => k, () => w()) //~ ERROR closure captures `k` (written outside this closure
}

fn readerCapturedBeside() -> Int {
    let mut k = 1
    let w = () => { _ = k + 1 }
    let a = both2(() => k, () => w())
    a + both2(() => 0, () => { k = k + 1 })
}

fn writerInLentFn() -> Int {
    let mut k = 1
    let mut w = () => { k = k + 1 }
    bothFn(() => k, () => w()) //~ ERROR closure captures `k` (written outside this closure
}

fn readerInLentFn() -> Int {
    let mut k = 1
    let w = () => { _ = k + 1 }
    let a = bothFn(() => k, () => w())
    a + both2(() => 0, () => { k = k + 1 })
}

fn receiverWrites() -> Int {
    let mut k = 1
    let mut h = H { f: () => { k = k + 1 } }
    h.run(() => k) //~ ERROR closure captures `k` (written outside this closure
}

fn receiverReads() -> Int {
    let mut k = 1
    let mut h = H { f: () => { _ = k + 1 } }
    let a = h.run(() => k)
    a + both2(() => 0, () => { k = k + 1 })
}

fn readerRunsReader() -> Int {
    let mut k = 1
    let g = () => k
    both2(() => g(), () => { k = k + 1 }) //~ ERROR closure captures `k` (written outside this closure
}

fn readerRunsReaderReads() -> Int {
    let mut k = 1
    let g = () => k
    let a = both2(() => g(), () => { _ = k + 1 })
    a + both2(() => 0, () => { k = k + 1 })
}

fn mergedReader(c: Bool) -> Int {
    let mut k = 1
    both2(if c { () => k } else { () => 0 }, () => { k = k + 1 }) //~ ERROR closure captures `k` (written outside this closure
}

fn mergedReaderReads(c: Bool) -> Int {
    let mut k = 1
    let a = both2(if c { () => k } else { () => 0 }, () => { _ = k + 1 })
    a + both2(() => 0, () => { k = k + 1 })
}

fn writerInOption() -> Int {
    let mut k = 1
    bothOpt(() => k, Some(() => { k = k + 1 })) //~ ERROR closure captures `k` (written outside this closure
}

fn readerInOption() -> Int {
    let mut k = 1
    let a = bothOpt(() => k, Some(() => { _ = k + 1 }))
    a + both2(() => 0, () => { k = k + 1 })
}

fn writerByRef() -> Int {
    let mut k = 1
    let mut w = () => { k = k + 1 }
    bothRef(() => k, &mut w) //~ ERROR closure captures `k` (written outside this closure
}

fn readerByRef() -> Int {
    let mut k = 1
    let mut w = () => { _ = k + 1 }
    let a = bothRef(() => k, &mut w)
    a + both2(() => 0, () => { k = k + 1 })
}

fn readerInPack() -> Int {
    let mut k = 1
    packed(() => { k = k + 1 }, () => k) //~ ERROR closure captures `k` (written outside this closure
}

fn readerInPackReads() -> Int {
    let mut k = 1
    let a = packed(() => { _ = k + 1 }, () => k)
    a + both2(() => 0, () => { k = k + 1 })
}

fn writerBorrows() -> Int {
    let mut k = 1
    both2(() => k, () => bump(&mut k)) //~ ERROR closure captures `k` (written outside this closure
}

fn writerBorrowsReadField() -> Int {
    let mut p = P { a: 1, b: 2 }
    both2(() => p.a, () => bump(&mut p.a)) //~ ERROR closure captures `p` (written outside this closure
}

fn writerBorrowsOtherField() -> Int {
    let mut p = P { a: 1, b: 2 }
    both2(() => p.a, () => bump(&mut p.b))
}

fn writerReplacesWhole() -> Int {
    let mut p = P { a: 1, b: 2 }
    both2(() => p.a, () => { p = P { a: 9, b: 9 } }) //~ ERROR closure captures `p` (written outside this closure
}

fn borrowedBesideWriter() -> Int {
    let mut ks: Array[Int] = Array.empty()
    both2(() => ks.len().toInt() || 0, () => { ks.push(1) }) //~ ERROR closure captures `ks` (written outside this closure
}

fn borrowedBesideReader() -> Int {
    let mut ks: Array[Int] = Array.empty()
    let a = both2(() => ks.len().toInt() || 0, () => { _ = ks.len() })
    a + both2(() => 0, () => { ks.push(1) })
}

fn borrowedFieldBesideWriter() -> Int {
    let mut q = Q { xs: Array.empty() }
    both2(() => q.xs.len().toInt() || 0, () => { q.xs.push(1) }) //~ ERROR closure captures `q` (written outside this closure
}

fn borrowedFieldBesideReader() -> Int {
    let mut q = Q { xs: Array.empty() }
    let a = both2(() => q.xs.len().toInt() || 0, () => { _ = q.xs.len() })
    a + both2(() => 0, () => { q.xs.push(1) })
}

fn besideCannotRun() -> Int {
    let mut k = 1
    let w = () => { k = k + 1 }
    keepOnly(() => k, w)
}

type R[F] = { pub mut f F }

fn both4[F: FnMut[fn() -> Void]](f: fn() -> Int, mut r: R[F]) -> Int { r.f(); f() }
fn bothRefH[F: FnMut[fn() -> Void]](f: fn() -> Int, h: &mut H[F]) -> Int { h.f(); f() }

fn recordArgWrites() -> Int {
    let mut k = 1
    both4(() => k, R { f: () => { k = k + 1 } }) //~ ERROR closure captures `k` (written outside this closure
}

fn recordArgReads() -> Int {
    let mut k = 1
    let a = both4(() => k, R { f: () => { _ = k + 1 } })
    a + both2(() => 0, () => { k = k + 1 })
}

fn recordRefWrites() -> Int {
    let mut k = 1
    let mut h = H { f: () => { k = k + 1 } }
    bothRefH(() => k, &mut h) //~ ERROR closure captures `k` (written outside this closure
}

fn recordRefReads() -> Int {
    let mut k = 1
    let mut h = H { f: () => { _ = k + 1 } }
    let a = bothRefH(() => k, &mut h)
    a + both2(() => 0, () => { k = k + 1 })
}

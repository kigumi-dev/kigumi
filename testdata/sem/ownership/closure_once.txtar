-- module --
mir: planned
-- src --
type Handle = resource {
    pub mut id Int
}

fn Handle.drop(move self) {}

fn Handle.close(move self) {}

fn Handle.peek(self) -> Int {
    self.id
}

type Pack = {
    pub mut inner Handle
    pub mut other Handle
    pub mut n Int
}

fn mkh(n: Int) -> Handle {
    Handle { id: n }
}

fn mk(n: Int) -> Pack {
    Pack { inner: mkh(n), other: mkh(n + 1), n: 0 }
}

fn take(h: Handle) {}

fn sink(n: Int) {}

fn callTwiceFn[F: Fn[fn() -> Void]](f: F) {
    f()
    f()
}

fn callTwiceMut[F: FnMut[fn() -> Void]](f: F) {
    f()
    f()
}

fn callOnce[F: FnOnce[fn() -> Void]](f: F) {
    f()
}

fn satisfiesFn() {
    let h = mkh(1)
    let f = () => { h.close() }
    callTwiceFn(f) //~ ERROR consumes `h`
}

fn satisfiesFnMut() {
    let h = mkh(1)
    let f = () => { h.close() }
    callTwiceMut(f) //~ ERROR consumes `h`
}

fn satisfiesOnce() {
    let h = mkh(1)
    let f = () => { h.close() }
    callOnce(f)
}

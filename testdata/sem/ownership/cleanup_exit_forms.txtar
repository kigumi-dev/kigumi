-- src --
type Handle = resource {
    pub id Int
}

fn Handle.drop(move self) {}

fn Handle.close(move self) {}

fn step() -> Void! {}

fn tailLoopBreak() -> Handle! {
    let h = Handle { id: 1 }
    defer(fail) { h.close() }
    for {
        break h
    }
}

fn tailBlock() -> Handle! {
    let h = Handle { id: 1 }
    defer(fail) { h.close() }
    {
        h
    }
}

fn letLoopBreak() -> Handle! {
    let h = Handle { id: 1 }
    defer(fail) { h.close() }
    let v = for {
        break h //~ ERROR `h` is reserved by a cleanup that consumes it
    }
    step()?
    v
}

fn letBlock() -> Handle! {
    let h = Handle { id: 1 }
    defer(fail) { h.close() }
    let v = {
        h //~ ERROR `h` is reserved by a cleanup that consumes it
    }
    step()?
    v
}

fn outerLoopFromCleanup() {
    for i in 0..3 {
        defer {
            break //~ ERROR `break` is not allowed in a cleanup body
        }
    }
}

fn innerLoopInCleanup() {
    defer {
        for i in 0..3 {
            if i == 1 {
                continue
            }
            break
        }
    }
}

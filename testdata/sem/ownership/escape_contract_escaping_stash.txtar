-- lib/esc.kg --
fn stash(cb: escaping fn() -> Void) -> fn() -> Void {
    cb
}

fn stashViaLet(cb: escaping fn() -> Void) -> fn() -> Void {
    let kept = cb
    kept
}

fn stashEach(cb: escaping fn() -> Void, other: escaping fn() -> Void) -> Array[fn() -> Void] {
    Array.of(cb, other)
}

type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

type Box = {
    pub v Res
    pub o Res?
}

fn Box.fallbackSelf(self, c: Bool, o: Res?, r: Result[Res, Int], k: Int?, y: Res) -> Res {
    o || self.v //~ ERROR reading `self.v` by value
}

fn Box.handlerSelf(self, c: Bool, o: Res?, r: Result[Res, Int], k: Int?, y: Res) -> Res {
    r || (e) => self.v //~ ERROR reading `self.v` by value
}

fn Box.lhsSelf(self, c: Bool, o: Res?, r: Result[Res, Int], k: Int?, y: Res) -> Res {
    self.o || y //~ ERROR reading `self.o` by value
}

fn Box.ifArmSelf(self, c: Bool, o: Res?, r: Result[Res, Int], k: Int?, y: Res) -> Res {
    if c { self.v } else { y } //~ ERROR reading `self.v` by value
}

fn Box.matchArmSelf(self, c: Bool, o: Res?, r: Result[Res, Int], k: Int?, y: Res) -> Res {
    match k {
        Some(_) -> self.v //~ ERROR reading `self.v` by value
        None -> y
    }
}

fn Box.plainSelf(self, c: Bool, o: Res?, r: Result[Res, Int], k: Int?, y: Res) -> Res {
    self.v //~ ERROR reading `self.v` by value
}

fn Box.letSelf(self, c: Bool, o: Res?, r: Result[Res, Int], k: Int?, y: Res) -> Res {
    let z = o || self.v //~ ERROR reading `self.v` by value
    z
}

fn Box.retSelf(self, c: Bool, o: Res?, r: Result[Res, Int], k: Int?, y: Res) -> Res {
    if c {
        return o || self.v //~ ERROR reading `self.v` by value
    }
    y
}


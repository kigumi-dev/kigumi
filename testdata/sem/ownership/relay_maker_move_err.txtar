-- module --
mir: planned
-- src --
import task from std/task

async fn pushB(v: &mut Array[String]) {
    await task.yieldNow()
    v.push("B-written-${40 + 2}")
}
fn syncReady(v: &mut Array[String]) -> Future[Void] { task.yieldNow() }
interface Maker[T] { fn create() -> T }
@impl(Maker[fn(&mut Array[String]) -> Future[Void]])
type MakeB = { pub n Int }
fn MakeB.create() -> fn(&mut Array[String]) -> Future[Void] { pushB }
fn mk[T, M: Maker[T]](x: T, flag: Bool) -> T { if flag { x } else { M.create() } }
fn consume(a: Array[String]) -> usize { a.len() }

fn main() {
    let ex = task.currentThreadExecutor()
    let h = mk[fn(&mut Array[String]) -> Future[Void], MakeB](syncReady, false)
    let mut v = Array.of("init-${1}")
    let fut = h(&mut v)
    let n = consume(v) //~ ERROR `v` is borrowed and cannot be moved
    ex.runToCompletion(fut)
    print "after: ${n}"
}

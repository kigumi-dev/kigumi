-- module --
mir: planned
allocator: none
-- src --
import {AllocatorHandle} from std/alloc
import {Box} from std/alloc

fn scoped(h: AllocatorHandle, n: Int) -> Int {
    allocator h.scope() {
        let b = Box.new(n)
        b.into()
    }
}

fn scopedTry(h: AllocatorHandle, n: Int) -> Int {
    allocator h.scope() {
        match Box.tryNew(n) {
            Ok(b) -> b.into()
            Err(_) -> 0
        }
    }
}

export(C) {
    pub fn lib_try(n: i64) -> i64 {
        match Box.tryNew(n) { //~ ERROR needs the default allocator
            Ok(b) -> b.into()
            Err(_) -> 0
        }
    }

    pub fn lib_direct(n: i64) -> i64 {
        let b = Box.new(n) //~ ERROR needs the default allocator
        b.into()
    }
}

fn main() -> Void! {}

type Res = resource {
    pub id Int
}

type Holder = {
    pub r Res
}

fn Res.drop(move self) {}
fn Res.touch(self) {}
fn Res.touchMut(mut self) {}
fn Res.consume(move self) {}

type Keyed = {
    mut slots Array[Res]
}

fn Keyed.index(mut self, k: usize) -> Res {
    self.slots.takeAt(0).unwrap()
}

fn byValue(xs: Array[Res]) {
    let y = xs[0] //~ ERROR reading `Res` out of an index by value needs `Copy`
}

fn byValueField(ys: Array[Holder]) {
    let z = ys[0].r //~ ERROR reading `Res` out of an index by value needs `Copy`
}

fn byValueChained(xs: Array[Array[Res]]) {
    let z = xs[0][0] //~ ERROR reading `Res` out of an index by value needs `Copy`
}

fn viaWitness(k: Keyed) {
    let z = k[0] //~ ERROR reading `Res` out of an index by value needs `Copy`
}

fn borrowed(xs: &Array[Res]) {
    let r = &xs[0]
    r.touch()
}

fn borrowedMut(mut xs: Array[Res]) {
    let r = &mut xs[0]
    r.touch()
}

fn methodCall(xs: Array[Res]) {
    xs[0].touch()
}

fn methodCallMut(mut xs: Array[Res]) {
    xs[0].touchMut()
}

fn takenOwned(mut xs: Array[Res]) {
    let y = xs.takeAt(0).unwrap()
}

fn chainedNavigate(xs: Array[Array[Res]]) {
    xs[0][0].touch()
}

fn moveReceiverViaIndex(xs: Array[Res]) {
    xs[0].consume() //~ ERROR reading `Res` out of an index by value needs `Copy`
}

fn makeArr() -> Array[Res] {
    Array.of(Res { id: 1 })
}

fn makeHolderArr() -> Array[Holder] {
    Array.of(Holder { r: Res { id: 1 } })
}

fn moveReceiverViaCallIndex() {
    makeArr()[0].consume() //~ ERROR reading `Res` out of an index by value needs `Copy`
}

fn byValueFieldOfCallIndex() {
    let z = makeHolderArr()[0].r //~ ERROR reading `Res` out of an index by value needs `Copy`
}

fn byValueOptField(hs: Array[Holder?]) {
    let z = hs[0]?.r //~ ERROR reading `Res?` out of an index by value needs `Copy`
}

fn moveExprViaCallIndex() {

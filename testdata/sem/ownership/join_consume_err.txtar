-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn Res.close(move self) {}

fn mk(id: Int) -> Res {
    Res { id: id }
}

fn eat(r: Res) {}

type C = {
    pub v Res
    pub o Res?
    pub r Result[Res, Int]
}

type G = resource {
    pub a Res
}

fn G.drop(move self) {
    eat(for {
        break self.a //~ ERROR reading `self.a` by value
    })
}

fn recvOr(c: C, o: Res?) {
    (o || c.v).close() //~ ERROR reading `c.v` by value
}

fn recvIf(c: C, k: Bool) {
    (if k { c.v } else { mk(0) }).close() //~ ERROR reading `c.v` by value
}

fn recvMatch(c: C) {
    (match 1 {
        _ -> c.v //~ ERROR reading `c.v` by value
    }).close()
}

fn scrutOr(c: C, o: Res?) {
    match (o || c.v) { //~ ERROR reading `c.v` by value
        r -> eat(r)
    }
}

fn scrutIs(c: C, k: Bool) {
    if (if k { c.o } else { None }) is Some(r) { //~ ERROR reading `c.o` by value
        eat(r)
    }
}

fn scrutLetElse(c: C, k: Bool) {
    let Some(r) = (if k { c.o } else { None }) else { //~ ERROR reading `c.o` by value
        return
    }
    eat(r)
}

fn payloadIf(c: C, k: Bool) {
    eat((if k { c.o } else { None }) || mk(0)) //~ ERROR reading `c.o` by value
}

fn payloadTry(c: C, t: Bool) -> Result[Int, Int] {
    let x = (if t { c.r } else { Err(0) })? //~ ERROR reading `c.r` by value
    Ok(x.id)
}

fn argIfLet(c: C, o: Res?) {
    eat(if let Some(x) = o { x } else { c.v }) //~ ERROR reading `c.v` by value
}

fn argBreak(c: C) {
    eat(for {
        break c.v //~ ERROR reading `c.v` by value
    })
}

fn movedIsFine(c: C, o: Res?) {
    (o || move c.v).close()
}

-- module --
stage: driver
-- src --
type P['a, 'b] = { pub x &'a Bytes, pub y &'b Bytes }

fn P['a, 'b].size(self) -> usize { self.x.len() + self.y.len() }

fn pairs['a, 'b](x: &'a Bytes, y: &'b Bytes) -> Array[P['a, 'b]] {
    let mut out: Array[P['a, 'b]] = Array.empty()
    out.push(P { x: x, y: y })
    out
}

fn firstX['a, 'b](ps: &Array[P['a, 'b]]) -> &'a Bytes {
    ps[0].x
}

fn firstXv['a, 'b](ps: Array[P['a, 'b]]) -> &'a Bytes {
    ps[0].x
}

fn count['a, 'b](ps: &Array[P['a, 'b]]) -> usize {
    ps.len()
}

fn caller() -> usize {
    let a = Bytes.fromArray(&Array.of(1, 2, 3))
    let b = Bytes.fromArray(&Array.of(4))
    let mut qs: Array[P['a, 'b]] = Array.empty()
    qs.push(P { x: &a, y: &b })
    let ps = pairs(&a, &b)
    let n = count(&qs) + ps.len()
    let x = firstXv(qs)
    x.len() + n
}

fn local() -> usize {
    let a = Bytes.fromArray(&Array.of(1, 2, 3))
    let mut qs: Array[P['a, 'b]] = Array.empty()
    {
        let b = Bytes.fromArray(&Array.of(4))
        qs.push(P { x: &a, y: &b })
    }
    count(&qs)
}

fn fine() -> usize {
    let a = Bytes.fromArray(&Array.of(1, 2, 3))
    let b = Bytes.fromArray(&Array.of(4))
    let mut qs: Array[P['a, 'b]] = Array.empty()
    qs.push(P { x: &a, y: &b })
    qs[0].size() + count(&qs)
}

let n = fine()

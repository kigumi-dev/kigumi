-- app/t/t.kg --
type Item = {
    pub mut count Int
}

fn Item.update(mut self, delta: Int) {
    self.count = self.count + delta
}

fn beforeDefinition() -> Int {
    let mut item = Item { count: 0 }
    item.update(1)
    let touch = () => { item.update(1) }
    touch()
    item.count
}

fn aliasBeforeDefinition() -> Int {
    let mut item = Item { count: 0 }
    item.update(2)
    let touch = () => { item.update(1) }
    let alias = touch
    alias()
    item.count
}

fn beforeDefinitionInLoop() -> Int {
    let mut item = Item { count: 0 }
    for _ in 0..2 {
        item.update(1)
        let touch = () => { item.update(1) }
        touch()
    }
    item.count
}

// The closure made in the argument only changes the storage the call holds.
fn definedInArgument() -> Int {
    let mut item = Item { count: 0 }
    item.update(bump(() => { item.update(5) }))
    item.count
}

fn bump[F: FnMut[fn() -> Void]](mut f: F) -> Int {
    f()
    1
}

fn onlyThroughClosure() -> Int {
    let mut item = Item { count: 0 }
    let touch = () => { item.update(1) }
    touch()
    touch()
    item.count
}

fn readOnlyCapture() -> Int {
    let mut item = Item { count: 0 }
    let peek = () => item.count
    item.update(1)
    let _ = peek()
    item.count
}

fn otherRootCapture() -> Int {
    let mut item = Item { count: 0 }
    let other = Item { count: 0 }
    let readOther = () => other.count
    item.update(1)
    let _ = readOther()
    item.count
}
-- expect --

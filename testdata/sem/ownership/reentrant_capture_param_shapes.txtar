-- app/t/t.kg --
type Resource = resource {
    pub mut count Int
}
fn Resource.drop(move self) {}

fn Resource.run[F: FnMut[fn() -> Void]](mut self, f: F) {
    f()
}

fn mutate(x: &mut Resource) {
    x.count = 99
}

fn reenter(mut v: Resource, f: fn() -> Void) {
    v.run(f)
}

fn forward[G: FnMut[fn() -> Void]](mut v: Resource, g: G) {
    v.run(g) //~ ERROR cannot see what this closure captures
}

fn forwardAlias[G: FnMut[fn() -> Void]](mut v: Resource, g: G) {
    let g2 = g
    v.run(g2) //~ ERROR cannot see what this closure captures
}

fn doNothing() {}

fn viaTopLevelFnParam(mut v: Resource, unused: fn() -> Void) {
    v.run(doNothing)
}

type Hold = {
    pub mut cb fn() -> Void
    pub mut n Int
}

fn Hold.run[F: FnMut[fn() -> Void]](mut self, f: F) {
    f()
    self.n = self.n + 1
}

fn viaFieldLet(mut h: Hold) -> Int {
    let f = h.cb
    h.run(f)
    h.n
}

fn viaFieldDirect(mut h: Hold) -> Int {
    h.run(h.cb)
    h.n
}

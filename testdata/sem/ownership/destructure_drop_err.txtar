-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

type Guard = resource {
    pub a Res
    pub n Int
}

fn Guard.drop(move self) {
    let Guard { a, n } = self
}

type Outer = {
    pub g Guard
}

fn letDestructure(g: Guard) -> Res {
    let Guard { a, n } = g //~ ERROR cannot move `a` out of `Guard`
    a
}

fn matchDestructure(g: Guard) -> Res {
    match g {
        Guard { a, n } -> a //~ ERROR cannot move `a` out of `Guard`
    }
}

fn nestedDestructure(o: Outer) -> Res {
    let Outer { g: Guard { a, n } } = o //~ ERROR cannot move `a` out of `Guard`
    a
}

fn copyOnly(g: Guard) -> Int {
    let Guard { a: _, n } = g
    n
}

fn borrowed(g: &Guard) -> Int {
    let Guard { a, n } = g
    a.id + n
}

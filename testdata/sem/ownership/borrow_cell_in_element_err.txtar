-- module --
mir: planned
-- src --
type Box = {
    pub mut n Int
}

fn Box.update(mut self, k: Int) {
    self.n = self.n + k
}

fn Box.run[F: FnMut[fn() -> Void]](mut self, mut f: F) {
    f()
    self.n = self.n + 10
}

type Slot[T] = {
    pub x T
}

fn arrayOfShared() -> Int {
    let mut v = Box { n: 0 }
    let a = Array.of(&mut v) //~ ERROR a borrow cannot go in element 0
    for r in a {
        r.update(1)
    }
    let mut w = Box { n: 0 }
    w.run(() => v.update(1))
    v.n
}

fn tupleOfShared() -> Int {
    let mut v = Box { n: 0 }
    let t = (&mut v, 1) //~ ERROR a borrow cannot go in `_0`
    let (r, _) = t
    r.update(1)
    let mut w = Box { n: 0 }
    w.run(() => v.update(1))
    v.n
}

fn arrayInClosure() -> Int {
    let mut v = Box { n: 0 }
    let mut w = Box { n: 0 }
    w.run(() => {
        let a = Array.of(&mut v) //~ ERROR a borrow cannot go in element 0
        for r in a {
            r.update(1)
        }
    })
    v.n
}

fn tupleInClosure() -> Int {
    let mut v = Box { n: 0 }
    let mut w = Box { n: 0 }
    w.run(() => {
        let t = (&mut v, 1) //~ ERROR a borrow cannot go in `_0`
        let (_, k) = t
        _ = k
    })
    v.n
}

fn payloadInClosure() -> Int {
    let mut v = Box { n: 0 }
    let mut w = Box { n: 0 }
    w.run(() => {
        let o = Some(&mut v) //~ ERROR a borrow cannot go in payload 0
        if let Some(r) = o {
            r.update(1)
        }
    })
    v.n
}

fn fieldInClosure() -> Int {
    let mut v = Box { n: 0 }
    let mut w = Box { n: 0 }
    w.run(() => {
        let s = Slot { x: &mut v } //~ ERROR a borrow cannot go in `x`
        s.x.update(1)
    })
    v.n
}

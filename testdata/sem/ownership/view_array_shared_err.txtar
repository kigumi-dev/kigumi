-- module --
stage: driver
-- src --
import {Box, Shared} from std/alloc

type View['a] = { pub data &'a Bytes, pub off usize }

fn views['a](b: &'a Bytes) -> Array[View['a]] {
    Array.of(View { data: b, off: 0 })
}

fn bytes() -> Bytes {
    Bytes.fromArray(&Array.of(1, 2, 3))
}

fn shared() {
    let buf = bytes()
    let vs = views(&buf)
    let s = Shared.new(vs)
    _ = s
}

fn boxed() {
    let buf = bytes()
    let vs = views(&buf)
    let b = Box.new(vs)
    _ = b
}
-- expect --
error[E1020]: `Array[View['a]]` carries a borrow and cannot be stored in `Shared`
  --> main.kg:16:13
   |
16 |     let s = Shared.new(vs)
   |             ^^^^^^^^^^^^^

error[E1020]: `Array[View['a]]` carries a borrow and cannot be stored in `Box`

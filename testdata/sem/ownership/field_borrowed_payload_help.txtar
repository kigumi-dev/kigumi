-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn mk(id: Int) -> Res {
    Res { id: id }
}

type Cell = {
    pub v Res
    pub o Res?
}

type Holder = {
    pub xs Array[Cell]
    pub o Res?
}

fn Holder.viaIndex(self, y: Res) -> Res {
    self.xs[0].o || y //~ ERROR reading `Res?` out of an index by value needs `Copy`
}

fn Holder.viaSelf(self, y: Res) -> Res {
    self.o || y //~ ERROR reading `self.o` by value
}

fn viaCapture(o: Res?, q: Res?) -> Res {
    o.unwrapOrElse(() => q || mk(0)) //~ ERROR reading `q` by value
}

fn viaMoveClosure(o: Res?, q: Res?) -> Res {
    o.unwrapOrElse(move () => q || mk(0))
}

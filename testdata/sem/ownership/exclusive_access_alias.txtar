-- app/t/t.kg --
type Item = {
    pub mut count Int
}

fn Item.update(mut self, d: Int) {
    self.count = self.count + d
}

fn Item.run[F: FnMut[fn() -> Void]](mut self, f: F) {
    f()
}

fn nop() {}

type Pair = {
    pub mut a Item
    pub mut b Item
}

type Slot = {
    pub mut found Option[Item]
    pub mut other Item
}

fn immutableAlias() -> Int {
    let mut v = Item { count: 0 }
    let r = &mut v
    r.run(() => { v.update(1) }) //~ ERROR a closure argument cannot capture `v`
    v.count
}

fn mutAlias() -> Int {
    let mut v = Item { count: 0 }
    let mut r = &mut v
    r.run(() => { v.update(1) }) //~ ERROR a closure argument cannot capture `v`
    v.count
}

fn mutAliasCapturedByClosure() -> Int {
    let mut v = Item { count: 0 }
    let mut r = &mut v
    v.run(() => { r.update(1) }) //~ ERROR a closure argument cannot capture `r`
    v.count
}

fn aliasOfAlias() -> Int {
    let mut v = Item { count: 0 }
    let mut r = &mut v
    let mut s = r
    s.run(() => { v.update(1) }) //~ ERROR a closure argument cannot capture `v`
    v.count
}

fn matchAlias() -> Int {
    let mut o = Some(Item { count: 0 })
    match &mut o {
        Some(r) -> r.run(() => { o = None }) //~ ERROR a closure argument cannot capture `o`
        None -> {}
    }
    0
}

fn ifLetAlias() -> Int {
    let mut o = Some(Item { count: 0 })
    if let Some(r) = &mut o {
        r.run(() => { o = None }) //~ ERROR a closure argument cannot capture `o`
    }
    0
}

fn recordPatternAlias() -> Int {
    let mut p = Pair { a: Item { count: 0 }, b: Item { count: 0 } }
    match &mut p {
        Pair { a, b } -> a.run(() => { p.a.update(1) }) //~ ERROR a closure argument cannot capture `p`
    }
    p.a.count
}

fn mutAliasQuiet() -> Int {
    let mut v = Item { count: 0 }
    let mut r = &mut v
    r.run(nop)
    r.update(1)
    v.run(() => { v.count = 3 }) //~ ERROR a closure argument cannot capture `v`
    v.count
}

fn aliasOfOtherField() -> Int {
    let mut p = Pair { a: Item { count: 0 }, b: Item { count: 0 } }
    let mut r = &mut p.a
    p.b.run(() => { r.update(1) })
    p.a.count
}

fn aliasOfSameField() -> Int {
    let mut p = Pair { a: Item { count: 0 }, b: Item { count: 0 } }
    let mut r = &mut p.a
    p.a.run(() => { r.update(1) }) //~ ERROR a closure argument cannot capture `r`
    p.a.count
}

fn patternAliasOfOtherField() -> Int {
    let mut s = Slot { found: Some(Item { count: 0 }), other: Item { count: 0 } }
    if let Some(r) = &mut s.found {
        r.run(() => { s.other.update(1) })
    }
    s.other.count
}

fn patternAliasOfSameField() -> Int {
    let mut s = Slot { found: Some(Item { count: 0 }), other: Item { count: 0 } }
    if let Some(r) = &mut s.found {
        r.run(() => { s.found = None }) //~ ERROR a closure argument cannot capture `s`
    }
    s.other.count
}

fn matchByValueIsNotAlias() -> Int {
    let mut o = Some(Item { count: 0 })
    match o {
        Some(r) -> {
            let mut c = r
            c.run(() => { o = None })
        }
        None -> {}
    }
    0
}

fn mk() -> Item {
    Item { count: 0 }
}

fn ifBranchAlias() -> Int {
    let mut a = mk()
    let mut b = mk()
    let c = a.count == 0
    let r = if c { &mut a } else { &mut b }
    r.run(() => { a.update(1) }) //~ ERROR a closure argument cannot capture `a`
    a.count
}

fn ifBranchOtherBranch() -> Int {
    let mut a = mk()
    let mut b = mk()
    let c = a.count == 0
    let r = if c { &mut a } else { &mut b }
    r.run(() => { b.update(1) }) //~ ERROR a closure argument cannot capture `b`
    b.count
}

fn matchBranchAlias() -> Int {
    let mut a = mk()
    let r = match a.count {
        _ -> &mut a
    }
    r.run(() => { a.update(1) }) //~ ERROR a closure argument cannot capture `a`
    a.count
}

fn blockAlias() -> Int {
    let mut a = mk()
    let r = { &mut a }
    r.run(() => { a.update(1) }) //~ ERROR a closure argument cannot capture `a`
    a.count
}

fn branchAliasUnrelated() -> Int {
    let mut a = mk()
    let mut b = mk()
    let mut z = mk()
    let c = a.count == 0
    let r = if c { &mut a } else { &mut b }
    r.run(() => { z.update(1) })
    z.count
}

fn siblingPatternFields() -> Int {
    let mut p = Pair { a: mk(), b: mk() }
    match &mut p {
        Pair { a, b } -> b.run(() => { a.update(1) })
    }
    p.a.count
}

fn siblingPatternFieldsReversed() -> Int {
    let mut p = Pair { a: mk(), b: mk() }
    match &mut p {
        Pair { a, b } -> a.run(() => { b.update(1) })
    }
    p.b.count
}

fn samePatternField() -> Int {
    let mut p = Pair { a: mk(), b: mk() }
    match &mut p {
        Pair { a, b } -> a.run(() => { a.update(1) }) //~ ERROR a closure argument cannot capture `a`
    }
    p.a.count
}

fn patternFieldVsRoot() -> Int {
    let mut p = Pair { a: mk(), b: mk() }
    match &mut p {
        Pair { a, b } -> a.run(() => { p.a.update(1) }) //~ ERROR a closure argument cannot capture `p`
    }
    p.a.count
}

fn aliasOfFieldCapturedByFieldCall() {
    let mut p = Pair { a: mk(), b: mk() }
    match &mut p.a {
        r -> p.a.run(() => { r.update(1) }) //~ ERROR a closure argument cannot capture `r`
    }
}

fn aliasOfRootThenFieldCall() -> Int {
    let mut p = Pair { a: mk(), b: mk() }
    let r = &mut p
    r.a.run(() => { p.b.update(1) })
    p.b.count
}

fn aliasOfRootThenSameFieldCall() -> Int {
    let mut p = Pair { a: mk(), b: mk() }
    let r = &mut p
    r.a.run(() => { p.a.update(1) }) //~ ERROR a closure argument cannot capture `p`
    p.a.count
}

fn aliasOfRootFieldCallVsOtherAlias() -> Int {
    let mut p = Pair { a: mk(), b: mk() }
    let r = &mut p
    let s = &mut p.b
    r.a.run(() => { s.update(1) })
    p.b.count
}

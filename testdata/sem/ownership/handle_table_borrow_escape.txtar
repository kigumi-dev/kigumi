import ffi from std/ffi

fn leak['a](table: &'a ffi.HandleTable[Int], h: &'a ffi.FfiHandle[Int]) -> &'a Int {
    table.with(h, (v: &'a Int) => v) //~ ERROR borrow types cannot appear in return types
}

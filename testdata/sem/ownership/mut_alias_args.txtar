-- src --
fn addBoth(a: &mut Int, b: &mut Int) {
    a = a + 10
    b = b + 100
}

fn sameIndexLiteral() {
    let mut arr = Array.of(1, 2, 3)
    addBoth(&mut arr[0], &mut arr[0]) //~ ERROR this `&mut` argument may target the same storage
}

type Box = { mut v Int }

fn sameField() {
    let mut b = Box { v: 1 }
    addBoth(&mut b.v, &mut b.v) //~ ERROR this `&mut` argument may target the same storage
}

fn unknownIndices(i: usize, j: usize) {
    let mut arr = Array.of(1, 2, 3)
    addBoth(&mut arr[i], &mut arr[j]) //~ ERROR this `&mut` argument may target the same storage
}

fn distinctLiteral() {
    let mut arr = Array.of(1, 2, 3)
    addBoth(&mut arr[0], &mut arr[2])
}

fn distinctNestedRow() {
    let mut mat = Array.of(Array.of(1, 2), Array.of(3, 4))
    addBoth(&mut mat[0][1], &mut mat[1][1])
}

fn sameNestedIndex() {
    let mut mat = Array.of(Array.of(1, 2), Array.of(3, 4))
    addBoth(&mut mat[0][1], &mut mat[0][1]) //~ ERROR this `&mut` argument may target the same storage
}

type Pair = { mut a Int, mut b Int }

fn takeIntPair(x: &mut Int, p: &mut Pair) {}
fn takePairInt(p: &mut Pair, x: &mut Int) {}

fn wholeAndField() {
    let mut p = Pair { a: 1, b: 2 }
    takeIntPair(&mut p.a, &mut p) //~ ERROR this `&mut` argument may target the same storage
}

fn wholeAndFieldReversed() {
    let mut p = Pair { a: 1, b: 2 }
    takePairInt(&mut p, &mut p.a) //~ ERROR this `&mut` argument may target the same storage
}

fn siblingFields() {
    let mut p = Pair { a: 1, b: 2 }
    addBoth(&mut p.a, &mut p.b)
}

fn distinctRoots() {
    let mut p = Pair { a: 1, b: 2 }
    let mut q = Pair { a: 1, b: 2 }
    takeIntPair(&mut p.a, &mut q)
}

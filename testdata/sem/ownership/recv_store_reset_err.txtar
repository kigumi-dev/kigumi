-- module --
mir: planned
-- src --
type View['a] = { pub mut data &'a Array[Int], pub mut off usize }

type Two['a] = { pub mut x &'a String, pub mut y &'a String }

type V['a] = { pub s &'a String }

fn View['a].at(self) -> Int {
    self.data[self.off]
}

fn View['a].setAll(mut self, d: &'a Array[Int]) {
    self = View { data: d, off: 0 }
}

fn View['a].setData(mut self, d: &'a Array[Int]) {
    self.data = d
}

fn View['a].setSome(mut self, d: &'a Array[Int], go: Bool) {
    if go {
        self = View { data: d, off: 0 }
    }
}

fn View['a].setLate(mut self, d: &'a Array[Int], go: Bool) {
    if go {
        return
    }
    self.data = d
}

fn Two['a].setX(mut self, s: &'a String) {
    self.x = s
}

fn mkV['a](s: &'a String) -> V['a] {
    V { s: s }
}

fn putMut[U](out: &mut U, items: &mut Array[String], f: fn(&String) -> U) {
    out = f(&items[0])
}

fn putTry[U](out: &mut U, items: &mut Array[String], f: fn(&String) -> U, r: Result[Int, String]) -> Result[Int, String] {
    let n = r?
    out = f(&items[0])
    Ok(n)
}

fn someLeft(go: Bool) -> Int {
    let mut a = Array.of(1, 2, 3)
    let b = Array.of(7, 8)
    let mut cur = View { data: &a, off: 0 }
    cur.setSome(&b, go)
    a = Array.of(9) //~ ERROR `a` is borrowed and cannot be mutated //~ ERROR `a` is borrowed and cannot be moved
    cur.at()
}

fn lateLeft(go: Bool) -> Int {
    let mut a = Array.of(1, 2, 3)
    let b = Array.of(7, 8)
    let mut cur = View { data: &a, off: 0 }
    cur.setLate(&b, go)
    a = Array.of(9) //~ ERROR `a` is borrowed and cannot be mutated //~ ERROR `a` is borrowed and cannot be moved
    cur.at()
}

fn branchLeft(go: Bool) -> Int {
    let mut a = Array.of(1, 2, 3)
    let b = Array.of(7, 8)
    let mut cur = View { data: &a, off: 0 }
    if go {
        cur.setData(&b)
    }
    a = Array.of(9) //~ ERROR `a` is borrowed and cannot be mutated //~ ERROR `a` is borrowed and cannot be moved
    cur.at()
}

fn otherField() -> usize {
    let mut p = "p"
    let q = "qq"
    let mut t = Two { x: &q, y: &p }
    t.setX(&q)
    p = "z" //~ ERROR `p` is borrowed and cannot be mutated //~ ERROR `p` is borrowed and cannot be moved
    t.y.len()
}

fn newAll() -> Int {
    let a = Array.of(1, 2, 3)
    let mut b = Array.of(7, 8)
    let mut cur = View { data: &a, off: 0 }
    cur.setAll(&b)
    b = Array.of(9) //~ ERROR `b` is borrowed and cannot be mutated //~ ERROR `b` is borrowed and cannot be moved
    cur.at()
}

fn newData() -> Int {
    let a = Array.of(1, 2, 3)
    let mut b = Array.of(7, 8)
    let mut cur = View { data: &a, off: 0 }
    cur.setData(&b)
    b = Array.of(9) //~ ERROR `b` is borrowed and cannot be mutated //~ ERROR `b` is borrowed and cannot be moved
    cur.at()
}

fn tryKeeps() -> usize {
    let k = "k"
    let mut items = Array.of("i1", "i22")
    let mut other = Array.of("o1", "o2")
    let mut out = mkV(&k)
    putMut(&mut out, &mut items, mkV)
    let r = putTry(&mut out, &mut other, mkV, Err("no"))
    items.push("x") //~ ERROR `items` is borrowed and cannot be mutated
    match r {
        Ok(n) -> out.s.len() + (n.toUsize() || 0)
        Err(e) -> out.s.len() + e.len()
    }
}

fn main() {
    print "${someLeft(true)} ${lateLeft(false)} ${branchLeft(true)} ${otherField()} ${newAll()} ${newData()} ${tryKeeps()}"
}

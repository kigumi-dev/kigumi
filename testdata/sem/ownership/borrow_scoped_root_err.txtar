-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn mk(id: Int) -> Res {
    Res { id: id }
}

type Cell = {
    pub v Res
}

fn mkc(id: Int) -> Cell {
    Cell { v: mk(id) }
}

context k: Cell

@provides(k)
type Env = {
    pub k Cell
}

type Pt = {
    pub name String
    pub n Int
}

fn mkPt() -> Pt {
    Pt { name: "origin", n: 1 }
}

const home: Pt = comptime mkPt()

static origin: Pt = comptime mkPt()

type Pair = {
    pub a Res
    pub b Res
}

type C = {
    pub p Pair
    pub q Pair
}

fn unsafeLocal() -> Int {
    let r = &unsafe { //~ ERROR cannot keep a borrow of a temporary
        let t = mk(7)
        t
    }
    r.id
}

fn unsafeLocalField() -> Int {
    let r = &unsafe { //~ ERROR cannot keep a borrow of a temporary
        let t = mkc(8)
        t.v
    }
    r.id
}

fn nestedBlock() -> Int {
    let r = &unsafe { //~ ERROR cannot keep a borrow of a temporary
        {
            let t = mk(3)
            t
        }
    }
    r.id
}

fn memberOfLocal() -> Int {
    let r = &(unsafe { //~ ERROR cannot keep a borrow of a temporary
        let t = mkc(4)
        t
    }).v
    r.id
}

fn movedParam(c: Cell) -> Int {
    let r = &unsafe { c }.v //~ ERROR cannot keep a borrow of a temporary
    r.id
}

fn providedKey() -> Int {
    let r = &context (Env { k: mkc(1) }) { //~ ERROR cannot keep a borrow of a temporary
        k.v
    }
    r.id
}

fn providedLocal() -> Int {
    let r = &context (Env { k: mkc(1) }) { //~ ERROR cannot keep a borrow of a temporary
        let t = mk(2)
        t
    }
    r.id
}

fn constRoot() -> Int {
    let r = &home //~ ERROR cannot keep a borrow of a temporary
    r.n
}

fn constField() -> usize {
    let s = &home.name //~ ERROR cannot keep a borrow of a temporary
    s.len()
}

fn refJoinMatch(c: C, k: Bool) -> Int {
    match &(if k { &c.p } else { &c.q }) {
        r -> r.a.id //~ ERROR this pattern cannot match `&&Pair`
    }
}

fn refMatch(p: &Pair) -> Int {
    match &p {
        r -> r.a.id //~ ERROR this pattern cannot match `&&Pair`
    }
}

fn staticRoot() -> usize {
    let r = &origin
    let s = &origin.name
    r.name.len() + s.len()
}

fn outerKey() -> Int {
    let r = &k.v
    r.id
}

fn outerField(c: Cell) -> Int {
    let r = &unsafe { c.v }
    r.id
}

fn matchScoped() -> Int {
    match &unsafe {
        let t = mk(9)
        t
    } {
        r -> r.id
    }
}

fn refJoinPlain(c: C, k: Bool) -> Int {
    match if k { &c.p } else { &c.q } {
        r -> r.a.id
    }
}

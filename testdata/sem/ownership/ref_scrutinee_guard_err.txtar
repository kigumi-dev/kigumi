-- src --
type Bag = {pub items Array[i64], pub tag String}
type Sh = Boxy(b: Bag) | Nil
type H = {pub b Bag, pub n i64}
type Holder = {pub mut sh Sh}

fn pickSh(r: &Sh) -> &Sh { r }
fn pickBag(r: &Bag) -> &Bag { r }
fn mkSh(t: String) -> Sh { Sh.Boxy(Bag { items: Array.of(1), tag: t }) }
fn mkh(t: String) -> H { H { b: Bag { items: Array.of(1), tag: t }, n: 1 } }

fn behindAnd(r: &Sh, c: Bool) -> String {
    match 0 {
        0 if c && pickSh(r) is Boxy(b) -> b.tag, //~ ERROR `b` keeps a borrow of a temporary that the right side of `&&` creates
        _ -> "",
    }
}

fn shorthandBehindAnd(c: Bool) -> String {
    match 0 {
        0 if c && (&mkh("s") is H { b, n }) -> b.tag, //~ ERROR `b` keeps a borrow of a temporary that the right side of `&&` creates
        _ -> "",
    }
}

fn secondIs(r: &Sh) -> String {
    match 0 {
        0 if pickSh(r) is Boxy(b) && pickSh(r) is Boxy(d) -> d.tag, //~ ERROR `d` keeps a borrow of a temporary that the right side of `&&` creates
        _ -> "",
    }
}

fn letBehindAnd(o: i64?, r: &Sh, c: Bool) -> String {
    if let Some(k) = o; c && pickSh(r) is Boxy(b) { //~ ERROR `b` keeps a borrow of a temporary that the right side of `&&` creates
        return b.tag
    }
    ""
}

fn rootMoved() -> String {
    let mut s = mkSh("a")
    match 0 {
        0 if pickSh(&s) is Boxy(b) -> {
            s = Sh.Nil //~ ERROR `s` is borrowed and cannot be moved or dropped here //~ ERROR `s` is borrowed and cannot be mutated here
            b.tag
        }
        _ -> "",
    }
}

fn rootWritten(h: &mut Holder) -> String {
    match 0 {
        0 if pickSh(&h.sh) is Boxy(b) -> {
            h.sh = Sh.Nil //~ ERROR `h` is borrowed and cannot be mutated here
            b.tag
        }
        _ -> "",
    }
}

fn keptPastMatch() -> String {
    let k = match 0 { //~ ERROR `k` keeps a borrow of a temporary past the statement
        0 if pickSh(&mkSh("k")) is Boxy(b) -> b,
        _ -> return "",
    }
    k.tag
}

fn wholeOfTemp(k: i64) -> String {
    match k {
        0 if pickBag(&Bag { items: Array.of(1), tag: "w" }) is x -> x.tag, //~ ERROR `x` keeps a borrow of a temporary past the statement
        _ -> "",
    }
}

fn valueBehindAnd(c: Bool) -> Bool {
    let r = c && (&mkSh("x") is Boxy(b)) && b.tag == "x" //~ ERROR `b` keeps a borrow of a temporary that the right side of `&&` creates
    r
}

fn countedValueBehindAnd(s: &Sh, c: Bool) -> Bool {
    c && pickSh(s) is Boxy(b) && b.tag == "x" //~ ERROR `b` keeps a borrow of a temporary that the right side of `&&` creates
}


-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {
    print "drop ${self.id}"
}

let r = Array.of(Res { id: 1 })
let f = r.filter((x: &Res) => true) //~ ERROR `Res` does not satisfy `Copy`
let g = r.concat(Array.of(Res { id: 2 })) //~ ERROR `Res` does not satisfy `Copy`
print "${f.len()} ${g.len()}"

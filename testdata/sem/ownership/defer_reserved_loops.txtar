-- module --
mir: planned
-- src --
type Handle = resource {
    pub id Int
}

fn Handle.drop(move self) {}

fn Handle.close(move self) {}

fn Handle.peek(self) -> Int {
    self.id
}

type Pack = {
    pub mut inner Handle
    pub mut other Handle
}

fn mkh(n: Int) -> Handle {
    Handle { id: n }
}

fn mk(n: Int) -> Pack {
    Pack { inner: mkh(n), other: mkh(n + 1) }
}

fn show(h: &Handle) {}

fn sink(n: Int) {}

fn outerBinding() {
    let h = mkh(1)
    for i in 0..2 {
        defer { h.close() } //~ ERROR
    }
}

fn outerField() {
    let b = mk(1)
    for i in 0..2 {
        defer { b.inner.close() } //~ ERROR
    }
}

fn outerParam(h: Handle) {
    for i in 0..2 {
        defer { h.close() } //~ ERROR
    }
}

fn conditionLoop(n: Int) {
    let h = mkh(1)
    let mut left = n
    for left > 0 {
        defer { h.close() } //~ ERROR
        left = left - 1
    }
}

fn bareLoop() {
    let h = mkh(1)
    for {
        defer { h.close() } //~ ERROR
        break
    }
}

fn innerLoop() {
    for i in 0..2 {
        let h = mkh(i)
        for j in 0..2 {
            defer { h.close() } //~ ERROR
        }
    }
}

fn perIterationBinding() {
    for i in 0..2 {
        let h = mkh(i)
        defer { h.close() }
        sink(h.peek())
    }
}

fn loopVariable() {
    for h in Array.of(mkh(1), mkh(2)) {
        defer { h.close() }
    }
}

fn perIterationField() {
    for i in 0..2 {
        let b = mk(i)
        defer { b.inner.close() }
        b.other.close()
    }
}

fn perIterationFieldMoves() {
    for i in 0..2 {
        let b = mk(i)
        b.other.close()
        b.inner.close()
    }
}

fn reassignedEachIteration() {
    let mut b = mk(1)
    for i in 0..2 {
        b.other.close()
        b = mk(i)
    }
    b.inner.close()
    b.other.close()
}

fn outerBorrowOnly() {
    let h = mkh(1)
    for i in 0..2 {
        defer { show(&h) }
    }
    h.close()
}

fn outerFailCleanup() -> Void! {
    let h = mkh(1)
    for i in 0..2 {
        defer(fail) { h.close() }
    }
}

fn cleanupBeforeLoop() {
    let h = mkh(1)
    defer { h.close() }
    for i in 0..2 {
        sink(i)
    }
}

fn lambdaInLoop() {
    let h = mkh(1)
    for i in 0..2 {
        let f = () => {
            let g = mkh(i)
            defer { g.close() }
            sink(g.peek())
        }
        f()
    }
    h.close()
}

-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn mk(id: Int) -> Res {
    Res { id: id }
}

type Guard = resource {
    pub a Res
    pub n Int
}

fn Guard.drop(move self) {}

fn mkg(i: Int) -> Guard {
    Guard { a: mk(i), n: i }
}

type Id = Res

type W = {
    pub id Id
}

fn tempDrop(o: Res?) -> Res {
    o || move mkg(1).a //~ ERROR cannot move `mkg(1).a` out of `Guard`
}

fn ownerDrop(g: Guard) -> Res {
    move g.a //~ ERROR cannot move `g.a` out of `Guard`
}

fn ownerDropFallback(g: Guard, o: Res?) -> Res {
    let r = o || g.a //~ ERROR cannot move `g.a` out of `Guard`
    r
}

fn ownerDropLet(g: Guard) -> Res {
    let r = g.a //~ ERROR cannot move `g.a` out of `Guard`
    r
}

fn valueThroughRef(x: &W) -> Res {
    move x.id.value //~ ERROR cannot move `Res` out of a borrow
}

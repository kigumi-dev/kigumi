-- src --
import {Arena} from std/alloc

context k: Int

@provides(k)
type Env = {
    pub k Int
}

type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn mk(id: Int) -> Res {
    Res { id: id }
}

fn eat(r: Res) {}

type Guard = resource {
    pub a Res
    pub o Res?
}

fn Guard.drop(move self) {}

fn mkg(i: Int) -> Guard {
    Guard { a: mk(i), o: None }
}

fn unsafeTail() -> Res {
    unsafe { mkg(1).a } //~ ERROR cannot move `mkg(1).a` out of `Guard`
}

fn unsafeOr(o: Res?) -> Res {
    o || unsafe { mkg(2).a } //~ ERROR cannot move `mkg(2).a` out of `Guard`
}

fn unsafeLet() -> Res {
    let r = unsafe { mkg(3).a } //~ ERROR cannot move `mkg(3).a` out of `Guard`
    r
}

fn unsafeArg() {
    eat(unsafe { mkg(4).a }) //~ ERROR cannot move `mkg(4).a` out of `Guard`
}

fn unsafeReceiver() -> Res {
    unsafe { mkg(5).o }.unwrap() //~ ERROR cannot move `mkg(5).o` out of `Guard`
}

fn unsafePayload(y: Res) -> Res {
    unsafe { mkg(6).o } || y //~ ERROR cannot move `mkg(6).o` out of `Guard`
}

fn ifLetTail(o: Res?) -> Res {
    if let Some(r) = o { r } else { mkg(7).a } //~ ERROR cannot move `mkg(7).a` out of `Guard`
}

fn ifLetOr(o: Res?, q: Res?) -> Res {
    q || if let Some(r) = o { r } else { mkg(8).a } //~ ERROR cannot move `mkg(8).a` out of `Guard`
}

fn ifLetLet(o: Res?) -> Res {
    let r = if let Some(r) = o { r } else { mkg(9).a } //~ ERROR cannot move `mkg(9).a` out of `Guard`
    r
}

fn ifLetArg(o: Res?) {
    eat(if let Some(r) = o { r } else { mkg(10).a }) //~ ERROR cannot move `mkg(10).a` out of `Guard`
}

fn ifLetReceiver(o: Res??) -> Res {
    (if let Some(r) = o { r } else { mkg(11).o }).unwrap() //~ ERROR cannot move `mkg(11).o` out of `Guard`
}

fn ifLetPayload(o: Res??, y: Res) -> Res {
    (if let Some(r) = o { r } else { mkg(12).o }) || y //~ ERROR cannot move `mkg(12).o` out of `Guard`
}

fn contextTail() -> Res {
    context (Env { k: 13 }) {
        mkg(k).a //~ ERROR cannot move `mkg(k).a` out of `Guard`
    }
}

fn contextArg() {
    eat(context (Env { k: 14 }) {
        mkg(k).a //~ ERROR cannot move `mkg(k).a` out of `Guard`
    })
}

fn allocatorLet() -> Int! {
    let arena = Arena.create()?
    let r = allocator arena.scope() {
        mkg(15).a //~ ERROR cannot move `mkg(15).a` out of `Guard`
    }
    Ok(r.id)
}

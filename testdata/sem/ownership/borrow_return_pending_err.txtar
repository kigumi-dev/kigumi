-- src --
type R = resource {
    pub mut id Int
}

fn R.drop(move self) {
    _ = self
}

type H = {
    pub mut r R
    pub mut n Int
}

fn see(n: Int) -> Int {
    n
}

fn rOf(h: &H) -> &R {
    &h.r
}

fn H.rMut(mut self) -> &mut R {
    &mut self.r
}

fn writeBeforeLastUse() {
    let mut h = H { r: R { id: 1 }, n: 0 }
    let a = rOf(&h)
    h.n += 1
    _ = see(a.id)
}

fn replaceAfterLastUse() {
    let mut h = H { r: R { id: 1 }, n: 0 }
    let a = rOf(&h)
    _ = see(a.id)
    h.r = R { id: 2 }
}

fn mutCallAfterLastUse() {
    let mut h = H { r: R { id: 1 }, n: 0 }
    let a = rOf(&h)
    _ = see(a.id)
    let m = h.rMut()
    m.id += 1
}

fn moveAfterLastUse() {
    let h = H { r: R { id: 1 }, n: 0 }
    let a = rOf(&h)
    _ = see(a.id)
    let h2 = h
}

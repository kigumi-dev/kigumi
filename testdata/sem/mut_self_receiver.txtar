-- src --
type Shape = Circle(r: Int) | Dot

fn Shape.flatten(mut self) -> Unit {
    self = Dot
}

fn Shape.widen(mut self, k: Int) -> Unit {
    self = Circle(k)
}

type Counter = {
    pub mut n Int
}

fn Counter.inc(mut self) -> Unit {
    self.n = self.n + 1
}

async fn Counter.incLater(mut self) -> Unit {
    self = Counter { n: self.n + 1 } //~ ERROR assigns `self` as a whole in an `async` body
}

async fn Counter.bumpLater(mut self) -> Unit {
    self.n = self.n + 1
}

fn viaBorrow(s: &mut Shape) -> Unit {
    s.flatten() //~ ERROR replaces its receiver as a whole
}

fn viaBorrowNested(s: &mut Shape, k: Int) -> Unit {
    s.widen(k) //~ ERROR replaces its receiver as a whole
}

fn takeViaBorrow(o: &mut Int?) -> Int {
    o.take() || 0 //~ ERROR replaces its receiver as a whole
}

fn fieldWriteIsFine(c: &mut Counter) -> Unit {
    c.inc()
}

type Holder = {
    mut shape Shape
}

fn placeIsFine(h: &mut Holder) -> Unit {
    h.shape.flatten()
}

fn ownedIsFine() -> Unit {
    let mut s: Shape = Circle(1)
    s.flatten()
}

fn Counter.escapingRead(mut self) -> fn() -> Int {
    () => self.n //~ ERROR cannot be a plain `fn`
}

fn Counter.closureIsFine(mut self) -> Int {
    let add = (k: Int) => { self.n = self.n + k }
    add(3)
    self.n
}

interface Widener {
    fn widen(mut self, k: Int) -> Unit
}

fn widenViaBorrowedParam[W: Widener](w: &mut W, k: Int) -> Unit {
    w.widen(k) //~ ERROR can be witnessed by `Shape.widen`
}

fn widenOwnedParamIsFine[W: Widener](mut w: W, k: Int) -> Unit {
    w.widen(k)
}

interface Bumper {
    fn inc(mut self) -> Unit
}

fn incViaBorrowedParamIsFine[B: Bumper](b: &mut B) -> Unit {
    b.inc()
}

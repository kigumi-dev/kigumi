-- src --
type H = {
    pub mut n Int
}

type R = resource {
    pub n Int
}

fn R.drop(move self) {
    _ = self
}

fn H.get(self) -> Int {
    self.n
}

fn H.bump(mut self) {
    self.n += 1
}

fn R.consume(move self) -> Int {
    self.n
}

fn R.peek(self) -> Int {
    self.n
}

fn okChain(h: H?) -> Int? {
    h?.get()
}

fn nonOption(i: Int) -> Int? {
    i?.get() //~ ERROR `?.` needs an `Option` operand, found `Int`
}

fn mutThrough(h: H?) -> Void? {
    h?.bump() //~ ERROR `bump` takes `mut self` but the receiver is a temporary
}

fn moveThrough(r: R?) -> Int? {
    r?.consume() //~ ERROR cannot move `R` out of a borrow
}

fn borrowedOk(r: R?) -> Int? {
    r?.peek()
}

fn ownedTemp(make: fn() -> R?) -> Int? {
    make()?.consume()
}

fn doubled(h: H?) -> Int? {
    h?.get()?.toInt() //~ ERROR `Int` has no field or method `toInt`
}

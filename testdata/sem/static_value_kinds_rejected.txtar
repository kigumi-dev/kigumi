-- src --
type In = {
    pub a Int
    pub b Int
}

type Pick = Held(v: In) | Empty

fn mkPick() -> Pick {
    Held(In { a: 1, b: 2 })
}

fn hidden(x: Int) -> Int {
    x + 1
}

fn mkFn() -> fn(Int) -> Int {
    hidden
}

fn mkOpt() -> Option[In] {
    Some(In { a: 1, b: 2 })
}

fn mkRes() -> Result[In, Int] {
    Ok(In { a: 1, b: 2 })
}

static pick: Pick = comptime mkPick() //~ ERROR a comptime block must produce
static viaThunk: fn(Int) -> Int = comptime mkFn() //~ ERROR a comptime block must produce
static named: fn(Int) -> Int = hidden //~ ERROR `hidden` is not a compile-time constant
static opt: Option[In] = comptime mkOpt() //~ ERROR a comptime block must produce
static res: Result[In, Int] = comptime mkRes() //~ ERROR a comptime block must produce

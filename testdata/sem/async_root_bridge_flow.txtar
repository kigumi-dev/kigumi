-- app/t/t.kg --
import task from std/task

async fn work() -> Int {
    0
}

fn syncRoot() -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(work())
}

fn safeFn() -> Int {
    9
}

type Holder = {
    pub mut cb fn() -> Int
}

type Wrap = {
    pub mut inner Holder
}


fn callIt(h: Holder) -> Int {
    h.cb()
}

fn mutate(w: &mut Wrap) -> Unit {
    w.inner.cb = syncRoot
}

fn opaqueSel(b: Bool) -> fn() -> Int {
    if b { syncRoot } else { safeFn }
}

async fn safeMutCopyBeforeWrite() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    let mut h = w.inner
    w.inner.cb = syncRoot
    h.cb()
}

async fn safeImmCopyBeforeWrite() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    let h = w.inner
    w.inner.cb = syncRoot
    h.cb()
}

async fn safeWholeCopyBeforeWrite() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    let v = w
    w.inner.cb = syncRoot
    v.inner.cb()
}

async fn safeCopyBeforeCalleeWrite() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    let h = w.inner
    mutate(&mut w)
    h.cb()
}

async fn safePassedCopyBeforeWrite() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    let h = w.inner
    w.inner.cb = syncRoot
    callIt(h)
}

async fn safeChainBeforeWrite() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    let a = w
    let b = a
    w.inner.cb = syncRoot
    b.inner.cb()
}

async fn safeCopyBeforeUnresolvedWrite() -> Int {
    let sel: fn(Bool) -> fn() -> Int = opaqueSel
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    let h = w.inner
    w.inner.cb = sel(true)
    h.cb()
}

async fn safeLoopLocalSource() -> Int {
    let mut total = 0
    let mut n = 0
    for n < 2 {
        let mut w = Wrap { inner: Holder { cb: safeFn } }
        let h = w.inner
        w.inner.cb = syncRoot
        total = total + h.cb()
        n = n + 1
    }
    total
}

async fn riskyCopyAfterWrite() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    w.inner.cb = syncRoot
    let h = w.inner
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn riskyMutCopyAfterWrite() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    w.inner.cb = syncRoot
    let mut h = w.inner
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn riskyCopyAfterCalleeWrite() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    mutate(&mut w)
    let h = w.inner
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn riskyCopyBetweenWrites() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    w.inner.cb = syncRoot
    let h = w.inner
    w.inner.cb = safeFn
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn riskyCopyAfterUnresolvedWrite() -> Int {
    let sel: fn(Bool) -> fn() -> Int = opaqueSel
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    w.inner.cb = sel(true) //~ ERROR cannot run inside an `async fn`
    let h = w.inner
    h.cb()
}

async fn riskyLoopWriteReachesCopy() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    let mut total = 0
    let mut n = 0
    for n < 2 {
        let h = w.inner
        total = total + h.cb() //~ ERROR cannot run inside an `async fn`
        w.inner.cb = syncRoot
        n = n + 1
    }
    total
}

async fn riskyCopyInClosure() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    let take = () => {
        let h = w.inner
        h.cb() //~ ERROR cannot run inside an `async fn`
    }
    w.inner.cb = syncRoot
    take()
}

async fn riskyPassedCopyAfterWrite() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    w.inner.cb = syncRoot
    let h = w.inner
    callIt(h) //~ ERROR cannot run inside an `async fn`
}

async fn riskyChainAfterWrite() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    w.inner.cb = syncRoot
    let a = w
    let b = a
    b.inner.cb() //~ ERROR cannot run inside an `async fn`
}

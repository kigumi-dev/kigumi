-- module --
mir: planned
-- src --
import task from std/task
import alloc from std/alloc

type SHold = { s alloc.Shared[Future[Int]?] }
fn putIn(s: alloc.Shared[Future[Int]?], h: Future[Int]) { s.set(Some(h)) }
fn putClone(s: alloc.Shared[Future[Int]?], h: Future[Int]) { let s2 = s.clone(); s2.set(Some(h)) }
fn putGen[T](s: alloc.Shared[T?], v: T) { s.set(Some(v)) }
fn putMethodValue(s: alloc.Shared[Future[Int]?], h: Future[Int]) { let set = s.set; set(Some(h)) }
async fn putAsync(s: alloc.Shared[Future[Int]?], h: Future[Int]) -> Int { s.set(Some(h)); 0 }
fn startInto[F: FnOnce[fn() -> Int]](s: alloc.Shared[Future[Int]?], pool: task.BlockingPool, w: escaping F) { s.set(Some(pool.run(w).unwrap())) }
fn setVia(s: &mut alloc.Shared[Future[Int]?], h: Future[Int]) { s.set(Some(h)) }
fn dropShared(s: alloc.Shared[Future[Int]?]) {}
fn finish(h: Future[Int]) -> Int { 0 }

async fn setThroughReceiver() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let s: alloc.Shared[Future[Int]?] = alloc.Shared.new(None)
    s.set(Some(pool.run(() => { other = "x"; 1 }).unwrap()))
    let r = &other //~ ERROR `other` is written by a closure that may still be running on another thread
    r.len().toInt() || 0
}

async fn setThroughHelper() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let s: alloc.Shared[Future[Int]?] = alloc.Shared.new(None)
    putIn(s.clone(), pool.run(() => { other = "x"; 1 }).unwrap())
    let k = other.len().toInt() || 0 //~ ERROR `other` is written by a closure that may still be running on another thread
    dropShared(s)
    k
}


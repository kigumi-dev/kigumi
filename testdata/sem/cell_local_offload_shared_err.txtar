    let mut other = "o"
    let s: alloc.Shared[Future[Int]?] = alloc.Shared.new(None)
    startInto(s, pool, () => { other = "x"; 1 })
    other.len().toInt() || 0
}

async fn asyncHelperConsumesShared() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let s: alloc.Shared[Future[Int]?] = alloc.Shared.new(None)
    let n = await putAsync(s, pool.run(() => { other = "x"; 1 }).unwrap())
    n + (other.len().toInt() || 0)
}

async fn unrelatedShared() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let s: alloc.Shared[Future[Int]?] = alloc.Shared.new(None)
    let n = await pool.run(() => { other = "x"; 1 }).unwrap()
    s.set(None)
    n + (other.len().toInt() || 0)
}

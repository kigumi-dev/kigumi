async fn setThroughField() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let hd = SHold { s: alloc.Shared.new(None) }
    hd.s.set(Some(pool.run(() => { other = "x"; 1 }).unwrap()))
    other.len().toInt() || 0 //~ ERROR `other` is written by a closure that may still be running on another thread
}

async fn setThroughElement() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let arr: Array[alloc.Shared[Future[Int]?]] = Array.of(alloc.Shared.new(None))
    arr[0].set(Some(pool.run(() => { other = "x"; 1 }).unwrap()))
    other.len().toInt() || 0 //~ ERROR `other` is written by a closure that may still be running on another thread
}

async fn keptByEarlierClone() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let s: alloc.Shared[Future[Int]?] = alloc.Shared.new(None)
    let s2 = s.clone()
    s.set(Some(pool.run(() => { other = "x"; 1 }).unwrap()))
    dropShared(s)
    let k = other.len().toInt() || 0 //~ ERROR `other` is written by a closure that may still be running on another thread
    dropShared(s2)
    k
}

async fn keptByEarlierRecord() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let s: alloc.Shared[Future[Int]?] = alloc.Shared.new(None)
    let hd = SHold { s: s.clone() }
    s.set(Some(pool.run(() => { other = "x"; 1 }).unwrap()))
    dropShared(s)
    let k = other.len().toInt() || 0 //~ ERROR `other` is written by a closure that may still be running on another thread
    let kept = hd
    k
}

async fn keptByUpgradedWeak() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let s: alloc.Shared[Future[Int]?] = alloc.Shared.new(None)
    let w = s.downgrade()
    s.set(Some(pool.run(() => { other = "x"; 1 }).unwrap()))
    let s3 = w.upgrade()
    dropShared(s)
    let k = other.len().toInt() || 0 //~ ERROR `other` is written by a closure that may still be running on another thread
    let kept = s3
    k
}

async fn keptByCloneThroughMutRef() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let mut s: alloc.Shared[Future[Int]?] = alloc.Shared.new(None)
    let s2 = s.clone()
    setVia(&mut s, pool.run(() => { other = "x"; 1 }).unwrap())
    dropShared(s)
    let k = other.len().toInt() || 0 //~ ERROR `other` is written by a closure that may still be running on another thread
    dropShared(s2)
    k
}

async fn setByCapturingClosure() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let s: alloc.Shared[Future[Int]?] = alloc.Shared.new(None)
    let put = (h: Future[Int]) => { s.set(Some(h)) }
    put(pool.run(() => { other = "x"; 1 }).unwrap())
    let k = other.len().toInt() || 0 //~ ERROR `other` is written by a closure that may still be running on another thread
    dropShared(s)
    k
}

async fn setByMoveClosureKeptByClone() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let s: alloc.Shared[Future[Int]?] = alloc.Shared.new(None)
    let s2 = s.clone()
    {
        let put = move (h: Future[Int]) => { s.set(Some(h)) }
        put(pool.run(() => { other = "x"; 1 }).unwrap())
    }
    let k = other.len().toInt() || 0 //~ ERROR `other` is written by a closure that may still be running on another thread
    dropShared(s2)
    k
}

async fn setByClosureParam() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let s: alloc.Shared[Future[Int]?] = alloc.Shared.new(None)
    let put = (sh: alloc.Shared[Future[Int]?], h: Future[Int]) => { sh.set(Some(h)) }
    put(s.clone(), pool.run(() => { other = "x"; 1 }).unwrap())
    let k = other.len().toInt() || 0 //~ ERROR `other` is written by a closure that may still be running on another thread
    dropShared(s)
    k
}

async fn setInLoop() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let s: alloc.Shared[Future[Int]?] = alloc.Shared.new(None)
    let mut k = 0
    for i in 0..2 {
        k = k + (other.len().toInt() || 0) //~ ERROR `other` is written by a closure that may still be running on another thread
        s.set(Some(pool.run(() => { other = "x"; 1 }).unwrap())) //~ ERROR `other` is written by a closure that may still be running on another thread
    }
    k
}

async fn droppedInBlock() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    {
        let s: alloc.Shared[Future[Int]?] = alloc.Shared.new(None)
        s.set(Some(pool.run(() => { other = "x"; 1 }).unwrap()))
    }
    other.len().toInt() || 0
}

async fn awaitedBeforeSet() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let s: alloc.Shared[Int?] = alloc.Shared.new(None)
    s.set(Some(await pool.run(() => { other = "x"; 1 }).unwrap()))
    other.len().toInt() || 0
}

async fn setDroppingValue() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let s: alloc.Shared[Int?] = alloc.Shared.new(None)
    s.set(Some(finish(pool.run(() => { other = "x"; 1 }).unwrap())))
    other.len().toInt() || 0
}

async fn helperConsumesShared() -> Int {
    let pool = task.BlockingPool.new(1)
    let mut other = "o"
    let s: alloc.Shared[Future[Int]?] = alloc.Shared.new(None)
    putIn(s, pool.run(() => { other = "x"; 1 }).unwrap())

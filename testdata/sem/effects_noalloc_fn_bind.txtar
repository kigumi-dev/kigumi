-- module --
mir: planned
-- src --
interface Sz {
    noalloc fn isEmpty(self) -> Bool
}

noalloc fn total[T: Sz](x: T) -> Bool {
    x.isEmpty()
}

noalloc fn takes(f: noalloc fn(String) -> Bool, p: String) -> Bool {
    f(p)
}

noalloc fn direct(p: String) -> Bool {
    total(p)
}

noalloc fn viaParam(p: String) -> Bool {
    takes(total[String], p) //~ ERROR binding the witnesses of `total`
}

noalloc fn viaLocal(p: String) -> Bool {
    let f = total[String] //~ ERROR binding the witnesses of `total`
    f(p)
}

fn inferred(p: String) -> Bool {
    takes(total[String], p)
}

noalloc fn callsInferred(p: String) -> Bool {
    inferred(p) //~ ERROR `inferred` is not `noalloc`
}

fn plain(p: String) -> Bool {
    let f = total[String]
    f(p)
}

fn main() -> Void! {
    print "${direct("a")} ${viaParam("b")} ${viaLocal("c")} ${callsInferred("d")} ${plain("e")}"
}

-- module --
mir: planned
-- src --
interface Sz {
    noalloc fn sz(self) -> Bool
}

noalloc fn i64.sz(self) -> Bool { self > 0 }

noalloc fn total[T: Sz](x: T) -> Bool {
    x.sz()
}

noalloc fn takes(f: noalloc fn(Int) -> Bool, p: Int) -> Bool {
    f(p) //~ ERROR a call through a function value receives this `Int` in a box
}

noalloc fn direct(p: Int) -> Bool {
    total(p)
}

noalloc fn viaParam(p: Int) -> Bool {
    takes(total[Int], p) //~ ERROR binding the witnesses of `total`
}

noalloc fn viaLocal(p: Int) -> Bool {
    let f = total[Int] //~ ERROR binding the witnesses of `total`
    f(p) //~ ERROR a call through a function value receives this `Int` in a box
}

fn inferred(p: Int) -> Bool {
    takes(total[Int], p)
}

noalloc fn callsInferred(p: Int) -> Bool {
    inferred(p) //~ ERROR `inferred` is not `noalloc`
}

fn plain(p: Int) -> Bool {
    let f = total[Int]
    f(p)
}

fn main() -> Unit! {
    print "${direct(1)} ${viaParam(2)} ${viaLocal(3)} ${callsInferred(4)} ${plain(5)}"
}

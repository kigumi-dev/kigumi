-- module --
stage: driver
-- src --
import map from std/map

type View['a] = { pub data &'a Bytes, pub off usize }

fn views['a](b: &'a Bytes) -> Array[View['a]] {
    Array.of(View { data: b, off: 0 })
}

fn bytes() -> Bytes {
    Bytes.fromArray(&Array.of(1, 2, 3))
}

fn mapped['a](b: &'a Bytes) -> Unit {
    let mut m: map.Map[Int, View['a]] = map.empty()
    m.set(1, View { data: b, off: 0 })
}

fn viaFnValue() -> usize {
    let buf = bytes()
    let f = views
    let vs = f(&buf)
    vs.len()
}

fn bareRefs() -> usize {
    let buf = bytes()
    let xs = Array.of(&buf)
    xs.len()
}

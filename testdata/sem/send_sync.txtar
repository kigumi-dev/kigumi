-- app/t/t.kg --
import {Shared} from std/alloc
import random from std/random

fn ship[T: Send](x: T) -> Unit {}

fn share[T: Sync](x: &T) -> Unit {}

type Plain = {
    n Int
    name String
}

type Holder = {
    p *const u8
}

// An integer-handle resource is no longer Send/Sync by structural luck; it
// needs a guarantee like Socket below.
type Handle = resource {
    fd Int
}

/// Safety: fd is a plain OS handle with no shared state; moving or sharing it between threads is fine.
@unsafeGuarantee(Send, Sync)
type Socket = resource {
    fd Int
}

fn use(shared: Shared[Int], leaky: Shared[*const u8], plain: Plain, holder: Holder, handle: Handle, socket: Socket, rng: random.Rng, f: fn(Int) -> Int) -> Unit {
    ship(1)
    ship("text")
    ship(plain)
    ship(shared) //~ ERROR `Shared[Int]` does not satisfy `Send`: it cannot move to another thread
    ship(handle) //~ ERROR `Handle` does not satisfy `Send`: it cannot move to another thread
    ship(socket)
    ship(rng)
    ship(Array.of(1, 2))
    ship(Some(plain))
    ship(holder) //~ ERROR `Holder` does not satisfy `Send`: it cannot move to another thread
    ship(leaky) //~ ERROR `Shared[*const u8]` does not satisfy `Send`: it cannot move to another thread
    ship(f) //~ ERROR `fn(Int) -> Int` does not satisfy `Send`: it cannot move to another thread //~ ERROR `f` is a non-escaping callback and cannot be passed to `ship`, whose parameter type cannot be verified not to keep it
    let mut counter = 0
    ship(() => { //~ ERROR does not satisfy `Send`
        counter = counter + 1
    })
    share(&plain)
    share(&shared) //~ ERROR `Shared[Int]` does not satisfy `Sync`: it cannot be shared between threads
    share(&handle) //~ ERROR `Handle` does not satisfy `Sync`: it cannot be shared between threads
    share(&socket)
    share(&rng)
    counter = counter + 1
}


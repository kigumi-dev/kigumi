async fn both(a: &Int, b: &Int) -> Int { a + b }
async fn run() -> Int {
    let x = 1
    let y = 2
    await both(&x, &y) //~ ERROR a borrow cannot be captured by a future
}
type R = resource {
    pub id Int
}
fn R.drop(move self) {}
fn eat(r: R) {}
fn loopMove() {
    let r = R { id: 1 }
    for i in 0..3 {
        eat(r) //~ ERROR `r` was moved in an earlier iteration of the loop
    }
}
fn twice() {
    let r = R { id: 1 }
    eat(r)
    eat(r) //~ ERROR `r` was moved
}

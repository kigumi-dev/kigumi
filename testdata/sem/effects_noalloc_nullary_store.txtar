-- module --
mir: planned
-- src --
type Tick = Up(n: Int) | Flat

type Clock = {
    pub mut tick Tick
}

// A payload-free variant is the one immortal every site reads, so storing it builds no box.
noalloc fn Tick.reset(mut self) {
    self = Flat
}

noalloc fn clear(t: &mut Tick) {
    t = Tick.Flat
}

noalloc fn clearField(c: &mut Clock) {
    c.tick = Flat
}

noalloc fn clearSlot(xs: &mut Array[Tick]) {
    xs[0] = Flat
}


noalloc fn Tick.bump(mut self) {
    self = Up(1) //~ ERROR handing `Tick` to a slot that holds a reference allocates a box for it
}

noalloc fn setUp(t: &mut Tick, n: Int) {
    t = Up(n) //~ ERROR handing `Tick` to a slot that holds a reference allocates a box for it
}

fn main() -> Void! {
    let mut t = Up(3)
    t.reset()
    print "${t is Flat}"
}

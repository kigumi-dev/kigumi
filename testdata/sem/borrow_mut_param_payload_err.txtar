type E = A(Array[Int], Array[Int]) | B(p: Array[Int], q: Array[Int]) | C

fn grab(e: &mut E) {}

fn sameFieldTwice(e: &mut E) {
    match e {
        A(x, _) -> {
            if e is A(z, _) { //~ ERROR `e` is exclusively borrowed //~ ERROR `e` is exclusively borrowed
                z.push(1)
            }
            x.push(2)
        }
        _ -> {}
    }
}

fn reassigned(e: &mut E) {
    if e is B(p, q) {
        e = C //~ ERROR `e` is exclusively borrowed
        p.push(1)
    }
}

fn wholeUse(e: &mut E) {
    if e is A(x, y) {
        grab(e) //~ ERROR `e` is exclusively borrowed
        x.push(1)
    }
}

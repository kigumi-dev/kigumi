-- app/a/a.kg --
pub type Guard = {
    pub mut amount Int
}

fn Guard.grow(mut self, k: Int) {
    self = Guard { amount: k }
}

pub type Pad = {
    pub mut n Int
}

pub fn Pad.grow(mut self, k: Int) {
    self.n = self.n + k
}

pub type Holder['a] = {
    pub mut r &'a mut Pad
}

pub type Swap = {
    pub mut amount Int
}

pub fn Swap.grow(mut self, k: Int) {
    self = Swap { amount: k }
}

pub type SwapHolder['a] = {
    pub mut r &'a mut Swap
}
fn reset(p: &mut Rebound, k: Int) {
    p = Rebound { n: k }
}

pub type Rebound = {
    pub mut n Int
}

pub fn Rebound.grow(mut self, k: Int) {
    reset(&mut self, k)
}

pub type ReboundHolder['a] = {
    pub mut r &'a mut Rebound
}
-- app/b/b.kg --
pub interface Grower {
    fn grow(mut self, k: Int)
}

pub fn growAny[G: Grower](x: &mut G, k: Int) {
    x.grow(k)
}
-- app/c/c.kg --
import a from app/a
import b from app/b

pub fn viaField['x](h: a.Holder['x]) {
    b.growAny(h.r, 1)
}

pub fn viaSwapField['x](h: a.SwapHolder['x]) {
    b.growAny(h.r, 1) //~ ERROR a `&mut` held in a field is lent here
}

pub fn viaReborrow['x](h: a.ReboundHolder['x]) {
    b.growAny(h.r, 1) //~ ERROR a `&mut` held in a field is lent here
}

pub fn viaGuard(g: &mut a.Guard) {
    b.growAny(g, 1) //~ ERROR `Guard` does not satisfy `Grower`
}

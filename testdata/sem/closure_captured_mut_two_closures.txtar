-- app/t/t.kg --
type Item = {
    pub mut count Int
}

fn Item.update(mut self, delta: Int) {
    self.count = self.count + delta
}

fn twoClosures() -> Int {
    let mut item = Item { count: 0 }
    let a = () => { item.update(1) } //~ ERROR a `mut self` call on `item` conflicts
    let b = () => { item.update(2) } //~ ERROR a `mut self` call on `item` conflicts
    a()
    b()
    item.count
}

fn twoClosuresWithReader() -> Int {
    let mut item = Item { count: 0 }
    let bump = () => { item.update(1) }
    let peek = () => item.count
    bump()
    item.count
}

fn nestedThroughOuter() -> Int {
    let mut item = Item { count: 0 }
    let outer = () => {
        let inner = () => { item.update(1) }
        inner()
        inner()
    }
    outer()
    item.count
}

fn aliasThenDirectCall() -> Int {
    let mut item = Item { count: 0 }
    let bump = () => { item.update(1) }
    let peek = () => item.count
    let alias = bump
    alias()
    item.update(1) //~ ERROR a `mut self` call on `item` conflicts
    item.count + peek()
}

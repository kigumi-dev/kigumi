-- app/t/t.kg --
type Item = {
    pub mut count Int
}

fn Item.update(mut self, delta: Int) {
    self.count = self.count + delta
}

fn twoClosures() -> Int {
    let mut item = Item { count: 0 }
    let a = () => { item.update(1) }
    let b = () => { item.update(2) }
    a()
    b()
    item.count
}

// b runs while a's call holds item but only changes that storage, so both writes are kept.
fn oneRunsInsideTheOther() -> Int {
    let mut item = Item { count: 0 }
    let b = () => {
        item.update(2)
        2
    }
    let a = () => { item.update(b()) }
    a()
    item.count
}

fn closureBesideWriter() -> Int {
    let mut item = Item { count: 0 }
    let bump = () => { item.update(1) }
    let reset = () => { item.count = 10 }
    bump()
    reset()
    bump()
    item.count
}

fn twoClosuresWithReader() -> Int {
    let mut item = Item { count: 0 }
    let bump = () => { item.update(1) }
    let peek = () => item.count
    bump()
    item.count
}

fn nestedThroughOuter() -> Int {
    let mut item = Item { count: 0 }
    let outer = () => {
        let inner = () => { item.update(1) }
        inner()
        inner()
    }
    outer()
    item.count
}

fn aliasThenDirectCall() -> Int {
    let mut item = Item { count: 0 }
    let bump = () => { item.update(1) }
    let peek = () => item.count
    let alias = bump
    alias()
    item.update(1)
    item.count + peek()
}
-- expect --

-- module --
stage: driver
-- src --
import cli from std/cli

fn readsWhileRegistering(p: &mut cli.Parser) {
    let mut n: Int = 0
    p.flag("n", &mut n, help: "${n}")
}

fn registersTwice(p: &mut cli.Parser) -> Int {
    let mut n: Int = 0
    p.flag("a", &mut n)
    p.flag("b", &mut n)
    n
}

fn movedBetweenCalls(p: &mut cli.Parser) {
    let mut s = ""
    p.flag("s", &mut s)
    let t = s
    p.arg("t", &mut s)
    let _u = t
}

fn chainReuses(p: cli.Parser) -> cli.Parser {
    let mut n: Int = 0
    p.withFlag("a", &mut n).withFlag("b", &mut n)
}

fn aliasHeld(p: &mut cli.Parser) {
    let mut n: Int = 0
    let r = &mut n
    p.flag("n", &mut n)
    p.flag("m", r)
}

fn useAfter(p: &mut cli.Parser) -> Int {
    let mut port: Int = 80
    p.flag("port", &mut port)
    let doubled = port * 2
    port = doubled
    port
}

fn declaresAfterFinish(mut p: cli.Parser) {
    let mut n: Int = 0
    let _outcome = p.finish()
    p.flag("n", &mut n)
}

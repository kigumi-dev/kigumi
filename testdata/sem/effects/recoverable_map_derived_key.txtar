-- module --
stage: driver
profile: recoverable-only
-- src --
import map from std/map

type Id = { n Int }

// trySet[Id, Int] is specialized and verified; the profile reports the box its key parameter needs.
fn run() -> Result[Void, AllocError] {
    let mut m = map.tryEmpty[Id, Int]()?
    m.trySet(Id { n: 1 }, 2)?
    Ok(())
}

fn main() {
    _ = run()
}

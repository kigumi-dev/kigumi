-- src --
context r: Rec

type Rec = {
    pub mut n Int
    pub mut xs Array[Int]
}

fn Rec.reset(mut self) {
    self = Rec { n: 0, xs: Array.empty() }
}

fn Rec.bump(mut self) {
    self.n = self.n + 1
}

interface Resettable {
    fn reset(mut self)
}

interface Bumpable {
    fn bump(mut self)
}

fn replaceWhole(p: &mut Rec) {
    p.reset()
}

fn viaCall(p: &mut Rec) {
    p.n = 11
    p.reset()
    p.n = 12
}

fn viaGeneric[T: Resettable](p: &mut T) {
    p.reset()
}

fn bumpGeneric[T: Bumpable](p: &mut T) {
    p.bump()
}

fn forward(p: &mut Rec) {
    replaceWhole(p)
}

fn touch(p: &mut Rec) {
    p.n = 1
    p.xs.push(1)
}

type Holder = {
    pub id Int
}

fn Holder.wipe(self, p: &mut Rec) {
    p.reset()
}

@provides(r)
type Env = {
    pub mut r Rec
}

fn callee() {
    replaceWhole(&mut r) //~ ERROR context key `r` cannot be lent with `&mut` to a callee that may replace it as a whole
    viaCall(&mut r) //~ ERROR context key `r` cannot be lent with `&mut` to a callee that may replace it as a whole
    viaGeneric(&mut r) //~ ERROR context key `r` cannot be lent with `&mut` to a callee that may replace it as a whole
    forward(&mut r) //~ ERROR context key `r` cannot be lent with `&mut` to a callee that may replace it as a whole
    Holder { id: 1 }.wipe(&mut r) //~ ERROR context key `r` cannot be lent with `&mut` to a callee that may replace it as a whole
    let f = touch
    f(&mut r) //~ ERROR context key `r` cannot be lent with `&mut` to a callee that may replace it as a whole
    let p = &mut r
    replaceWhole(p) //~ ERROR `p` is a borrow bound to a name
    touch(&mut r)
    bumpGeneric(&mut r)
}

context (Env { r: Rec { n: 3, xs: Array.empty() } }) {
    callee()
    replaceWhole(&mut (r)) //~ ERROR context key `r` cannot be lent with `&mut` to a callee that may replace it as a whole
    touch(&mut r)
}

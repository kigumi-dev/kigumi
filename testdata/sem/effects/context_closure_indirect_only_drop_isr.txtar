-- src --
context tok: Int

@provides(tok)
type Bundle = resource {
    tok Int
}

fn Bundle.drop(move self) {
    _ = "${self.tok}"
}

fn needsTok() -> Int {
    tok
}

export(interrupt) {
    pub fn tick() { //~ ERROR export(interrupt) handler `tick` may allocate or deallocate memory
        context (Bundle { tok: 1 }) {
            let f = () => {
                needsTok()
            }
            _ = f()
        }
    }
}

tick()

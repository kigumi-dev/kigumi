-- lib/fixed.kg --
// An inline array's set is an index store, so it allocates nothing.
noalloc fn setInPlace(n: Int) -> Int {
    let mut a = FixedArray.filled[Int, 8](n)
    let ok = a.set(3, 1)
    if ok { a[3] } else { 0 }
}

// A capture written later makes the local a cell, so set stays a call.
noalloc fn setThroughCell(n: Int) -> Int {
    let mut a = FixedArray.filled[Int, 8](n)
    let ok = a.set(3, 1) //~ ERROR `set` is not `noalloc` //~ ERROR handing `FixedArray[Int, 8]` to a slot that holds a reference allocates a box for it
    let bump = () => { a[0] = 5 } //~ ERROR constructing `closure fn() -> Void` allocates
    bump()
    a[3]
}

// Past a page the array is boxed, so building it is a call that allocates.
noalloc fn boxedFill(n: u8) -> u8 {
    let a = FixedArray.filled[u8, 8192](n) //~ ERROR `filled` is not `noalloc`
    a[1]
}

// at and withMut lend the callback a boxed element, so they allocate even for a scalar element.
noalloc fn atBoxes(n: Int) -> Int {
    let a = FixedArray.filled[Int, 8](n)
    a.at(3, (x: &Int) => x + 1) || 0 //~ ERROR `at` is not `noalloc` //~ ERROR handing `FixedArray[Int, 8]` to a slot that holds a reference allocates a box for it //~ ERROR closure is not `noalloc` (allocates)
}

noalloc fn withMutBoxes(n: Int) -> Int {
    let mut a = FixedArray.filled[Int, 8](n)
    let _ = a.withMut(3, (x: &mut Int) => { x = x + 1 }) //~ ERROR `withMut` is not `noalloc` //~ ERROR handing `FixedArray[Int, 8]` to a slot that holds a reference allocates a box for it //~ ERROR closure is not `noalloc` (allocates)
    a[3]
}

// The ops stay fine in a function that does not claim noalloc.
fn atBoxesFreely(n: Int) -> Int {
    let a = FixedArray.filled[Int, 8](n)
    a.at(3, (x: &Int) => x + 1) || 0
}


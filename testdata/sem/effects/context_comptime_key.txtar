-- module --
stage: driver
-- src --
context port: Int

@provides(port)
type Cfg = {
    pub port Int
}

fn read() -> Int {
    port
}

const viaConst: Int = comptime read() //~ ERROR this `comptime` block requires context key `port`

fn viaFn() -> Int {
    comptime { read() } //~ ERROR this `comptime` block requires context key `port`
}

fn viaParam() -> Int {
    comptime { port + 1 } //~ ERROR this `comptime` block requires context key `port`
}

fn viaLambda() -> Int {
    comptime {
        let f = () => port //~ ERROR this `comptime` block requires context key `port`
        f()
    }
}

fn bound() -> Int {
    comptime {
        context (Cfg { port: 7 }) {
            read() + port
        }
    }
}

context (Cfg { port: 5 }) {
    print "${comptime { port }}" //~ ERROR this `comptime` block requires context key `port`
    let g = () => comptime { read() } //~ ERROR this `comptime` block requires context key `port`
    print "${viaFn()} ${viaParam()} ${viaLambda()} ${bound()} ${g()} ${viaConst}"
}

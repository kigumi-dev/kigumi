import {Box, Shared} from std/alloc

noalloc fn zeros() {
    let _ = Bytes.zeros(3) //~ ERROR `zeros` is not `noalloc`
}

noalloc fn fill() {
    let _ = Bytes.fill(1, 3) //~ ERROR `fill` is not `noalloc`
}

noalloc fn fromArray(raw: &Array[u8]) {
    let _ = Bytes.fromArray(raw) //~ ERROR `fromArray` is not `noalloc`
}

noalloc fn concat(a: Bytes, b: Bytes) {
    let _ = a.concat(b) //~ ERROR `concat` is not `noalloc`
}

noalloc fn slice(a: Bytes) {
    let _ = a.slice(0, 1) //~ ERROR `slice` is not `noalloc`
}

noalloc fn sliceBytes(s: String) {
    let _ = s.sliceBytes(0, 1) //~ ERROR `sliceBytes` is not `noalloc`
}

noalloc fn clone(a: Array[Int]) {
    let _ = a.clone() //~ ERROR `clone` is not `noalloc`
}

noalloc fn sharedNew(n: Int) {
    let _ = Shared.new(n) //~ ERROR `new` is not `noalloc`
}

noalloc fn sharedGet(s: Shared[Int]) {
    let _ = s.get() //~ ERROR `get` is not `noalloc`
}

noalloc fn downgrade(s: Shared[Int]) {
    let _ = s.downgrade() //~ ERROR `downgrade` is not `noalloc`
}

noalloc fn boxNew(n: Int) {
    let _ = Box.new(n) //~ ERROR `new` is not `noalloc`
}


-- lib/poly.kg --
type App = {
    pub view pure? fn(Int) -> Int
}

pure fn pureView(x: Int) -> Int {
    x + 1
}

fn plainView(x: Int) -> Int {
    x + 1
}

pure fn withPureView() -> Int {
    let app = App { view: pureView }
    app.view(1)
}

pure fn withPlainView() -> Int {
    let app = App { view: plainView }
    app.view(1) //~ ERROR `app.view` may be impure
}

// app is a parameter: withParam is polymorphic in its `view` field, so a caller's
// own actual argument decides purity, not this body.
pure fn withParam(app: App) -> Int {
    app.view(1)
}

fn callWithImpure() -> Int {
    withParam(App { view: plainView })
}

pure fn callWithImpureFromPure() -> Int {
    withParam(App { view: plainView }) //~ ERROR `App { view: plainView` may be impure
}

// useApp is a plain fn deferring its own purity to the caller's argument, same as
// withParam but undeclared: erasing it to a fixed `pure fn` has no argument left to resolve against.
fn useApp(app: App, x: Int) -> Int {
    app.view(x)
}

fn erasedFieldParam() -> Int {
    let g: pure fn(App, Int) -> Int = useApp //~ ERROR `useApp` is not `pure` (calls `app.view`)
    g(App { view: plainView }, 1)
}

// outerHop/innerHop forward `app` through a second function declared, and so
// body-checked, after the caller: forwarding must not depend on check order.
pure fn callChainWithImpure(x: Int) -> Int {
    outerHop(App { view: plainView }, x) //~ ERROR `App { view: plainView` may be impure
}

fn outerHop(app: App, x: Int) -> Int {
    innerHop(app, x)
}

fn innerHop(app: App, x: Int) -> Int {
    app.view(x)
}

pure fn callChainWithPure(x: Int) -> Int {
    outerHop(App { view: pureView }, x)
}

// overloadHop/relayOverload is callChainWithImpure's shape again, but the inner
// call's target name is overloaded: the pre-pass must not drop the edge outright.
pure fn callChainOverload(x: Int) -> Int {
    overloadHop(App { view: plainView }, x) //~ ERROR `App { view: plainView` may be impure
}

fn overloadHop(app: App, x: Int) -> Int {
    relayOverload(app, x)
}

fn relayOverload(app: App, x: Int) -> Int {
    app.view(x)
}

fn relayOverload(s: String) -> Int {
    0
}

pure fn callChainOverloadWithPure(x: Int) -> Int {
    overloadHop(App { view: pureView }, x)
}

// sameArityRelay's two overloads share one arity, unlike relayOverload: the pre-pass
// must filter by the forwarded argument's declared type, not arity alone.
fn sameArityRelay(a: App, x: Int) -> Int {
    a.view(x)
}

fn sameArityRelay(s: String, x: Int) -> Int {
    x
}

fn sameArityHopString(s: String, x: Int) -> Int {
    sameArityRelay(s, x)
}

fn sameArityHopApp(a: App, x: Int) -> Int {
    sameArityRelay(a, x)
}

pure fn callSameArityOverloadString(x: Int) -> Int {
    sameArityHopString("s", x)
}

pure fn callSameArityOverloadAppImpure(x: Int) -> Int {
    sameArityHopApp(App { view: plainView }, x) //~ ERROR `App { view: plainView` may be impure
}

pure fn callSameArityOverloadAppPure(x: Int) -> Int {
    sameArityHopApp(App { view: pureView }, x)
}

// multiParamRelay's two overloads share the forwarded position's type and differ
// only at mode: the per-position filter must not ignore mode's own declared type.
fn multiParamRelay(a: App, mode: Bool) -> Int {
    a.view(1)
}

fn multiParamRelay(a: App, mode: Int) -> Int {
    mode
}

fn multiParamHop(a: App, mode: Int) -> Int {
    multiParamRelay(a, mode)
}

pure fn callMultiParamHop(x: Int) -> Int {
    multiParamHop(App { view: plainView }, x)
}

fn multiParamHopBool(a: App, mode: Bool) -> Int {
    multiParamRelay(a, mode)
}

pure fn callMultiParamHopBoolRejected(x: Int) -> Int {
    multiParamHopBool(App { view: plainView }, true) //~ ERROR `App { view: plainView` may be impure
}

// literalParamHopBool/literalParamHopInt repeat the multiParamHop shape, but mode
// is a literal at the call site: the filter must type the literal itself, not only identifiers.
fn literalParamHopBool(a: App) -> Int {
    multiParamRelay(a, true)
}

pure fn callLiteralParamHopBoolRejected(x: Int) -> Int {
    literalParamHopBool(App { view: plainView }) //~ ERROR `App { view: plainView` may be impure
}

fn literalParamHopInt(a: App) -> Int {
    multiParamRelay(a, 1)
}

pure fn callLiteralParamHopIntAccepted(x: Int) -> Int {
    literalParamHopInt(App { view: plainView })
}

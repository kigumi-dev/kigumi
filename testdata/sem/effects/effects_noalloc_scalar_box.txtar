fn twice(x: Int) -> Int { x * 2 }

fn even(x: Int) -> Bool { x % 2 == 0 }

noalloc fn intResult(f: noalloc fn() -> Int) -> Int {
    f() //~ ERROR the `Int` it returns arrives in a box
}

noalloc fn floatResult(f: noalloc fn() -> Float) -> Float {
    f() //~ ERROR the `Float` it returns arrives in a box
}

noalloc fn charResult(f: noalloc fn() -> Char) -> Char {
    f() //~ ERROR the `Char` it returns arrives in a box
}

noalloc fn byteResult(f: noalloc fn() -> u8) -> u8 {
    f()
}

// Bool and Void boxes are immortals.
noalloc fn boolResult(f: noalloc fn() -> Bool) -> Bool {
    f()
}

noalloc fn unitResult(f: noalloc fn() -> Void) {
    f()
}

noalloc fn intArgument(f: noalloc fn(Int) -> Bool, x: Int) -> Bool {
    f(x)
}

// A literal argument is handed over as its immortal.
noalloc fn literalArgument(f: noalloc fn(Int) -> Bool) -> Bool {
    f(7)
}

noalloc fn itemValue() -> Bool {
    let f = twice //~ ERROR `twice` returns `Int` unboxed
    let g: noalloc fn(Int) -> Bool = even
    g(4)
}

fn inferred(f: fn(Int) -> Int, x: Int) -> Int { f(x) }

noalloc fn callsInferred() -> Int {
    inferred(twice, 3) //~ ERROR `inferred` is not `noalloc` //~ ERROR `twice` returns `Int` unboxed
}

fn main() -> Void! {}

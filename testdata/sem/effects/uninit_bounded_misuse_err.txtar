-- src --
import mem from std/mem
import array from std/array

type Res = resource {
    pub id Int
}

fn Res.drop(move self) {
    let _ = self.id
}

fn unsafe_outside(s: &mut mem.Uninit[Int]) -> Int {
    mem.initialize(s, 1) //~ ERROR calling `initialize` requires an `unsafe { }` block
    mem.takeInitialized(s) //~ ERROR calling `takeInitialized` requires an `unsafe { }` block
}

fn borrow_outside(s: &mem.Uninit[Int]) {
    let r = mem.borrowInitialized(s) //~ ERROR calling `borrowInitialized` requires an `unsafe { }` block
    let _ = r
}

fn drop_outside(s: &mut mem.Uninit[Res]) {
    mem.dropInitialized(s) //~ ERROR calling `dropInitialized` requires an `unsafe { }` block
}

fn wrong_value(s: &mut mem.Uninit[Int]) {
    unsafe {
        mem.initialize(s, "text") //~ ERROR expected `Int`, found `String`
    }
}

fn private_slots(b: &array.BoundedArray[Int, 2]) {
    let _ = b.slots //~ ERROR
}

fn wrong_capacity(a: array.BoundedArray[Int, 2]) -> array.BoundedArray[Int, 3] {
    a //~ ERROR expected `BoundedArray[Int, 3]`, found `BoundedArray[Int, 2]`
}

fn index_move_only(b: &array.BoundedArray[Res, 2]) -> Res {
    b[0] //~ ERROR
}

fn get_move_only(b: &array.BoundedArray[Res, 2]) {
    let _ = b.get(0) //~ ERROR
}

fn ignore_full(b: &mut array.BoundedArray[Int, 2]) {
    b.tryPush(1) //~ ERROR unused
}

fn push_wrong(b: &mut array.BoundedArray[Int, 2]) {
    let _ = b.tryPush("x") //~ ERROR expected `Int`, found `String`
}
noalloc fn make_slot() {
    let _ = mem.uninit[Int]() //~ ERROR `uninit` needs the allocator
}

noalloc fn make_array() {
    let _ = array.BoundedArray.new[Int, 2]() //~ ERROR `new` needs the allocator
}

noalloc fn push_pop(b: &mut array.BoundedArray[Int, 2], v: Int) -> Int {
    _ = b.tryPush(v) //~ ERROR `tryPush` needs the allocator
    b.pop() || 0 //~ ERROR `pop` needs the allocator
}

noalloc fn read(b: &array.BoundedArray[Int, 2]) -> Int {
    (b.get(0) || 0) + b[1] //~ ERROR `get` needs the allocator //~ ERROR `index` needs the allocator
}

noalloc fn no_storage(b: &array.BoundedArray[Int, 2], s: &mut mem.Uninit[Int], owned: array.BoundedArray[Int, 2]) -> usize {
    unsafe {
        mem.initialize(s, 4)
        mem.dropInitialized(s)
    }
    let _ = owned
    b.len() + b.capacity()
}

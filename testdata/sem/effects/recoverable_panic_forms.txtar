-- module --
mir: planned
profile: recoverable-only
-- src --
import {Box, Shared} from std/alloc


export(C) {
    pub fn lib_zeros(n: i64) -> i64 {
        let _ = Bytes.zeros(3) //~ ERROR `zeros`
        n
    }

    pub fn lib_fill(n: i64) -> i64 {
        let _ = Bytes.fill(1, 3) //~ ERROR `fill`
        n
    }

    pub fn lib_from_array(n: i64) -> i64 {
        let raw = Array.tryFill[u8](1, 2) || return n
        let _ = Bytes.fromArray(&raw) //~ ERROR `fromArray`
        n
    }

    pub fn lib_concat(n: i64) -> i64 {
        let part = Bytes.tryZeros(2) || return n
        let _ = part.concat(part) //~ ERROR `concat`
        n
    }

    pub fn lib_slice(n: i64) -> i64 {
        let part = Bytes.tryZeros(2) || return n
        let _ = part.slice(0, 1) //~ ERROR `slice`
        n
    }

    pub fn lib_slice_bytes(n: i64) -> i64 {
        let _ = "text".sliceBytes(0, 1) //~ ERROR `sliceBytes`
        n
    }

    pub fn lib_clone(n: i64) -> i64 {
        let items = Array.tryFill(n, 2) || return n
        let _ = items.clone() //~ ERROR `clone`
        n
    }

    pub fn lib_shared_new(n: i64) -> i64 {
        let _ = Shared.new(n) //~ ERROR `new`
        n
    }

    pub fn lib_shared_get(n: i64) -> i64 {
        let cell = Shared.tryNew(n) || return n
        cell.get() //~ ERROR `get`
    }

    pub fn lib_downgrade(n: i64) -> i64 {
        let cell = Shared.tryNew(n) || return n
        let _ = cell.downgrade() //~ ERROR `downgrade`
        n
    }

    pub fn lib_box_new(n: i64) -> i64 {
        let b = Box.new(n) //~ ERROR `new`
        b.into()
    }
}

fn main() -> Void! {}

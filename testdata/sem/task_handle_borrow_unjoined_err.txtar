-- module --
mir: planned
-- src --
// A Task handle keeps the borrows of the future it runs until it is joined. Each body below lets one go unjoined: it
// drops a value holding the handle, or hands it to a callee that drops it or keeps it in a task it does not join.
import task from std/task

type Box = { pub n Int, pub mut t task.Task[Int] }
type Job = { pub f Future[Int] }
type Runner = { pub run fn(Future[Int]) -> Void }

async fn leaf() -> Int { 1 }

async fn count(xs: &Array[Int]) -> Int {
    await task.yieldNow()
    xs.len().toInt() || 0
}

fn sink[T](t: task.Task[T]) {}

fn go(f: Future[Int]) {
    _ = task.spawn(f)
}

async fn keep(t: task.Task[Int]) -> Int {
    0
}

async fn maybe(f: Future[Int], b: Bool) -> Int {
    let t = task.spawn(f)
    if b {
        return await t
    }
    0
}

fn runJob(j: Job) {
    _ = task.spawn(j.f)
}

async fn inRecord() -> Int {
    let xs = Array.of(1)
    let b = Box { n: 1, t: task.spawn(count(&xs)) } //~ ERROR a spawned task outlives this borrow
    _ = b
    0
}

async fn overwritten() -> Int {
    let xs = Array.of(1)
    let mut b = Box { n: 1, t: task.spawn(count(&xs)) } //~ ERROR a spawned task outlives this borrow
    b.t = task.spawn(leaf())
    await b.t
}

async fn inOption() -> Int {
    let xs = Array.of(1)
    let o = Some(task.spawn(count(&xs))) //~ ERROR a spawned task outlives this borrow
    0
}

async fn inArray() -> Int {
    let xs = Array.of(1)
    let ts = Array.of(task.spawn(count(&xs))) //~ ERROR a spawned task outlives this borrow //~ ERROR a borrow cannot go in element 0
    0
}

async fn cancelled() -> Int {
    let xs = Array.of(1)
    let t = task.spawn(count(&xs)) //~ ERROR a spawned task outlives this borrow
    t.cancel()
    0
}

async fn sunk() -> Int {
    let xs = Array.of(1)
    sink(task.spawn(count(&xs))) //~ ERROR a spawned task outlives this borrow
    0
}

async fn spawnedByCallee() -> Int {
    let xs = Array.of(1)
    go(count(&xs)) //~ ERROR a task the callee spawns from this argument
    0
}

async fn droppedByAsyncCallee() -> Int {
    let xs = Array.of(1)
    await keep(task.spawn(count(&xs))) //~ ERROR a spawned task outlives this borrow
}

async fn droppedByChild() -> Int {
    let xs = Array.of(1)
    let t = task.spawn(count(&xs)) //~ ERROR a spawned task outlives this borrow
    await task.spawn(keep(t))
}

async fn joinedOnOnePath() -> Int {
    let xs = Array.of(1)
    await maybe(count(&xs), true) //~ ERROR a task the callee spawns from this argument
}

async fn inJob() -> Int {
    let xs = Array.of(1)
    runJob(Job { f: count(&xs) }) //~ ERROR a task the callee spawns from this argument
    0
}

async fn viaFnValue() -> Int {
    let xs = Array.of(1)
    let s = sink[Int]
    s(task.spawn(count(&xs))) //~ ERROR a spawned task outlives this borrow
    let g = go
    g(count(&xs)) //~ ERROR a task the callee spawns from this argument
    0
}

async fn viaUnknown(r: Runner) -> Int {
    let xs = Array.of(1)
    (r.run)(count(&xs)) //~ ERROR a value borrowing `xs` cannot go into shared storage
    0
}

fn pick() -> fn(Future[Int]) -> Void {
    go
}

async fn viaResult() -> Int {
    let xs = Array.of(1)
    pick()(count(&xs)) //~ ERROR a task the callee spawns from this argument //~ ERROR a value borrowing `xs` cannot go into shared storage
    0
}

fn returned() -> task.Task[Int] {
    let xs = Array.of(1) //~ ERROR `xs` is still borrowed when its scope ends here
    task.spawn(count(&xs)) //~ ERROR a borrow cannot be returned
}

fn main() {}

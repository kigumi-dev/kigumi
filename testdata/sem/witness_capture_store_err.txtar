-- module --
mir: planned
-- src --
interface FromRef[K] { fn fromRef(k: &K) -> Self }
type View['a] = { pub s &'a String }
fn View['a].fromRef(k: &'a String) -> View['a] { View { s: k } }
fn apply[V](g: fn(V) -> Void, x: V) { g(x) }
fn addVia[K, V: FromRef[K]](dst: &mut Array[V], k: &K) {
    apply((y: V) => { dst.push(y) }, V.fromRef(k)) //~ ERROR borrow cannot be stored
}
fn ownLocal[K, V: FromRef[K]](dst: &mut Array[V], k: K) { addVia(dst, &k) }
fn go() {
    let name = "named"
    let mut xs = Array.of(View { s: &name })
    ownLocal(&mut xs, "gone-${1}")
    print "${xs.len()}"
}
go()

-- app/t/t.kg --
import task from std/task

async fn inner() -> Int {
    0
}

async fn nestedRoot() -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(inner()) //~ ERROR cannot run inside an `async fn`
}

fn syncRoot() -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(inner())
}

fn bridgeHop() -> Int {
    syncRoot()
}

async fn indirectRoot() -> Int {
    bridgeHop() //~ ERROR cannot run inside an `async fn`
}

async fn closureRoot() -> Int {
    let drive = () => syncRoot()
    drive() //~ ERROR cannot run inside an `async fn`
}

fn hopA(n: Int) -> Int {
    if n <= 0 { syncRoot() } else { hopB(n - 1) }
}

fn hopB(n: Int) -> Int {
    hopA(n - 1)
}

async fn recursiveRoot() -> Int {
    hopA(3) //~ ERROR cannot run inside an `async fn`
}

fn forward(cb: fn() -> Int) -> Int {
    cb()
}

async fn paramRoot(cb: fn() -> Int) -> Int {
    forward(cb) //~ ERROR cannot run inside an `async fn`
}

async fn paramDirect(cb: fn() -> Int) -> Int {
    cb() //~ ERROR cannot run inside an `async fn`
}

type Holder = {
    cb fn() -> Int
}

fn callField(h: Holder) -> Int {
    h.cb()
}

async fn fieldRoot(h: Holder) -> Int {
    callField(h) //~ ERROR cannot run inside an `async fn`
}

interface Driver {
    fn drive(self) -> Int
}

type Direct = {
    pub n Int
}

fn Direct.drive(self) -> Int {
    syncRoot()
}

fn callDyn(d: Driver) -> Int {
    d.drive()
}

async fn ifaceRoot() -> Int {
    let d: Driver = Direct { n: 7 }
    callDyn(d) //~ ERROR cannot run inside an `async fn`
}

interface Calc {
    fn value(self) -> Int
}

type SafeCalc = {
    pub n Int
}

fn SafeCalc.value(self) -> Int {
    self.n
}

type RiskyCalc = {
    pub n Int
}

fn RiskyCalc.value(self) -> Int {
    syncRoot()
}

fn callCalc(c: Calc) -> Int {
    c.value()
}

// callCalc is shared with unrelatedRiskyCalc; safeIfaceCall's own receiver
// never holds RiskyCalc, so it must still compile clean.
async fn safeIfaceCall() -> Int {
    let c: Calc = SafeCalc { n: 1 }
    callCalc(c)
}

fn unrelatedRiskyCalc() -> Int {
    let c: Calc = RiskyCalc { n: 2 }
    callCalc(c)
}

fn callCalcInner(c: Calc) -> Int {
    c.value()
}

fn callCalcOuter(c: Calc) -> Int {
    callCalcInner(c)
}

// callCalcOuter forwards c through callCalcInner, two hops from the
// receiver to the interface call; narrowing must follow the whole chain.
async fn safeTwoHop() -> Int {
    let c: Calc = SafeCalc { n: 3 }
    callCalcOuter(c)
}

async fn riskyTwoHop() -> Int {
    let c: Calc = RiskyCalc { n: 4 }
    callCalcOuter(c) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedRiskyTwoHop() -> Int {
    let c: Calc = RiskyCalc { n: 5 }
    callCalcOuter(c)
}

fn callCalcOuterOuter(c: Calc) -> Int {
    callCalcOuter(c)
}

async fn safeThreeHop() -> Int {
    let c: Calc = SafeCalc { n: 6 }
    callCalcOuterOuter(c)
}

async fn riskyThreeHop() -> Int {
    let c: Calc = RiskyCalc { n: 7 }
    callCalcOuterOuter(c) //~ ERROR cannot run inside an `async fn`
}

fn mutA(c: Calc) -> Int {
    if c.value() > 0 { mutB(c) } else { 0 }
}

fn mutB(c: Calc) -> Int {
    mutA(c)
}

// mutA and mutB forward c to each other; narrowing must not loop forever
// chasing that cycle, and must not let it leak the global union either.
async fn safeMutRoot() -> Int {
    let c: Calc = SafeCalc { n: 8 }
    mutA(c)
}

async fn riskyMutRoot() -> Int {
    let c: Calc = RiskyCalc { n: 9 }
    mutA(c) //~ ERROR cannot run inside an `async fn`
}

type Box = {
    c Calc
}

// b.c.value() reads the receiver back out of a record literal instead of a
// bare identifier; narrowing must still see through to c's own witness.
fn callCalcField(c: Calc) -> Int {
    let b = Box { c: c }
    b.c.value()
}

async fn safeFieldCall() -> Int {
    let c: Calc = SafeCalc { n: 10 }
    callCalcField(c)
}

async fn riskyFieldCall() -> Int {
    let c: Calc = RiskyCalc { n: 11 }
    callCalcField(c) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedRiskyFieldCall() -> Int {
    let c: Calc = RiskyCalc { n: 12 }
    callCalcField(c)
}

// run() reads c through a closure capture instead of a direct call;
// narrowing must still see through to c's own witness.
fn callCalcClosure(c: Calc) -> Int {
    let run = () => c.value()
    run()
}

async fn safeClosureCall() -> Int {
    let c: Calc = SafeCalc { n: 13 }
    callCalcClosure(c)
}

async fn riskyClosureCall() -> Int {
    let c: Calc = RiskyCalc { n: 14 }
    callCalcClosure(c) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedRiskyClosureCall() -> Int {
    let c: Calc = RiskyCalc { n: 15 }
    callCalcClosure(c)
}

async fn capturedRoot() -> Int {
    let g = syncRoot
    let run = () => g()
    run() //~ ERROR cannot run inside an `async fn`
}

interface Witness2 {
    fn m(self) -> Int
}

type Shallow = {
    pub n Int
}

fn Shallow.m(self) -> Int {
    syncRoot()
}

type Deep = {
    pub n Int
}

fn deepHelper1() -> Int {
    deepHelper2()
}

fn deepHelper2() -> Int {
    deepHelper3()
}

fn deepHelper3() -> Int {
    syncRoot()
}

fn Deep.m(self) -> Int {
    deepHelper1()
}

fn callWitness2(w: Witness2) -> Int {
    w.m()
}

async fn deepWitnessRoot() -> Int {
    let w: Witness2 = Deep { n: 1 }
    callWitness2(w) //~ ERROR cannot run inside an `async fn`
}

fn useShallowWitness() -> Int {
    let w: Witness2 = Shallow { n: 2 }
    callWitness2(w)
}

fn callFnBound[F: Fn[fn() -> Int]](f: F) -> Int {
    f()
}

async fn fnBoundNamedRoot() -> Int {
    callFnBound(syncRoot) //~ ERROR cannot run inside an `async fn`
}

async fn fnBoundClosureRoot() -> Int {
    callFnBound(() => syncRoot()) //~ ERROR cannot run inside an `async fn`
}

async fn fnBoundCaptureRoot() -> Int {
    let n = 1
    callFnBound(() => n + syncRoot()) //~ ERROR cannot run inside an `async fn`
}

fn safeFnBoundValue() -> Int {
    41
}

// callFnBoundSafe is its own instantiation rather than sharing callFnBound's
// f; fnBoundSharedSafeRoot below shares callFnBound directly instead.
fn callFnBoundSafe[F: Fn[fn() -> Int]](f: F) -> Int {
    f()
}

async fn fnBoundSafeRoot() -> Int {
    callFnBoundSafe(() => safeFnBoundValue())
}

fn callFnBoundForward[G: Fn[fn() -> Int]](g: G) -> Int {
    callFnBound(g)
}

// callFnBoundForward forwards g through its own Fn-bound parameter into
// callFnBound's; narrowing must follow both generic hops.
async fn fnBoundTwoHopRoot() -> Int {
    callFnBoundForward(() => syncRoot()) //~ ERROR cannot run inside an `async fn`
}

fn callFnBoundForwardSafe[G: Fn[fn() -> Int]](g: G) -> Int {
    callFnBoundSafe(g)
}

async fn fnBoundTwoHopSafeRoot() -> Int {
    callFnBoundForwardSafe(() => safeFnBoundValue())
}

// forwardSubst's EdgeFnBoundArg case narrows callFnBound (and, through it,
// callFnBoundForward) per call site, so a safe caller can finally share
// them directly with fnBoundNamedRoot/fnBoundTwoHopRoot above.
async fn fnBoundSharedSafeRoot() -> Int {
    callFnBound(() => safeFnBoundValue())
}

async fn fnBoundSharedTwoHopSafeRoot() -> Int {
    callFnBoundForward(() => safeFnBoundValue())
}

type MutHolder = {
    mut cb fn() -> Int
}

fn callMutField(h: MutHolder) -> Int {
    h.cb()
}

// A field reassigned after construction joins the known set (safe) or
// poisons it to the global union (risky), the same as a fresh literal.
async fn safeFieldReassign() -> Int {
    let mut h = MutHolder { cb: safeFnBoundValue }
    h.cb = safeFnBoundValue
    callMutField(h)
}

async fn riskyFieldReassign() -> Int {
    let mut h = MutHolder { cb: safeFnBoundValue }
    h.cb = syncRoot
    callMutField(h) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedRiskyFieldReassign() -> Int {
    let mut h = MutHolder { cb: safeFnBoundValue }
    h.cb = syncRoot
    callMutField(h)
}

type MutBox = {
    mut c Calc
}

fn callMutBoxField(b: MutBox) -> Int {
    b.c.value()
}

// Same as above, for an interface-typed field's witness set instead of a
// fn value's knownFieldFn.
async fn safeWitnessReassign() -> Int {
    let mut b = MutBox { c: SafeCalc { n: 20 } }
    let c: Calc = SafeCalc { n: 21 }
    b.c = c
    callMutBoxField(b)
}

async fn riskyWitnessReassign() -> Int {
    let mut b = MutBox { c: SafeCalc { n: 22 } }
    let c: Calc = RiskyCalc { n: 23 }
    b.c = c
    callMutBoxField(b) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedRiskyWitnessReassign() -> Int {
    let mut b = MutBox { c: SafeCalc { n: 24 } }
    let c: Calc = RiskyCalc { n: 25 }
    b.c = c
    callMutBoxField(b)
}

// A whole-value reassignment (`b = MutBox{...}`), not a per-field write,
// re-registers the new literal's own fields instead of leaving the field
// poisoned forever.
async fn safeWholeValueReassign() -> Int {
    let mut b = MutBox { c: SafeCalc { n: 40 } }
    b = MutBox { c: SafeCalc { n: 41 } }
    callMutBoxField(b)
}

async fn riskyWholeValueReassign() -> Int {
    let mut b = MutBox { c: SafeCalc { n: 42 } }
    b = MutBox { c: RiskyCalc { n: 43 } }
    callMutBoxField(b) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedRiskyWholeValueReassign() -> Int {
    let mut b = MutBox { c: SafeCalc { n: 44 } }
    b = MutBox { c: RiskyCalc { n: 45 } }
    callMutBoxField(b)
}

type FieldOuter = {
    c Calc
}

fn callFieldOuter(o: FieldOuter) -> Int {
    o.c.value()
}

// An interface-typed field crossing a plain-fn call boundary (passed by
// value): the callee's own field-param entity narrows per call site too.
async fn safeOuterFieldCall() -> Int {
    let c: Calc = SafeCalc { n: 30 }
    callFieldOuter(FieldOuter { c: c })
}

async fn riskyOuterFieldCall() -> Int {
    let c: Calc = RiskyCalc { n: 31 }
    callFieldOuter(FieldOuter { c: c }) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedRiskyOuterFieldCall() -> Int {
    let c: Calc = RiskyCalc { n: 32 }
    callFieldOuter(FieldOuter { c: c })
}

fn callFieldOuterRef(o: &FieldOuter) -> Int {
    o.c.value()
}

// Same, passed by reference instead of by value.
async fn safeOuterFieldRefCall() -> Int {
    let c: Calc = SafeCalc { n: 33 }
    let o = FieldOuter { c: c }
    callFieldOuterRef(&o)
}

async fn riskyOuterFieldRefCall() -> Int {
    let c: Calc = RiskyCalc { n: 34 }
    let o = FieldOuter { c: c }
    callFieldOuterRef(&o) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedRiskyOuterFieldRefCall() -> Int {
    let c: Calc = RiskyCalc { n: 35 }
    let o = FieldOuter { c: c }
    callFieldOuterRef(&o)
}

type FieldWrap = {
    inner FieldOuter
}

fn callFieldTwoHop(w: FieldWrap) -> Int {
    w.inner.c.value()
}

// Two field hops crossing the call boundary: w.inner.c, not w.c.
async fn safeFieldTwoHop() -> Int {
    let c: Calc = SafeCalc { n: 36 }
    callFieldTwoHop(FieldWrap { inner: FieldOuter { c: c } })
}

async fn riskyFieldTwoHop() -> Int {
    let c: Calc = RiskyCalc { n: 37 }
    callFieldTwoHop(FieldWrap { inner: FieldOuter { c: c } }) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedRiskyFieldTwoHop() -> Int {
    let c: Calc = RiskyCalc { n: 38 }
    callFieldTwoHop(FieldWrap { inner: FieldOuter { c: c } })
}

// A non-mut local's field set straight from a record literal, not an ident:
// fieldChainEnt can't trace it, so this needs its own CoerceWitness lookup.
async fn safeOneHopLiteralField() -> Int {
    let o = FieldOuter { c: SafeCalc { n: 50 } }
    callFieldOuter(o)
}

async fn riskyOneHopLiteralField() -> Int {
    let o = FieldOuter { c: RiskyCalc { n: 51 } }
    callFieldOuter(o) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedRiskyOneHopLiteralField() -> Int {
    let o = FieldOuter { c: RiskyCalc { n: 52 } }
    callFieldOuter(o)
}

// Same gap, two field hops deep: the leaf is a literal, not an ident.
async fn safeTwoHopLiteralField() -> Int {
    callFieldTwoHop(FieldWrap { inner: FieldOuter { c: SafeCalc { n: 53 } } })
}

async fn riskyTwoHopLiteralField() -> Int {
    callFieldTwoHop(FieldWrap { inner: FieldOuter { c: RiskyCalc { n: 54 } } }) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedRiskyTwoHopLiteralField() -> Int {
    callFieldTwoHop(FieldWrap { inner: FieldOuter { c: RiskyCalc { n: 55 } } })
}

// A `mut self` method's own field write must bind back to the caller's
// receiver, not just the method's own self parameter.
fn MutHolder.setCb(mut self, f: escaping fn() -> Int) -> Unit {
    self.cb = f
}

async fn safeSetterCall() -> Int {
    let mut h = MutHolder { cb: safeFnBoundValue }
    h.setCb(safeFnBoundValue)
    callMutField(h)
}

async fn riskySetterCall() -> Int {
    let mut h = MutHolder { cb: safeFnBoundValue }
    h.setCb(syncRoot)
    callMutField(h) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedRiskySetterCall() -> Int {
    let mut h = MutHolder { cb: safeFnBoundValue }
    h.setCb(syncRoot)
    callMutField(h)
}

// Same setter, reached through a `&mut` parameter instead of a bare local.
fn setAndReadRefSafe(mut h: &mut MutHolder) -> Int {
    h.setCb(safeFnBoundValue)
    h.cb()
}

fn setAndReadRefRisky(mut h: &mut MutHolder) -> Int {
    h.setCb(syncRoot)
    h.cb()
}

async fn safeSetterRefCall() -> Int {
    let mut h = MutHolder { cb: safeFnBoundValue }
    setAndReadRefSafe(&mut h)
}

async fn riskySetterRefCall() -> Int {
    let mut h = MutHolder { cb: safeFnBoundValue }
    setAndReadRefRisky(&mut h) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedRiskySetterRefCall() -> Int {
    let mut h = MutHolder { cb: safeFnBoundValue }
    setAndReadRefRisky(&mut h)
}

// setCbChainSafe/Risky call setCb on their own self: the summary must compose.
fn MutHolder.setCbChainSafe(mut self) -> Unit {
    self.setCb(safeFnBoundValue)
}

fn MutHolder.setCbChainRisky(mut self) -> Unit {
    self.setCb(syncRoot)
}

async fn safeSetterChainCall() -> Int {
    let mut h = MutHolder { cb: safeFnBoundValue }
    h.setCbChainSafe()
    callMutField(h)
}

async fn riskySetterChainCall() -> Int {
    let mut h = MutHolder { cb: safeFnBoundValue }
    h.setCbChainRisky()
    callMutField(h) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedRiskySetterChainCall() -> Int {
    let mut h = MutHolder { cb: safeFnBoundValue }
    h.setCbChainRisky()
    callMutField(h)
}

// A setter's argument that isn't ident/literal-resolvable poisons the field
// to the global union, same as an unresolved direct write.
fn MutBox.setC(mut self, c: Calc) -> Unit {
    self.c = c
}

fn unknownCalc() -> Calc {
    SafeCalc { n: 60 }
}

async fn unknownSetterCall() -> Int {
    let mut b = MutBox { c: SafeCalc { n: 61 } }
    b.setC(unknownCalc())
    callMutBoxField(b) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedUnknownSetterCall() -> Int {
    let mut b = MutBox { c: SafeCalc { n: 62 } }
    b.setC(unknownCalc())
    callMutBoxField(b)
}

// A setter's argument passed as a bare record literal, not through an ident:
// the same call site is revisited every closeMethodFieldWrites pass, so it must resolve the same way each time.
async fn safeLiteralSetterCall() -> Int {
    let mut b = MutBox { c: SafeCalc { n: 70 } }
    b.setC(SafeCalc { n: 71 })
    callMutBoxField(b)
}

async fn riskyLiteralSetterCall() -> Int {
    let mut b = MutBox { c: SafeCalc { n: 72 } }
    b.setC(RiskyCalc { n: 73 })
    callMutBoxField(b) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedRiskyLiteralSetterCall() -> Int {
    let mut b = MutBox { c: SafeCalc { n: 74 } }
    b.setC(RiskyCalc { n: 75 })
    callMutBoxField(b)
}

type NestBox = {
    mut inner MutBox
}

fn callNestBoxField(o: NestBox) -> Int {
    o.inner.c.value()
}

// A setter called on a nested field receiver (`o.inner.setC(...)`), not a
// bare local: the receiver must resolve through the same field-chain lookup a read uses.
async fn safeNestedSetterCall() -> Int {
    let mut o = NestBox { inner: MutBox { c: SafeCalc { n: 76 } } }
    o.inner.setC(SafeCalc { n: 77 })
    callNestBoxField(o)
}

async fn riskyNestedSetterCall() -> Int {
    let mut o = NestBox { inner: MutBox { c: SafeCalc { n: 78 } } }
    o.inner.setC(RiskyCalc { n: 79 })
    callNestBoxField(o) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedRiskyNestedSetterCall() -> Int {
    let mut o = NestBox { inner: MutBox { c: SafeCalc { n: 80 } } }
    o.inner.setC(RiskyCalc { n: 81 })
    callNestBoxField(o)
}

type GBox[T] = {
    mut cb T
}

fn GBox[T].setCb(mut self, f: T) -> Unit {
    self.cb = f
}

fn callGBoxField(g: GBox[fn() -> Int]) -> Int {
    g.cb()
}

// A generic field typed by an unconstrained type param, instantiated to a plain
// fn type: construction and the setter must both track it, or at least fall back to the union.
async fn safeGBoxConstructCall() -> Int {
    let g = GBox[fn() -> Int] { cb: safeFnBoundValue }
    callGBoxField(g)
}

async fn riskyGBoxConstructCall() -> Int {
    let g = GBox[fn() -> Int] { cb: syncRoot }
    callGBoxField(g) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedRiskyGBoxConstructCall() -> Int {
    let g = GBox[fn() -> Int] { cb: syncRoot }
    callGBoxField(g)
}

async fn safeGBoxSetterCall() -> Int {
    let mut g = GBox[fn() -> Int] { cb: safeFnBoundValue }
    g.setCb(safeFnBoundValue)
    callGBoxField(g)
}

async fn riskyGBoxSetterCall() -> Int {
    let mut g = GBox[fn() -> Int] { cb: safeFnBoundValue }
    g.setCb(syncRoot)
    callGBoxField(g) //~ ERROR cannot run inside an `async fn`
}

fn unrelatedRiskyGBoxSetterCall() -> Int {
    let mut g = GBox[fn() -> Int] { cb: safeFnBoundValue }
    g.setCb(syncRoot)
    callGBoxField(g)
}

fn supply() -> Int {
    let ex = task.currentThreadExecutor()
    let a = ex.runToCompletion(paramRoot(syncRoot))
    let ex2 = task.currentThreadExecutor()
    let b = ex2.runToCompletion(paramDirect(syncRoot))
    let ex3 = task.currentThreadExecutor()
    let c = ex3.runToCompletion(fieldRoot(Holder { cb: syncRoot }))
    let ex4 = task.currentThreadExecutor()
    let d = ex4.runToCompletion(ifaceRoot())
    let ex5 = task.currentThreadExecutor()
    let ex6 = task.currentThreadExecutor()
    let e = ex6.runToCompletion(capturedRoot())
    let ex7 = task.currentThreadExecutor()
    let g = ex7.runToCompletion(deepWitnessRoot())
    let ex8 = task.currentThreadExecutor()
    let h = ex8.runToCompletion(safeTwoHop())
    let ex9 = task.currentThreadExecutor()
    let i = ex9.runToCompletion(riskyTwoHop())
    let ex10 = task.currentThreadExecutor()
    let j = ex10.runToCompletion(safeThreeHop())
    let ex11 = task.currentThreadExecutor()
    let k = ex11.runToCompletion(riskyThreeHop())
    let ex12 = task.currentThreadExecutor()
    let l = ex12.runToCompletion(safeMutRoot())
    let ex13 = task.currentThreadExecutor()
    let m = ex13.runToCompletion(riskyMutRoot())
    let ex14 = task.currentThreadExecutor()
    let o = ex14.runToCompletion(safeFieldCall())
    let ex15 = task.currentThreadExecutor()
    let p = ex15.runToCompletion(riskyFieldCall())
    let ex16 = task.currentThreadExecutor()
    let q = ex16.runToCompletion(safeClosureCall())
    let ex17 = task.currentThreadExecutor()
    let s = ex17.runToCompletion(riskyClosureCall())
    let ex18 = task.currentThreadExecutor()
    let u = ex18.runToCompletion(fnBoundNamedRoot())
    let ex19 = task.currentThreadExecutor()
    let v = ex19.runToCompletion(fnBoundClosureRoot())
    let ex20 = task.currentThreadExecutor()
    let w = ex20.runToCompletion(fnBoundCaptureRoot())
    let ex21 = task.currentThreadExecutor()
    let x = ex21.runToCompletion(fnBoundSafeRoot())
    let ex22 = task.currentThreadExecutor()
    let y = ex22.runToCompletion(fnBoundTwoHopRoot())
    let ex23 = task.currentThreadExecutor()
    let z = ex23.runToCompletion(fnBoundTwoHopSafeRoot())
    let ex24 = task.currentThreadExecutor()
    let aa = ex24.runToCompletion(fnBoundSharedSafeRoot())
    let ex25 = task.currentThreadExecutor()
    let ab = ex25.runToCompletion(fnBoundSharedTwoHopSafeRoot())
    let ex26 = task.currentThreadExecutor()
    let ac = ex26.runToCompletion(safeFieldReassign())
    let ex27 = task.currentThreadExecutor()
    let ad = ex27.runToCompletion(riskyFieldReassign())
    let ex28 = task.currentThreadExecutor()
    let ae = ex28.runToCompletion(safeWitnessReassign())
    let ex29 = task.currentThreadExecutor()
    let af = ex29.runToCompletion(riskyWitnessReassign())
    let ex29b = task.currentThreadExecutor()
    let afb = ex29b.runToCompletion(safeWholeValueReassign())
    let ex29c = task.currentThreadExecutor()
    let afc = ex29c.runToCompletion(riskyWholeValueReassign())
    let ex30 = task.currentThreadExecutor()
    let ag = ex30.runToCompletion(safeOuterFieldCall())
    let ex31 = task.currentThreadExecutor()
    let ah = ex31.runToCompletion(riskyOuterFieldCall())
    let ex32 = task.currentThreadExecutor()
    let ai = ex32.runToCompletion(safeOuterFieldRefCall())
    let ex33 = task.currentThreadExecutor()
    let aj = ex33.runToCompletion(riskyOuterFieldRefCall())
    let ex34 = task.currentThreadExecutor()
    let ak = ex34.runToCompletion(safeFieldTwoHop())
    let ex35 = task.currentThreadExecutor()
    let al = ex35.runToCompletion(riskyFieldTwoHop())
    let ex36 = task.currentThreadExecutor()
    let am = ex36.runToCompletion(safeOneHopLiteralField())
    let ex37 = task.currentThreadExecutor()
    let an = ex37.runToCompletion(riskyOneHopLiteralField())
    let ex38 = task.currentThreadExecutor()
    let ao = ex38.runToCompletion(safeTwoHopLiteralField())
    let ex39 = task.currentThreadExecutor()
    let ap = ex39.runToCompletion(riskyTwoHopLiteralField())
    let ex40 = task.currentThreadExecutor()
    let aq = ex40.runToCompletion(safeSetterCall())
    let ex41 = task.currentThreadExecutor()
    let ar = ex41.runToCompletion(riskySetterCall())
    let ex42 = task.currentThreadExecutor()
    let au = ex42.runToCompletion(safeSetterRefCall())
    let ex43 = task.currentThreadExecutor()
    let av = ex43.runToCompletion(riskySetterRefCall())
    let ex44 = task.currentThreadExecutor()
    let aw = ex44.runToCompletion(safeSetterChainCall())
    let ex45 = task.currentThreadExecutor()
    let ax = ex45.runToCompletion(riskySetterChainCall())

-- app/t/t.kg --
import task from std/task

async fn work() -> Int {
    0
}

fn syncRoot() -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(work())
}

fn safeFn() -> Int {
    9
}

type Holder = {
    pub mut cb fn() -> Int
}

type Bag = {
    pub mut items Array[Holder]
}

async fn mutRisky() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    a[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn mutSafe() -> Int {
    let mut a = Array.of(Holder { cb: safeFn })
    a[0].cb()
}

async fn pushRisky() -> Int {
    let mut a = Array.of(Holder { cb: safeFn })
    a.push(Holder { cb: syncRoot })
    a[1].cb() //~ ERROR cannot run inside an `async fn`
}

async fn getRisky() -> Int {
    let a = Array.of(Holder { cb: syncRoot })
    match a.get(0) {
        Some(h) -> h.cb() //~ ERROR cannot run inside an `async fn`
        None -> 0
    }
}

async fn getSafe() -> Int {
    let a = Array.of(Holder { cb: safeFn })
    match a.get(0) {
        Some(h) -> h.cb()
        None -> 0
    }
}

async fn unwrapRisky() -> Int {
    let o = Some(Holder { cb: syncRoot })
    let h = o.unwrap()
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn unwrapGetRisky() -> Int {
    let a = Array.of(Holder { cb: syncRoot })
    a.get(0).unwrap().cb() //~ ERROR cannot run inside an `async fn`
}

async fn forRisky() -> Int {
    let a = Array.of((Holder { cb: syncRoot }, 1))
    let mut s = 0
    for (h, n) in a {
        s = s + h.cb() + n //~ ERROR cannot run inside an `async fn`
    }
    s
}

async fn forSafe() -> Int {
    let a = Array.of((Holder { cb: safeFn }, 1))
    let mut s = 0
    for (h, n) in a {
        s = s + h.cb() + n
    }
    s
}

async fn forRefRisky() -> Int {
    let a = Array.of(Holder { cb: syncRoot })
    let mut s = 0
    for h in &a {
        s = s + h.cb() //~ ERROR cannot run inside an `async fn`
    }
    s
}

async fn fieldRisky() -> Int {
    let b = Bag { items: Array.of(Holder { cb: syncRoot }) }
    b.items[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn fieldSafe() -> Int {
    let b = Bag { items: Array.of(Holder { cb: safeFn }) }
    b.items[0].cb()
}

fn callOn(a: &Array[Holder]) -> Int {
    a[0].cb()
}

async fn paramRisky() -> Int {
    let a = Array.of(Holder { cb: syncRoot })
    callOn(&a) //~ ERROR cannot run inside an `async fn`
}

async fn paramSafe() -> Int {
    let a = Array.of(Holder { cb: safeFn })
    callOn(&a)
}

fn tryIt(h: Holder) -> Result[Holder, String] {
    Ok(h)
}

async fn resultRisky() -> Int {
    match tryIt(Holder { cb: syncRoot }) {
        Ok(h) -> h.cb() //~ ERROR cannot run inside an `async fn`
        Err(e) -> 0
    }
}

async fn resultSafe() -> Int {
    match tryIt(Holder { cb: safeFn }) {
        Ok(h) -> h.cb()
        Err(e) -> 0
    }
}

async fn fixedRisky() -> Int {
    let f = FixedArray.filled[Holder, 2](Holder { cb: syncRoot })
    f[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn fixedSafe() -> Int {
    let f = FixedArray.filled[Holder, 2](Holder { cb: safeFn })
    f[0].cb()
}

fn unwrapH(o: Option[Holder]) -> Holder {
    match o {
        Some(h) -> h
        None -> Holder { cb: safeFn }
    }
}

fn unwrapG[T](o: Option[T]) -> T {
    match o {
        Some(v) -> v
        None -> None.expect("empty")
    }
}

async fn userUnwrapRisky() -> Int {
    let h = unwrapH(Some(Holder { cb: syncRoot }))
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn userUnwrapSafe() -> Int {
    let h = unwrapH(Some(Holder { cb: safeFn }))
    h.cb()
}

async fn genericUnwrapRisky() -> Int {
    let h = unwrapG(Some(Holder { cb: syncRoot }))
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn genericUnwrapSafe() -> Int {
    let h = unwrapG(Some(Holder { cb: safeFn }))
    h.cb()
}

async fn stdUnwrapRisky() -> Int {
    let h = Some(Holder { cb: syncRoot }).unwrap()
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn stdUnwrapSafe() -> Int {
    let h = Some(Holder { cb: safeFn }).unwrap()
    h.cb()
}

async fn fixedIdxRisky() -> Int {
    let f = FixedArray.filled[Holder, 2](Holder { cb: syncRoot })
    let g = f[0]
    g.cb() //~ ERROR cannot run inside an `async fn`
}

async fn fixedGetRisky() -> Int {
    let f = FixedArray.filled[Holder, 2](Holder { cb: syncRoot })
    match f.get(0) {
        Some(h) -> h.cb() //~ ERROR cannot run inside an `async fn`
        None -> 0
    }
}

async fn fixedGetSafe() -> Int {
    let f = FixedArray.filled[Holder, 2](Holder { cb: safeFn })
    match f.get(0) {
        Some(h) -> h.cb()
        None -> 0
    }
}

async fn tryRisky() -> Result[Int, String] {
    let h = tryIt(Holder { cb: syncRoot })?
    Ok(h.cb()) //~ ERROR cannot run inside an `async fn`
}

async fn trySafe() -> Result[Int, String] {
    let h = tryIt(Holder { cb: safeFn })?
    Ok(h.cb())
}

fn errSide(h: Holder) -> Result[Int, Holder] {
    Err(h)
}

async fn errRisky() -> Int {
    match errSide(Holder { cb: syncRoot }) {
        Ok(n) -> n
        Err(h) -> h.cb() //~ ERROR cannot run inside an `async fn`
    }
}

async fn errSafe() -> Int {
    match errSide(Holder { cb: safeFn }) {
        Ok(n) -> n
        Err(h) -> h.cb()
    }
}

fn paramLoop(a: &Array[Holder]) -> Int {
    let mut s = 0
    for h in a {
        s = s + h.cb()
    }
    s
}

async fn paramLoopRisky() -> Int {
    let a = Array.of(Holder { cb: syncRoot })
    paramLoop(&a) //~ ERROR cannot run inside an `async fn`
}

async fn paramLoopSafe() -> Int {
    let a = Array.of(Holder { cb: safeFn })
    paramLoop(&a)
}

fn paramGet(a: &Array[Holder]) -> Int {
    match a.get(0) {
        Some(h) -> h.cb()
        None -> 0
    }
}

async fn paramGetRisky() -> Int {
    let a = Array.of(Holder { cb: syncRoot })
    paramGet(&a) //~ ERROR cannot run inside an `async fn`
}

async fn paramGetSafe() -> Int {
    let a = Array.of(Holder { cb: safeFn })
    paramGet(&a)
}

async fn mutOverwrittenSafe() -> Int {
    let mut a = Array.of(Holder { cb: safeFn })
    a.push(Holder { cb: safeFn })
    a[1].cb()
}


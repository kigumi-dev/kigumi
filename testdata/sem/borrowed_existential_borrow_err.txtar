-- module --
stage: driver
-- src --
interface Show {
    fn show(self) -> String
}

interface Counter {
    fn bump(mut self, by: Int)
}

type Box = {
    pub mut value String
}

fn Box.show(self) -> String {
    self.value
}

type Num = {
    pub mut n Int
}

fn Num.bump(mut self, by: Int) {
    self.n = self.n + by
}

type Keep['a] = {
    pub mut s &'a Show
}

fn escape['a](b: &'a Box) -> &'a Show {
    b
}

fn escapeField['a](b: &'a Box) -> Keep['a] {
    Keep { s: b }
}

fn storeCaller['a](k: &mut Keep['a], b: &'a Box) {
    k.s = b
}

fn mutateOwner() -> String {
    let mut box = Box { value: "a" }
    let v: &Show = &box
    box.value = "b"
    v.show()
}

fn exclusive() -> Int {
    let mut num = Num { n: 1 }
    let c: &mut Counter = &mut num
    let n = num.n
    c.bump(1)
    n
}

fn scopeEnd() -> String {
    let v: &Show = {
        let box = Box { value: "a" }
        &box
    }
    v.show()
}

fn reusedSlot(items: &Array[Box]) -> String {
    let mut out = ""
    let first = Box { value: "first" }
    let mut k = Keep { s: &first }
    for i in 0..items.len() {
        let cur: &Show = &items[i]
        out = "${out}${k.s.show()}"
        k = Keep { s: cur }
    }
    out
}

fn copiedView(items: &Array[Box]) -> String {
    let first = Box { value: "first" }
    let mut prev = Keep { s: &first }
    let mut cur = Keep { s: &first }
    for i in 0..items.len() {
        prev = Keep { s: cur.s }
        let v: &Show = &items[i]
        cur = Keep { s: v }
    }
    prev.s.show()
}

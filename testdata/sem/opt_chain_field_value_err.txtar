type R = resource {
    pub n Int
}

fn R.drop(move self) {
    _ = self
}

type V = resource {
    pub r R
    pub k Int
}

fn plain(y: V?) -> Int? {
    y?.k
}

fn steal(y: V?) -> R? {
    y?.r //~ ERROR reading `y?.r` by value would copy a `R`, which is not `Copy`
}

fn stealLocal(y: V?) {
    let t = y?.r //~ ERROR reading `y?.r` by value would copy a `R`, which is not `Copy`
    _ = t
}

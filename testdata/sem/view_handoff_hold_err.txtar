-- module --
stage: driver
-- src --
import task from std/task

type View['a] = { pub data &'a Array[Int], pub off usize }

async fn one['a](v: View['a]) -> Int { v.data[v.off] }

async fn viaSpawn() -> Int {
    let mut a = Array.of(1, 2, 3)
    let t = task.spawn(one(View { data: &a, off: 0 }))
    a.push(4)
    await t
}

async fn viaHandoff(ex: task.Executor) -> Int {
    let mut a = Array.of(1, 2, 3)
    let t = ex.handoff(one(View { data: &a, off: 0 }))
    a.push(4)
    await t
}

let ex = task.currentThreadExecutor()
print "${ex.runToCompletion(viaSpawn())} ${ex.runToCompletion(viaHandoff(task.currentThreadExecutor()))}"

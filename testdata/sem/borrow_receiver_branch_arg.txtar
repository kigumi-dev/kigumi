-- src --
type P = resource { pub mut s Array[Int], tag Int }
fn P.drop(move self) { print "drop ${self.tag}" }
type Bx = resource { pub mut inner P }

fn Bx.go(mut self, o: &P) -> Int {
    self.inner = P { s: Array.of(99), tag: 99 }
    o.s[0]
}

fn direct(b: &mut Bx) -> Int {
    b.go(&b.inner) //~ ERROR this argument may target storage
}

fn branch(b: &mut Bx, c: Bool) -> Int {
    b.go(if c { &b.inner } else { &b.inner }) //~ ERROR this argument may target storage
}

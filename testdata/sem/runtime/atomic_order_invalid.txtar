-- src --
import atomic from std/atomic

fn orders(a: atomic.AtomicU64) {
    unsafe {
        _ = a.load(atomic.LoadOrder.Release) //~ ERROR
        _ = a.load(atomic.LoadOrder.AcqRel) //~ ERROR
        a.store(1, atomic.StoreOrder.Acquire) //~ ERROR
        a.store(1, atomic.StoreOrder.AcqRel) //~ ERROR
        a.store(1, atomic.StoreOrder.SeqCst)
    }
}

print "ok"

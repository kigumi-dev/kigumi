-- app/t/t.kg --
import task from std/task

async fn leaf() -> Int {
    5
}

fn spawner() -> task.Task[Int] {
    task.spawn(leaf())
}

fn stop(t: task.Task[Int]) {
    t.cancel()
}

export(interrupt) {
    pub fn tick() { //~ ERROR export(interrupt) handler `tick` may block or reach unverified code
        let t = spawner()
        stop(t)
    }
}


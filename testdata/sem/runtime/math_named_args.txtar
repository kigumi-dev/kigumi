-- src --
import math from std/math

fn main() {
    let roots = math.sqrt(x: 2.0) + math.floor(x: 2.5) + math.ceil(x: 2.5) + math.round(x: 2.5)
    let bits = math.fromBits(bits: math.toBits(x: roots))
    let ints = (math.toInt(x: bits) || 0) + math.abs(x: -2) + math.min(a: 1, b: 2) + math.max(a: 1, b: 2) + math.clamp(x: 5, lo: 0, hi: 3)
    let floats = math.toFloat(x: ints) + math.abs(x: -2.5) + math.min(a: 1.0, b: 2.0) + math.max(a: 1.0, b: 2.0) + math.clamp(x: 5.0, lo: 0.0, hi: 3.0)
    let tests = math.isNaN(x: floats) || math.isInf(x: floats) || math.isFinite(x: floats)
    let parts = math.trunc(x: floats) + math.fract(x: floats) + math.fmod(x: floats, y: 3.0)
    let logs = math.exp(x: 1.0) + math.log(x: 2.0) + math.log2(x: 8.0) + math.log10(x: 100.0)
    let trig = math.sin(x: 1.0) + math.cos(x: 1.0) + math.tan(x: 1.0)
    let hyper = math.sinh(x: 1.0) + math.cosh(x: 1.0) + math.tanh(x: 1.0) + math.pow(x: 2.0, y: 10.0)
    print "${tests} ${parts + logs + trig + hyper + math.nan() + math.inf()}"
}
-- expect --

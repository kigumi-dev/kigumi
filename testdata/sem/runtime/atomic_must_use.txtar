-- src --
import atomic from std/atomic

type Counter = {
    a atomic.AtomicU64
}

fn make() -> atomic.AtomicU64 {
    atomic.AtomicU64.new(1)
}

fn makeCounter() -> Counter {
    Counter { a: atomic.AtomicU64.new(1) }
}

fn makeOption() -> Option[atomic.AtomicU64] {
    Some(atomic.AtomicU64.new(1))
}

fn discard() {
    make() //~ ERROR
    makeCounter() //~ ERROR
    makeOption() //~ ERROR
    let kept = make()
    _ = kept
}

print "ok"

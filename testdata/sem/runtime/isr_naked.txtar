-- src --
extern(C) {
    fn raw()
}

export(interrupt) {
    pub fn inner() {}
}

export(interrupt, naked) {
    pub fn saved() {
        asm {
            "push rbx"
            "xor ebx, ebx"
            "call {f}"
            "pop rbx"
            "ret"
            f: sym inner
        }
    }
    pub fn trap() { //~ ERROR export(interrupt) handler `trap` reaches assembly the compiler cannot verify
        asm {
            "ud2"
        }
    }
    pub fn foreign() { //~ ERROR export(interrupt) handler `foreign` may block or reach unverified code
        asm {
            "push rbx"
            "call {f}"
            "pop rbx"
            "ret"
            f: sym raw
        }
    }
    pub fn device() { //~ ERROR export(interrupt) handler `device` reaches assembly the compiler cannot verify
        asm {
            "mov eax, [rdi]"
            "ret"
        }
    }
}


-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn mk(id: Int) -> Res {
    Res { id: id }
}

type GA = resource {
    pub xs Array[Res]
}

fn GA.drop(move self) {}

fn mkga(i: Int) -> GA {
    GA { xs: Array.of(mk(i)) }
}

type HA = {
    pub xs Array[Res]
}

type H['a] = {
    pub r &'a HA
}

fn me(h: &HA) -> &HA {
    h
}

fn unsafeTemp() {
    for r in unsafe { mkga(1).xs } { //~ ERROR cannot move `mkga(1).xs` out of `GA`
        _ = r
    }
}

fn ifTemp(c: Bool) {
    for r in (if c { mkga(2).xs } else { Array.of(mk(0)) }) { //~ ERROR cannot move `mkga(2).xs` out of `GA`
        _ = r
    }
}

fn orTemp(o: Array[Res]?) {
    for r in (o || mkga(3).xs) { //~ ERROR cannot move `mkga(3).xs` out of `GA`
        _ = r
    }
}

fn namedOwner(g: GA) {
    for r in unsafe { g.xs } { //~ ERROR cannot move `g.xs` out of `GA`
        _ = r
    }
}

fn borrowedRoot(h: &HA) {
    for r in unsafe { h.xs } { //~ ERROR `for` over `h.xs` would take each element out
        _ = r
    }
}

fn borrowedLink['a](h: H['a]) {
    for r in unsafe { h.r.xs } { //~ ERROR `for` over `h.r.xs` would take each element out
        _ = r
    }
}

fn borrowedCall(h: &HA, c: Bool) {
    for r in (if c { me(h).xs } else { Array.of(mk(0)) }) { //~ ERROR `for` over `me(h).xs` would take each element out
        _ = r
    }
}

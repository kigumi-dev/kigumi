-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

type W = {
    pub items Array[Res]
    pub ws Array[V]
}

type V = {
    pub items Array[Res]
}

type Box[T] = {
    pub v T
}

type H['a] = {
    pub r &'a Array[W]
}

type Holder = {
    pub ws Array[W]
}

fn id[T](x: T) -> T {
    x
}

fn pair[T](a: T, b: T) -> Box[T] {
    Box { v: a }
}

fn apply(f: fn() -> Int) -> Int {
    f()
}

fn me(h: &Array[Array[Res]]) -> &Array[Array[Res]] {
    h
}

fn sharedField(xs: &Array[W]) {
    for r in xs[0].items { //~ ERROR `for` over `xs[0].items` would take each element
        _ = r
    }
}

fn sharedElem(xs: &Array[Array[Res]]) {
    for r in xs[0] { //~ ERROR `for` over `xs[0]` would take each element
        _ = r
    }
}

fn mutField(xs: &mut Array[W]) {
    for r in xs[0].items { //~ ERROR `for` over `xs[0].items` would take each element
        _ = r
    }
}

fn mutElem(xs: &mut Array[Array[Res]]) {
    for r in xs[0] { //~ ERROR `for` over `xs[0]` would take each element
        _ = r
    }
}

fn localRef(owner: Array[W]) {
    let xs = &owner
    for r in xs[0].items { //~ ERROR `for` over `xs[0].items` would take each element
        _ = r
    }
}

fn localRefElem(owner: Array[Array[Res]]) {
    let xs: &Array[Array[Res]] = &owner
    for r in xs[0] { //~ ERROR `for` over `xs[0]` would take each element
        _ = r
    }
}

fn inferredParam(owner: Array[Array[Res]]) {
    let xs = id(&owner)
    for r in xs[0] { //~ ERROR `for` over `xs[0]` would take each element
        _ = r
    }
}

fn inferredField(owner: Array[W]) {
    let b = Box { v: &owner }
    for r in b.v[0].items { //~ ERROR `for` over `b.v[0].items` would take each element
        _ = r
    }
}

fn inferredCall(owner: Array[W]) {
    let b = pair(&owner, &owner)
    for r in b.v[0].items { //~ ERROR `for` over `b.v[0].items` would take each element
        _ = r
    }
}

fn heldRef['a](h: H['a]) {
    for r in h.r[0].items { //~ ERROR `for` over `h.r[0].items` would take each element
        _ = r
    }
}

fn genericElem[T](xs: &Array[Array[T]]) {
    for r in xs[0] { //~ ERROR `for` over `xs[0]` would take each element
        _ = r
    }
}

fn nested(xs: &Array[Array[Array[Res]]]) {
    for r in xs[0][1] { //~ ERROR `for` over `xs[0][1]` would take each element
        _ = r
    }
}

fn nestedField(xs: &Array[W]) {
    for r in xs[0].ws[1].items { //~ ERROR `for` over `xs[0].ws[1].items` would take each element
        _ = r
    }
}

fn callRef(h: &Array[Array[Res]]) {
    for r in me(h)[0] { //~ ERROR `for` over `me(h)[0]` would take each element
        _ = r
    }
}

fn joinRef(c: Bool, xs: &Array[Array[Res]], ys: &Array[Array[Res]]) {
    for r in (if c { xs } else { ys })[0] { //~ ERROR `for` over `(if c { xs } else { ys })[0]` would take each element
        _ = r
    }
}

fn ix(i: usize) -> usize {
    i
}

fn callIndex(xs: &Array[Array[Res]], ks: &Array[usize]) {
    for r in xs[ix(0)] { //~ ERROR `for` over `xs[ix(0)]` would take each element
        _ = r
    }
    for r in xs[ks[0]] { //~ ERROR `for` over `xs[ks[0]]` would take each element
        _ = r
    }
    for r in xs[ks.len() - ix(1)] { //~ ERROR `for` over `xs[ks.len() - ix(1)]` would take each element
        _ = r
    }
}

fn slice(xs: &Array[Res]) {
    for r in xs[0..1] { //~ ERROR `for` over `xs[0..1]` would take each element
        _ = r
    }
}

fn sliceField(xs: &Array[W]) {
    for r in xs[0].items[0..1] { //~ ERROR `for` over `xs[0].items[0..1]` would take each element
        _ = r
    }
}

fn Holder.lent(self) {
    for r in self.ws[0].items { //~ ERROR `for` over `self.ws[0].items` would take each element
        _ = r
    }
}

fn captured(xs: Array[W]) -> Int {
    apply(() => {
        let mut n = 0
        for r in xs[0].items { //~ ERROR `for` over `xs[0].items` would take each element
            n = n + r.id
        }
        n
    })
}

fn borrowedOk(xs: &Array[W], ys: &mut Array[Array[Res]], ns: &Array[Array[Int]]) -> Int {
    let mut n = 0
    for r in &xs[0].items {
        n = n + r.id
    }
    for r in &ys[0] {
        n = n + r.id
    }
    for r in &xs[0].items[0..1] {
        n = n + r.id
    }
    for k in ns[0] {
        n = n + k
    }
    n
}

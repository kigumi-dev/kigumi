type Cb = {
    pub f fn(Int) -> Int
    pub n Int
}

fn fingerprint[T: Hash](a: &T) -> u64 { hash(a) }

fn run(n: Int) -> u64 {
    fingerprint(&Cb { f: (x) => x, n: n }) //~ ERROR `Cb` does not satisfy `Hash`
}


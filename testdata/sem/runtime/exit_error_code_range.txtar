-- src --
import os from std/os

fn zero() -> Void! {
    fail os.ExitError.new(0)? //~ ERROR outside 1 to 255
}

fn big() -> Void! {
    fail os.ExitError.new(256)? //~ ERROR outside 1 to 255
}

fn negative() -> Void! {
    fail os.ExitError.new(-3)? //~ ERROR outside 1 to 255
}

fn fine() -> Void! {
    fail os.ExitError.new(255)?
}

fn dynamic(code: Int) -> Void! {
    fail os.ExitError.new(code)?
}

fn identity[T](x: T) -> T {
    x
}

fn sumLens(xs: Array[Array[Int]]) -> usize {
    let mapped = xs.map(identity) //~ ERROR `identity`'s type parameter would be inferred as a reference here
    let mut total: usize = 0
    for a in mapped {
        total = total + a.len()
    }
    total
}

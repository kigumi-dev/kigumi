type Box = {
    pub mut n Int
}

fn Box.update(mut self, k: Int) {
    self.n = self.n + k
}

fn Box.run[F: FnMut[fn() -> Void]](mut self, mut f: F) {
    f()
    self.n = self.n + 10
}

fn Box.addFrom(mut self, other: &mut Box) {
    self.n = self.n + other.n
    other.n = 0
}

fn Box.peek[F: FnMut[fn() -> Int]](mut self, mut f: F) -> Int {
    self.n = self.n + 10
    f()
}

type H['a] = {
    pub r &'a mut Box
}

type Hold['a] = {
    pub mut r &'a mut Box
    pub z Int
}

type Bag['a] = {
    pub mut items Array[H['a]]
}

fn pushTo['a](a: &mut Array[H['a]], h: H['a]) {
    a.push(h)
}

fn relay['a](a: &mut Array[H['a]], h: H['a]) {
    pushTo(a, h)
}

fn storeAt['a](a: &mut Array[H['a]], h: H['a]) {
    a[0] = h
}

fn setHold['a](out: &mut Hold['a], h: H['a]) {
    out.r = h.r
}

fn emit['a](out: &mut H['a], h: H['a]) {
    out = h
}

fn put[T](a: &mut Array[T], x: T) {
    a.push(x)
}

fn tally['a](a: &mut Array[H['a]], c: &mut Int) {
    c = c + 1
}

fn bumpBeside['a](a: &mut Array[H['a]], b: &mut Box) {
    b.n = b.n + 1
}

fn dropOther['a, 'b](a: &mut Array[H['a]], h: H['b]) {
    h.r.update(1)
}

fn each['a, F: FnMut[fn() -> Void]](a: Array[H['a]], mut f: F) {
    for h in a {
        h.r.run(() => f())
    }
}

fn holder['a, F: FnMut[fn() -> Void]](h: H['a], mut f: F) {
    h.r.run(() => f())
}

fn fixed1[T](a: Array[T]) -> FixedArray[T, 1] {
    FixedArray.fromArrayMove[T, 1](a).unwrap()
}

fn fixedOpt[T](a: Array[T]) -> FixedArray[T, 1]? {
    FixedArray.fromArrayMove[T, 1](a)
}


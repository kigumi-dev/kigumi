-- src --
type Nm = {
    pub name String
    pub mut n Int
}

type W = {
    pub mut nm Nm
}

fn mkn(x: Int) -> Nm { Nm { name: "b", n: x } }

fn plainFn(x: Int) -> Int { mkn(x).n }

noalloc fn cheap(x: Int) -> Int { x + 1 }

noalloc fn applyGen[F: Fn[noalloc fn(Int) -> Int]](f: F, v: Int) -> Int {
    f(v) //~ ERROR a call through a function value receives this `Int` in a box allocated for it
}

pure fn applyPure[F: Fn[pure fn(Int) -> Int]](f: F, v: Int) -> Int {
    f(v)
}

fn okItem() -> Int { applyGen(cheap, 1) }

fn okClosure(n: Int) -> Int {
    let k = n + 1
    applyGen((x: Int) => x + k, 1) //~ ERROR closure is not `noalloc` (allocates)
}

fn okForwarded(f: noalloc fn(Int) -> Int) -> Int { applyGen(f, 1) }

fn badItem() -> Int { applyGen(plainFn, 1) } //~ ERROR `plainFn` is not `noalloc`

fn badClosure() -> Int { applyGen((x: Int) => mkn(x).n, 1) } //~ ERROR closure is not `noalloc`

fn badBuild(w: &mut W) -> Int {
    applyGen((x: Int) => { //~ ERROR closure is not `noalloc`
        w.nm = Nm { name: "b", n: x }
        x
    }, 1)
}

fn badValue(f: fn(Int) -> Int) -> Int { applyGen(f, 1) } //~ ERROR `fn(Int) -> Int` cannot be used as `noalloc fn(Int) -> Int`

fn badPure() -> Int {
    applyPure((x: Int) => { //~ ERROR closure is not `pure`
        print "${x}"
        x
    }, 1)
}

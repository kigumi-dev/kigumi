-- module --
stage: driver
-- src --
interface Reader {
    fn at(self) -> Int
}

type View['a] = {
    pub data &'a Array[Int],
    pub off usize
}

fn View['a].at(self) -> Int {
    self.data[self.off]
}

type BadErr['a] = {
    pub data &'a Array[Int]
}

fn BadErr['a].message(self) -> String {
    "bad"
}

fn toReader() -> Int {
    let o: Reader = {
        let b = Array.of(9, 9, 9)
        View { data: &b, off: 1 }
    }
    o.at()
}

fn inScope() -> Int {
    let b = Array.of(9, 9, 9)
    let o: Reader = View { data: &b, off: 1 }
    o.at()
}

fn fromParam['a](v: View['a]) -> Reader {
    v
}

fn toError() -> Void! {
    let b = Array.of(9, 9, 9)
    fail BadErr { data: &b }
}

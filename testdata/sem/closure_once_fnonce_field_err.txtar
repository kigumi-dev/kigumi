type Tr = resource {
    pub id Int
}

fn Tr.drop(move self) {}

fn Tr.close(move self) {}

type Holder[F] = {
    pub f F
}

fn runTwice[F: FnOnce[fn() -> Void]](r: Holder[F]) -> Void {
    (r.f)()
    (r.f)() //~ ERROR is a `FnOnce` value and can be called only once
}

fn Holder[F: FnOnce[fn() -> Void]].runOwnedTwice(move self) -> Void {
    (self.f)()
    (self.f)() //~ ERROR is a `FnOnce` value and can be called only once
}

fn runOnce[F: FnOnce[fn() -> Void]](r: Holder[F]) -> Void {
    (r.f)()
}

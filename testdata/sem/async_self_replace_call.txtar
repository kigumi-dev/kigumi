-- src --
type Counter = Off | N(n: Int)

fn Counter.reset(mut self) {
    self = N(7)
}

fn Counter.resetVia(mut self) {
    self.reset()
}

fn Counter.tag(mut self) {
    match self {
        Off -> {}
        N(n) -> print "n ${n}"
    }
}

fn swap(c: &mut Counter) {
    c = Off
}

type Box = { pub mut n Int }

fn Box.bump(mut self) {
    self.n = self.n + 1
}

async fn Counter.bumpAsync(mut self) {
    self.reset() //~ ERROR `bumpAsync` lends `self` to `reset`, which may replace it as a whole
}

async fn Counter.viaChain(mut self) {
    self.resetVia() //~ ERROR `viaChain` lends `self` to `resetVia`, which may replace it as a whole
}

async fn Counter.viaParam(mut self) {
    swap(&mut self) //~ ERROR `viaParam` lends `self` to `swap`, which may replace it as a whole
}

async fn Counter.viaValue(mut self) {
    let f: fn(&mut Counter) -> Void = swap
    f(&mut self) //~ ERROR `viaValue` lends `self` to a function value, which may replace it as a whole
}

async fn Counter.readOnly(mut self) {
    self.tag()
}

async fn Box.fieldsOnly(mut self) {
    self.bump()
}

interface Reset {
    fn reset(mut self)
}

async fn viaGen[T: Reset](c: &mut T) {
    c.reset()
}

async fn viaAsync(c: &mut Counter) {
    c.reset()
}

async fn Counter.viaGenSelf(mut self) {
    await viaGen(&mut self) //~ ERROR a `&mut` the callee may replace as a whole cannot be lent to an `async` call
}

async fn Counter.viaAsyncSelf(mut self) {
    await viaAsync(&mut self) //~ ERROR a `&mut` the callee may replace as a whole cannot be lent to an `async` call
}

-- module --
stage: driver
-- src --
type View['a] = { pub data &'a Bytes, pub off usize }

fn views['a](b: &'a Bytes) -> Array[View['a]] {
    Array.of(View { data: b, off: 0 })
}

fn bytes() -> Bytes {
    Bytes.fromArray(&Array.of(1, 2, 3))
}

fn fromLocal['a](keep: &'a Bytes) -> Array[View['a]] {
    let mine = bytes()
    Array.of(View { data: keep, off: 0 }, View { data: &mine, off: 0 })
}

fn untagged['a](keep: &'a Bytes, b: &Bytes) -> Array[View['a]] {
    let mut vs: Array[View['a]] = views(keep)
    let w: View['a] = View { data: b, off: 1 }
    vs.push(w)
    vs
}

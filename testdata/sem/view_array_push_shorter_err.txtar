-- src --
type View['a] = { pub data &'a Bytes, pub off usize }

fn views['a](b: &'a Bytes) -> Array[View['a]] {
    Array.of(View { data: b, off: 0 })
}

fn bytes() -> Bytes {
    Bytes.fromArray(&Array.of(1, 2, 3))
}

fn shorter() -> usize {
    let outer = bytes()
    let mut vs = views(&outer)
    {
        let inner = bytes()
        vs.push(View { data: &inner, off: 1 })
    }
    vs.len()
}

fn later() -> usize {
    let outer = bytes()
    let mut vs = views(&outer)
    let next = bytes()
    vs.push(View { data: &next, off: 1 })
    vs.len()
}

type Slot['a] = { pub mut data &'a Bytes }

fn viaCallback() -> usize {
    let a = bytes()
    let mut ss = Array.of(Slot { data: &a })
    {
        let b = bytes()
        let w = Slot { data: &b }
        _ = ss.withMut(0, (e) => {
            e.data = w.data
        })
    }
    ss.len()
}

let n = shorter() + later() + viaCallback()

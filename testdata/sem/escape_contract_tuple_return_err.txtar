-- lib/esc.kg --
// A tuple (or other aggregate) return type must still catch a non-escaping callback leaking out
// through a fresh tuple literal, even though the return type itself isn't Fn-shaped.
fn noop() {}

fn tupleTailReturn(cb: fn() -> Void) -> (fn() -> Void, Int) {
    (cb, 1) //~ ERROR `cb` is a non-escaping callback and cannot be returned
}

fn tupleExplicitReturn(cb: fn() -> Void) -> (fn() -> Void, Int) {
    return (cb, 1) //~ ERROR `cb` is a non-escaping callback and cannot be returned
}

fn tupleViaIfBranch(cb: fn() -> Void, flag: Bool) -> (fn() -> Void, Int) {
    if flag { (cb, 1) } else { (noop, 2) } //~ ERROR `cb` is a non-escaping callback and cannot be returned
}

fn tupleNested(cb: fn() -> Void) -> ((fn() -> Void, Int), Int) {
    ((cb, 1), 2) //~ ERROR `cb` is a non-escaping callback and cannot be returned
}

// A tuple return with no restricted value anywhere in it stays clean, even
// though the return type has the same (fn, Int) shape as the rejected cases.
fn tupleTailOk(cb: fn() -> Void) -> (fn() -> Void, Int) {
    cb()
    (noop, 1)
}

-- module --
stage: driver
-- src --
type R = resource { pub mut id Int }

fn R.drop(move self) {
    _ = self.id
}

fn R.bump(mut self, k: Int) -> Int {
    self.id += k
    self.id
}

fn R.show(self, k: Int) -> Int {
    self.id + k
}

fn take(r: R) -> Int {
    r.id
}

type P = { pub mut id Int }

fn P.show(self, k: Int) -> Int {
    self.id + k
}

fn mutReplaced() -> Int {
    let mut a = R { id: 1 }
    a.bump({ a = R { id: 2 }; 10 })
}

fn mutMoved() -> Int {
    let mut a = R { id: 1 }
    a.bump({ let _ = take(a); 10 })
}

fn mutFieldWrite() -> Int {
    let mut a = R { id: 1 }
    a.bump({ a.id = 3; 10 })
}

fn sharedReplaced() -> Int {
    let mut a = R { id: 1 }
    a.show({ a = R { id: 2 }; 10 })
}

fn sharedFieldWrite() -> Int {
    let mut b = R { id: 1 }
    b.show({ b.id = 5; 10 })
}

fn sharedRead() -> Int {
    let b = R { id: 1 }
    b.show(b.id)
}

fn plainFieldWrite() -> Int {
    let mut p = P { id: 1 }
    p.show({ p.id = 5; 10 })
}

fn mk(i: Int) -> R {
    R { id: i }
}

fn R.take(move self) -> Int {
    self.id
}

type Pair = resource { pub mut h R, pub mut k R }

fn disjointMove() -> Int {
    let mut p = Pair { h: mk(1), k: mk(2) }
    p.h.bump(p.k.take())
}

fn disjointAssign() -> Int {
    let mut p = Pair { h: mk(1), k: mk(2) }
    p.h.bump({ p.k = mk(3); 1 })
}

fn sameField() -> Int {
    let mut p = Pair { h: mk(1), k: mk(2) }
    p.h.bump({ p.h = mk(4); 1 })
}

fn paramField(p: &mut Pair) -> Int {
    p.h.bump({ p.h = mk(6); 1 })
}

fn paramDisjoint(p: &mut Pair) -> Int {
    p.h.bump({ p.k = mk(7); 1 })
}

fn element() -> Int {
    let mut xs = Array.of(mk(1))
    xs[0].bump({ xs = Array.of(mk(5)); 1 })
}

fn elementRead() -> Int {
    let mut xs = Array.of(mk(1), mk(2))
    xs[0].bump(xs[1].id)
}

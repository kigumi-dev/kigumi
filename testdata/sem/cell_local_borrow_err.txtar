mir: planned
-- src --
import task from std/task

type V['a] = { pub s &'a String }
type Rec = { pub mut name String, pub mut n Int }
type H[F] = { pub f F }
type P = { pub mut a Int, pub mut b Int }
type Named = { pub name String, pub mut n Int }
type W = { pub mut nm Named, pub k Int }
type FW = { pub f fn() -> usize }
type Guard[F] = resource { pub mut f F }
type Sink['a] = { pub items &'a mut Array[V['a]] }
type FB = { pub mut futs Array[Future[Int]] }
type SG[F] = { pub mut g Guard[F] }
type Outer = { pub mut fb FB, pub k Int }
type FO = { pub mut fut Future[Int]?, pub k Int }
type HR['a] = { pub mut fb &'a mut FB }
type GB[T] = { pub mut v Array[T] }
type N0['a] = { pub mut fb &'a mut FB }
type N1['a] = { pub mut n &'a mut N0['a] }
type N2['a] = { pub mut n &'a mut N1['a] }
type N3['a] = { pub mut n &'a mut N2['a] }
type N4['a] = { pub mut n &'a mut N3['a] }
type N5['a] = { pub mut n &'a mut N4['a] }
type N6['a] = { pub mut n &'a mut N5['a] }
type N7['a] = { pub mut n &'a mut N6['a] }
type N8['a] = { pub mut n &'a mut N7['a] }

fn mkV['a](s: &'a String) -> V['a] { V { s: s } }
fn setS(s: &mut String) { s = "q" }
fn run[F: FnMut[fn() -> Void]](mut f: F) { f() }
fn runWith[F: FnMut[fn() -> Void]](s: &String, mut f: F) -> usize { f(); s.len() }
async fn work[F: FnMut[fn() -> Void]](mut f: F) -> Int { f(); 1 }
fn runs[F: FnMut[fn() -> Void]](x: Named, mut f: F) -> Int { f(); x.n }
fn viaShared[F: FnMut[fn() -> Void]](w: &W, mut f: F) -> Int { runs(w.nm, f) }
fn peekLen(s: &String) { let n = s.len() }
fn Guard[F: FnMut[fn() -> Void]].drop(move self) { self.f() }
fn two(a: &mut String, b: &mut String) { a = "1"; b = "2" }
async fn holdGuard[F: FnMut[fn() -> Void]](g: Guard[F]) -> Int { 1 }
fn eatGuard[F: FnMut[fn() -> Void]](g: Guard[F]) { }
async fn workEsc[F: FnMut[fn() -> Void]](mut f: escaping F) -> Int { f(); 1 }
fn spawnA[F: FnMut[fn() -> Void]](f: escaping F, n: Int) {
    if n > 0 { spawnB(f, n - 1) } else { let tk = task.spawn(workEsc(f)) }
}
fn spawnB[F: FnMut[fn() -> Void]](f: escaping F, n: Int) { spawnA(f, n) }
fn FB.futsMut(mut self) -> &mut Array[Future[Int]] { &mut self.futs }
fn FB.me(mut self) -> &mut FB { &mut self }
fn pickMix['a](a: &'a mut FB, o: &'a mut Outer, c: Bool) -> &'a mut FB { if c { a.me() } else { &mut o.fb } }
fn GB[T].vm(mut self) -> &mut Array[T] { &mut self.v }
fn addF(h: &mut Array[Future[Int]], f: Future[Int]) { h.push(f) }
fn viaParam[F: FnMut[fn() -> Void]](h: &mut FB, f: escaping F) { h.futs.push(work(f)) }
fn viaHR['a, F: FnMut[fn() -> Void]](k: &mut HR['a], f: escaping F) { k.fb.futs.push(work(f)) }
fn call2[F: FnMut[fn() -> Void]](mut c: F) { c() }
fn FB.addW[F: FnMut[fn() -> Void]](mut self, f: escaping F) { self.futs.push(work(f)) }
fn futsOf(b: &mut FB) -> &mut Array[Future[Int]] { &mut b.futs }
fn pickTwo['a](a: &'a mut FB, b: &'a mut FB, first: Bool) -> &'a mut Array[Future[Int]] { if first { &mut a.futs } else { &mut b.futs } }
fn spawnLater[F: FnMut[fn() -> Void]](f: escaping F) { let tk = task.spawn(workEsc(f)) }
fn viaOnce[G: FnOnce[fn() -> Int]](g: G) -> Int { g() }
fn both(s: &mut String, f: fn() -> usize) -> usize { s = "z"; f() }
fn bothRev(f: fn() -> usize, s: &mut String) -> usize { s = "z"; f() }
fn bothWrapped(s: &mut String, w: FW) -> usize { s = "z"; w.f() }


-- module --
mir: planned
profile: recoverable-only
-- src --
import map from std/map

type Plain = {
    a Int
}

pure fn Plain.equals(self, other: &Plain) -> Bool {
    self.a == other.a
}

pure fn Plain.hash(self) -> u64 {
    self.a.toU64() || 0
}

// The instance takes the key unboxed, then boxes it to hand it to the shared `append` that stores it.
fn fill() -> Result[Bool, AllocError] {
    let mut m = map.tryEmpty[Plain, Int]()?
    let mut i = 0
    for i < 10 {
        m.trySet(Plain { a: i }, 1)? //~ ERROR `fill` passed the recoverable-only profile as if `Plain` stayed unboxed
        i = i + 1
    }
    Ok(m.len() == 10)
}

fn main() {
    if fill() is Ok(b) {
        let _ = b
    }
}
-- expect --
error[E2313]: `fill` passed the recoverable-only profile as if `Plain` stayed unboxed, yet handing it to a slot that holds a reference allocates a box here that a refused allocation would end the program on; call a form that takes it unboxed, or allocate inside an `allocator` block
  --> main.kg:20:9
   |

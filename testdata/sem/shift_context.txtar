fn main() -> Void! {
    let n: usize = 3
    let x: u32 = 5
    let y: u64 = 7
    let ok1: u32 = (1 << n) + 1
    let ok2: i32 = (-1 << n) + 1
    let ok3 = x + (1 << n)
    let ok4 = (1 << n) < x
    let ok5: i32 = -(1 << n)
    let ok6: i16 = -(-1 << n) + 2
    let ok7: i64 = -(1 << n) * 3
    let up = 1 << n
    let down = -1 << n
    let a: u8 = (1 << n) + 300 //~ ERROR `300` does not fit `u8`
    let b = y + (1 << n) + x //~ ERROR `u64` and `u32` cannot be mixed
    let c: usize = (-1 << n) + 1 //~ ERROR expected `usize`, found `Int`
    let d: u32 = up + 1 //~ ERROR expected `u32`, found `usize`
    let e: i32 = down //~ ERROR expected `i32`, found `Int`
    let z: i32 = 4
    let f: u32 = -(1 << n) //~ ERROR unary `-` on unsigned `u32`
    let g: i64 = -(z << n) //~ ERROR expected `Int`, found `i32`
}

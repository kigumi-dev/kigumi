-- src --
const X: u8 = 200
const Y = X + 100 //~ ERROR `300` does not fit `u8`
const Z: u8 = 255
const W = Z + 1 //~ ERROR `256` does not fit `u8`
const NEG = -X //~ ERROR `-200` does not fit `u8`
const BAD: u16 = X //~ ERROR expected `u16`, found `u8`
const OK = X - 50
const OK2: u8 = 100 + 100
const FLIP = ~X

const ONE: u8 = 1
const S = 1 << -1 //~ ERROR `-1` does not fit `usize`
const T = 1 >> -3 //~ ERROR `-3` does not fit `usize`
const WIDE = ONE << 8 //~ ERROR shift count 8 is out of range for `u8`
const HUGE = 1 << 100000000000 //~ ERROR limited to 65536 bits
const FINE = ONE << 7
const L: Int = 8 >> 70
const M: u32 = 5 >> 40
const N = 8 >> 200
const OKS: Int = 8 >> 2
const FINE2: u16 = 1 << 12

fn use() -> Int {
    let a: u8 = OK
    let b: u8 = FLIP
    let c: u8 = FINE
    a.toInt() + b.toInt() + c.toInt()
}

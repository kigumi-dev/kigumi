const FINE = ONE << 7
const L: Int = 8 >> 70 //~ ERROR `a shift by 70` does not fit `Int`
const M: u32 = 5 >> 40 //~ ERROR `a shift by 40` does not fit `u32`
const N = 8 >> 200 //~ ERROR `a shift by 200`
const OKS: Int = 8 >> 2
const FINE2: u16 = 1 << 12

fn use() -> Int {
    let a: u8 = OK
    let b: u8 = FLIP
    let c: u8 = FINE
    a.toInt() + b.toInt() + c.toInt()
}

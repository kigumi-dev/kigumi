-- module --
mir: planned
-- src --
import task from std/task

interface Bump {
    fn bump(mut self)
    fn get(self) -> Int
}

type Counter = { pub mut n Int }

fn Counter.bump(mut self) {
    self.n = self.n + 1
}

fn Counter.get(self) -> Int {
    self.n
}

async fn acount(c: &mut Bump) -> Int {
    c.bump()
    c.get()
}

async fn aInt(n: Int) -> Int {
    n + 1
}

fn run[T](f: Future[T]) -> T {
    task.currentThreadExecutor().runToCompletion(f)
}

fn swapOut(a: &mut Array[Future[Int]], b: &mut Array[Future[Int]]) {
    match a.takeAt(0) {
        Some(x) -> b.push(x)
        None -> {}
    }
}

fn fw(f: fn(&mut Bump) -> Future[Int], a: &mut Array[Future[Int]], b: &mut Array[Future[Int]], c: &mut Bump) {
    a.push(f(c))
    swapOut(a, b)
}

fn viaValue() -> Array[Future[Int]] {
    let mut c = Counter { n: 5 }
    let mut a = Array.empty[Future[Int]]()
    let mut b = Array.empty[Future[Int]]()
    let w = fw
    w(acount, &mut a, &mut b, &mut c) //~ ERROR an `&Interface` view made in this function lives in its frame and cannot be returned
    b
}

fn viaDirect() -> Array[Future[Int]] {
    let mut c = Counter { n: 5 }
    let mut a = Array.empty[Future[Int]]() //~ ERROR `a` is still borrowed when its scope ends here
    let mut b = Array.empty[Future[Int]]()
    fw(acount, &mut a, &mut b, &mut c) //~ ERROR an `&Interface` view made in this function lives in its frame and cannot be returned //~ ERROR a borrow of `a` cannot be stored back into `a` //~ ERROR a borrow of `b` cannot be stored back into `b`
    b //~ ERROR `b` is borrowed and cannot be moved or dropped here
}

fn local() -> Array[Future[Int]] {
    let mut c = Counter { n: 5 } //~ ERROR `c` is still borrowed when its scope ends here
    let mut a = Array.empty[Future[Int]]()
    let mut b = Array.empty[Future[Int]]()
    a.push(acount(&mut c))
    swapOut(&mut a, &mut b) //~ ERROR an `&Interface` view made in this function lives in its frame and cannot be returned
    b
}

fn fill(c: &Counter, o: &mut Array[Future[Int]]) {
    o.push(aInt(c.n))
}

fn apply(w: fn(&Counter, &mut Array[Future[Int]]) -> Void, c: &Counter, o: &mut Array[Future[Int]]) {
    w(c, o)
}

fn applied() -> Int {
    let mut c = Counter { n: 4 }
    let mut a = Array.empty[Future[Int]]()
    apply(fill, &c, &mut a)
    c = Counter { n: 40 }
    let mut t = 0
    for f in move a {
        t = t + run(f)
    }
    t + c.n
}

fn main() {
    print "applied ${applied()}"
}

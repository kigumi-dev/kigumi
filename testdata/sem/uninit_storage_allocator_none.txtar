-- module --
mir: planned
allocator: none
-- src --
import {AllocatorHandle} from std/alloc
import mem from std/mem

fn scoped(h: AllocatorHandle) -> usize {
    allocator h.scope() {
        let mut b = mem.BoundedArray.new[Int, 2]()
        _ = b.tryPush(1)
        b.len()
    }
}

export(C) {
    pub fn lib_array() -> u64 {
        let b = mem.BoundedArray.new[i64, 2]() //~ ERROR `new` needs the allocator
        b.capacity().truncate[u64]()
    }

    pub fn lib_slot() {
        let _ = mem.uninit[i64]() //~ ERROR `uninit` needs the allocator
    }
}

fn main() -> Void! {}

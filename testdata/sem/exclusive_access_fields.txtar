-- app/t/t.kg --
type Item = {
    pub mut count Int
}

fn Item.update(mut self, d: Int) {
    self.count = self.count + d
}

fn Item.run[F: FnMut[fn() -> Void]](mut self, f: F) {
    f()
}

fn Item.runFn(mut self, f: fn() -> Void) {
    f()
}

fn Item.tick(mut self) {
    self.count = self.count + 1
}

type Pair = {
    pub mut a Item
    pub mut b Item
}

fn Pair.bumpB(mut self) {
    self.b.run(() => { self.a.update(1) })
}

fn Pair.bumpA(mut self) {
    self.a.run(() => { self.a.update(1) }) //~ ERROR a closure argument cannot capture `self`
}

fn disjointWrite() -> Int {
    let mut p = Pair { a: Item { count: 0 }, b: Item { count: 0 } }
    p.a.run(() => { p.b.update(1) })
    p.a.count + p.b.count
}

fn disjointRead() -> Int {
    let mut p = Pair { a: Item { count: 0 }, b: Item { count: 0 } }
    let mut seen = 0
    p.a.run(() => { seen = p.b.count })
    seen
}

fn sameFieldWrite() -> Int {
    let mut p = Pair { a: Item { count: 0 }, b: Item { count: 0 } }
    p.a.run(() => { p.a.update(1) }) //~ ERROR a closure argument cannot capture `p`
    p.a.count
}

fn wholeRootWrite() -> Int {
    let mut p = Pair { a: Item { count: 0 }, b: Item { count: 0 } }
    p.a.run(() => { p = Pair { a: Item { count: 1 }, b: Item { count: 1 } } }) //~ ERROR a closure argument cannot capture `p`
    p.a.count
}

fn touchPair(x: &mut Pair) {
    x.b.count = 1
}

fn wholeRootBorrow() -> Int {
    let mut p = Pair { a: Item { count: 0 }, b: Item { count: 0 } }
    p.a.run(() => { touchPair(&mut p) }) //~ ERROR a closure argument cannot capture `p`
    p.a.count
}

fn disjointNamedClosure() -> Int {
    let mut p = Pair { a: Item { count: 0 }, b: Item { count: 0 } }
    let touch = () => { p.b.update(1) }
    p.a.run(touch)
    p.a.count
}

fn disjointClosureBeforeCall() -> Int {
    let mut p = Pair { a: Item { count: 0 }, b: Item { count: 0 } }
    let touch = () => { p.b.update(1) }
    p.a.tick()
    touch()
    p.a.count + p.b.count
}

fn sameFieldClosureBeforeCall() -> Int {
    let mut p = Pair { a: Item { count: 0 }, b: Item { count: 0 } }
    let touch = () => { p.a.update(1) }
    p.a.tick()
    touch()
    p.a.count
}

fn methodValueOfCopy() -> Int {
    let mut v = Item { count: 0 }
    v.run(v.look)
    v.count
}

fn methodValueIntoFn() -> Int {
    let mut v = Item { count: 0 }
    v.runFn(v.look)
    v.count
}

fn methodValueOfOtherPlace() -> Int {
    let mut v = Item { count: 0 }
    let mut w = Item { count: 0 }
    w.runFn(v.look)
    v.count + w.count
}

fn methodValueOfSiblingField() -> Int {
    let mut p = Pair { a: Item { count: 0 }, b: Item { count: 0 } }
    p.a.runFn(p.b.look)
    p.a.count
}

fn methodValueThroughLet() -> Int {
    let mut v = Item { count: 0 }
    let f = v.look
    v.runFn(f)
    v.count
}

fn methodValueOfSameField() -> Int {
    let mut p = Pair { a: Item { count: 0 }, b: Item { count: 0 } }
    p.a.runFn(p.a.look) //~ ERROR cannot see what this closure captures
    p.a.count
}

fn methodValueOfElement() -> Int {
    let mut xs = Array.of(Item { count: 0 }, Item { count: 0 })
    xs[0].runFn(xs[1].look) //~ ERROR cannot see what this closure captures
    xs[0].count
}

type Big = {
    pub mut count Int
    pub mut items Array[Int]
}

fn Big.tickWith[T](self, d: T) {
    let n = self.count
}

fn Big.runWith(mut self, f: fn(Int) -> Void) {
    f(1)
}

fn methodValueOfMoveOnly() -> Int {
    let mut v = Big { count: 0, items: Array.of(1) }
    v.runWith(v.tickWith) //~ ERROR closure captures `v` (move-only) and cannot be a plain `fn`
    v.count
}

fn Item.look(self) {}

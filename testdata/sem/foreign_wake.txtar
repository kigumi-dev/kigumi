-- app/t/t.kg --
import task from std/task

async fn leaf() -> Int {
    5
}

async fn spawner() -> task.Task[Int] {
    task.spawn(leaf())
}

async fn canceller() -> Int {
    let t = task.spawn(leaf())
    t.cancel()
    1
}

fn stop(t: task.Task[Int]) {
    t.cancel()
}

fn pump(n: Int) -> Int {
    n + 1
}

export(C) {
    pub fn viaHelper() {
        let ex = task.currentThreadExecutor()
        let t = ex.runToCompletion(spawner())
        stop(t) //~ ERROR `viaHelper` is exported to C and reaches `Task.cancel`
    }

    pub fn direct() {
        let ex = task.currentThreadExecutor()
        let t = ex.runToCompletion(spawner())
        t.cancel() //~ ERROR `direct` is exported to C and reaches `Task.cancel`
    }

    pub fn insideTask() -> Int {
        let ex = task.currentThreadExecutor()
        ex.runToCompletion(canceller())
    }

    pub fn unrelated(n: Int) -> Int {
        pump(n)
    }
}

-- expect --

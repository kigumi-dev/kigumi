-- app/t/t.kg --
import task from std/task

async fn work() -> Int {
    0
}

fn syncRoot() -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(work())
}

fn safeFn() -> Int {
    9
}

type Holder = {
    pub mut cb fn() -> Int
}

type Wrap = {
    pub mut inner Holder
}

fn mkRisky() -> Holder {
    Holder { cb: syncRoot }
}

fn mkSafe() -> Holder {
    Holder { cb: safeFn }
}

fn callMut(h: &mut Holder) -> Int {
    h.cb()
}

async fn riskyCopy() -> Int {
    let w = Wrap { inner: Holder { cb: syncRoot } }
    let mut w2 = w
    w2.inner.cb() //~ ERROR cannot run inside an `async fn`
}

async fn safeCopy() -> Int {
    let w = Wrap { inner: Holder { cb: safeFn } }
    let mut w2 = w
    w2.inner.cb()
}

async fn riskyCopyChain() -> Int {
    let w = Wrap { inner: Holder { cb: syncRoot } }
    let mut a = w
    let mut b = a
    b.inner.cb() //~ ERROR cannot run inside an `async fn`
}

async fn safeCopyChain() -> Int {
    let w = Wrap { inner: Holder { cb: safeFn } }
    let mut a = w
    let mut b = a
    b.inner.cb()
}

async fn riskyCopyField() -> Int {
    let w = Wrap { inner: Holder { cb: syncRoot } }
    let mut h = w.inner
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn safeCopyField() -> Int {
    let w = Wrap { inner: Holder { cb: safeFn } }
    let mut h = w.inner
    h.cb()
}

async fn riskyCopyWrite() -> Int {
    let w = Wrap { inner: Holder { cb: safeFn } }
    let mut h = w.inner
    h.cb = syncRoot
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn riskySourceWrittenLater() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    let mut h = w.inner
    w.inner.cb = syncRoot
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn riskyBorrowedCopy() -> Int {
    let w = Wrap { inner: Holder { cb: syncRoot } }
    let mut h = w.inner
    callMut(&mut h) //~ ERROR cannot run inside an `async fn`
}

async fn safeBorrowedCopy() -> Int {
    let w = Wrap { inner: Holder { cb: safeFn } }
    let mut h = w.inner
    callMut(&mut h)
}

async fn riskyWholeAssign() -> Int {
    let mut h = Holder { cb: safeFn }
    h = mkRisky()
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn safeWholeAssign() -> Int {
    let mut h = Holder { cb: safeFn }
    h = mkSafe()
    h.cb()
}

async fn riskyWholeAssignLocal() -> Int {
    let mut h = Holder { cb: safeFn }
    let g = Holder { cb: syncRoot }
    h = g
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn safeWholeAssignLocal() -> Int {
    let mut h = Holder { cb: safeFn }
    let g = Holder { cb: safeFn }
    h = g
    h.cb()
}

async fn riskyMutResult() -> Int {
    let mut h = mkRisky()
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn safeMutResult() -> Int {
    let mut h = mkSafe()
    h.cb()
}


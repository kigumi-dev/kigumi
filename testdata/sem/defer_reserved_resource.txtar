-- lib/reserved.kg --
type Handle = resource {
    pub id Int
}

fn Handle.drop(move self) -> Unit {}

fn Handle.close(move self) -> Unit {}

fn Handle.peek(self) -> Int {
    self.id
}

fn take(h: Handle) -> Unit {}

fn reassign() -> Unit! {
    let mut h = Handle { id: 1 }
    defer { h.close() }
    h = Handle { id: 2 } //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be assigned
}

fn reassignErrdefer() -> Unit! {
    let mut h = Handle { id: 1 }
    defer(fail) { h.close() }
    h = Handle { id: 2 } //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be assigned
}

fn moveByCall() -> Unit! {
    let h = Handle { id: 1 }
    defer { h.close() }
    take(h) //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
}

fn moveByLet() -> Unit! {
    let h = Handle { id: 1 }
    defer { h.close() }
    let g = h //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
    take(g)
}

fn moveByClose() -> Unit! {
    let h = Handle { id: 1 }
    defer { h.close() }
    h.close() //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
}

fn moveIntoRecord() -> Unit! {
    let h = Handle { id: 1 }
    defer { take(h) }
    let b = Wrapper { inner: h } //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
    _ = b.inner.peek()
}

type Wrapper = {
    pub inner Handle
}

fn secondCleanupSameScope() -> Unit! {
    let h = Handle { id: 1 }
    defer { h.close() }
    defer { take(h) } //~ ERROR `h` is already consumed by an earlier cleanup
}

fn secondCleanupNestedScope() -> Unit! {
    let h = Handle { id: 1 }
    defer(fail) { h.close() }
    if h.peek() > 0 {
        defer { take(h) } //~ ERROR `h` is already consumed by an earlier cleanup
    }
}

fn reservedInsideConditionalScope(flag: Bool) -> Unit! {
    let mut h = Handle { id: 1 }
    if flag {
        defer(fail) { h.close() }
        h = Handle { id: 2 } //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be assigned
    }
}

fn parameterIsReserved(h: Handle) -> Unit {
    defer { h.close() }
    take(h) //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
}

fn peekingCleanupDoesNotReserve() -> Unit! {
    let mut h = Handle { id: 1 }
    defer { _ = h.peek() }
    h = Handle { id: 2 }
}

fn reservationEndsWithItsScope(flag: Bool) -> Unit! {
    let mut h = Handle { id: 1 }
    if flag {
        defer(fail) { h.close() }
    }
    h = Handle { id: 2 }
    take(h)
}

fn localInsideCleanupIsNotReserved() -> Unit! {
    defer {
        let t = Handle { id: 9 }
        t.close()
    }
    let t = Handle { id: 1 }
    take(t)
}

fn borrowsStayLegal() -> Unit! {
    let h = Handle { id: 1 }
    defer { h.close() }
    let n = h.peek()
    _ = n
}

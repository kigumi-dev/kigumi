type E = Add(a: Int, b: Int) | Plain(Int)

fn use() {
    let ok = Add(b: 1, a: 2)
    let mixed = Add(1, b: 2)
    let unknown = Add(a: 1, c: 2) //~ ERROR `Add` has no parameter named `c`
    let dup = Add(a: 1, a: 2) //~ ERROR argument `a` given more than once
    let late = Add(a: 1, 2) //~ ERROR positional argument after a named argument
    let few = Add(a: 1) //~ ERROR `Add` takes 2 payload values, 1 given
    let plain = Plain(v: 1) //~ ERROR `Plain` has no parameter named `v`
    let wrong = Add(a: "x", b: 1) //~ ERROR expected `Int`, found `String`
}

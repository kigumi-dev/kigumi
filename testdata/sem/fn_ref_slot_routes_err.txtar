pub type V['a] = { pub s &'a String }
pub type Sink['a] = { pub mut items &'a mut Array[V['a]] }
fn keep['a](x: &'a String, k: Sink['a]) { k.items.push(V { s: x }) }
fn nop['a](x: &'a String, k: Sink['a]) { }
fn mkKeep['a](n: Int) -> fn(&'a String, Sink['a]) -> Void { keep }
fn mkNop['a](n: Int) -> fn(&'a String, Sink['a]) -> Void { nop }
fn mkMkKeep['a](n: Int) -> fn(Int) -> fn(&'a String, Sink['a]) -> Void { mkKeep }
fn mkMkNop['a](n: Int) -> fn(Int) -> fn(&'a String, Sink['a]) -> Void { mkNop }
fn drive['a, F: Fn[fn(&String, Sink['a]) -> Void]](f: F, k: Sink['a]) {
    let loc = "local-${40 + 2}"
    f(&loc, k)
}
pub type Box[F] = { pub cb F }
pub type Runner['a, F: Fn[fn(&String, Sink['a]) -> Void]] = { pub mut cb F }
pub type RunnerN['a, F: Fn[fn(Int) -> fn(&String, Sink['a]) -> Void]] = { pub mut cb F }
pub type Outer['a, F: Fn[fn(&String, Sink['a]) -> Void]] = { pub b Box[F] }
pub type OuterN['a, F: Fn[fn(Int) -> fn(&String, Sink['a]) -> Void]] = { pub b Box[F] }
pub type Cb['a, F: Fn[fn(&String, Sink['a]) -> Void]] = Has(b: Box[F]) | NoCb
pub type CbN['a, F: Fn[fn(Int) -> fn(&String, Sink['a]) -> Void]] = HasN(b: Box[F]) | NoCbN
pub type HN['a] = { pub n Int }
fn HN['a].run[F: Fn[fn(&String, Sink['a]) -> Void]](self, f: F, k: Sink['a]) {
    let loc = "local-${40 + 2}"
    f(&loc, k)
}
fn HN['a].runN[F: Fn[fn(Int) -> fn(&String, Sink['a]) -> Void]](self, f: F, k: Sink['a]) { }
fn mapO[U, F: Fn[fn(Int) -> U]](o: Option[F], t: Int) -> Option[U] { if o is Some(f) { Some(f(t)) } else { None } }
fn runB['a, F: Fn[fn(&String, Sink['a]) -> Void]](b: Box[F], k: Sink['a]) { drive(b.cb, k) }
fn runBN['a, F: Fn[fn(Int) -> fn(&String, Sink['a]) -> Void]](b: Box[F], k: Sink['a]) { }
fn runO['a, F: Fn[fn(&String, Sink['a]) -> Void]](o: Option[F], k: Sink['a]) { if o is Some(f) { drive(f, k) } }
fn runIt['a, F: Fn[fn(&String, Sink['a]) -> Void]](r: Runner['a, F], k: Sink['a]) { drive(r.cb, k) }
fn runItN['a, F: Fn[fn(Int) -> fn(&String, Sink['a]) -> Void]](r: RunnerN['a, F], k: Sink['a]) { }
fn twoLevelT['a, F: Fn[fn(&String, Sink['a]) -> Void], G: Fn[fn(Int) -> F]](g: G, k: Sink['a]) {
    let f = g(3)
    let loc = "local-${40 + 2}"
    f(&loc, k)
}
fn twoLevelO[U, F: Fn[fn(Int) -> U], G: Fn[fn(Int) -> F]](g: G, t: Int) -> Option[U] { let f = g(t); Some(f(t)) }

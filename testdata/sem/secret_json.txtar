-- module --
stage: driver
-- src --
import secret from std/secret
import json from std/json

type Holder = {
    pub name String
    pub key secret.SecretU32
}

type Wrapper[T] = {
    pub v T
}

let a = secret.SecretU32.classify(1)
let c = secret.SecretU16.classify(1).ctEq(secret.SecretU16.classify(1))
let buf = secret.SecretBuffer.fromString("hunter2")

// JSON has no rendering of a secret: encoding one is refused rather than
// declassifying it, and a container that holds one is refused with it.
let e1 = json.encode(a) //~ ERROR does not satisfy `Encode`
let e2 = json.encode(c) //~ ERROR does not satisfy `Encode`
let e3 = json.encode(buf) //~ ERROR does not satisfy `Encode`
let e4 = json.encode(Holder { name: "n", key: a }) //~ ERROR does not satisfy `Encode`
let e5 = json.encodeRef(&a) //~ ERROR does not satisfy `Encode`
let e6 = json.encode(Array.of[secret.SecretU8](secret.SecretU8.classify(1))) //~ ERROR has no `toJson`
let e7 = json.encode(Wrapper[secret.SecretU8] { v: secret.SecretU8.classify(1) }) //~ ERROR has no `toJson`
let d1 = json.decode[secret.SecretU32]("1") //~ ERROR does not satisfy `Decode`
let d2 = json.decode[Holder]("{}") //~ ERROR does not satisfy `Decode`
-- expect --
error[E300]: `SecretU32` does not satisfy `Encode`: missing `fn toJson(self) -> Value`
  --> main.kg:19:10
   |
19 | let e1 = json.encode(a) //~ ERROR does not satisfy `Encode`
   |          ^^^^^^^^^^^^^

error[E300]: `Choice` does not satisfy `Encode`: missing `fn toJson(self) -> Value`
  --> main.kg:20:10
   |
20 | let e2 = json.encode(c) //~ ERROR does not satisfy `Encode`
   |          ^^^^^^^^^^^^^

error[E300]: `SecretBuffer` does not satisfy `Encode`: missing `fn toJson(self) -> Value`
  --> main.kg:21:10
   |
21 | let e3 = json.encode(buf) //~ ERROR does not satisfy `Encode`
   |          ^^^^^^^^^^^^^^^

error[E300]: `Holder` does not satisfy `Encode`: missing `fn toJson(self) -> Value`
  --> main.kg:22:10
   |
22 | let e4 = json.encode(Holder { name: "n", key: a }) //~ ERROR does not satisfy `Encode`
   |          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

error[E300]: `SecretU32` does not satisfy `Encode`: missing `fn toJson(self) -> Value`
  --> main.kg:23:10
   |
23 | let e5 = json.encodeRef(&a) //~ ERROR does not satisfy `Encode`
   |          ^^^^^^^^^^^^^^^^^

error[E964]: `SecretU8` has no `toJson` to pass for `Encode` and none could be generated
  --> main.kg:24:10
   |
24 | let e6 = json.encode(Array.of[secret.SecretU8](secret.SecretU8.classify(1))) //~ ERROR has no `toJson`
   |          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

error[E964]: `SecretU8` has no `toJson` to pass for `Encode` and none could be generated
  --> main.kg:25:10

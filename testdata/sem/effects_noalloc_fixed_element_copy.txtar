-- module --
mir: planned
-- src --
type Pt = {
    pub mut x Int
    pub mut y Int
}

type Inner = {
    pub mut p Pt
    pub mut on Bool
}

type Named = {
    pub mut name String
    pub mut n Int
}

noalloc fn copyScalar(xs: &mut FixedArray[Int, 2]) -> Unit {
    xs[0] = xs[1]
}

noalloc fn copyRecord(xs: &mut FixedArray[Pt, 2]) -> Unit {
    xs[0] = xs[1]
}

noalloc fn copyNested(xs: &mut FixedArray[Inner, 2]) -> Unit {
    xs[1] = xs[0]
}

noalloc fn copyAcross(dst: &mut FixedArray[Pt, 2], src: &FixedArray[Pt, 2]) -> Unit {
    dst[0] = src[1]
}

noalloc fn copyParen(xs: &mut FixedArray[Pt, 2]) -> Unit {
    xs[0] = (xs[1])
}

noalloc fn copyLocal() -> Int {
    let mut xs = FixedArray.filled[Pt, 2](Pt { x: 1, y: 2 })
    xs[0] = xs[1]
    xs[0].x
}

fn main() -> Unit! {}
-- expect --

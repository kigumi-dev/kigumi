-- module --
mir: planned
-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn Res.close(move self) {}

fn eat(r: Res) {}

fn arrayThenFallback(x: Res, y: Res) -> Res {
    let mut a = Array.of(x, y)
    a.takeAt(1) || x //~ ERROR `x` was moved
}

fn sharedAfterFallback(o: Res?, x: Res) -> Res {
    let r = o || x
    eat(x) //~ ERROR `x` is moved on some paths but not others
    r
}

fn fallbackPerIteration(x: Res) {
    for i in 0..2 {
        let o: Res? = None
        eat(o || x) //~ ERROR earlier iteration of the loop
    }
}

fn closeThenFallback(o: Res?, x: Res) -> Res {
    x.close()
    o || x //~ ERROR `x` was moved
}

fn closureAfterClose(o: Res?, x: Res) -> Res {
    x.close()
    let f = () => o || x //~ ERROR `x` was moved
    f()
}

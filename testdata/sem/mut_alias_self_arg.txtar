type Reader = { v Int, mut w Int }

fn Reader.peek(self, y: &mut Int) {
    y = y + self.v
}

fn sharedSelfFieldArg() {
    let mut r = Reader { v: 1, w: 2 }
    r.peek(&mut r.w) //~ ERROR this argument may target storage this call's receiver already mutates
}

fn disjointLocalOk() {
    let mut b = Box { v: 1, w: 2 }
    let mut y = 7
    b.touch(&mut y)
}

fn differentObjectOk() {
    let mut b = Box { v: 1, w: 2 }
    let mut c = Box { v: 10, w: 20 }
    b.touch(&mut c.v)
}

fn sharedSelfDisjointOk() {

type Box = { mut v Int, mut w Int }

fn Box.touch(mut self, y: &mut Int) {
    self.v = self.v + 1
    y = y + 100
}

fn fieldArg() {
    let mut b = Box { v: 1, w: 2 }
    b.touch(&mut b.v) //~ ERROR this argument may target storage this call's receiver already mutates
}

type Inner = { mut x Int }
type Box2 = { mut v Int, mut inner Inner }


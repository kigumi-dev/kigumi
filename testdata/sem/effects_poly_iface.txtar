-- lib/poly_iface.kg --
pub interface Viewer {
    pure? fn view(self, x: Int) -> Int
}

@impl(Viewer)
pub type PureV = {
    pub tag Int
}

pub pure fn PureV.view(self, x: Int) -> Int {
    x + self.tag
}

@impl(Viewer)
pub type ImpureV = {
    pub tag Int
}

pub fn ImpureV.view(self, x: Int) -> Int {
    x + self.tag
}

pure fn callView(v: Viewer, x: Int) -> Int { //~ ERROR dropping `Viewer` is not `pure`
    v.view(x) //~ ERROR requirement `view` of `Viewer` is not `pure`
}

// A `pure?` requirement called through the callee's own type parameter defers to
// each instantiation's resolved witness, unlike the existential `v: Viewer` above.
fn callViewGeneric[T: Viewer](t: T, x: Int) -> Int {
    t.view(x)
}

pure fn callGenericPure(x: Int) -> Int {
    callViewGeneric(PureV { tag: 1 }, x)
}

pure fn callGenericImpure(x: Int) -> Int {
    callViewGeneric(ImpureV { tag: 1 }, x) //~ ERROR `callViewGeneric` may be impure
}

// Erasing the generic function itself to a fixed-effect fn value has no call-site
// type argument left to resolve the witness against.
fn erasedGenericWitness() -> Int {
    let g: pure fn(PureV, Int) -> Int = callViewGeneric //~ ERROR `callViewGeneric` is not `pure` (calls `T.view`) //~ ERROR `callViewGeneric` has interface-bounded type parameters
    g(PureV { tag: 1 }, 1)
}

pure? fn notARequirement(x: Int) -> Int { //~ ERROR `pure?` is only allowed on an interface requirement
    x
}

// A generic wrapper's own `pure fn` declaration defers to ITS type parameter's
// witness in turn, recursing witnessArgMods over a WitnessBind's own CalledWitnessReqs.
@impl(Viewer)
pub type Wrap[T: Viewer] = {
    pub inner T
}

pub pure fn Wrap[T].view(self, x: Int) -> Int {
    self.inner.view(x)
}

pure fn wrapPure(x: Int) -> Int {
    callViewGeneric(Wrap { inner: PureV { tag: 1 } }, x)
}

pure fn wrapImpure(x: Int) -> Int {
    callViewGeneric(Wrap { inner: ImpureV { tag: 1 } }, x) //~ ERROR `callViewGeneric` may be impure
}

-- src --
import task from std/task

fn blocking(x: Int) -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(later(x))
}

fn idb[T](x: T) -> T {
    let _ = blocking(1)
    x
}

async fn later(x: Int) -> Int {
    x
}

type W = { pub f fn(Int) -> Int }

async fn go() -> Int {
    let v = W { f: idb[Int] }
    v.f(2) //~ ERROR `runToCompletion` cannot run inside an `async fn`
}

-- app/a/a.kg --
pub type Guard = {
    pub mut amount Int
}

fn Guard.grow(mut self, k: Int) -> Unit {
    self = Guard { amount: k }
}
-- app/b/b.kg --
pub interface Grower {
    fn grow(mut self, k: Int) -> Unit
}

fn growViaBorrowedParam[G: Grower](g: &mut G, k: Int) -> Unit {
    g.grow(k) //~ ERROR can be witnessed by `Guard.grow`
}

-- app/a/a.kg --
import b from app/b

pub type Guard = {
    pub mut amount Int
}

fn Guard.grow(mut self, k: Int) -> Unit {
    self = Guard { amount: k }
}

pub fn growHere(g: &mut Guard, k: Int) -> Unit {
    b.growViaBorrowedParamIsFine(g, k)
}
-- app/b/b.kg --
pub interface Grower {
    fn grow(mut self, k: Int) -> Unit
}

pub fn growViaBorrowedParamIsFine[G: Grower](g: &mut G, k: Int) -> Unit {
    g.grow(k)
}

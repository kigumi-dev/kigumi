// Accepted: variadic callbacks that are only called, or declared `...escaping`.
fn callsInLoop(cbs: ...fn() -> Unit) -> Int {
    let mut n = 0
    for cb in cbs {
        cb()
        n += 1
    }
    n
}

fn callsBound[F: Fn[fn() -> Unit]](cbs: ...F) -> Int {
    let mut n = 0
    for cb in cbs {
        cb()
        n += 1

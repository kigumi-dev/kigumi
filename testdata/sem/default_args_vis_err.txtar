fn secret() -> Int { 40 }
const HIDDEN = 2
type Hid = { pub n Int }
fn Hid.double(self) -> Int { self.n * 2 }
pub const SHOWN: Int = 3
pub fn shown() -> Int { 1 }

pub fn viaFn(a: Int = secret()) -> Int { a } //~ ERROR less visible `secret`
pub fn viaConst(a: Int = HIDDEN) -> Int { a } //~ ERROR less visible `HIDDEN`
pub fn viaMethod(a: Int = Hid { n: 1 }.double()) -> Int { a } //~ ERROR less visible `double`
pub fn viaPub(a: Int = shown() + SHOWN) -> Int { a }
fn private(a: Int = secret() + HIDDEN) -> Int { a }

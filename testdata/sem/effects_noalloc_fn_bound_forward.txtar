-- src --
type Nm = {
    pub name String
    pub mut n Int
}

fn mkn(x: Int) -> Nm { Nm { name: "b", n: x } }

fn plainFn(x: Int) -> Int { mkn(x).n }

noalloc fn cheap(x: Int) -> Int { x + 1 }

pure fn spotless(x: Int) -> Int { x * 2 }

noalloc fn applyGen[F: Fn[noalloc fn(Int) -> Int]](f: F, v: Int) -> Int {
    f(v)
}

pure fn applyPure[F: Fn[pure fn(Int) -> Int]](f: F, v: Int) -> Int {
    f(v)
}

noalloc pure fn applyBoth[F: Fn[noalloc pure fn(Int) -> Int]](f: F, v: Int) -> Int {
    f(v)
}

fn okNoalloc[G: Fn[noalloc fn(Int) -> Int]](g: G) -> Int { applyGen(g, 1) }

fn okPure[G: Fn[pure fn(Int) -> Int]](g: G) -> Int { applyPure(g, 1) }

fn okBoth[G: Fn[noalloc pure fn(Int) -> Int]](g: G) -> Int {
    applyGen(g, 1) + applyPure(g, 1) + applyBoth(g, 1)
}

fn okWider[G: Fn[noalloc pure fn(Int) -> Int]](g: G) -> Int { applyGen(g, 1) }

fn badNoalloc[G: Fn[fn(Int) -> Int]](g: G) -> Int { applyGen(g, 1) } //~ ERROR `G` cannot be used as `noalloc fn(Int) -> Int`

fn badPure[G: Fn[fn(Int) -> Int]](g: G) -> Int { applyPure(g, 1) } //~ ERROR `G` cannot be used as `pure fn(Int) -> Int`

fn badOnlyPure[G: Fn[pure fn(Int) -> Int]](g: G) -> Int { applyGen(g, 1) } //~ ERROR `G` cannot be used as `noalloc fn(Int) -> Int`

fn badOnlyNoalloc[G: Fn[noalloc fn(Int) -> Int]](g: G) -> Int { applyPure(g, 1) } //~ ERROR `G` cannot be used as `pure fn(Int) -> Int`

fn badBoth[G: Fn[noalloc fn(Int) -> Int]](g: G) -> Int { applyBoth(g, 1) } //~ ERROR `G` cannot be used as `pure noalloc fn(Int) -> Int`

fn badChain[G: Fn[fn(Int) -> Int]](g: G) -> Int { okNoalloc(g) } //~ ERROR `G` cannot be used as `noalloc fn(Int) -> Int`

fn useItems() -> Int {
    okNoalloc(cheap) + okNoalloc((x: Int) => x + 2) + okPure(spotless) //~ ERROR closure is not `noalloc` (allocates)
}

fn badItem() -> Int { okNoalloc(plainFn) } //~ ERROR `plainFn` is not `noalloc`

fn badClosure() -> Int { okNoalloc((x: Int) => mkn(x).n) } //~ ERROR closure is not `noalloc`

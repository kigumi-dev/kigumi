-- module --
stage: driver
mir: planned
-- src --
import task from std/task

async fn worker(mut xs: &mut Array[Int]) {
    xs.push(9)
}

async fn parent() -> Int {
    let mut xs = Array.of(1)
    {
        let child = task.spawn(worker(&mut xs))
        _ = child
    }
    xs.push(2)
    xs.len().toInt() || 0
}

fn main() {}

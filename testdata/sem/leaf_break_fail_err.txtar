-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn mk(id: Int) -> Res {
    Res { id: id }
}

fn eat(r: Res) {}

type Guard = resource {
    pub a Res
}

fn Guard.drop(move self) {}

fn mkg(i: Int) -> Guard {
    Guard { a: mk(i) }
}

type Cell = {
    pub v Res
}

type H['a] = {
    pub r &'a Cell
}

fn me(c: &Cell) -> &Cell {
    c
}

fn breakTemp() -> Res {
    for {
        break mkg(1).a //~ ERROR cannot move `mkg(1).a` out of `Guard`
    }
}

fn breakOwned(c: Cell) -> Res {
    let r = for {
        break c.v //~ ERROR reading `c.v` by value
    }
    r
}

fn breakLink['a](h: H['a]) -> Res {
    for {
        break h.r.v //~ ERROR reading `h.r.v` by value
    }
}

fn breakArg() {
    eat(for {
        break mkg(2).a //~ ERROR cannot move `mkg(2).a` out of `Guard`
    })
}

fn breakOr(o: Res?) -> Res {
    o || for {
        break mkg(3).a //~ ERROR cannot move `mkg(3).a` out of `Guard`
    }
}

fn breakInClosure() -> Res {
    let f = () => for {
        break mkg(4).a //~ ERROR cannot move `mkg(4).a` out of `Guard`
    }
    f()
}

fn failTemp() -> Result[Int, Res] {
    fail mkg(5).a //~ ERROR cannot move `mkg(5).a` out of `Guard`
}

fn failLink['a](h: H['a]) -> Result[Int, Res] {
    fail h.r.v //~ ERROR reading `h.r.v` by value
}

fn failCall(c: &Cell) -> Result[Int, Res] {
    fail me(c).v //~ ERROR reading `me(c).v` by value
}

fn failOr(o: Res?) -> Result[Int, Res] {
    let r = o || fail mkg(6).a //~ ERROR cannot move `mkg(6).a` out of `Guard`
    Ok(r.id)
}

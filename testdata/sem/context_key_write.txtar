-- src --
import lib from lib

type Point = {
    pub mut x Int
}

fn Point.shift(mut self) {
    self.x = self.x + 1
}

type Shape = Circle(r: Int) | Dot

fn Shape.flatten(mut self) {
    self = Dot
}

type Log = {
    pub mut lines Array[String]
}

fn Log.reset(mut self) {
    self = Log { lines: Array.empty() }
}

fn Log.add(mut self, s: String) {
    self.lines.push(s)
}

context port: Int
context origin: Point
context log: Log

@provides(port, origin, log)
type Env = {
    pub mut port Int
    pub mut origin Point
    pub mut log Log
}

fn bump(p: &mut Int) {
    p = p + 1
}

fn inCallee() {
    port = 9 //~ ERROR context key `port` cannot be assigned
    port += 1 //~ ERROR context key `port` cannot be assigned
    origin.x = 3 //~ ERROR context key `origin` cannot be written through a field or element
    origin.shift() //~ ERROR context key `origin` cannot be the receiver of `mut self` method `shift`
    bump(&mut port) //~ ERROR context key `port` cannot be borrowed with `&mut`
    log = Log { lines: Array.empty() } //~ ERROR context key `log` cannot be assigned
    log.reset() //~ ERROR this receiver is lent with no owner to return it to
    log.add("ok")
    log.lines.push("ok")
}

fn qualified() {
    lib.token = "x" //~ ERROR context key `token` cannot be assigned
}

context (Env { port: 5, origin: Point { x: 0 }, log: Log { lines: Array.empty() } }) {
    port = 7 //~ ERROR context key `port` cannot be assigned
    origin.x = 1 //~ ERROR context key `origin` cannot be written through a field or element
    log.add("ok")
    inCallee()
    context (lib.Bundle { token: "t" }) {
        qualified()
    }
}
-- lib/lib.kg --
pub context token: String

@provides(token)
pub type Bundle = {
    pub mut token String
}

type Resource = resource {
    pub mut count Int
}
fn Resource.drop(move self) -> Unit {}

fn Resource.run[F: FnMut[fn() -> Unit]](mut self, f: F) -> Unit {
    f()
}

fn mutate(x: &mut Resource) -> Unit {
    x.count = 99
}

fn reenter(mut v: Resource, f: fn() -> Unit) -> Unit {
    v.run(f) //~ ERROR cannot see what this closure captures
}

fn forward[G: FnMut[fn() -> Unit]](mut v: Resource, g: G) -> Unit {
    v.run(g) //~ ERROR cannot see what this closure captures
}

fn forwardAlias[G: FnMut[fn() -> Unit]](mut v: Resource, g: G) -> Unit {
    let g2 = g
    v.run(g2) //~ ERROR cannot see what this closure captures
}

fn doNothing() -> Unit {}

fn viaTopLevelFnParam(mut v: Resource, unused: fn() -> Unit) -> Unit {
    v.run(doNothing)
}

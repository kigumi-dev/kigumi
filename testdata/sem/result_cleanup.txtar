-- lib/cl.kg --
import fs from std/fs

fn write(files: fs.Files, path: fs.Path) -> Void! {
    let mut f = files.create(path)?
    defer(fail) _ = files.remove(path)
    defer _ = files.remove(path)
    defer {
        _ = files.remove(path)
    }
    _ = f.write("x".toBytes())?
    f.close()?
}

fn bad(files: fs.Files, path: fs.Path) -> Void! {
    defer files.remove(path)? //~ ERROR `?` is not allowed in a cleanup body
    defer files.remove(path) //~ ERROR unused `Void!`
    defer return //~ ERROR `return` is not allowed in a cleanup body
    defer(fail) fail Empty //~ ERROR `fail` is not allowed in a cleanup body //~ ERROR undefined name `Empty`
    for i in 0..3 {
        defer break //~ ERROR `break` is not allowed in a cleanup body
    }
}

fn noFail() {
    defer(fail) _ = 1 //~ ERROR `defer(fail)` in a function that cannot fail
}

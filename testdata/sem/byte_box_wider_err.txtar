-- module --
stage: driver
profile: recoverable-only
-- src --
import mem from std/mem
import {Arena} from std/alloc

fn main() {
    match Arena.tryCreate() {
        Ok(h) -> {
            let cell = allocator h.scope() { mem.UnsafeCell.new[u16](60000) }
            _ = unsafe { cell.atomicLoad(mem.AtomicOrder.Relaxed) }
        }
        Err(_) -> {}
    }
}

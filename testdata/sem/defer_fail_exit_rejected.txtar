-- src --
import test from std/test

type Handle = resource {
    pub id Int
}

fn Handle.drop(move self) {}

fn Handle.close(move self) {}

fn take(h: Handle) {}

fn step() -> Void! {}

fn num() -> Int! {
    1
}

fn wrapR(h: Handle) -> Handle! {
    h
}

type Pair = {
    pub h Handle
    pub n Int
}

fn moveThenFail() -> Void! {
    let h = Handle { id: 1 }
    defer(fail) { h.close() }
    take(h) //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
    step()?
}

fn tailMoveBeforeTry() -> Pair! {
    let h = Handle { id: 1 }
    defer(fail) { h.close() }
    Pair { h: h, n: num()? } //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
}

fn returnMoveBeforeTry() -> Pair! {
    let h = Handle { id: 1 }
    defer(fail) { h.close() }
    return Pair { h: h, n: num()? } //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
}

fn tailReturnsResult() -> Handle! {
    let h = Handle { id: 1 }
    defer(fail) { h.close() }
    wrapR(h) //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
}

fn conditionalMoveThenFail(flag: Bool) -> Handle! {
    let h = Handle { id: 1 }
    defer(fail) { h.close() }
    if flag { h } else { fail test.failure("no") } //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
}

fn branchMayBeErr(flag: Bool) -> Handle! {
    let h = Handle { id: 1 }
    defer(fail) { h.close() }
    if flag { h } else { wrapR(Handle { id: 2 }) } //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
}

fn okBeforeTry() -> Pair! {
    let h = Handle { id: 1 }
    defer(fail) { h.close() }
    return Ok(Pair { h: h, n: num()? }) //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
}

fn moveInsideLoop(n: Int) -> Void! {
    let h = Handle { id: 1 }
    defer(fail) { h.close() }
    for i in 0..n {
        take(h) //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
    }
    step()?
}

fn reassign() -> Handle! {
    let mut h = Handle { id: 1 }
    defer(fail) { h.close() }
    h = Handle { id: 2 } //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be assigned
    h
}

fn consumedTwice() -> Handle! {
    let h = Handle { id: 1 }
    defer(fail) { h.close() }
    defer { take(h) } //~ ERROR `h` is already consumed by an earlier cleanup
    h //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
}

fn plainDeferKeepsReservation() -> Handle! {
    let h = Handle { id: 1 }
    defer { h.close() }
    h //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
}

fn bodyCheckedWithoutFailureExit() -> Void! {
    let h = Handle { id: 1 }
    defer(fail) {
        let s: String = h.id //~ ERROR expected `String`, found `Int`
        h.close()
    }
}

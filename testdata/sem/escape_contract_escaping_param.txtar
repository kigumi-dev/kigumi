-- lib/esc.kg --
pub type Handler[F] = { pub callback F }

fn runNow[F: Fn[fn() -> Unit]](callback: F) -> Unit {
    callback()
}

fn keep[F: Fn[fn() -> Unit]](callback: escaping F) -> Handler[F] {
    Handler { callback: callback }
}

fn giveBack[F: Fn[fn() -> Unit]](callback: escaping F) -> F {
    callback
}

fn wrap[F: Fn[fn() -> Unit] + Copy](callback: escaping F) -> fn() -> Unit {
    () => callback()
}

fn stash(cb: escaping fn() -> Unit) -> Handler[fn() -> Unit] {
    Handler { callback: cb }
}

fn wrapAndStash[F: Fn[fn() -> Unit] + Copy](callback: escaping F) -> Handler[fn() -> Unit] {
    stash(() => callback())
}

type Callback = alias fn() -> Unit

fn keepAlias(callback: escaping Callback) -> fn() -> Unit {
    callback
}

fn forward[F: Fn[fn() -> Unit]](callback: escaping F) -> Handler[F] {
    keep(callback)
}

fn viaRegister[F: Fn[fn() -> Unit]](register: fn(escaping F) -> Unit, callback: escaping F) -> Unit {
    register(callback)
}

fn useAll(cb: fn() -> Unit) -> Unit {
    runNow(cb)
    let h = keep(() => {})
    h.callback()
}

pub interface Registry[F: Fn[fn() -> Unit]] {
    fn add(self, callback: escaping F) -> Handler[F]
}

@impl(Registry[F])
pub type Slots[F: Fn[fn() -> Unit]] = {
    pub n Int
}

pub fn Slots[F].add(self, callback: escaping F) -> Handler[F] {
    Handler { callback: callback }
}

fn register[F: Fn[fn() -> Unit], R: Registry[F]](r: R, callback: escaping F) -> Handler[F] {
    r.add(callback)
}
pub interface Observer[F: Fn[fn() -> Unit]] {
    fn watch(self, callback: escaping F) -> Unit
}

// An implementation may be more conservative than its requirement.
@impl(Observer[F])
pub type Quiet[F: Fn[fn() -> Unit]] = {
    pub n Int
}

pub fn Quiet[F].watch(self, callback: F) -> Unit {
    runNow(() => {})
}
pub fn pinned() -> fn(escaping fn() -> Unit) -> Handler[fn() -> Unit] {
    keep
}

pub fn annotated() -> Handler[fn() -> Unit] {
    let k: fn(escaping fn() -> Unit) -> Handler[fn() -> Unit] = keep
    k(() => {})
}

pub fn forwarded(callback: escaping fn() -> Unit) -> Handler[fn() -> Unit] {
    keep(callback)
}
-- expect --

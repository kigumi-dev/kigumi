-- module --
mir: planned
-- src --
type Handle = resource {
    pub mut id Int
}

fn Handle.drop(move self) {}

fn Handle.close(move self) {}

fn Handle.peek(self) -> Int {
    self.id
}

fn Handle.bump(mut self) {
    self.id = self.id + 1
}

type Pack = {
    pub mut inner Handle
    pub mut other Handle
    pub mut n Int
}

type Slot = {
    pub keep fn() -> Int
}

fn mkh(n: Int) -> Handle {
    Handle { id: n }
}

fn mk() -> Pack {
    Pack { inner: mkh(1), other: mkh(2), n: 0 }
}

fn pair() -> (Handle, Handle) {
    (mkh(1), mkh(2))
}

fn show(h: &Handle) {}

fn sink(n: Int) {}

fn take[T](x: T) {}

fn reset(p: &mut Handle) {
    p = mkh(9)
}

fn apply(f: fn() -> Int) -> Int {
    f()
}

fn store(f: escaping fn() -> Int) {}

fn keep[T](x: T) {}

fn borrowLambdaCalled() {
    let b = mk()
    defer { b.inner.close() }
    let f = () => b.inner.peek()
    sink(f())
    sink(f())
}

fn borrowLambdaShared() {
    let b = mk()
    defer { b.inner.close() }
    let f = () => show(&b.inner)
    f()
}

fn borrowLambdaWholeReserved() {
    let b = mk()
    defer { take(b) }
    let f = () => b.n
    sink(f())
    let g = () => show(&b.other)
    g()
}

fn borrowLambdaDirect() {
    let b = mk()
    defer { b.inner.close() }
    sink((() => b.inner.peek())())
}

fn borrowLambdaImmediate() {
    let b = mk()
    defer { b.inner.close() }
    sink(apply(() => b.inner.peek()))
}

fn borrowLambdaSibling() {
    let b = mk()
    defer { b.inner.close() }
    let f = () => b.other.peek()
    sink(f())
}

fn lambdaEscapesToStore() {
    let b = mk()
    defer { b.inner.close() }
    store(() => b.inner.peek()) //~ ERROR closure captures //~ ERROR is reserved
}

fn lambdaEscapesThroughLocal() {
    let b = mk()
    defer { b.inner.close() }
    let f = () => b.inner.peek() //~ ERROR
    keep(f)
}

fn lambdaEscapesThroughAlias() {
    let b = mk()
    defer { b.inner.close() }
    let f = () => b.inner.peek() //~ ERROR
    let g = f
    sink(g())
}

fn lambdaEscapesIntoLambda() {
    let b = mk()
    defer { b.inner.close() }
    let f = () => b.inner.peek() //~ ERROR
    let g = () => f()
    sink(g())
}

fn lambdaInRecord() {
    let b = mk()
    defer { b.inner.close() }
    let s = Slot { keep: () => b.inner.peek() } //~ ERROR closure captures //~ ERROR is reserved
}

fn lambdaMoves() {
    let b = mk()
    defer { b.inner.close() }
    let f = () => take(b.inner) //~ ERROR
    f()
}

fn lambdaReturnsReserved() {
    let b = mk()
    defer { b.inner.close() }
    let f = () => b.inner //~ ERROR
    take(f())
}

fn lambdaBorrowsMutably() {
    let mut b = mk()
    defer { b.inner.close() }
    let f = () => reset(&mut b.inner) //~ ERROR
    f()
}

fn lambdaCallsMutSelf() {
    let mut b = mk()
    defer { b.inner.close() }
    let f = () => b.inner.bump() //~ ERROR
    f()
}

fn tupleSecondElement() {
    let t = pair()
    defer { take(t._0) }
    match t {
        (_, y) -> y.close()
    }
}

fn tupleReservedElement() {
    let t = pair()
    defer { take(t._0) }
    match t { //~ ERROR
        (x, _) -> x.close()
    }
}

fn tupleReservedBoth() {
    let t = pair()
    defer { take(t) }
    match t { //~ ERROR
        (_, y) -> y.close()
    }
}

fn tupleNestedSibling() {
    let t = ((mkh(1), mkh(2)), mkh(3))
    defer { take(t._1) }
    match t {
        ((a, _), _) -> a.close()
    }
}

fn tupleReservedLet() {
    let t = pair()
    defer { take(t._1) }
    let (_, y) = t //~ ERROR
    y.close()
}

fn tupleNested() {
    let t = ((mkh(1), mkh(2)), mkh(3))
    defer { take(t._0) }
    match t { //~ ERROR
        ((a, _), _) -> a.close()
    }
}

fn indexScrutinee() {
    let xs = Array.of(mk())
    defer { take(xs) }
    match xs[0] { //~ ERROR
        Pack { inner, other: _, n: _ } -> inner.close()
    }
}

fn refScrutinee(p: &Pack) {
    match p {
        Pack { inner, other: _, n: _ } -> show(inner)
    }
}

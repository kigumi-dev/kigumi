import secret from std/secret

let a = secret.SecretU32.classify(1)
let b = secret.SecretU32.classify(2)

print a.v //~ ERROR is not visible here
print "${a}" //~ ERROR cannot interpolate
print (a == b) //~ ERROR does not satisfy `Eq`
print a.hash() //~ ERROR expected `String`, found `Choice`
let leaked = a.declassify() //~ ERROR requires an `unsafe { }` block

let c = secret.SecretU8.classify(1).ctEq(secret.SecretU8.classify(1))
print (c == c) //~ ERROR does not satisfy `Eq`
print c.hash() //~ ERROR expected `String`, found `Choice`
print "${c}" //~ ERROR cannot interpolate

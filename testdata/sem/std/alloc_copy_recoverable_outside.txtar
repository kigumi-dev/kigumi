-- module --
mir: planned
profile: recoverable-only
-- src --
type Nm = {
    pub name String
    pub mut n Int
}

fn clear(x: &mut Nm?) {
    x = None
}

// rt_copy ends the process when the allocator refuses, so a planned copy is a fatal path like a construction.
fn dup(o: Nm?) -> Int {
    let mut b = o
    clear(&mut b)
    if o is Some(_) { 1 } else { 0 }
}

fn main() -> Void! {
    let o: Nm? = None
    let n = dup(o) //~ ERROR `dup` may terminate on a refused allocation
}
-- expect --
error[E1280]: `dup` may terminate on a refused allocation instead of returning it as a value, which the recoverable-only profile forbids
  --> main.kg:19:13
   |
19 |     let n = dup(o) //~ ERROR `dup` may terminate on a refused allocation
   |             ^^^^^
   = help: use the fallible (`try`-prefixed) form instead


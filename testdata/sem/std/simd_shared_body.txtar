-- module --
mir: planned
-- src --
import simd from std/simd

type W[const N: usize] = resource { pub v simd.Vec[i32, N] } //~ NOTE the drop glue of `W` runs this one body

fn W[N].drop(move self) { print "drop ${self.v.add(self.v).lane(0)}" } //~ ERROR `W.drop` is reached as one shared body

interface Sh { fn run(self) -> Int }
type H[T] = { pub v simd.Vec[T, 4] }
fn H[T: Copy].run(self) -> Int { _ = self.v.add(self.v); 1 } //~ ERROR `H.run` is reached as one shared body

fn main() { //~ NOTE `main` builds an interface method table that runs it
    let w = W[4] { v: simd.Vec.splat[i32, 4](3) }
    let s: Sh = H[i32] { v: simd.Vec.splat[i32, 4](1) }
    print "made ${w.v.lane(1)} ${s.run()}"
}
-- expect --

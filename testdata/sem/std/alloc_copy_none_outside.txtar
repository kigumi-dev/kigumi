-- module --
mir: planned
allocator: none
-- src --
type Nm = {
    pub name String
    pub mut n Int
}

fn clear(x: &mut Nm?) {
    x = None
}

// A copy of a parameter makes a box of its own, which needs the default allocator like a construction does.
fn dup(o: Nm?) -> Int {
    let mut b = o
    clear(&mut b)
    if o is Some(_) { 1 } else { 0 }
}

fn main() -> Void! {
    let o: Nm? = None
    let n = dup(o) //~ ERROR `dup` needs the default allocator
}
-- expect --
error[E959]: `dup` needs the default allocator, but this build has none (--allocator none)
  --> main.kg:19:13
   |
19 |     let n = dup(o) //~ ERROR `dup` needs the default allocator
   |             ^^^^^
   = help: allocate inside an `allocator` block


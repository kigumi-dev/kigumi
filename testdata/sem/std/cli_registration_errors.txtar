-- src --
import cli from std/cli

type Opaque = {
    pub n Int
}

fn immutableDestination(p: &mut cli.Parser) {
    let n: Int = 0
    p.flag("n", &mut n)
}

fn notAFlagType(p: &mut cli.Parser) {
    let mut o = Opaque { n: 1 }
    p.flag("o", &mut o)
}

fn immutableParser(p: cli.Parser) {
    let mut n: Int = 0
    p.flag("n", &mut n)
}

fn plainReferenceDestination(p: &mut cli.Parser) {
    let mut n: Int = 0
    p.flag("n", n)
}

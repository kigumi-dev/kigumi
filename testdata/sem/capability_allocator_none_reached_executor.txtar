import task from std/task
import {AllocatorHandle} from std/alloc

async fn leaf() -> Int {
    1
}

fn probe(h: AllocatorHandle) -> Int {
    allocator h.scope() {
        let ex = task.currentThreadExecutor()
        ex.runToCompletion(leaf())
    }
}

fn main() -> Unit! {
    let h: AllocatorHandle? = None
    if h is Some(handle) {
        let r = probe(handle)
    }
}

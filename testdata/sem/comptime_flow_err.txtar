-- src --
async fn a() -> Int { 1 }

fn ok() -> Int! { 1 }

fn viaTry() -> Int! {
    let n = comptime {
        let v = ok()? //~ ERROR cannot leave a `comptime` block
        v + 1
    }
    n
}

async fn viaAwait() -> Int {
    comptime { await a() } //~ ERROR cannot leave a `comptime` block
}

async fn closureAwait() -> Int {
    let g = () => { await a() } //~ ERROR only allowed inside an `async fn`
    g()
}

fn fine() -> Int {
    comptime { 1 + 2 }
}

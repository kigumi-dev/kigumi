-- module --
mir: planned
-- src --
type Handle = resource {
    pub mut id Int
}

fn Handle.drop(move self) {}

fn Handle.close(move self) {}

fn Handle.peek(self) -> Int {
    self.id
}

type Pack = {
    pub mut inner Handle
    pub mut other Handle
}

fn mkh(n: Int) -> Handle {
    Handle { id: n }
}

fn take(h: Handle) {}

fn madeInLoop() {
    let h = mkh(1)
    for i in 0..2 {
        let k = () => { h.close() } //~ ERROR `h` was moved in an earlier iteration of the loop; it cannot be moved again
        k()
    }
}

fn madeInLoopField() {
    let b = Pack { inner: mkh(1), other: mkh(2) }
    for i in 0..2 {
        let k = () => { b.other.close() } //~ ERROR `b` was moved in an earlier iteration of the loop; it cannot be moved again
        k()
    }
}

fn consumedAfterCall() {
    let h = mkh(1)
    let f = () => { h.close() }
    f()
    h.close() //~ ERROR `h` was moved; it cannot be used again
}

fn consumedBeforeCall() {
    let h = mkh(1)
    let f = () => { h.close() }
    take(h) //~ ERROR `h` was moved; it cannot be used again
    f()
}

fn twoClosures() {
    let h = mkh(1)
    let f = () => { h.close() }
    let g = () => { h.close() } //~ ERROR `h` was moved; it cannot be used again
    f()
    g()
}

fn innerOnceMadeInLoop() {
    let h = mkh(1)
    let g = () => { h.close() }
    for i in 0..2 {
        let k = () => { g() } //~ ERROR `g` was moved in an earlier iteration of the loop; it cannot be moved again
        k()
    }
}

fn readAfterMaking() -> Int {
    let h = mkh(1)
    let f = () => { h.close() }
    let n = h.peek() //~ ERROR `h` was moved; it cannot be used again
    f()
    n
}

fn madeInLoopOverLocal() {
    for i in 0..2 {
        let h = mkh(i)
        let k = () => { h.close() }
        k()
    }
}

fn reassignedBeforeMaking() {
    let mut h = mkh(0)
    h.close()
    for i in 0..2 {
        h = mkh(i)
        let k = () => { h.close() }
        k()
    }
    h = mkh(9)
    h.close()
}

fn refillReservesNothing() {
    let mut h = mkh(1)
    let f = () => {
        h.close()
        h = mkh(2)
    }
    f()
    h.close() //~ ERROR `h` was moved; it cannot be used again
}

fn madeInBranchThenConsumed(c: Bool) {
    let h = mkh(1)
    if c {
        let f = () => { h.close() }
        f()
    }
    h.close() //~ ERROR `h` is moved on some paths but not others
}

fn madeInBlockThenConsumed() {
    let h = mkh(1)
    {
        let f = () => { h.close() }
        f()
    }
    h.close() //~ ERROR `h` was moved; it cannot be used again
}

fn escapedFromBlockThenConsumed() {
    let h = mkh(1)
    let f = {
        let g = () => { h.close() }
        g
    }
    f()
    h.close() //~ ERROR `h` was moved; it cannot be used again
}

fn paramMadeInBlockThenConsumed(h: Handle) {
    {
        let f = () => { h.close() }
        f()
    }
    h.close() //~ ERROR `h` was moved; it cannot be used again
}

fn fieldMadeInBlockThenConsumed() {
    let b = Pack { inner: mkh(1), other: mkh(2) }
    {
        let f = () => { b.other.close() }
        f()
    }
    b.other.close() //~ ERROR `b` was moved; it cannot be used again
}

fn conditionalCallThenAssign(c: Bool) {
    let mut h = mkh(1)
    let f = () => { h.close() }
    if c {
        f()
    }
    h = mkh(2)
    h.close()
}

fn callThenConditionalAssign(c: Bool) {
    let mut h = mkh(1)
    let f = () => { h.close() }
    f()
    if c {
        h = mkh(2)
    }
    h.close() //~ ERROR `h` is moved on some paths but not others
}

fn neverCalledStillReserves(c: Bool) {
    let h = mkh(1)
    let f = () => { h.close() }
    if c {
        f()
    } else {
        h.close() //~ ERROR `h` was moved; it cannot be used again
    }
}

fn callThenAssign() {
    let mut h = mkh(1)
    let f = () => { h.close() }
    f()
    h = mkh(2)
    h.close()
}

fn callThenAssignPerIteration() {
    for i in 0..2 {
        let mut h = mkh(i)
        let f = () => { h.close() }
        f()
        h = mkh(i + 10)
        h.close()
    }
}

fn callThenAssignInLoop() {
    let mut h = mkh(30)
    for i in 0..2 {
        let f = () => { h.close() }
        f()
        h = mkh(i + 31)
    }
    h.close()
}

fn madeInBranchThenAssign(c: Bool) {
    let mut h = mkh(1)
    if c {
        let f = () => { h.close() }
        f()
    }
    h = mkh(2)
    h.close()
}

fn breakBeforeRefill() {
    let mut h = mkh(1)
    for i in 0..3 {
        let f = () => { h.close() }
        f()
        if i == 1 {
            break
        }
        h = mkh(10 + i)
    }
}

fn continueBeforeRefillInLoop() {
    let mut h = mkh(1)
    for i in 0..3 {
        let f = () => { h.close() } //~ ERROR `h` was moved in an earlier iteration of the loop; it cannot be moved again
        f()
        if i == 1 {
            continue
        }
        h = mkh(10 + i)
    }
}

fn breakBeforeFieldRefill() {
    let mut b = Pack { inner: mkh(1), other: mkh(2) }
    for i in 0..3 {
        let f = () => { b.other.close() } //~ ERROR `b` was moved in an earlier iteration of the loop; it cannot be moved again
        f()
        if i == 1 {
            break
        }
        b.other = mkh(10 + i) //~ ERROR `b` was moved; it cannot be used again
    }
}

fn continueBeforeFieldRefill() {
    let mut b = Pack { inner: mkh(1), other: mkh(2) }
    for i in 0..3 {
        let f = () => { b.other.close() } //~ ERROR `b` was moved in an earlier iteration of the loop; it cannot be moved again
        f()
        if i == 1 {
            continue
        }
        b.other = mkh(10 + i) //~ ERROR `b` was moved; it cannot be used again
    }
}

fn breakAfterRefill() {
    let mut h = mkh(1)
    for i in 0..3 {
        let f = () => { h.close() }
        f()
        h = mkh(10 + i)
        if i == 1 {
            break
        }
    }
    h.close()
}

fn refillThenCloseTwice() {
    let mut h = mkh(1)
    let f = () => { h.close() }
    f()
    h = mkh(2)
    h.close()
    h.close() //~ ERROR `h` was moved; it cannot be used again
}

fn refillThenMoveAndDefer() {
    let mut h = mkh(1)
    let f = () => { h.close() }
    f()
    h = mkh(2)
    let k = h
    defer { h.close() } //~ ERROR a cleanup reads `h`, which can already be moved when the cleanup runs
    take(k)
}

fn refillInLoopThenCloseTwice() {
    let mut h = mkh(1)
    for i in 0..2 {
        let f = () => { h.close() } //~ ERROR `h` is moved on some paths but not others
        f()
        h = mkh(10 + i)
        h.close()
        h.close() //~ ERROR `h` was moved; it cannot be used again
    }
}

fn refillFieldThenCloseTwice() {
    let mut b = Pack { inner: mkh(1), other: mkh(2) }
    let f = () => { b.other.close() }
    f()
    b.other = mkh(3) //~ ERROR `b` was moved; it cannot be used again
    b.other.close() //~ ERROR `b` was moved; it cannot be used again
    take(b.other) //~ ERROR `b` was moved; it cannot be used again //~ ERROR `b.other` was moved; it cannot be used again
}

fn refillAfterLoopThenCloseTwice() {
    let mut h = mkh(1)
    for i in 0..2 {
        h = mkh(10 + i)
        let f = () => { h.close() }
        f()
    }
    h = mkh(20)
    h.close()
    h.close() //~ ERROR `h` was moved; it cannot be used again
}

fn shadowingLetIsNoRefill() {
    let mut b = Pack { inner: mkh(1), other: mkh(2) }
    for i in 0..2 {
        let f = () => { b.other.close() } //~ ERROR `b` was moved in an earlier iteration of the loop; it cannot be moved again
        f()
        let mut b = Pack { inner: mkh(3), other: mkh(4) }
        b.other = mkh(5)
        b.other.close()
        b.inner.close()
    }
}

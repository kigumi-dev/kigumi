-- module --
mir: planned
-- src --
type Handle = resource {
    pub mut id Int
}

fn Handle.drop(move self) -> Unit {}

fn Handle.close(move self) -> Unit {}

fn Handle.peek(self) -> Int {
    self.id
}

type Pack = {
    pub mut inner Handle
    pub mut other Handle
}

fn mkh(n: Int) -> Handle {
    Handle { id: n }
}

fn take(h: Handle) -> Unit {}

fn madeInLoop() -> Unit {
    let h = mkh(1)
    for i in 0..2 {
        let k = () => { h.close() } //~ ERROR can already be moved
        k()
    }
}

fn madeInLoopField() -> Unit {
    let b = Pack { inner: mkh(1), other: mkh(2) }
    for i in 0..2 {
        let k = () => { b.other.close() } //~ ERROR can already be moved
        k()
    }
}

fn consumedAfterCall() -> Unit {
    let h = mkh(1)
    let f = () => { h.close() }
    f()
    h.close() //~ ERROR cannot be moved before the scope exits
}

fn consumedBeforeCall() -> Unit {
    let h = mkh(1)
    let f = () => { h.close() }
    take(h) //~ ERROR cannot be moved before the scope exits
    f()
}

fn twoClosures() -> Unit {
    let h = mkh(1)
    let f = () => { h.close() }
    let g = () => { h.close() } //~ ERROR cannot be moved before the scope exits
    f()
    g()
}

fn innerOnceMadeInLoop() -> Unit {
    let h = mkh(1)
    let g = () => { h.close() }
    for i in 0..2 {
        let k = () => { g() } //~ ERROR can already be moved
        k()
    }
}

fn readAfterMaking() -> Int {
    let h = mkh(1)
    let f = () => { h.close() }
    let n = h.peek()
    f()
    n
}

fn madeInLoopOverLocal() -> Unit {
    for i in 0..2 {
        let h = mkh(i)
        let k = () => { h.close() }
        k()
    }
}

fn reassignedBeforeMaking() -> Unit {
    let mut h = mkh(0)
    h.close()
    for i in 0..2 {
        h = mkh(i)
        let k = () => { h.close() }
        k()
    }
    h = mkh(9) //~ ERROR cannot be assigned
    h.close() //~ ERROR cannot be moved before the scope exits
}

fn refillReservesNothing() -> Unit {
    let mut h = mkh(1)
    let f = () => {
        h.close()
        h = mkh(2)
    }
    f()
    h.close()
}

fn madeInBranchThenConsumed(c: Bool) -> Unit {
    let h = mkh(1)
    if c {
        let f = () => { h.close() }
        f()
    }
    h.close() //~ ERROR cannot be moved before the scope exits
}

fn madeInBlockThenConsumed() -> Unit {
    let h = mkh(1)
    {
        let f = () => { h.close() }
        f()
    }
    h.close() //~ ERROR cannot be moved before the scope exits
}

fn escapedFromBlockThenConsumed() -> Unit {
    let h = mkh(1)
    let f = {
        let g = () => { h.close() }
        g
    }
    f()
    h.close() //~ ERROR cannot be moved before the scope exits
}

fn paramMadeInBlockThenConsumed(h: Handle) -> Unit {
    {
        let f = () => { h.close() }
        f()
    }
    h.close() //~ ERROR cannot be moved before the scope exits
}

fn fieldMadeInBlockThenConsumed() -> Unit {
    let b = Pack { inner: mkh(1), other: mkh(2) }
    {
        let f = () => { b.other.close() }
        f()
    }
    b.other.close() //~ ERROR cannot be moved before the scope exits
}

fn conditionalCallThenAssign(c: Bool) -> Unit {
    let mut h = mkh(1)
    let f = () => { h.close() }
    if c {
        f()
    }
    h = mkh(2) //~ ERROR cannot be assigned before the scope exits
    h.close() //~ ERROR cannot be moved before the scope exits
}

fn callThenConditionalAssign(c: Bool) -> Unit {
    let mut h = mkh(1)
    let f = () => { h.close() }
    f()
    if c {
        h = mkh(2) //~ ERROR cannot be assigned
    }
    h.close() //~ ERROR cannot be moved before the scope exits
}

fn neverCalledStillReserves(c: Bool) -> Unit {
    let h = mkh(1)
    let f = () => { h.close() }
    if c {
        f()
    } else {
        h.close() //~ ERROR cannot be moved before the scope exits
    }
}

fn callThenAssign() -> Unit {
    let mut h = mkh(1)
    let f = () => { h.close() }
    f()
    h = mkh(2) //~ ERROR cannot be assigned
    h.close() //~ ERROR cannot be moved before the scope exits
}

fn callThenAssignPerIteration() -> Unit {
    for i in 0..2 {
        let mut h = mkh(i)
        let f = () => { h.close() }
        f()
        h = mkh(i + 10) //~ ERROR cannot be assigned
        h.close() //~ ERROR cannot be moved before the scope exits
    }
}

fn callThenAssignInLoop() -> Unit {
    let mut h = mkh(30)
    for i in 0..2 {
        let f = () => { h.close() } //~ ERROR can already be moved
        f()
        h = mkh(i + 31) //~ ERROR cannot be assigned
    }
    h.close() //~ ERROR cannot be moved before the scope exits
}

fn madeInBranchThenAssign(c: Bool) -> Unit {
    let mut h = mkh(1)
    if c {
        let f = () => { h.close() }
        f()
    }
    h = mkh(2) //~ ERROR cannot be assigned
    h.close() //~ ERROR cannot be moved before the scope exits
}

fn breakBeforeRefill() -> Unit {
    let mut h = mkh(1)
    for i in 0..3 {
        let f = () => { h.close() } //~ ERROR can already be moved
        f()
        if i == 1 {
            break
        }
        h = mkh(10 + i) //~ ERROR cannot be assigned
    }
}

fn continueBeforeRefillInLoop() -> Unit {
    let mut h = mkh(1)
    for i in 0..3 {
        let f = () => { h.close() } //~ ERROR can already be moved
        f()
        if i == 1 {
            continue
        }
        h = mkh(10 + i) //~ ERROR cannot be assigned
    }
}

fn breakBeforeFieldRefill() -> Unit {
    let mut b = Pack { inner: mkh(1), other: mkh(2) }
    for i in 0..3 {
        let f = () => { b.other.close() } //~ ERROR can already be moved
        f()
        if i == 1 {
            break
        }
        b.other = mkh(10 + i) //~ ERROR cannot be assigned
    }
}

fn continueBeforeFieldRefill() -> Unit {
    let mut b = Pack { inner: mkh(1), other: mkh(2) }
    for i in 0..3 {
        let f = () => { b.other.close() } //~ ERROR can already be moved
        f()
        if i == 1 {
            continue
        }
        b.other = mkh(10 + i) //~ ERROR cannot be assigned
    }
}

fn breakAfterRefill() -> Unit {
    let mut h = mkh(1)
    for i in 0..3 {
        let f = () => { h.close() } //~ ERROR can already be moved
        f()
        h = mkh(10 + i) //~ ERROR cannot be assigned
        if i == 1 {
            break
        }
    }
    h.close() //~ ERROR cannot be moved before the scope exits
}

fn refillThenCloseTwice() -> Unit {
    let mut h = mkh(1)
    let f = () => { h.close() }
    f()
    h = mkh(2) //~ ERROR cannot be assigned
    h.close() //~ ERROR cannot be moved before the scope exits
    h.close() //~ ERROR cannot be moved before the scope exits
}

fn refillThenMoveAndDefer() -> Unit {
    let mut h = mkh(1)
    let f = () => { h.close() }
    f()
    h = mkh(2) //~ ERROR cannot be assigned
    let k = h //~ ERROR cannot be moved before the scope exits
    defer { h.close() } //~ ERROR already consumed by an earlier cleanup
    take(k)
}

fn refillInLoopThenCloseTwice() -> Unit {
    let mut h = mkh(1)
    for i in 0..2 {
        let f = () => { h.close() } //~ ERROR can already be moved
        f()
        h = mkh(10 + i) //~ ERROR cannot be assigned
        h.close() //~ ERROR cannot be moved before the scope exits
        h.close() //~ ERROR cannot be moved before the scope exits
    }
}

fn refillFieldThenCloseTwice() -> Unit {
    let mut b = Pack { inner: mkh(1), other: mkh(2) }
    let f = () => { b.other.close() }
    f()
    b.other = mkh(3) //~ ERROR cannot be assigned
    b.other.close() //~ ERROR cannot be moved before the scope exits
    take(b.other) //~ ERROR cannot be moved before the scope exits
}

fn refillAfterLoopThenCloseTwice() -> Unit {
    let mut h = mkh(1)
    for i in 0..2 {
        h = mkh(10 + i)
        let f = () => { h.close() }
        f()
    }
    h = mkh(20) //~ ERROR cannot be assigned
    h.close() //~ ERROR cannot be moved before the scope exits
    h.close() //~ ERROR cannot be moved before the scope exits
}

fn shadowingLetIsNoRefill() -> Unit {
    let mut b = Pack { inner: mkh(1), other: mkh(2) }
    for i in 0..2 {
        let f = () => { b.other.close() } //~ ERROR can already be moved
        f()
        let mut b = Pack { inner: mkh(3), other: mkh(4) }
        b.other = mkh(5)
        b.other.close()
        b.inner.close()
    }
}

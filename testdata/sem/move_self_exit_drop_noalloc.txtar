-- src --
type Buf = resource { pub n Int }

fn Buf.drop(move self) {
    let xs = Array.of(self.n)
    print "drop ${xs.len()}"
}

noalloc fn Buf.finish(move self) {} //~ ERROR dropping `Buf` may allocate or deallocate

noalloc fn finishFree(b: Buf) {} //~ ERROR dropping `Buf` may allocate or deallocate

noalloc fn Buf.peek(move self) -> Buf { self }

type Plain = resource { pub n Int }

noalloc fn Plain.finish(move self) {}

type W = resource { pub h Buf, pub k Int }

noalloc fn W.take(move self) -> Buf { self.h }

noalloc fn W.takeLet(move self) -> Buf {
    let b = move self.h
    b
}

noalloc fn W.keep(move self) -> Int { self.k } //~ ERROR dropping `W` may allocate or deallocate

noalloc fn W.maybe(move self, spare: Buf, flag: Bool) -> Buf { //~ ERROR dropping `W` may allocate or deallocate
    if flag {
        return self.h
    }
    spare
}

type N = resource { pub w W, pub k Int }

noalloc fn N.inner(move self) -> Buf { self.w.h }

type Two = resource { pub a Buf, pub b Buf }

noalloc fn Two.first(move self) -> Buf { self.a } //~ ERROR dropping `Buf` may allocate or deallocate

let b = Buf { n: 1 }
let c = b.peek()
c.finish()
Plain { n: 2 }.finish()

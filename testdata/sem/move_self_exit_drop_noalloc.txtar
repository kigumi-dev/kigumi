-- src --
type Buf = resource { pub n Int }

fn Buf.drop(move self) {
    let xs = Array.of(self.n)
    print "drop ${xs.len()}"
}

noalloc fn Buf.finish(move self) {} //~ ERROR dropping `Buf` may allocate or deallocate

noalloc fn finishFree(b: Buf) {} //~ ERROR dropping `Buf` may allocate or deallocate

noalloc fn Buf.peek(move self) -> Buf { self }

type Plain = resource { pub n Int }

noalloc fn Plain.finish(move self) {}

let b = Buf { n: 1 }
let c = b.peek()
c.finish()
Plain { n: 2 }.finish()

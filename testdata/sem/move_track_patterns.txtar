-- module --
mir: planned
-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn Res.close(move self) {}

fn Res.peek(self) -> Int {
    self.id
}

fn say(n: Int) {}

fn sayU(n: usize) {}

fn mkr(n: Int) -> Res {
    Res { id: n }
}

type Pair = {
    pub mut left Res
    pub mut right Res
}

type Box = {
    pub mut p Pair?
}

fn Box.put(mut self, p: Pair) {
    self.p = Some(p)
}

fn take(p: Pair) {
    let g = move p.left
    g.close()
}

fn matchTwice(o: Res?) {
    match o {
        Some(c) -> c.close()
        None -> {}
    }
    match o {
        Some(c) -> c.close() //~ ERROR `o` was moved
        None -> {}
    }
}

fn isTwice(o: Res?) {
    if o is Some(c) {
        c.close()
    }
    if o is Some(c) { //~ ERROR `o` is moved on some paths but not others
        c.close()
    }
}

fn ifLetThenMatch(o: Res?) {
    if let Some(c) = o {
        say(c.peek())
    }
    match o {
        Some(c) -> c.close() //~ ERROR `o` was moved
        None -> {}
    }
}

fn tryTwice(r: Result[Res, String]) -> Result[Int, String] {
    let a = r?
    let b = r? //~ ERROR `r` was moved
    a.close()
    b.close()
    Ok(1)
}

fn orTwice(o: Res?) {
    let a = o || mkr(1)
    let b = o || mkr(2) //~ ERROR `o` was moved
    a.close()
    b.close()
}

fn recordTwice(p: Pair) {
    match p {
        Pair { left, right } -> left.close()
    }
    match p {
        Pair { left, right } -> right.close() //~ ERROR `p.left` was moved //~ ERROR `p.right` was moved
    }
}

fn tupleTwice(t: (Res, Int)) {
    match t {
        (c, n) -> c.close()
    }
    match t {
        (c, n) -> c.close() //~ ERROR `t._0` was moved
    }
}

fn arrayShared() {
    let o = Some(Array.of(1, 2, 3))
    let mut a = match o {
        Some(x) -> x
        None -> Array.of()
    }
    let b = match o {
        Some(x) -> x //~ ERROR `o` was moved
        None -> Array.of()
    }
    a.push(9)
}

fn aliasPassedOn(o: Pair?) {
    if let Some(p) = o {
        take(p)
    }
    match o {
        Some(q) -> q.left.close() //~ ERROR `o` was moved
        None -> {}
    }
}

fn aliasStored(o: Pair?, b: Box) {
    let mut bx = b
    if let Some(p) = o {
        bx.put(p)
    }
    match o {
        Some(q) -> q.right.close() //~ ERROR `o` was moved
        None -> {}
    }
}

fn aliasReturnedByLambda(o: Pair?) {
    if let Some(p) = o {
        let f = () => p
        take(f())
    }
    match o {
        Some(q) -> q.left.close() //~ ERROR `o` was moved
        None -> {}
    }
}

fn fieldThenWhole(o: Pair?) -> Int {
    if let Some(p) = o {
        let g = move p.left
        g.close()
        return 1
    }
    0
}

fn borrowedTwice(o: &Res?) {
    match o {
        Some(c) -> say(c.peek())
        None -> {}
    }
    match o {
        Some(c) -> say(c.peek())
        None -> {}
    }
}

fn borrowedLocal() {
    let o = Some(mkr(3))
    match &o {
        Some(c) -> say(c.peek())
        None -> {}
    }
    match o {
        Some(c) -> c.close()
        None -> {}
    }
}

fn copyPayload(o: Int?) -> Int {
    let a = o || 0
    let b = o || 1
    match o {
        Some(n) -> n + a + b
        None -> 0
    }
}

fn reinitAfterMatch() {
    let mut o = Some(mkr(4))
    match o {
        Some(c) -> c.close()
        None -> {}
    }
    o = Some(mkr(5))
    match o {
        Some(c) -> c.close()
        None -> {}
    }
}

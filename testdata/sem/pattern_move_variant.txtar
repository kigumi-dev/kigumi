-- module --
mir: planned
-- src --
type Handle = resource {
    pub id Int
}

fn Handle.drop(move self) {}

fn Handle.close(move self) {}

fn Handle.peek(self) -> Int {
    self.id
}

type Pack = {
    pub inner Handle
    pub other Handle
    pub n Int
}

type Bag = {
    pub opt Handle?
    pub pack Pack?
    pub other Handle
}

fn mkh(n: Int) -> Handle {
    Handle { id: n }
}

fn mk(n: Int) -> Pack {
    Pack { inner: mkh(n), other: mkh(n + 1), n: 0 }
}

fn mkBag(n: Int) -> Bag {
    Bag { opt: Some(mkh(n)), pack: Some(mk(n)), other: mkh(n + 1) }
}

fn sink(n: Int) {}

fn payloadInLoop() {
    let b = mkBag(1)
    for i in 0..2 {
        match b.opt {
            Some(h) -> h.close() //~ ERROR `b.opt` was moved
            None -> {}
        }
    }
}

fn payloadInLoopParam(b: Bag) {
    for i in 0..2 {
        match b.opt {
            Some(h) -> h.close() //~ ERROR `b.opt` was moved
            None -> {}
        }
    }
}

fn payloadIsInLoop(b: Bag) {
    for i in 0..2 {
        if b.opt is Some(h) { //~ ERROR `b.opt` is moved on some paths
            h.close()
        }
    }
}

fn payloadNestedInLoop(b: Bag) {
    for i in 0..2 {
        match b.pack {
            Some(Pack { other, inner: _, n: _ }) -> other.close() //~ ERROR `b.pack.other` was moved
            None -> {}
        }
    }
}

fn payloadLocalInLoop(o: Handle?) {
    for i in 0..2 {
        match o {
            Some(h) -> h.close() //~ ERROR `o` was moved
            None -> {}
        }
    }
}

fn payloadTwice(b: Bag) {
    match b.opt {
        Some(h) -> h.close()
        None -> {}
    }
    match b.opt {
        Some(g) -> g.close() //~ ERROR `b.opt` was moved
        None -> {}
    }
}

fn payloadOnce(b: Bag) {
    match b.opt {
        Some(h) -> h.close()
        None -> {}
    }
}

fn payloadPerIteration() {
    for i in 0..2 {
        let b = mkBag(i)
        match b.opt {
            Some(h) -> h.close()
            None -> {}
        }
    }
}

fn payloadForElement(bs: Array[Bag]) {
    for b in bs {
        match b.opt {
            Some(h) -> h.close()
            None -> {}
        }
    }
}

fn payloadReference(b: Bag) {
    for i in 0..2 {
        match &b.opt {
            Some(h) -> sink(h.peek())
            None -> {}
        }
    }
}

fn payloadCopy(o: Int?) {
    for i in 0..2 {
        match o {
            Some(n) -> sink(n)
            None -> {}
        }
    }
}

fn payloadGuarded(b: Bag) {
    match b.opt {
        Some(h) if h.peek() > 100 -> h.close()
        Some(h) -> h.close()
        None -> {}
    }
}

fn payloadGuardedLoop(b: Bag) {
    match b.pack {
        Some(Pack { other, inner: _, n: _ }) if other.peek() > 100 -> other.close()
        Some(Pack { other, inner: _, n: _ }) -> other.close()
        None -> {}
    }
}

fn payloadReassigned(b: Bag) {
    let mut o = move b.opt
    for i in 0..2 {
        match o {
            Some(h) -> h.close()
            None -> {}
        }
        o = Some(mkh(i))
    }
}

type Cell = {
    pub mut opt Handle?
    pub mut other Handle
}

type Wrap = {
    pub o Handle?
}

fn mkCell(n: Int) -> Cell {
    Cell { opt: Some(mkh(n)), other: mkh(n + 1) }
}

fn takeOpt(o: Handle?) {}

fn ok(h: &Handle) -> Bool {
    true
}

fn guardedInLoop() {
    let mut b = mkCell(110)
    for i in 0..2 {
        match b.opt {
            Some(h) if ok(&h) -> h.close() //~ ERROR `b.opt` is moved on some paths
            _ -> {}
        }
    }
}

fn guardedPerIteration() {
    for i in 0..2 {
        let b = mkCell(120 + 10 * i)
        match b.opt {
            Some(h) if ok(&h) -> h.close()
            _ -> {}
        }
        b.other.close()
    }
}

fn takeAndRefill() {
    let mut b = mkCell(30)
    for i in 0..3 {
        match b.opt {
            Some(h) -> {
                h.close()
                b.opt = None
            }
            None -> {}
        }
    }
    b.other.close()
}

fn ifLetTakeAndRefill() {
    let mut b = mkCell(40)
    for i in 0..3 {
        if let Some(h) = b.opt {
            h.close()
            b.opt = None
        }
    }
    b.other.close()
}

fn putBack() {
    let mut b = mkCell(50)
    for i in 0..2 {
        match b.opt {
            Some(h) -> {
                b.opt = Some(h)
            }
            None -> {}
        }
    }
    b.other.close()
}

fn tupleMovesField() {
    let b = mkCell(60)
    let t = (move b.other, 1)
    b.other.close() //~ ERROR `b.other` was moved //~ ERROR `b.other` was moved
}

fn tupleInLoop() {
    let b = mkCell(70)
    for i in 0..2 {
        let t = (move b.opt, 1) //~ ERROR `b.opt` was moved //~ ERROR `b.opt` was moved
        let (o, _) = t
        match o {
            Some(h) -> h.close()
            None -> {}
        }
    }
}

fn recordMovesField() {
    let b = mkCell(80)
    let w = Wrap { o: move b.opt }
    takeOpt(b.opt) //~ ERROR `b.opt` was moved //~ ERROR `b.opt` was moved
}

fn variantMovesField() {
    let b = mkCell(90)
    let o = Some(move b.other)
    b.other.close() //~ ERROR `b.other` was moved //~ ERROR `b.other` was moved
}

fn arrayMovesField() {
    let b = mkCell(100)
    let xs = Array.of(b.other)
    b.other.close() //~ ERROR `b.other` was moved //~ ERROR `b.other` was moved
}

fn literalOfOtherField() {
    let b = mkCell(130)
    let t = (move b.other, 1)
    match b.opt {
        Some(h) -> h.close()
        None -> {}
    }
}

fn isTakeAndClear() {
    let mut o = Some(mkh(5))
    if o is Some(h) {
        h.close()
        o = None
    }
    if o is Some(h) {
        h.close()
    }
}

fn isTakeAndClearInLoop() {
    let mut o = Some(mkh(6))
    for i in 0..3 {
        if o is Some(h) {
            h.close()
            o = None
        }
        if i == 1 {
            o = Some(mkh(9))
        }
    }
}

type Box1 = {
    pub mut opt Handle?
}

fn isTakeAndClearField() {
    let mut g = Box1 { opt: Some(mkh(7)) }
    for i in 0..3 {
        if g.opt is Some(h) {
            h.close()
            g.opt = None
        }
    }
}

fn isTakeNoClearInLoop() {
    let o = Some(mkh(8))
    for i in 0..2 {
        if o is Some(h) { //~ ERROR `o` is moved on some paths
            h.close()
        }
    }
}

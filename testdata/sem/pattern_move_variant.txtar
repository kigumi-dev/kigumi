fn isTakeAndClear() -> Unit {
    let mut o = Some(mkh(5))
    if o is Some(h) {
        h.close()
        o = None
    }
    if o is Some(h) {
        h.close()
    }
}

fn isTakeAndClearInLoop() -> Unit {
    let mut o = Some(mkh(6))
    for i in 0..3 {
        if o is Some(h) {
            h.close()
            o = None
        }
        if i == 1 {
            o = Some(mkh(9))
        }
    }
}


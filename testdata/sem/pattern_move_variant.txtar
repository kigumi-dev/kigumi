-- module --
mir: planned
-- src --
type Handle = resource {
    pub id Int
}

fn Handle.drop(move self) -> Unit {}

fn Handle.close(move self) -> Unit {}

fn Handle.peek(self) -> Int {
    self.id
}

type Pack = {
    pub inner Handle
    pub other Handle
    pub n Int
}

type Bag = {
    pub opt Handle?
    pub pack Pack?
    pub other Handle
}

fn mkh(n: Int) -> Handle {
    Handle { id: n }
}

fn mk(n: Int) -> Pack {
    Pack { inner: mkh(n), other: mkh(n + 1), n: 0 }
}

fn mkBag(n: Int) -> Bag {
    Bag { opt: Some(mkh(n)), pack: Some(mk(n)), other: mkh(n + 1) }
}

fn sink(n: Int) -> Unit {}

fn payloadInLoop() -> Unit {
    let b = mkBag(1)
    for i in 0..2 {
        match b.opt {
            Some(h) -> h.close() //~ ERROR `b.opt` was moved
            None -> {}
        }
    }
}

fn payloadInLoopParam(b: Bag) -> Unit {
    for i in 0..2 {
        match b.opt {
            Some(h) -> h.close() //~ ERROR `b.opt` was moved
            None -> {}
        }
    }
}

fn payloadIsInLoop(b: Bag) -> Unit {
    for i in 0..2 {
        if b.opt is Some(h) { //~ ERROR `b.opt` is moved on some paths
            h.close()
        }
    }
}

fn payloadNestedInLoop(b: Bag) -> Unit {
    for i in 0..2 {
        match b.pack {
            Some(Pack { other, inner: _, n: _ }) -> other.close() //~ ERROR `b.pack.other` was moved
            None -> {}
        }
    }
}

fn payloadLocalInLoop(o: Handle?) -> Unit {
    for i in 0..2 {
        match o {
            Some(h) -> h.close() //~ ERROR `o` was moved
            None -> {}
        }
    }
}

fn payloadTwice(b: Bag) -> Unit {
    match b.opt {
        Some(h) -> h.close()
        None -> {}
    }
    match b.opt {
        Some(g) -> g.close() //~ ERROR `b.opt` was moved
        None -> {}
    }
}

fn payloadOnce(b: Bag) -> Unit {
    match b.opt {
        Some(h) -> h.close()
        None -> {}
    }
}

fn payloadPerIteration() -> Unit {
    for i in 0..2 {
        let b = mkBag(i)
        match b.opt {
            Some(h) -> h.close()
            None -> {}
        }
    }
}

fn payloadForElement(bs: Array[Bag]) -> Unit {
    for b in bs {
        match b.opt {
            Some(h) -> h.close()
            None -> {}
        }
    }
}

fn payloadReference(b: Bag) -> Unit {
    for i in 0..2 {
        match &b.opt {
            Some(h) -> sink(h.peek())
            None -> {}
        }
    }
}

fn payloadCopy(o: Int?) -> Unit {
    for i in 0..2 {
        match o {
            Some(n) -> sink(n)
            None -> {}
        }
    }
}

fn payloadGuarded(b: Bag) -> Unit {
    match b.opt {
        Some(h) if h.peek() > 100 -> h.close()
        Some(h) -> h.close()
        None -> {}
    }
}

fn payloadGuardedLoop(b: Bag) -> Unit {
    match b.pack {
        Some(Pack { other, inner: _, n: _ }) if other.peek() > 100 -> other.close()
        Some(Pack { other, inner: _, n: _ }) -> other.close()
        None -> {}
    }
}

fn payloadReassigned(b: Bag) -> Unit {
    let mut o = b.opt
    for i in 0..2 {
        match o {
            Some(h) -> h.close()
            None -> {}
        }
        o = Some(mkh(i))
    }
}

type Cell = {
    pub mut opt Handle?
    pub mut other Handle
}

type Wrap = {
    pub o Handle?
}

fn mkCell(n: Int) -> Cell {
    Cell { opt: Some(mkh(n)), other: mkh(n + 1) }
}

fn takeOpt(o: Handle?) -> Unit {}

fn ok(h: &Handle) -> Bool {
    true
}

fn guardedInLoop() -> Unit {
    let mut b = mkCell(110)
    for i in 0..2 {
        match b.opt {
            Some(h) if ok(&h) -> h.close() //~ ERROR `b.opt` is moved on some paths
            _ -> {}
        }
    }
}

fn guardedPerIteration() -> Unit {
    for i in 0..2 {
        let b = mkCell(120 + 10 * i)
        match b.opt {
            Some(h) if ok(&h) -> h.close()
            _ -> {}
        }
        b.other.close()
    }
}

fn takeAndRefill() -> Unit {
    let mut b = mkCell(30)
    for i in 0..3 {
        match b.opt {
            Some(h) -> {
                h.close()
                b.opt = None
            }
            None -> {}
        }
    }
    b.other.close()
}

fn ifLetTakeAndRefill() -> Unit {
    let mut b = mkCell(40)
    for i in 0..3 {
        if let Some(h) = b.opt {
            h.close()
            b.opt = None
        }
    }
    b.other.close()
}

fn putBack() -> Unit {
    let mut b = mkCell(50)
    for i in 0..2 {
        match b.opt {
            Some(h) -> {
                b.opt = Some(h)
            }
            None -> {}
        }
    }
    b.other.close()
}


fn counter() -> fn() -> Int {
    let mut n = 0
    () => { //~ ERROR closure captures `n` (assigned inside the closure) and cannot be a plain `fn`
        n = n + 1
        n
    }
}

fn apply(f: fn() -> Int) -> Int {
    f()
}

fn viaArg() -> Int {
    let mut n = 0
    apply(() => { //~ ERROR closure captures `n` (assigned inside the closure) and cannot be a plain `fn`
        n = n + 1
        n
    })
}

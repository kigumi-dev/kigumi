-- module --
mir: planned
-- src --
import {Shared} from std/alloc

pub type V['a] = {
    pub s &'a String
}

pub type Sink['a] = {
    pub mut items &'a mut Array[V['a]]
}

fn nop['a](x: &'a String, k: Sink['a]) {
}

fn nop2['a](x: &'a String, k: Sink['a]) {
}

fn keeper['a](x: &'a String, k: Sink['a]) {
    k.items.push(V { s: x })
}

fn assignedTwice['a](mut f: fn(&'a String, Sink['a]) -> Void, k: Sink['a], x: &'a String) {
    if k.items.len() > 5 { f = nop }
    if k.items.len() > 7 { f = nop2 }
    f(x, k)
}

fn assignedOnce['a](mut f: fn(&'a String, Sink['a]) -> Void, k: Sink['a], x: &'a String) {
    if k.items.len() > 5 { f = nop }
    f(x, k)
}

fn plain['a](f: fn(&'a String, Sink['a]) -> Void, k: Sink['a], x: &'a String) {
    f(x, k)
}

fn callerAssigned['a](mut f: fn(&'a String, Sink['a]) -> Void, k: Sink['a]) {
    let loc = "local-${40 + 2}"
    if k.items.len() > 5 { f = nop }
    plain(f, k, &loc) //~ ERROR a borrow cannot be stored into `k` here //~ ERROR a value borrowing `loc` cannot go into shared storage
}

fn twice() -> usize {
    let base = "base"
    let mut out = Array.of(V { s: &base })
    let mut loc = "loc-${40 + 2}"
    assignedTwice(keeper, Sink { items: &mut out }, &loc) //~ ERROR a value borrowing `out` cannot go into shared storage
    loc = "changed-${1}" //~ ERROR `loc` is borrowed and cannot be mutated here //~ ERROR `loc` is borrowed and cannot be moved or dropped here
    out.len()
}

fn once() -> usize {
    let base = "base"
    let mut out = Array.of(V { s: &base })
    let mut loc = "loc-${40 + 2}"
    assignedOnce(keeper, Sink { items: &mut out }, &loc) //~ ERROR a value borrowing `out` cannot go into shared storage
    loc = "changed-${1}" //~ ERROR `loc` is borrowed and cannot be mutated here //~ ERROR `loc` is borrowed and cannot be moved or dropped here
    out.len()
}

fn quietPlain() -> usize {
    let base = "base"
    let mut out = Array.of(V { s: &base })
    let mut loc = "loc-${40 + 2}"
    plain(nop, Sink { items: &mut out }, &loc)
    loc = "changed-${1}"
    out.len()
}

interface FromRef[K] {
    fn fromRef(k: &K) -> Self
}

type View['a] = {
    pub s &'a String
}

fn View['a].fromRef(k: &'a String) -> View['a] {
    View { s: k }
}

fn keepIt[K, V: FromRef[K]](k: &K) -> V? {
    Some(V.fromRef(k))
}

fn quiet[K, V: FromRef[K]](k: &K) -> V? {
    None
}

fn quiet2[K, V: FromRef[K]](k: &K) -> V? {
    None
}

fn pick[K, V: FromRef[K]](mut f: fn(&K) -> V?, k: &K, n: usize) -> V? {
    if n > 5 { f = quiet }
    if n > 7 { f = quiet2 }
    f(k)
}

fn generic[K, V: FromRef[K]](dst: &mut Array[V], k: K) {
    if pick(keepIt, &k, dst.len()) is Some(v) { dst.push(v) } //~ ERROR a borrow cannot be stored into `dst` here
}

type Tag = resource {
    pub n Int
}

fn Tag.drop(move self) {
    print "drop ${self.n}"
}

async fn readTag(t: &Tag) -> Int {
    t.n
}

fn drop1(f: Future[Int], sh: Shared[Future[Int]?]) {
}

fn stash(f: Future[Int], sh: Shared[Future[Int]?]) {
    sh.set(Some(f))
}

fn sharedOnce(mut cb: fn(Future[Int], Shared[Future[Int]?]) -> Void, f: Future[Int], sh: Shared[Future[Int]?]) {
    if sh.with((o: &Future[Int]?) => o is None) {
    } else {
        cb = drop1
    }
    cb(f, sh)
}

fn put(sh: Shared[Future[Int]?]) {
    let t = Tag { n: 42 }
    sharedOnce(stash, readTag(&t), sh) //~ ERROR a value borrowing `t` cannot go into shared storage
}

let text = "hello"
let mut items = Array.of(V { s: &text })
callerAssigned(keeper, Sink { items: &mut items }) //~ ERROR a value borrowing `items` cannot go into shared storage
let name = "named"
let mut xs = Array.of(View { s: &name })
generic(&mut xs, "gone-${2}")
put(Shared.new(None))
print "${twice()} ${once()} ${quietPlain()} ${items.len()} ${xs.len()}"

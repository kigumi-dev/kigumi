-- src --
pub type V['a] = { pub s &'a String }
pub type Sink['a] = { pub mut items &'a mut Array[V['a]] }

fn keep['a](x: &'a String, k: Sink['a]) { k.items.push(V { s: x }) }

pub fn direct['a](g: fn(&'a String, Sink['a]) -> Void, k: Sink['a]) {
    let loc = "local"
    g(&loc, k) //~ ERROR a value borrowing `loc` cannot go into shared storage
}

pub fn bound['a, F: Fn[fn(&'a String, Sink['a]) -> Void]](g: F, k: Sink['a]) {
    let loc = "local"
    g(&loc, k) //~ ERROR a value borrowing `loc` cannot go into shared storage
}

pub fn alias['a](g: fn(&'a String, Sink['a]) -> Void, k: Sink['a]) {
    let loc = "local"
    let h = g
    h(&loc, k) //~ ERROR a value borrowing `loc` cannot go into shared storage
}

pub fn known['a](k: Sink['a]) {
    let loc = "local"
    keep(&loc, k) //~ ERROR a borrow cannot be stored into `k`
}


pub type V['a] = { pub s &'a String }
pub type Sink['a] = { pub mut items &'a mut Array[V['a]] }
fn keep['a](x: &'a String, k: Sink['a]) { k.items.push(V { s: x }) }
fn nop['a](x: &'a String, k: Sink['a]) { }
pub interface Sized2 { fn size(move self) -> usize }
pub type R0['a, F] = { pub cb F, pub k Sink['a] }
pub fn R0['a, F: Fn[fn(&String, Sink['a]) -> Void]].size(move self) -> usize {
    let loc = "local-${40 + 2}-abcdefghijklmnopqrstuvwxyz"
    (self.cb)(&loc, self.k)
    7
}
pub type Hn = { pub n Int }
fn Hn.measure[R: Sized2](self, r: R) -> usize { r.size() }
pub type Holder[G] = { pub f G }
fn apply['a](g: fn(R0['a, fn(&'a String, Sink['a]) -> Void]) -> usize, r: R0['a, fn(&'a String, Sink['a]) -> Void]) -> usize { g(r) }
fn callRef['a](p: &fn(R0['a, fn(&'a String, Sink['a]) -> Void]) -> usize, r: R0['a, fn(&'a String, Sink['a]) -> Void]) -> usize { p(r) }
fn runAll['a, H: Fn[fn(R0['a, fn(&'a String, Sink['a]) -> Void]) -> usize] + Copy](r: R0['a, fn(&'a String, Sink['a]) -> Void], hs: ...H) -> usize { hs[0](r) }
fn zero['a](r: R0['a, fn(&'a String, Sink['a]) -> Void]) -> usize { 0 }
pub fn wrapBlock['a](k1: Sink['a], k2: Sink['a]) -> usize {
    let hn = Hn { n: 1 }
    let ra: R0['a, fn(&'a String, Sink['a]) -> Void] = R0 { cb: nop, k: k1 }
    let rb: R0['a, fn(&'a String, Sink['a]) -> Void] = R0 { cb: keep, k: k2 }
    let g = hn.measure
    let x = g(ra)
    x + apply({ g }, rb) //~ ERROR cannot be erased
}

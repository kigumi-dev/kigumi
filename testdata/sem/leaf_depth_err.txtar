type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn mk(id: Int) -> Res {
    Res { id: id }
}

fn eat(r: Res) {}

type Guard = resource {
    pub a Res
}

fn Guard.drop(move self) {}

fn mkg(i: Int) -> Guard {
    Guard { a: mk(i) }
}

type Cell = {
    pub v Res
}


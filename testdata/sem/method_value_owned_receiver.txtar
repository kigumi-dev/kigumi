-- lib/mv.kg --
type Res = resource {
    pub n Int
}

fn Res.drop(move self) -> Unit {}

fn Res.get(self, k: Int) -> Int { self.n + k }

fn Res.bump(mut self) -> Unit {}

fn Res.take(move self) -> Int { self.n }

async fn Res.later(self) -> Int { self.n }

async fn Res.laterWith[U](self, u: U) -> U { u }

fn Res.peek[U](self, f: fn(Int) -> U) -> U { f(self.n) }

fn Res.inner(self) -> Int {
    let f = self.get //~ ERROR this receiver is borrowed here
    f(1)
}

fn Res.owned(move self) -> Int {
    let f = self.get //~ TYPE f : closure fn(Int) -> Int
    f(1)
}

type Pt = {
    pub x Int
}

fn Pt.get(self, k: Int) -> Int { self.x + k }

type Holder = resource {
    pub r Res
}

type Keep[F] = {
    pub f F
}

interface Getter {
    fn get(self, k: Int) -> Int
}

interface Bumper {
    fn bump(mut self) -> Unit
}

interface Taker {
    fn take(move self) -> Int
}

fn apply[F: Fn[fn(Int) -> Int]](f: F, k: Int) -> Int { f(k) }

fn applyPeek[F: Fn[fn(fn(Int) -> Int) -> Int]](f: F) -> Int { f((k) => k + 1) }

fn useKeep[F: Fn[fn(Int) -> Int]](k: Keep[F]) -> Int { k.f(1) }

fn concrete(w: Res) -> Int {
    let f = w.get //~ TYPE f : closure fn(Int) -> Int
    f(1) + f(2)
}

fn viaParam[T: Getter](t: T) -> Int {
    let f = t.get //~ TYPE f : closure fn(Int) -> Int
    f(1) + f(2)
}

fn viaCopyParam[T: Getter + Copy](t: T) -> fn(Int) -> Int {
    t.get
}

fn viaExistential(g: Getter) -> Int {
    let f = g.get //~ TYPE f : closure fn(Int) -> Int
    apply(f, 3)
}

fn ownGeneric(w: Res) -> Int {
    applyPeek(w.peek)
}

fn copied(p: Pt) -> Int {
    let f: fn(Int) -> Int = p.get //~ TYPE f : fn(Int) -> Int
    let g: fn(Int) -> Int = p.get
    f(1) + g(2) + p.x
}

fn passed(w: Res) -> Int {
    apply(w.get, 4)
}

fn temporary() -> Int {
    apply(Res { n: 1 }.get, 4)
}

fn stored(w: Res) -> Int {
    useKeep(Keep { f: w.get })
}

fn borrowed(r: &Res) -> Int {
    let f = r.get //~ ERROR this receiver is borrowed here
    f(1)
}

fn borrowedParam[T: Getter](t: &T) -> Int {
    let f = t.get //~ ERROR this receiver is borrowed here
    f(1)
}

fn borrowedField(h: &Holder) -> Int {
    let f = h.r.get //~ ERROR this receiver is borrowed here
    f(1)
}

fn ownedField(h: Holder) -> Int {
    let f = h.r.get //~ ERROR cannot be moved out of a field, element or static
    f(1)
}

fn optional(o: Res?) -> Int? {
    let f = o?.get //~ ERROR cannot be moved out of a field, element or static
    f?(1)
}

fn plain(w: Res) -> fn(Int) -> Int {
    w.get //~ ERROR closure captures `w` (move-only) and cannot be a plain `fn`
}

fn plainParam[T: Getter](t: T) -> Int {
    let f: fn(Int) -> Int = t.get //~ ERROR closure captures `t` (move-only) and cannot be a plain `fn`
    f(1)
}

fn unchanged(mut w: Res, v: Res, x: Res, y: Res) -> Unit {
    let a = w.bump //~ ERROR cannot form a method value on move-only `Res`
    let b = v.take //~ ERROR cannot form a method value on move-only `Res`
    let c = x.later //~ ERROR cannot form a method value on move-only `Res`
    let d = y.laterWith //~ ERROR cannot take its move-only `Res` receiver
}

fn unchangedReq[B: Bumper, T: Taker](mut b: B, t: T) -> Unit {
    let a = b.bump //~ ERROR is an interface requirement with no single implementation
    let c = t.take //~ ERROR consumes its receiver
}

-- app/t/t.kg --
import task from std/task

async fn leaf() -> Int {
    5
}

async fn spawner() -> task.Task[Int] {
    task.spawn(leaf())
}

fn stop(t: task.Task[Int]) -> Unit {
    t.cancel()
}

export(interrupt) {
    pub fn tick() -> Unit { //~ ERROR export(interrupt) handler `tick` may block or reach unverified code
        let ex = task.currentThreadExecutor()
        let t = ex.runToCompletion(spawner())
        stop(t)
    }
}


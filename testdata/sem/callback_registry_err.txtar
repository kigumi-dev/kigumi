type Res = resource {
    pub n Int
}

fn Res.drop(move self) {}

type Reg = { pub mut fs Array[fn() -> Int] }

fn addKept(r: &mut Reg, f: escaping fn() -> Int) {
    r.fs.push(f)
}

fn addLent(r: &mut Reg, f: fn() -> Int) {
    r.fs.push(f) //~ ERROR `f` is a non-escaping callback and cannot be passed to `push` //~ ERROR cannot see what this closure captures
}

fn Reg.addLentMethod(mut self, f: fn() -> Int) {
    self.fs.push(f) //~ ERROR `f` is a non-escaping callback and cannot be passed to `push` //~ ERROR cannot see what this closure captures
}

fn register(r: &mut Reg) {
    let a = Res { n: 1 }
    addKept(r, () => a.n) //~ ERROR closure captures `a` (move-only) and cannot be a plain `fn`
    for i in 0..3 {
        addKept(r, () => i)
    }
    let flag = true
    addKept(r, () => if flag { 1 } else { 0 })
}

fn counted(xs: Array[Int]) -> Int {
    let mut n = 0
    let f: fn(Int) -> Void = (x: Int) => { n = n + x } //~ ERROR closure captures `n` (assigned inside the closure) and cannot be a plain `fn`
    f(1)
    n
}

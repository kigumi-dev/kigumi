-- module --
mir: planned
-- src --
fn eat[T](v: T) {}

type Cell[T] = {
    pub v T
}

fn Cell[T].take(move self) -> T {
    self.v
}

fn Cell[T].orSelf(self, o: Cell[T]?) -> Cell[T] {
    o || self //~ ERROR `self` is borrowed by this method
}

fn arrayThenFallback[T](x: T, y: T) -> T {
    let mut a = Array.of(x, y)
    a.takeAt(1) || x //~ ERROR `x` was moved
}

fn resultFallback[T](r: Result[T, Int], x: T) -> T {
    eat(x)
    r || x //~ ERROR `x` was moved
}

fn handlerFallback[T](r: Result[T, Int], x: T) -> T {
    eat(x)
    r || (e) => x //~ ERROR `x` was moved
}

fn fallbackThenUse[T](o: T?, x: T) -> T {
    let r = o || x
    eat(x) //~ ERROR `x` is moved on some paths but not others
    r
}

fn fallbackTwice[T](o: T?, q: T?, x: T) -> T {
    eat(o || x)
    q || x //~ ERROR `x` is moved on some paths but not others
}

fn fallbackInIf[T](c: Bool, o: T?, x: T, y: T) -> T {
    eat(x)
    if c { o || x } else { y } //~ ERROR `x` was moved
}

fn fallbackInMatch[T](o: T?, q: T?, x: T) -> T {
    eat(x)
    match o {
        Some(v) -> v
        None -> q || x //~ ERROR `x` was moved
    }
}

fn fallbackInLoop[T](x: T) {
    for i in 0..2 {
        let o: T? = None
        eat(o || x) //~ ERROR earlier iteration of the loop
    }
}

fn tryThenFallback[T](r: Result[T, Int], o: Result[T, Int]?) -> Result[T, Int] {
    let a = r?
    eat(a)
    o || r //~ ERROR `r` was moved
}

fn fallbackThenTry[T](o: Result[T, Int]?, r: Result[T, Int]) -> Result[T, Int] {
    eat(o || r)
    let a = r? //~ ERROR `r` is moved on some paths but not others
    Ok(a)
}

fn closureAfterMove[T](o: T?, x: T) -> T {
    eat(x)
    let f = () => o || x //~ ERROR `x` was moved
    f()
}

fn fallbackThenCapture[T](o: T?, x: T) -> T {
    eat(o || x)
    let f = () => x //~ ERROR `x` is moved on some paths but not others
    f()
}

fn onceClosure[T](x: T) -> T {
    let f = (o: T?) => o || x
    eat(f(None))
    f(None) //~ ERROR `f` consumes `x` when called
}

fn receiverThenFallback[T](o: Cell[T]?, c: Cell[T]) -> T {
    eat(c.take())
    let d = o || c //~ ERROR `c` was moved
    d.take()
}

fn fallbackThenReceiver[T](o: Cell[T]?, c: Cell[T]) -> T {
    eat(o || c)
    c.take() //~ ERROR `c` is moved on some paths but not others
}

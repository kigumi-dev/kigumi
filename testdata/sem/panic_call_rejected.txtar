-- src --
import test from std/test

fn direct() -> Int {
    panic("stop") //~ ERROR `panic` is reserved for the std runtime
}

fn bare() -> Unit {
    panic() //~ ERROR `panic` is reserved for the std runtime
}

fn inClosure(xs: Array[Int]) -> Int {
    let n = xs.len().toInt() || 0
    let pick = (x: Int) => if x > 1 { x } else { panic("small") } //~ ERROR `panic` is reserved for the std runtime
    pick(n)
}

fn generic[T](o: Option[T]) -> T {
    o || panic() //~ ERROR `panic` is reserved for the std runtime
}

fn unwrapStays(o: Option[Int], r: Result[Int, String]) -> Int {
    o.unwrap() + o.expect("present") + r.unwrap() + r.expect("ok")
}

fn typedFailure(o: Option[Int]) -> Int! {
    o || fail test.failure("missing")
}

-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

type Cell = {
    pub v Res
    pub n Int
}

type H['a] = {
    pub r &'a Cell
}

fn me(c: &Cell) -> &Cell {
    c
}

fn apply(f: fn(Res?) -> Res) -> Res {
    f(None)
}

fn Cell.tailSelf(self) -> Res {
    apply((o) => o || self.v) //~ ERROR reading `self.v` by value
}

fn Cell.returnSelf(self) -> Res {
    apply((o) => {
        if self.n == 0 {
            return o || self.v //~ ERROR reading `self.v` by value
        }
        Res { id: 9 }
    })
}

fn returnRef(c: &Cell) -> Res {
    apply((o) => {
        if c.n == 0 {
            return if o is Some(r) { r } else { c.v } //~ ERROR reading `c.v` by value
        }
        Res { id: 9 }
    })
}

fn returnLent() -> Res {
    let w = Cell { v: Res { id: 1 }, n: 0 }
    apply((o) => {
        if w.n == 0 {
            return o || w.v //~ ERROR reading `w.v` by value
        }
        Res { id: 9 }
    })
}

fn tailRefField['a](h: H['a]) -> Res {
    apply((o) => o || h.r.v) //~ ERROR reading `h.r.v` by value
}

fn tailRefCall(c: &Cell) -> Res {
    apply((o) => o || me(c).v) //~ ERROR reading `me(c).v` by value
}

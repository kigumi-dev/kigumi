-- app/t/t.kg --
type Item = {
    pub mut count Int
}

fn Item.run[F: FnMut[fn() -> Unit]](mut self, f: F) -> Unit {
    f()
}

fn direct(mut v: Item) -> Unit {
    v.run(() => { v.run(() => {}) }) //~ ERROR a closure argument cannot capture `v`
}

fn indirect(mut v: Item) -> Unit {
    let cb = () => { v.run(() => {}) }
    v.run(cb) //~ ERROR a `mut self` call on `v` conflicts //~ ERROR a closure argument cannot capture `v`
}

fn aliasIndirect(mut v: Item) -> Unit {
    let cb = () => { v.run(() => {}) }
    let cb2 = cb
    v.run(cb2) //~ ERROR a `mut self` call on `v` conflicts //~ ERROR a closure argument cannot capture `v`
}

fn fineIndirect(mut v: Item) -> Unit {
    let cb = () => {}
    v.run(cb)
}

fn makeCb() -> fn() -> Unit {
    () => {}
}

fn viaCall(mut v: Item) -> Unit {
    v.run(makeCb()) //~ ERROR cannot see what this closure captures
}

fn viaIndex(mut v: Item, cbs: Array[fn() -> Unit]) -> Unit {
    v.run(cbs[0]) //~ ERROR cannot see what this closure captures
}

type Resource = resource {
    pub mut count Int
}
fn Resource.drop(move self) -> Unit {}

fn Resource.run[F: FnMut[fn() -> Unit]](mut self, f: F) -> Unit {
    f()
}

fn mutate(x: &mut Resource) -> Unit {
    x.count = 99
}

fn identity(cb: escaping fn() -> Unit) -> fn() -> Unit {
    cb
}

fn viaErasedReturn(mut v: Resource) -> Unit {
    let stored = identity(() => { mutate(&mut v) }) //~ ERROR closure captures `v` (move-only) and cannot be a plain `fn`
    v.run(stored) //~ ERROR cannot see what this closure captures
}

fn viaErasedReturnAlias(mut v: Resource) -> Unit {
    let stored = identity(() => { mutate(&mut v) }) //~ ERROR closure captures `v` (move-only) and cannot be a plain `fn`
    let stored2 = stored
    v.run(stored2) //~ ERROR cannot see what this closure captures
}

fn viaErasedReturnFine(mut v: Resource) -> Unit {
    let stored: fn() -> Unit = () => {}
    v.run(stored)
}

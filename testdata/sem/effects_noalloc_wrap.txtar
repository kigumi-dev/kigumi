-- lib/na.kg --
type Tick = Up(n: Int) | Flat

type Held = Has(s: String) | Gone

type Named = {
    pub name String
    pub n Int
}

type Spot = {
    pub x Int
    pub y Int
}

// Some and Ok a coercion adds build the wrapper like a constructor call, in the frame:
// an Option or Result keeps a String or a boxed record inline as the reference it already is.
noalloc fn wrapDirect(t: Tick, n: Int) -> Result[Tick?, Int] {
    if n > 0 { return t }
    Ok(None)
}

noalloc fn wrapCounted(s: String) -> String? {
    s
}

noalloc fn wrapBesideCounted(t: Tick) -> Result[Tick, String] {
    t
}

// Any other sum type with a reference payload is still a box.
noalloc fn wrapIntoABox(s: String) -> Held {
    Held.Has(s) //~ ERROR constructing `Held` allocates
}

// `fail` and a `?` that cannot hand its operand on build an Err the same way.
noalloc fn failDirect(n: Int) -> Result[Int, Tick] {
    if n > 0 { fail Up(n) }
    Ok(n)
}

noalloc fn failCounted(n: Int) -> Result[String, Tick] {
    fail Up(n)
}

noalloc fn rethrowDirect(r: Result[Int, Tick]) -> Result[Bool, Tick] {
    let v = r?
    Ok(v > 0)
}

noalloc fn rethrowCounted(r: Result[Int, Tick], s: Result[String, Tick]) -> Result[String, Tick] {
    let v = r?
    s
}

// An optional member read builds the Option it yields.
noalloc fn optDirect(o: Spot?) -> Int? {
    o?.y
}

noalloc fn optCounted(o: Named?) -> String? {
    o?.name
}

// A wrapper around a fixed value is one immortal shared by every site.
noalloc fn fixedOk() -> Void! {
    Ok(())
}

noalloc fn fixedTail() -> Void! {}

noalloc fn fixedLiteral() -> String? {
    "lit"
}

noalloc fn fixedNullary() -> Result[String, Tick] {
    Err(Flat)
}

noalloc fn notFixed(n: Int) -> Result[String, Tick] {
    Err(Up(n))
}

noalloc fn fixedFail(n: Int) -> Result[String, Tick] {
    if n > 0 { fail Flat }
    Ok("ok")
}

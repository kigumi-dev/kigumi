-- app/t/t.kg --
import task from std/task

async fn work() -> Int {
    0
}

fn syncRoot() -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(work())
}

fn safeFn() -> Int {
    9
}

type Holder = {
    pub mut cb fn() -> Int
}

type Pair = {
    pub mut left fn() -> Int
    pub mut right fn() -> Int
}

fn bump(mut h: Holder) -> Holder {
    h.cb = safeFn
    h
}

fn bumpNested(mut h: Holder, flag: Bool) -> Holder {
    h.cb = safeFn
    if flag {
        return h
    }
    h
}

fn bumpTwice(mut h: Holder, flag: Bool) -> Holder {
    h.cb = safeFn
    if flag {
        h.cb = safeFn
    }
    h
}

fn bumpPoisoned(mut h: Holder) -> Holder {
    h.cb = syncRoot
    h
}

fn bumpIf(mut h: Holder, flag: Bool) -> Holder {
    if flag {
        h.cb = safeFn
    }
    h
}

fn bumpEarly(mut h: Holder, flag: Bool) -> Holder {
    if flag {
        return h
    }
    h.cb = safeFn
    h
}

fn bumpLoop(mut h: Holder, n: Int) -> Holder {
    for i in 0..n {
        h.cb = safeFn
    }
    h
}

fn bumpLeft(mut p: Pair) -> Pair {
    p.left = safeFn
    p
}

fn bumpAfterCopy(mut h: Holder) -> Holder {
    let c = h
    h.cb = safeFn
    c
}

async fn literalOverwritten() -> Int {
    let h = bump(Holder { cb: syncRoot })
    h.cb()
}

async fn placeOverwritten() -> Int {
    let src = Holder { cb: syncRoot }
    let h = bump(src)
    h.cb()
}

async fn nestedReturnOverwritten() -> Int {
    let h = bumpNested(Holder { cb: syncRoot }, true)
    h.cb()
}

async fn twiceOverwritten() -> Int {
    let h = bumpTwice(Holder { cb: syncRoot }, true)
    h.cb()
}

async fn otherFieldOverwritten() -> Int {
    let p = bumpLeft(Pair { left: syncRoot, right: safeFn })
    p.left() + p.right()
}

async fn riskWrittenSyncRoot() -> Int {
    let h = bumpPoisoned(Holder { cb: safeFn })
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn riskConditionalWrite() -> Int {
    let h = bumpIf(Holder { cb: syncRoot }, true)
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn riskEarlyReturn() -> Int {
    let h = bumpEarly(Holder { cb: syncRoot }, true)
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn riskLoopWrite() -> Int {
    let h = bumpLoop(Holder { cb: syncRoot }, 2)
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn riskOtherField() -> Int {
    let p = bumpLeft(Pair { left: safeFn, right: syncRoot })
    p.right() //~ ERROR cannot run inside an `async fn`
}

async fn riskCopyBeforeWrite() -> Int {
    let h = bumpAfterCopy(Holder { cb: syncRoot })
    h.cb() //~ ERROR cannot run inside an `async fn`
}

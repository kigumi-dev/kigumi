fn twice[F: FnOnce[fn() -> Void]](f: F) {
    f()
    f() //~ ERROR `f` is bound by `FnOnce` and may already have been called
}

fn inLoop[F: FnOnce[fn() -> Void]](f: F, xs: Array[Int]) {
    for x in xs {
        f() //~ ERROR `f` is bound by `FnOnce` and cannot be called inside a loop
    }
}

fn afterBranch[F: FnOnce[fn() -> Void]](f: F, c: Bool) {
    if c {
        f()
    }
    f() //~ ERROR `f` is bound by `FnOnce` and may already have been called
}

fn afterMatch[F: FnOnce[fn() -> Void]](f: F, n: Int) {
    match n {
        0 -> f()
        _ -> {}
    }
    f() //~ ERROR `f` is bound by `FnOnce` and may already have been called
}

fn run(g: fn() -> Void) { g() }

fn afterLambda[F: FnOnce[fn() -> Void]](f: F) {
    f()
    run(() => f()) //~ ERROR `f` is bound by `FnOnce` and cannot be called inside a loop or a closure
}

fn parenthesized[F: FnOnce[fn() -> Void]](f: F) {
    (f)()
    f() //~ ERROR `f` is bound by `FnOnce` and may already have been called
}

// Accepted: one call on each path, and bounds that allow repeating.
fn once[F: FnOnce[fn() -> Void]](f: F) {
    f()
}

fn eachBranch[F: FnOnce[fn() -> Void]](f: F, c: Bool) {
    if c {
        f()
    } else {
        f()
    }
}

fn eachArm[F: FnOnce[fn() -> Void]](f: F, n: Int) {
    match n {
        0 -> f()
        _ -> f()
    }
}

fn eachIfLet[F: FnOnce[fn() -> Void]](f: F, o: Int?) {
    if let x = o {
        f()
    } else {
        f()
    }
}

fn divergingBranch[F: FnOnce[fn() -> Void]](f: F, c: Bool) {
    if c {
        f()
        return
    }
    f()
}

fn withArgument[F: FnOnce[fn(Int) -> Int]](f: F) -> Int {
    f(1)
}

fn repeatable[F: FnMut[fn() -> Void]](f: F) {
    f()
    f()
    for i in 0..3 {
        f()
    }
}

fn repeatableFn[F: Fn[fn() -> Void]](f: F) {
    f()
    f()
}

fn plain(f: fn() -> Void) {
    f()
    f()
}

fn continueLoop[F: FnOnce[fn() -> Void]](f: F, xs: Array[Int]) {
    for x in xs {
        if x > 0 {
            f() //~ ERROR `f` is bound by `FnOnce` and cannot be called inside a loop
            continue
        }
    }
}

fn nestedLoop[F: FnOnce[fn() -> Void]](f: F, xs: Array[Int]) {
    for x in xs {
        for y in xs {
            f() //~ ERROR `f` is bound by `FnOnce` and cannot be called inside a loop
            break
        }
    }
}

fn afterBreakCall[F: FnOnce[fn() -> Void]](f: F, xs: Array[Int]) {
    for x in xs {
        if x > 0 {
            f()
            break
        }
    }
    f() //~ ERROR `f` is bound by `FnOnce` and may already have been called
}

// Accepted: the call is the last thing its path does, so no later iteration or statement repeats it.
fn returnInLoop[F: FnOnce[fn() -> Int]](f: F, xs: Array[Int]) -> Int {
    for x in xs {
        if x > 0 {
            return f()
        }
    }
    0
}

fn returnInLoopThenCall[F: FnOnce[fn() -> Int]](f: F, xs: Array[Int]) -> Int {
    for x in xs {
        if x > 0 {
            return f()
        }
    }
    f()
}

fn bareLoopReturn[F: FnOnce[fn() -> Void]](f: F) {
    for {
        f()
        return
    }
}

fn breakAfterCall[F: FnOnce[fn() -> Void]](f: F, xs: Array[Int]) {
    for x in xs {
        if x > 0 {
            f()
            break
        }
    }
}

fn elseReturnsCall[F: FnOnce[fn() -> Int]](f: F, o: Int?) -> Int {
    let Some(x) = o else {
        return f()
    }
    x + f()
}

fn elseDivergesThenCall[F: FnOnce[fn() -> Void]](f: F, o: Int?) {
    let Some(x) = o else {
        f()
        return
    }
    f()
}

fn run2[F: FnOnce[fn() -> Int]](f: F) -> Int { f() }

fn runFn[G: Fn[fn() -> Int]](g: G) -> Int { g() + g() }

fn mapWrapped[F: FnOnce[fn() -> Int]](f: F) -> Int {
    Array.of(1, 2, 3).map((x: &Int) => f()).len().toInt() || 0 //~ ERROR `f` is bound by `FnOnce` and cannot be called inside a loop or a closure
}

fn fnWrapped[F: FnOnce[fn() -> Int]](f: F) -> Int {
    runFn(() => f()) //~ ERROR `f` is bound by `FnOnce` and cannot be called inside a loop or a closure
}

fn passedTwice[F: FnOnce[fn() -> Int]](f: F) -> Int {
    run2(f) + run2(f) //~ ERROR `f` is bound by `FnOnce` and may already have been called
}

fn calledThenPassed[F: FnOnce[fn() -> Int]](f: F) -> Int {
    let a = f()
    run2(f) + a //~ ERROR `f` is bound by `FnOnce` and may already have been called
}

fn passedInLoop[F: FnOnce[fn() -> Int]](f: F, xs: Array[Int]) -> Int {
    for x in xs {
        _ = run2(f) //~ ERROR `f` is bound by `FnOnce` and cannot be called inside a loop or a closure
    }
    0
}

fn reassigned[F: FnOnce[fn() -> Int]](mk: fn() -> F) -> Int {
    let mut f = mk()
    let a = f()
    f = mk()
    a + f()
}

fn passedOnce[F: FnOnce[fn() -> Int]](f: F) -> Int { run2(f) }

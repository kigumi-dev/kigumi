-- src --
type Handle = resource { pub id Int }

fn Handle.drop(move self) {
    print "drop ${self.id}"
}

fn take(h: Handle) {
    print "take ${h.id}"
}

fn reassign() {
    let mut h = Handle { id: 1 }
    defer {
        let f = move () => take(h)
        f()
    }
    h = Handle { id: 2 } //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be assigned
}

fn moveOut() {
    let h = Handle { id: 3 }
    defer {
        let f = move () => take(h)
        f()
    }
    take(h) //~ ERROR `h` is reserved by a cleanup that consumes it and cannot be moved
}

fn copyFields() {
    let mut h = Handle { id: 4 }
    defer {
        match h {
            Handle { id } -> print "m ${id}"
        }
    }
    h = Handle { id: 5 }
}

fn ownedInside() {
    defer {
        let k = Handle { id: 6 }
        let f = move () => take(k)
        f()
    }
    print "body"
}

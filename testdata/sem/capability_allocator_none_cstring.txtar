-- src --
import ffi from std/ffi

export(C) {
    pub fn start() -> Int {
        let text = "hi"
        match ffi.CString.new(&text) {
            Ok(c) -> {
                if ffi.isNull(c.ptr()) {
                    1
                } else {
                    0
                }
            }
            Err(_) -> 2
        }
    }
}

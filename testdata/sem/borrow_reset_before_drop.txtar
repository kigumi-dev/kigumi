stage: driver
-- src --
type View['a] = { pub data &'a Array[Int], pub off usize }

fn View['a].at(self) -> Int {
    self.data[self.off]
}

fn resetBeforeDrop() -> Int {
    let a = Array.of(1, 2, 3)
    let mut cur = View { data: &a, off: 0 }
    {
        let b = Array.of(42)
        cur = View { data: &b, off: 0 }
        _ = cur.at()
        cur = View { data: &a, off: 2 }
    }
    cur.at()
}

fn containerReset() -> Int {
    let a = Array.of(1, 2, 3)
    let mut vs = Array.of(View { data: &a, off: 0 })
    {
        let b = Array.of(42)
        vs = Array.of(View { data: &b, off: 0 })
        vs = Array.of(View { data: &a, off: 1 })
    }
    vs[0].at()
}

fn noReset() -> Int {
    let a = Array.of(1, 2, 3)
    let mut cur = View { data: &a, off: 0 }
    {
        let b = Array.of(42)
        cur = View { data: &b, off: 0 }
    }
    cur.at()
}

fn branchReset(k: Bool) -> Int {
    let a = Array.of(1, 2, 3)
    let mut cur = View { data: &a, off: 0 }
    {
        let b = Array.of(42)
        cur = View { data: &b, off: 0 }
        if k {
            cur = View { data: &a, off: 1 }
        }
    }
    cur.at()
}

fn loopReset(n: Int) -> Int {
    let a = Array.of(1, 2, 3)
    let mut cur = View { data: &a, off: 0 }
    {
        let b = Array.of(42)
        for i in 0..n {
            cur = View { data: &a, off: 1 }
            cur = View { data: &b, off: 0 }
        }
    }
    cur.at()
}

-- lib/fv.kg --
interface Shower {
    fn show(self) -> String
}

type Pt = {
    x Int
    y Int
}

fn Pt.show(self) -> String { "pt" }

fn identity[T](x: T) -> T { x }
fn describe[T: Shower](x: T) -> String { x.show() }
fn collect(xs: ...Int) -> Int { 0 }

fn use() -> Unit {
    let a = identity[Pt] //~ TYPE a : fn(Pt) -> Pt
    let b: fn(Pt) -> Pt = identity
    let c = describe[Pt] //~ ERROR `describe` has interface-bounded type parameters
    let d: fn(Pt) -> String = describe //~ ERROR `describe` has interface-bounded type parameters
    let e = Array.of[Int] //~ ERROR variadic function `of` has no function value
    let f = collect //~ ERROR variadic function `collect` has no function value
    let g = describe(Pt { x: 1, y: 2 }) //~ TYPE g : String
}

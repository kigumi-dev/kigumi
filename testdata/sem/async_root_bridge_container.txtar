-- app/t/t.kg --
import task from std/task

async fn work() -> Int {
    0
}

fn syncRoot() -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(work())
}

fn safeFn() -> Int {
    9
}

type Holder = {
    pub cb fn() -> Int
}

fn Holder.me(self) -> Holder {
    self
}

fn id[T](x: T) -> T {
    x
}

fn pair(h: Holder, n: Int) -> (Holder, Int) {
    (h, n)
}

fn pairOf(risky: Bool) -> (Holder, Int) {
    if risky {
        (Holder { cb: syncRoot }, 1)
    } else {
        (Holder { cb: safeFn }, 2)
    }
}

fn wrap(h: Holder) -> Option[Holder] {
    Some(h)
}

fn many(h: Holder) -> Array[Holder] {
    Array.of(h)
}

fn nested(h: Holder) -> Option[(Holder, Int)] {
    Some((h, 3))
}

async fn selfRisky() -> Int {
    let h = Holder { cb: syncRoot }
    h.me().cb() //~ ERROR cannot run inside an `async fn`
}

async fn selfSafe() -> Int {
    let h = Holder { cb: safeFn }
    h.me().cb()
}

async fn genericRisky() -> Int {
    let r = id(Holder { cb: syncRoot })
    r.cb() //~ ERROR cannot run inside an `async fn`
}

async fn genericSafe() -> Int {
    let r = id(Holder { cb: safeFn })
    r.cb()
}

async fn tupleRisky() -> Int {
    let (h, n) = pair(Holder { cb: syncRoot }, 1)
    h.cb() + n //~ ERROR cannot run inside an `async fn`
}

async fn tupleSafe() -> Int {
    let (h, n) = pair(Holder { cb: safeFn }, 1)
    h.cb() + n
}

async fn tupleLiteralRisky() -> Int {
    let (h, n) = pairOf(true)
    h.cb() + n //~ ERROR cannot run inside an `async fn`
}

async fn tupleLocalRisky() -> Int {
    let t = (Holder { cb: syncRoot }, 1)
    let (h, n) = t
    h.cb() + n //~ ERROR cannot run inside an `async fn`
}

async fn tupleLocalSafe() -> Int {
    let t = (Holder { cb: safeFn }, 1)
    let (h, n) = t
    h.cb() + n
}

async fn optionRisky() -> Int {
    let h = Holder { cb: syncRoot }
    match Some(h) {
        Some(x) -> x.cb() //~ ERROR cannot run inside an `async fn`
        None -> 0
    }
}

async fn optionSafe() -> Int {
    let h = Holder { cb: safeFn }
    match Some(h) {
        Some(x) -> x.cb()
        None -> 0
    }
}

async fn optionIfLetRisky() -> Int {
    let o = Some(Holder { cb: syncRoot })
    if let Some(x) = o {
        x.cb() //~ ERROR cannot run inside an `async fn`
    } else {
        0
    }
}

async fn optionResultRisky() -> Int {
    match wrap(Holder { cb: syncRoot }) {
        Some(x) -> x.cb() //~ ERROR cannot run inside an `async fn`
        None -> 0
    }
}

async fn optionResultSafe() -> Int {
    match wrap(Holder { cb: safeFn }) {
        Some(x) -> x.cb()
        None -> 0
    }
}

async fn arrayRisky() -> Int {
    let a = Array.of(Holder { cb: syncRoot })
    a[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn arraySafe() -> Int {
    let a = Array.of(Holder { cb: safeFn })
    a[0].cb()
}

async fn arrayDirectRisky() -> Int {
    Array.of(Holder { cb: syncRoot })[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn arrayResultRisky() -> Int {
    let a = many(Holder { cb: syncRoot })
    a[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn arrayResultSafe() -> Int {
    let a = many(Holder { cb: safeFn })
    a[0].cb()
}

async fn nestedRisky() -> Int {
    match nested(Holder { cb: syncRoot }) {
        Some((x, n)) -> x.cb() + n //~ ERROR cannot run inside an `async fn`
        None -> 0
    }
}

async fn nestedSafe() -> Int {
    match nested(Holder { cb: safeFn }) {
        Some((x, n)) -> x.cb() + n
        None -> 0
    }
}

async fn closureRisky() -> Int {
    let h = Holder { cb: syncRoot }
    let f = () => h
    f().cb() //~ ERROR cannot run inside an `async fn`
}

async fn closureSafe() -> Int {
    let h = Holder { cb: safeFn }
    let f = () => h
    f().cb()
}


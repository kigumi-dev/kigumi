-- module --
mir: planned
-- src --
type V['a] = { pub s &'a String }
fn apply['a](g: fn(V['a]) -> Void, x: V['a]) { g(x) }
fn applyIn['a](g: fn(V['a]) -> Void, x: V['a]) { g(x) }

fn direct['a](g: fn(V['a]) -> Void) {
    let loc = "frame-local"
    g(V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}

fn forwarded['a](g: fn(V['a]) -> Void) {
    let loc = "frame-local"
    apply(g, V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}

fn nested['a](g: fn(V['a]) -> Void) {
    let loc = "frame-local"
    apply((x: V['a]) => { applyIn((y: V['a]) => { g(y) }, x) }, V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}

fn aliased['a](g: fn(V['a]) -> Void) {
    let loc = "frame-local"
    let h = g
    h(V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}

fn read['a](x: V['a]) { _ = x.s }
fn replaced['a](mut g: fn(V['a]) -> Void, h: fn(V['a]) -> Void, b: Bool) {
    if b { g = h } else { g = h }
    let loc = "frame-local"
    g(V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}

fn wrapped['a](g: fn(V['a]) -> Void) {
    let loc = "frame-local"
    g(V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}
fn proxy['a](g: fn(V['a]) -> Void) {
    wrapped((x: V['a]) => { g(x) })
}

fn caller['a](u: &'a String) {
    let mut arr = Array.of(V { s: u })
    let r = &mut arr
    direct((y: V['a]) => { r.push(y) })
    forwarded((y: V['a]) => { r.push(y) })
    nested((y: V['a]) => { r.push(y) })
    aliased((y: V['a]) => { r.push(y) })
    replaced(read, (y: V['a]) => { r.push(y) }, true)
    proxy((y: V['a]) => { r.push(y) })
    _ = arr.len()
}

fn unbound['a](g: fn(V['a]) -> Void) {
    let loc = "frame-local"
    g(V { s: &loc }) //~ ERROR a value borrowing `loc` cannot go into shared storage
}

let u = "caller"
caller(&u)

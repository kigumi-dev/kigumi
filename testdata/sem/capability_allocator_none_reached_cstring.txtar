-- module --
stage: driver
allocator: none
-- src --
import ffi from std/ffi
import {AllocatorHandle} from std/alloc

fn probe(h: AllocatorHandle) -> Int {
    allocator h.scope() {
        let text = "hi"
        match ffi.CString.new(&text) {
            Ok(c) -> if ffi.isNull(c.ptr()) { 1 } else { 0 }
            Err(_) -> 2
        }
    }
}

fn main() -> Unit! {
    let h: AllocatorHandle? = None
    if h is Some(handle) {
        let r = probe(handle)
    }
}

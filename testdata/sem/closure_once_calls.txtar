-- module --
mir: planned
-- src --
type Handle = resource {
    pub mut id Int
}

fn Handle.drop(move self) {}

fn Handle.close(move self) {}

fn Handle.peek(self) -> Int {
    self.id
}

type Pack = {
    pub mut inner Handle
    pub mut other Handle
    pub mut n Int
}

fn mkh(n: Int) -> Handle {
    Handle { id: n }
}

fn mk(n: Int) -> Pack {
    Pack { inner: mkh(n), other: mkh(n + 1), n: 0 }
}

fn take(h: Handle) {}

fn sink(n: Int) {}

fn callOnceBranches[F: FnOnce[fn() -> Void]](f: F, c: Bool) {
    if c {
        f()
    } else {
        f()
    }
}

fn fieldInLoop() {
    let b = mk(1)
    let f = () => { b.other.close() }
    for i in 0..2 {
        f() //~ ERROR consumes `b.other`
    }
}

fn wholeTwice() {
    let h = mkh(1)
    let f = () => { h.close() }
    f()
    f() //~ ERROR consumes `h`
}

fn returnedTwice() {
    let h = mkh(1)
    let f = () => h
    let a = f()
    let b = f() //~ ERROR consumes `h`
}

fn passedOn() {
    let h = mkh(1)
    let f = () => { take(h) }
    f()
    f() //~ ERROR consumes `h`
}

fn consumedViaNested() {
    let h = mkh(1)
    let f = () => { h.close() }
    let g = () => { f() }
    g()
    g() //~ ERROR consumes `f`
}

fn deferInLoop() {
    let h = mkh(1)
    let f = () => { h.close() }
    for i in 0..2 {
        defer { f() } //~ ERROR consumes `h`
    }
}

fn onceCalledOnce() {
    let h = mkh(1)
    let f = () => { h.close() }
    f()
}

fn onceInBranches(c: Bool) {
    let h = mkh(1)
    let f = () => { h.close() }
    if c {
        f()
    } else {
        f()
    }
}

fn borrowedManyTimes() {
    let h = mkh(1)
    let f = () => h.peek()
    sink(f())
    sink(f())
}

fn borrowedField() {
    let b = mk(1)
    let f = () => b.other.peek()
    for i in 0..2 {
        sink(f())
    }
}

fn copyCaptureManyTimes() {
    let n = 5
    let f = () => n + 1
    sink(f())
    sink(f())
}

fn perIterationClosure() {
    for i in 0..2 {
        let h = mkh(i)
        let f = () => { h.close() }
        f()
    }
}

type Slot = {
    pub mut opt Handle?
}

fn refillClosure() {
    let mut h = mkh(1)
    let f = () => {
        h.close()
        h = mkh(2)
    }
    f()
    f()
    h.close() //~ ERROR `h` was moved
}

fn refillFieldClosure() {
    let mut p = mk(10)
    let f = () => {
        p.other.close()
        p.other = mkh(11)
    }
    f()
    f()
}

fn refillPayloadClosure() {
    let mut s = Slot { opt: Some(mkh(20)) }
    let f = () => {
        match s.opt {
            Some(h) -> h.close()
            None -> {}
        }
        s.opt = None
    }
    f()
    f()
}

fn assignedBeforeConsume() {
    let mut h = mkh(1)
    let f = () => {
        h = mkh(2)
        h.close()
    }
    f()
    f() //~ ERROR can be called only once
}

fn conditionalRefill(c: Bool) {
    let mut h = mkh(1)
    let f = () => {
        h.close()
        if c {
            h = mkh(2)
        }
    }
    f()
    f() //~ ERROR can be called only once
}

fn sumOf(xs: Array[Int]) -> Int {
    xs[0]
}

fn ownedArrayTwice() -> Int {
    let xs = Array.of(1, 2)
    let f = () => sumOf(xs)
    f() + f() //~ ERROR can be called only once
}

type Holder[F] = {
    pub f F
}

fn storedInFieldOnce() {
    let p = mk(30)
    let f = () => { p.other.close() }
    let s = Holder { f: f }
    (s.f)()
}

fn storedInFieldTwice() {
    let p = mk(40)
    let f = () => { p.other.close() }
    let s = Holder { f: f }
    (s.f)()
    (s.f)() //~ ERROR can be called only once
}

fn storedInFieldInLoop() {
    let p = mk(50)
    let f = () => { p.other.close() }
    let s = Holder { f: f }
    for i in 0..2 {
        (s.f)() //~ ERROR can be called only once
    }
}

fn returnBeforeRefill(c: Bool) {
    let mut h = mkh(1)
    let f = () => {
        h.close()
        if c {
            return ()
        }
        h = mkh(2)
    }
    f()
    f() //~ ERROR can be called only once
}

fn matchReturnBeforeRefill() {
    let mut h = mkh(1)
    let f = (x: Int) => {
        h.close()
        match x > 0 {
            true -> { return 0 }
            false -> {}
        }
        h = mkh(2)
        1
    }
    sink(f(1))
    sink(f(1)) //~ ERROR can be called only once
}

fn continueBeforeRefill(c: Bool) {
    let mut h = mkh(1)
    let f = () => {
        for i in 0..1 {
            h.close()
            if c {
                continue
            }
            h = mkh(2)
        }
    }
    f()
    f() //~ ERROR can be called only once
}

fn innerLoopBreakKeepsRefill(xs: Array[Int]) {
    let mut h = mkh(1)
    let f = () => {
        h.close()
        for x in &xs {
            if x > 0 {
                break
            }
        }
        h = mkh(2)
    }
    f()
    f()
}

type S[F] = {
    pub f F
}

fn S[F: FnOnce[fn() -> Void]].run(self) {
    (self.f)() //~ ERROR reached through a borrow
}

fn S[F: FnOnce[fn() -> Void]].runOwned(move self) {
    (self.f)()
}

fn runS[F: FnOnce[fn() -> Void]](s: &S[F]) {
    (s.f)() //~ ERROR reached through a borrow
}

fn runOwnedOnce() {
    let p = mk(60)
    let s = S { f: () => { p.other.close() } }
    s.runOwned()
}

fn innerOnceThenOuter() {
    let h = mkh(1)
    let g = () => { h.close() }
    let k = () => { g() }
    k()
    g() //~ ERROR can be called only once
}

fn outerAfterInner() {
    let h = mkh(1)
    let g = () => { h.close() }
    g()
    let k = () => { g() } //~ ERROR can be called only once
    k()
}

fn innerDeferredAndOuter() {
    let h = mkh(1)
    let g = () => { h.close() }
    defer { g() } //~ ERROR can be called only once
    let k = () => { g() }
    k()
}

type Point = {
    pub mut x Int
    pub y Int
}

fn Point.bump(mut self) -> Unit {
    self.x = self.x + 1
}

fn setX(p: &mut Point) -> Unit {
    p.x = 5
}

noalloc fn viaReceiver() -> Int {
    let mut p = Point { x: 1, y: 2 }
    p.bump() //~ ERROR handing `Point` to a slot that holds a reference allocates a box for it //~ ERROR `bump` is not `noalloc`
    p.x
}

noalloc fn viaMutBorrow() -> Int {
    let mut p = Point { x: 1, y: 2 }
    setX(&mut p) //~ ERROR handing `Point` to a slot that holds a reference allocates a box for it
    p.x
}

fn main() -> Unit! {
    let n = viaReceiver() + viaMutBorrow()
}

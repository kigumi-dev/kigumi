-- src --
type Res = resource {
    pub mut id Int
}

fn Res.drop(move self) {}

fn mk(id: Int) -> Res {
    Res { id: id }
}

type P = {
    pub mut x Int
}

type W = {
    pub items Array[Res]
}

fn eat(r: Res) -> Int {
    r.id
}

fn eatAll(a: Array[Res]) -> Int {
    a.len().toInt() || 0
}

fn sum(a: Array[Int]) -> Int {
    a.len().toInt() || 0
}

fn first(a: Array[P]) -> Int {
    a[0].x
}

fn mutate(mut a: Array[P]) {
    a[0].x = 9
}

fn bump(a: &mut Array[P]) {
    a[0].x = 9
}

fn popIt(a: &mut Array[Array[Res]]) -> Array[Res] {
    a.takeAt(0) || Array.empty()
}

fn setFirst(a: &mut Array[Res]) {
    a[0] = mk(9)
}

fn P.inc(mut self) {
    self.x = self.x + 1
}

type V = {
    pub mut items Array[Res]
    pub mut p P
}

fn collect(a: &Array[Res]) -> Int {
    a.len().toInt() || 0
}

fn mka(i: Int) -> Array[Array[Res]] {
    Array.of(Array.of(mk(i)))
}

fn mkrs(i: Int) -> Array[Res] {
    Array.of(mk(i))
}

fn consumeNested(xss: Array[Array[Res]]) -> Int {
    let mut n = 0
    for a in xss[0..1] { //~ ERROR `for` over `xss[0..1]` would take each element
        for r in a {
            n = n + eat(r)
        }
    }
    n
}

fn handedRes(ys: Array[Res]) -> Int {
    eatAll(ys[0..1]) //~ ERROR reading `Array[Res]` out of an index by value
}

fn handedRecord(ps: Array[P]) -> Int {
    first(ps[0..2]) //~ ERROR reading `Array[P]` out of an index by value
}

fn handedGeneric[T: Copy](xs: Array[T]) -> Array[T] {
    xs[0..1] //~ ERROR reading `Array[T]` out of an index by value
}

fn returned(xs: Array[Res]) -> Array[Res] {
    xs[1..2] //~ ERROR reading `Array[Res]` out of an index by value
}

fn returnedRef(xs: &Array[Res]) -> Array[Res] {
    xs[1..2] //~ ERROR reading `Array[Res]` out of an index by value
}

fn built(ys: Array[Res]) -> W {
    W { items: ys[0..1] } //~ ERROR reading `Array[Res]` out of an index by value
}

fn joined(c: Bool, ys: Array[Res]) -> Int {
    let a = if c { ys[0..1] } else { mkrs(0) } //~ ERROR reading `Array[Res]` out of an index by value
    a.len().toInt() || 0
}

fn assigned(ys: Array[Res]) {
    let mut out = mkrs(0)
    out = ys[0..1] //~ ERROR reading `Array[Res]` out of an index by value
    _ = out
}

fn writeViaLet(ps: Array[P]) {
    let mut zs = ps[0..1]
    zs[0].x = 77 //~ ERROR `zs` is immutable
}

fn writeInPlace(ps: Array[P]) {
    ps[0..1][0].x = 9 //~ ERROR `ps` is immutable
}

fn writeHanded(ps: Array[P]) {
    mutate(ps[0..1]) //~ ERROR reading `Array[P]` out of an index by value
}

fn writeBorrowed(ps: Array[P]) {
    bump(&mut ps[0..1]) //~ ERROR `ps[0..1]` is a slice, a new array that shares only the elements of `ps`
}

fn takeFromSlice(mut ys: Array[Array[Res]]) -> Int {
    let a = ys[0..1].takeAt(0) || Array.empty() //~ ERROR `ys[0..1]` is a slice
    a.len().toInt() || 0
}

fn takeViaMutRef(mut ys: Array[Array[Res]]) -> Int {
    let a = popIt(&mut ys[0..1]) //~ ERROR `ys[0..1]` is a slice
    a.len().toInt() || 0
}

fn takeInCallee(ms: &mut Array[Array[Res]]) -> Int {
    let a = ms[0..1].takeAt(0) || Array.empty() //~ ERROR `ms[0..1]` is a slice
    a.len().toInt() || 0
}

fn slotWrite(mut ps: Array[P]) {
    ps[0..1][0] = P { x: 9 } //~ ERROR `ps[0..1][0]` is in the slice `ps[0..1]`
}

fn valueSlotWrite(mut ns: Array[Int]) {
    ns[0..1][0] = 9 //~ ERROR cannot assign to this expression
}

fn valueSlotAdd(mut ns: Array[Int]) {
    ns[0..1][0] += 1 //~ ERROR cannot assign to this expression
}

fn valueSlicePush(mut ns: Array[Int]) {
    ns[0..2].push(4) //~ ERROR `push` takes `mut self` but the receiver is a temporary
}

fn slotWriteViaMutRef(mut rs: Array[Res]) {
    setFirst(&mut rs[0..1]) //~ ERROR `rs[0..1]` is a slice
}

fn mutSelfOnSlot(mut ps: Array[P]) {
    ps[0..1][0].inc() //~ ERROR `ps[0..1][0]` is in the slice `ps[0..1]`
}

fn nestedSliceWrite(mut ps: Array[P]) {
    ps[0..2][0..1][0] = P { x: 5 } //~ ERROR `ps[0..2][0..1][0]` is in the slice `ps[0..2][0..1]`
}

fn elementUnderSlice(ys: Array[Res]) -> Int {
    eat(ys[0..1][0]) //~ ERROR reading `Res` out of an index by value
}

fn moveUnderSlice(ys: Array[Res]) -> Int {
    eat(move ys[0..1][0]) //~ ERROR cannot move a value out of an index
}

fn mutLoopOverSlice(mut ps: Array[P]) {
    for p in &mut ps[0..1] { //~ ERROR `ps[0..1]` is a slice
        p.x = 1
    }
}

fn keptShared(ys: Array[Res]) -> Int {
    let zs = &ys[0..1] //~ ERROR `let` cannot keep a borrow of the result of `ys[0..1]`
    zs.len().toInt() || 0
}

fn keptMut() {
    let mut ms = mkrs(1)
    let ws = &mut ms[0..1] //~ ERROR `ms[0..1]` is a slice
    _ = ws
}

fn keptString(s: String) -> Int {
    let r = &s[0..2] //~ ERROR `let` cannot keep a borrow of the result of `s[0..2]`
    r.len().toInt() || 0
}

fn viewOk(ys: Array[Res], ns: Array[Int]) -> Int {
    let mut n = 0
    for k in ns[0..2] {
        n = n + k
    }
    for r in &ys[0..1] {
        n = n + r.id
    }
    let zs = ys[0..1] //~ TYPE zs : &Array[Res]
    let ks = ns[1..2] //~ TYPE ks : Array[Int]
    n = n + sum(ns[0..2])
    n = n + collect(&ys[0..1]) + collect(zs)
    for a in mka(1)[0..1] {
        for r in a {
            n = n + eat(r)
        }
    }
    n = n + eatAll(mkrs(2)[0..1])
    let mut ms = Array.of(P { x: 1 })
    ms[0..1][0].x = 7
    let mut vs = Array.of(V { items: Array.of(mk(1)), p: P { x: 1 } })
    vs[0..1][0].items[0] = mk(9)
    vs[0..1][0].p.x = 5
    vs[0..1][0].items = Array.of(mk(7))
    let r = &mut vs[0..1][0].items
    r.push(mk(8))
    vs[0..1][0].p.inc()
    let e = &ys[0..1][0] //~ TYPE e : &Res
    n = n + e.id
    n + (ks.len().toInt() || 0)
}

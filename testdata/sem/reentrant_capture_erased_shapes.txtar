-- app/t/t.kg --
type Resource = resource {
    pub mut count Int
}
fn Resource.drop(move self) -> Unit {}

fn Resource.run[F: FnMut[fn() -> Unit]](mut self, f: F) -> Unit {
    f()
}

fn mutate(x: &mut Resource) -> Unit {
    x.count = 99
}

type Holder = {
    pub cb fn() -> Unit
}

fn pack(f: escaping fn() -> Unit) -> Holder {
    Holder { cb: f }
}

fn viaFieldRead(mut v: Resource) -> Unit {
    let holder = pack(() => { mutate(&mut v) }) //~ ERROR closure captures `v` (move-only) and cannot be a plain `fn`
    v.run(holder.cb) //~ ERROR cannot see what this closure captures
}

fn identity(f: escaping fn() -> Unit) -> fn() -> Unit {
    f
}

fn viaCallResult(mut v: Resource) -> Unit {
    let stored = identity(() => { mutate(&mut v) }) //~ ERROR closure captures `v` (move-only) and cannot be a plain `fn`
    v.run(stored) //~ ERROR cannot see what this closure captures
}

fn viaIndex(mut v: Resource, cbs: Array[fn() -> Unit]) -> Unit {
    v.run(cbs[0]) //~ ERROR cannot see what this closure captures
}

type HolderArray = {
    pub cbs Array[fn() -> Unit]
}

fn viaFieldThenIndex(mut v: Resource, holder: HolderArray) -> Unit {
    v.run(holder.cbs[0]) //~ ERROR cannot see what this closure captures
}

fn doNothing() -> Unit {}

fn viaTopLevelFn(mut v: Resource) -> Unit {
    v.run(doNothing)
}

-- app/t/t.kg --
import {Box, Shared} from std/alloc

type View['a] = { pub data &'a Bytes, pub off usize }

fn stash['a](b: &'a Bytes) -> Unit {
    let v = View { data: b, off: 0 }
    let s: Box[View['a]] = Box.new(v) //~ ERROR carries a borrow and cannot be stored
    _ = s
}

fn stashInferred['a](b: &'a Bytes) -> Unit {
    let v = View { data: b, off: 0 }
    let s = Box.new(v) //~ ERROR carries a borrow and cannot be stored
    _ = s
}

fn ship[T: Send](x: T) -> Unit {}

fn share[T: Sync](x: &T) -> Unit {}

fn threads(plain: Box[Int], arr: Box[Array[Int]], cell: Box[Shared[Int]]) -> Unit {
    ship(plain)
    ship(arr)
    ship(cell) //~ ERROR `Box[Shared[Int]]` does not satisfy `Send`
    share(&plain)
    share(&cell) //~ ERROR `Box[Shared[Int]]` does not satisfy `Sync`
}

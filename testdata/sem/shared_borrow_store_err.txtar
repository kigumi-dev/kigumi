-- module --
mir: planned
-- src --
import {Shared, Weak, Box} from std/alloc
import {UnsafeCell} from std/mem
import ffi from std/ffi

interface Bump {
    fn bump(mut self)
    fn get(self) -> Int
}

type Counter = { pub mut n Int }

fn Counter.bump(mut self) {
    self.n = self.n + 1
}

fn Counter.get(self) -> Int {
    self.n
}

async fn acount(c: &mut Bump) -> Int {
    c.bump()
    c.get()
}

async fn mut1(a: &mut Array[String]) -> usize {
    a.push("b")
    a.len()
}

async fn plain(n: usize) -> usize {
    n + 1
}

type Sh = { cell Shared[Future[usize]?] }

fn Sh.put(self, f: Future[usize]) {
    self.cell.set(Some(f))
}

fn Sh.putMut(mut self, f: Future[usize]) {
    self.cell.set(Some(f))
}

fn putRef(s: &mut Sh, f: Future[usize]) {
    s.cell.set(Some(f))
}

fn putIn(s: Shared[Future[usize]?], f: Future[usize]) {
    s.set(Some(f))
}

type Rec = { pub f Future[usize] }

fn putRec(s: Shared[Rec?], r: Rec) {
    s.set(Some(r))
}

fn putView(s: Shared[Future[Int]?], f: Future[Int]) {
    s.set(Some(f))
}

async fn putLater(s: Shared[Future[usize]?], f: Future[usize]) {
    s.set(Some(f))
}

fn recPut(s: Shared[Future[usize]?], n: Int, f: Future[usize]) {
    if n > 0 {
        recPut(s, n - 1, f)
    } else {
        s.set(Some(f))
    }
}

type Holder = { pub s Shared[Future[usize]?] }

interface Sink {
    fn take(mut self, f: Future[usize])
}

type ShSink = { cell Shared[Future[usize]?] }

fn ShSink.take(mut self, f: Future[usize]) {
    self.cell.set(Some(f))
}

fn sinkInto(o: &mut Sink, f: Future[usize]) {
    o.take(f)
}

fn each(n: Int, f: fn(Int) -> Void) {
    f(n)
}

interface Tk {
    fn keep(self, f: Future[usize])
}

type D = { pub s Shared[Future[usize]?] }

fn D.keep(self, f: Future[usize]) {
    self.s.set(Some(f))
}

interface TkG[T] {
    fn hold(self, f: T)
}

type G = { pub s Shared[Future[usize]?] }

fn G.hold(self, f: Future[usize]) {
    self.s.set(Some(f))
}

type GV = { pub s Shared[Future[Int]?] }

fn GV.hold(self, f: Future[Int]) {
    self.s.set(Some(f))
}

fn keepVia[K: Tk](k: K, f: Future[usize]) {
    k.keep(f)
}

type Hold = { pub f fn(Shared[Future[usize]?], Future[usize]) -> Void }

fn apply[T](f: fn(T, Future[usize]) -> Void, t: T, x: Future[usize]) {
    f(t, x)
}

type Two = { pub a Shared[Future[usize]?], pub b Shared[Future[usize]?] }

type Fns = { pub a Shared[Array[fn(Int) -> Int]], pub b Shared[Array[fn(Int) -> Int]] }

async fn peek(o: &mut Future[usize]?) -> usize {
    3
}

fn takeOpt(o: &mut Future[usize]?) -> Future[usize]? {
    o.take()
}

fn unwrap1(mut o: Future[usize]?) -> Future[usize]? {
    o.take()
}

fn callBound[F: Fn[fn(Future[usize]) -> Void]](g: F) {
    let mut z = Array.of("a")
    g(mut1(&mut z)) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn direct(sh: Shared[Future[usize]?]) {
    let mut z = Array.of("a")
    sh.set(Some(mut1(&mut z))) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn selfMethod(s: Sh) {
    let mut z = Array.of("a")
    s.put(mut1(&mut z)) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn selfMethodValue(s: Sh) {
    let mut z = Array.of("a")
    let put = s.put
    put(mut1(&mut z)) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn cloneMethodValue(sh: Shared[Future[usize]?]) {
    let mut z = Array.of("a")
    let set = sh.clone().set
    set(Some(mut1(&mut z))) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn mutRecv(s: Sh) {
    let mut z = Array.of("a")
    let mut t = s
    t.putMut(mut1(&mut z)) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn mutRefHelper(s: Sh) {
    let mut z = Array.of("a")
    let mut t = s
    putRef(&mut t, mut1(&mut z)) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn helper(sh: Shared[Future[usize]?]) {
    let mut z = Array.of("a")
    putIn(sh.clone(), mut1(&mut z)) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn clonedAlias(sh: Shared[Future[usize]?]) {
    let t = sh.clone()
    let mut z = Array.of("a")
    t.set(Some(mut1(&mut z))) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn localAlias() -> Shared[Future[usize]?] {
    let sh: Shared[Future[usize]?] = Shared.new(None)
    let t = sh.clone()
    let mut z = Array.of("a")
    t.set(Some(mut1(&mut z))) //~ ERROR a value borrowing `z` cannot go into shared storage
    sh
}

fn upgraded(w: Weak[Future[usize]?]) {
    let mut z = Array.of("a")
    if let Some(s) = w.upgrade() {
        s.set(Some(mut1(&mut z))) //~ ERROR a value borrowing `z` cannot go into shared storage
    }
}

fn fieldClone(sh: Shared[Future[usize]?]) {
    let h = Holder { s: sh.clone() }
    let mut z = Array.of("a")
    h.s.set(Some(mut1(&mut z))) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn record(s: Shared[Rec?]) {
    let mut z = Array.of("a")
    s.set(Some(Rec { f: mut1(&mut z) })) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn recordHelper(s: Shared[Rec?]) {
    let mut z = Array.of("a")
    putRec(s, Rec { f: mut1(&mut z) }) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn array(s: Shared[Array[Future[usize]]]) {
    let mut z = Array.of("a")
    s.set(Array.of(mut1(&mut z))) //~ ERROR a borrow cannot go in element 0
}

fn view(s: Shared[Future[Int]?]) {
    let mut c = Counter { n: 1 }
    s.set(Some(acount(&mut c))) //~ ERROR a value borrowing `c` cannot go into shared storage
}

fn viewHelper(s: Shared[Future[Int]?]) {
    let mut c = Counter { n: 1 }
    putView(s, acount(&mut c)) //~ ERROR a value borrowing `c` cannot go into shared storage //~ ERROR cannot be spawned or passed to a call that may spawn it
}

fn asyncHelper(s: Shared[Future[usize]?]) -> Future[Void] {
    let mut z = Array.of("a") //~ ERROR `z` is still borrowed when its scope ends here
    putLater(s, mut1(&mut z)) //~ ERROR a borrow cannot be returned //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn recursive(s: Shared[Future[usize]?]) {
    let mut z = Array.of("a")
    recPut(s, 3, mut1(&mut z)) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn unsafeCell(c: &UnsafeCell[Future[usize]?]) {
    let mut z = Array.of("a")
    unsafe { c.set(Some(mut1(&mut z))) } //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn handleTable(t: ffi.HandleTable[Future[usize]]) {
    let mut z = Array.of("a")
    let h = t.insert(mut1(&mut z)) //~ ERROR a value borrowing `z` cannot go into shared storage
    _ = h
}

fn ifaceHelper(sh: Shared[Future[usize]?]) {
    let mut z = Array.of("a")
    let mut k = ShSink { cell: sh.clone() }
    sinkInto(&mut k, mut1(&mut z)) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn ifaceView(sh: Shared[Future[usize]?]) {
    let mut z = Array.of("a")
    let mut k = ShSink { cell: sh.clone() }
    let o: &mut Sink = &mut k
    o.take(mut1(&mut z)) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn closureCapture(sh: Shared[Future[usize]?]) {
    let mut z = Array.of("a")
    let g = (f: Future[usize]) => sh.set(Some(f))
    g(mut1(&mut z)) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn immediateCapture(sh: Shared[Future[usize]?]) {
    let mut z = Array.of("a")
    each(1, (x: Int) => sh.set(Some(mut1(&mut z)))) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn bound[K: Tk](k: K) {
    let mut z = Array.of("a")
    k.keep(mut1(&mut z)) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn boundHelper(sh: Shared[Future[usize]?]) {
    let mut z = Array.of("a")
    keepVia(D { s: sh.clone() }, mut1(&mut z)) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn genericBound[K: TkG[Future[usize]]](k: K) {
    let mut z = Array.of("a")
    k.hold(mut1(&mut z)) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn genericBoundView[K: TkG[Future[Int]]](k: K) {
    let mut c = Counter { n: 1 }
    k.hold(acount(&mut c)) //~ ERROR a value borrowing `c` cannot go into shared storage
}

fn opaqueFnGeneric(sh: Shared[Future[usize]?], h: Hold) {
    let mut z = Array.of("a")
    apply(h.f, sh.clone(), mut1(&mut z)) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn cellBorrowedOut(t: Two) {
    let f = t.a.withMut(peek)
    t.b.set(Some(f)) //~ ERROR a value borrowing `t` cannot go into shared storage
}

fn takenFromLocal(s: Shared[Future[usize]?]) {
    let mut z = Array.of("a")
    let mut o = Some(mut1(&mut z))
    s.set(o.take()) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn takenByHelper(s: Shared[Future[usize]?]) {
    let mut z = Array.of("a")
    let mut o = Some(mut1(&mut z))
    s.set(takeOpt(&mut o)) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn takenByValue(s: Shared[Future[usize]?]) {
    let mut z = Array.of("a")
    let o = Some(mut1(&mut z))
    s.set(unwrap1(o)) //~ ERROR a value borrowing `z` cannot go into shared storage
}

fn takenFromBox(s: Shared[Future[usize]?]) {
    let mut z = Array.of("a")
    let mut b = Box.new(Some(mut1(&mut z)))
    s.set(b.withMut((p: &mut Future[usize]?) => p.take())) //~ ERROR a value borrowing `z` cannot go into shared storage
}

type P = { pub a Future[usize], pub n Int }

fn unpackedParam(d: Shared[Future[usize]?], s: Shared[Future[usize]?]) {
    let x = s.withMut((o: &mut Future[usize]?) => o.take())
    if let Some(f) = x {
        d.set(Some(f))
    }
}

fn unpackedLocal(d: Shared[Future[usize]?]) {
    let s: Shared[Future[usize]?] = Shared.new(Some(plain(1)))
    match s.withMut((o: &mut Future[usize]?) => o.take()) {
        Some(f) -> d.set(Some(f))
        None -> {}
    }
}

fn unpackedInsert(t: ffi.HandleTable[Future[usize]], s: Shared[Future[usize]?]) {
    match s.withMut((o: &mut Future[usize]?) => o.take()) {
        Some(f) -> {
            let h = t.insert(f)
            _ = h
        }
        None -> {}
    }
}

fn unpackedRemove(t: ffi.HandleTable[Future[usize]], s: Shared[ffi.FfiHandle[Future[usize]]?]) {
    match s.withMut((o: &mut ffi.FfiHandle[Future[usize]]?) => o.take()) {
        Some(h) -> {
            let f = t.remove(h)
            _ = f
        }
        None -> {}
    }
}

fn unpackedField(d: Shared[Future[usize]?], s: Shared[P?]) {
    match s.withMut((o: &mut P?) => o.take()) {
        Some(q) -> d.set(Some(move q.a))
        None -> {}
    }
}

fn unpackedBorrowed(d: Shared[Future[usize]?]) {
    let mut z = Array.of("a")
    let r = Some(P { a: mut1(&mut z), n: 1 })
    match r {
        Some(q) -> d.set(Some(move q.a)) //~ ERROR a value borrowing `z` cannot go into shared storage
        None -> {}
    }
}

fn takenOut(t: Two) {
    let x = t.a.withMut((o: &mut Future[usize]?) => o.take())
    t.b.set(x)
}

fn takenOutLocal() {
    let t = Two { a: Shared.new(None), b: Shared.new(None) }
    let x = t.a.withMut((o: &mut Future[usize]?) => o.take())
    t.b.set(x)
}

fn clonedOut(t: Fns) {
    let xs = t.a.with((o: &Array[fn(Int) -> Int]) => o.clone())
    t.b.set(xs)
}

fn boxReturned() -> Box[Future[usize]?] {
    let mut b: Box[Future[usize]?] = Box.new(None)
    let mut z = Array.of("a") //~ ERROR `z` is still borrowed when its scope ends here
    b.set(Some(mut1(&mut z))) //~ ERROR a borrow cannot be returned
    b
}

fn borrowFree(sh: Shared[Future[usize]?], s: Sh) {
    sh.set(Some(plain(1)))
    putIn(sh.clone(), plain(2))
    s.put(plain(3))
}

fn plainCells(a: Shared[Int], b: Shared[String]) {
    let mut z = Array.of("a")
    let n = z.len()
    a.set(n.toInt() || 0)
    b.set(z[0])
    z.push("c")
}

type V['a] = { pub s &'a String }

fn keepNamed['a](c: &UnsafeCell[V['a]?], v: V['a]) {
    unsafe { c.set(Some(v)) }
}

fn keepNamedVia['a](c: &UnsafeCell[V['a]?], v: V['a]) {
    keepNamed(c, v)
}


-- src --
import task from std/task

type Res = {
    id Int
}

async fn leaf() -> Res {
    await task.yieldNow()
    Res { id: 5 }
}

async fn wrapper(t: task.Task[Res]) -> Int {
    let r = await t
    r.id
}

fn wrapSync(t: task.Task[Res]) -> Future[Int] {
    wrapper(t) //~ ERROR `Task[Res]` holds a `Task` handle
}

async fn returned() -> Future[Int] {
    let t = task.spawn(leaf())
    wrapper(t) //~ ERROR `Task[Res]` holds a `Task` handle
}

async fn bound() -> Int {
    let t = task.spawn(leaf())
    let f = wrapper(t) //~ ERROR `Task[Res]` holds a `Task` handle
    await f
}

async fn viaValue() -> Int {
    let t = task.spawn(leaf())
    let g = wrapper
    let f = g(t) //~ ERROR `Task[Res]` holds a `Task` handle
    await f
}

async fn inScope() -> Int {
    let a = task.spawn(leaf())
    let b = task.spawn(leaf())
    let w = task.spawn(wrapper(a))
    await wrapper(b) + await w
}


-- app/t/t.kg --
import task from std/task

async fn work() -> Int {
    0
}

fn syncRoot() -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(work())
}

fn safeFn() -> Int {
    9
}

type Holder = {
    pub mut cb fn() -> Int
}

type Wrap = {
    pub mut inner Holder
}


fn opaqueSel(b: Bool) -> fn() -> Int {
    if b { syncRoot } else { safeFn }
}

fn callIt(h: Holder) -> Int {
    h.cb()
}

fn forward(h: Holder) -> Int {
    callIt(h)
}

fn mkUnknown(b: Bool) -> Holder {
    let sel: fn(Bool) -> fn() -> Int = opaqueSel
    Holder { cb: sel(b) }
}

fn mkSafe() -> Holder {
    Holder { cb: safeFn }
}

fn callBoth(a: Holder, b: Holder) -> Int {
    a.cb() + b.cb()
}

fn callSecond(a: Holder, b: Holder) -> Int {
    b.cb()
}

fn callSecondFirst(a: Holder, b: Holder) -> Int {
    a.cb() + callSecond(a, b)
}

async fn poisonUser() -> Int {
    let sel: fn(Bool) -> fn() -> Int = opaqueSel
    let mut w = Holder { cb: safeFn }
    w.cb = sel(true)
    callIt(w) //~ ERROR cannot run inside an `async fn`
}

async fn poisonForwarded() -> Int {
    let sel: fn(Bool) -> fn() -> Int = opaqueSel
    let mut w = Holder { cb: safeFn }
    w.cb = sel(true)
    forward(w) //~ ERROR cannot run inside an `async fn`
}

async fn sibLiteral() -> Int {
    callIt(Holder { cb: safeFn })
}

async fn sibLocal() -> Int {
    let w = Holder { cb: safeFn }
    callIt(w)
}

async fn sibForward() -> Int {
    forward(Holder { cb: safeFn })
}

async fn sibResultSafe() -> Int {
    callIt(mkSafe())
}

async fn sibArray() -> Int {
    let xs = Array.of(Holder { cb: safeFn })
    callIt(xs[0])
}

async fn sibParam(h: Holder) -> Int {
    callIt(h)
}

async fn sibCopy() -> Int {
    let w = Holder { cb: safeFn }
    let mut v = w
    callIt(v)
}

async fn sibResultUnknown() -> Int {
    callIt(mkUnknown(false)) //~ ERROR cannot run inside an `async fn`
}

async fn sibBoth() -> Int {
    let x = Holder { cb: syncRoot }
    let y = Holder { cb: syncRoot }
    callBoth(x, y) //~ ERROR cannot run inside an `async fn`
}

async fn sibSecondRisky() -> Int {
    let x = Holder { cb: syncRoot }
    let y = Holder { cb: safeFn }
    callBoth(y, x) //~ ERROR cannot run inside an `async fn`
}

async fn sibSecondOnly() -> Int {
    let x = Holder { cb: syncRoot }
    let y = Holder { cb: syncRoot }
    callSecond(x, y) //~ ERROR cannot run inside an `async fn`
}

async fn sibFirstOfTwo() -> Int {
    let x = Holder { cb: syncRoot }
    let y = Holder { cb: syncRoot }
    callSecondFirst(x, y) //~ ERROR cannot run inside an `async fn`
}

async fn sibFirstRisky() -> Int {
    let x = Holder { cb: syncRoot }
    let y = Holder { cb: safeFn }
    callSecondFirst(x, y) //~ ERROR cannot run inside an `async fn`
}

async fn sibSecondSafe() -> Int {
    let x = Holder { cb: safeFn }
    let y = Holder { cb: syncRoot }
    callSecond(y, x)
}

async fn val(x: Int) -> Int {
    x
}

type Holder = {
    pub t Future[Int]
}

type HR['a] = {
    pub r &'a Holder
}

async fn viaRef(h: &Holder) -> Int {
    await h.t //~ ERROR reading `h.t` by value
}

async fn viaLink['a](h: HR['a]) -> Int {
    await h.r.t //~ ERROR reading `h.r.t` by value
}

async fn viaIf(c: Bool, h: Holder) -> Int {
    await (if c { h.t } else { val(0) }) //~ ERROR reading `h.t` by value
}

async fn ownedDirect(h: Holder) -> Int {
    await h.t
}

-- app/t/t.kg --
import task from std/task

async fn work() -> Int {
    0
}

fn syncRoot() -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(work())
}

fn safeFn() -> Int {
    9
}

type Holder = {
    pub mut cb fn() -> Int
}

type Wrap = {
    pub mut inner Holder
}


fn callIt(h: Holder) -> Int {
    h.cb()
}

fn callH(h: Holder) -> Int {
    h.cb()
}

fn viaCopyMut(w: Wrap) -> Int {
    let mut h = w.inner
    h.cb()
}

fn viaWholeMut(w: Wrap) -> Int {
    let mut v = w
    v.inner.cb()
}

fn viaHolderMut(h: Holder) -> Int {
    let mut g = h
    g.cb()
}

fn viaPassMut(h: Holder) -> Int {
    let mut g = h
    callIt(g)
}

fn viaPassBefore(h: Holder) -> Int {
    let mut g = h
    forward(g)
}

fn forward(h: Holder) -> Int {
    callIt(h)
}

fn viaAssign(w: Wrap, h: Holder) -> Int {
    let mut g = Holder { cb: safeFn }
    g = h
    g.cb()
}

fn passThrough(h: Holder) -> Holder {
    h
}

fn passInner(w: Wrap) -> Holder {
    w.inner
}

fn withRoot(mut h: Holder) -> Holder {
    h.cb = syncRoot
    h
}

fn pick(a: Holder, b: Holder, first: Bool) -> Holder {
    if first { a } else { b }
}

fn twice(h: Holder) -> Holder {
    passThrough(h)
}

async fn riskyCopyMut() -> Int {
    viaCopyMut(Wrap { inner: Holder { cb: syncRoot } }) //~ ERROR cannot run inside an `async fn`
}

async fn safeCopyMut() -> Int {
    viaCopyMut(Wrap { inner: Holder { cb: safeFn } })
}

async fn riskyWholeMut() -> Int {
    viaWholeMut(Wrap { inner: Holder { cb: syncRoot } }) //~ ERROR cannot run inside an `async fn`
}

async fn safeWholeMut() -> Int {
    viaWholeMut(Wrap { inner: Holder { cb: safeFn } })
}

async fn riskyHolderMut() -> Int {
    viaHolderMut(Holder { cb: syncRoot }) //~ ERROR cannot run inside an `async fn`
}

async fn safeHolderMut() -> Int {
    viaHolderMut(Holder { cb: safeFn })
}

async fn riskyPassMut() -> Int {
    viaPassMut(Holder { cb: syncRoot }) //~ ERROR cannot run inside an `async fn`
}

async fn safePassMut() -> Int {
    viaPassMut(Holder { cb: safeFn })
}

async fn riskyPassBefore() -> Int {
    viaPassBefore(Holder { cb: syncRoot }) //~ ERROR cannot run inside an `async fn`
}

async fn safePassBefore() -> Int {
    viaPassBefore(Holder { cb: safeFn })
}

async fn riskyAssign() -> Int {
    viaAssign(Wrap { inner: Holder { cb: safeFn } }, Holder { cb: syncRoot }) //~ ERROR cannot run inside an `async fn`
}

async fn safeAssign() -> Int {
    viaAssign(Wrap { inner: Holder { cb: safeFn } }, Holder { cb: safeFn })
}

async fn riskyPass() -> Int {
    let h = passThrough(Holder { cb: syncRoot })
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn safePass() -> Int {
    let h = passThrough(Holder { cb: safeFn })
    h.cb()
}

async fn riskyPassPlace() -> Int {
    let src = Holder { cb: syncRoot }
    let h = passThrough(src)
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn safePassPlace() -> Int {
    let src = Holder { cb: safeFn }
    let h = passThrough(src)
    h.cb()
}

async fn safePassWrittenAfter() -> Int {
    let mut src = Holder { cb: safeFn }
    let h = passThrough(src)
    src.cb = syncRoot
    h.cb()
}

async fn riskyPassInner() -> Int {
    let h = passInner(Wrap { inner: Holder { cb: syncRoot } })
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn safePassInner() -> Int {
    let h = passInner(Wrap { inner: Holder { cb: safeFn } })
    h.cb()
}

async fn riskyMutReturn() -> Int {
    let h = withRoot(Holder { cb: safeFn })
    callH(h) //~ ERROR cannot run inside an `async fn`
}

async fn riskyPick() -> Int {
    let h = pick(Holder { cb: safeFn }, Holder { cb: syncRoot }, true)
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn safePick() -> Int {
    let h = pick(Holder { cb: safeFn }, Holder { cb: safeFn }, true)
    h.cb()
}

async fn riskyDirectResult() -> Int {
    passThrough(Holder { cb: syncRoot }).cb() //~ ERROR cannot run inside an `async fn`
}

async fn guardedTwice() -> Int {
    let h = twice(Holder { cb: syncRoot })
    h.cb()
}

async fn riskyClosure() -> Int {
    let make = () => Holder { cb: syncRoot }
    let h = make()
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn safeClosure() -> Int {
    let make = () => Holder { cb: safeFn }
    let h = make()
    h.cb()
}

async fn riskyClosureDirect() -> Int {
    let make = () => Holder { cb: syncRoot }
    make().cb() //~ ERROR cannot run inside an `async fn`
}

async fn riskyClosureCapture() -> Int {
    let src = Holder { cb: syncRoot }
    let make = () => src
    let h = make()
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn safeClosureCapture() -> Int {
    let src = Holder { cb: safeFn }
    let make = () => src
    let h = make()
    h.cb()
}

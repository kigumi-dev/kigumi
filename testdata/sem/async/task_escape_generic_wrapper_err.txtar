-- module --
mir: planned
-- src --
import task from std/task

type Box[T] = { pub v T }

async fn leaf() -> Int { 1 }
async fn wrapper(t: task.Task[Int]) -> Int { await t }

fn mkbox[T](t: T, f: fn(T) -> Future[Int]) -> Box[Future[Int]] {
    Box { v: f(t) }
}

async fn root() -> Int {
    let t = task.spawn(leaf())
    let b = mkbox(t, wrapper) //~ ERROR a Future that is not awaited or spawned
    0
}

async fn viaValue() -> Int {
    let t = task.spawn(leaf())
    let g = mkbox[task.Task[Int]]
    let b = g(t, wrapper) //~ ERROR a Future that is not awaited or spawned
    0
}

-- src --
import task from std/task

async fn leaf() -> Int {
    5
}

type Holder = {
    pub t task.Task[Int]
}

async fn captured() -> Int {
    let t = task.spawn(leaf())
    let f = () => {
        t.cancel() //~ ERROR `t` holds a `Task` handle and cannot be captured by a closure that may outlive the task that spawned it
    }
    0
}

async fn capturedHolder() -> Int {
    let h = Holder { t: task.spawn(leaf()) }
    let f = () => h.t.cancel() //~ ERROR `h` holds a `Task` handle
    0
}

fn now[F: Fn[fn() -> Void]](f: F) {
    f()
}

async fn immediate() -> Int {
    let t = task.spawn(leaf())
    now(() => t.cancel())
    await t
}


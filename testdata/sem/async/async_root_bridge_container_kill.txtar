-- app/t/t.kg --
import task from std/task

async fn work() -> Int {
    0
}

fn syncRoot() -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(work())
}

fn safeFn() -> Int {
    9
}

type Holder = {
    pub mut cb fn() -> Int
}

type Bag = {
    pub mut items Array[Holder]
}

fn fresh() -> Array[Holder] {
    Array.of(Holder { cb: safeFn })
}

async fn reassignSafe() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    a = Array.of(Holder { cb: safeFn })
    a[0].cb()
}

async fn reassignBefore() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    let first = a[0].cb() //~ ERROR cannot run inside an `async fn`
    a = Array.of(Holder { cb: safeFn })
    first + a[0].cb()
}

async fn reassignRisky() -> Int {
    let mut a = Array.of(Holder { cb: safeFn })
    a = Array.of(Holder { cb: syncRoot })
    a[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn reassignUnknown() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    a = fresh()
    a[0].cb()
}

async fn reassignConditional(flag: Bool) -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    if flag {
        a = Array.of(Holder { cb: safeFn })
    }
    a[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn reassignInLoop() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    let mut s = 0
    for i in 0..3 {
        s = s + a[0].cb() //~ ERROR cannot run inside an `async fn`
        a = Array.of(Holder { cb: safeFn })
    }
    s
}

async fn reassignThroughClosure() -> Int {
    let mut a = Array.of(Holder { cb: safeFn })
    let arm = () => {
        a = Array.of(Holder { cb: syncRoot })
    }
    a = Array.of(Holder { cb: safeFn })
    arm()
    a[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn overwriteOnly() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    a[0] = Holder { cb: safeFn }
    a[0].cb()
}

async fn overwriteWithRisk() -> Int {
    let mut a = Array.of(Holder { cb: safeFn })
    a[0] = Holder { cb: syncRoot }
    a[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn overwriteTwoElements() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot }, Holder { cb: safeFn })
    a[0] = Holder { cb: safeFn }
    a[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn overwriteSecondOfOne() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    a[1] = Holder { cb: safeFn }
    a[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn overwriteDynamic(i: usize) -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    a[i] = Holder { cb: safeFn }
    a[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn overwriteAfterUse() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    let _ = a.insertAt(0, Holder { cb: safeFn })
    a[0] = Holder { cb: safeFn }
    a[1].cb() //~ ERROR cannot run inside an `async fn`
}

async fn takeAtSafe() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    let _ = a.takeAt(0)
    a.push(Holder { cb: safeFn })
    a[0].cb()
}

async fn takeAtResult() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    match a.takeAt(0) {
        Some(h) -> h.cb() //~ ERROR cannot run inside an `async fn`
        None -> 0
    }
}

async fn takeAtOther() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    let _ = a.takeAt(1)
    a.push(Holder { cb: safeFn })
    a[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn takeAtTwoElements() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot }, Holder { cb: safeFn })
    let _ = a.takeAt(0)
    a[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn takeAtAfterInsert() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    let _ = a.insertAt(0, Holder { cb: safeFn })
    let _ = a.takeAt(0)
    a[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn fieldReplaceSafe() -> Int {
    let mut b = Bag { items: Array.of(Holder { cb: syncRoot }) }
    b.items = Array.of(Holder { cb: safeFn })
    b.items[0].cb()
}

async fn fieldReplaceRisky() -> Int {
    let mut b = Bag { items: Array.of(Holder { cb: safeFn }) }
    b.items = Array.of(Holder { cb: syncRoot })
    b.items[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn fieldReplaceUnknown() -> Int {
    let mut b = Bag { items: Array.of(Holder { cb: syncRoot }) }
    b.items = fresh()
    b.items[0].cb()
}

async fn fieldReplaceOther() -> Int {
    let mut b = Bag { items: Array.of(Holder { cb: syncRoot }) }
    let mut c = Bag { items: Array.of(Holder { cb: safeFn }) }
    c.items = Array.of(Holder { cb: safeFn })
    b.items[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn recordFieldOverwrite() -> Int {
    let mut h = Holder { cb: syncRoot }
    h.cb = safeFn
    h.cb()
}

async fn recordReassign() -> Int {
    let mut h = Holder { cb: syncRoot }
    h = Holder { cb: safeFn }
    h.cb()
}

async fn optionReassign() -> Int {
    let mut o = Some(Holder { cb: syncRoot })
    o = Some(Holder { cb: safeFn })
    o.unwrap().cb()
}

async fn copyBeforeReassign() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    let h = a[0]
    a = Array.of(Holder { cb: safeFn })
    h.cb() //~ ERROR cannot run inside an `async fn`
}

async fn getAfterReassign() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    a = Array.of(Holder { cb: safeFn })
    match a.get(0) {
        Some(h) -> h.cb()
        None -> 0
    }
}

fn callOn(a: &Array[Holder]) -> Int {
    a[0].cb()
}

async fn passAfterReassign() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    a = Array.of(Holder { cb: safeFn })
    callOn(&a)
}

async fn passBeforeReassign() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    let n = callOn(&a) //~ ERROR cannot run inside an `async fn`
    a = Array.of(Holder { cb: safeFn })
    n + callOn(&a)
}

async fn fieldCopyBeforeOverwrite() -> Int {
    let mut h = Holder { cb: syncRoot }
    let f = h.cb
    h.cb = safeFn
    f() //~ ERROR cannot run inside an `async fn`
}

async fn fieldCopyAfterOverwrite() -> Int {
    let mut h = Holder { cb: syncRoot }
    h.cb = safeFn
    let f = h.cb
    f()
}

async fn fieldCopyBothSides() -> Int {
    let mut h = Holder { cb: syncRoot }
    let v = h.cb
    h.cb = safeFn
    let w = h.cb
    w() + v() //~ ERROR cannot run inside an `async fn`
}

async fn fieldCopyPassedOn() -> Int {
    let mut h = Holder { cb: syncRoot }
    let f = h.cb
    h.cb = safeFn
    apply(f) //~ ERROR cannot run inside an `async fn`
}

fn apply(g: fn() -> Int) -> Int {
    g()
}

async fn elementFieldCopyBeforeReplace() -> Int {
    let mut b = Bag { items: Array.of(Holder { cb: syncRoot }) }
    let f = b.items[0].cb
    b.items = Array.of(Holder { cb: safeFn })
    f() //~ ERROR cannot run inside an `async fn`
}

async fn takeAtKept() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    let t = a.takeAt(0)
    match t {
        Some(h) -> h.cb() //~ ERROR cannot run inside an `async fn`
        None -> 0
    }
}

async fn takeAtKeptUnwrap() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    let t = a.takeAt(0)
    if t is Some(_) {
        t.unwrap().cb() //~ ERROR cannot run inside an `async fn`
    } else {
        0
    }
}

async fn overwriteWithSelf() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    a[0] = a[0]
    a[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn overwriteWithOwnField() -> Int {
    let mut a = Array.of(Holder { cb: syncRoot })
    a[0] = Holder { cb: a[0].cb }
    a[0].cb() //~ ERROR cannot run inside an `async fn`
}

async fn fieldOverwriteWithSelf() -> Int {
    let mut h = Holder { cb: syncRoot }
    h.cb = h.cb
    h.cb() //~ ERROR cannot run inside an `async fn`
}

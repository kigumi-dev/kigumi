import alloc from std/alloc

fn ship[T: Send](x: T) {}

fn share[T: Sync](x: &T) {}

type Handle = resource {
    fd Int
}

async fn capture(h: Handle) -> Int {
    42
}

fn use(h: Handle, a: alloc.AllocatorHandle) {
    let fut = capture(h)
    ship(fut) //~ ERROR `Future[Int]` does not satisfy `Send`: it cannot move to another thread
    share(&fut) //~ ERROR `Future[Int]` does not satisfy `Sync`: it cannot be shared between threads
    ship(a) //~ ERROR `AllocatorHandle` does not satisfy `Send`: it cannot move to another thread
    share(&a) //~ ERROR `AllocatorHandle` does not satisfy `Sync`: it cannot be shared between threads
}


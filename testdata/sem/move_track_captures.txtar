mir: planned
-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn Res.close(move self) {}

fn Res.peek(self) -> Int {
    self.id
}

fn use(r: &Res) {}

fn say(n: Int) {}

fn sayU(n: usize) {}

fn sayB(b: Bool) {}

fn mkr(n: Int) -> Res {
    Res { id: n }
}

fn total(xs: Array[Int], f: fn(Int) -> Int) -> Int {
    let mut t = 0
    for x in xs {
        t = t + f(x)
    }
    t
}

fn readerThenClose() {
    let r = mkr(7)
    let f = () => { use(&r) }
    r.close() //~ ERROR `r` is shared with a closure that may still run
    f()
}

fn arrayShared() {
    let mut xs = Array.of(1, 2)
    let f = () => { sayU(xs.len()) }
    xs.push(3) //~ ERROR `xs` is shared with a closure that may still run
    f()
}

fn ownCellThenOuter() {
    let mut xs = Array.of(1)
    let f = () => { xs.push(2) }
    f()
    sayU(xs.len()) //~ ERROR `xs` was moved
}

fn capturedInLoop() {
    let r = mkr(1)
    for i in 0..2 {
        let f = () => r.peek()
        say(f())
    }
}

fn consumerTwice() {
    let r = mkr(2)
    let f = () => { r.close() }
    f()
    f() //~ ERROR `f` consumes `r` when called and can be called only once
}

fn nestedReadTwice() {
    let r = mkr(3)
    let f = () => {
        let g = () => r.peek()
        say(g())
    }
    f()
    f()
    r.close()
}

fn nestedMoveTwice() {
    let r = mkr(13)
    let f = () => {
        let g = () => r.close()
        g()
    }
    f()
    f() //~ ERROR `f` consumes `r` when called and can be called only once
}

fn secondClosure() {
    let r = mkr(4)
    let f = () => r.peek()
    let g = () => r.peek()
    say(f() + g())
    r.close()
}

fn reinitAfterCapture() {
    let mut r = mkr(5)
    let f = () => { r.close() }
    r = mkr(6)
    f()
    r.close()
}

fn readerCalledTwice() -> Int {
    let r = mkr(8)
    let f = () => r.peek()
    f() + f()
}

fn immediateBorrows() {
    let ys = Array.of(1, 2)
    let r = mkr(9)
    say(total(Array.of(1, 2), (x: Int) => x + r.peek()))
    sayU(ys.len())
    r.close()
}

fn copyCaptureShared() -> Int {
    let mut n = 1
    let f = () => { n = n + 1 }
    f()
    n
}

fn ownCellCalledTwice() -> Int {
    let mut xs = Array.of(1)
    let f = () => {
        xs.push(2)
        xs.len().toInt() || 0
    }
    f() + f()
}
fn readThenRead() {
    let xs = Array.of(1, 2)
    let g = () => xs.len()
    sayU(xs.len() + g())
}

fn readerDeadThenConsume() {
    let r = mkr(10)
    let f = () => r.peek()
    say(f())
    r.close()
}

fn readerEscapesThenConsume() {
    let r = mkr(11)
    let f = () => say(r.peek())
    let keep = Array.of(f)
    r.close() //~ ERROR `r` is shared with a closure that may still run
}

fn fieldWriteWhileRead() {
    let mut w = Pair { r: mkr(12), n: 1 }
    let f = () => w.n
    w.n = 5 //~ ERROR `w` is shared with a closure that may still run
    say(f())
}

fn matchWhileRead() {
    let o = Some(mkr(14))
    let f = () => say(probe(&o))
    match o {
        Some(x) -> x.close() //~ ERROR `o` is shared with a closure that may still run
        None -> {}
    }
    f()
}

fn fallbackWhileRead() {
    let o = Some(mkr(15))
    let f = () => say(probe(&o))
    let x = o || mkr(16) //~ ERROR `o` is shared with a closure that may still run
    x.close()
    f()
}

fn moverWhileRead() {
    let r = mkr(17)
    let f = () => r.peek()
    let g = () => r.close() //~ ERROR `r` is shared with a closure that may still run
    g()
    say(f())
}

fn fallbackConsumerTwice() {
    let o: Option[Res] = Some(mkr(18))
    let f = () => {
        let x = o || mkr(19)
        x.close()
    }
    f()
    f() //~ ERROR `f` consumes `o` when called and can be called only once
}

fn each(n: Int, f: fn(Int) -> Void) {
    f(n)
}

fn writeInsideKeeper() {
    let mut r = mkr(24)
    let f = () => {
        each(1, (i: Int) => {
            r = mkr(25 + i)
        })
        say(r.peek())
    }
    f()
    f()
}

fn probe(o: &Option[Res]) -> Int {
    match o {
        Some(_) -> 1
        None -> 0
    }
}

type Pair = {
    pub mut r Res
    pub mut n Int
}

fn applyNow(f: fn() -> Void) {
    f()
}

fn closeOptC(o: Res?) {
    match o {
        Some(r) -> r.close()
        None -> {}
    }
}

fn cellCloseTwice() {
    let mut o = mkr(1)
    applyNow(() => { o = mkr(2) })
    o.close()
    o.close() //~ ERROR `o` was moved
}

fn cellPassTwice() {
    let mut o = Some(mkr(1))
    applyNow(() => { o = Some(mkr(2)) })
    closeOptC(o)
    closeOptC(o) //~ ERROR `o` was moved
}

fn cellLetThenPass() {
    let mut o = Some(mkr(1))
    applyNow(() => { o = Some(mkr(2)) })
    let x = o
    closeOptC(x)
    closeOptC(o) //~ ERROR `o` was moved
}

fn cellCatchAllThenPass() {
    let mut o = Some(mkr(1))
    applyNow(() => { o = Some(mkr(2)) })
    match o {
        x -> closeOptC(x)
    }
    closeOptC(o) //~ ERROR `o` was moved
}

fn cellPayloadThenPass() {
    let mut o = Some(mkr(1))
    applyNow(() => { o = Some(mkr(2)) })
    match o {
        Some(r) -> r.close()
        None -> {}
    }
    closeOptC(o) //~ ERROR `o` was moved
}

fn cellLambdaAfterConsume() {
    let mut o = Some(mkr(1))
    applyNow(() => { o = Some(mkr(2)) })
    closeOptC(o)
    applyNow(() => { sayB(o is None) }) //~ ERROR `o` was moved
}

fn cellReinit(c: Bool) {
    let mut o = mkr(1)
    applyNow(() => { o = mkr(2) })
    o.close()
    o = mkr(3)
    if c {
        o.close()
        o = mkr(4)
    }
    o.close()
}

type CP = resource {
    pub mut a Int
    pub mut r Res
}

fn eatRes(r: Res) {
    r.close()
}

fn cellFieldMoveTwice() {
    let mut p = CP { a: 1, r: mkr(1) }
    applyNow(() => { p.a = 2 })
    eatRes(move p.r)
    eatRes(move p.r) //~ ERROR `p.r` was moved //~ ERROR `p.r` was moved
}

fn cellFieldMoveThenUse() {
    let mut p = CP { a: 1, r: mkr(1) }
    applyNow(() => { p.a = 2 })
    let r1 = move p.r
    r1.close()
    say(p.r.peek()) //~ ERROR `p.r` was moved //~ ERROR `p.r` was moved
}

fn cellGuardStoresField() {
    let mut p = CP { a: 1, r: mkr(1) }
    applyNow(() => { p.a = 2 })
    match p {
        q if { p.r = mkr(7); false } -> say(q.a) //~ ERROR `p` is held by the pattern binding `q` until its guard passes, so it cannot be changed here
        q -> q.r.close()
    }
}

fn guardAssignsWhole(o0: Res?) {
    let mut o = o0
    match o {
        Some(r) if { o = None; false } -> r.close() //~ ERROR `o` is held by the pattern binding `r` until its guard passes, so it cannot be changed here
        _ -> {}
    }
}

fn cellGuardAssignsWhole() {
    let mut o = Some(mkr(1))
    applyNow(() => { o = None })
    match o {
        Some(r) if { o = None; false } -> r.close() //~ ERROR `o` is held by the pattern binding `r` until its guard passes, so it cannot be changed here
        _ -> {}
    }
}

fn guardReplacesRecord() {
    let mut p = CP { a: 1, r: mkr(1) }
    match p {
        q if { p = CP { a: 2, r: mkr(2) }; false } -> say(q.a) //~ ERROR `p` is held by the pattern binding `q` until its guard passes, so it cannot be changed here
        _ -> {}
    }
}

fn cellConsumeThenReadingLambda() {
    let mut o = Some(mkr(1))
    applyNow(() => { o = None })
    closeOptC(o)
    applyNow(() => { sayB(o is None) }) //~ ERROR `o` was moved
}

fn cellConsumeThenWritingLambda() {
    let mut o = Some(mkr(1))
    applyNow(() => { o = None })
    closeOptC(o)
    applyNow(() => { o = Some(mkr(2)) })
    closeOptC(o) //~ ERROR `o` is moved on some paths but not others
}

fn guardStoresSiblingField() {
    let mut p = CP { a: 1, r: mkr(1) }
    match p.r {
        r if { p.a = 5; r.peek() > 0 } -> r.close()
        r -> r.close()
    }
}

fn lambdaReadsMovedField() {
    let mut p = CP { a: 1, r: mkr(1) }
    eatRes(move p.r)
    applyNow(() => { say(p.r.peek()) }) //~ ERROR `p.r` was moved out of `p`
}

fn cellLambdaReadsMovedField() {
    let mut p = CP { a: 1, r: mkr(1) }
    applyNow(() => { p.a = 2 })
    eatRes(move p.r)
    applyNow(() => { say(p.r.peek()) }) //~ ERROR `p.r` was moved out of `p`
}

fn storedClosureAfterFieldMove() {
    let mut p = CP { a: 1, r: mkr(1) }
    eatRes(move p.r)
    let f = () => p.a //~ ERROR `p.r` was moved out of `p`
    say(f())
}

fn lambdaAfterPayloadBinding(o: Res?) {
    match o {
        Some(r) -> r.close()
        None -> {}
    }
    applyNow(() => { sayB(o is None) }) //~ ERROR `o` was moved
}

fn lambdaAfterFieldRefill() {
    let mut p = CP { a: 1, r: mkr(1) }
    eatRes(move p.r)
    p.r = mkr(2)
    applyNow(() => { say(p.r.peek()) })
}

type Pair2['a] = { pub n usize, pub h Hold['a] }
type Two['a] = Both(usize, Hold['a]) | NoneOf

fn outP2['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], p: Pair2['a]) {
    p.h.r.push(f(c))
}

fn outT['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], t: Two['a]) {
    match t {
        Both(_, h) -> h.r.push(f(c))
        NoneOf -> {}
    }
}

fn wrapP2['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: Hold['a]) {
    outP2(f, c, Pair2 { n: 1, h: h })
}

fn wrapP['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: Hold['a]) {

fn moveSelfLocal() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    Hold { r: &mut a }.fwdL(&mut c)
    c = Array.of("q", "q", "q") //~ ERROR `c` is exclusively borrowed and cannot be used here //~ ERROR `c` is borrowed and cannot be moved or dropped here
    sum(a) + c.len()
}

fn outI[S: Sink](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: S) {
    h.put(f(c))
}

fn gen[H](w: fn(fn(&mut Array[String]) -> Future[usize], &mut Array[String], H) -> Void, h: H, c: &mut Array[String]) {
    w(mut1, c, h)
}

fn mid[H: Sink](c: &mut Array[String], h: H) {
    outI(mut1, c, h)
}

fn midLocal[H: Sink](h: H) -> usize {
    let mut c = Array.of("a")
    outI(mut1, &mut c, h) //~ ERROR a borrow cannot be stored into `H`
    c.len()
}

fn pushRd['a](h: Hold['a], x: &Array[String]) {
    let g = rd
    h.r.push(g(x))
}

fn foldVoid[A](init: A, step: fn(A, &Array[String]) -> Void) {
    let first = Array.of("p", "q")
    step(init, &first) //~ ERROR a borrow cannot be stored into `A`
}


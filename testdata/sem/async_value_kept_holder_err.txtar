-- src --
import task from std/task

interface Sink {
    fn put(move self, f: Future[usize])
}

type Hold['a] = { pub r &'a mut Array[Future[usize]] }
type Pair['a] = { pub h Hold['a], pub n usize }

fn Hold['a].put(move self, f: Future[usize]) {
    self.r.push(f)
}

fn Hold['a].fwdL(move self, c: &mut Array[String]) {
    let g = mut1
    self.r.push(g(c))
}

async fn rd(x: &Array[String]) -> usize {
    x.len()
}

async fn mut1(a: &mut Array[String]) -> usize {
    a.push("x")
    a.len()
}

fn run[T](f: Future[T]) -> T {
    task.currentThreadExecutor().runToCompletion(f)
}

fn sum(a: Array[Future[usize]]) -> usize {
    let mut n: usize = 0
    for f in move a {
        n = n + run(f)
    }
    n
}

fn outH['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: Hold['a]) {
    h.r.push(f(c))
}

fn outM['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: Hold['a]) {
    h.put(f(c))
}

fn outP['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], p: Pair['a]) {
    p.h.r.push(f(c))
}

fn outO['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], o: Option[Hold['a]]) {
    match o {
        Some(h) -> h.r.push(f(c))
        None -> {}
    }
}

fn outA['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], hs: Array[Hold['a]]) {
    for h in move hs {
        h.r.push(f(c))
    }
}

fn outL['a](c: &mut Array[String], h: Hold['a]) {
    let g = mut1
    h.r.push(g(c))
}

fn viaValue() -> usize {
    let w = outH
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    w(mut1, &mut c, Hold { r: &mut a })
    c = Array.of("q", "q", "q") //~ ERROR `c` is exclusively borrowed and cannot be used here //~ ERROR `c` is borrowed and cannot be moved or dropped here
    sum(a) + c.len()
}


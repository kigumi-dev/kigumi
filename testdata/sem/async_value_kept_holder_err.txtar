    let mut hold = Hold { r: &mut a }
    relayG(mut1, &mut c, &mut hold, pt)
    c = Array.of("q", "q", "q") //~ ERROR `c` is exclusively borrowed and cannot be used here //~ ERROR `c` is borrowed and cannot be moved or dropped here
    sum(a) + c.len()
}

interface RefSink {
    fn putRef(mut self, f: Future[usize])
}

fn Hold['a].putRef(mut self, f: Future[usize]) {
    self.r.push(f)
}

fn outRefI[S: RefSink](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: &mut S) {
    h.putRef(f(c))
}

fn boundLentDirect() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    outRefI(mut1, &mut c, &mut hold)
    c = Array.of("q", "q", "q") //~ ERROR `c` is exclusively borrowed and cannot be used here //~ ERROR `c` is borrowed and cannot be moved or dropped here
    sum(a) + c.len()
}

fn main() {
    print "bound lent ${boundLentDirect()}"
    print "generic lent ${genericLentDirect()} ${genericLentRelay()}"
    print "packed ${packedRecord()} ${packedVariant()} ${packedArray()} ${packedDirect()} ${packedFirst()} ${lentValue()} ${lentDirect()} ${unknownLent(outR)}"
    print "${viaValue()} ${direct()} ${viaMoveSelf()} ${viaRecord()} ${viaOption()} ${viaArray()}"
    print "${localDirect()} ${localValue()} ${unknown(outH)} ${moveSelfLocal()}"
    print "${viaBound()} ${viaGeneric()} ${viaMid()}"
}

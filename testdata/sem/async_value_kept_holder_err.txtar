    let c = Array.of("a", "b", "c")
    let _ = run(w(rd, &c, h)) //~ ERROR a borrow cannot be stored into `h` here
}

fn asyncEscapeDirect['a](h: &mut Hold['a]) {
    let c = Array.of("a", "b", "c")
    let _ = run(outAsync(rd, &c, h)) //~ ERROR a borrow cannot be captured by a future //~ ERROR `h` is borrowed by this method and cannot be moved out
}

fn asyncLentIntValue() -> usize {
    let w = outAsyncInt
    let mut c = 0
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    let _ = run(w(mutInt, &mut c, &mut hold))
    c = 5 //~ ERROR `c` is exclusively borrowed and cannot be used here
    sum(a)
}

fn asyncLentIntDirect() -> usize {
    let mut c = 0
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    let _ = run(outAsyncInt(mutInt, &mut c, &mut hold))
    c = 5 //~ ERROR `c` is exclusively borrowed and cannot be used here
    sum(a)
}

async fn outAsyncIntFrame(f: fn(&mut Int) -> Future[usize], c: &mut Int, a: &mut Array[Future[usize]]) -> usize {
    a.push(f(c))
    0
}

fn asyncFrameValue() -> usize {
    let w = outAsyncIntFrame
    let mut c = 0
    let mut a = Array.empty[Future[usize]]()
    let _ = run(w(mutInt, &mut c, &mut a))
    c = 5 //~ ERROR `c` is exclusively borrowed and cannot be used here
    sum(a)
}

fn asyncFrameDirect() -> usize {
    let mut c = 0
    let mut a = Array.empty[Future[usize]]()
    let _ = run(outAsyncIntFrame(mutInt, &mut c, &mut a))
    c = 5 //~ ERROR `c` is exclusively borrowed and cannot be used here
    sum(a)
}

async fn storeCount(c: &mut Int, a: &mut Array[Future[usize]]) -> usize {
    let f = mutInt
    a.push(f(c))
    1
}

async fn storeCountHold['a](c: &mut Int, h: &mut Hold['a]) -> usize {
    let f = mutInt
    h.r.push(f(c))
    1
}

fn asyncStoringFrame() -> usize {
    let mut c = 0
    let mut a = Array.empty[Future[usize]]()
    let _ = run(storeCount(&mut c, &mut a))
    c = 4 //~ ERROR `c` is exclusively borrowed and cannot be used here
    sum(a)
}

fn asyncStoringFrameValue() -> usize {
    let mut c = 0
    let mut a = Array.empty[Future[usize]]()
    let w = storeCount
    let _ = run(w(&mut c, &mut a))
    c = 4 //~ ERROR `c` is exclusively borrowed and cannot be used here
    sum(a)
}

fn asyncStoringHold() -> usize {
    let mut c = 0
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    let _ = run(storeCountHold(&mut c, &mut hold))
    c = 4 //~ ERROR `c` is exclusively borrowed and cannot be used here
    sum(a)
}

fn asyncStoringHoldValue() -> usize {
    let mut c = 0
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    let w = storeCountHold
    let _ = run(w(&mut c, &mut hold))
    c = 4 //~ ERROR `c` is exclusively borrowed and cannot be used here
    sum(a)
}

type RH['a] = { pub mut r &'a Array[Int] }
type RSlot['a] = { pub mut r &'a mut RH['a] }
type MH['a] = { pub mut r &'a mut Array[Int] }

async fn putA['a](c: &'a Array[Int], h: &mut RH['a]) -> usize {
    h.r = c
    0
}

async fn putValueA['a](c: &'a Array[Int], mut h: RSlot['a]) -> usize {
    h.r.r = c
    0
}

async fn putMutA['a](c: MH['a], h: &mut MH['a]) -> usize {
    h.r = c.r
    0
}

fn asyncReferenceDirect() -> usize {
    let z = Array.of(1)
    let mut hold = RH { r: &z }
    let mut c = Array.of(2, 3)
    let _ = run(putA(&c, &mut hold))
    c = Array.of(9, 9, 9, 9, 9) //~ ERROR `c` is borrowed and cannot be mutated here //~ ERROR `c` is borrowed and cannot be moved or dropped here
    hold.r.len() + c.len()
}

fn asyncReferenceByValue() -> usize {
    let z = Array.of(1)
    let mut hold = RH { r: &z }
    let mut c = Array.of(2, 3)
    let _ = run(putValueA(&c, RSlot { r: &mut hold }))
    c = Array.of(9, 9, 9, 9, 9) //~ ERROR `c` is borrowed and cannot be mutated here //~ ERROR `c` is borrowed and cannot be moved or dropped here
    hold.r.len() + c.len()
}

fn asyncMutFieldStore() -> usize {
    let mut z = Array.of(1)
    let mut hold = MH { r: &mut z }
    let mut c = Array.of(2, 3)
    let _ = run(putMutA(MH { r: &mut c }, &mut hold))
    c = Array.of(9, 9, 9, 9, 9) //~ ERROR `c` is exclusively borrowed and cannot be used here //~ ERROR `c` is borrowed and cannot be moved or dropped here
    hold.r.len() + c.len()
}

fn main() {
    print "joined ${dynIfJoin()} ${dynMatchJoin()} ${dynLoopView()} ${dynBranchView()} ${dynIfCallee()} ${dynMatchMakerValue()} ${dynIfSecondHolder()}"
    print "dynamic ${dynDirect()} ${dynValue()} ${dynFrame()} bound ${boundFrame()}"
    print "scalar ${lentInt()} ${lentIntDirect()}"
    print "bound lent ${boundLentDirect()}"
    print "generic lent ${genericLentDirect()} ${genericLentRelay()}"
    print "packed ${packedRecord()} ${packedVariant()} ${packedArray()} ${packedDirect()} ${packedFirst()} ${lentValue()} ${lentDirect()} ${unknownLent(outR)}"
    print "${viaValue()} ${direct()} ${viaMoveSelf()} ${viaRecord()} ${viaOption()} ${viaArray()}"
    print "${localDirect()} ${localValue()} ${unknown(outH)} ${moveSelfLocal()}"
    print "${viaBound()} ${viaGeneric()} ${viaMid()}"
}

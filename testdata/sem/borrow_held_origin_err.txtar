import map from std/map

type V['a] = { pub s &'a String }
type Sink['a] = { pub mut items &'a mut Array[V['a]] }
type W['a] = { pub inner Sink['a] }
type OS['a] = { pub mut o Option[Sink['a]] }
type SS['a] = { pub mut items &'a mut Array[Sink['a]] }

fn pushByValue['a](k: Sink['a], x: V['a]) { k.items.push(x) }
fn pushRef['a](k: &mut Sink['a], x: V['a]) { k.items.push(x) }
fn fwdG[T, X](k: T, x: X, f: fn(T, X) -> Void) { f(k, x) }
fn at['a](ks: &mut Array[Sink['a]]) -> Sink['a] { ks.takeAt(0).unwrap() }
fn first['a](ks: &mut Array[Sink['a]]) -> Option[Sink['a]] { ks.takeAt(0) }
fn Sink['a].add(mut self, x: V['a]) { self.items.push(x) }

fn forwardLocal2['a](k: Sink['a]) { let kk = k; let loc = "l"; pushByValue(kk, V { s: &loc }) } //~ ERROR a borrow cannot be stored into `k` here
fn direct2['a](k: Sink['a]) { let mut kk = k; let loc = "l"; kk.items.push(V { s: &loc }) } //~ ERROR a borrow cannot be stored into `k` here
fn Sink['a].putLocalCopy(move self) { let s = self; let loc = "l"; s.items.push(V { s: &loc }) } //~ ERROR a borrow cannot be stored into `self` here
fn copiedTwice['a](k: Sink['a]) { let loc = "l"; let kk = k; let k2 = kk; k2.items.push(V { s: &loc }) } //~ ERROR a borrow cannot be stored into `k` here
fn refOfCopy['a](k: Sink['a]) { let loc = "l"; let mut kk = k; pushRef(&mut kk, V { s: &loc }) } //~ ERROR a borrow cannot be stored into `k` here
fn refOfParam['a](mut k: Sink['a]) { let loc = "l"; pushRef(&mut k, V { s: &loc }) } //~ ERROR a borrow cannot be stored into `k` here
fn genericForward['a](k: Sink['a]) { let loc = "l"; let kk = k; fwdG(kk, V { s: &loc }, pushByValue) } //~ ERROR a borrow cannot be stored into `k` here
fn rebuilt['a](k: Sink['a]) { let loc = "l"; let kk = k; pushByValue(Sink { items: kk.items }, V { s: &loc }) } //~ ERROR a borrow cannot be stored into `k` here
fn wrapped['a](k: Sink['a]) { let loc = "l"; let w = W { inner: k }; w.inner.items.push(V { s: &loc }) } //~ ERROR a borrow cannot be stored into `k` here
fn wrappedSome['a](k: Sink['a]) { let loc = "l"; let o = Some(k); if let Some(x) = o { x.items.push(V { s: &loc }) } } //~ ERROR a borrow cannot be stored into `k` here
fn fieldOfParam['a](w: W['a]) { let loc = "l"; let W { inner } = w; inner.items.push(V { s: &loc }) } //~ ERROR a borrow cannot be stored into `w` here
fn optionParam['a](o: Option[Sink['a]]) { let loc = "l"; let p = o; if let Some(s) = p { s.items.push(V { s: &loc }) } } //~ ERROR a borrow cannot be stored into `o` here
fn arrayParam['a](ks: Array[Sink['a]]) { let loc = "l"; let mine = ks; for s in mine { s.items.push(V { s: &loc }) } } //~ ERROR a borrow cannot be stored into `ks` here
fn swappedIn['a](k: Sink['a]) { let loc = "l"; let f = "f"; let mut mine = Array.of(V { s: &f }); let mut kk = Sink { items: &mut mine }; kk = k; kk.items.push(V { s: &loc }) } //~ ERROR a borrow cannot be stored into `k` here
fn refToCopy['a](k: Sink['a]) { let loc = "l"; let mut kk = k; let r = &mut kk; r.items.push(V { s: &loc }) } //~ ERROR a borrow cannot be stored into `k` here
fn fnValueCopy['a](k: Sink['a]) { let loc = "l"; let f = pushByValue; let kk = k; f(kk, V { s: &loc }) } //~ ERROR a borrow cannot be stored into `k` here
fn mutSelfOnCopy['a](k: Sink['a]) { let loc = "l"; let mut kk = k; kk.add(V { s: &loc }) } //~ ERROR a borrow cannot be stored into `k` here
fn holderOfHolders['a](ss: SS['a]) { let loc = "l"; let x = ss; for s in x.items { s.items.push(V { s: &loc }) } } //~ ERROR a borrow cannot be stored into `ss` here

fn calleeTakes['a](ks: &mut Array[Sink['a]]) { let loc = "l"; let t = ks.takeAt(0); if let Some(s) = t { pushByValue(s, V { s: &loc }) } } //~ ERROR a borrow cannot be stored into `ks` here
fn calleeTakesRef['a](ks: &mut Array[Sink['a]]) { let loc = "l"; let t = ks.takeAt(0); if let Some(s) = t { let mut ss = s; pushRef(&mut ss, V { s: &loc }) } } //~ ERROR a borrow cannot be stored into `ks` here
fn calleeTakesDirect['a](ks: &mut Array[Sink['a]]) { let loc = "l"; let t = ks.takeAt(0); if let Some(s) = t { s.items.push(V { s: &loc }) } } //~ ERROR a borrow cannot be stored into `ks` here
fn calleeTakesMatch['a](ks: &mut Array[Sink['a]]) {
    let loc = "l"
    match ks.takeAt(0) {
        Some(s) -> s.items.push(V { s: &loc }) //~ ERROR a borrow cannot be stored into `ks` here
        None -> {}
    }
}
fn calleeTakesWrapped['a](ks: &mut Array[Sink['a]]) { let loc = "l"; let t = ks.takeAt(0); let u = t; if let Some(s) = u { let w = W { inner: s }; w.inner.items.push(V { s: &loc }) } } //~ ERROR a borrow cannot be stored into `ks` here
fn helperReturns['a](ks: &mut Array[Sink['a]]) { let loc = "l"; let s = at(ks); s.items.push(V { s: &loc }) } //~ ERROR a borrow cannot be stored into `ks` here
fn helperOption['a](ks: &mut Array[Sink['a]]) { let loc = "l"; if let Some(s) = first(ks) { s.items.push(V { s: &loc }) } } //~ ERROR a borrow cannot be stored into `ks` here
fn optionTake['a](os: &mut OS['a]) { let loc = "l"; if let Some(s) = os.o.take() { s.items.push(V { s: &loc }) } } //~ ERROR a borrow cannot be stored into `os` here
fn mapTake['a](m: &mut map.Map[Int, Sink['a]]) { let loc = "l"; if let Some(s) = m.take(&1) { s.items.push(V { s: &loc }) } } //~ ERROR a borrow cannot be stored into `m` here
fn arrayOfIndex['a](k: Sink['a]) { let mut arr = Array.of(k); let loc = "l"; arr[0].items.push(V { s: &loc }) } //~ ERROR a borrow cannot be stored into `k` here
fn arrayOfTake['a](k: Sink['a]) { let mut arr = Array.of(k); let loc = "l"; let t = arr.takeAt(0); if let Some(s) = t { s.items.push(V { s: &loc }) } } //~ ERROR a borrow cannot be stored into `k` here
fn arrayOfLoop['a](k: Sink['a]) { let arr = Array.of(k); let loc = "l"; for s in arr { s.items.push(V { s: &loc }) } } //~ ERROR a borrow cannot be stored into `k` here
fn arrayOfMoved['a](k: Sink['a]) { let arr = Array.of(k); let m = arr; let loc = "l"; for s in m { s.items.push(V { s: &loc }) } } //~ ERROR a borrow cannot be stored into `k` here
fn arrayPushed['a](k: Sink['a]) { let mut arr: Array[Sink['a]] = Array.of(); arr.push(k); let loc = "l"; arr[0].items.push(V { s: &loc }) } //~ ERROR a borrow cannot be stored into `k` here
fn arrayRelay['a](k: Sink['a]) { let mut arr = Array.of(k); let mut b: Array[Sink['a]] = Array.of(); if let Some(s) = arr.takeAt(0) { b.push(s) }; let loc = "l"; b[0].items.push(V { s: &loc }) } //~ ERROR a borrow cannot be stored into `k` here
fn optionRelay['a](k: Sink['a]) { let mut arr = Array.of(k); let mut b: Array[Option[Sink['a]]] = Array.of(); b.push(arr.takeAt(0)); let loc = "l"; if let Some(Some(s)) = b.takeAt(0) { s.items.push(V { s: &loc }) } } //~ ERROR a borrow cannot be stored into `k` here
fn resultWrapped['a](k: Sink['a]) { let loc = "l"; let r: Result[Sink['a], Int] = Ok(k); if let Ok(s) = r { s.items.push(V { s: &loc }) } } //~ ERROR a borrow cannot be stored into `k` here

fn apply['a](g: fn(V['a]) -> Void, x: V['a]) { g(x) }
fn capSinkRef['a](k: Sink['a]) { let loc = "l"; let r = k.items; apply((x: V['a]) => { r.push(x) }, V { s: &loc }) } //~ ERROR a borrow cannot be stored into `k` here
fn capTakenRef['a](ks: &mut Array[Sink['a]]) { let loc = "l"; if let Some(s) = ks.takeAt(0) { let r = s.items; apply((x: V['a]) => { r.push(x) }, V { s: &loc }) } } //~ ERROR a borrow cannot be stored into `ks` here

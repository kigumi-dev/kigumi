-- app/t/t.kg --
fn ship[T: Send](x: T) {}

/// Safety: test fixture only; not a real guarantee.
@unsafeGuarantee(Send, Send) //~ ERROR `Send` is already guaranteed by this `@unsafeGuarantee`
type DupProp = resource {
    fd Int
}

/// Safety: test fixture only; not a real guarantee.
@unsafeGuarantee(Send)
@unsafeGuarantee(Sync) //~ ERROR at most one `@unsafeGuarantee` is allowed per type declaration
type TwoDirectives = resource {
    fd Int
}

@unsafeGuarantee(Copy) //~ ERROR a `resource` type cannot guarantee `Copy`
type CopyResource = resource {
    fd Int
}

@unsafeGuarantee(Send) //~ ERROR `@unsafeGuarantee` only applies to a `resource` or bodiless `type` declaration
type OrdinaryRecord = {
    n Int
}

@unsafeGuarantee(Send) //~ ERROR `@unsafeGuarantee` only applies to a `resource` or bodiless `type` declaration
fn stray() {}

@unsafeGuarantee(Send) //~ ERROR `@unsafeGuarantee` only applies to a `resource` or bodiless `type` declaration
const K: Int = 1

@unsafeGuarantee(Send) //~ ERROR `@unsafeGuarantee` only applies to a `resource` or bodiless `type` declaration
interface Trait {
    fn f(self) -> Int
}

interface MethodTarget {
    @unsafeGuarantee(Send) //~ ERROR `@unsafeGuarantee` only applies to a `resource` or bodiless `type` declaration
    fn g(self, @unsafeGuarantee(Sync) x: Int) -> Int //~ ERROR `@unsafeGuarantee` only applies to a `resource` or bodiless `type` declaration
}

@unsafeGuarantee(Send) //~ ERROR `@unsafeGuarantee` only applies to a `resource` or bodiless `type` declaration
type Adt = Red | Blue

fn paramTarget(@unsafeGuarantee(Send) x: Int) {} //~ ERROR `@unsafeGuarantee` only applies to a `resource` or bodiless `type` declaration

/// Safety: test fixture only; not a real guarantee.
@unsafeGuarantee(Send when U: Send) //~ ERROR `U` is not a type parameter of `BadParam`
type BadParam[T] = resource {
    t T
}

@unsafeGuarantee(Bogus) //~ ERROR `Bogus` is not a guarantee property
type BadProp = resource {
    fd Int
}

@unsafeGuarantee(Send) //~ WARNING `@unsafeGuarantee` needs a doc comment line starting with `Safety:`
type NoSafetyDoc = resource {
    fd Int
}

/// Safety: fd is a plain OS handle with no shared state.
@unsafeGuarantee(Send, Sync)
type Documented = resource {
    fd Int
}

/// Safety: T is only reachable through the lock, so Cell is Send/Sync exactly
/// when T is.
@unsafeGuarantee(Send when T: Send, Sync when T: Send + Sync)
type Cell[T] = resource {
    t T
}

type CellAlias = Cell[Int]

fn use(doc: Documented, cell: Cell[Int], nested: Cell[Cell[Int]], alias: CellAlias) {
    ship(doc)
    ship(cell)
    ship(nested)
    ship(alias)
}

fn share[T: Sync](x: &T) {}

fn useSync(cell: Cell[Int], notSync: Cell[*const u8]) {
    share(&cell)
    share(&notSync) //~ ERROR `Cell[*const u8]` does not satisfy `Sync`: it cannot be shared between threads
}


-- module --
stage: driver
profile: recoverable-only
-- src --
import ffi from std/ffi

fn put(p: *const u8, xs: &mut Array[*const u8]) {
    _ = xs.tryPush(p)
}

fn main() {
    let p = unsafe { ffi.offset(ffi.null[u8](), 0) }
    match Array.tryEmpty[*const u8]() {
        Ok(xs) -> {
            let mut out = xs
            put(p, &mut out)
        }
        Err(_) -> {}
    }
}

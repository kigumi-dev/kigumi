-- src --
import ffi from std/ffi

type Holder = {
    pub mut p *mut u8
}

fn stash(h: &mut Holder, p: *mut u8) {
    h.p = p
}

// h reaches the callback as a plain `&mut` binding, not a borrow expression,
// so only the callee hand-off itself closes this family of escapes.
fn stashInto(h: &mut Holder, v: u8) -> *mut u8 {
    let mut x: u8 = v
    ffi.withAddress(&mut x, (p: *mut u8) => {
        stash(h, p) //~ ERROR passes its leased pointer to `stash`
    })
    h.p
}

fn throughValue(cb: fn(*mut u8) -> Void, h: &mut Holder) {
    let mut x: u8 = 1
    ffi.withAddress(&mut x, (p: *mut u8) => {
        cb(p) //~ ERROR passes its leased pointer to `cb`
    })
}

fn throughClosure() -> Int {
    let mut x: i32 = 7
    let sink = (q: *mut i32) => {
        let mut keep = Array.empty[*mut i32]()
        keep.push(q)
    }
    ffi.withAddress(&mut x, (p: *mut i32) => {
        sink(p) //~ ERROR passes its leased pointer to `sink`
        0
    })
}

// A local container stays inside the callback, and the std entry points that
// read or write through the lease are the callback's whole purpose.
fn ok() -> i32 {
    let mut x: i32 = 7
    ffi.withAddress(&mut x, (p: *mut i32) => unsafe {
        let mut mine = Array.empty[*mut i32]()
        mine.push(p)
        ffi.writeI32(p, ffi.readI32(ffi.toConst(p)) + 1)
        ffi.readI32(ffi.toConst(p))
    })
}

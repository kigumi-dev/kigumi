-- src --
import ffi from std/ffi

type Holder = {
    pub mut p *mut u8
}

fn stash(h: &mut Holder, p: *mut u8) {
    h.p = p
}

fn stashInto(h: &mut Holder, v: u8) -> *mut u8 {
    let mut x: u8 = v
    ffi.withAddress(&mut x, (p: *mut u8) => {
        stash(h, p) //~ ERROR passes its leased pointer to `stash`
    })
    h.p
}

fn throughValue(cb: fn(*mut u8) -> Void, h: &mut Holder) {
    let mut x: u8 = 1
    ffi.withAddress(&mut x, (p: *mut u8) => {
        cb(p) //~ ERROR passes its leased pointer to `cb`
    })
}

fn throughClosure() -> Int {
    let mut x: i32 = 7
    let sink = (q: *mut i32) => {
        let mut keep = Array.empty[*mut i32]()
        keep.push(q)
    }
    ffi.withAddress(&mut x, (p: *mut i32) => {
        sink(p) //~ ERROR passes its leased pointer to `sink`
        0
    })
}

fn ok() -> i32 {
    let mut x: i32 = 7
    ffi.withAddress(&mut x, (p: *mut i32) => unsafe {
        let mut mine = Array.empty[*mut i32]()
        mine.push(p)
        ffi.writeI32(p, ffi.readI32(ffi.toConst(p)) + 1)
        ffi.readI32(ffi.toConst(p))
    })
}
fn viaOption(h: &mut Holder, v: u8) -> Int {
    let mut x = v
    ffi.withAddress(&mut x, (p: *mut u8) => {
        let o = Some(p)
        let result = o.map((q: *mut u8) => {
            stash(h, q) //~ ERROR passes its leased pointer to `stash`
            0
        })
        0
    })
}

type Pointer = { pub p *mut u8 }

fn viaArray(h: &mut Holder, v: u8) -> Int {
    let mut x = v
    ffi.withAddress(&mut x, (p: *mut u8) => {
        let pointers = Array.of(Pointer { p: p })
        let result = pointers.map((q: &Pointer) => {
            stash(h, q.p) //~ ERROR passes its leased pointer to `stash`
            0
        })
        0
    })
}
fn retain(p: *mut u8) {
    let mut keep = Array.empty[*mut u8]()
    keep.push(p)
}

fn viaBoundCallback(v: u8) -> Int {
    let mut x = v
    ffi.withAddress(&mut x, (p: *mut u8) => {
        let cb = (q: *mut u8) => {
            retain(q) //~ ERROR passes its leased pointer to `retain`
            v.toInt()
        }
        Some(p).map(cb).unwrap()
    })
}

fn okMapped() -> Bool {
    let mut x: u8 = 7
    ffi.withAddress(&mut x, (p: *mut u8) => {
        let cb = (q: *mut u8) => ffi.isNull(ffi.toConst(q))
        Some(p).map(cb).unwrap()
    })
}

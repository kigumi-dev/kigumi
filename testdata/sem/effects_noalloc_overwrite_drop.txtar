-- src --
type Buf = resource { pub n Int }

fn Buf.drop(move self) {
    let xs = Array.of(self.n)
    print "drop ${xs.len()}"
}

type W = resource { pub mut h Buf, pub mut k Int }

noalloc fn set(w: &mut W, b: Buf) {
    w.h = b //~ ERROR dropping `Buf` may allocate or deallocate
}

noalloc fn W.pre(move self, fresh: Buf, put: fn(Buf) -> Bool) -> Bool {
    self.h = fresh //~ ERROR dropping `Buf` may allocate or deallocate
    put(move self.h)
}

noalloc fn W.reset(mut self, fresh: Buf) {
    self.h = fresh //~ ERROR dropping `Buf` may allocate or deallocate
}

noalloc fn store(sink: &mut Array[Buf], b: Buf) {
    sink[0] = b //~ ERROR dropping `Buf` may allocate or deallocate
}

noalloc fn throughRef(s: &mut Buf, b: Buf) {
    s = b //~ ERROR dropping `Buf` may allocate or deallocate
}

noalloc fn rebind(a: Buf, b: Buf) -> Buf {
    let mut x = a
    x = b //~ ERROR dropping `Buf` may allocate or deallocate
    x
}

noalloc fn relayLoop(a: Buf, put: fn(Buf) -> Bool, mk: fn() -> Buf) -> Buf {
    let mut x = a
    let mut i = 0
    for i < 2 {
        x = mk() //~ ERROR dropping `Buf` may allocate or deallocate
        i += 1
    }
    x
}

noalloc fn W.refill(move self, fresh: Buf, put: fn(Buf) -> Bool) -> W {
    let ok = put(move self.h)
    self.h = fresh
    self
}

noalloc fn relay(a: Buf, b: Buf, put: fn(Buf) -> Bool) -> Buf {
    let mut x = a
    let ok = put(x)
    x = b
    x
}

noalloc fn setK(w: &mut W, k: Int) {
    w.k = k
}

let w = W { h: Buf { n: 1 }, k: 2 }
print "${w.k}"

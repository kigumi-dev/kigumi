    let b = P[Int] { x: 2 }
    let c = Pair[Int] { a: 1, b: 2 } //~ ERROR `Pair` takes 2 type arguments, 1 given
    let d = Pair[Int, Int] { a: 1, b: 2 }
    b.x + d.a
}

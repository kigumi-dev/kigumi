import json from std/json

type C = { mut n Int }
type R = { mut f fn() -> Int }
type Outer = { mut inner R }
type G = resource { pub f fn() -> Int }
type Bad = { pub why String }

interface Msg { fn text(self) -> String }

fn G.drop(move self) { _ = (self.f)() }
fn Bad.text(self) -> String { self.why }
fn compute(f: fn() -> Int) -> Result[Int, Msg] {
    let v = f()
    if v > 100 { Err(Bad { why: "big" }) } else { Ok(v) }
}
fn mkOther(f: fn() -> Int) -> fn() -> Int { () => 42 }
fn adapt(f: escaping fn() -> Int) -> fn(Int) -> Int { (x: Int) => x + f() }
fn addAll(mut xs: Array[fn() -> Int], f: escaping fn() -> Int) -> Array[fn() -> Int] { xs.push(f); xs }
fn pushFirst(out: &mut Array[fn() -> Int], f: escaping fn() -> Int) { out.push(f) }
fn storeIn(r: &mut R, f: escaping fn() -> Int) { r.f = f }
fn storeIn2(r: &mut R, f: escaping fn() -> Int) { storeIn(r, f) }
fn holderFirst(f: escaping fn() -> Int, r: &mut R) { r.f = f }
fn mix(f: escaping fn() -> Int, r: &mut R) { holderFirst(f, r) }
fn passOn(r: &mut R, f: escaping fn() -> Int) { storeIn2(r, f) }
fn readIn(r: &mut R, f: escaping fn() -> Int) -> Int { r.f() + f() }
fn readIn2(r: &mut R, f: escaping fn() -> Int) -> Int { readIn(r, f) }
fn rd(r: &mut R, f: escaping fn() -> Int, n: Int) -> Int { if n > 0 { rd(r, f, n - 1) } else { r.f() + f() } }
fn ma(r: &mut R, f: escaping fn() -> Int, n: Int) -> Int { if n > 0 { mb(r, f, n - 1) } else { r.f() + f() } }
fn mb(r: &mut R, f: escaping fn() -> Int, n: Int) -> Int { if n > 0 { ma(r, f, n - 1) } else { f() } }
fn rdStore(r: &mut R, f: escaping fn() -> Int, n: Int) { if n > 0 { rdStore(r, f, n - 1) } else { r.f = f } }
fn sa(r: &mut R, f: escaping fn() -> Int, n: Int) { if n > 0 { sb(r, f, n - 1) } }
fn sb(r: &mut R, f: escaping fn() -> Int, n: Int) { if n > 0 { sa(r, f, n - 1) } else { r.f = f } }


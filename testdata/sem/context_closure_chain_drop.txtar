-- src --
context tok: Int

@provides(tok)
type Bundle = resource {
    tok Int
}

fn Bundle.drop(move self) -> Unit {
    _ = "${self.tok}"
}

type Trivial = resource {
    x Int
}

fn Trivial.drop(move self) -> Unit {}

fn needsTok() -> Int {
    tok
}

noalloc fn useClosure(t: Trivial) -> Int {
    context (Bundle { tok: 1 }) { //~ ERROR constructing `Bundle` allocates //~ ERROR dropping `Bundle` may allocate or deallocate
        let f = () => { //~ ERROR dropping `closure fn() -> Int` may allocate or deallocate //~ ERROR constructing `closure fn() -> Int` allocates
            let _held = t
            needsTok()
        }
        f() //~ ERROR `f` is not `noalloc`
    }
}

_ = useClosure(Trivial { x: 0 })

-- module --
mir: planned
-- src --
noalloc fn apply(f: noalloc fn(Int) -> Ordering, v: Int) -> Ordering {
    f(v) //~ ERROR a call through a function value receives this `Int` in a box
}

// A payload-free variant is an immortal, so handing it back through a closure allocates nothing.
noalloc fn rank(n: Int) -> Ordering {
    apply((x: Int) => if x > 0 { Ordering.Greater } else { Ordering.Equal }, n)
}

noalloc fn applyOpt(f: noalloc fn(Int) -> Int?, v: Int) -> Int? {
    f(v) //~ ERROR arrives in a box //~ ERROR a call through a function value receives this `Int` in a box
}

noalloc fn payload(n: Int) -> Int? {
    applyOpt((x: Int) => Some(x), n) //~ ERROR is not `noalloc`
}

fn main() -> Unit! {}

-- module --
mir: planned
-- src --
type Bag = {pub mut items Array[i64], pub mut tag String}
type Sh = Boxy(b: Bag) | Nil
type Hold = {pub mut sh Sh, pub mut n Int}
type Inner = {pub mut bag Bag, pub mut x Int}
type Deep = {pub mut a Int, pub mut inner Inner}
type W['a] = {pub r &'a mut Sh}
type Wr = {pub mut h Hold}
type View['a] = {pub data &'a Bytes}

fn shMut(h: &mut Hold) -> &mut Sh { &mut h.sh }
fn Hold.shM(mut self) -> &mut Sh { &mut self.sh }
fn Hold.view(self) -> &Sh { &self.sh }
fn innerMut(d: &mut Deep) -> &mut Inner { &mut d.inner }
fn idr[T](x: T) -> T { x }
fn apply[R](h: &mut Hold, f: fn(&mut Hold) -> R) -> R { f(h) }
fn first['a](a: &'a mut Hold, b: &mut Hold) -> &'a mut Sh { &mut a.sh }
fn touch(h: &mut Hold) { h.sh = Sh.Nil }
fn count(h: &mut Hold) -> Int { h.n }
fn isBoxy(s: &mut Sh) -> Bool { s is Boxy(_) }
fn hm(w: &mut Wr) -> &mut Hold { &mut w.h }
fn pick['a](a: &'a mut Hold, b: &'a mut Hold, c: Bool) -> &'a mut Sh {
    if c { &mut a.sh } else { &mut b.sh }
}
fn pickBytes['a](c: Bool, a: &'a Bytes, b: &'a Bytes) -> &'a Bytes {
    if c { a } else { b }
}

fn passed(h: &mut Hold) -> Bool {
    let r = shMut(h)
    touch(h) //~ ERROR `h` is exclusively borrowed and cannot be used here
    isBoxy(r)
}

fn written(h: &mut Hold) -> Bool {
    let r = shMut(h)
    h.sh = Sh.Nil //~ ERROR `h` is exclusively borrowed and cannot be used here
    isBoxy(r)
}

fn read(h: &mut Hold) -> Bool {
    let r = shMut(h)
    let k = count(h) //~ ERROR `h` is exclusively borrowed and cannot be used here
    k > 0 && isBoxy(r)
}

fn method(h: &mut Hold) -> Bool {
    let r = h.shM()
    h.n = 2 //~ ERROR `h` is exclusively borrowed and cannot be used here
    isBoxy(r)
}

fn sharedMethod(h: &mut Hold) -> Bool {
    let r = h.view()
    h.sh = Sh.Nil //~ ERROR `h` is borrowed and cannot be mutated here
    r is Boxy(_)
}

fn generic(h: &mut Hold) -> Bool {
    let r = idr(shMut(h))
    touch(h) //~ ERROR `h` is exclusively borrowed and cannot be used here
    isBoxy(r)
}

fn fnValue(h: &mut Hold) -> Bool {
    let r = apply(h, shMut)
    touch(h) //~ ERROR `h` is exclusively borrowed and cannot be used here
    isBoxy(r)
}

fn named(h: &mut Hold, g: &mut Hold) -> Bool {
    let r = first(h, g)
    touch(g)
    touch(h) //~ ERROR `h` is exclusively borrowed and cannot be used here
    isBoxy(r)
}

fn tempScrutinee(h: &mut Hold) -> String {
    if shMut(h) is Boxy(b) {
        touch(h) //~ ERROR `h` is exclusively borrowed and cannot be used here
        return b.tag
    }
    ""
}

fn matched(h: &mut Hold) -> String {
    match shMut(h) {
        Boxy(b) -> {
            touch(h) //~ ERROR `h` is exclusively borrowed and cannot be used here
            b.tag
        }
        Nil -> ""
    }
}

fn binding(h: &mut Hold) -> String {
    let r = shMut(h)
    if r is Boxy(b) {
        h.n = 3 //~ ERROR `h` is exclusively borrowed and cannot be used here
        return b.tag
    }
    ""
}

fn field(d: &mut Deep) -> Int {
    let r = innerMut(d)
    let c = &mut r.bag
    d.inner.bag.items = Array.of(9) //~ ERROR `d` is exclusively borrowed and cannot be used here
    c.items.len().toInt() || 0
}

fn fieldLocal() -> Int {
    let mut dd = Deep { a: 1, inner: Inner { bag: Bag { items: Array.of(1), tag: "t" }, x: 2 } }
    let r = innerMut(&mut dd)
    let c = &mut r.bag
    dd.inner.bag.tag = "z" //~ ERROR `dd` is exclusively borrowed and cannot be used here
    c.tag.len().toInt() || 0
}

fn stored(h: &mut Hold) -> Bool {
    let w = W { r: shMut(h) }
    touch(h) //~ ERROR `h` is exclusively borrowed and cannot be used here
    isBoxy(w.r)
}

fn inArray(h: &mut Hold) -> usize {
    let ws = Array.of(W { r: shMut(h) })
    touch(h) //~ ERROR `h` is exclusively borrowed and cannot be used here
    ws.len()
}

fn returned(h: &mut Hold) -> &mut Sh {
    let r = shMut(h)
    touch(h) //~ ERROR `h` is exclusively borrowed and cannot be used here
    r
}

fn looped(h: &mut Hold) -> Bool {
    let r = shMut(h)
    let mut seen = false
    for i in 0..2 {
        seen = isBoxy(r)
        touch(h) //~ ERROR `h` is exclusively borrowed and cannot be used here
    }
    seen
}

fn localRef() -> Bool {
    let mut hh = Hold { sh: Sh.Nil, n: 1 }
    let h = &mut hh
    let r = shMut(h)
    touch(h) //~ ERROR `h` is exclusively borrowed and cannot be used here
    isBoxy(r)
}

fn ownerBehindRef() -> Bool {
    let mut hh = Hold { sh: Sh.Nil, n: 1 }
    let h = &mut hh
    let r = h.shM()
    hh.n = 5 //~ ERROR `hh` is exclusively borrowed and cannot be used here
    isBoxy(r)
}

fn patternRef(o: &mut Option[Hold]) -> Bool {
    if o is Some(h) {
        let r = shMut(h)
        touch(h) //~ ERROR `h` is exclusively borrowed and cannot be used here
        return isBoxy(r)
    }
    false
}

fn resultRef(w: &mut Wr) -> Bool {
    let h = hm(w)
    let r = shMut(h)
    touch(h) //~ ERROR `h` is exclusively borrowed and cannot be used here
    isBoxy(r)
}

fn loopRef(a: &mut Array[Hold]) -> Bool {
    for h in a {
        let r = shMut(h)
        touch(h) //~ ERROR `h` is exclusively borrowed and cannot be used here
        return isBoxy(r)
    }
    false
}

fn mixedLocal(h: &mut Hold) -> Bool {
    let mut l = Hold { sh: Sh.Nil, n: 1 }
    let r = pick(h, &mut l, true)
    l.n = 4 //~ ERROR `l` is exclusively borrowed and cannot be used here
    isBoxy(r)
}

fn mixedParam(h: &mut Hold) -> Bool {
    let mut l = Hold { sh: Sh.Nil, n: 1 }
    let r = pick(h, &mut l, true)
    h.n = 4 //~ ERROR `h` is exclusively borrowed and cannot be used here
    isBoxy(r)
}

fn mixedLent['a](v: View['a]) -> usize {
    let buf = Bytes.fromArray(&Array.of(9, 9))
    let r = pickBytes(true, v.data, &buf) //~ ERROR a borrow returned through this call may come from `buf`, a local
    r.len()
}

fn continued(h: &mut Hold, c: Bool) -> Int {
    let r = shMut(h)
    let mut a = 0
    for i in 0..3 {
        if isBoxy(r) {
            a += 1
        }
        if c {
            h.sh = Sh.Nil //~ ERROR `h` is exclusively borrowed and cannot be used here
            continue
        }
    }
    a
}

fn usedAfterLoop(h: &mut Hold, c: Bool) -> Bool {
    let r = shMut(h)
    for i in 0..3 {
        if c {
            h.sh = Sh.Nil //~ ERROR `h` is exclusively borrowed and cannot be used here
            break
        }
    }
    isBoxy(r)
}

fn inPayload(h: &mut Hold) -> Bool {
    let w = Some(shMut(h))
    touch(h) //~ ERROR `h` is exclusively borrowed and cannot be used here
    if w is Some(x) { isBoxy(x) } else { false }
}

fn inlineInPayload(h: &mut Hold) -> Bool {
    let w = Some(&mut h.sh) //~ ERROR a borrow cannot go in payload 0, a payload of `Option`
    if w is Some(x) { isBoxy(x) } else { false }
}

fn inElement(h: &mut Hold) -> usize {
    let w = Array.of(shMut(h)) //~ ERROR a borrow cannot go in element 0
    w.len()
}


-- src --
type Pt = {
    pub mut x Int
    pub mut y Int
}

type Seg = {
    pub mut a Pt
    pub mut b Pt
}

type Wrap = {
    pub mut a FixedArray[Pt, 3]
}

type Outer = {
    pub mut segs FixedArray[Seg, 2]
    pub mut w Wrap
}

type Grid = {
    pub mut rows FixedArray[FixedArray[Pt, 2], 2]
}

noalloc fn okSlotCopy(w: &mut Wrap) -> Unit { w.a[0] = w.a[1] }

noalloc fn okNestedCopy(g: &mut Grid) -> Unit { g.rows[0][1] = g.rows[1][0] }

fn undeclaredFieldCopy(o: &mut Outer) -> Unit { o.segs[0].a = o.segs[1].b }

fn undeclaredLiteral(w: &mut Wrap) -> Unit { w.a[0] = Pt { x: 1, y: 2 } }

noalloc fn fieldCopy(o: &mut Outer) -> Unit { o.segs[0].a = o.segs[1].b }

noalloc fn slotFromField(o: &mut Outer) -> Unit { o.w.a[1] = o.segs[1].a }

noalloc fn fieldFromSlot(o: &mut Outer) -> Unit { o.segs[0].b = o.w.a[2] }

noalloc fn Outer.shift(mut self) -> Unit { self.segs[1].a = self.segs[0].b }

noalloc fn fieldFromOwnedLocal(o: &mut Outer, s: &Seg) -> Unit { o.segs[0].a = s.b } //~ ERROR allocates a box

noalloc fn byValueSlots(mut w: Wrap) -> Unit { w.a[0] = w.a[1] } //~ ERROR allocates a box

noalloc fn byValueFields(mut o: Outer) -> Unit { o.segs[0].a = o.segs[1].b } //~ ERROR allocates a box

noalloc fn localSlots() -> Int {
    let mut w = Wrap { a: FixedArray.filled[Pt, 3](Pt { x: 0, y: 0 }) }
    w.a[0] = w.a[1] //~ ERROR allocates a box
    w.a[0].x
}

fn undeclaredByValue(mut w: Wrap) -> Unit { w.a[0] = w.a[1] }

fn undeclaredByValueFields(mut o: Outer) -> Unit { o.segs[0].a = o.segs[1].b }

fn undeclaredLocal(p: Pt) -> Int {
    let mut w = Wrap { a: FixedArray.filled[Pt, 3](p) }
    w.a[0] = w.a[2]
    w.a[1] = w.a[0]
    w.a[1].x
}

noalloc fn viaLocal(w: &mut Wrap) -> Unit {
    let t = w.a[0]
    w.a[1] = t //~ ERROR allocates a box
}

noalloc fn literalStore(w: &mut Wrap) -> Unit { w.a[0] = Pt { x: 1, y: 2 } } //~ ERROR allocates a box

noalloc fn valueStore(w: &mut Wrap, p: Pt) -> Unit { w.a[0] = p } //~ ERROR allocates a box

type Tw = {
    pub mut ws Array[Int]
    pub mut w Wrap
}

fn undeclaredTwLiteral(mut t: Tw) -> Int {
    t.w.a[0] = Pt { x: 1, y: 2 }
    t.w.a[0].x
}

fn undeclaredTwSwap(mut t: Tw) -> Int {
    let tmp = t.w.a[0]
    t.w.a[1] = tmp
    t.w.a[1].x
}

fn undeclaredTwOwn(mut t: Tw) -> Tw {
    t.w.a[2] = Pt { x: 9, y: 9 }
    t
}

noalloc fn twLiteral(mut t: Tw) -> Unit { t.w.a[0] = Pt { x: 1, y: 2 } } //~ ERROR allocates a box

noalloc fn twSwap(mut t: Tw) -> Unit {
    let tmp = t.w.a[0]
    t.w.a[1] = tmp //~ ERROR allocates a box
}

-- module --
mir: planned
-- src --
type P = { pub mut a Int, pub mut b Int }

fn P.incA(mut self) -> Int { self.a = self.a + 1; 0 }
fn P.getB(self) -> Int { self.b }
fn both2[F: FnMut[fn() -> Void]](f: fn() -> Int, mut g: F) -> Int { g(); f() }
fn apply2(f: fn() -> Int, x: Int) -> Int { f() + x }
fn bump(k: &mut Int) -> Int { k = k + 1; 0 }
fn peek(k: &Int) -> Int { k * 10 }
fn runIt[F: FnMut[fn() -> Void]](mut f: F) -> Int { f(); 0 }

fn laterBlockWrites() -> Int {
    let mut k = 1
    both2(() => k, { k = k + 1; () => { } }) //~ ERROR closure captures `k` (written outside this closure
}

fn laterBlockReads() -> Int {
    let mut k = 1
    let a = both2(() => k, { _ = k + 1; () => { } })
    a + both2(() => 0, () => { k = k + 1 })
}

fn laterValueWrites() -> Int {
    let mut k = 1
    apply2(() => k, { k = k + 1; 0 }) //~ ERROR closure captures `k` (written outside this closure
}

fn laterValueReads() -> Int {
    let mut k = 1
    let a = apply2(() => k, { k + 1 })
    a + both2(() => 0, () => { k = k + 1 })
}

fn laterBorrowWrites() -> Int {
    let mut k = 1
    apply2(() => k, bump(&mut k)) //~ ERROR closure captures `k` (written outside this closure
}

fn laterBorrowReads() -> Int {
    let mut k = 1
    let a = apply2(() => k, peek(&k))
    a + bump(&mut k)
}

fn laterRunsWriter() -> Int {
    let mut k = 1
    let mut w = () => { k = k + 1 }
    apply2(() => k, { w(); 0 }) //~ ERROR closure captures `k` (written outside this closure
}

fn laterRunsReader() -> Int {
    let mut k = 1
    let mut w = () => { _ = k + 1 }
    let a = apply2(() => k, { w(); 0 })
    a + both2(() => 0, () => { k = k + 1 })
}

fn laterCallRunsWriter() -> Int {
    let mut k = 1
    let w = () => { k = k + 1 }
    apply2(() => k, runIt(w)) //~ ERROR closure captures `k` (written outside this closure
}

fn laterCallRunsReader() -> Int {
    let mut k = 1
    let w = () => { _ = k + 1 }
    let a = apply2(() => k, runIt(w))
    a + both2(() => 0, () => { k = k + 1 })
}

fn laterReceiverWrites() -> Int {
    let mut p = P { a: 1, b: 2 }
    apply2(() => p.a, p.incA()) //~ ERROR closure captures `p` (written outside this closure
}

fn laterReceiverReads() -> Int {
    let mut p = P { a: 1, b: 2 }
    let a = apply2(() => p.a, p.getB())
    a + p.incA()
}

fn laterWritesOtherField() -> Int {
    let mut p = P { a: 1, b: 2 }
    apply2(() => p.a, { p.b = 5; 0 })
}

fn laterNamedArgWrites() -> Int {
    let mut k = 1
    apply2(f: () => k, x: { k = k + 1; 0 }) //~ ERROR closure captures `k` (written outside this closure
}

fn earlierNamedArgWrites() -> Int {
    let mut k = 1
    let a = apply2(x: { k = k + 1; 0 }, f: () => k)
    a + both2(() => 0, () => { k = k + 1 })
}

fn laterNestedCallWrites() -> Int {
    let mut k = 1
    apply2(() => k, apply2(() => 0, { k = k + 1; 0 })) //~ ERROR closure captures `k` (written outside this closure
}

fn laterNestedCallReads() -> Int {
    let mut k = 1
    let a = apply2(() => k, apply2(() => 0, { k + 1 }))
    a + both2(() => 0, () => { k = k + 1 })
}

fn laterLoopWrites() -> Int {
    let mut k = 1
    apply2(() => k, { for k < 3 { k = k + 1 }; 0 }) //~ ERROR closure captures `k` (written outside this closure
}

fn laterWriteLeaves(c: Bool) -> Int {
    let mut k = 1
    apply2(() => k, { if c { k = k + 1; return 0 }; 0 })
}

fn namedReaderLaterWrite() -> Int {
    let mut k = 1
    let r = () => k
    apply2(r, { k = k + 1; 0 }) //~ ERROR closure captures `k` (written outside this closure
}

fn namedReaderLaterRead() -> Int {
    let mut k = 1
    let r = () => k
    let a = apply2(r, { k + 1 })
    a + both2(() => 0, () => { k = k + 1 })
}

type Q = { pub mut p P, pub mut c Int }

fn P.incBoth(mut self) -> Int { self.incA() + { self.b = self.b + 1; 0 } }
fn P.reset(mut self) -> Int { self = P { a: 0, b: 0 }; 0 }
fn Q.incPA(mut self) -> Int { self.p.a = self.p.a + 1; 0 }

fn laterReceiverWritesOtherField() -> Int {
    let mut p = P { a: 1, b: 2 }
    apply2(() => p.b, p.incA())
}

fn laterBorrowWritesOtherField() -> Int {
    let mut p = P { a: 1, b: 2 }
    apply2(() => p.b, bump(&mut p.a))
}

fn laterReceiverPassesSelfOn() -> Int {
    let mut p = P { a: 1, b: 2 }
    apply2(() => p.b, p.incBoth()) //~ ERROR closure captures `p` (written outside this closure
}

fn laterReceiverReplacesSelf() -> Int {
    let mut p = P { a: 1, b: 2 }
    apply2(() => p.b, p.reset()) //~ ERROR closure captures `p` (written outside this closure
}

fn laterNestedReceiverWrites() -> Int {
    let mut q = Q { p: P { a: 1, b: 2 }, c: 3 }
    apply2(() => q.p.a, q.incPA()) //~ ERROR closure captures `q` (written outside this closure
}

fn laterNestedReceiverWritesOther() -> Int {
    let mut q = Q { p: P { a: 1, b: 2 }, c: 3 }
    apply2(() => q.p.b + q.c, q.incPA())
}

fn laterFieldReceiverWrites() -> Int {
    let mut q = Q { p: P { a: 1, b: 2 }, c: 3 }
    apply2(() => q.p.a, q.p.incA()) //~ ERROR closure captures `q` (written outside this closure
}

fn laterFieldReceiverWritesOther() -> Int {
    let mut q = Q { p: P { a: 1, b: 2 }, c: 3 }
    apply2(() => q.p.b + q.c, q.p.incA())
}

-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

type Pair = {
    pub a Res
    pub b Res
}

fn implicitOr(p: Pair, o: Res?) -> Res {
    defer { print "defer ${p.a.id}" } //~ ERROR a cleanup reads `p.a`
    o || p.a
}

fn implicitTail(p: Pair) -> Res {
    defer { print "defer ${p.a.id}" } //~ ERROR a cleanup reads `p.a`
    p.a
}

fn implicitIf(p: Pair, c: Bool, y: Res) -> Res {
    defer { print "defer ${p.a.id}" } //~ ERROR a cleanup reads `p.a`
    if c { p.a } else { y }
}

fn otherField(p: Pair, o: Res?) -> Res {
    defer { print "defer ${p.b.id}" }
    o || p.a
}

-- src --
fn eat[T](v: T) {}

type Cell[T] = {
    pub v T
    pub n Int
}

fn letFallback[T](o: T?, p: Cell[T]) -> T {
    let r = o || p.v //~ ERROR reading `p.v` by value
    eat(p)
    r
}

fn argFallback[T](o: T?, p: Cell[T]) {
    eat(o || p.v) //~ ERROR reading `p.v` by value
    eat(p)
}

fn handlerFallback[T](r: Result[T, Int], p: Cell[T]) -> T {
    let v = r || (e) => p.v //~ ERROR reading `p.v` by value
    eat(p)
    v
}

fn copyField[T](o: Int?, p: Cell[T]) -> Int {
    let n = o || p.n
    eat(p)
    n
}

fn movedField[T](o: T?, p: Cell[T]) -> T {
    o || move p.v
}

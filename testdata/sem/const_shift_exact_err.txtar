const ByI64 = 1 << K64 //~ ERROR shift count must be `usize`, found `Int`
const ByNeg = 1 << NegK //~ ERROR shift count must be `usize`, found `i8`
const BadRecv = 2.0 << 1 //~ ERROR no operator `<<` for ({float}, {integer})
const C60: usize = 60
const C65: usize = 65
const Big60: u8 = (1 << 70) >> C60 //~ ERROR `1024` does not fit `u8`
const Under: u8 = (1 << 9) >> (C65 - 66) //~ ERROR `-1` does not fit `usize`
const Late = (1 << 4095) >> 4000

fn main() {
    let x: Int = Late //~ ERROR `39614081257132168796771975168` does not fit `Int`
    let y: u128 = Late << 40 //~ ERROR `43556142965880123323311949751266331066368` does not fit `u128`
    print "${x} ${y}"
}

const C1: Int = comptime ((1 << 4095) >> 4000) //~ ERROR `39614081257132168796771975168` does not fit `Int`
const C2: u8 = comptime (1 << -3) //~ ERROR `-3` does not fit `usize`
const C3: Int = comptime { 1 << 70000 } //~ ERROR limited to 65536 bits
const FL: Float = 2.0
const K8: u8 = 3
const K64: i64 = 2
const NegK: i8 = -1
const BadF = 1 << 2.0 //~ ERROR float literal `2` cannot be `usize`
const BadTyped = 1 << FL //~ ERROR shift count must be `usize`, found `Float`
const BadBool = 1 << true //~ ERROR shift count must be `usize`, found `Bool`
const BadChar = 1 << 'a' //~ ERROR shift count must be `usize`, found `Char`
const ByU8 = 1 << K8 //~ ERROR shift count must be `usize`, found `u8`

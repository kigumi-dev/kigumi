import task from std/task

type V['a] = { pub s &'a String }
type Sink['a] = { pub mut items &'a mut Array[V['a]] }
type W['a] = { pub mut inner Sink['a] }
type OS['a] = { pub mut o Option[Sink['a]] }
type H['a] = { pub mut fs &'a mut Array[Future[String]] }
type Pair['a] = { pub k Sink['a], pub x V['a] }
type PairM['a] = { pub mut k Sink['a], pub mut x V['a] }
type P2['a, 'b] = { pub s &'a String, pub t &'b String }

fn mvS['a](k1: &mut Array[Sink['a]], k2: &mut Array[Sink['a]]) { let t = k2.takeAt(0); if let Some(s) = t { k1.push(s) } }
fn tk2['a](k: &mut Array[Sink['a]]) -> Option[Sink['a]] { k.takeAt(0) }
fn mvThroughHelper['a](k1: &mut Array[Sink['a]], k2: &mut Array[Sink['a]]) { if let Some(s) = tk2(k2) { k1.push(s) } }
fn mvO['a](k1: &mut Array[Sink['a]], k2: &mut OS['a]) { if let Some(s) = k2.o.take() { k1.push(s) } }
fn pushByValue['a](k: Sink['a], x: V['a]) { k.items.push(x) }
fn pushByValueCopy['a](k: Sink['a], x: V['a]) { let mut kk = k; kk.items.push(x) }
fn Sink['a].put(move self, x: V['a]) { self.items.push(x) }
fn pushNested['a](w: W['a], x: V['a]) { w.inner.items.push(x) }
fn pushOption['a](o: Option[Sink['a]], x: V['a]) { if let Some(k) = o { k.items.push(x) } }
fn pushOwnedArray['a](ks: Array[Sink['a]], x: V['a]) { for k in ks { k.items.push(x) } }
async fn show(r: &String) -> String { "${r}" }
fn pushFutureByValue['a](k: H['a], f: Future[String]) { k.fs.push(f) }
fn forwardLocal['a](k: Sink['a]) { let loc = "l"; pushByValue(k, V { s: &loc }) } //~ ERROR a borrow cannot be stored into `k` here
fn pushEach['a](k: &mut Array[Sink['a]], x: V['a]) { for s in k { s.items.push(x) } }
fn pushTaken['a](k: &mut Array[Sink['a]], x: V['a]) { let t = k.takeAt(0); if let Some(s) = t { s.items.push(x) } }
fn pushRef['a](k: &mut Sink['a], x: V['a]) { k.items.push(x) }
fn heldCallerRef['a](arr: &mut Array[Array[V['a]]]) { let loc = "l"; let mut sk = Sink { items: &mut arr[0] }; pushRef(&mut sk, V { s: &loc }) } //~ ERROR a borrow cannot be stored into `arr` here
fn selfStore['a](p: Pair['a]) { p.k.items.push(p.x) }
fn selfStoreRef['a](p: &mut Pair['a]) { p.k.items.push(p.x) }
fn selfStoreHelper['a](p: &mut PairM['a]) { pushRef(&mut p.k, p.x) }
fn viaClo['a](f: fn(V['a]) -> Void, x: V['a]) { f(x) }
fn fwdG[T, 'a](k: T, x: V['a], f: fn(T, V['a]) -> Void) { f(k, x) }
fn fwdM[T, 'a](k: &mut T, x: V['a], f: fn(&mut T, V['a]) -> Void) { f(k, x) }
fn run2(f: fn() -> Void) { f() }
fn runBound[F: FnMut[fn() -> Void]](mut f: F) { f() }
fn viaCloBound['a, F: FnMut[fn(V['a]) -> Void]](mut f: F, x: V['a]) { f(x) }
fn fwdBound[T, 'a, F: FnMut[fn(T, V['a]) -> Void]](k: T, x: V['a], mut f: F) { f(k, x) }
fn runFn1['a](f: fn(V['a]) -> Void, x: V['a]) { f(x) }
interface Putter['a] { fn put(move self, x: V['a]) }
type SinkP['a] = { pub k Sink['a] }
fn SinkP['a].put(move self, x: V['a]) { self.k.items.push(x) }
fn viaIface['a, P: Putter['a]](p: P, x: V['a]) { p.put(x) }
fn cb2['a](f: fn(V['a], Sink['a]) -> Void, x: V['a], k: Sink['a]) { f(x, k) }
fn cb3['a](f: fn(V['a], Sink['a]) -> Void, x: V['a], k: Sink['a]) { cb2(f, x, k) }
fn pushXK['a](x: V['a], k: Sink['a]) { k.items.push(x) }
fn cbCap['a](h: fn(V['a], Sink['a]) -> Void, x: V['a], k: Sink['a]) { cb2((xx, kk) => { h(xx, kk) }, x, k) }
fn viaPair['a](f: fn(V['a], V['a]) -> Void, x: V['a], z: V['a]) { f(x, z) }
fn twoLifetimes['a, 'b](b: &mut Array[P2['a, 'b]], dst: &mut Array[V['a]]) { for x in b { dst.push(V { s: x.t }) } } //~ ERROR a borrow cannot be stored into `dst` here
fn heldCallerByValue['a](arr: &mut Array[Array[V['a]]]) { let loc = "l"; pushByValue(Sink { items: &mut arr[0] }, V { s: &loc }) } //~ ERROR a borrow cannot be stored into `arr` here


-- module --
mir: planned
-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn Res.close(move self) {}

fn Res.peek(self) -> Int {
    self.id
}

fn mkr(n: Int) -> Res {
    Res { id: n }
}

fn say(n: Int) {}

type Wrap = {
    pub mut a Res
    pub n Int
}

fn eat(r: Res) -> Bool {
    r.close()
    false
}

fn pushTwice() {
    let w = Wrap { a: mkr(1), n: 1 }
    let mut keep = Array.of(mkr(0))
    keep.push(w.a)
    keep.push(w.a) //~ ERROR `w.a` was moved //~ ERROR `w.a` was moved
}

fn pushThenRead() {
    let w = Wrap { a: mkr(2), n: 1 }
    let mut keep = Array.of(mkr(0))
    keep.push(w.a)
    say(w.a.peek()) //~ ERROR `w.a` was moved //~ ERROR `w.a` was moved
}

fn pushInLoop() {
    let w = Wrap { a: mkr(3), n: 1 }
    let mut keep = Array.of(mkr(0))
    for i in 0..2 {
        keep.push(w.a) //~ ERROR `w.a` was moved //~ ERROR `w.a` was moved
    }
}

fn pushOnce() {
    let w = Wrap { a: mkr(4), n: 1 }
    let mut keep = Array.of(mkr(0))
    keep.push(w.a)
    say(w.n)
}

fn guardConsumes() {
    let o = Some(mkr(5))
    match o {
        Some(r) if eat(r) -> say(1)
        _ -> match o {
            Some(x) -> x.close() //~ ERROR `o` was moved
            None -> say(0)
        }
    }
}

fn chainConsumes() {
    let o = Some(mkr(6))
    if o is Some(r) && eat(r) {
        say(1)
    } else {
        match o {
            Some(x) -> x.close() //~ ERROR `o` is moved on some paths but not others
            None -> say(0)
        }
    }
}

fn chainElseKeeps(c: Bool) {
    let o = Some(mkr(7))
    if o is Some(r) && c {
        r.close()
    } else {
        match o {
            Some(x) -> x.close()
            None -> say(0)
        }
    }
}

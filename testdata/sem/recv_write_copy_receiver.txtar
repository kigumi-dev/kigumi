-- module --
stage: driver
-- src --
type C = { pub mut n Int }

fn C.bump(mut self, k: Int) -> Int {
    self.n = self.n + k
    self.n
}

fn C.reset(mut self, k: Int) -> Int {
    self = C { n: k }
    self.n
}

type P = { pub mut h C, pub mut k C }

type S = { pub mut name String, pub mut n Int }

fn S.bump(mut self, k: Int) -> Int {
    self.n = self.n + k
    self.n
}

type A = { pub mut xs Array[Int], pub mut n Int }

fn A.bump(mut self, k: Int) -> Int {
    self.n = self.n + k
    self.n
}

fn takeA(a: A) -> Int {
    a.n
}

type R = resource { pub mut id Int }

fn R.drop(move self) {}

fn R.bump(mut self, k: Int) -> Int {
    self.id = self.id + k
    self.id
}

fn R.reset(mut self, k: Int) -> Int {
    self = R { id: k }
    self.id
}

fn copyReplaced() -> Int {
    let mut a = C { n: 1 }
    a.bump({ a = C { n: 100 }; 10 })
}

fn stringReplaced() -> Int {
    let mut s = S { name: "x", n: 1 }
    s.bump({ s = S { name: "y", n: 100 }; 10 })
}

fn arrayMoved() -> Int {
    let mut a = A { xs: Array.of(1), n: 1 }
    a.bump({ let _ = takeA(a); 10 })
}

fn fieldReplaced() -> Int {
    let mut p = P { h: C { n: 1 }, k: C { n: 2 } }
    p.h.bump({ p.h = C { n: 100 }; 10 })
}

fn parentReplaced() -> Int {
    let mut p = P { h: C { n: 1 }, k: C { n: 2 } }
    p.h.bump({ p = P { h: C { n: 100 }, k: C { n: 5 } }; 10 })
}

fn elementReplaced() -> Int {
    let mut xs = Array.of(C { n: 1 }, C { n: 2 })
    xs[0].bump({ xs[1] = C { n: 100 }; 10 })
}

fn copyReset() -> Int {
    let mut a = C { n: 1 }
    a.bump({ a.reset(50) })
}

fn resourceReset() -> Int {
    let mut r = R { id: 1 }
    r.bump({ r.reset(50) })
}

fn zap(c: &mut C) -> Int {
    c = C { n: 500 }
    1
}

fn zapR(r: &mut R) -> Int {
    r = R { id: 500 }
    1
}

fn P.setH(mut self) -> Int {
    self.h = C { n: 100 }
    10
}

fn setH(p: &mut P) -> Int {
    p.h = C { n: 100 }
    10
}

type Q = resource { pub mut items Array[R], pub counter Int }

fn Q.fill(mut self) -> R {
    self.items = Array.of(R { id: 0 })
    R { id: 5 }
}

fn copyLentMut() -> Int {
    let mut a = C { n: 1 }
    a.bump(zap(&mut a))
}

fn resourceLentMut() -> Int {
    let mut r = R { id: 1 }
    r.bump(zapR(&mut r))
}

fn ancestorMethod() -> Int {
    let mut p = P { h: C { n: 1 }, k: C { n: 2 } }
    p.h.bump(p.setH())
}

fn ancestorLentMut() -> Int {
    let mut p = P { h: C { n: 1 }, k: C { n: 2 } }
    p.h.bump(setH(&mut p))
}

fn ancestorResourceMethod() -> Int {
    let mut q = Q { items: Array.of(R { id: 1 }), counter: 0 }
    q.items.push(q.fill())
    q.counter
}

type W = { pub mut h C, pub mut xs Array[C] }

fn zapW(w: &mut W) -> Int {
    w = W { h: C { n: 500 }, xs: Array.of(C { n: 1 }) }
    1
}

fn zapXs(w: &mut W) -> Int {
    w.xs = Array.of(C { n: 1000 })
    1
}

fn fieldThroughRef(w: &mut W) -> Int {
    w.h.bump(zapW(w))
}

fn elementThroughRef(w: &mut W) -> Int {
    w.xs[0].bump(zapXs(w))
}

fn wholeThroughRef(c: &mut C) -> Int {
    c.bump(zap(c))
}

fn R.peek(self, k: Int) -> Int {
    self.id + k
}

fn R.eat(move self) -> Int {
    self.id
}

type RP = resource { pub mut r R, pub n Int }

fn zapRP(p: &mut RP) -> Int {
    p.r = R { id: 500 }
    1
}

fn resourceThroughRef(p: &mut RP) -> Int {
    p.r.bump(zapRP(p))
}

fn selfResourceThroughRef(p: &mut RP) -> Int {
    p.r.peek(zapRP(p))
}

fn RP.bump(mut self, k: Int) -> Int {
    self.n + k
}

fn resourceMovedOut() -> Int {
    let mut p = RP { r: R { id: 1 }, n: 0 }
    p.bump(p.r.eat())
}

fn elementFieldReplaced(i: usize, j: usize) -> Int {
    let mut xs = Array.of(P { h: C { n: 1 }, k: C { n: 2 } })
    xs[i].h.bump({ xs[j].h = C { n: 500 }; 1 })
}

fn elementFieldReplacedResource(i: usize, j: usize) -> Int {
    let mut ps = Array.of(RP { r: R { id: 1 }, n: 0 })
    ps[i].r.bump({ ps[j].r = R { id: 600 }; 1 })
}

fn C.both(mut self, o: &mut C) -> Int {
    o = C { n: 500 }
    self.n = self.n + 1
    self.n
}

fn R.both(mut self, o: &mut R) -> Int {
    o = R { id: 500 }
    self.id = self.id + 1
    self.id
}

fn R.show(self, o: &mut R) -> Int {
    o = R { id: 500 }
    self.id
}

fn copyBothLentMut() -> Int {
    let mut c = C { n: 1 }
    c.both(&mut c)
}

fn resourceBothLentMut() -> Int {
    let mut r = R { id: 1 }
    r.both(&mut r)
}

fn fieldBothLentMut() -> Int {
    let mut p = P { h: C { n: 1 }, k: C { n: 2 } }
    p.h.both(&mut p.h)
}

fn resourceSelfLentMut() -> Int {
    let mut r = R { id: 1 }
    r.show(&mut r)
}

fn bothThroughRef(c: &mut C) -> Int {
    c.both(c)
}

fn P.both(mut self, o: &mut C) -> Int {
    o = C { n: 500 }
    self.h.n = self.h.n + 1
    self.h.n
}

fn RP.both(mut self, o: &mut R) -> Int {
    o = R { id: 500 }
    self.r.id = self.r.id + 1
    self.r.id
}

fn innerBothLentMut() -> Int {
    let mut p = P { h: C { n: 1 }, k: C { n: 2 } }
    p.both(&mut p.h)
}

fn innerResourceBothLentMut() -> Int {
    let mut p = RP { r: R { id: 1 }, n: 0 }
    p.both(&mut p.r)
}

fn innerBothThroughRef(p: &mut P) -> Int {
    p.both(&mut p.h)
}

fn otherFieldBothThroughRef(p: &mut P) -> Int {
    p.both(&mut p.k)
}

fn fieldBothThroughRef(p: &mut P) -> Int {
    p.h.both(&mut p.h)
}

fn innerResourceBothThroughRef(p: &mut RP) -> Int {
    p.both(&mut p.r)
}

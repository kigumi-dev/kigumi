-- app/t/t.kg --
import ffi from std/ffi

type Letter = alias Char

extern(C) {
    fn fill_char(p: *mut Char) -> i32 //~ ERROR
    fn read_char(p: *const Char) -> i32 //~ ERROR
    fn flag_ptr(p: *mut Bool) -> i32
    fn flag_cell(c: ffi.CValue[Bool]) -> i32 //~ ERROR
    fn char_cell(c: ffi.CValue[Char]) -> i32 //~ ERROR
    fn letter_ptr(p: *const Letter) -> i32 //~ ERROR
    fn fill_bytes(p: *mut u8, n: usize) -> i32
    fn fill_codes(p: *mut i32, n: usize) -> i32
    fn fill_ptrs(p: *mut *const u8) -> i32
    fn nested_char(p: *mut *mut Char) -> i32 //~ ERROR
    fn cell_ptr(p: *mut ffi.CValue[Char]) -> i32 //~ ERROR
}

fn cells() -> Char {
    let cv = ffi.CValue.new[Char]('k')
    cv.get()
}


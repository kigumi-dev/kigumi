-- module --
mir: planned
-- src --
type Named = {
    pub name String
    pub n Int
}

type Pt = {
    pub x Int
    pub y Int
}

// A scalar element comes back in a direct option, so first and last allocate no more than get does.
noalloc fn firstInt(a: &Array[Int]) -> Int {
    a.first() || -1
}

noalloc fn lastByte(a: &Array[u8]) -> u8 {
    a.last() || 0
}

noalloc fn getInt(a: &Array[Int]) -> Int {
    a.get(0) || -1
}

noalloc fn firstStr(a: &Array[String]) -> Bool {
    a.first() is Some(_) //~ ERROR copying `String?`
}

noalloc fn lastNamed(a: &Array[Named]) -> Bool {
    a.last() is Some(_) //~ ERROR copying `Named`
}

noalloc fn firstPt(a: &Array[Pt]) -> Bool {
    a.first() is Some(_) //~ ERROR copying `Pt`
}

// A `T: Copy` element is charged at each call; only a specialized instance hands a scalar out directly.
noalloc fn genericGet[T: Copy](xs: &Array[T]) -> T? {
    xs.get(0)
}

noalloc fn genericFirst[T: Copy](xs: &Array[T]) -> T? {
    xs.first()
}

noalloc fn genericLast[T: Copy](xs: &Array[T]) -> T? {
    xs.last()
}

noalloc fn genericThrough[T: Copy](xs: &Array[T]) -> T? {
    genericFirst(xs)
}

noalloc fn viaInt(xs: &Array[Int]) -> Int {
    (genericGet(xs) || 0) + (genericLast(xs) || 0) + (genericThrough(xs) || 0)
}

noalloc fn viaNamed(xs: &Array[Named]) -> Bool {
    genericFirst(xs) is Some(_) //~ ERROR copying `Named`
}

noalloc fn callGet(f: noalloc fn(&Array[Named]) -> Named?, xs: &Array[Named]) -> Bool {
    f(xs) is Some(_)
}

noalloc fn erasedLocal(xs: &Array[Named]) -> Bool {
    let f: noalloc fn(&Array[Named]) -> Named? = genericGet[Named] //~ ERROR `genericGet` is not `noalloc`
    f(xs) is Some(_)
}

fn erasedArg(xs: &Array[Named]) -> Bool {
    callGet(genericGet[Named], xs) //~ ERROR `genericGet` is not `noalloc`
}

noalloc fn lastStr(xs: &Array[String]) -> Bool {
    genericLast(xs) is Some(_) //~ ERROR copying `String?`
}

noalloc fn throughStr(xs: &Array[String]) -> Bool {
    genericThrough(xs) is Some(_) //~ ERROR copying `String?`
}

// A call from a noalloc body is always specialized; a fn value reaches the shared body, which boxes the Option.
noalloc fn genericAny[T: Copy](xs: &Array[T]) -> Bool {
    xs.last() is Some(_)
}

noalloc fn anyInt(xs: &Array[Int]) -> Bool {
    genericAny(xs)
}

fn plainAnyInt(xs: &Array[Int]) -> Bool {
    genericAny(xs)
}

noalloc fn viaPlain(xs: &Array[Int]) -> Bool {
    plainAnyInt(xs)
}

noalloc fn someEq[T: Copy + Eq](xs: &Array[T]) -> Bool {
    xs.last() is Some(_)
}

noalloc fn someEqInt(xs: &Array[Int]) -> Bool {
    someEq(xs)
}

fn erasedInt(xs: &Array[Int]) -> Bool {
    let f: noalloc fn(&Array[Int]) -> Bool = genericAny[Int] //~ ERROR `genericAny` is not `noalloc`
    f(xs)
}

fn erasedStr(xs: &Array[String]) -> Bool {
    let f: noalloc fn(&Array[String]) -> String? = genericLast //~ ERROR `genericLast` is not `noalloc`
    f(xs) is Some(_)
}

fn plainTarget() -> fn(&Array[Named]) -> Named? {
    genericGet[Named]
}

fn main() -> Void! {
    let a = Array.of(1, 2)
    print "${firstInt(&a)} ${getInt(&a)}"
}

-- module --
stage: driver
allocator: none
-- src --
import ffi from std/ffi
import {AllocatorHandle} from std/alloc

fn probe(h: AllocatorHandle) -> Int {
    allocator h.scope() {
        let table = ffi.HandleTable.new[Int]()
        let handle = table.insert(7)
        table.with(&handle, (v) => 1)
    }
}

fn main() -> Unit! {
    let h: AllocatorHandle? = None
    if h is Some(handle) {
        let r = probe(handle)
    }
}

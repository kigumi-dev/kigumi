-- src --
type Point = {
    pub x Int
    pub y Int
}

type Dir = North | South

interface Maker {
    noalloc fn make(self, i: Int) -> Point
    noalloc fn take(self, p: Point) -> Int
}

type Pm = {
    pub k Int
}

noalloc fn Pm.make(self, i: Int) -> Point { Point { x: i, y: self.k } }

noalloc fn Pm.take(self, p: Point) -> Int { p.x + self.k }

type Named = {
    pub name String
}

noalloc fn Named.make(self, i: Int) -> Point { Point { x: i, y: 0 } }

noalloc fn Named.take(self, p: Point) -> Int { p.y }

noalloc fn mk(i: Int) -> Point { Point { x: i, y: i } }

noalloc fn turn(d: Dir) -> Dir {
    match d {
        North -> South
        South -> North
    }
}

fn apply[T](f: fn(Int) -> T, i: Int) -> T { f(i) }

// Each call through a function value boxes the direct result its entry hands back.
noalloc fn formValue() -> Int {
    let f = mk //~ ERROR every call through this function value allocates a box for the result
    f(1).x //~ ERROR the `Point` it returns arrives in a box the callee allocates
}

noalloc fn passValue() -> Int {
    apply(mk, 2).y //~ ERROR every call through this function value allocates a box for the result
}

noalloc fn callValue(f: noalloc fn(Int) -> Point) -> Int {
    f(3).y //~ ERROR the `Point` it returns arrives in a box the callee allocates
}

// A payload-free variant's box is an immortal.
noalloc fn enumValue(f: noalloc fn(Dir) -> Dir) -> Bool {
    f(North) == South
}

noalloc fn formEnumValue() -> Dir {
    let f = turn
    f(North)
}

noalloc fn methodValue(p: Pm) -> Int {
    let f = p.make //~ ERROR constructing //~ ERROR every call through this function value allocates a box for the result
    f(1).x //~ ERROR the `Point` it returns arrives in a box the callee allocates
}

// A method table passes everything boxed.
noalloc fn viaTable(m: &Maker, p: Point) -> Int {
    m.make(1).y + m.take(p) //~ ERROR the `Point` it returns arrives in a box the callee allocates //~ ERROR handing `Point` to a slot that holds a reference allocates a box for it
}

fn inferredTable(m: &Maker, p: Point) -> Int {
    m.take(p)
}

noalloc fn callsInferred(m: &Maker, p: Point) -> Int {
    inferredTable(m, p) //~ ERROR `inferredTable` is not `noalloc`
}

fn main() -> Unit! {}

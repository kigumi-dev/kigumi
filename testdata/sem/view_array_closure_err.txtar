-- module --
stage: driver
-- src --
type View['a] = { pub data &'a Bytes, pub off usize }

fn views['a](b: &'a Bytes) -> Array[View['a]] {
    Array.of(View { data: b, off: 0 })
}

fn bytes() -> Bytes {
    Bytes.fromArray(&Array.of(1, 2, 3))
}

fn escapes() -> fn() -> usize {
    let buf = bytes()
    let vs = views(&buf)
    let f = () => vs.len()
    f
}
-- expect --
error[E1020]: `Array[View['a]]` carries a borrow and cannot be stored in a closure
  --> main.kg:14:19
   |
14 |     let f = () => vs.len()
   |                   ^^

error[E413]: closure captures `vs` (move-only) and cannot be a plain `fn`
  --> main.kg:15:5
   |
15 |     f
   |     ^
   = help: a returned closure cannot hold a move-only value; return a record that owns it and give the record a method


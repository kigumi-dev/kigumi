-- lib/lib.kg --
pub context token: String

@provides(token)
pub type Bundle = {
    pub token String
}

pub fn Bundle.wrap(t: String) -> Bundle {
    Bundle { token: t }
}

pub fn needsToken() -> String {
    token
}

pub async fn needsTokenAsync() -> String {
    token
}

pub type Thing = {
    pub mut x Int
}

pub fn Thing.needsToken(self) -> String {
    token
}

pub fn Thing.make() -> String {
    token
}

pub fn Thing.make(n: Int) -> String {
    "n"
}

pub interface Factory {
    fn make() -> String
}

pub interface Greeter {
    fn greet(self) -> String
}

pub fn Thing.greet(self) -> String {
    token
}

pub type Quiet = {}

pub fn Quiet.greet(self) -> String {
    "hi"
}

context secret: String

pub fn leaksPrivateKey() -> String { //~ ERROR public function `leaksPrivateKey` requires private context key `secret`, which callers outside its visibility cannot supply
    secret
}
-- src --
import lib from lib
import {token as myToken} from lib

fn ok() -> String {
    context (lib.Bundle.wrap("a")) {
        lib.needsToken()
    }
}

fn okAlias() -> String {
    context (lib.Bundle.wrap("a")) {
        myToken
    }
}

fn nestedOverride() -> Unit {
    context (lib.Bundle.wrap("outer")) {
        let a = lib.needsToken()
        context (lib.Bundle.wrap("inner")) {
            let b = lib.needsToken()
        }
    }
}

async fn futureKeepsCallSiteBinding() -> Unit {
    context (lib.Bundle.wrap("outer")) {
        let future = lib.needsTokenAsync()
        context (lib.Bundle.wrap("inner")) {
            let v = await future
        }
    }
}

fn fnValueReal() -> String {
    context (lib.Bundle.wrap("a")) {
        let g: fn() -> String = lib.needsToken //~ ERROR `needsToken` requires context key `token` and can't be used as a plain function value
        g()
    }
}

fn methodValueReal() -> String {
    context (lib.Bundle.wrap("a")) {
        let t = lib.Thing { x: 1 }
        let g: fn() -> String = t.needsToken //~ ERROR `needsToken` requires context key `token` and can't be used as a plain function value
        g()
    }
}

fn staticValueReal() -> String {
    context (lib.Bundle.wrap("a")) {
        let g: fn() -> String = lib.Thing.make //~ ERROR `make` requires context key `token` and can't be used as a plain function value
        g()
    }
}

fn witnessValue[T: lib.Factory]() -> fn() -> String {
    T.make //~ ERROR `T` is a type, not a value
}

fn callGreeter[T: lib.Greeter](v: T) -> String {
    v.greet()
}

fn ifaceGenericCallReal() -> String {
    context (lib.Bundle.wrap("a")) {
        let t = lib.Thing { x: 1 }
        callGreeter(t) //~ ERROR `greet` requires context key `token` and can't be used as a plain function value
    }
}

fn ifaceGenericCallNoContext() -> String {
    callGreeter(lib.Quiet {})
}

fn ifaceGenericCallUnbound() -> String {
    let t = lib.Thing { x: 1 }
    callGreeter(t) //~ ERROR `greet` requires context key `token` and can't be used as a plain function value
}

fn callBoxedGreeter(g: lib.Greeter) -> String {
    g.greet()
}

fn ifaceBoxCallReal() -> String {
    context (lib.Bundle.wrap("a")) {
        let t = lib.Thing { x: 1 }
        callBoxedGreeter(t) //~ ERROR `greet` requires context key `token` and can't be used as a plain function value
    }
}

fn ifaceBoxCallNoContext() -> String {
    callBoxedGreeter(lib.Quiet {})
}

fn unbound() -> String {
    lib.needsToken()
}

fn duplicate() -> String {
    context (lib.Bundle.wrap("a"), lib.Bundle.wrap("b")) { //~ ERROR context key `token` is already supplied by another provider in this `context (...)` list
        lib.needsToken()
    }
}

fn wrongType() -> Unit {
    context (1) { //~ ERROR `{integer}` does not declare any context keys
    }
}

fn notAKey() -> Int { 1 }

@provides(notAKey) //~ ERROR `notAKey` in `@provides` is not a `context` key declaration
pub type BadProvider = {
    pub mut notAKey Int
}


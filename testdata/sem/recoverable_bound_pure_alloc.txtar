-- module --
mir: planned
profile: recoverable-only
-- src --
interface Scaled {
    pure? fn scale(self, v: Int) -> Int
}

type Tally = {
    pub n Int
}

fn Tally.scale(self, v: Int) -> Int {
    let s = "a".concat("b")
    self.n * v
}

fn scaled[T: Scaled](g: T, n: Int) -> Int {
    g.scale(n)
}

fn main() {
    let a = scaled(Tally { n: 1 }, 3) //~ ERROR `scaled`, which calls `Tally.scale` as `Scaled.scale`
}

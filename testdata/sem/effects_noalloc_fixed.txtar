-- lib/fixed.kg --
// An inline array's set is an index store, so it allocates nothing.
noalloc fn setInPlace(n: Int) -> Int {
    let mut a = FixedArray.filled[Int, 8](n)
    let ok = a.set(3, 1)
    if ok { a[3] } else { 0 }
}

// A capture written later makes the local a cell, so set stays a call.
noalloc fn setThroughCell(n: Int) -> Int {
    let mut a = FixedArray.filled[Int, 8](n)
    let ok = a.set(3, 1) //~ ERROR `set` is not `noalloc` //~ ERROR handing `FixedArray[Int, 8]` to a slot that holds a reference allocates a box for it
    let bump = () => { a[0] = 5 } //~ ERROR constructing `closure fn() -> Unit` allocates
    bump()
    a[3]
}

// Past a page the array is boxed, so building it is a call that allocates.
noalloc fn boxedFill(n: u8) -> u8 {
    let a = FixedArray.filled[u8, 8192](n) //~ ERROR `filled` is not `noalloc`
    a[1]
}

type Point = {
    pub x Int
    pub y Int
}

// at and withMut run the callback in place; a scalar element needs no box and an Int result no allocated option.
noalloc fn atInPlace(n: Int) -> Int {
    let a = FixedArray.filled[Int, 8](n)
    a.at(3, (x: &Int) => x + 1) || 0
}

noalloc fn withMutInPlace(n: Int) -> Int {
    let mut a = FixedArray.filled[Int, 8](n)
    let _ = a.withMut(3, (x: &mut Int) => { x = x + 1 })
    a[3]
}

// A record element is boxed to be lent to the callback.
noalloc fn atBoxesRecord(n: Int) -> Int {
    let a = FixedArray.filled[Point, 8](Point { x: n, y: 1 })
    a.at(3, (p: &Point) => p.x + 1) || 0 //~ ERROR handing `Point` to a slot that holds a reference allocates a box for it
}

// An option around a heap result is built by the call.
noalloc fn atBuildsOption(n: Int) -> Int {
    let a = FixedArray.filled[Int, 8](n)
    let r = a.at(3, (x: &Int) => "s") //~ ERROR constructing `String?` allocates
    if r is Some(_) { 1 } else { 0 }
}

// Reading through a cell receiver is still in place, but withMut writes the local back, so it stays a call.
noalloc fn atThroughCell(n: Int) -> Int {
    let mut a = FixedArray.filled[Int, 8](n)
    let bump = () => { a[0] = 5 } //~ ERROR constructing `closure fn() -> Unit` allocates
    bump()
    a.at(3, (x: &Int) => x + 1) || 0
}

noalloc fn withMutThroughCell(n: Int) -> Int {
    let mut a = FixedArray.filled[Int, 8](n)
    let _ = a.withMut(3, (x: &mut Int) => { x = x + 1 }) //~ ERROR `withMut` is not `noalloc` //~ ERROR handing `FixedArray[Int, 8]` to a slot that holds a reference allocates a box for it
    let bump = () => { a[0] = 5 } //~ ERROR constructing `closure fn() -> Unit` allocates
    bump()
    a[3]
}

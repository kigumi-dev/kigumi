mir: planned
-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn Res.peek(self) -> Int {
    self.id
}

fn mkr(n: Int) -> Res {
    Res { id: n }
}

type Wrap = {
    pub mut a Res
    pub n Int
    pub xs Array[Int]
}

type Nest = {
    pub w Wrap
}

type Holder = {
    pub mut f Res
}

fn mkw() -> Wrap {
    Wrap { a: mkr(1), n: 2, xs: Array.of(1) }
}

fn take(r: Res) {}

fn show(r: &Res) {}

fn letRead() {
    let w = mkw()
    let t = w.a //~ ERROR reading `w.a` by value would copy a `Res`
}

fn letArray() {
    let w = mkw()
    let mut ys = w.xs //~ ERROR reading `w.xs` by value would copy a `Array[Int]`
    ys.push(2)
}

fn nestedRead() {
    let n = Nest { w: mkw() }
    let t = n.w.a //~ ERROR reading `n.w.a` by value would copy a `Res`
}

fn assignRead() {
    let w = mkw()
    let mut h = Holder { f: mkr(3) }
    h.f = w.a //~ ERROR reading `w.a` by value would copy a `Res`
}

fn recordLiteral() {
    let w = mkw()
    let h = Holder { f: w.a } //~ ERROR reading `w.a` by value would copy a `Res`
}

fn tupleLiteral() {
    let w = mkw()
    let t = (w.a, 1) //~ ERROR reading `w.a` by value would copy a `Res`
}

fn variantArg() {
    let w = mkw()
    let o = Some(w.a) //~ ERROR reading `w.a` by value would copy a `Res`
}

fn branchTail(c: Bool) {
    let w = mkw()
    let t = if c { w.a } else { mkr(4) } //~ ERROR reading `w.a` by value would copy a `Res`
}

fn inLoop() {
    let w = mkw()
    for i in 0..2 {
        let t = w.xs //~ ERROR reading `w.xs` by value would copy a `Array[Int]`
    }
}

fn paramRead(w: Wrap) {
    let t = w.a //~ ERROR reading `w.a` by value would copy a `Res`
}

fn callArgMoves() {
    let w = mkw()
    take(w.a)
}

fn explicitMoves() {
    let w = mkw()
    let t = move w.a
    let x = mkw()
    let h = Holder { f: move x.a }
    let y = mkw()
    let o = Some(move y.a)
}

fn borrowsAndCopies() {
    let w = mkw()
    let r = &w.a
    show(r)
    let n = w.n
    show(&w.a)
}

fn Wrap.lent(self) -> Int {
    let a = self.a
    a.peek()
}

fn temporaryField() {
    let t = mkw().a
}

type RB = {
    pub mut rs Array[Res]
    pub ns Array[Int]
}

fn forOverField() {
    let b = RB { rs: Array.of(mkr(1)), ns: Array.of(1) }
    for r in b.rs { //~ ERROR reading `b.rs` by value
        take(r)
    }
}

fn forOverFieldAccepted() {
    let b = RB { rs: Array.of(mkr(1)), ns: Array.of(1) }
    for n in b.ns {
        sayN(n)
    }
    for r in &b.rs {
        show(r)
    }
    for r in move b.rs {
        take(r)
    }
}

fn sayN(n: Int) {}

fn localAssignRead() {
    let w = mkw()
    let mut x = mkr(5)
    x = w.a //~ ERROR reading `w.a` by value would copy a `Res`
}

fn matchArmTail(c: Int) {
    let w = mkw()
    let t = match c {
        0 -> w.a //~ ERROR reading `w.a` by value would copy a `Res`
        _ -> mkr(6)
    }
}

fn tupleElemTail(c: Bool) {
    let p = (mkr(7), 1)
    let t = if c { p._0 } else { mkr(8) } //~ ERROR reading `p._0` by value would copy a `Res`
}

fn nestedTail(c: Bool) {
    let n = Nest { w: mkw() }
    let t = if c { n.w.a } else { mkr(9) } //~ ERROR reading `n.w.a` by value would copy a `Res`
}

fn argBranchTail(c: Bool) {
    let w = mkw()
    take(if c { w.a } else { mkr(10) }) //~ ERROR reading `w.a` by value would copy a `Res`
}

fn argMatchTail(c: Int) {
    let w = mkw()
    take(match c {
        0 -> w.a //~ ERROR reading `w.a` by value would copy a `Res`
        _ -> mkr(11)
    })
}

fn argBlockTail() {
    let w = mkw()
    take({ w.a }) //~ ERROR reading `w.a` by value would copy a `Res`
}

fn variantArgBranch(c: Bool) {
    let w = mkw()
    let o = Some(if c { w.a } else { mkr(12) }) //~ ERROR reading `w.a` by value would copy a `Res`
}

fn pushArgBranch(c: Bool) {
    let w = mkw()
    let mut xs: Array[Res] = Array.of()
    xs.push(if c { w.a } else { mkr(13) }) //~ ERROR reading `w.a` by value would copy a `Res`
}

fn branchTailsAccepted(c: Bool) {
    let w = mkw()
    take(if c { move w.a } else { mkr(14) })
    let v = mkw()
    let n = if c { v.n } else { 0 }
    sayN(n)
}

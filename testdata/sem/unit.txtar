-- app/t/t.kg --
// `()` is the value of type Void, the 0-tuple counterpart of `(a, b)`;
// `Void` itself stays a type name.
fn takesUnit(u: Void) {
    _ = u
}

fn ok() -> Void! {
    return Ok(())
}

fn use() -> Void! {
    let u = () //~ TYPE u : Void
    takesUnit(u)
    takesUnit(())
    ok()?
}
-- expect --

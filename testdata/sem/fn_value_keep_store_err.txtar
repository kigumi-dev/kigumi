mir: planned
-- src --
pub type V['a] = { pub s &'a String }
pub type Sink['a] = { pub mut items &'a mut Array[V['a]] }
pub type Box[F] = { pub cb F }
pub type H = { pub n Int }

fn keep['a](x: &'a String, k: Sink['a]) { k.items.push(V { s: x }) }
fn keepFirst['a](x: &'a String, k: Sink['a]) { let at = k.items.insertAt(0, V { s: x }) }
fn nop['a](x: &'a String, k: Sink['a]) { }
fn H.keepIn['a](self, x: &'a String, k: Sink['a]) { k.items.push(V { s: x }) }
async fn keepLater['a](x: &'a String, k: Sink['a]) { k.items.push(V { s: x }) }

pub fn letBound['a](k: Sink['a]) {
    let g = keep
    let loc = "local-${40 + 2}"
    g(&loc, k) //~ ERROR a borrow cannot be stored into `k` here
}

pub fn annotated['a](k: Sink['a]) {
    let g: fn(&'a String, Sink['a]) -> Void = keep
    let loc = "local-${40 + 2}"
    g(&loc, k) //~ ERROR a borrow cannot be stored into `k` here
}

pub fn aliasChain['a](k: Sink['a]) {
    let g = keep
    let h = g
    let i: fn(&'a String, Sink['a]) -> Void = h
    let loc = "local-${40 + 2}"
    i(&loc, k) //~ ERROR a borrow cannot be stored into `k` here
}

pub fn inField['a](k: Sink['a]) {
    let b = Box { cb: keep }
    let loc = "local-${40 + 2}"
    (b.cb)(&loc, k) //~ ERROR a borrow cannot be stored into `k` here
}

pub fn eitherKeeps['a](k: Sink['a], c: Bool) {
    let g = if c { keep } else { keepFirst }
    let loc = "local-${40 + 2}"
    g(&loc, k) //~ ERROR a borrow cannot be stored into `k` here
}

pub fn oneKeeps['a](k: Sink['a], c: Bool) {
    let g = if c { nop } else { keep }
    let loc = "local-${40 + 2}"
    g(&loc, k) //~ ERROR a borrow cannot be stored into `k` here
}

pub async fn asyncItem['a](k: Sink['a]) {
    let g = keepLater
    let loc = "local-${40 + 2}"
    await g(&loc, k) //~ ERROR a borrow cannot be stored into `k` here
}

pub fn methodValue['a](k: Sink['a]) {
    let h = H { n: 1 }
    let m = h.keepIn
    let loc = "local-${40 + 2}"
    m(&loc, k) //~ ERROR a borrow cannot be stored into `k` here
}

fn apply['a](f: fn(&'a String, Sink['a]) -> Void, x: &'a String, k: Sink['a]) { f(x, k) }

pub fn boundAtSite['a](k: Sink['a]) {
    let a = apply
    let loc = "local-${40 + 2}"
    a(keep, &loc, k) //~ ERROR a borrow cannot be stored into `k` here
}

pub fn inArray['a](k: Sink['a]) {
    let fs = Array.of(nop, keep)
    let loc = "local-${40 + 2}"
    fs[0](&loc, k) //~ ERROR a borrow cannot be stored into `k` here
}

fn callLoud['a](g: fn(&'a String, Sink['a]) -> Void, k: Sink['a]) {
    let loc = "local-${40 + 2}"
    g(&loc, k) //~ ERROR cannot be passed as `&'a String`
}

pub fn loudCaller['a](k: Sink['a], c: Bool) {
    let g = if c { nop } else { keep }
    callLoud(g, k)
}

pub fn localHolder() -> usize {
    let text = "t"
    let g = keep
    let mut loc = "local-${40 + 2}"
    let mut items = Array.of(V { s: &text })
    g(&loc, Sink { items: &mut items })
    loc = "x${1}" //~ ERROR `loc` is borrowed and cannot be mutated here //~ ERROR `loc` is borrowed and cannot be moved or dropped here
    items.len()
}

pub fn localEither(c: Bool) -> usize {
    let text = "t"
    let g = if c { nop } else { keep }
    let mut loc = "local-${40 + 2}"
    let mut items = Array.of(V { s: &text })
    g(&loc, Sink { items: &mut items })
    loc = "x${1}" //~ ERROR `loc` is borrowed and cannot be mutated here //~ ERROR `loc` is borrowed and cannot be moved or dropped here
    items.len()
}

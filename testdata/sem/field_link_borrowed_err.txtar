-- src --
context k: Cell

type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

type Cell = {
    pub v Res
    pub o Res?
}

fn Cell.me(self) -> &Cell {
    &self
}

type H['a] = {
    pub r &'a Cell
}

type Id = Res

type IdO = Res?

type W = {
    pub id Id
    pub io IdO
}

fn me(c: &Cell) -> &Cell {
    c
}

fn fallbackRefField['a](h: H['a], c: Bool, o: Res?, q: Result[Res, Int], n: Int?, y: Res) -> Res {
    o || h.r.v //~ ERROR reading `h.r.v` by value
}

fn handlerRefField['a](h: H['a], c: Bool, o: Res?, q: Result[Res, Int], n: Int?, y: Res) -> Res {
    q || (e) => h.r.v //~ ERROR reading `h.r.v` by value
}

fn lhsRefField['a](h: H['a], c: Bool, o: Res?, q: Result[Res, Int], n: Int?, y: Res) -> Res {
    h.r.o || y //~ ERROR reading `h.r.o` by value
}

fn ifArmRefField['a](h: H['a], c: Bool, o: Res?, q: Result[Res, Int], n: Int?, y: Res) -> Res {
    if c { h.r.v } else { y } //~ ERROR reading `h.r.v` by value
}

fn matchArmRefField['a](h: H['a], c: Bool, o: Res?, q: Result[Res, Int], n: Int?, y: Res) -> Res {
    match n {
        Some(_) -> h.r.v //~ ERROR reading `h.r.v` by value
        None -> y
    }
}

fn plainRefField['a](h: H['a], c: Bool, o: Res?, q: Result[Res, Int], n: Int?, y: Res) -> Res {
    h.r.v //~ ERROR reading `h.r.v` by value
}

fn letRefField['a](h: H['a], c: Bool, o: Res?, q: Result[Res, Int], n: Int?, y: Res) -> Res {
    let z = o || h.r.v //~ ERROR reading `h.r.v` by value
    z
}

fn retRefField['a](h: H['a], c: Bool, o: Res?, q: Result[Res, Int], n: Int?, y: Res) -> Res {
    if c {
        return o || h.r.v //~ ERROR reading `h.r.v` by value
    }
    y
}


const A: Int = 1
const B: f32 = 1.0
const A8: u8 = 7
const I16: i16 = 3
const H = 0.004

const MixedSum = A + B //~ ERROR `Int` and `f32` cannot be mixed
const MixedLess = B < A //~ ERROR `f32` and `Int` cannot be mixed
const NarrowQuo = A8 / 300 //~ ERROR `300` does not fit `u8`
const NarrowEq = A8 == 300 //~ ERROR `300` does not fit `u8`
const NarrowAnd = I16 & 16777217 //~ ERROR `16777217` does not fit `i16`
const NarrowSum = A8 + 300 //~ ERROR `300` does not fit `u8`
const TypedRem = B % 2.0 //~ ERROR no operator `%` for (f32, f32)
const UntypedRem = 5.5 % 2.0 //~ ERROR no operator `%` for (Float, Float)
const NegUnsigned = -A8 //~ ERROR unary `-` on unsigned `u8`
const ZeroAtF32: f32 = 1.0 / (1.00000001 - 1.0) //~ ERROR division by zero in a constant expression
const Overflow: f32 = (1.0e30 * 1.0e10) / 1.0e10 //~ ERROR does not fit `f32`
const NegSum: f32 = 0.5 + -(0.001 + 0.004)
const NegConst: f32 = 0.004 + (-H)

fn runtime(a: Int, b: f32, a8: u8, i16: i16) -> f32 {
    let mixedSum = a + b //~ ERROR `Int` and `f32` cannot be mixed
    let mixedLess = b < a //~ ERROR `f32` and `Int` cannot be mixed
    let narrowQuo = a8 / 300 //~ ERROR `300` does not fit `u8`
    let narrowEq = a8 == 300 //~ ERROR `300` does not fit `u8`
    let narrowAnd = i16 & 16777217 //~ ERROR `16777217` does not fit `i16`
    let narrowSum = a8 + 300 //~ ERROR `300` does not fit `u8`
    let typedRem = b % 2.0 //~ ERROR no operator `%` for (f32, f32)
    let untypedRem = 5.5 % 2.0 //~ ERROR no operator `%` for (Float, Float)
    let negUnsigned = -a8 //~ ERROR unary `-` on unsigned `u8`
    let zeroAtF32: f32 = 1.0 / (1.00000001 - 1.0) //~ ERROR division by zero in a constant expression
    let overflow: f32 = (1.0e30 * 1.0e10) / 1.0e10 //~ ERROR does not fit `f32`
    let mut rem: f32 = 5.5
    rem %= 2.0 //~ ERROR no operator `%` for (f32, f32)
    let negSum: f32 = 0.5 + -(0.001 + 0.004)
    let negConst: f32 = 0.004 + (-H)
    negSum + negConst + NegSum + NegConst
}

-- src --
type Named = {
    pub name String
    pub n Int
}

noalloc fn genericGet[T: Copy](xs: &Array[T]) -> T? {
    xs.get(0)
}

// `Named?` holds its String inline, so a call through a function value gets it from the entry's box.
noalloc fn callGet(f: noalloc fn(&Array[Named]) -> Named?, xs: &Array[Named]) -> Bool {
    f(xs) is Some(_) //~ ERROR arrives in a box the callee allocates
}

noalloc fn erasedLocal(xs: &Array[Named]) -> Bool {
    let f: noalloc fn(&Array[Named]) -> Named? = genericGet[Named] //~ ERROR allocates a box for the result
    f(xs) is Some(_) //~ ERROR arrives in a box the callee allocates
}

fn main() -> Void! {}

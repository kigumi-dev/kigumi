-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn mk(id: Int) -> Res {
    Res { id: id }
}

fn eat(r: Res) {}

type Guard = resource {
    pub a Res
}

fn Guard.drop(move self) {}

fn mkg(i: Int) -> Guard {
    Guard { a: mk(i) }
}

type Cell = {
    pub v Res
}

fn viaHandler(r: Result[Int, Int]) -> Res {
    for {
        let n = r || (e) => break mkg(e).a //~ ERROR cannot move `mkg(e).a` out of `Guard`
        break mk(n)
    }
}

fn viaCondHead(c: Bool) -> Res {
    for {
        for (if c { break mkg(2).a } else { false }) { //~ ERROR cannot move `mkg(2).a` out of `Guard`
            eat(mk(1))
        }
        break mk(0)
    }
}

fn viaInHead(c: Bool) -> Res {
    for {
        for x in (if c { break mkg(3).a } else { Array.of(1) }) { //~ ERROR cannot move `mkg(3).a` out of `Guard`
            eat(mk(x))
        }
        break mk(0)
    }
}

fn ownedHandler(c: Cell, r: Result[Int, Int]) -> Res {
    let x = for {
        let n = r || (e) => break c.v //~ ERROR reading `c.v` by value
        break mk(n)
    }
    x
}

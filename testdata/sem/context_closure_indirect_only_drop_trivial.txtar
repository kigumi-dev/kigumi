-- src --
context tok: Int

@provides(tok)
type Bundle = resource {
    tok Int
}

fn Bundle.drop(move self) -> Unit {}

fn needsTok() -> Int {
    tok
}

noalloc fn useClosure(b: Bundle) -> Int {
    context (b) {
        let f = () => { //~ ERROR constructing `closure fn() -> Int` allocates
            needsTok()
        }
        f()
    }
}

_ = useClosure(Bundle { tok: 1 })

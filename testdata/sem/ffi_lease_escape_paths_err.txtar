-- src --
import ffi from std/ffi

type Holder = { pub mut ps Array[*mut i32] }

fn paths() {
    let mut x: i32 = 7
    let mut saved = Array.empty[*mut i32]()
    let mut h = Holder { ps: Array.empty[*mut i32]() }
    ffi.withAddress(&mut x, (p: *mut i32) => { h.ps.push(p) }) //~ ERROR stores its leased pointer in `h`
    ffi.withAddress(&mut x, (p: *mut i32) => {
        let w = Some(p)
        match w {
            Some(q) -> saved.push(q), //~ ERROR stores its leased pointer in `saved`
            None -> {}
        }
    })
    ffi.withAddress(&mut x, (p: *mut i32) => {
        if let Some(q) = Some(p) {
            saved.push(q) //~ ERROR stores its leased pointer in `saved`
        }
    })
    ffi.withAddress(&mut x, (p: *mut i32) => {
        let mut tmp = Array.empty[*mut i32]()
        tmp.push(p)
        saved.push(tmp[0]) //~ ERROR stores its leased pointer in `saved`
    })
}

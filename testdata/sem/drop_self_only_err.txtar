-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {}

fn mk(id: Int) -> Res {
    Res { id: id }
}

fn eat(r: Res) {}

type G2 = resource {
    pub a Res
    pub n Int
}

fn G2.drop(move self) {
    if self.n == 1 {
        let h = G2 { a: mk(100), n: 2 }
        eat(move h.a) //~ ERROR cannot move `h.a` out of `G2`
    }
}

type G4 = resource {
    pub a Res
    pub n Int
}

fn G4.drop(move self) {
    eat(G4 { a: mk(1), n: 2 }.a) //~ ERROR cannot move `G4 { a: mk(1), n: 2 }.a` out of `G4`
}
-- expect --
error[E1021]: cannot move `h.a` out of `G2`, which defines a custom `drop`

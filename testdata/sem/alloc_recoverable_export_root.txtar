-- module --
mir: planned
profile: recoverable-only
-- src --
type Nm = {
    pub name String
    pub mut n Int
}

export(C) {
    pub fn lib_clean(n: i64) -> i64 {
        n + 1
    }

    pub fn lib_direct(n: i64) -> i64 {
        let r = Nm { name: "a", n: 1 } //~ ERROR this allocation may terminate on a refused allocation
        r.n + n
    }
}

fn main() -> Unit! {}

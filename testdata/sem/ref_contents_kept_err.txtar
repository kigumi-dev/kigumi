mir: planned
-- src --
type View['a] = {
    pub s &'a String
}

type Bag[T] = {
    pub mut items Array[T]
}

type W[T] = {
    pub v T
}

fn Bag[T: Copy].extend(mut self, src: &Array[T]) {
    for x in src {
        self.items.push(x)
    }
}

fn Bag[T: Copy].addFrom(mut self, k: &W[T]) {
    self.items.push(k.v)
}

fn addTo[T: Copy](dst: &mut Array[T], k: &W[T]) {
    dst.push(k.v)
}

fn mkStr(i: Int) -> String {
    "s${i}"
}

fn m1() -> usize {
    let name = "named"
    let mut b = Bag { items: Array.of(View { s: &name }) }
    b.extend(&Array.of(View { s: &mkStr(1) })) //~ ERROR `b` keeps a borrow of a temporary
    b.items[1].s.len()
}

fn m2() -> usize {
    let name = "named"
    let mut b = Bag { items: Array.of(View { s: &name }) }
    b.addFrom(&W { v: View { s: &mkStr(1) } }) //~ ERROR `b` keeps a borrow of a temporary
    b.items[1].s.len()
}

fn m4() -> usize {
    let name = "named"
    let mut xs = Array.of(View { s: &name })
    addTo(&mut xs, &W { v: View { s: &mkStr(1) } }) //~ ERROR `xs` keeps a borrow of a temporary
    xs[1].s.len()
}

fn m7() -> usize {
    let name = "named"
    let mut b = Bag { items: Array.of(View { s: &name }) }
    for i in 0..1 {
        let inner = "in${i}" //~ ERROR `inner` is still borrowed when its scope ends //~ ERROR `inner` is borrowed and cannot be mutated
        let w = W { v: View { s: &inner } }
        b.addFrom(&w)
    }
    b.items[1].s.len()
}

fn stringKey(xs: &mut Array[String], k: &W[String]) {
    xs.push(k.v)
}

fn plainContents() -> usize {
    let mut xs = Array.of("a")
    stringKey(&mut xs, &W { v: mkStr(2) })
    xs[1].len()
}

interface FromRef[K] {
    fn fromRef(k: &K) -> Self
}

fn View['a].fromRef(k: &'a String) -> View['a] {
    View { s: k }
}

type KBag[K, V] = {
    pub mut vs Array[V]
    pub ks Array[K]
}

fn KBag[K, V: FromRef[K]].addRef(mut self, k: &K) {
    self.vs.push(V.fromRef(k)) //~ ERROR a borrow cannot be stored into `self`
}

fn mintTo[K, V: FromRef[K]](dst: &mut Array[V], k: &K) {
    dst.push(V.fromRef(k))
}

fn witnessSelf() -> usize {
    let name = "named"
    let mut b = KBag { vs: Array.of(View { s: &name }), ks: Array.of("k") }
    b.addRef(&mkStr(1)) //~ ERROR `b` keeps a borrow of a temporary
    b.vs[1].s.len()
}

fn witnessMut() -> usize {
    let name = "named"
    let mut xs = Array.of(View { s: &name })
    mintTo(&mut xs, &mkStr(1)) //~ ERROR `xs` keeps a borrow of a temporary
    xs[1].s.len()
}

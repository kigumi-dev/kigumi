-- app/t/t.kg --
import task from std/task

async fn work() -> Int {
    0
}

fn syncRoot() -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(work())
}

fn safeFn() -> Int {
    9
}

type Holder = {
    pub mut cb fn() -> Int
}

type Wrap = {
    pub mut inner Holder
}

fn mutate(w: &mut Wrap) {
    w.inner.cb = syncRoot
}

fn copyThenWrite(w: &mut Wrap) -> Int {
    let h = w.inner
    w.inner.cb = syncRoot
    h.cb()
}

fn copyThenCallee(w: &mut Wrap) -> Int {
    let h = w.inner
    mutate(w)
    h.cb()
}

fn copyThenRestore(w: &mut Wrap) -> Int {
    let h = w.inner
    w.inner.cb = safeFn
    h.cb()
}

fn writeThenCopy(w: &mut Wrap) -> Int {
    w.inner.cb = syncRoot
    let h = w.inner
    h.cb()
}

fn calleeThenCopy(w: &mut Wrap) -> Int {
    mutate(w)
    let h = w.inner
    h.cb()
}

fn copyInLoop(w: &mut Wrap, n: Int) -> Int {
    let mut total = 0
    for i in 0..n {
        let h = w.inner
        total = total + h.cb()
        w.inner.cb = syncRoot
    }
    total
}

fn copyOnly(w: &mut Wrap) -> Int {
    let h = w.inner
    h.cb()
}

async fn okCopyThenWrite() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    copyThenWrite(&mut w)
}

async fn okCopyThenCallee() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    copyThenCallee(&mut w)
}

async fn okCallerWritesAfter() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    let r = copyThenWrite(&mut w)
    w.inner.cb = syncRoot
    r
}

async fn riskBoundBeforeRestore() -> Int {
    let mut w = Wrap { inner: Holder { cb: syncRoot } }
    copyThenRestore(&mut w) //~ ERROR cannot run inside an `async fn`
}

async fn riskWriteThenCopy() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    writeThenCopy(&mut w) //~ ERROR cannot run inside an `async fn`
}

async fn riskCalleeThenCopy() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    calleeThenCopy(&mut w) //~ ERROR cannot run inside an `async fn`
}

async fn riskCopyInLoop() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    copyInLoop(&mut w, 2) //~ ERROR cannot run inside an `async fn`
}

async fn riskCopyOnlyBoundSync() -> Int {
    let mut w = Wrap { inner: Holder { cb: syncRoot } }
    copyOnly(&mut w) //~ ERROR cannot run inside an `async fn`
}

async fn riskCallerWroteBefore() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    w.inner.cb = syncRoot
    copyThenWrite(&mut w) //~ ERROR cannot run inside an `async fn`
}

async fn okDeclaredLater() -> Int {
    let mut w = Wrap { inner: Holder { cb: safeFn } }
    laterCopy(&mut w)
}

fn laterCopy(w: &mut Wrap) -> Int {
    let h = w.inner
    w.inner.cb = syncRoot
    h.cb()
}

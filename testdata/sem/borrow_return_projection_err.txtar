-- module --
stage: driver
-- src --
type Cfg = {
    pub name String
    pub port Int
}

type View['a] = {
    pub data &'a Array[Int]
    pub own Array[Int]
}

type Two['a, 'b] = {
    pub x &'a Cfg
    pub y &'b Cfg
}

fn local['a](c: &'a Cfg) -> &'a String {
    let mine = Cfg { name: "m", port: 0 }
    &mine.name
}

fn byValue['a](c: &'a Cfg, d: Cfg) -> &'a String {
    &d.name
}

fn ownedField['a](v: &'a View['a]) -> &'a Int {
    &v.own[0]
}

fn View['a].ownFirst(self) -> &'a Int {
    &self.own[0]
}

fn otherLifetime['a, 'b](t: &'b Two['a, 'b]) -> &'a String {
    &t.y.name
}

fn wrongParam['a, 'b](c: &'a Cfg, d: &'b Cfg) -> &'a String {
    &d.name
}

fn callerMutates() {
    let mut c = Cfg { name: "a", port: 1 }
    let n = nameOf(&c)
    c = Cfg { name: "b", port: 2 }
    _ = n.len()
}

fn nameOf['a](c: &'a Cfg) -> &'a String {
    &c.name
}

fn elidedLocal(c: &Cfg) -> &String {
    let mine = Cfg { name: "m", port: 0 }
    &mine.name
}

fn Cfg.nameRef(self) -> &String {
    &self.name
}

fn receiverHeld() {
    let mut c = Cfg { name: "a", port: 1 }
    let n = c.nameRef()
    c = Cfg { name: "b", port: 2 }
    _ = n.len()
}

fn reborrowLocalAlias(c: &Cfg) -> &String {
    let l = Cfg { name: "l", port: 0 }
    let a = &l
    &a.name
}

fn reborrowOtherLifetime['a, 'b](c: &'a Cfg, d: &'b Cfg) -> &'a String {
    let a = d
    &a.name
}

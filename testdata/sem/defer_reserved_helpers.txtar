type ArrBox = {
    pub mut xs Array[Handle]
    pub mut n Int
}

type OuterBox = {
    pub mut b ArrBox
}

fn ArrBox.closeAll(move self) {
    for h in move self.xs {
        h.close()
    }
}

fn drainArrBox(b: &mut ArrBox) {
    drainHelper(&mut b.xs)
}

fn mkBox(n: Int) -> ArrBox {
    ArrBox { xs: Array.of(mkh(n), mkh(n + 1)), n: 0 }
}

fn drainFieldThroughHelper() {
    let mut b = mkBox(1)
    defer { drainHelper(&mut b.xs) }
    b.xs = Array.of(mkh(9)) //~ ERROR reserved by a cleanup
}

fn drainWholeThenAssignField() {

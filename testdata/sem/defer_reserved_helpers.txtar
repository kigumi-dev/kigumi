type Handle = resource {
    pub mut id Int
}

fn Handle.drop(move self) {}

fn Handle.close(move self) {}

fn Handle.peek(self) -> Int {
    self.id
}

fn Handle.bump(mut self) {
    self.id = self.id + 1
}

type Pack = {
    pub mut inner Handle
    pub mut other Handle
    pub mut n Int
}

fn mkh(n: Int) -> Handle {
    Handle { id: n }
}

fn mk(n: Int) -> Pack {
    Pack { inner: mkh(n), other: mkh(n + 1), n: 0 }
}

fn closeAll(xs: Array[Handle]) {}

fn closePacks(xs: Array[Pack]) {}

fn takePack(b: Pack) {}

fn tweak(p: &mut Handle) {
    p.id = p.id + 10
}

fn tweakTwice(p: &mut Handle) {
    tweak(p)
    tweak(p)
}

fn tweakViaMethod(p: &mut Handle) {
    p.bump()
}

fn tweakRecursive(p: &mut Handle, n: Int) {
    if n > 0 {
        tweakRecursive(p, n - 1)
    }
    p.id = p.id + 1
}

fn tweakShared(p: &mut Handle) {
    p.id = p.peek()
}

fn replace(p: &mut Handle) {
    p = mkh(9)
}

fn replaceViaHelper(p: &mut Handle) {
    replace(p)
}

fn replaceViaMethod(p: &mut Handle) {
    p.rebind()
}

fn Handle.rebind(mut self) {
    replace(&mut self)
}

fn bumpN(p: &mut Pack) {
    p.n = p.n + 1
}

fn replaceInner(p: &mut Pack) {
    p.inner = mkh(7)
}

fn mutual(p: &mut Handle, n: Int) {
    if n > 0 {
        mutualBack(p, n - 1)
    }
}

fn mutualBack(p: &mut Handle, n: Int) {
    p.id = n
    mutual(p, n)
}

fn helperWholeAccept() {
    let mut h = mkh(1)
    defer { h.close() }
    tweak(&mut h)
    tweakTwice(&mut h)
    tweakViaMethod(&mut h)
    tweakRecursive(&mut h, 2)
    tweakShared(&mut h)
    mutual(&mut h, 3)
}

fn helperFieldAccept() {
    let mut b = mk(1)
    defer { b.inner.close() }
    bumpN(&mut b)
    tweak(&mut b.other)
}

fn helperWholeReject() {
    let mut h = mkh(1)
    defer { h.close() }
    replace(&mut h) //~ ERROR cannot be borrowed mutably
    replaceViaHelper(&mut h) //~ ERROR cannot be borrowed mutably
    replaceViaMethod(&mut h) //~ ERROR cannot be borrowed mutably
}

fn helperFieldReject() {
    let mut b = mk(1)
    defer { b.inner.close() }
    replaceInner(&mut b) //~ ERROR cannot be borrowed mutably
}

fn helperBeforeCleanup() {
    let mut h = mkh(1)
    replace(&mut h)
    defer { h.close() }
}

fn forConsumes() {
    let mut xs = Array.of(mkh(1))
    defer {
        for h in xs {
            h.close()
        }
    }
    xs = Array.of(mkh(2)) //~ ERROR cannot be assigned
}


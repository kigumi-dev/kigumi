    overT(&mut h) //~ ERROR cannot be borrowed mutably
}

type Slot = {
    pub mut o Handle?
}

fn Slot.empty(mut self) {
    match self.o.take() {
        Some(h) -> h.close()
        None -> {}
    }
}

fn drainArray() {
    let mut xs = Array.of(mkh(1), mkh(2))
    defer {
        for xs.len() > 0 {
            match xs.takeAt(0) {
                Some(h) -> h.close()
                None -> {}
            }
        }
    }
    xs.push(mkh(3))
    xs = Array.of(mkh(4)) //~ ERROR reserved by a cleanup
}

fn drainViaMethod() {
    let mut s = Slot { o: Some(mkh(1)) }
    defer { s.empty() }
    s = Slot { o: None } //~ ERROR reserved by a cleanup
}

fn drainOption() {
    let mut o = Some(mkh(1))
    defer {
        match o.take() {
            Some(h) -> h.close()
            None -> {}
        }
    }
    o = None //~ ERROR reserved by a cleanup
}

fn drainField() {
    let mut s = Slot { o: Some(mkh(1)) }
    defer {
        match s.o.take() {
            Some(h) -> h.close()
            None -> {}
        }
    }
    s.o = None //~ ERROR reserved by a cleanup
}


}

fn addOne(p: &mut Pack) {
    p.n = p.n + 1
}

fn viaShadowLocal(p: &mut Pack) {
    let addOne = (q: &mut Pack) => { q.inner = mkh(1) }
    addOne(p)
}

fn viaShadowParam(addOne: fn(&mut Pack) -> Void, p: &mut Pack) {

fn gen[T](p: &mut T) {}

fn setIt(p: &mut Handle, v: Handle) {
    p = v
}

fn genSet[T](p: &mut T, v: T) {
    p = v
}

fn over(p: &mut Handle) {
    p.id = 1
}

fn over(p: &mut Handle, n: Int) {
    p = mkh(n)
}

fn overT(p: &mut Handle) {
    p.id = 1
}

fn overT(p: &mut Pack) {
    p.n = 1
}

fn helperShapesAccept() {
    let mut h = mkh(1)
    let mut b = mk(2)
    defer { h.close() }
    defer { b.inner.close() }
    gen(&mut h)
    over(&mut h)
}


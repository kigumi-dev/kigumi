    let hn = Hn { n: 1 }
    let rb: R0['a, fn(&'a String, Sink['a]) -> Void] = R0 { cb: keep, k: k2 }
    callIt(hn.measure, rb) //~ ERROR cannot be erased
}
pub fn calleeBuilds['a](k2: Sink['a]) -> usize {
    let hn = Hn { n: 1 }
    callOwn(hn.measure, k2) //~ ERROR cannot be erased

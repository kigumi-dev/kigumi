-- module --
mir: planned
-- src --
import task from std/task

type Box = { pub f fn(&String) -> Future[usize] }

async fn lenOf(s: &String) -> usize {
    s.len()
}

fn one[U](items: &Array[String], f: fn(&String) -> U) -> U {
    f(&items[0])
}

fn conc(f: fn(&String) -> Future[usize], items: &Array[String]) -> Future[usize] {
    f(&items[0])
}

fn concOut(out: &mut Future[usize], f: fn(&String) -> Future[usize], items: &Array[String]) {
    out = f(&items[0])
}

fn viaRec(b: &Box, items: &Array[String]) -> Future[usize] {
    (b.f)(&items[0])
}

fn run(f: Future[usize]) -> usize {
    task.currentThreadExecutor().runToCompletion(f)
}

fn reassignGeneric() -> usize {
    let k = "k"
    let mut items = Array.of("i1")
    let mut fu = lenOf(&k)
    fu = one(&items, lenOf)
    items = Array.of("zz") //~ ERROR `items` is borrowed and cannot be mutated //~ ERROR `items` is borrowed and cannot be moved
    run(fu)
}

fn reassignDirect() -> usize {
    let k = "k"
    let mut items = Array.of("i1")
    let mut fu = lenOf(&k)
    fu = lenOf(&items[0])
    items = Array.of("zz") //~ ERROR `items` is borrowed and cannot be mutated //~ ERROR `items` is borrowed and cannot be moved
    run(fu)
}

fn reassignBranch(go: Bool) -> usize {
    let k = "k"
    let mut items = Array.of("i1")
    let mut fu = lenOf(&k)
    if go {
        fu = one(&items, lenOf)
    }
    items = Array.of("zz") //~ ERROR `items` is borrowed and cannot be mutated //~ ERROR `items` is borrowed and cannot be moved
    run(fu)
}

fn reassignLoop() -> usize {
    let k = "k"
    let mut items = Array.of("i1")
    let mut fu = lenOf(&k)
    for i in 0..2 {
        fu = lenOf(&items[0])
    }
    items = Array.of("zz") //~ ERROR `items` is borrowed and cannot be mutated //~ ERROR `items` is borrowed and cannot be moved
    run(fu)
}

fn localValue() -> usize {
    let mut items = Array.of("i1")
    let f = lenOf
    let fu = f(&items[0])
    items = Array.of("zz") //~ ERROR `items` is borrowed and cannot be mutated //~ ERROR `items` is borrowed and cannot be moved
    run(fu)
}

fn concreteParam() -> usize {
    let mut items = Array.of("i1")
    let fu = conc(lenOf, &items)
    items = Array.of("zz") //~ ERROR `items` is borrowed and cannot be mutated //~ ERROR `items` is borrowed and cannot be moved
    run(fu)
}

fn concreteOut() -> usize {
    let k = "k"
    let mut items = Array.of("i1")
    let mut fu = lenOf(&k)
    concOut(&mut fu, lenOf, &items)
    items = Array.of("zz") //~ ERROR `items` is borrowed and cannot be mutated //~ ERROR `items` is borrowed and cannot be moved
    run(fu)
}

fn recordField() -> usize {
    let mut items = Array.of("i1")
    let b = Box { f: lenOf }
    let fu = viaRec(&b, &items)
    items = Array.of("zz") //~ ERROR `items` is borrowed and cannot be mutated //~ ERROR `items` is borrowed and cannot be moved
    run(fu)
}

fn main() {
    print "${reassignGeneric()} ${reassignDirect()} ${reassignBranch(true)} ${reassignLoop()}"
    print "${localValue()} ${concreteParam()} ${concreteOut()} ${recordField()}"
}

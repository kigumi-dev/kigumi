type R = resource { pub mut id Int }

fn R.drop(move self) {}

type H = resource { pub mut r R, pub n Int }

fn H.drop(move self) {}

fn mko(i: Int) -> H? {
    if i > 0 { Some(H { r: R { id: i }, n: i }) } else { None }
}

fn flag() -> Bool {
    true
}

fn kept() -> Int {
    let k = match &mko(4)?.r {
        Some(r) -> r
        None -> return 0
    }
    k.id
}

fn keptIfLet() -> Int {
    let k = if let Some(r) = &mko(4)?.r { r } else { return 0 }
    k.id
}

fn behindAnd() -> Int {
    if flag() && &mko(4)?.r is Some(r) {
        return r.id
    }
    0
}

fn letKept() -> Int {
    let z = &mko(5)?.r
    match z {
        Some(r) -> r.id
        None -> 0
    }
}

fn letKeptScalar() -> Int {
    let z = &mko(5)?.n
    match z {
        Some(n) -> n
        None -> 0
    }
}

type W = { pub h H? }

fn letKeptChain() -> Int {
    let z = &W { h: mko(6) }.h?.r
    match z {
        Some(r) -> r.id
        None -> 0
    }
}

type P = { pub a Int, pub b Int }

type G = resource { pub n Int, pub p P }

fn G.drop(move self) {}

fn mkg(i: Int) -> G? {
    if i > 0 { Some(G { n: i, p: P { a: i, b: i } }) } else { None }
}

fn letKeptLocal() -> Int {
    let x = mkg(5)
    let z = &x?.n
    match z {
        Some(n) -> n
        None -> 0
    }
}

fn letKeptLocalRecord() -> Int {
    let x = mkg(5)
    let z = &x?.p
    match z {
        Some(p) -> p.a
        None -> 0
    }
}

fn letKeptRef(x: &G?) -> Int {
    let z = &x?.n
    match z {
        Some(n) -> n
        None -> 0
    }
}

fn letKeptBlock(x: &G?) -> Int {
    let z = &{ x?.n }
    match z {
        Some(n) -> n
        None -> 0
    }
}

fn letKeptIf(x: &G?, c: Bool) -> Int {
    let z = &(if c { x?.n } else { x?.n })
    match z {
        Some(n) -> n
        None -> 0
    }
}

fn letKeptMatch(x: &G?, c: Bool) -> Int {
    let z = &match c {
        true -> mkg(1)
        false -> mkg(2)
    }
    match z {
        Some(g) -> g.n
        None -> 0
    }
}

fn letBlockLocal(x: &G?) -> Int {
    let y = mkg(3)
    let z = &{ y }
    match z {
        Some(g) -> g.n
        None -> 0
    }
}

-- src --
fn g() -> Int! { 1 }
fn f(x: Int = g()?) -> Int { x }
async fn h2() -> Int { 1 }
async fn h(x: Int = await h2()) -> Int { x } //~ ERROR `await` cannot be used in a default argument
async fn k(x: Int) -> Int { await h2() + x }
fn use() {
    let a = f() //~ ERROR `?` requires a `Result` return type
}

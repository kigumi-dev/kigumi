-- src --
fn wrap[E: Error](e: E) -> Error {
    e //~ ERROR `E` is a type parameter bounded by `Error`
}

type Bad = {
    pub code Int
}

fn Bad.message(self) -> String {
    "bad ${self.code}"
}

fn concrete(b: Bad) -> Error {
    b
}

fn plain(n: Int) -> Error {
    n //~ ERROR `Int` does not conform to `Error`
}

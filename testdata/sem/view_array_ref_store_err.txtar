-- module --
stage: driver
-- src --
type View['a] = { pub data &'a Array[Int], pub off usize }

fn View['a].at(self) -> Int { self.data[self.off] }

type Doc['a] = { pub mut views Array[View['a]] }

fn Doc['a].add(mut self, v: View['a]) { self.views.push(v) }

fn short() -> Int {
    let a = Array.of(1, 2, 3)
    let mut o = Array.of(View { data: &a, off: 0 })
    let r = &mut o
    {
        let b = Array.of(4)
        r.push(View { data: &b, off: 0 })
    }
    o[1].at()
}

fn shortBinding() -> usize {
    let a = Array.of(1, 2, 3)
    let mut opt = Some(Doc { views: Array.of(View { data: &a, off: 0 }) })
    {
        let b = Array.of(4)
        if let Some(d) = &mut opt { d.add(View { data: &b, off: 0 }) }
    }
    if let Some(d) = &opt { d.views.len() } else { 0 }
}

fn shortField() -> usize {
    let mut doc = Doc { views: Array.empty() }
    {
        let b = Array.of(4)
        let d = &mut doc
        let vs = &mut d.views
        vs.push(View { data: &b, off: 0 })
    }
    doc.views.len()
}

fn mutated() -> Int {
    let mut a = Array.of(1, 2, 3)
    let mut o = Array.of(View { data: &a, off: 0 })
    let r = &mut o
    r.push(View { data: &a, off: 1 })
    a = Array.of(9)
    o[0].at()
}

fn pick['a](d: &'a mut Array[View['a]]) -> &'a mut Array[View['a]] { d }

fn viaCall() -> Int {
    let mut a = Array.of(1, 2, 3)
    let b = Array.of(5)
    let mut o = Array.of(View { data: &b, off: 0 })
    let r = pick(&mut o)
    r.push(View { data: &a, off: 1 })
    a = Array.of(9)
    o[1].at()
}

let n = viaCall()

-- lib/fv.kg --
pub context token: String

pub fn say[T](x: T) -> String {
    token
}

pub fn zeroLen[const N: usize]() -> usize { N }

pub fn lenOf[T, const N: usize](a: &FixedArray[T, N]) -> usize { N }

pub fn plain[T](x: T) -> T { x }

pub type Box[T] = {
    pub v T
}

pub fn Box[T].eqv[U: Eq](self, o: U, p: U) -> Bool { o == p }

pub async fn sameLater[T: Eq](a: T, b: T) -> Bool { a == b }

pub type Ticket = resource {
    pub id Int
}

pub fn Ticket.same[U: Eq](self, a: U, b: U) -> Bool { a == b }

pub async fn Box[T].laterEq[U: Eq](self, a: U, b: U) -> Bool { a == b }

pub fn use() -> Unit {
    let a = say[Int] //~ ERROR `say` requires context key `token`
    let b = zeroLen[4] //~ ERROR `zeroLen` has const generic parameters
    let c = lenOf[Int, 3] //~ ERROR `lenOf` has const generic parameters
    let d = FixedArray.filled[Int, 3] //~ ERROR `filled` has const generic parameters
    let e = plain[Int] //~ TYPE e : fn(Int) -> Int
    let arr = FixedArray.filled[Int, 3](1)
    let f = arr.len //~ ERROR `len` has const generic parameters
    let box = Box { v: 1 }
    let g: fn(Int, Int) -> Bool = box.eqv //~ TYPE g : fn(Int, Int) -> Bool
    let h = sameLater[Int] //~ TYPE h : fn(Int, Int) -> Future[Bool]
    let t = Ticket { id: 1 }
    let tv: fn(Int, Int) -> Bool = t.same //~ ERROR cannot form a method value on move-only
    let lv: fn(Int, Int) -> Future[Bool] = box.laterEq //~ TYPE lv : fn(Int, Int) -> Future[Bool]
}

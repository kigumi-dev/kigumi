-- module --
blocking: single-thread-event-loop
-- src --
import fs from std/fs
import task from std/task

// Without worker threads the pool runs the closure on the caller, so the read still blocks it.
async fn useProvider() -> Result[String, task.BlockingError] { //~ ERROR reaches a direct-blocking operation
    let pool = task.BlockingPool.new(4)
    let fut = pool.run(() => {
        host.files().read(fs.Path.fromString("x").unwrap()).unwrap()
    })?
    await fut
}

fn readerCall(items: &mut Array[String]) -> String {
    let u = mkV(&items[0])
    let n = rd(items) //~ ERROR `items` is borrowed and cannot be mutated
    showVR(&u, churn() + (n.toInt() || 0))
}

fn pushLocalTie[U](items: &mut Array[String], f: fn(&String) -> U, g: fn(&U, Int) -> String) -> String {
    let mut out: Array[U] = Array.empty()
    out.push(f(&items[0]))
    items = Array.of("q") //~ ERROR `items` is borrowed and cannot be mutated

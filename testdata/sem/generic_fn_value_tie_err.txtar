}

fn fieldLocalTie[U](items: &mut Array[String], f: fn(&String) -> U, g: fn(&U, Int) -> String) -> String {
    let mut h = Box3 { v: f(&items[1]) }
    h.v = f(&items[0])
    items = Array.of("q") //~ ERROR `items` is borrowed and cannot be mutated
    g(&h.v, churn())
}

fn literalLocalTie[U](items: &mut Array[String], f: fn(&String) -> U, g: fn(&U, Int) -> String) -> String {
    let h = Box3 { v: f(&items[0]) }
    let o = Some(f(&items[1]))
    let a = Array.of(f(&items[0]))
    items = Array.of("q") //~ ERROR `items` is borrowed and cannot be mutated
    g(&h.v, churn())
}

fn setLocalTie[U](items: &mut Array[String], f: fn(&String) -> U, g: fn(&U, Int) -> String) -> String {
    let mut out = Array.of(f(&items[1]))
    out[0] = f(&items[0])
    items.push("q") //~ ERROR `items` is borrowed and cannot be mutated

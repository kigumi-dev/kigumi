}

fn keepLocalTie[U](items: &mut Array[String], f: fn(&String) -> U, g: fn(&U, Int) -> String) -> String {
    let mut out: Array[U] = Array.empty()
    out.push(f(&items[0]))
    g(&out[0], churn())

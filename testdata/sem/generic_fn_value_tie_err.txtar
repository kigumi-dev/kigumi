fn returnLocalTie[U](items: &mut Array[String], f: fn(&String) -> U) -> Array[U] {
    let mut out: Array[U] = Array.empty()
    out.push(f(&items[0]))
    out
}

fn dropHeld[U](xs: &mut Array[String], f: fn(&String) -> U) {
    let u = f(&xs[0])
    xs.push("x") //~ ERROR `xs` is borrowed and cannot be mutated
}


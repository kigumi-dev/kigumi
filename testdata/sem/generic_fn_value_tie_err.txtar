type V['a] = { pub s &'a String }
type B['a] = { pub b &'a Bytes }
fn churn() -> Int {
    let mut arr: Array[String] = Array.of("x")
    for i in 100..3000 {
        arr.push("w${i}")
    }
    arr.len().toInt() || 0
}
fn mkV['a](s: &'a String) -> V['a] { V { s: s } }
fn mkB['a](b: &'a Bytes) -> B['a] { B { b: b } }
fn lastV['a](acc: V['a], s: &'a String) -> V['a] { V { s: s } }
fn showR['a](v: &V['a], k: Int) -> String { "${v.s.len()} ${v.s}" }
fn collect[U](items: &Array[String], f: fn(&String) -> U) -> Array[U] {
    let mut out: Array[U] = Array.empty()
    for s in items {
        out.push(f(s))
    }
    out
}
fn collectNested[U](items: &Array[Array[String]], f: fn(&String) -> U) -> Array[U] {
    let mut out: Array[U] = Array.empty()
    for row in items {
        for s in row {
            out.push(f(s))
        }
    }
    out
}
fn collectBytes[U](items: &Array[Bytes], f: fn(&Bytes) -> U) -> Array[U] {
    let mut out: Array[U] = Array.empty()
    for b in items {
        out.push(f(b))
    }
    out
}
fn putV[U](out: &mut U, items: &Array[String], f: fn(&String) -> U) {
    for s in items {
        out = f(s)
    }
}
fn foldItems[A](items: &Array[String], init: A, step: fn(A, &String) -> A) -> A {
    let mut acc = init
    for s in items {
        acc = step(acc, s)
    }
    acc
}
fn one[U](items: &Array[String], f: fn(&String) -> U) -> U {
    f(&items[0])
}
fn collectAssign() -> String {
    let mut items = Array.of("a${churn()}", "bcd")
    let c = collect(&items, mkV)
    items = Array.of("zzz") //~ ERROR `items` is borrowed and cannot be mutated //~ ERROR `items` is borrowed and cannot be moved
    showR(&c[0], churn())
}
fn collectPush() -> String {
    let mut items = Array.of("a${churn()}", "bcd")
    let c = collect(&items, mkV)
    items.push("x${churn()}") //~ ERROR `items` is borrowed and cannot be mutated
    showR(&c[0], churn())
}
fn putAssign() -> String {
    let base = "q"
    let mut items = Array.of("a${churn()}", "bcd")
    let mut out = mkV(&base)
    putV(&mut out, &items, mkV)
    items = Array.of("zzz") //~ ERROR `items` is borrowed and cannot be mutated //~ ERROR `items` is borrowed and cannot be moved
    showR(&out, churn())
}
fn foldAssign() -> String {
    let base = "q"
    let mut items = Array.of("a${churn()}", "bcd")
    let r = foldItems(&items, mkV(&base), lastV)
    items = Array.of("zzz") //~ ERROR `items` is borrowed and cannot be mutated //~ ERROR `items` is borrowed and cannot be moved
    showR(&r, churn())
}
fn nestedAssign() -> String {
    let mut items = Array.of(Array.of("a${churn()}", "bcd"))
    let c = collectNested(&items, mkV)
    items = Array.of(Array.of("zzz")) //~ ERROR `items` is borrowed and cannot be mutated //~ ERROR `items` is borrowed and cannot be moved
    showR(&c[0], churn())
}
fn bytesAssign() -> usize {
    let mut items = Array.of(Bytes.fromArray(&Array.of(1, 2, 3)))
    let c = collectBytes(&items, mkB)
    items = Array.of(Bytes.fromArray(&Array.of(9))) //~ ERROR `items` is borrowed and cannot be mutated //~ ERROR `items` is borrowed and cannot be moved
    c[0].b.len()
}
fn oneAssign() -> String {
    let mut items = Array.of("a${churn()}", "bcd")
    let v = one(&items, mkV)
    items = Array.of("zzz") //~ ERROR `items` is borrowed and cannot be mutated //~ ERROR `items` is borrowed and cannot be moved
    showR(&v, churn())
}
type P = { pub name String, pub age Int }

type Pn = { pub name String, pub n Int }

type Pt = { pub x Int, pub y Int }

fn nameOf(p: &P) -> &String {
    &p.name
}

fn lenOf(s: &String) -> usize {
    s.len()
}

fn apply[U](p: &P, f: fn(&P) -> U, g: fn(U) -> usize) -> usize {
    g(f(p))
}

fn mapPn[U](items: &Array[Pn], f: fn(&String) -> U) -> Array[U] {
    let mut out: Array[U] = Array.empty()
    for p in items {
        out.push(f(&p.name))
    }
    out
}

fn recName[U](out: &mut U, items: &Array[Pn], f: fn(&String) -> U) {
    for p in items {
        out = f(&p.name)
    }
}

fn okNested2[U](out: &mut Array[U], items: &Array[String?], f: fn(&String) -> U) {
    for o in items {
        match o {
            Some(s) -> out.push(f(&s))
            None -> {}
        }
    }
}

fn ptX[U](out: &mut U, items: &Array[Pt], f: fn(&Int) -> U) {
    for p in items {
        out = f(&p.x) //~ ERROR cannot be stored through `out`
    }
}

fn readOnly() -> String {
    let items = Array.of("a", "bcd")
    let c = collect(&items, mkV)
    let p = P { name: "abc", age: 3 }
    let people = Array.of(P { name: "a", age: 1 }, P { name: "bc", age: 2 })
    let names = people.map(nameOf)
    "${showR(&c[1], 0)} ${apply(&p, nameOf, lenOf)} ${names.len()} ${names[1]}"
}

fn mapThenPush() -> String {
    let mut people = Array.of(P { name: "a", age: 1 })
    let names = people.map(nameOf)
    people.push(P { name: "z", age: 9 }) //~ ERROR `people` is borrowed and cannot be mutated
    "${names[0]}"
}

type Hold[U] = { pub f fn(&String) -> U }

type Bag2[T] = { pub mut xs Array[T] }

fn useHold[U](items: &Array[String], h: Hold[U]) -> Array[U] {
    collect(items, h.f)
}

async fn waitIt() -> Int {
    1
}

fn viaArray() -> String {
    let mut items = Array.of("a${churn()}", "bcd")
    let fs = Array.of(mkV)
    let c = collect(&items, fs[0])
    items = Array.of("zzz") //~ ERROR `items` is borrowed and cannot be mutated //~ ERROR `items` is borrowed and cannot be moved
    showR(&c[0], churn())
}

fn viaField() -> String {
    let mut items = Array.of("a${churn()}", "bcd")
    let h = Hold { f: mkV }
    let c = collect(&items, h.f)
    items.push("x") //~ ERROR `items` is borrowed and cannot be mutated
    showR(&c[0], churn())
}

fn viaCallee() -> String {
    let mut items = Array.of("a${churn()}", "bcd")
    let h = Hold { f: mkV }
    let c = useHold(&items, h)
    items = Array.of("zzz") //~ ERROR `items` is borrowed and cannot be mutated //~ ERROR `items` is borrowed and cannot be moved
    showR(&c[0], churn())
}

async fn viaAwait() -> String {
    let mut items = Array.of("a${churn()}", "bcd")
    let fs = Array.of(mkV)
    let c = collect(&items, fs[0])
    let k = await waitIt() //~ ERROR a borrow of `items` is still live across this `await`
    items = Array.of("zzz") //~ ERROR `items` is borrowed and cannot be mutated //~ ERROR `items` is borrowed and cannot be moved
    showR(&c[0], churn() + k)
}

fn lenField() -> usize {
    let mut items = Array.of("a${churn()}", "bcd")
    let h = Hold { f: lenOf }
    let c = collect(&items, h.f)
    items = Array.of("zzz")
    c[0]
}

fn writeAfter[U](items: &mut Array[String], f: fn(&String) -> U, show: fn(&U, Int) -> String) -> String {
    let s = &items[0]
    let u = f(s)
    items = Array.of("zzz${churn()}") //~ ERROR `items` is borrowed and cannot be mutated
    show(&u, churn())
}

fn Bag2[T].writeSelf[U](mut self, f: fn(&T) -> U, show: fn(&U, Int) -> String) -> String {
    let u = f(&self.xs[0])
    self.xs = Array.empty() //~ ERROR `self` is borrowed and cannot be mutated
    show(&u, churn())
}

fn readMut[U](items: &mut Array[String], f: fn(&String) -> U) -> U {
    let s = &items[0]
    let n = items.len()
    f(s)
}

fn readMut2[U](items: &mut Array[String], f: fn(&String) -> U, show: fn(&U, Int) -> String) -> String {
    let u = f(&items[0])
    show(&u, items.len().toInt() || 0)
}

fn showVR['a](v: &V['a], k: Int) -> String {
    "${v.s.len()} ${v.s}"
}

fn fwdLocal[U](f: fn(&String) -> U, show: fn(&U, Int) -> String) -> String {
    let mut items = Array.of("aa${churn()}", "bbb")
    let rs = collect(&items, f)
    items = Array.of("q") //~ ERROR `items` is borrowed and cannot be mutated //~ ERROR `items` is borrowed and cannot be moved
    show(&rs[0], churn())
}

fn fwdKeep[U](f: fn(&String) -> U, show: fn(&U, Int) -> String) -> String {
    let items = Array.of("aa${churn()}", "bbb")
    let rs = collect(&items, f)
    show(&rs[0], churn())
}

fn fwdParam[U](items: &Array[String], f: fn(&String) -> U) -> Array[U] {
    collect(items, f)
}

fn collectMut[U](items: &mut Array[String], f: fn(&String) -> U) -> Array[U] {
    collect(&items[0..1], f)
}

fn fwdMut[U](items: &mut Array[String], f: fn(&String) -> U) -> Array[U] {
    collectMut(items, f)
}

fn fwdMutWrite[U](items: &mut Array[String], f: fn(&String) -> U, show: fn(&U, Int) -> String) -> String {
    let rs = collectMut(items, f)
    items = Array.of("q") //~ ERROR `items` is borrowed and cannot be mutated
    show(&rs[0], churn())
}

fn fwdLen(f: fn(&String) -> usize) -> usize {
    let mut items = Array.of("aa", "bbb")
    let rs = collect(&items, f)
    items = Array.of("q")
    rs[0]
}

fn rep(items: &mut Array[String]) {
    items = Array.of("zz${churn()}")
}

fn passOn(items: &mut Array[String]) -> String {
    let u = mkV(&items[0])
    rep(items) //~ ERROR `items` is borrowed and cannot be mutated
    showVR(&u, churn())
}

fn passOnGeneric[U](items: &mut Array[String], f: fn(&String) -> U, show: fn(&U, Int) -> String) -> String {
    let u = f(&items[0])
    rep(items) //~ ERROR `items` is borrowed and cannot be mutated
    show(&u, churn())
}

fn passFirst(items: &mut Array[String]) -> String {
    rep(items)
    let u = mkV(&items[0])
    showVR(&u, churn())
}

type Box3[U] = { pub mut v U }

fn rd(items: &mut Array[String]) -> usize {
    items.len()
}

fn viaClosureCall(items: &mut Array[String]) -> String {
    let u = mkV(&items[0])
    let h = (a: &mut Array[String]) => { rep(a) }
    h(items) //~ ERROR `items` is borrowed and cannot be mutated

-- lib/s.kg --
@section("ok.section")
static good: u32 = 0

@section("") //~ ERROR takes exactly one nonempty string literal
static empty: u32 = 0

@section("bad\"quote") //~ ERROR cannot be written in LLVM IR
static quote: u32 = 0

@section("bad\ttab") //~ ERROR cannot be written in LLVM IR
static tab: u32 = 0

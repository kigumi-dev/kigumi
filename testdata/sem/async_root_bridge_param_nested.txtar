-- app/t/t.kg --
import task from std/task

async fn work() -> Int {
    0
}

fn syncRoot() -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(work())
}

fn safeFn() -> Int {
    9
}

type Holder = {
    pub cb fn() -> Int
}

type Wrap = {
    pub inner Holder
}

type Deep = {
    pub wrap Wrap
}

fn mkWrapRisky() -> Wrap {
    Wrap { inner: Holder { cb: syncRoot } }
}

fn mkWrapSafe() -> Wrap {
    Wrap { inner: Holder { cb: safeFn } }
}

fn callH(h: Holder) -> Int {
    h.cb()
}

fn viaDirect(w: Wrap) -> Int {
    w.inner.cb()
}

fn viaLocal(w: Wrap) -> Int {
    let h = w.inner
    h.cb()
}

fn viaForward(w: Wrap) -> Int {
    callH(w.inner)
}

fn viaForward2(d: Deep) -> Int {
    viaForward(d.wrap)
}

fn viaDeep(d: Deep) -> Int {
    d.wrap.inner.cb()
}

fn viaLocalChain(d: Deep) -> Int {
    let w = d.wrap
    let h = w.inner
    h.cb()
}

async fn riskyLiteral() -> Int {
    viaDirect(Wrap { inner: Holder { cb: syncRoot } }) //~ ERROR cannot run inside an `async fn`
}

async fn safeLiteral() -> Int {
    viaDirect(Wrap { inner: Holder { cb: safeFn } })
}

async fn riskyLocalArg() -> Int {
    let w = Wrap { inner: Holder { cb: syncRoot } }
    viaLocal(w) //~ ERROR cannot run inside an `async fn`
}

async fn safeLocalArg() -> Int {
    let w = Wrap { inner: Holder { cb: safeFn } }
    viaLocal(w)
}

async fn riskyCallArg() -> Int {
    viaLocal(mkWrapRisky()) //~ ERROR cannot run inside an `async fn`
}

async fn safeCallArg() -> Int {
    viaLocal(mkWrapSafe())
}

async fn riskyForward() -> Int {
    viaForward(Wrap { inner: Holder { cb: syncRoot } }) //~ ERROR cannot run inside an `async fn`
}

async fn safeForward() -> Int {
    viaForward(Wrap { inner: Holder { cb: safeFn } })
}

async fn riskyForwardLocal() -> Int {
    let w = Wrap { inner: Holder { cb: syncRoot } }
    viaForward(w) //~ ERROR cannot run inside an `async fn`
}

async fn safeForwardLocal() -> Int {
    let w = Wrap { inner: Holder { cb: safeFn } }
    viaForward(w)
}

async fn riskyForward2() -> Int {
    viaForward2(Deep { wrap: Wrap { inner: Holder { cb: syncRoot } } }) //~ ERROR cannot run inside an `async fn`
}

async fn safeForward2() -> Int {
    viaForward2(Deep { wrap: Wrap { inner: Holder { cb: safeFn } } })
}

async fn riskyDeep() -> Int {
    viaDeep(Deep { wrap: Wrap { inner: Holder { cb: syncRoot } } }) //~ ERROR cannot run inside an `async fn`
}

async fn safeDeep() -> Int {
    viaDeep(Deep { wrap: Wrap { inner: Holder { cb: safeFn } } })
}

async fn riskyDeepLocal() -> Int {
    let d = Deep { wrap: Wrap { inner: Holder { cb: syncRoot } } }
    viaDeep(d) //~ ERROR cannot run inside an `async fn`
}

async fn safeDeepLocal() -> Int {
    let d = Deep { wrap: Wrap { inner: Holder { cb: safeFn } } }
    viaDeep(d)
}

async fn riskyChain() -> Int {
    let d = Deep { wrap: Wrap { inner: Holder { cb: syncRoot } } }
    viaLocalChain(d) //~ ERROR cannot run inside an `async fn`
}

async fn safeChain() -> Int {
    let d = Deep { wrap: Wrap { inner: Holder { cb: safeFn } } }
    viaLocalChain(d)
}

async fn riskyPartial() -> Int {
    let d = Deep { wrap: mkWrapRisky() }
    viaDeep(d) //~ ERROR cannot run inside an `async fn`
}

async fn safePartial() -> Int {
    let d = Deep { wrap: mkWrapSafe() }
    viaDeep(d)
}


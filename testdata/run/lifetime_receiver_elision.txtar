-- src --
type View['a] = { pub data &'a Bytes, pub off usize }

fn View['a].peek(self) -> &Bytes {
    self.data
}

fn main() -> Unit! {
    let buf = Bytes.fromArray(&Array.of(10, 20, 30))
    let v = View { data: &buf, off: 0 }
    let r = v.peek()
    print "${r[0]} ${r[2]}"
}
-- stdout --
10 30

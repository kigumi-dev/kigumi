-- src --
import task from std/task
import time from std/time

// Dropping a pending result waits for the closure, so its captured value is released only afterwards.
/// Safety: it holds only an Int, so moving it to the pool thread moves nothing shared.
@unsafeGuarantee(Send)
type Guard = resource {
    pub id Int
}

fn Guard.drop(move self) {
    print "guard ${self.id} dropped"
}

async fn root() -> Int! {
    let pool = task.BlockingPool.new(2)
    {
        let g = Guard { id: 1 }
        let fut = pool.run(move () => {
            time.sleep(200)
            print "closure done ${g.id}"
            0
        })?
        print "dropping"
    }
    let again = pool.run(() => 5)?
    await again
}

let ex = task.threadPoolExecutor(2)
let r = ex.runToCompletion(root())
print "result ${r.unwrap()}"
-- stdout --
dropping
closure done 1
guard 1 dropped
result 5

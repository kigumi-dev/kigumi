-- src --
import task from std/task

async fn worker(wg: &sync.WaitGroup) -> Void {
    wg.done()
}
import sync from std/sync

async fn check() -> Void! {
    let mut once = sync.Once.new()
    (await once.call(() => print "first"))?
    (await once.call(() => print "second"))?
    print "once done ${once.done()}"

    let wg = sync.WaitGroup.new()
    wg.add(2)
    wg.done()
    wg.done()
    await wg.wait()
    print "waitgroup done"

    let wg2 = sync.WaitGroup.new()
    wg2.add(1)
    let t = task.spawn(worker(&wg2))
    await t
    await wg2.wait()
    print "task done"
}

task.currentThreadExecutor().runToCompletion(check())?
-- stdout --
first
once done true
waitgroup done
task done

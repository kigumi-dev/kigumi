-- src --
import secret from std/secret

fn secretSeven() -> u64 {
    let mut t = FixedArray.filled[u64, 4](0)
    _ = t.set(2, 7)
    secret.ctLookupU64(&t, secret.SecretIndex[4].from(secret.SecretU32.classify(2)))
}

// Each byte a loop reads out of secret-derived Bytes keeps the label.
for b in "${secretSeven()}".toBytes() {
    if b == 55 {
        print "digit is 7"
    }
}
-- stdout --
digit is 7
-- secret-san --
panic: SecretSan: secret value reaches a conditional branch in main

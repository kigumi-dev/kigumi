-- src --
import secret from std/secret

fn secretSeven() -> u64 {
    let mut t = FixedArray.filled[u64, 4](0)
    _ = t.set(2, 7)
    secret.ctLookupU64(&t, secret.SecretIndex[4].from(secret.SecretU32.classify(2)))
}

import map from std/map

// A secret Map key picks the slot it is filed under.
let mut m = map.empty[u64, u64]()
m.set(secretSeven(), 1)
print "filed ${m.len()}"
-- stdout --
filed 1
-- secret-san --
panic: SecretSan: secret value reaches an index in std/map.fileSlot

-- src --
import task from std/task

type Res = resource {
    pub id Int
}

fn Res.drop(move self) {
    print "drop ${self.id}"
}

type Wrap = {
    pub r Res
}

fn mk(n: Int) -> Wrap? {
    Some(Wrap { r: Res { id: n } })
}

fn mkOk(n: Int) -> Result[Wrap, String] {
    Ok(Wrap { r: Res { id: n } })
}


fn nothing() -> Int? {
    None
}

async fn tick() -> Int {
    1
}

fn two(a: Wrap?, b: Result[Wrap, String], c: Wrap?) -> Int {
    let _z = nothing().expect("boom")
    0
}
async fn boom() -> Int {
    let a = mk(1)
    let b = mkOk(2)
    let c = mk(3)
    let k = await tick()
    two(a, b, c) + k
}
async fn root() -> Int { let a = task.spawn(boom())
 await a }
let ex = task.currentThreadExecutor()
print "total ${ex.runToCompletion(root())}"
-- stdout --
drop 3
drop 2
drop 1
-- stderr --
panic: boom
-- exit --
2

-- src --
// A resource read by value out of an Array (bracket indexing, or a field of the
// indexed element) is a compile error (E1050); takeAt is the sound replacement.
type Res = resource {
    pub id Int
}

type Holder = {
    pub r Res
}

fn Res.drop(move self) {
    print "drop ${self.id}"
}

fn consume(x: Res) {
    print "consume ${x.id}"
}

fn peek(x: &Res) {
    print "peek ${x.id}"
}

fn byTakeAt() {
    let mut xs = Array.of(Res { id: 1 })
    consume(xs.takeAt(0).unwrap())
}

fn byBorrow() {
    let xs = Array.of(Res { id: 2 })
    peek(&xs[0])
}

fn byIndexField() {
    let mut ys = Array.of(Holder { r: Res { id: 3 } })
    consume(ys.takeAt(0).unwrap().r)
}

byTakeAt()
print "takeAt"
byBorrow()
print "borrow"
byIndexField()
print "index field"
-- stdout --
consume 1
drop 1
takeAt
peek 2
drop 2
borrow
consume 3
drop 3
index field

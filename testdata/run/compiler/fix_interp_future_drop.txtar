-- src --
import task from std/task

type Handle = resource {
    pub id Int
}

fn Handle.drop(move self) {
    print "drop ${self.id}"
}

fn make(id: Int) -> Handle {
    Handle { id: id }
}

async fn consume(h: Handle) -> Int {
    print "consume ${h.id}"
    h.id
}

fn never() {
    let f = consume(make(42))
    print "created, not awaited"
}

async fn awaited() {
    let f = consume(make(50))
    let _ = await f
    print "after await"
}

async fn neverAwaited() {
    let t = task.spawn(consume(make(77)))
    print "spawned, never awaited"
}

async fn root() {
    await awaited()
    await neverAwaited()
    print "after neverAwaited"
    let t = task.spawn(consume(make(88)))
    let _ = await t
    print "after await of task"
}

never()
print "after never"
let ex = task.currentThreadExecutor()
ex.runToCompletion(root())
print "done"
-- stdout --
created, not awaited
drop 42
after never
consume 50
drop 50
after await
spawned, never awaited
after neverAwaited
consume 77
drop 77
consume 88
drop 88
after await of task
done

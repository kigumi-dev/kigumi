-- src --
// A comptime block copies direct values where a run does, so each pair
// below agrees: the first number is folded at compile time, the second runs.
type Point = {
    pub mut x Int
    pub mut y Int
}

type Named = {
    pub name String
    pub mut n Int
}

type Holder = {
    pub mut a FixedArray[Int, 3]
    pub mut p Point
}

fn pushThenWrite() -> Int {
    let mut p = Point { x: 1, y: 2 }
    let mut pts: Array[Point] = Array.empty()
    pts.push(p)
    p.x = 9
    pts[0].x * 10 + p.x
}

fn arrayThenWrite() -> Int {
    let mut a = FixedArray.filled[Int, 3](1)
    let mut arr: Array[FixedArray[Int, 3]] = Array.empty()
    arr.push(a)
    a[2] = 7
    arr[0][2] * 10 + a[2]
}

fn bump(mut p: Point) -> Int {
    p.x = p.x + 100
    p.x
}

fn fieldCopies() -> Int {
    let h = Holder { a: FixedArray.filled(4), p: Point { x: 5, y: 6 } }
    let mut b = h.a
    b[1] = 50
    let moved = bump(h.p)
    h.a[1] * 1000 + b[1] * 10 + h.p.x + moved
}

fn namedPush() -> Int {
    let mut r = Named { name: "n", n: 1 }
    let mut rs: Array[Named] = Array.empty()
    rs.push(r)
    r.n = 7
    rs[0].n * 10 + r.n
}

fn capture() -> Int {
    let p = Point { x: 3, y: 4 }
    let f = () => p.x + p.y
    let mut q = p
    q.x = 100
    f() * 1000 + q.x
}

let pushed = comptime { pushThenWrite() }
let arrays = comptime { arrayThenWrite() }
let fields = comptime { fieldCopies() }
let named = comptime { namedPush() }
let captured = comptime { capture() }
let inline = comptime {
    let mut p = Point { x: 1, y: 2 }
    let mut pts: Array[Point] = Array.empty()
    pts.push(p)
    p.x = 9
    pts[0].x * 10 + p.x
}
print "push ${pushed} ${pushThenWrite()}"
print "fixed ${arrays} ${arrayThenWrite()}"
print "fields ${fields} ${fieldCopies()}"
print "named ${named} ${namedPush()}"
print "capture ${captured} ${capture()}"
print "inline ${inline}"
-- stdout --
push 19 19
fixed 17 17
fields 4610 4610
named 17 17
capture 7100 7100
inline 19

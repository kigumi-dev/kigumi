-- src --
// A TLS 1.3 server over loopback sockets, driven by the module's own client.
// Both sides run the real handshake: there is no scripted flight and no
// loopback bypass. The server echoes one request, negotiates ALPN from its
// own preference order, and treats a client close_notify as end of stream.
import hex from std/encoding/hex
import net from std/net
import tls from std/net/tls
import task from std/task
import x509 from std/crypto/x509

const ROOT = ""
const LEAF = ""
const LEAF_KEY = "d88a88882b51bedeca8e098d7322bcaa262676a902ba292bc4c69633508084b9"

fn dec(text: String) -> Bytes {
    hex.decode(text).expect("hex")
}

fn deterministicRandom(n: usize) -> Bytes! {
    Bytes.fill(0x7b, n)
}

fn serverConfig() -> tls.ServerConfig {
    let mut config = tls.ServerConfig.new(Array.of(dec(LEAF)), tls.ServerKey.EcP256(dec(LEAF_KEY)), (k) => deterministicRandom(k))
    // The client offers only http/1.1, so server preference must fall through
    // to the one protocol both sides speak.
    config.alpn = Array.of("h2", "http/1.1")
    config
}

type Mode = | Echo | PeerClose

async fn serve(mut listener: net.Listener, mode: Mode) -> String {
    let pool = task.BlockingPool.new(1)
    let pending = match pool.run(() => listener.accept().unwrap()) {
        Ok(value) -> value
        Err(e) -> return "accept: ${e.message()}"
    }
    let conn = await pending
    let handshake = await tls.Server.handshake(conn, serverConfig())
    let mut session = match handshake {
        Ok(value) -> value
        Err(e) -> return "handshake: ${e.message()}"
    }
    let request = match await session.read(64) {
        Ok(value) -> value
        Err(e) -> {
            await session.close()
            return "read: ${e.message()}"
        }
    }
    let text = String.fromBytes(request) || ""
    if mode is Mode.Echo {
        if text != "hello tls" {
            await session.close()
            return "request `${text}`"
        }
        match await session.write("welcome".toBytes()) {
            Ok(_) -> {}
            Err(e) -> {
                await session.close()
                return "write: ${e.message()}"
            }
        }
        // The server closes; its close_notify is what the client reads next.
        await session.close()
        return "ok"
    }
    if text != "bye" {
        await session.close()
        return "request `${text}`"
    }
    // The client sent close_notify, so this read is end of stream.
    let after = await session.read(64)
    await session.close()
    match after {
        Ok(chunk) -> if chunk.len() == 0 {
            "ok"
        } else {
            "data after the client close"
        }
        Err(e) -> "close: ${e.message()}"
    }
}

async fn connect(n: net.Net, port: Int) -> tls.Session! {
    let root = (x509.parse(dec(ROOT)))?
    let anchors = Array.of(root)
    let config = tls.Config.new("localhost", anchors, (k) => deterministicRandom(k))
    let pool = task.BlockingPool.new(1)
    let conn = await pool.run(() => n.connect("127.0.0.1", port).unwrap()).unwrap()
    let session = (await tls.Client.connect(conn, config))?
    session
}

async fn echoCase(n: net.Net) -> String! {
    let pool = task.BlockingPool.new(1)
    let listener = await pool.run(() => n.listen("127.0.0.1", 0).unwrap()).unwrap()
    let port = listener.port()
    let running = task.spawn(serve(listener, Mode.Echo))
    let mut session = (await connect(n, port))?
    let alpn = session.alpn()
    (await session.write("hello tls".toBytes()))?
    let first = (await session.read(64))?
    let second = (await session.read(64))?
    await session.close()
    let server = await running
    if server != "ok" {
        return "echo => server ${server}"
    }
    let text = String.fromBytes(first) || ""
    if text != "welcome" || second.len() != 0 {
        return "echo => application data `${text}` then ${second.len()} bytes"
    }
    "echo => ok alpn ${alpn}"
}

async fn peerCloseCase(n: net.Net) -> String! {
    let pool = task.BlockingPool.new(1)
    let listener = await pool.run(() => n.listen("127.0.0.1", 0).unwrap()).unwrap()
    let port = listener.port()
    let running = task.spawn(serve(listener, Mode.PeerClose))
    let mut session = (await connect(n, port))?
    (await session.write("bye".toBytes()))?
    await session.close()
    let server = await running
    if server != "ok" {
        return "peer-close => server ${server}"
    }
    "peer-close => ok"
}

async fn run() -> Void! {
    let n = host.net()
    let echo = (await echoCase(n))?
    print echo
    let peerClose = (await peerCloseCase(n))?
    print peerClose
}

task.currentThreadExecutor().runToCompletion(run())?
-- stdout --
echo => ok alpn http/1.1
peer-close => ok

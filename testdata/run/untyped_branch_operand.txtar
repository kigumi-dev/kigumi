-- src --
fn viaIf(b: Bool) -> f32 {
    let k: f32 = 2
    k + (if b { 1 } else { 0 })
}

fn viaMatch(b: Bool) -> Float {
    let k: Float = 2.5
    k * (match b {
        true -> 3
        false -> 4
    })
}

fn nested(n: Int) -> u8 {
    let k: u8 = 10
    k + (if n > 0 { 1 } else if n < 0 { 2 } else { 3 })
}

fn viaBlock() -> f32 {
    let k: f32 = 0.5
    k + { 1 }
}

fn early(b: Bool) -> u8 {
    let k: u8 = 2
    k + (if b { 1 } else { return 9 })
}

print "${viaIf(true)} ${viaIf(false)} ${viaMatch(true)} ${viaMatch(false)}"
print "${nested(5)} ${nested(-5)} ${nested(0)} ${viaBlock()} ${early(true)} ${early(false)}"
-- stdout --
3 2 7.5 10
11 12 13 1.5 3 9

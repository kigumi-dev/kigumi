-- src --
import fmt from std/fmt

type Point = {
    pub x Int
    pub y Int
}

type Shape = Circle(r: Int) | Dot

type Wrap[T] = {
    pub inner T
}

pure fn render[T: fmt.Display](v: T) -> String {
    v.display()
}

type Pretty = {
    pub label String
}

pub pure fn Pretty.display(self) -> String {
    "<${self.label}>"
}

print render(Point { x: 1, y: 2 })
print render(Shape.Circle(3))
print render(Shape.Dot)
print render(Wrap { inner: Point { x: 5, y: 6 } })
print render(Pretty { label: "hi" })
print debug(&Point { x: 1, y: 2 })
-- stdout --
Point { 1, 2 }
Circle(3)
Dot
Wrap { Point { 5, 6 } }
<hi>
Point { 1, 2 }

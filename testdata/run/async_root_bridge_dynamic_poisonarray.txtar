-- src --
import task from std/task
import map from std/map

type Holder = {
    pub mut cb fn() -> Int
}

async fn leaf(n: Int) -> Int {
    n
}

fn syncRoot() -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(leaf(7))
}

fn safeFn() -> Int {
    1
}

fn opaqueSel(pick: Bool) -> fn() -> Int {
    if pick {
        syncRoot
    } else {
        safeFn
    }
}

fn callIt(h: Holder) -> Int {
    h.cb()
}

async fn outer() -> Int {
    let mut w = Holder { cb: safeFn }
    w.cb = opaqueSel(true)
    let mut hs = map.empty[Int, Holder]()
    hs.set(0, w)
    callIt(hs.get(&0).unwrap())
}

print "start"
let ex = task.currentThreadExecutor()
print "got ${ex.runToCompletion(outer())}"
-- stdout --
start
-- stderr --
panic: `Executor.runToCompletion` cannot run inside a task; `await` the future instead
-- exit --
2

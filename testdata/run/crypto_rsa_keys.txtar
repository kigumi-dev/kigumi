-- src --
// Malformed PKCS#1 keys and signature length/range boundaries.
import hex from std/encoding/hex
import rsa from std/crypto/rsa

fn key(r: Result[rsa.PublicKey, rsa.Error]) -> String {
    match r {
        Ok(k) -> "ok ${k.byteSize()} ${k.exponent()}"
        Err(e) -> e.message()
    }
}

fn show(r: Result[Bool, rsa.Error]) -> String {
    match r { Ok(v) -> "${v}", Err(e) -> e.message() }
}

fn main() -> Void! {
    let der = hex.decode("")?
    print "der-ok ${key(rsa.parsePkcs1(der))}"
    print "der-trailing ${key(rsa.parsePkcs1(hex.decode("")?))}"
    print "der-wrong-tag ${key(rsa.parsePkcs1(hex.decode("")?))}"
    print "der-negative ${key(rsa.parsePkcs1(hex.decode("3006020181020103")?))}"
    print "der-redundant-zero ${key(rsa.parsePkcs1(hex.decode("30070202007f020103")?))}"
    print "der-three-fields ${key(rsa.parsePkcs1(hex.decode("3009020101020103020103")?))}"
    print "der-empty-integer ${key(rsa.parsePkcs1(hex.decode("30050200020103")?))}"
    print "der-zero-modulus ${key(rsa.parsePkcs1(hex.decode("3006020100020103")?))}"
    print "der-small-modulus ${key(rsa.parsePkcs1(hex.decode("3006020101020103")?))}"
    print "der-even-exponent ${key(rsa.parsePkcs1(hex.decode("")?))}"
    print "der-truncated ${key(rsa.parsePkcs1(hex.decode("3082")?))}"
    print "der-empty ${key(rsa.parsePkcs1(Bytes.zeros(0)))}"

    let modulus = hex.decode("")?
    print "raw-ok ${key(rsa.fromRaw(modulus, hex.decode("03")?))}"
    print "raw-leading-zero ${key(rsa.fromRaw(hex.decode("")?, hex.decode("03")?))}"
    print "raw-even-modulus ${key(rsa.fromRaw(hex.decode("")?, hex.decode("03")?))}"
    print "raw-small-modulus ${key(rsa.fromRaw(hex.decode("ffffffff")?, hex.decode("03")?))}"
    print "raw-zero-exponent ${key(rsa.fromRaw(modulus, hex.decode("00")?))}"
    print "raw-empty-exponent ${key(rsa.fromRaw(modulus, Bytes.zeros(0)))}"
    print "raw-one-exponent ${key(rsa.fromRaw(modulus, hex.decode("01")?))}"
    print "raw-even-exponent ${key(rsa.fromRaw(modulus, hex.decode("02")?))}"
    print "raw-exponent-leading-zero ${key(rsa.fromRaw(modulus, hex.decode("00010001")?))}"
    print "raw-exponent-too-big ${key(rsa.fromRaw(modulus, hex.decode("0100000000")?))}"
    print "raw-exponent-too-long ${key(rsa.fromRaw(modulus, hex.decode("010000000000000001")?))}"

    let pk = rsa.parsePkcs1(der)?
    let test = hex.decode("54657374")?
    print "sig-empty ${show(rsa.verifyPssSha256(pk, test, Bytes.zeros(0), rsa.SaltLength.Auto))}"
    print "sig-short ${show(rsa.verifyPssSha256(pk, test, hex.decode("")?, rsa.SaltLength.Auto))}"
    print "sig-long ${show(rsa.verifyPssSha256(pk, test, hex.decode("")?, rsa.SaltLength.Auto))}"
    print "sig-modulus ${show(rsa.verifyPssSha256(pk, test, modulus, rsa.SaltLength.Auto))}"
    print "sig-modulus-plus-one ${show(rsa.verifyPkcs1v15Sha256(pk, test, hex.decode("")?))}"
    print "digest-short ${show(rsa.verifyPssSha256Digest(pk, Bytes.zeros(31), hex.decode("")?, rsa.SaltLength.Auto))}"
}
-- stdout --
der-ok ok 256 65537
der-trailing rsa: invalid PKCS#1 public key
der-wrong-tag rsa: invalid PKCS#1 public key
der-negative rsa: invalid PKCS#1 public key
der-redundant-zero rsa: invalid PKCS#1 public key
der-three-fields rsa: invalid PKCS#1 public key
der-empty-integer rsa: invalid PKCS#1 public key
der-zero-modulus rsa: invalid modulus
der-small-modulus rsa: invalid modulus
der-even-exponent rsa: invalid public exponent
der-truncated rsa: invalid PKCS#1 public key
der-empty rsa: invalid PKCS#1 public key
raw-ok ok 256 3
raw-leading-zero rsa: invalid modulus
raw-even-modulus rsa: invalid modulus
raw-small-modulus rsa: invalid modulus
raw-zero-exponent rsa: invalid public exponent
raw-empty-exponent rsa: invalid public exponent
raw-one-exponent rsa: invalid public exponent
raw-even-exponent rsa: invalid public exponent
raw-exponent-leading-zero rsa: invalid public exponent
raw-exponent-too-big rsa: invalid public exponent
raw-exponent-too-long rsa: invalid public exponent
sig-empty rsa: signature length does not match the modulus
sig-short rsa: signature length does not match the modulus
sig-long rsa: signature length does not match the modulus
sig-modulus rsa: signature is not below the modulus
sig-modulus-plus-one rsa: signature is not below the modulus
digest-short rsa: digest must be 32 bytes

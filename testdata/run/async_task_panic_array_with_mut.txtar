-- src --
import task from std/task
import {Shared} from std/alloc

async fn boom(s: Shared[Array[Int]]) -> Int {
    let _ = s.withMut((xs: &mut Array[Int]) => {
        xs.withMut(0, (v: &mut Int) => {
            v = 9
            if v == 9 {
                panic("inside")
            }
            0
        })
    })
    0
}

async fn sib(s: Shared[Array[Int]]) -> Int {
    s.with((xs: &Array[Int]) => xs[0])
}

async fn root(s: Shared[Array[Int]]) -> Int {
    let a = task.spawn(boom(s.clone()))
    let b = task.spawn(sib(s.clone()))
    let x = await b
    print "sibling ${x}"
    await a
}

let ex = task.currentThreadExecutor()
print "total ${ex.runToCompletion(root(Shared.new(Array.of(1, 2))))}"
-- stdout --
sibling 9
-- stderr --
panic: inside
-- exit --
2

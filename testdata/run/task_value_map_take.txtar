-- src --
// Tasks kept in a map and taken back out to be awaited hold no borrow, so taking them is no escape.
import task from std/task
import map from std/map

async fn leaf(n: Int) -> Int {
    await task.yieldNow()
    n
}

async fn root() -> Int {
    let mut m: map.Map[Int, task.Task[Int]] = map.empty()
    m.set(1, task.spawn(leaf(4)))
    m.set(2, task.spawn(leaf(5)))
    let mut s = 0
    if m.take(&1) is Some(t) {
        s += await t
    }
    if m.take(&2) is Some(t) {
        s += await t
    }
    s
}

print "${task.currentThreadExecutor().runToCompletion(root())}"
-- stdout --
9
-- stderr --
-- exit --
0

-- src --
// Same as fix_interp_bracket_move_drop, through a chain of two index/field hops.
type Res = resource {
    pub id Int
}

type Row = {
    pub mut cells Array[Res]
}

fn Res.drop(move self) -> Unit {
    print "drop ${self.id}"
}

fn consume(x: Res) -> Unit {
    print "consume ${x.id}"
}

fn peek(x: &Res) -> Unit {
    print "peek ${x.id}"
}

fn byNestedTakeAt() -> Unit {
    let mut xs = Array.of(Array.of(Res { id: 1 }, Res { id: 2 }))
    consume(xs[0].takeAt(1).unwrap())
}

fn byNestedBorrow() -> Unit {
    let xs = Array.of(Array.of(Res { id: 3 }, Res { id: 4 }))
    peek(&xs[0][1])
}

fn byIndexFieldIndex() -> Unit {
    let mut rows = Array.of(Row { cells: Array.of(Res { id: 5 }) })
    let r: usize = 0
    consume(rows[r].cells.takeAt(0).unwrap())
}

byNestedTakeAt()
print "nested takeAt"
byNestedBorrow()
print "nested borrow"
byIndexFieldIndex()
print "index field index"
-- stdout --
consume 2
drop 2
drop 1
nested takeAt
peek 4
drop 4
drop 3
nested borrow
consume 5
drop 5
index field index

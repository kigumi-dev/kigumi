-- src --
import task from std/task
import {atomicAdd, atomicLoad, atomicOr, AtomicOrder} from std/mem

static mut hits: u64 = 0
static mut small: u8 = 0
static mut mask: u32 = 0

async fn work(id: Int, bit: u32) -> Int {
    let mut i = 0
    for i < 1000 {
        unsafe {
            _ = atomicAdd(&mut hits, 1, AtomicOrder.Relaxed)
            _ = atomicAdd(&mut small, 1, AtomicOrder.SeqCst)
        }
        if i % 250 == 0 {
            await task.yieldNow()
        }
        i = i + 1
    }
    unsafe {
        _ = atomicOr(&mut mask, bit, AtomicOrder.AcqRel)
    }
    id
}

async fn root() -> Int {
    let mut kids = Array.empty[task.Task[Int]]()
    let mut id = 0
    let mut bit: u32 = 1
    for id < 8 {
        kids.push(task.spawn(work(id, bit)))
        id = id + 1
        bit = bit * 2
    }
    let mut sum = 0
    for k in kids {
        sum = sum + await k
    }
    sum
}

let ex = task.threadPoolExecutor(4)
print "sum ${ex.runToCompletion(root())}"
unsafe {
    print "hits ${atomicLoad(&hits, AtomicOrder.SeqCst)}"
    print "small ${atomicLoad(&small, AtomicOrder.SeqCst)}"
    print "mask ${atomicLoad(&mask, AtomicOrder.SeqCst)}"
}
-- stdout --
sum 28
hits 8000
small 64
mask 255

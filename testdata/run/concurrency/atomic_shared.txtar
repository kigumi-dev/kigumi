-- src --
import {atomicAdd, atomicLoad, AtomicOrder} from std/mem
import task from std/task

static mut hits: u64 = 0

fn bump(n: Int) -> Int {
    let mut i = 0
    for i < n {
        unsafe {
            _ = atomicAdd(&mut hits, 1, AtomicOrder.SeqCst)
        }
        i = i + 1
    }
    n
}

async fn root() -> u64 {
    let pool = task.BlockingPool.new(4)
    let f1 = pool.run(() => bump(20000)).expect("capacity")
    let f2 = pool.run(() => bump(20000)).expect("capacity")
    _ = bump(20000)
    _ = await f1
    _ = await f2
    unsafe {
        atomicLoad(&hits, AtomicOrder.SeqCst)
    }
}

let ex = task.threadPoolExecutor(2)
print "${ex.runToCompletion(root())}"
-- stdout --
60000

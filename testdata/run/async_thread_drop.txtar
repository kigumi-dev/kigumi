-- src --
import task from std/task

async fn leaf(n: Int) -> Int {
    n * 3
}

async fn job(n: Int) -> Int {
    let t = task.spawn(leaf(n))
    n + await t
}

// The frame owning the handle ends while the task it handed over is still
// running, so the drop cannot wait for the worker that has to finish it.
fn launch(pool: task.Executor, n: Int) -> task.Task[Int] {
    pool.handoff(job(n))
}

// The pool is born and loses its last handle inside one poll, so a worker of
// the outer pool is the lane that has to let it go.
async fn chain(n: Int) -> Int {
    let t = launch(task.threadPoolExecutor(2), n)
    await t
}

async fn root(first: task.Executor) -> Int {
    let b = first.handoff(chain(2))
    let a = first.handoff(chain(1))
    let x = await a
    print "a ${x}"
    let y = await b
    print "b ${y}"
    x + y
}

let first = task.threadPoolExecutor(2)
let ex = task.currentThreadExecutor()
print "total ${ex.runToCompletion(root(first))}"
-- stdout --
a 4
b 8
total 12

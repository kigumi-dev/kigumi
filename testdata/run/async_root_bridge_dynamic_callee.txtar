-- src --
import task from std/task

type Holder = {
    pub cb fn() -> Int
}

type Wrap = {
    pub inner Holder
}

async fn leaf(n: Int) -> Int {
    n
}

fn syncRoot() -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(leaf(7))
}

fn safeRoot() -> Int {
    9
}

fn callInner(w: Wrap) -> Int {
    w.inner.cb()
}

async fn outer() -> Int {
    let h = Holder { cb: syncRoot }
    let w = Wrap { inner: h }
    callInner(w)
}

print "start"
let ex = task.currentThreadExecutor()
print "got ${ex.runToCompletion(outer())}"
-- stdout --
start
-- stderr --
panic: `Executor.runToCompletion` cannot run inside a task; `await` the future instead
-- exit --
2

-- src --
type Handle = resource {
    pub mut id Int
}

fn Handle.drop(move self) {}

fn Handle.close(move self) {
    print "close ${self.id}"
}

fn Handle.peek(self) -> Int {
    self.id
}

type Pack = {
    pub mut inner Handle
    pub mut other Handle
}

fn mkh(n: Int) -> Handle {
    Handle { id: n }
}

fn mk(n: Int) -> Pack {
    Pack { inner: mkh(n), other: mkh(n + 1) }
}

fn take(h: Handle) {
    print "take ${h.id}"
}

fn callOnce[F: FnOnce[fn() -> Void]](f: F) {
    f()
}

fn callTwice[F: Fn[fn() -> Int]](f: F) -> Int {
    f() + f()
}

fn calledOnce() {
    let h = mkh(1)
    let f = () => { h.close() }
    f()
}

fn calledInBranches(c: Bool) {
    let h = mkh(2)
    let f = () => { h.close() }
    if c {
        f()
    } else {
        print "skipped"
    }
}

fn consumesField() {
    let b = mk(10)
    let o = move b.other
    let f = () => { o.close() }
    f()
    b.inner.close()
}

fn passedToOnce() {
    let h = mkh(20)
    let f = () => { take(h) }
    callOnce(f)
}

fn perIteration() {
    for i in 0..2 {
        let h = mkh(30 + i)
        let f = () => { h.close() }
        f()
    }
}

fn nestedOnce() {
    let h = mkh(40)
    let f = () => { h.close() }
    let g = () => { f() }
    g()
}

fn deferredOnce() {
    let h = mkh(50)
    let f = () => { h.close() }
    defer { f() }
    print "body"
}

fn borrowingClosure() -> Int {
    let h = mkh(60)
    let f = () => h.peek()
    f() + f()
}

fn borrowingGeneric() -> Int {
    let h = mkh(70)
    let total = callTwice(() => h.peek())
    h.close()
    total
}

type Slot = {
    pub mut opt Handle?
}

fn refillTwice() {
    let mut h = mkh(80)
    let f = () => {
        h.close()
        h = mkh(81)
    }
    f()
    f()
}

fn refillField() {
    let mut p = mk(90)
    let f = () => {
        p.other.close()
        p.other = mkh(99)
    }
    f()
    f()
}

fn refillPayload() {
    let mut s = Slot { opt: Some(mkh(100)) }
    let f = () => {
        match s.opt {
            Some(h) -> h.close()
            None -> print "empty"
        }
        s.opt = None
    }
    f()
    f()
}

type Holder[F] = {
    pub f F
}

fn storedInField() {
    let p = mk(110)
    let o = move p.other
    let f = () => { o.close() }
    let s = Holder { f: f }
    (s.f)()
    p.inner.close()
}

fn innerBreakThenRefill(xs: Array[Int]) {
    let mut h = mkh(120)
    let f = () => {
        h.close()
        for x in &xs {
            if x > 0 {
                break
            }
        }
        h = mkh(121)
    }
    f()
    f()
}

type Runner[F] = {
    pub f F
}

fn Runner[F: FnOnce[fn() -> Void]].runOwned(move self) {
    (self.f)()
}

fn runOwnedOnce() {
    let p = mk(130)
    let s = Runner { f: () => { p.other.close() } }
    s.runOwned()
}

fn readAfterMaking() {
    let h = mkh(140)
    print "peek ${h.peek()}"
    let f = () => { h.close() }
    f()
}

calledOnce()
calledInBranches(true)
calledInBranches(false)
consumesField()
passedToOnce()
perIteration()
nestedOnce()
deferredOnce()
print "total ${borrowingClosure()}"
print "total ${borrowingGeneric()}"
refillTwice()
refillField()
refillPayload()
storedInField()
innerBreakThenRefill(Array.of(1, 2))
runOwnedOnce()
readAfterMaking()

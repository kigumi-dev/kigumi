-- src --
import task from std/task

type Holder = {
    pub cb fn() -> Int
}

async fn leaf(n: Int) -> Int {
    n
}

fn syncRoot() -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(leaf(7))
}

fn safeRoot() -> Int {
    9
}

// pick's result defeats the static field-value tracker: the field holds
// whichever fn this call returns, known only at run time.
fn pick(risky: Bool) -> fn() -> Int {
    if risky { syncRoot } else { safeRoot }
}

fn callField(h: Holder) -> Int {
    h.cb()
}

async fn outer() -> Int {
    let h = Holder { cb: pick(true) }
    callField(h)
}

print "start"
let ex = task.currentThreadExecutor()
print "got ${ex.runToCompletion(outer())}"
-- stdout --
start
-- stderr --
panic: `Executor.runToCompletion` cannot run inside a task; `await` the future instead
-- exit --
2

-- src --
// Go 1.26 crypto/rsa signatures for 1032-, 2049-, 2056- and 2085-bit keys, whose octet length is not
// a multiple of the 8-octet limb, and a 2048-bit key; python-cryptography agrees with every verdict.
import rsa from std/crypto/rsa
import hex from std/encoding/hex

fn show(r: Result[Bool, rsa.Error]) -> String {
    match r {
        Ok(v) -> "${v}"
        Err(e) -> e.message()
    }
}

fn checkKey(v: KeyVectors) -> Void! {
    let pk = rsa.parsePkcs1(hex.decode(v.key)?)?
    let n = v.name
    let msg = "kigumi rsa ${pk.bitSize()}-bit vector".toBytes()
    let pkcs1 = hex.decode(v.pkcs1)?
    let zeroMsg = v.zeroMsg.toBytes()
    let pkcs1Zero = hex.decode(v.pkcs1Zero)?
    let stripped = pkcs1Zero.slice(1, pkcs1Zero.len()) || Bytes.zeros(0)
    let pss = hex.decode(v.pss)?
    let pssMax = hex.decode(v.pssMax)?
    let pssZero = hex.decode(v.pssZero)?
    print "${n} key ${pk.byteSize()} ${pk.bitSize()}"
    print "${n} pkcs1 ${show(rsa.verifyPkcs1v15Sha256(pk, msg, pkcs1))}"
    print "${n} pkcs1-flipped ${show(rsa.verifyPkcs1v15Sha256(pk, msg, hex.decode(v.pkcs1Flipped)?))}"
    print "${n} pkcs1-top-zero ${show(rsa.verifyPkcs1v15Sha256(pk, zeroMsg, pkcs1Zero))} top=${pkcs1Zero[0]}"
    print "${n} pkcs1-top-zero-stripped ${show(rsa.verifyPkcs1v15Sha256(pk, zeroMsg, stripped))}"
    print "${n} pss-exact ${show(rsa.verifyPssSha256(pk, msg, pss, rsa.SaltLength.Exact(32)))}"
    print "${n} pss-auto ${show(rsa.verifyPssSha256(pk, msg, pss, rsa.SaltLength.Auto))}"
    print "${n} pss-max-salt-auto ${show(rsa.verifyPssSha256(pk, msg, pssMax, rsa.SaltLength.Auto))}"
    print "${n} pss-max-salt-exact32 ${show(rsa.verifyPssSha256(pk, msg, pssMax, rsa.SaltLength.Exact(32)))}"
    print "${n} pss-top-zero ${show(rsa.verifyPssSha256(pk, v.pssZeroMsg.toBytes(), pssZero, rsa.SaltLength.Exact(32)))} top=${pssZero[0]}"
}

fn main() -> Void! {
    let all = keyVectors()
    let mut i: usize = 0
    for i < all.len() {
        checkKey(all[i])?
        i = i + 1
    }
}
-- main/vectors.kg --
/// One key and its signatures: PKCS#1 v1.5 and PSS (32-octet salt) over "kigumi rsa <bits>-bit vector",
/// the PKCS#1 one with its last bit flipped, PSS with the largest salt, and a PKCS#1 and a PSS
/// signature found by searching messages for one whose first octet is zero.
type KeyVectors = {
    name String
    key String
    pkcs1 String
    pkcs1Flipped String
    zeroMsg String
    pkcs1Zero String
    pss String
    pssMax String
    pssZeroMsg String
    pssZero String
}


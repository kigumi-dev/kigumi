-- src --
import map from std/map

fn indexOf(items: &Array[Int], key: Int) -> Int {
    let mut i: usize = 0
    for i < items.len() {
        if (items.get(i) || -1) == key {
            return i.toInt() || 0
        }
        i = i + 1
    }
    -1
}

fn agrees(m: &map.Map[Int, Int], model: &Array[Int]) -> Bool {
    let keys = m.keys()
    if !keys.equals(model) {
        return false
    }
    let values = m.values()
    let mut i: usize = 0
    for i < keys.len() {
        if (values.get(i) || -1) != (keys.get(i) || 0) * 3 {
            return false
        }
        i = i + 1
    }
    true
}

fn randomOps() {
    let mut m = map.empty[Int, Int]()
    let mut model = Array.empty[Int]()
    let mut seed = 12345
    let mut step = 0
    let mut mismatches = 0
    for step < 6000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        let key = (seed / 65536) % 700
        let at = indexOf(&model, key)
        if (seed / 7) % 3 == 0 {
            let got = m.take(&key)
            if at >= 0 {
                _ = model.takeAt(at.toUsize() || 0)
                if got != Some(key * 3) {
                    mismatches = mismatches + 1
                }
            } else if got is Some(_) {
                mismatches = mismatches + 1
            }
        } else {
            m.set(key, key * 3)
            if at < 0 {
                model.push(key)
            }
        }
        if step % 250 == 0 && !agrees(&m, &model) {
            mismatches = mismatches + 1
        }
        step = step + 1
    }
    print "random: len=${m.len()} model=${model.len()} agrees=${agrees(&m, &model)} mismatches=${mismatches}"
}

fn removeAllThenReinsert() {
    let n = 3000
    let mut m = map.empty[Int, Int]()
    let mut i = 0
    for i < n {
        m.set(i, i * 3)
        i = i + 1
    }
    i = 0
    for i < n {
        m.remove(&i)
        i = i + 1
    }
    print "front-removed: len=${m.len()} has0=${m.contains(&0)} has2999=${m.contains(&2999)}"
    i = n - 1
    for i >= 0 {
        m.set(i, i * 3)
        i = i - 1
    }
    print "reinserted: len=${m.len()} first=${m.keys().get(0) || -1} last=${m.keys().last() || -1}"
    i = n - 1
    for i >= 0 {
        if m.take(&i) != Some(i * 3) {
            print "bad take ${i}"
        }
        i = i - 1
    }
    print "back-removed: len=${m.len()}"
    m.set(7, 21)
    m.set(5, 15)
    m.remove(&7)
    m.set(7, 22)
    m.remove(&99)
    print "order: ${debug(&m.keys())} ${debug(&m.values())}"
}

fn cloneAfterRemoval() {
    let mut m = map.empty[Int, Int]()
    let mut i = 0
    for i < 100 {
        m.set(i, i)
        i = i + 1
    }
    i = 0
    for i < 100 {
        m.remove(&i)
        i = i + 2
    }
    let copy = m.clone()
    print "clone: ${copy.len()} equals=${copy.equals(&m)} get51=${copy.get(&51) || -1} get50=${copy.get(&50) || -1}"
    m.set(50, 500)
    print "diverged: ${copy.equals(&m)} ${copy.len()} ${m.len()}"
}

fn trySetAfterRemoval() -> Result[Void, AllocError] {
    let mut m = map.empty[Int, Int]()
    let mut i = 0
    for i < 200 {
        m.trySet(i, i)?
        i = i + 1
    }
    i = 0
    for i < 200 {
        m.remove(&i)
        i = i + 3
    }
    i = 200
    for i < 400 {
        m.trySet(i, i)?
        i = i + 1
    }
    print "tryset: len=${m.len()} has3=${m.contains(&3)} has2=${m.contains(&2)} has399=${m.contains(&399)}"
}

randomOps()
removeAllThenReinsert()
cloneAfterRemoval()
_ = trySetAfterRemoval()
-- stdout --
random: len=452 model=452 agrees=true mismatches=0
front-removed: len=0 has0=false has2999=false
reinserted: len=3000 first=2999 last=0
back-removed: len=0
order: [5, 7] [15, 22]
clone: 50 equals=true get51=51 get50=-1
diverged: false 50 51
tryset: len=333 has3=false has2=true has399=true

-- src --
import math from std/math

fn ar8(a: i8, b: i8) -> String {
    "${a + b} ${a - b} ${a * b} ${a / b} ${a % b} ${a ^ b} ${-a} ${~a}"
}

fn aru8(a: u8, b: u8) -> String {
    "${a + b} ${a - b} ${a * b} ${a / b} ${a % b} ${a ^ b} ${~a}"
}

fn ar32(a: i32, b: i32) -> String {
    "${a + b} ${a - b} ${a * b} ${a / b} ${a % b} ${-a} ${~a}"
}

fn aru32(a: u32, b: u32) -> String {
    "${a + b} ${a - b} ${a * b} ${a / b} ${a % b} ${~a}"
}

fn ar64(a: Int, b: Int) -> String {
    "${a + b} ${a - b} ${a * b} ${a / b} ${a % b} ${-a} ${~a}"
}

fn aru64(a: u64, b: u64) -> String {
    "${a + b} ${a - b} ${a * b} ${a / b} ${a % b} ${~a}"
}

fn sh8(a: i8, n: usize) -> String {
    "${a << n} ${a >> n}"
}

fn shu16(a: u16, n: usize) -> String {
    "${a << n} ${a >> n}"
}

fn sh64(a: Int, n: usize) -> String {
    "${a << n} ${a >> n}"
}

fn shu64(a: u64, n: usize) -> String {
    "${a << n} ${a >> n}"
}

fn wr8(a: i8, b: i8) -> String {
    "${a.wrappingAdd(b)} ${a.wrappingSub(b)} ${a.wrappingMul(b)} ${a.wrappingShiftLeft(b)} ${a.wrappingShiftRight(b)} ${a.rotateLeft(b)} ${a.rotateRight(b)}"
}

fn wru32(a: u32, b: u32) -> String {
    "${a.wrappingAdd(b)} ${a.wrappingSub(b)} ${a.wrappingMul(b)} ${a.wrappingShiftLeft(b)} ${a.wrappingShiftRight(b)} ${a.rotateLeft(b)} ${a.rotateRight(b)}"
}

fn wr64(a: Int, b: Int) -> String {
    "${a.wrappingAdd(b)} ${a.wrappingSub(b)} ${a.wrappingMul(b)} ${a.wrappingShiftLeft(b)} ${a.wrappingShiftRight(b)} ${a.rotateLeft(b)} ${a.rotateRight(b)}"
}

fn wru64(a: u64, b: u64) -> String {
    "${a.wrappingAdd(b)} ${a.wrappingSub(b)} ${a.wrappingMul(b)} ${a.wrappingShiftLeft(b)} ${a.wrappingShiftRight(b)} ${a.rotateLeft(b)} ${a.rotateRight(b)}"
}

fn cv(n: Int) -> String {
    "${n.toI8() || -1} ${n.toU8() || 7} ${n.toU16() || 7} ${n.toI32() || -1} ${n.toU64() || 7} ${n.toFloat()} ${n.truncate[u8]()} ${n.truncate[i16]()}"
}

fn cvu(n: u64) -> String {
    "${n.toInt() || -1} ${n.toI8() || -1} ${n.toU32() || 7} ${n.toFloat()} ${n.toUsize()}"
}

fn cvi8(n: i8) -> String {
    "${n.toU8() || 7} ${n.toU64() || 7} ${n.toInt()} ${n.toFloat()}"
}

fn cvf(x: Float) -> String {
    "${x.toInt() || -1}"
}

fn ch(n: Int) -> String {
    match Char.fromInt(n) {
        Some(c) -> "${c.toInt()}"
        None -> "none"
    }
}

fn mth(x: Float, y: Float) -> String {
    "${math.sqrt(x)} ${math.floor(x)} ${math.ceil(x)} ${math.round(x)} ${math.pow(x, y)}"
}

print ar8(-10, 3)
print bound()
print ar8(-7, 2)
print aru8(200, 1)
print ar32(2147483646, -1)
print ar32(-7, -2)
print aru32(65535, 65535)
print ar64(4611686018427387904, -2)
print ar64(-3074457345618258602, 3)
print aru64(4294967297, 4294967295)
print aru64(9223372036854775808, 1)
print sh8(1, 6)
print sh8(-64, 1)
print sh8(-1, 7)
print shu16(1, 15)
print shu16(65535, 0)
print sh64(1, 62)
print sh64(-1, 63)
print shu64(1, 63)
print wr8(127, 9)
print wr8(-128, -1)
print wr8(-3, -9)
print wru32(4294967295, 33)
print wru32(2147483648, 31)
print wr64(9223372036854775807, 65)
print wr64(-9223372036854775807 - 1, -1)
print wru64(18446744073709551615, 127)
print cv(300)
print cv(-129)
print cv(-1)
print cv(255)
print cv(9007199254740993)
print cv(-9223372036854775807 - 1)
print cvu(18446744073709551615)
print cvu(9223372036854775808)
print cvu(9223372036854775807)
print cvu(200)
print cvi8(-128)
print cvi8(127)
print cvf(2.9)
print cvf(-2.9)
print cvf(9223372036854775807.0)
print cvf(-9223372036854775808.0)
print cvf(-9223372036854777856.0)
print cvf(fdiv(1.0, 0.0))
print cvf(-fdiv(1.0, 0.0))
print cvf(fdiv(0.0, 0.0))
print cvf(9223372036854774784.0)
print ch(-1)
print ch(55295)
print ch(55296)
print ch(57343)
print ch(57344)
print ch(1114111)
print ch(1114112)
print mth(2.0, 0.5)
print mth(-2.5, 3.0)
print mth(2.5, -1.0)
print mth(-1.0, 0.5)
print mth(0.0, -1.0)
print mth(-0.5, 2.0)
print mth(fdiv(1.0, 0.0), 0.0)

fn fdiv(a: Float, b: Float) -> Float {
    a / b
}

fn add8(a: i8, b: i8) -> i8 {
    a + b
}

fn sub8(a: i8, b: i8) -> i8 {
    a - b
}

fn mul8(a: i8, b: i8) -> i8 {
    a * b
}

fn addu8(a: u8, b: u8) -> u8 {
    a + b
}

fn mulu64(a: u64, b: u64) -> u64 {
    a * b
}

fn mul64(a: Int, b: Int) -> Int {
    a * b
}

fn sub64(a: Int, b: Int) -> Int {
    a - b
}

fn div64(a: Int, b: Int) -> String {
    "${a / b} ${a % b}"
}

fn bound() -> String {
    "${add8(127, 0)} ${add8(-128, 127)} ${sub8(-128, 0)} ${sub8(-1, -128)} ${mul8(-128, 1)} ${mul8(-64, 2)} ${addu8(255, 0)} ${mulu64(4294967296, 4294967295)} ${mul64(-4611686018427387904, 2)} ${sub64(-9223372036854775807, 1)} ${div64(-9223372036854775807 - 1, 1)} ${div64(-9223372036854775807 - 1, -2)} ${div64(7, -3)}"
}

-- src --
import stdio from std/stdio
import {stdout} from std/stdio

fn inner() -> Void! {
    _ = stdout.write("inner\n".toBytes())?
}

fn call[F: Fn[fn() -> Void!]](f: F) -> Void! {
    f()
}

context (stdio.hostStdio(host)) {
    _ = call(() => {
        _ = inner()?
        ()
    })?
    _ = call(() => {
        _ = call(() => {
            _ = inner()?
            ()
        })?
        ()
    })?
}
-- stdout --
inner
inner

-- src --
import shell from std/shell
import hex from std/encoding/hex

fn dump(label: String, plan: shell.Plan) {
    let mut n = 0
    for st in shell.stages(&plan) {
        for a in &st.argv {
            if n > 0 {
                print "${label}: [${hex.encode(a.toBytes())}]"
            }
            n = n + 1
        }
    }
}

let x = "v"
dump("mixed-dq-bare", $"echo x\"a\\;b\"")
dump("sq-then-bare", $"echo 'a'b\\;c")
dump("interp-in-dq", $"echo \"${x}\\;\"")
dump("dq-then-bare", $"echo \"a\"b\\;c")
dump("bare-escaped-quote", $"echo a\\\"b c")
dump("dq-escaped-quote", $"echo \"a\\\"b\"")
dump("dq-even-run-closes", $"echo \"a\\\\\"b")
dump("dq-backslash-and-quote", $"echo \"a\\\\\\\"b\"")
dump("bare-backslash-before-interp", $"echo a\\${x}")
dump("dq-backslash-before-interp", $"echo \"a\\${x}\"")
dump("dollar-escape-in-dq", $"echo \"\${x}\"")
dump("sq-closed-by-escape", $"echo 'a\'")
dump("quote-escape-opens-sq", $"echo a\'b c'")
dump("unicode-backslash", $"echo a\u{5c}\u{5c}b")
dump("tab-escape-splits", $"echo a\tb")
dump("newline-escape-splits", $"echo a\nb")
dump("unicode-space-splits", $"echo a\u{20}b")
dump("sq-dq-bare", $"echo 'a'\"b\"c")
dump("interp-then-bare", $"echo ${x}\\;")
dump("sq-dollar-brace", $"echo '${'")
dump("sq-dollar-brace-quote", $"echo '${ \"'")
dump("sq-interp-text", $"echo '${x}'")
dump("hash-inside-words", $"echo a#b '#c' \"#d\"")

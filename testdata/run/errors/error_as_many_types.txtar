    if k == 33 { return E33 { v: k } }
    if k == 34 { return E34 { v: k } }
    if k == 35 { return E35 { v: k } }
    if k == 36 { return E36 { v: k } }
    if k == 37 { return E37 { v: k } }
    if k == 38 { return E38 { v: k } }
    if k == 39 { return E39 { v: k } }
    if k == 40 { return E40 { v: k } }
    if k == 41 { return E41 { v: k } }
    if k == 42 { return E42 { v: k } }
    if k == 43 { return E43 { v: k } }
    if k == 44 { return E44 { v: k } }
    if k == 45 { return E45 { v: k } }
    if k == 46 { return E46 { v: k } }
    if k == 47 { return E47 { v: k } }
    if k == 48 { return E48 { v: k } }
    if k == 49 { return E49 { v: k } }
    E0 { v: k }
}
let mut hits = 0
for k in 0..50 {
    let e = pick(k)

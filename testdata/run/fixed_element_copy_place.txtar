-- src --
type Pt = {
    pub mut x Int
    pub mut y Int
}

type Wrap = {
    pub mut a FixedArray[Pt, 3]
}

type Outer = {
    pub mut w Wrap
    pub mut tag Int
}

noalloc fn viaField(w: &mut Wrap, to: usize, from: usize) -> Unit {
    w.a[to] = w.a[from]
}

fn viaFieldPlain(w: &mut Wrap) -> Unit {
    w.a[0] = w.a[1]
}

noalloc fn viaDeep(o: &mut Outer) -> Unit {
    o.w.a[2] = o.w.a[0]
}

fn Wrap.shift(mut self) -> Unit {
    self.a[0] = self.a[2]
}

noalloc fn Wrap.shiftNa(mut self) -> Unit {
    self.a[1] = self.a[2]
}

fn show(w: &Wrap) -> String {
    "${w.a[0].x},${w.a[0].y} ${w.a[1].x},${w.a[1].y} ${w.a[2].x},${w.a[2].y}"
}

fn closureCopy() -> String {
    let mut cs = FixedArray.filled[Pt, 3](Pt { x: 1, y: 2 })
    cs[1] = Pt { x: 5, y: 6 }
    let f = () => {
        cs[0] = cs[1]
    }
    f()
    cs[1].x = 50
    "${cs[0].x},${cs[0].y} ${cs[1].x},${cs[1].y} ${cs[2].x},${cs[2].y}"
}

fn main() -> Unit! {
    let mut w = Wrap { a: FixedArray.filled[Pt, 3](Pt { x: 1, y: 2 }) }
    w.a[1] = Pt { x: 3, y: 4 }
    w.a[2] = Pt { x: 5, y: 6 }
    viaField(&mut w, 0, 1)
    print show(&w)
    w.a[0].x = 90
    print show(&w)
    w.a[1].y = 91
    print show(&w)
    viaField(&mut w, 2, 2)
    viaFieldPlain(&mut w)
    print show(&w)
    w.a[1].x = 7
    print show(&w)
    w.shift()
    w.a[2].y = 8
    print show(&w)
    w.shiftNa()
    w.a[1].x = 9
    print show(&w)
    let kept = w.a[0]
    w.shift()
    w.a[2].x = 10
    print "${kept.x},${kept.y} ${show(&w)}"

    let mut o = Outer { w: Wrap { a: FixedArray.filled[Pt, 3](Pt { x: 0, y: 0 }) }, tag: 1 }
    o.w.a[0] = Pt { x: 11, y: 12 }
    viaDeep(&mut o)
    o.w.a[0].x = 13
    print "${show(&o.w)} ${o.tag}"
    print closureCopy()
}
-- stdout --
3,4 3,4 5,6
90,4 3,4 5,6
90,4 3,91 5,6
3,91 3,91 5,6
3,91 7,91 5,6
5,6 7,91 5,8
5,6 9,8 5,8
5,6 5,8 9,8 10,8
13,12 0,0 11,12 1
5,6 50,6 1,2

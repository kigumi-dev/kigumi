-- src --
type Handle = resource {
    pub id Int
}

fn Handle.drop(move self) -> Unit {
    print "drop ${self.id}"
}

fn Handle.close(move self) -> Unit {
    print "close ${self.id}"
}

fn main() -> Unit! {
    let old = Handle { id: 1 }
    defer { old.close() }
    let current = Handle { id: 2 }
    defer { current.close() }
    print "both live ${old.id + current.id}"
}
-- stdout --
both live 3
close 2
drop 2
close 1
drop 1

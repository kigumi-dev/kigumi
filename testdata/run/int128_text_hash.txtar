-- src --
import text from std/text
fn o_i128(o: i128?) -> String {
    match o {
        Some(v) -> "Some(${v})"
        None -> "None"
    }
}

fn o_u128(o: u128?) -> String {
    match o {
        Some(v) -> "Some(${v})"
        None -> "None"
    }
}


print "[0] ${o_i128(text.parseI128("0"))} ${o_u128(text.parseU128("0"))}"

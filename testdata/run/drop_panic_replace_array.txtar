-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) -> Unit {
    print "drop ${self.id}"
}

type Bad = resource {
    pub id Int
}

fn Bad.drop(move self) -> Unit {
    print "bad ${self.id}"
    let _: Unit = None.expect("drop failed: ${self.id}")
}

fn scope() -> Unit {
    let a = Res { id: 1 }
    let mut xs = Array.of(Bad { id: 2 }, Bad { id: 5 })
    xs[0] = Bad { id: 4 }
    let c = Res { id: 3 }
    print "body"
}

scope()
print "unreachable"
-- stdout --
bad 2
bad 5
bad 4
drop 1
-- stderr --
panic: drop failed: 2
panic: drop failed: 5
panic: drop failed: 4
-- exit --
2

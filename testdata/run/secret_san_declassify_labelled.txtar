-- src --
import secret from std/secret

fn secretSeven() -> u64 {
    let mut t = FixedArray.filled[u64, 4](0)
    _ = t.set(2, 7)
    secret.ctLookupU64(&t, secret.SecretIndex[4].from(secret.SecretU32.classify(2)))
}

// Bytes derived from a secret leave SecretBuffer through declassify without tripping a sink inside std.
fn text(b: Bytes) -> String {
    match String.fromBytes(b) {
        Ok(s) -> s
        Err(_) -> "?"
    }
}

let buf = secret.SecretBuffer.fromBytes("k${secretSeven()}".toBytes())
print text(unsafe {
    buf.declassify()
})
-- stdout --
k7
-- secret-san --

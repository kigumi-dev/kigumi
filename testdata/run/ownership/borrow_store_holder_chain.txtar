fn moveHelperRead() -> String {
    let mut v = "v${churn()}"
    let u = "u"
    let mut a = Array.of(V { s: &u })
    let mut b = Array.of(V { s: &v })
    let mut s1 = Sink { items: &mut a }
    let mut s2 = Sink { items: &mut b }
    {
        let t = tk(&mut s2)
        if let Some(x) = t { s1.items.push(x) }
    }
    let out = "${a[1].s} ${a.len()}"
    v = "zz${churn()}"
    "${out} ${v}"

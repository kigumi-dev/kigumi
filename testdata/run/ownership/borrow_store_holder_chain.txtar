    let mut ps = Array.of(Pair { x: Sink { items: &mut a }, y: Sink { items: &mut b } })
    let k = &mut ps
    k[0].x.items.push(V { s: &v })
    v = "zz${churn()}"
    "${b[0].s} ${v}"
}
fn payloadPairInBlock() -> String {
    let mut v = "v${churn()}"
    let u = "u"
    let mut a = Array.of(V { s: &u })
    let mut c = Array.of(V { s: &u })
    {
        let mut q = PO { x: Some(Sink { items: &mut a }), y: Some(Sink { items: &mut c }) }
        let k = &mut q
        if let Some(it) = &mut k.x { it.items.push(V { s: &v }) }
    }
    v = "zz${churn()}"
    "${c.len()} ${c[0].s} ${v}"
}
fn movedRead() -> String {
    let mut v = "v${churn()}"
    let u = "u"
    let mut a = Array.of(V { s: &u })
    let mut b = Array.of(V { s: &v })
    let mut s1 = Sink { items: &mut a }
    let mut s2 = Sink { items: &mut b }
    mvall(&mut s1, &mut s2)
    let out = "${a[1].s} ${b.len()}"
    v = "zz${churn()}"
    "${out} ${v}"
}

-- src --
import map from std/map
import task from std/task

type V['a] = { pub s &'a String }
type Sink['a] = { pub mut items &'a mut Array[V['a]] }
type S2['a] = { pub mut inner &'a mut Sink['a] }
type Slot['a] = { pub mut v V['a] }
type SS['a] = { pub mut slot &'a mut Slot['a] }
type OS['a] = { pub mut o Option[Sink['a]] }
type Pair['a] = { pub mut x Sink['a], pub mut y Sink['a] }
type H['a] = { pub mut fs &'a mut Array[Future[String]] }
type H2['a] = { pub mut inner &'a mut H['a] }
type PO['a] = { pub mut x Option[Sink['a]], pub mut y Option[Sink['a]] }
type W['a] = { pub mut inner &'a mut Sink['a] }
type Mix['a] = { pub s &'a String, pub k &'a mut Array[V['a]] }
type PairH['a] = { pub p Mix['a], pub n Int }
fn pushV['a](k: &mut Sink['a], x: V['a]) { k.items.push(x) }
fn pushV2['a](k: &mut S2['a], x: V['a]) { k.inner.items.push(x) }
fn noop['a](k1: &mut Sink['a], k2: &mut Sink['a]) { }
fn readOnly['a](k: &mut Sink['a], x: V['a]) -> usize { k.items.len() }
fn pushOne['a](k1: &mut Sink['a], k2: &mut Sink['a], x: V['a]) { k1.items.push(x) }
async fn show(r: &String) -> String { "${r}" }
fn pushF1['a](k: &mut H['a], f: Future[String]) { k.fs.push(f) }
fn pushF2['a](k: &mut H2['a], f: Future[String]) { k.inner.fs.push(f) }
fn pushX['a](k: &mut Pair['a], x: V['a]) { k.x.items.push(x) }
fn mvall['a](k1: &mut Sink['a], k2: &mut Sink['a]) { let t = k2.items.takeAt(0); if let Some(x) = t { k1.items.push(x) } }
fn tk['a](k: &mut Sink['a]) -> Option[V['a]] { k.items.takeAt(0) }
fn recY['a](p: &mut Pair['a], n: Int, x: V['a]) { if n > 0 { recY(p, n - 1, x) } else { p.y.items.push(x) } }
fn mf['a](p: &mut Pair['a], n: Int, x: V['a]) { if n > 0 { mg(p, n - 1, x) } else { p.y.items.push(x) } }
fn mg['a](p: &mut Pair['a], n: Int, x: V['a]) { mf(p, n, x) }
fn mvP['a](k1: &mut Array[V['a]], k2: &mut Array[V['a]]) { let t = k2.takeAt(0); if let Some(x) = t { k1.push(x) } }
fn pushByValue['a](k: Sink['a], x: V['a]) { k.items.push(x) }
fn churn() -> Int { let mut arr: Array[String] = Array.of("x"); for i in 100..400 { arr.push("w${i}") }; arr.len().toInt() || 0 }

fn twoHops() -> String {
    let mut v = "v${churn()}"
    let u = "u"
    let mut a = Array.of(V { s: &u })
    let mut sk = Sink { items: &mut a }
    let k = &mut sk
    k.items.push(V { s: &v })
    let n = churn()
    let out = "${a[1].s} ${n} ${a.len()}"
    v = "zz${churn()}"
    "${out} ${v}"
}
fn threeHops() -> String {
    let mut v = "v${churn()}"
    let u = "u"
    let mut a = Array.of(V { s: &u })
    let mut sk = Sink { items: &mut a }
    let mut s2 = S2 { inner: &mut sk }
    let k = &mut s2
    k.inner.items.push(V { s: &v })
    let out = "${a[1].s} ${churn()}"
    v = "zz${churn()}"
    "${out} ${v}"
}
fn indexHop() -> String {
    let mut v = "v${churn()}"
    let u = "u"
    let mut a = Array.of(V { s: &u })
    let mut sks = Array.of(Sink { items: &mut a })
    let k = &mut sks
    k[0].items.push(V { s: &v })
    let out = "${a[1].s} ${churn()}"
    v = "zz${churn()}"
    "${out} ${v}"
}
fn passHolder() -> String {
    let mut v = "v${churn()}"
    let u = "u"
    let mut a = Array.of(V { s: &u })
    let mut sk = Sink { items: &mut a }
    pushV(&mut sk, V { s: &v })
    let out = "${a[1].s} ${churn()}"
    v = "zz${churn()}"
    "${out} ${v}"
}

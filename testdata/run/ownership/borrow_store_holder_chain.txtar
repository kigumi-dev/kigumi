    let out = "${a[1].s} ${churn()}"
    v = "zz${churn()}"
    "${out} ${v}"
}
fn noopTwo() -> String {
    let u = "u"
    let mut a = Array.of(V { s: &u })
    let mut b = Array.of(V { s: &u })
    let mut s1 = Sink { items: &mut a }
    let mut s2 = Sink { items: &mut b }
    noop(&mut s1, &mut s2)
    "${a.len()} ${b.len()}"
}
fn readOnlyHolder() -> String {
    let mut v = "v${churn()}"
    let u = "u"
    let mut a = Array.of(V { s: &u })
    let mut sa = Sink { items: &mut a }
    let n = readOnly(&mut sa, V { s: &v })
    v = "zz${churn()}"
    "${a[0].s} ${n} ${v}"
}
fn pairDisjoint() -> String {
    let mut v = "v${churn()}"
    let u = "u"
    let mut a = Array.of(V { s: &u })
    let mut b = Array.of(V { s: &u })
    let mut p = Pair { x: Sink { items: &mut a }, y: Sink { items: &mut b } }
    let k = &mut p
    k.x.items.push(V { s: &v })
    v = "zz${churn()}"
    "${b[0].s} ${v}"
}
fn oneOfTwo() -> String {
    let mut v = "v${churn()}"
    let u = "u"
    let mut a = Array.of(V { s: &u })
    let mut b = Array.of(V { s: &u })
    let mut s1 = Sink { items: &mut a }
    let mut s2 = Sink { items: &mut b }
    pushOne(&mut s1, &mut s2, V { s: &v })
    let first = "${a[1].s}"
    v = "zz${churn()}"
    "${first} ${b[0].s} ${v}"
}
fn carryAwaited() -> String {
    let ex = task.currentThreadExecutor()
    let mut fs = Array.empty[Future[String]]()
    let mut h = H { fs: &mut fs }
    let mut x = "val${churn()}"
    pushF1(&mut h, show(&x))
    let mut s = ""
    for f in fs { s = "${s}${ex.runToCompletion(f)}" }
    x = "zz${churn()}"
    "${s} ${x}"
}
fn carryAwaitedTwoHops() -> String {
    let ex = task.currentThreadExecutor()
    let mut fs = Array.empty[Future[String]]()
    let mut h = H { fs: &mut fs }
    let mut h2 = H2 { inner: &mut h }
    let mut x = "val${churn()}"
    pushF2(&mut h2, show(&x))
    let mut s = ""
    for f in fs { s = "${s}${ex.runToCompletion(f)}" }
    x = "zz${churn()}"
    "${s} ${x}"
}

    let mut v = "v${churn()}"
    let u = "u"
    let mut a = Array.of(V { s: &u })
    let mut sk = Sink { items: &mut a }
    let k = &mut sk
    pushV(k, V { s: &v })
    let out = "${a[1].s} ${churn()}"
    v = "zz${churn()}"
    "${out} ${v}"
}
fn setFieldTwo() -> String {
    let mut v = "v${churn()}"
    let u = "u"
    let mut sl = Slot { v: V { s: &u } }
    let mut ss = SS { slot: &mut sl }
    let k = &mut ss
    k.slot.v = V { s: &v }
    let out = "${sl.v.s} ${churn()}"
    v = "zz${churn()}"
    "${out} ${v}"
}
fn setIndexTwo() -> String {
    let mut v = "v${churn()}"
    let u = "u"
    let mut a = Array.of(V { s: &u })
    let mut sk = Sink { items: &mut a }
    let k = &mut sk
    k.items[0] = V { s: &v }
    let out = "${a[0].s} ${churn()}"
    v = "zz${churn()}"
    "${out} ${v}"
}
fn optionHop() -> String {
    let mut v = "v${churn()}"
    let u = "u"
    let mut a = Array.of(V { s: &u })
    {
        let mut os = OS { o: Some(Sink { items: &mut a }) }
        let k = &mut os
        if let Some(it) = &mut k.o { it.items.push(V { s: &v }) }
    }
    let out = "${a[1].s} ${churn()}"
    v = "zz${churn()}"
    "${out} ${v}"
}

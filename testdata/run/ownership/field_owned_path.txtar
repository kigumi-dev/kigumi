-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {
    print "drop ${self.id}"
}

fn mk(id: Int) -> Res {
    Res { id: id }
}

type Cell = {
    pub v Res
    pub o Res?
}

type Id = Res

type W = {
    pub id Id
    pub c Cell
}

fn cell(v: Int, o: Int?) -> Cell {
    Cell { v: mk(v), o: if o is Some(i) { Some(mk(i)) } else { None } }
}

fn w(id: Int, v: Int, o: Int?) -> W {
    W { id: Id(mk(id)), c: cell(v, o) }
}

fn nested(x: W, o: Res?) -> Res {
    o || x.c.v
}

fn nestedLhs(x: W, y: Res) -> Res {
    x.c.o || y
}

fn temp(o: Res?) -> Res {
    o || cell(50, None).v
}

fn wholeValue(i: Id) -> Res {
    let r = i.value
    r
}

fn fieldValue(x: W, c: Bool, y: Res) -> Res {
    if c { x.id.value } else { y }
}

fn explicitMove(x: W) -> Res {
    let r = move x.c.v
    r
}

fn show(r: Res) {
    print "got ${r.id}"
}

show(nested(w(1, 2, None), None))
show(nested(w(3, 4, None), Some(mk(5))))
show(nestedLhs(w(6, 7, Some(8)), mk(9)))
show(nestedLhs(w(10, 11, None), mk(12)))
show(temp(None))
show(temp(Some(mk(13))))
show(wholeValue(Id(mk(14))))
show(fieldValue(w(15, 16, None), true, mk(17)))
show(fieldValue(w(18, 19, None), false, mk(20)))
show(explicitMove(w(21, 22, Some(23))))
print "done"
-- stdout --

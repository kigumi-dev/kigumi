-- src --
type H[F] = { pub mut f F }
type R[F] = { pub mut f F }
type P = { pub mut a Int, pub mut b Int }
type Q = { pub mut p P, pub mut c Int }

fn P.incA(mut self) -> Int { self.a = self.a + 1; 0 }
fn P.getB(self) -> Int { self.b }
fn Q.incPA(mut self) -> Int { self.p.a = self.p.a + 1; 0 }
fn both2[F: FnMut[fn() -> Void]](f: fn() -> Int, mut g: F) -> Int { g(); f() }
fn both4[F: FnMut[fn() -> Void]](f: fn() -> Int, mut r: R[F]) -> Int { r.f(); f() }
fn bothRefH[F: FnMut[fn() -> Void]](f: fn() -> Int, h: &mut H[F]) -> Int { h.f(); f() }
fn apply2(f: fn() -> Int, x: Int) -> Int { f() + x }
fn applyF[F: Fn[fn() -> Int]](f: F, x: Int) -> Int { f() + x }
fn applyM[F: FnMut[fn() -> Int]](mut f: F, x: Int) -> Int { f() + x }
fn bump(k: &mut Int) -> Int { k = k + 1; 0 }
fn peek(k: &Int) -> Int { k * 10 }
fn runIt[F: FnMut[fn() -> Void]](mut f: F) -> Int { f(); 0 }

fn laterBlockReads() -> String {
    let mut k = 1
    let mut seen = 0
    let a = both2(() => k, { seen = k + 1; () => { } })
    let b = both2(() => 0, () => { k = k + 1 })
    "${a} ${seen} ${k}"
}

fn laterValueReads() -> String {
    let mut k = 1
    let a = apply2(() => k, { k + 1 })
    let b = both2(() => 0, () => { k = k + 1 })
    "${a} ${k}"
}

fn laterBorrowReads() -> String {
    let mut k = 1
    let a = apply2(() => k, peek(&k))
    let b = bump(&mut k)
    "${a} ${k}"
}

fn laterRunsReader() -> String {
    let mut k = 1
    let mut seen = 0
    let mut w = () => { seen = k + 1 }
    let a = apply2(() => k, { w(); 0 })
    let b = runIt(w)
    let c = both2(() => 0, () => { k = k + 1 })
    "${a} ${seen} ${k}"
}

fn laterCallRunsReader() -> String {
    let mut k = 1
    let mut seen = 0
    let a = apply2(() => k, runIt(() => { seen = k + 5 }))
    let b = both2(() => 0, () => { k = k + 1 })
    "${a} ${seen} ${k}"
}

fn laterReceiverReads() -> String {
    let mut p = P { a: 1, b: 2 }
    let a = apply2(() => p.a, p.getB())
    let b = p.incA()
    "${a} ${p.a}"
}

fn laterWritesOtherField() -> String {
    let mut p = P { a: 1, b: 2 }
    let a = apply2(() => p.a, { p.b = 5; p.getB() })
    "${a} ${p.b}"
}

fn earlierNamedArgWrites() -> String {
    let mut k = 1
    let a = apply2(x: { k = k + 1; 0 }, f: () => k)
    let b = both2(() => 0, () => { k = k + 1 })
    "${a} ${k}"
}

fn laterNestedCallReads() -> String {
    let mut k = 1
    let a = apply2(() => k, apply2(() => 0, { k + 1 }))
    let b = both2(() => 0, () => { k = k + 1 })
    "${a} ${k}"
}

fn laterWriteLeaves(c: Bool) -> Int {
    let mut k = 1
    apply2(() => k, { if c { k = k + 1; return 0 }; 0 })
}

fn namedReaderLaterRead() -> String {
    let mut k = 1
    let r = () => k
    let a = apply2(r, { k + 1 })
    let b = both2(() => 0, () => { k = k + 1 })
    "${a} ${k}"
}

fn fnBoundLaterRead() -> Int {
    let mut k = 1
    applyF(() => k, { k + 1 })
}

fn sharedLaterWrite() -> Int {
    let mut k = 1
    applyM(() => k, { k = k + 1; 0 })
}

fn sharedLaterBorrow() -> Int {
    let mut k = 1
    applyM(() => k, bump(&mut k))
}

fn sharedLaterReceiver() -> Int {
    let mut p = P { a: 1, b: 2 }
    applyM(() => p.a, p.incA())
}

fn sharedLaterNamedArg() -> Int {
    let mut k = 1
    applyM(x: { k = k + 10; 0 }, f: () => k) + applyM(f: () => k, x: { k = k + 100; 0 })
}

fn recordArgReads() -> String {
    let mut k = 1
    let mut seen = 0
    let a = both4(() => k, R { f: () => { seen = k + 1 } })
    let b = both2(() => 0, () => { k = k + 1 })
    "${a} ${seen} ${k}"
}

fn recordRefReads() -> String {
    let mut k = 1
    let mut seen = 0
    let mut h = H { f: () => { seen = k + 1 } }
    let a = bothRefH(() => k, &mut h)
    let b = both2(() => 0, () => { k = k + 1 })
    "${a} ${seen} ${k}"
}

fn laterWritesOtherFieldThroughCalls() -> String {
    let mut p = P { a: 1, b: 2 }
    let x = apply2(() => p.b, p.incA())
    let y = apply2(() => p.b, bump(&mut p.a))
    let mut q = Q { p: P { a: 1, b: 2 }, c: 3 }
    let z = apply2(() => q.p.b + q.c, q.incPA())
    let w = apply2(() => q.p.b + q.c, q.p.incA())
    "${x} ${y} ${p.a} ${z} ${w} ${q.p.a}"
}

interface Runner { fn run(self, f: fn() -> Int, x: Int) -> Int }
interface SiblingRunner { fn both(self, f: fn() -> Int, g: fn() -> Void, x: Int) -> Int }
@impl(Runner, SiblingRunner)
type RunnerValue = { pub n Int }
fn RunnerValue.run(self, f: fn() -> Int, x: Int) -> Int { f() + x + self.n }
fn RunnerValue.both(self, f: fn() -> Int, g: fn() -> Void, x: Int) -> Int { g(); f() + x + self.n }

fn viaBound[T: Runner](r: &T) -> Int {
    let mut k = 1
    let a = r.run(() => k, { k + 1 })
    a + bump(&mut k)
}

fn viaBoundVal[T: Runner](r: T) -> Int {
    let mut k = 1
    let a = r.run(() => k, { k + 1 })
    a + bump(&mut k)
}

fn besideBound[T: Runner](r: &T) -> Int {
    let mut k = 1
    let mut seen = 0
    let mut w = () => { seen = k + 1 }
    let a = r.run(() => k, { w(); 0 })
    let b = bump(&mut k)
    a + seen
}

fn viaView(r: &Runner) -> Int {
    let mut k = 1
    let a = r.run(() => k, { k + 1 })
    a + bump(&mut k)
}

fn boundSibling[T: SiblingRunner](r: &T) -> Int {
    let mut k = 1
    let mut seen = 0
    let mut w = () => { seen = k + 1 }
    let a = r.both(() => k, () => w(), 0)
    let b = bump(&mut k)
    a + seen
}

fn P.useF(mut self, f: fn() -> Int) -> Int { self.a = self.a + 1; f() }
fn P.useG(mut self, f: fn() -> Int) -> Int { self.a = self.a + 1; f() }

fn sameCallReceiverWritesOther() -> String {
    let mut p = P { a: 1, b: 2 }
    let x = p.useG(() => p.b)
    let mut q = P { a: 1, b: 2 }
    let a = q.a
    let y = q.useF(() => a)
    "${x} ${p.a} ${y} ${q.a}"
}

fn loopLentWindows() -> String {
    let mut k = 1
    let mut s = 0
    for i in 0..2 { s = s + apply2(() => k, 0); k = k + 1 }
    let mut t = 0
    let mut j = 0
    for j < 2 { t = t + apply2(() => k, { if j == 5 { k = k + 1; continue }; 0 }); j = j + 1 }
    "${s} ${k} ${t}"
}

fn loopContinue() -> String {
    let mut k = 1
    let mut t = 0
    let mut j = 0
    for j < 3 {
        t = t + apply2(() => k, { if j == 1 { k = k + 1; j = j + 1; continue }; 0 })
        j = j + 1
    }
    "${t} ${k} ${j}"
}

fn main() {
    print "${laterBlockReads()} | ${laterValueReads()} | ${laterBorrowReads()} | ${laterRunsReader()} | ${laterCallRunsReader()}"
    print "${laterReceiverReads()} | ${laterWritesOtherField()} | ${earlierNamedArgWrites()} | ${laterNestedCallReads()}"
    print "${laterWriteLeaves(true)} ${laterWriteLeaves(false)} | ${namedReaderLaterRead()} | ${fnBoundLaterRead()}"
    print "${sharedLaterWrite()} ${sharedLaterBorrow()} ${sharedLaterReceiver()} ${sharedLaterNamedArg()}"
    print "${recordArgReads()} | ${recordRefReads()} | ${laterWritesOtherFieldThroughCalls()}"
    let r = RunnerValue { n: 0 }
    print "${viaBound(&r)} ${viaBoundVal(r)} ${besideBound(&r)} ${viaView(&r)} ${boundSibling(&r)}"
    print "${sameCallReceiverWritesOther()} | ${loopLentWindows()} | ${loopContinue()}"
}
-- stdout --
1 2 2 | 3 2 | 11 2 | 1 2 2 | 1 6 2
3 2 | 6 5 | 2 3 | 3 2
0 1 | 3 2 | 3
2 2 2 122
1 2 2 | 1 2 2 | 2 2 3 5 5 3
3 3 3 3 3
2 2 1 2 | 3 3 6 | 3 2 3

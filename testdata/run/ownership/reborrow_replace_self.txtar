-- src --
import a from lib/a
import b from lib/b

let mut direct = a.Rebound { n: 1 }
b.growAny(&mut direct, 2)
print "direct ${direct.n}"
let mut chained = a.Chained { n: 1 }
b.growAny(&mut chained, 3)
print "chained ${chained.n}"
let mut kept = a.Kept { n: 1 }
b.growAny(&mut kept, 4)
print "kept ${kept.n}"
let mut plain = a.Rebound { n: 1 }
plain.grow(5)
print "plain ${plain.n}"
-- lib/a/a.kg --
fn reset(p: &mut Rebound, k: Int) {
    p = Rebound { n: k }
}

pub type Rebound = {
    pub mut n Int
}

pub fn Rebound.grow(mut self, k: Int) {
    reset(&mut self, k)
}

fn forward(p: &mut Chained, k: Int) {
    swap(p, k)
}

fn swap(p: &mut Chained, k: Int) {
    p = Chained { n: k }
}

pub type Chained = {
    pub mut n Int
}

pub fn Chained.grow(mut self, k: Int) {
    forward(&mut self, k)
}

fn bump(p: &mut Kept, k: Int) {
    p.n = p.n + k
}

pub type Kept = {
    pub mut n Int
}

pub fn Kept.grow(mut self, k: Int) {
    bump(&mut self, k)
}
-- lib/b/b.kg --
pub interface Grower {
    fn grow(mut self, k: Int)
}

pub fn growAny[G: Grower](x: &mut G, k: Int) {
    x.grow(k)
}
-- stdout --
direct 2
chained 3
kept 5
plain 5

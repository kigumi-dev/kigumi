-- src --
import {Shared} from std/alloc

type Point = {
    pub mut x Int
    pub mut y Int
}

fn put(s: &Shared[FixedArray[Point, 2]], i: usize, p: Point) {
    s.withMut((a) => {
        a[i] = p
    })
}

fn swap01(s: &Shared[FixedArray[Point, 2]]) {
    s.withMut((a) => {
        let t = a[0]
        a[0] = a[1]
        a[1] = t
    })
}

fn nested(s: &Shared[FixedArray[Point, 2]], t: &Shared[Point]) {
    s.withMut((a) => {
        t.withMut((p) => {
            a[1] = Point { x: p.x + 10, y: p.y + 10 }
        })
    })
}

fn main() -> Void! {
    let s = Shared.new(FixedArray.filled[Point, 2](Point { x: 1, y: 2 }))
    let t = Shared.new(Point { x: 7, y: 8 })
    put(&s, 0, Point { x: 5, y: 6 })
    nested(&s, &t)
    s.with((a) => {
        print "c=${a[0].x} ${a[0].y} ${a[1].x} ${a[1].y}"
    })
    swap01(&s)
    s.with((a) => {
        print "c=${a[0].x} ${a[0].y} ${a[1].x} ${a[1].y}"
    })
}
-- stdout --
c=5 6 17 18
c=17 18 5 6

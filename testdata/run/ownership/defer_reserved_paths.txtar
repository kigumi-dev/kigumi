-- src --
import test from std/test

type Handle = resource {
    pub mut id Int
}

fn Handle.drop(move self) {
    print "drop ${self.id}"
}

fn Handle.close(move self) {
    print "close ${self.id}"
}

fn Handle.peek(self) -> Int {
    self.id
}

fn Handle.bump(mut self) {
    self.id = self.id + 1
}

fn show(h: &Handle) {
    print "show ${h.id}"
}

fn take(h: Handle) {
    print "take ${h.id}"
}

fn normal() -> Void! {
    let h = Handle { id: 1 }
    defer { h.close() }
    print "normal body ${h.peek()}"
}

fn typedErr(failIt: Bool) -> Void! {
    let h = Handle { id: 2 }
    defer(fail) { h.close() }
    print "typed body"
    if failIt {
        fail test.failure("boom")
    }
}

fn early(skip: Bool) -> Void! {
    if skip {
        return
    }
    let h = Handle { id: 3 }
    defer { h.close() }
    print "early body"
}

fn loops() {
    for i in 0..4 {
        let h = Handle { id: 10 + i }
        defer { h.close() }
        if i == 1 { continue }
        if i == 2 { break }
        print "iter ${i}"
    }
}

fn loopErr(failAt: Int) -> Void! {
    for i in 0..3 {
        let h = Handle { id: 20 + i }
        defer(fail) { h.close() }
        if i == failAt {
            fail test.failure("loop")
        }
    }
}

fn param(h: Handle) {
    defer { h.close() }
    print "param body ${h.peek()}"
}

fn conditional(flag: Bool, failIt: Bool) -> Void! {
    let h = Handle { id: 5 }
    if flag {
        defer(fail) { h.close() }
        print "in if"
        if failIt {
            fail test.failure("inside")
        }
    }
    take(h)
}

fn twoBindings() -> Void! {
    let first = Handle { id: 40 }
    defer { first.close() }
    let second = Handle { id: 41 }
    defer { second.close() }
    print "both open ${first.peek() + second.peek()}"
}

fn borrowsAllowed() -> Void! {
    let mut h = Handle { id: 50 }
    defer { h.close() }
    h.bump()
    h.id = h.id + 100
    show(&h)
    h.id = h.id + 10
    print "body ${h.id}"
}

normal() || (e) => print "err ${e.message()}"
typedErr(false) || (e) => print "err ${e.message()}"
typedErr(true) || (e) => print "err ${e.message()}"
early(true) || (e) => print "err ${e.message()}"
early(false) || (e) => print "err ${e.message()}"
loops()
loopErr(5) || (e) => print "err ${e.message()}"
loopErr(1) || (e) => print "err ${e.message()}"
param(Handle { id: 30 })
conditional(false, false) || (e) => print "err ${e.message()}"
conditional(true, false) || (e) => print "err ${e.message()}"
conditional(true, true) || (e) => print "err ${e.message()}"
twoBindings() || (e) => print "err ${e.message()}"
borrowsAllowed() || (e) => print "err ${e.message()}"

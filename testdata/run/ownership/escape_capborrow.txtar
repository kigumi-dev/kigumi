-- src --
type Handle = resource {
    pub id Int
}

fn Handle.drop(move self) {
    print "drop ${self.id}"
}

fn Handle.touch(self) {
    print "touch ${self.id}"
}

// callTwice's cb is non-escaping by default, so the caller may lend a move-only capture (capBorrow)
// and still use the owner after the call returns.
fn callTwice(cb: fn() -> Void) {
    cb()
    cb()
}

let h = Handle { id: 1 }
callTwice(() => h.touch())
print "after call"
-- stdout --
touch 1
touch 1
after call
drop 1

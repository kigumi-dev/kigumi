-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {
    print "drop ${self.id}"
}

fn Res.close(move self) {
    print "close ${self.id}"
}

fn Res.peek(self) -> Int {
    self.id
}

fn mkr(n: Int) -> Res {
    Res { id: n }
}

type Pair = {
    pub left Res
    pub right Res
}

fn matchThenRefill() {
    let mut o = Some(mkr(1))
    match o {
        Some(r) -> r.close()
        None -> print "none"
    }
    o = Some(mkr(2))
    match o {
        Some(r) -> print "kept ${r.peek()}"
        None -> print "none"
    }
    print "end matchThenRefill"
}

fn tryOnce(r: Result[Res, String]) -> Result[Int, String] {
    let a = r?
    let n = a.peek()
    a.close()
    Ok(n)
}

fn orOnce(o: Res?) {
    let a = o || mkr(99)
    print "or ${a.peek()}"
}

fn ifLetThenReinit() {
    let mut o = Some(mkr(3))
    if let Some(r) = o {
        r.close()
    }
    o = None
    o = Some(mkr(4))
    print "end ifLetThenReinit"
}

fn recordPattern() {
    let p = Pair { left: mkr(5), right: mkr(6) }
    match p {
        Pair { left, right } -> {
            right.close()
            print "left ${left.peek()}"
        }
    }
    print "end recordPattern"
}

fn borrowedTwice() {
    let o = Some(mkr(7))
    match &o {
        Some(r) -> print "peek ${r.peek()}"
        None -> {}
    }
    match &o {
        Some(r) -> print "peek again ${r.peek()}"
        None -> {}
    }
    match o {
        Some(r) -> r.close()
        None -> {}
    }
}

fn arrayOwnedOnce() {
    let o = Some(Array.of(1, 2, 3))
    let mut a = match o {
        Some(xs) -> xs
        None -> Array.of()
    }
    a.push(9)
    print "len ${a.len()}"
}

fn isAndElse(c: Bool) {
    let o = Some(mkr(12))
    if o is Some(r) && c {
        r.close()
    } else {
        match o {
            Some(x) -> x.close()
            None -> print "none"
        }
    }
}

fn closeOpt(o: Res?) {
    match o {
        Some(r) -> r.close()
        None -> {}
    }
}

fn peekOpt(o: &Res?) -> Bool {
    match o {
        Some(r) -> r.peek() > 0
        None -> false
    }
}

fn guardReadsByRef(o: Res?) {
    match o {
        Some(r) if peekOpt(&o) -> r.close()
        _ -> {}
    }
}

fn chainFailsThenUse(o: Res?, c: Bool) {
    if o is Some(r) && c {
        r.close()
    } else {
        closeOpt(o)
    }
}

fn guardFailsToOther(o: Res?) {
    match o {
        Some(r) if r.peek() > 25 -> r.close()
        other -> closeOpt(other)
    }
}

type Slot = {
    pub mut o Res?
    pub n Int
}

fn closeSlot(s: Slot) {
    match s.o {
        Some(r) -> r.close()
        None -> print "slot empty ${s.n}"
    }
}

fn fieldReinit(s: Slot) {
    let mut v = s
    match v.o {
        Some(r) -> r.close()
        None -> print "none"
    }
    print "slot n ${v.n}"
    v.o = Some(mkr(71))
    closeSlot(v)
    print "end fieldReinit"
}

type SlotBox = {
    pub mut s Slot
}

fn catchAllLocal() {
    let s = Slot { o: Some(mkr(80)), n: 0 }
    match s.o {
        other -> print "catch-all local"
    }
    print "end catchAllLocal"
}

fn catchAllParam(s: Slot) {
    match s.o {
        other -> print "catch-all param"
    }
    print "end catchAllParam"
}

fn catchAllNested(b: SlotBox) {
    match b.s.o {
        other -> print "catch-all nested"
    }
    print "end catchAllNested"
}

fn catchAllRecordField(b: SlotBox) {
    match b.s {
        s2 -> print "catch-all record ${s2.n}"
    }
    print "end catchAllRecordField"
}

fn catchAllPairField(p: Pair) {
    match p.left {
        x -> print "catch-all left ${x.peek()}"
    }
    print "end catchAllPairField"
}

fn catchAllMoved(s: Slot) {
    match move s.o {
        other -> print "catch-all moved"
    }
    print "end catchAllMoved"
}

fn catchAllThenReassign() {
    let mut s = Slot { o: Some(mkr(86)), n: 0 }
    match s.o {
        other -> print "catch-all then reassign"
    }
    s.o = None
    print "end catchAllThenReassign"
}

fn catchAllThenMatch(s: Slot) {
    match s.o {
        other -> match other {
            Some(r) -> r.close()
            None -> {}
        }
    }
    print "end catchAllThenMatch"
}

fn wholeReinit() {
    let mut o = Some(mkr(90))
    match o {
        x -> closeOpt(x)
    }
    o = Some(mkr(91))
    closeOpt(o)
    print "end wholeReinit"
}

fn wholeKept(o: Res?) {
    match o {
        x -> print "whole kept"
    }
    print "end wholeKept"
}

fn wholeGuarded(o: Res?, g: Bool) {
    match o {
        x if g -> closeOpt(x)
        other -> print "whole guard failed"
    }
    print "end wholeGuarded ${g}"
}

fn wholeIfLet(o: Res?) {
    if let x = o {
        print "whole if let"
    }
    print "end wholeIfLet"
}

fn wholeAfterBorrow(o: Res?) {
    let r = &o
    print "borrowed ${peekOpt(r)}"
    match o {
        x -> closeOpt(x)
    }
}

fn leadingAndIs(o: Res?, c: Bool) {
    if c && o is x {
        closeOpt(x)
    } else {
        print "and skipped"
    }
    print "end leadingAndIs ${c}"
}

fn leadingAndIsSome(o: Res?, c: Bool) {
    if c && o is Some(r) {
        r.close()
    }
    print "end leadingAndIsSome ${c}"
}

fn guardReadsBinding(o: Res?) {
    match o {
        x if { match &x { Some(r) -> r.peek() > 100, None -> false } } -> closeOpt(x)
        other -> closeOpt(other)
    }
    print "end guardReadsBinding"
}

matchThenRefill()
print "try ${tryOnce(Ok(mkr(10))) || 0}"
print "try ${tryOnce(Err("no")) || 0}"
orOnce(Some(mkr(11)))
orOnce(None)
ifLetThenReinit()
recordPattern()
borrowedTwice()
arrayOwnedOnce()
isAndElse(true)
isAndElse(false)
guardReadsByRef(Some(mkr(21)))
chainFailsThenUse(Some(mkr(22)), false)
chainFailsThenUse(Some(mkr(23)), true)
guardFailsToOther(Some(mkr(24)))
guardFailsToOther(Some(mkr(26)))
fieldReinit(Slot { o: Some(mkr(70)), n: 5 })
fieldReinit(Slot { o: None, n: 6 })
catchAllLocal()
catchAllParam(Slot { o: Some(mkr(81)), n: 0 })
catchAllNested(SlotBox { s: Slot { o: Some(mkr(82)), n: 0 } })
catchAllRecordField(SlotBox { s: Slot { o: Some(mkr(83)), n: 9 } })
catchAllPairField(Pair { left: mkr(84), right: mkr(85) })
catchAllMoved(Slot { o: Some(mkr(87)), n: 0 })
catchAllThenReassign()
catchAllThenMatch(Slot { o: Some(mkr(88)), n: 0 })
wholeReinit()
wholeKept(Some(mkr(92)))
wholeGuarded(Some(mkr(93)), true)
wholeGuarded(Some(mkr(94)), false)
wholeIfLet(Some(mkr(95)))
wholeAfterBorrow(Some(mkr(96)))
leadingAndIs(Some(mkr(100)), true)
leadingAndIs(Some(mkr(101)), false)
leadingAndIsSome(Some(mkr(102)), true)
leadingAndIsSome(Some(mkr(103)), false)
guardReadsBinding(Some(mkr(104)))
guardReadsBinding(Some(mkr(5)))

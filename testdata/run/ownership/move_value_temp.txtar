-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {
    print "drop ${self.id}"
}

fn mk(id: Int) -> Res {
    Res { id: id }
}

type Id = Res

type W = {
    pub id Id
    pub r Res
    pub n Int
}

type Cell = {
    pub v Res
    pub o Res?
}

fn w(a: Int, b: Int) -> W {
    W { id: Id(mk(a)), r: mk(b), n: a }
}

fn cell(v: Int, o: Int?) -> Cell {
    Cell { v: mk(v), o: if o is Some(i) { Some(mk(i)) } else { None } }
}

fn valueField(x: W) -> Res {
    move x.id.value
}

fn valueFieldFallback(x: W, o: Res?) -> Res {
    o || move x.id.value
}

fn valueBinding(i: Id) -> Res {
    move i.value
}

fn tempField(o: Res?) -> Res {
    o || move cell(30, Some(31)).v
}

fn tempFieldLet() -> Res {
    let r = move cell(40, None).v
    r
}

fn show(r: Res) {
    print "got ${r.id}"
}

show(valueField(w(1, 2)))
show(valueFieldFallback(w(3, 4), None))
show(valueFieldFallback(w(5, 6), Some(mk(7))))
show(valueBinding(Id(mk(8))))
show(tempField(None))
show(tempField(Some(mk(9))))
show(tempFieldLet())
print "done"
-- stdout --
drop 2
got 1
drop 1
drop 4
got 3
drop 3
drop 6
drop 5
got 7
drop 7
got 8
drop 8
drop 31
got 30
drop 30
got 9
drop 9
got 40
drop 40
done

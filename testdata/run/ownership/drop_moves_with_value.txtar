drop 9
left 8
drop 8
end recordFields
consume 10
drop 10
end wildcardKeepsRest
drop 11
consume 12
drop 12
end andChain true
end andChain false
drop 12
drop 13
got 13
end movedClosure
consume 14
drop 14
consume 15
drop 15
consume 16
drop 16
end recordCopyRead 5 6 7
consume 17
consume 19
drop 19
left 18
drop 18
end recordGuarded 0 8
drop 17

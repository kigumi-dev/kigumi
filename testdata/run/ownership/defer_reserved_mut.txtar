-- src --
import test from std/test
import {BytesWriter} from std/io

type Handle = resource {
    pub mut id Int
}

fn Handle.drop(move self) {}

fn Handle.close(move self) {
    print "close ${self.id}"
}

fn Handle.peek(self) -> Int {
    self.id
}

fn Handle.bump(mut self) {
    self.id = self.id + 1
}

fn Handle.bumpTwice(mut self) {
    self.bump()
    self.bump()
}

type Pack = {
    pub mut inner Handle
    pub mut other Handle
    pub mut n Int
}

fn Pack.setN(mut self, n: Int) {
    self.n = n
}

type Outer = {
    pub mut pack Pack
    pub mut tag Int
}

fn Outer.retag(mut self, tag: Int) {
    self.tag = tag
}

fn mkh(n: Int) -> Handle {
    Handle { id: n }
}

fn mk(n: Int) -> Pack {
    Pack { inner: mkh(n), other: mkh(n + 1), n: 0 }
}

fn reset(p: &mut Handle) {
    p = mkh(90)
}

fn showPack(p: &Pack) {
    print "pack ${p.n}"
}

fn show(h: &Handle) {
    print "show ${h.id}"
}

fn incr(n: &mut Int) {
    n = n + 1
}

fn closeAll(xs: Array[Handle]) {
    for h in xs {
        h.close()
    }
}

fn siblingBorrow() {
    let mut b = mk(10)
    defer { b.inner.close() }
    reset(&mut b.other)
    incr(&mut b.n)
    showPack(&b)
    show(&b.inner)
    b.other.close()
}

fn siblingRecv() {
    let mut b = mk(20)
    defer { b.inner.close() }
    b.other.bump()
    b.setN(3)
    print "other ${b.other.peek()} n ${b.n}"
    b.other.close()
}

fn siblingOfAncestor() {
    let mut o = Outer { pack: mk(30), tag: 0 }
    defer { o.pack.inner.close() }
    o.retag(2)
    o.pack.setN(1)
    print "tag ${o.tag} n ${o.pack.n}"
    o.pack.other.close()
}

fn bumpReserved() {
    let mut h = mkh(40)
    defer { h.close() }
    h.bump()
    h.bump()
}

fn pushIntoReserved() {
    let mut xs = Array.of(mkh(50))
    defer { closeAll(xs) }
    xs.push(mkh(51))
    print "len ${xs.len()}"
}

fn perIterationBinding() {
    for i in 0..2 {
        let h = mkh(60 + i)
        defer { h.close() }
        print "iter ${h.peek()}"
    }
}

fn loopVariable() {
    for h in Array.of(mkh(70), mkh(71)) {
        defer { h.close() }
    }
}

fn perIterationField() {
    for i in 0..2 {
        let b = mk(80 + i * 10)
        defer { b.inner.close() }
        b.other.close()
    }
}

fn perIterationFieldMoves() {
    for i in 0..2 {
        let b = mk(100 + i * 10)
        b.other.close()
        b.inner.close()
    }
}

fn reassignedEachIteration() {
    let mut b = mk(120)
    for i in 0..2 {
        b.other.close()
        b = mk(130 + i * 10)
    }
    b.inner.close()
    b.other.close()
}

fn outerBorrowOnly() {
    let h = mkh(150)
    for i in 0..2 {
        defer { show(&h) }
    }
    h.close()
}

fn outerFailCleanup(ok: Bool) -> Void! {
    let h = mkh(160)
    for i in 0..1 {
        defer(fail) { h.close() }
        if !ok {
            fail test.failure("late")
        }
    }
    h.close()
}

fn helperRecv() {
    let mut h = mkh(170)
    defer { h.close() }
    h.bumpTwice()
}

fn indexSibling() {
    let mut xs = Array.of(mkh(180))
    let mut ys = Array.of(mkh(181))
    defer { closeAll(xs) }
    ys[0] = mkh(182)
    closeAll(ys)
}

fn indexBeforeCleanup() {
    let mut xs = Array.of(mkh(190))
    xs[0] = mkh(191)
    defer { closeAll(xs) }
}

fn borrowHeldUnused() {
    let mut b = mk(200)
    let r = &mut b
    r.inner = mkh(210)
    defer { b.inner.close() }
    b.other.close()
}

fn closureBeforeCleanupUnused() {
    let mut h = mkh(220)
    let f = () => { mkh(221) }
    h = f()
    defer { h.close() }
}

type Tally = {
    pub mut h Handle
    pub mut k Int
}

fn Tally.close(move self) {
    print "tally ${self.k}"
    self.h.close()
}

fn Tally.add(mut self) {
    self.k = self.k + self.h.peek()
}

fn copyWriteUnderWholeCleanup() {
    let mut t = Tally { h: mkh(230), k: 1 }
    defer { t.close() }
    t.add()
    t.add()
}

fn stdWriteUnderCleanup() -> Void! {
    let mut w = BytesWriter.new()
    defer { written(w) }
    _ = w.write("hey".toBytes())?
    _ = w.write("!".toBytes())?
}

fn written(w: BytesWriter) {
    print "written ${w.bytes().len()}"
}

fn report(label: String, r: Void!) {
    match r {
        Ok(_) -> print "${label}: ok"
        Err(e) -> print "${label}: err ${e.message()}"
    }
}

siblingBorrow()
siblingRecv()
siblingOfAncestor()
bumpReserved()
pushIntoReserved()
perIterationBinding()
loopVariable()
perIterationField()
perIterationFieldMoves()
reassignedEachIteration()
outerBorrowOnly()
helperRecv()
indexSibling()
indexBeforeCleanup()
borrowHeldUnused()
closureBeforeCleanupUnused()
report("fail ok", outerFailCleanup(true))
report("fail err", outerFailCleanup(false))
report("std write", stdWriteUnderCleanup())
copyWriteUnderWholeCleanup()

-- src --
import hex from std/encoding/hex
import hash from std/crypto/hash
import sha3 from std/crypto/sha3

fn show(b: Bytes) -> String {
    hex.encode(b)
}

let empty = Bytes.zeros(0)
let m56 = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".toBytes()
let m200 = "a".repeat(200).toBytes()
let m135 = "a".repeat(135).toBytes()
let m136 = "a".repeat(136).toBytes()
let m72 = "a".repeat(72).toBytes()

// FIPS 202 §6 examples: empty and "abc", then 56-byte, exact-rate and
// multi-block messages (SHA3-256 rate 136, SHA3-512 rate 72).
print "256-empty ${show(sha3.sum256(empty))}"
print "256-abc ${show(sha3.sum256(b"abc"))}"
print "256-56 ${show(sha3.sum256(m56))}"
print "256-135a ${show(sha3.sum256(m135))}"
print "256-136a ${show(sha3.sum256(m136))}"
print "256-200a ${show(sha3.sum256(m200))}"
print "512-empty ${show(sha3.sum512(empty))}"
print "512-abc ${show(sha3.sum512(b"abc"))}"
print "512-56 ${show(sha3.sum512(m56))}"
print "512-72a ${show(sha3.sum512(m72))}"
print "512-200a ${show(sha3.sum512(m200))}"

// update in pieces is the same digest as one call.
let mut h = sha3.Hasher256.new()
h.update(b"abcdbcdecdefdefgefghfghighijhijk")
h.update(b"ijkljklmklmnlmnomnopnopq")
print "256-split ${show(h.finish())}"

let mut h512 = sha3.Hasher512.new()
h512.update(b"abcdefghbcdefghicdefghijdefghijk")
h512.update(b"efghijklfghijklmghijklmnhijklmno")
h512.update(b"ijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")
print "512-split ${show(h512.finish())}"

// The Digest bound sees SHA3 through the package's type parameter.
print "generic256 ${show(hash.sum[sha3.Hasher256](b"abc"))}"
print "generic512 ${show(hash.sum[sha3.Hasher512](b"abc"))}"

print "sizes ${sha3.size256} ${sha3.size512} ${sha3.rate256} ${sha3.rate512}"
print "methods ${sha3.Hasher256.size()} ${sha3.Hasher512.size()} ${sha3.Hasher256.blockSize()} ${sha3.Hasher512.blockSize()}"

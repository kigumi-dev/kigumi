-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {
    print "drop ${self.id}"
}

fn inner() {
    let r = Res { id: 2 }
    let _: Void = None.expect("sync")
}

fn work() {
    let r = Res { id: 1 }
    let a = Array.of[Int](1, 2)
    inner()
    print "${a[5]}"
}

work()
-- stdout --
-- stderr --
panic: sync
-- exit --
2

-- src --
import task from std/task

type Holder = {
    pub mut cb fn() -> Int
}

interface Armable {
    fn arm(mut self) -> Unit
}

fn Holder.arm(mut self) -> Unit {
    self.cb = syncRoot
}

async fn leaf(n: Int) -> Int {
    n
}

fn syncRoot() -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(leaf(7))
}

fn safeRoot() -> Int {
    9
}

fn armIt[S: Armable](mut s: S) -> Option[S] {
    s.arm()
    Some(s)
}

async fn outer() -> Int {
    let h = Holder { cb: safeRoot }
    let armed = armIt(h).unwrap()
    armed.cb()
}

print "start"
let ex = task.currentThreadExecutor()
print "got ${ex.runToCompletion(outer())}"
-- stdout --
start
-- stderr --
panic: `Executor.runToCompletion` cannot run inside a task; `await` the future instead
-- exit --
2

-- src --
import task from std/task

interface Sink {
    fn put(move self, f: Future[usize])
}

type Hold['a] = { pub r &'a mut Array[Future[usize]] }
type Pair['a] = { pub h Hold['a], pub n usize }
type Plain['a] = { pub r &'a mut Array[String] }

fn Hold['a].put(move self, f: Future[usize]) {
    self.r.push(f)
}

fn Hold['a].fwdL(move self, c: &mut Array[String]) {
    let g = mut1
    self.r.push(g(c))
}

async fn rd(x: &Array[String]) -> usize {
    x.len()
}

async fn mut1(a: &mut Array[String]) -> usize {
    a.push("x")
    a.len()
}

fn run[T](f: Future[T]) -> T {
    task.currentThreadExecutor().runToCompletion(f)
}

fn sum(a: Array[Future[usize]]) -> usize {
    let mut n: usize = 0
    for f in move a {
        n = n + run(f)
    }
    n
}

fn outH['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: Hold['a]) {
    h.r.push(f(c))
}

fn outM['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: Hold['a]) {
    h.put(f(c))
}

fn outP['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], p: Pair['a]) {
    p.h.r.push(f(c))
}

fn outO['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], o: Option[Hold['a]]) {
    match o {
        Some(h) -> h.r.push(f(c))
        None -> {}
    }
}

fn outA['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], hs: Array[Hold['a]]) {
    for h in move hs {
        h.r.push(f(c))
    }
}

fn outL['a](c: &mut Array[String], h: Hold['a]) {
    let g = mut1
    h.r.push(g(c))
}

fn plainPut['a](c: &mut Array[String], h: Plain['a]) {
    h.r.push(c[0])
}

fn inFrame() -> usize {
    let w = outH
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    w(mut1, &mut c, Hold { r: &mut a })
    let n = sum(a)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn shapes() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let wm = outM
    wm(mut1, &mut c, Hold { r: &mut a })
    let m = sum(a)
    c.push("m")
    let mut b = Array.empty[Future[usize]]()
    let wp = outP
    wp(mut1, &mut c, Pair { h: Hold { r: &mut b }, n: 1 })
    let p = sum(b)
    c.push("p")
    let mut d = Array.empty[Future[usize]]()
    let wo = outO
    wo(mut1, &mut c, Some(Hold { r: &mut d }))
    let o = sum(d)
    c.push("o")
    let mut e = Array.empty[Future[usize]]()
    let wa = outA
    wa(mut1, &mut c, Array.of(Hold { r: &mut e }))
    let x = sum(e)
    c = Array.of("q")
    m * 1000 + p * 100 + o * 10 + x + c.len()
}

fn locals() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    outL(&mut c, Hold { r: &mut a })
    let d = sum(a)
    c.push("d")
    let mut b = Array.empty[Future[usize]]()
    let w = outL
    w(&mut c, Hold { r: &mut b })
    let v = sum(b)
    c.push("v")
    let mut e = Array.empty[Future[usize]]()
    Hold { r: &mut e }.fwdL(&mut c)
    let s = sum(e)
    c = Array.of("q", "q")
    d * 100 + v * 10 + s + c.len()
}

fn unknown['a](w: fn(fn(&mut Array[String]) -> Future[usize], &mut Array[String], Hold['a]) -> Void) -> usize {
    let mut c = Array.of("a", "b")
    let mut a = Array.empty[Future[usize]]()
    w(mut1, &mut c, Hold { r: &mut a })
    let n = sum(a)
    c = Array.of("q")
    n * 10 + c.len()
}

fn plain() -> usize {
    let w = plainPut
    let mut c = Array.of("a")
    let mut s = Array.empty[String]()
    w(&mut c, Plain { r: &mut s })
    c = Array.of("q", "q", "q")
    s.len() * 10 + c.len()
}

fn outI[S: Sink](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: S) {
    h.put(f(c))
}

fn gen[H](w: fn(fn(&mut Array[String]) -> Future[usize], &mut Array[String], H) -> Void, h: H, c: &mut Array[String]) {
    w(mut1, c, h)
}

fn mid[H: Sink](c: &mut Array[String], h: H) {
    outI(mut1, c, h)
}

fn pushRd['a](h: Hold['a], x: &Array[String]) {
    let g = rd
    h.r.push(g(x))
}

fn foldOk[A](init: A, xs: &Array[String], step: fn(A, &Array[String]) -> Void) {
    step(init, xs)
}

fn generic() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    outI(mut1, &mut c, Hold { r: &mut a })
    let i = sum(a)
    c.push("i")
    let mut b = Array.empty[Future[usize]]()
    gen(outH, Hold { r: &mut b }, &mut c)
    let g = sum(b)
    c.push("g")
    let mut d = Array.empty[Future[usize]]()
    mid(&mut c, Hold { r: &mut d })
    let m = sum(d)
    let mut e = Array.empty[Future[usize]]()
    foldOk(Hold { r: &mut e }, &c, pushRd)
    let f = sum(e)
    c = Array.of("q")
    i * 1000 + g * 100 + m * 10 + f + c.len()
}

fn step[T](x: T, b: &mut Array[Int]) -> T {
    b.push(1)
    x
}

fn twiceKnown[T](x: T, buf: &mut Array[Int]) -> T {
    let y = step(x, buf)
    let z = step(y, buf)
    buf.push(2)
    z
}

fn twiceShared[T](x: T, buf: &Array[Int], g: fn(T, &Array[Int]) -> T) -> T {
    let y = g(x, buf)
    g(y, buf)
}

fn addLen(n: Int, b: &Array[Int]) -> Int {
    n + (b.len().toInt() || 0)
}

fn callbacks() -> Int {
    let mut b: Array[Int] = Array.empty()
    let k = twiceKnown(5, &mut b)
    k * 100 + twiceShared(1, &b, addLen)
}

type Pair2['a] = { pub n usize, pub h Hold['a] }
type Two['a] = Both(usize, Hold['a]) | NoneOf

fn outP2['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], p: Pair2['a]) {
    p.h.r.push(f(c))
}

fn outT['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], t: Two['a]) {
    match t {
        Both(_, h) -> h.r.push(f(c))
        NoneOf -> {}
    }
}

fn wrapP2['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: Hold['a]) {
    outP2(f, c, Pair2 { n: 1, h: h })
}

fn wrapP['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: Hold['a]) {
    outP(f, c, Pair { h: h, n: 1 })
}

fn wrapT['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: Hold['a]) {
    outT(f, c, Both(1, h))
}

fn wrapA['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: Hold['a]) {
    let mut tmp = Array.empty[Future[usize]]()
    outA(f, c, Array.of(Hold { r: &mut tmp }, h))
    let _ = sum(tmp)
}

fn outR['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: &mut Hold['a]) {
    h.r.push(f(c))
}

fn packedRecord() -> usize {
    let w = wrapP2
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    w(mut1, &mut c, Hold { r: &mut a })
    let n = sum(a)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn packedVariant() -> usize {
    let w = wrapT
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    w(mut1, &mut c, Hold { r: &mut a })
    let n = sum(a)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn packedArray() -> usize {
    let w = wrapA
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    w(mut1, &mut c, Hold { r: &mut a })
    let n = sum(a)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn packedDirect() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    wrapP2(mut1, &mut c, Hold { r: &mut a })
    let n = sum(a)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn packedFirst() -> usize {
    let w = wrapP
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    w(mut1, &mut c, Hold { r: &mut a })
    let n = sum(a)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn lentValue() -> usize {
    let w = outR
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    w(mut1, &mut c, &mut hold)
    let n = sum(a)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn lentDirect() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    outR(mut1, &mut c, &mut hold)
    let n = sum(a)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn unknownLent['a](w: fn(fn(&mut Array[String]) -> Future[usize], &mut Array[String], &mut Hold['a]) -> Void) -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    w(mut1, &mut c, &mut hold)
    let n = sum(a)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn scopedPacked() -> usize {
    let mut c = Array.of("a")
    let n = {
        let mut a = Array.empty[Future[usize]]()
        let w = wrapP2
        w(mut1, &mut c, Hold { r: &mut a })
        sum(a)
    }
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn scopedLent() -> usize {
    let mut c = Array.of("a")
    let n = {
        let mut a = Array.empty[Future[usize]]()
        let mut hold = Hold { r: &mut a }
        let w = outR
        w(mut1, &mut c, &mut hold)
        sum(a)
    }
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn plainPutR['a](c: &mut Array[String], h: &mut Plain['a]) {
    h.r.push(c[0])
}

fn plainLent['a](w: fn(&mut Array[String], &mut Plain['a]) -> Void) -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[String]()
    let mut hold = Plain { r: &mut a }
    w(&mut c, &mut hold)
    c = Array.of("q", "q", "q")
    a.len() + c.len()
}

fn useR['a](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: &mut Hold['a]) {
    let _ = run(f(c))
    let _ = h.r.len()
}

fn consumedLent() -> usize {
    let w = useR
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    w(mut1, &mut c, &mut hold)
    c = Array.of("q", "q", "q")
    sum(a) + c.len()
}

fn outG[H](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: &mut H, put: fn(&mut H, Future[usize]) -> Void) {
    put(h, f(c))
}

fn relayG[H](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: &mut H, put: fn(&mut H, Future[usize]) -> Void) {
    outG(f, c, h, put)
}

fn pt['a](h: &mut Hold['a], f: Future[usize]) {
    h.r.push(f)
}

fn genericLentDirect() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    outG(mut1, &mut c, &mut hold, pt)
    let n = sum(a)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn genericLentRelay() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    relayG(mut1, &mut c, &mut hold, pt)
    let n = sum(a)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn consumeR['a](h: &mut Hold['a], f: Future[usize]) {
    let _ = run(f)
    let _ = h.r.len()
}

fn genericLentConsumed() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    outG(mut1, &mut c, &mut hold, consumeR)
    c = Array.of("q", "q", "q")
    sum(a) + c.len()
}

interface RefSink {
    fn putRef(mut self, f: Future[usize])
}

fn Hold['a].putRef(mut self, f: Future[usize]) {
    self.r.push(f)
}

fn outRefI[S: RefSink](f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: &mut S) {
    h.putRef(f(c))
}

fn boundLentDirect() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    outRefI(mut1, &mut c, &mut hold)
    let n = sum(a)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn outDyn(f: fn(&mut Array[String]) -> Future[usize], c: &mut Array[String], h: &mut RefSink) {
    h.putRef(f(c))
}

fn dynDirect() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    outDyn(mut1, &mut c, &mut hold)
    let n = sum(a)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn dynValue() -> usize {
    let w = outDyn
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    w(mut1, &mut c, &mut hold)
    let n = sum(a)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn dynFrame() -> usize {
    let f = mut1
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    let v: &mut RefSink = &mut hold
    v.putRef(f(&mut c))
    let n = sum(a)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn boundFrame() -> usize {
    let f = mut1
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    hold.putRef(f(&mut c))
    let n = sum(a)
    c = Array.of("q", "q", "q")
    n + c.len()
}

async fn mutInt(c: &mut Int) -> usize {
    c = c + 1
    1
}

fn outInt['a](f: fn(&mut Int) -> Future[usize], c: &mut Int, h: &mut Hold['a]) {
    h.r.push(f(c))
}

fn lentIntDirect() -> usize {
    let mut c = 0
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    outInt(mutInt, &mut c, &mut hold)
    let n = sum(a)
    c = 5
    n
}

fn lentIntValue() -> usize {
    let w = outInt
    let mut c = 0
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    w(mutInt, &mut c, &mut hold)
    let n = sum(a)
    c = 5
    n
}

interface RefConsumer {
    fn consumeRef(mut self, f: Future[usize])
}

fn Hold['a].consumeRef(mut self, f: Future[usize]) {
    let _ = run(f)
    let _ = self.r.len()
}

fn useDyn(f: fn(&mut Int) -> Future[usize], c: &mut Int, h: &mut RefConsumer) {
    h.consumeRef(f(c))
}

fn consumedDynDirect() -> usize {
    let mut c = 0
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    useDyn(mutInt, &mut c, &mut hold)
    c = 5
    sum(a)
}

fn consumedDynValue() -> usize {
    let w = useDyn
    let mut c = 0
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    w(mutInt, &mut c, &mut hold)
    c = 5
    sum(a)
}

type RefView['a] = { pub mut v &'a mut RefSink }

fn dynIfJoin() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    let mut a2 = Array.empty[Future[usize]]()
    let mut hold2 = Hold { r: &mut a2 }
    let v: &mut RefSink = if c.len() > 0 { &mut hold } else { &mut hold2 }
    v.putRef(mut1(&mut c))
    let n = sum(a) + sum(a2)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn dynMatchJoin() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    let mut a2 = Array.empty[Future[usize]]()
    let mut hold2 = Hold { r: &mut a2 }
    let v: &mut RefSink = match c.len() {
        0 -> &mut hold
        _ -> &mut hold2
    }
    v.putRef(mut1(&mut c))
    let n = sum(a) + sum(a2)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn dynLoopView() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    let mut a2 = Array.empty[Future[usize]]()
    let mut hold2 = Hold { r: &mut a2 }
    let mut slot = RefView { v: &mut hold }
    for i in 0..2 {
        if i == 1 { slot = RefView { v: &mut hold2 } }
    }
    slot.v.putRef(mut1(&mut c))
    let n = sum(a) + sum(a2)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn dynBranchView() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    let mut a2 = Array.empty[Future[usize]]()
    let mut hold2 = Hold { r: &mut a2 }
    let mut slot = RefView { v: &mut hold }
    if c.len() > 0 { slot = RefView { v: &mut hold2 } }
    slot.v.putRef(mut1(&mut c))
    let n = sum(a) + sum(a2)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn dynIfCallee() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    let mut a2 = Array.empty[Future[usize]]()
    let mut hold2 = Hold { r: &mut a2 }
    let v: &mut RefSink = if c.len() > 0 { &mut hold } else { &mut hold2 }
    outDyn(mut1, &mut c, v)
    let n = sum(a) + sum(a2)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn dynMatchMakerValue() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    let mut a2 = Array.empty[Future[usize]]()
    let mut hold2 = Hold { r: &mut a2 }
    let v: &mut RefSink = match c.len() {
        0 -> &mut hold
        _ -> &mut hold2
    }
    let f = mut1
    v.putRef(f(&mut c))
    let n = sum(a) + sum(a2)
    c = Array.of("q", "q", "q")
    n + c.len()
}

fn dynIfSecondHolder() -> usize {
    let mut c = Array.of("a")
    let mut a = Array.empty[Future[usize]]()
    let mut hold = Hold { r: &mut a }
    let mut a2 = Array.empty[Future[usize]]()
    let mut hold2 = Hold { r: &mut a2 }
    let v: &mut RefSink = if c.len() > 0 { &mut hold } else { &mut hold2 }
    v.putRef(mut1(&mut c))
    let n = sum(a)
    let m = sum(a2)
    c = Array.of("q", "q", "q")
    n + m + c.len()
}

fn main() {
    print "joined ${dynIfJoin()} ${dynMatchJoin()} ${dynLoopView()} ${dynBranchView()} ${dynIfCallee()} ${dynMatchMakerValue()} ${dynIfSecondHolder()}"
    print "consumed dynamic ${consumedDynDirect()} ${consumedDynValue()}"
    print "dynamic ${dynDirect()} ${dynValue()} ${dynFrame()} bound ${boundFrame()}"
    print "scalar ${lentIntDirect()} ${lentIntValue()}"
    print "bound lent ${boundLentDirect()}"
    print "generic lent ${genericLentDirect()} ${genericLentRelay()} ${genericLentConsumed()}"
    print "plain lent ${plainLent(plainPutR)} consumed ${consumedLent()}"
    print "packed ${packedRecord()} ${packedVariant()} ${packedArray()} ${packedDirect()} ${packedFirst()} ${lentValue()} ${lentDirect()} ${unknownLent(outR)} ${scopedPacked()} ${scopedLent()}"
    print "frame ${inFrame()} shapes ${shapes()} locals ${locals()} unknown ${unknown(outH)} plain ${plain()} generic ${generic()} callbacks ${callbacks()}"
}

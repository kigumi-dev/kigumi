-- src --
let net = host.net()


fn msg[T](r: T!) -> String {
    if r is Err(e) {
        e.message()
    } else {
        "ok"
    }
}

print "listen 74637: ${msg(net.listen("127.0.0.1", 74637))}"
print "listen -1: ${msg(net.listen("127.0.0.1", -1))}"
print "listen 65536: ${msg(net.listen("127.0.0.1", 65536))}"
print "connect 74637: ${msg(net.connect("127.0.0.1", 74637))}"
print "connect 2^32+80: ${msg(net.connect("127.0.0.1", 4294967376))}"
print "connect -80: ${msg(net.connect("127.0.0.1", -80))}"
-- stdout --
listen 74637: port must be between 0 and 65535
listen -1: port must be between 0 and 65535
listen 65536: port must be between 0 and 65535
connect 74637: port must be between 0 and 65535
connect 2^32+80: port must be between 0 and 65535
connect -80: port must be between 0 and 65535

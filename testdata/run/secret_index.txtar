-- src --
import secret from std/secret

let mut t = FixedArray.filled[u64, 4](0)
_ = t.set(0, 10)
_ = t.set(1, 20)
_ = t.set(2, 30)
_ = t.set(3, 40)
let i2 = secret.SecretIndex[4].from(secret.SecretU32.classify(2))
let i9 = secret.SecretIndex[4].from(secret.SecretU32.classify(9))
print "${secret.ctLookupU64(&t, i2)} ${secret.ctLookupU64(&t, i9)}"
secret.ctUpdateU64(&mut t, i2, 99)
print "${(t.get(2) || 0)} ${(t.get(0) || 0)}"
-- stdout --
30 0
99 10
-- secret-san --
panic: SecretSan: secret value reaches host I/O (print) in main

-- src --
import array from std/array
import text from std/text

type Cell = {
    name String
    buf text.StringBuilder
}

fn copyCell(c: &Cell) -> Cell {
    Cell { name: c.name, buf: text.StringBuilder.new() }
}

fn main() {
    let a = Array.of(Cell { name: "a", buf: text.StringBuilder.new() }, Cell { name: "b", buf: text.StringBuilder.new() }, Cell { name: "c", buf: text.StringBuilder.new() })
    let b = a.sliceWith(1, 3, copyCell).unwrap()
    print "slice=${b.with(0, (c) => c.name) || ""} ${b.len()} ${a.len()}"
    print "bad=${a.sliceWith(0, 4, copyCell) is None} ${a.sliceWith(2, 1, copyCell) is None}"
    print "index=${Array.of("a", "b", "c").indexOf("b") || 0} ${Array.of("a", "b").indexOf("z") is None}"
}
-- stdout --
slice=b 2 3
bad=true true
index=1 true

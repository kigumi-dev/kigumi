-- src --
import stdio from std/os
import {stdout} from std/os

fn call[F: Fn[fn() -> Void!]](f: F) -> Void! {
    f()
}

context (stdio.hostStdio(host)) {
    _ = call(() => {
        _ = stdout.write("direct\n".toBytes())?
        ()
    })?
    _ = call(() => {
        _ = call(() => {
            _ = stdout.write("nested\n".toBytes())?
            ()
        })?
        ()
    })?
}
-- stdout --
direct
nested

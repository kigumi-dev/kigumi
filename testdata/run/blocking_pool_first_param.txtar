-- src --
import task from std/task
import alloc from std/alloc
type Store = { s alloc.Shared[Future[Int]?] }
fn churn() -> Int { let mut arr: Array[String] = Array.of("x"); for i in 100..400 { arr.push("w${i}") }; arr.len().toInt() || 0 }
fn dropShared(s: alloc.Shared[Future[Int]?]) {}
fn same(s: alloc.Shared[Future[Int]?]) -> alloc.Shared[Future[Int]?] { s }
fn startIn[F: FnOnce[fn() -> Int]](pool: task.BlockingPool, out: &mut Array[Future[Int]], w: escaping F) { out.push(pool.run(w).unwrap()) }
fn seenOf(r: &String) -> String {
    let mut seen = Array.empty[usize]()
    for j in 0..3000 { let l = r.len(); if seen.len() == 0 || seen[seen.len() - 1] != l { seen.push(l) } }
    "${debug(&seen)} ${r}"
}
async fn paramCloneAwaited(p: alloc.Shared[Future[Int]?]) -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let t = p.clone()
    let n = await pool.run(() => { for i in 0..300 { other = "c${i}${churn()}" }; 1 }).unwrap()
    t.set(Some(pool.run(() => n + 10).unwrap()))
    dropShared(t)
    "${seenOf(&other)} ${n}"
}
async fn paramAliasAwaited(p: alloc.Shared[Future[Int]?]) -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let t = p
    let n = await pool.run(() => { for i in 0..300 { other = "a${i}${churn()}" }; 2 }).unwrap()
    t.set(Some(pool.run(() => n + 10).unwrap()))
    dropShared(t)
    "${seenOf(&other)} ${n}"
}
async fn paramHelperAliasAwaited(p: alloc.Shared[Future[Int]?]) -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let t = same(p)
    let n = await pool.run(() => { for i in 0..300 { other = "h${i}${churn()}" }; 3 }).unwrap()
    t.set(Some(pool.run(() => n + 10).unwrap()))
    dropShared(t)
    "${seenOf(&other)} ${n}"
}
async fn Store.selfFieldAwaited(self) -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let n = await pool.run(() => { for i in 0..300 { other = "s${i}${churn()}" }; 4 }).unwrap()
    self.s.set(Some(pool.run(() => n + 10).unwrap()))
    "${seenOf(&other)} ${n}"
}
async fn paramFieldAwaited(st: Store) -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let n = await pool.run(() => { for i in 0..300 { other = "f${i}${churn()}" }; 5 }).unwrap()
    st.s.set(Some(pool.run(() => n + 10).unwrap()))
    "${seenOf(&other)} ${n}"
}
async fn reassignedFirstParamAwaited(mut h: Future[Int]?) -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    h = Some(pool.run(() => { for i in 0..300 { other = "r${i}${churn()}" }; 6 }).unwrap())
    let g = h
    let n = match g {
        Some(f) -> await f,
        None -> 0
    }
    "${seenOf(&other)} ${n}"
}
async fn awaitedPayloadBesideParam(x: Future[Int]) -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let o = Some(pool.run(() => { for i in 0..300 { other = "p${i}${churn()}" }; 7 }).unwrap())
    let n = match o {
        Some(f) -> await f,
        None -> 0
    }
    let m = await x
    "${seenOf(&other)} ${n} ${m}"
}
async fn plainLendBesideFirstParam(g: Future[Int]) -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    {
        let mut fs: Array[Future[Int]] = Array.empty()
        startIn(pool, &mut fs, () => { for i in 0..300 { other = "l${i}${churn()}" }; 8 })
    }
    let seen = seenOf(&other)
    "${seen} ${await g}"
}
async fn nine() -> Int { 9 }
let keep: alloc.Shared[Future[Int]?] = alloc.Shared.new(None)
let st = Store { s: keep.clone() }
let ex = task.threadPoolExecutor(2)
print ex.runToCompletion(paramCloneAwaited(keep.clone()))
print ex.runToCompletion(paramAliasAwaited(keep.clone()))
print ex.runToCompletion(paramHelperAliasAwaited(keep.clone()))
print ex.runToCompletion(st.selfFieldAwaited())
print ex.runToCompletion(paramFieldAwaited(Store { s: keep.clone() }))
print ex.runToCompletion(reassignedFirstParamAwaited(None))
print ex.runToCompletion(awaitedPayloadBesideParam(nine()))
print ex.runToCompletion(plainLendBesideFirstParam(nine()))
-- stdout --

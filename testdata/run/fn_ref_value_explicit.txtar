-- src --
fn blen['a](x: &'a Array[Int]) -> usize { x.len() }
pub interface Sized2 { fn size(self) -> usize }
pub type R2[F: Fn[fn(&Array[Int]) -> usize] + Copy] = { pub cb F }
pub fn R2[F].size(self) -> usize {
    let xs = Array.of(1, 2, 3)
    (self.cb)(&xs)
}
pub type Hn = { pub n Int }
fn Hn.measure[R: Sized2](self, r: R) -> usize { r.size() }
fn measureFree[R: Sized2](r: R) -> usize { r.size() }
fn explicitInPlace['a](hn: Hn, xs: &'a Array[Int]) -> usize {
    let ra: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
    (hn.measure[R2[fn(&'a Array[Int]) -> usize]])(ra)
}
fn explicitHolder['a](hn: Hn, xs: &'a Array[Int]) -> usize {
    let ra: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
    let g = hn.measure[R2[fn(&'a Array[Int]) -> usize]]
    g(ra)
}
fn freeAnnot['a](xs: &'a Array[Int]) -> usize {
    let ra: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
    let f: fn(R2[fn(&'a Array[Int]) -> usize]) -> usize = measureFree
    f(ra)
}
fn freeExplicit['a](xs: &'a Array[Int]) -> usize {
    let ra: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
    let f = measureFree[R2[fn(&'a Array[Int]) -> usize]]
    f(ra)
}
fn freeInPlace['a](xs: &'a Array[Int]) -> usize {
    let ra: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
    (measureFree[R2[fn(&'a Array[Int]) -> usize]])(ra)
}
let hn = Hn { n: 1 }
let xs = Array.of(9)
print "${explicitInPlace(hn, &xs)} ${explicitHolder(hn, &xs)} ${freeAnnot(&xs)} ${freeExplicit(&xs)} ${freeInPlace(&xs)}"
-- stdout --
3 3 3 3 3

-- src --
type Point = {
    pub x Int
    pub y Int
}

type Shape = Circle(r: Int) | Rect(w: Int, h: Int) | Dot

type Grid = {
    pub mut cells FixedArray[Int, 3]
    pub tag Bool
}

fn sum3(a: FixedArray[Int, 3]) -> Int {
    let mut s = 0
    for x in a {
        s = s + x
    }
    s
}

fn firstOf[T: Copy, const N: usize](a: FixedArray[T, N]) -> T? {
    a.get(0)
}

fn area(s: Shape) -> Int {
    match s {
        Circle(r) -> r * r * 3
        Rect(w, h) -> w * h
        Dot -> 0
    }
}

fn bump(g: Grid) -> Grid {
    let mut out = g
    out.cells[1] = out.cells[1] + 100
    out
}

// Building, indexing, writing, iterating and measuring an inline array allocate nothing.
noalloc fn quiet(seed: Int) -> Int {
    let mut fa = FixedArray.filled[Int, 4](seed)
    fa[1] = fa[0] + 1
    let mut s = 0
    for x in fa {
        s = s + x
    }
    s + (fa.len().toInt() || 0)
}

fn main() -> Unit! {
    let mut ints = FixedArray.filled[Int, 3](1)
    ints[0] = 5
    ints[2] = ints[0] * 2
    print "ints ${ints[0]} ${ints[1]} ${ints[2]} sum ${sum3(ints)} len ${ints.len()}"

    let mut pts = FixedArray.filled[Point, 2](Point { x: 1, y: 2 })
    pts[1] = Point { x: 7, y: 8 }
    print "pts ${pts[0].x} ${pts[1].y} ${(pts.get(1) || Point { x: 0, y: 0 }).x}"

    let mut shapes = FixedArray.filled[Shape, 3](Dot)
    shapes[0] = Circle(2)
    shapes[1] = Rect(3, 4)
    let mut total = 0
    for s in shapes {
        total = total + area(s)
    }
    print "shapes ${total}"

    let g = Grid { cells: FixedArray.filled[Int, 3](4), tag: true }
    let g2 = bump(g)
    print "grid ${g.cells[1]} ${g2.cells[1]} ${g2.tag}"

    let inner = FixedArray.filled[Int, 2](0)
    let mut nested: FixedArray[FixedArray[Int, 2], 2] = FixedArray.filled(inner)
    nested[1] = FixedArray.filled[Int, 2](9)
    let row = nested[1]
    print "nested ${nested[0][1]} ${nested[1][0]} ${row[1]}"

    let flags = FixedArray.filled[Bool, 2](true)
    let chars = FixedArray.filled[Char, 2]('q')
    let floats = FixedArray.filled[Float, 2](1.5)
    print "mixed ${flags[1]} ${chars[0]} ${floats[1] * 2.0}"

    let _ = ints.withMut(1, (v: &mut Int) => { v = v + 40 })
    let _ = pts.withMut(0, (p: &mut Point) => { p = Point { x: p.x + 1, y: p.y } })
    print "withMut ${ints[1]} ${pts[0].x} ${ints.withMut(3, (v: &mut Int) => 0) is None}"

    let ok = ints.set(0, 6)
    let bad = ints.set(9, 6)
    print "set ${ok} ${bad} ${ints[0]}"

    let copy = ints
    ints[0] = 0
    print "copy ${copy[0]} ${ints[0]}"

    let a = FixedArray.filled[Int, 3](7)
    let b = FixedArray.filled[Int, 3](7)
    let c = FixedArray.filled[Int, 3](8)
    print "eq ${a == b} ${a == c} ${a != c} ${hash(&a) == hash(&b)} ${hash(&a) == hash(&c)}"

    let pa = FixedArray.filled[Point, 2](Point { x: 1, y: 1 })
    let pb = FixedArray.filled[Point, 2](Point { x: 1, y: 1 })
    print "eqRec ${pa == pb} ${hash(&pa) == hash(&pb)}"

    let k = 3
    let cap = (d: Int) => a[0] + d + k
    print "closure ${cap(1)}"

    let boxed = Array.of(a, c)
    print "array ${(boxed.get(1) || a)[2]} ${firstOf(c) || 0}"

    let z = FixedArray.zeroed[u8, 4]()
    let arr = z.toArray()
    print "zeroed ${z[3]} ${arr.len()} ${z.at(1, (v: &u8) => v + 1) || 0} quiet ${quiet(2)}"
}
-- stdout --
ints 5 1 10 sum 16 len 3
pts 1 8 7
shapes 24
grid 4 104 true
nested 0 9 9
mixed true q 3
withMut 41 2 true
set true false 6
copy 6 0
eq true false true true false
eqRec true true
closure 11
array 8 8
zeroed 0 4 1 quiet 13

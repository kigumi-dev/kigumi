-- src --
import task from std/task

pub interface Show {
    fn show(self) -> String
}

type Tag = {
    pub s String
}

pub fn Tag.show(self) -> String { "<${self.s}>" }

type Pt = {
    pub x Int
}

pub async fn Pt.same[U: Eq](self, a: U, b: U) -> Bool { a == b }

pub async fn Pt.label[U: Show](self, v: U) -> String {
    "${self.x}:${v.show()}"
}

type Box[T] = {
    pub v T
}

pub async fn Box[T].laterEq[U: Eq](self, a: U, b: U) -> Bool { a == b }

pub async fn Box[T: Show].shw(self, pre: String) -> String {
    "${pre}${self.v.show()}"
}

pub async fn sameLater[T: Eq](a: T, b: T) -> Bool { a == b }

async fn applySame(f: fn(Int, Int) -> Future[Bool], a: Int, b: Int) -> Bool {
    await f(a, b)
}

async fn driver() -> Int {
    let p = Pt { x: 5 }
    let strs: fn(String, String) -> Future[Bool] = p.same
    print "${await strs("a", "b")} ${await strs("c", "c")}"
    let label: fn(Tag) -> Future[String] = p.label
    print "${await label(Tag { s: "t" })}"
    print "${await label(Tag { s: "u" })}"
    let box = Box { v: 1 }
    let eqv: fn(Int, Int) -> Future[Bool] = box.laterEq
    print "${await eqv(2, 2)} ${await eqv(2, 3)}"
    let shown = Box { v: Tag { s: "owner" } }
    let shw: fn(String) -> Future[String] = shown.shw
    print "${await shw("> ")}"
    print "${await applySame(p.same, 3, 3)} ${await applySame(p.same, 3, 4)}"
    let item = sameLater[Int]
    print "${await item(1, 1)} ${await applySame(sameLater[Int], 1, 2)}"
    let pending = eqv(7, 7)
    print "${await pending}"
    0
}

let ex = task.currentThreadExecutor()
print "${ex.runToCompletion(driver())}"
-- stdout --
false true
5:<t>
5:<u>
true false
> <owner>
true false
true false
true
0

-- src --
import array from std/array
import text from std/text

fn run() -> Unit {
    for s in Array.of("a,b,,c", "", ",", "x", ",,", "é,ü", "abc") {
        print "split ${array.join(&s.split(","), "|")} ${s.split(",").len()} ${s.split("").len()} ${s.split(",,").len()}"
        print "chars ${s.chars().len()} ${array.join(&text.graphemes(s), "/")} ${text.lines(s).len()} ${text.lines("${s}\n").len()} ${text.lines("\n${s}").len()} ${array.join(&text.lines("${s}\nz"), "+")}"
        print "case ${s.toUpper()} ${s.toLower()} [${s.trim()}] [${" \t${s}\r\n ".trim()}]"
        print "replace ${text.replace(s, ",", "::")} ${text.replace(s, "b", "")} ${text.replace(s, "", "q")} ${text.replace(s, "a,", "xyz")}"
        print "edges ${text.trimPrefix(s, "a")} ${text.trimSuffix(s, "c")} ${text.trimPrefix(s, s)} ${text.trimSuffix(s, "")}"
        print "join ${array.join(&Array.of(s, s, ""), ", ")} ${array.join(&Array.of(s), "--")}"
    }
    print "sorted ${array.join(&array.sortedBy(&Array.of("b", "c", "a", "b"), (a, b) => a.compareTo(b)), "")}"
    let mut sb = text.StringBuilder.new()
    sb.push("é")
    sb.push("")
    sb.pushByte(33)
    print "builder ${sb.len()} ${sb.freeze().unwrap()}"
}

run()

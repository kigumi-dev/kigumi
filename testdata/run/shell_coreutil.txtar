head-neg=[err: line count must not be negative]
wc-none=[err: wc needs at least one count]
uniq-both=[err: uniq cannot select both repeated and unique]
cut-nodelim=[err: cut needs a delimiter]
cut-zerofield=[err: cut fields are 1-based]
tr-nosource=[err: tr needs a source set]
tee-nopath=[err: tee needs a path]

-- src --
import hex from std/encoding/hex
import snp from std/cvm/snp

fn withByte(raw: Bytes, at: usize, value: u8) -> Bytes {
    let mut buffer = ByteBuffer.tryNew(raw.len()).expect("byte buffer")
    buffer.copyFrom(0, raw, 0, raw.len())
    buffer.set(at, value)
    buffer.freeze()
}

fn accept(digest: Bytes, signature: &snp.Signature) -> Result[Bool, snp.Error] {
    Ok(digest.len() == 48 && signature.r.len() == 72 && signature.s.len() == 72)
}

fn reject(digest: Bytes, signature: &snp.Signature) -> Result[Bool, snp.Error] {
    let _ = digest
    let _ = signature
    Ok(false)
}

fn main() -> Void! {
    let raw = hex.decode("")?
    let report = snp.parseReport(raw)?
    print "version=${report.version} svn=${report.guestSvn} vmpl=${report.vmpl}"
    print "policy=${report.policy.raw} abi=${report.policy.abiMajor()}.${report.policy.abiMinor()} debug=${report.policy.debugAllowed()} smt=${report.policy.smtAllowed()}"
    print "measurement=${hex.encode(report.measurement)}"
    print "reportData=${hex.encode(report.reportData)}"
    print "tcb=${report.currentTcb.raw} boot=${report.currentTcb.bootLoader()} tee=${report.currentTcb.tee()} snp=${report.currentTcb.snp()} micro=${report.currentTcb.microcode()}"
    print "platform smt=${report.platformInfo.smtEnabled()} ecc=${report.platformInfo.eccEnabled()} alias=${report.platformInfo.aliasCheckComplete()}"
    print "key author=${report.keyInfo.authorKeyEnabled()} mask=${report.keyInfo.maskChipKey()} key=${report.keyInfo.signingKey()}"
    print "cpuid=${report.cpuidFamilyId || 0}:${report.cpuidModelId || 0}:${report.cpuidStepping || 0}"
    print "versions=${report.currentVersion.major}.${report.currentVersion.minor}.${report.currentVersion.build}/${report.committedVersion.major}.${report.committedVersion.minor}.${report.committedVersion.build}"
    print "mit=${report.launchMitVector || 0}/${report.currentMitVector || 0} signed=${report.signedBytes().len()}"
    print "signature=${report.signature.r[0]},${report.signature.s[0]} reserved=${report.signature.reserved.len()}"
    print "matches data=${report.reportDataEquals(report.reportData)} measurement=${report.measurementEquals(report.measurement)}"
    print "claims debug=${report.claims().debugAllowed} smt=${report.claims().smtAllowed} vmpl=${report.claims().vmpl}"

    let older = snp.parseReport(hex.decode("")?)?
    print "v2 version=${older.version} cpuid=${older.cpuidFamilyId is None} mit=${older.launchMitVector is None} signed=${older.signedBytes().len()}"
    let v3 = snp.parseReport(hex.decode("")?)?
    print "v3 version=${v3.version} cpuid=${v3.cpuidFamilyId || 0}:${v3.cpuidModelId || 0}:${v3.cpuidStepping || 0} mit=${v3.launchMitVector is None}"

    match snp.verifyReportSignature(&report, accept) {
        Ok(_) -> print "verify accept=ok"
        Err(error) -> print "verify accept=${error.message()}"
    }
    match snp.verifyReportSignature(&report, reject) {
        Ok(_) -> print "verify reject=accepted"
        Err(error) -> print "verify reject=${error.message()}"
    }
    let cleared = withByte(withByte(raw, 0x2A0, 0), 0x2E8, 0)
    let masked = snp.parseReport(withByte(cleared, 0x48, 2))?
    match snp.verifyReportSignature(&masked, accept) {
        Ok(_) -> print "verify unsigned=accepted"
        Err(error) -> print "verify unsigned=${error.message()}"
    }

    match snp.parseReport(Bytes.zeros(10)) {
        Ok(_) -> print "size=accepted"
        Err(error) -> print "size=${error.message()}"
    }
    match snp.parseReport(withByte(raw, 0x00, 1)) {
        Ok(_) -> print "version1=accepted"
        Err(error) -> print "version1=${error.message()}"
    }
    match snp.parseReport(withByte(raw, 0x00, 6)) {
        Ok(_) -> print "version6=accepted"
        Err(error) -> print "version6=${error.message()}"
    }
    match snp.parseReport(withByte(raw, 0x34, 0)) {
        Ok(_) -> print "algorithm=accepted"
        Err(error) -> print "algorithm=${error.message()}"
    }
    match snp.parseReport(withByte(raw, 0x4C, 1)) {
        Ok(_) -> print "reserved=accepted"
        Err(error) -> print "reserved=${error.message()}"
    }
    match snp.parseReport(withByte(raw, 0x0A, 0)) {
        Ok(_) -> print "policy=accepted"
        Err(error) -> print "policy=${error.message()}"
    }
    match snp.parseReport(withByte(raw, 0x41, 1)) {
        Ok(_) -> print "platform=accepted"
        Err(error) -> print "platform=${error.message()}"
    }
    match snp.parseReport(withByte(raw, 0x208, 1)) {
        Ok(_) -> print "mitigation=accepted"
        Err(error) -> print "mitigation=${error.message()}"
    }
    match snp.parseReport(withByte(raw, 0x18B, 1)) {
        Ok(_) -> print "cpuid=accepted"
        Err(error) -> print "cpuid=${error.message()}"
    }
    match snp.parseReport(withByte(raw, 0x2A0, 0)) {
        Ok(_) -> print "scalar=accepted"
        Err(error) -> print "scalar=${error.message()}"
    }
    match snp.parseReport(withByte(raw, 0x48, 28)) {
        Ok(_) -> print "signingkey=accepted"
        Err(error) -> print "signingkey=${error.message()}"
    }
    match snp.parseReport(withByte(raw, 0x48, 2)) {
        Ok(_) -> print "masked-aware=accepted"
        Err(error) -> print "masked-aware=${error.message()}"
    }
    match snp.parseReport(withByte(hex.decode("")?, 0x1F8, 1)) {
        Ok(_) -> print "v2reserved=accepted"
        Err(error) -> print "v2reserved=${error.message()}"
    }
}
-- stdout --
version=5 svn=7 vmpl=1
policy=131328 abi=1.0 debug=false smt=false
measurement=404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f
reportData=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f
tcb=578437695752307201 boot=1 tee=2 snp=7 micro=8
platform smt=true ecc=true alias=true
key author=false mask=false key=0
cpuid=26:17:2
versions=7.8.9/4.5.6
mit=0/3 signed=672
signature=1,2 reserved=368
matches data=true measurement=true
claims debug=false smt=false vmpl=1
v2 version=2 cpuid=true mit=true signed=672
v3 version=3 cpuid=26:17:2 mit=true
verify accept=ok
verify reject=snp: forged or inconsistent report signature
verify unsigned=snp: the report is not signed
size=snp: expected 1184 bytes, got 10
version1=snp: unsupported version 1
version6=snp: unsupported version 6
algorithm=snp: unsupported algorithm 0
reserved=snp: reserved bytes are not zero in report reserved0
policy=snp: malformed guest policy
platform=snp: reserved bytes are not zero in platform info
mitigation=snp: reserved bytes are not zero in mitigation reserved
cpuid=snp: reserved bytes are not zero in CPUID reserved
scalar=snp: forged or inconsistent report signature scalar
signingkey=snp: forged or inconsistent signing key selection
masked-aware=snp: forged or inconsistent signature for a masked chip key
v2reserved=snp: reserved bytes are not zero in report reserved

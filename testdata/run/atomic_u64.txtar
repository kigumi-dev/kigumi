-- src --
import atomic from std/atomic
import mem from std/mem

let a = atomic.AtomicU64.new(1)
print "${(unsafe { a.load(mem.AtomicOrder.SeqCst) })}"
print "${(unsafe { a.add(2, mem.AtomicOrder.SeqCst) })} ${(unsafe { a.load(mem.AtomicOrder.SeqCst) })}"
print "${(unsafe { a.compareExchange(3, 9, mem.AtomicOrder.SeqCst) })} ${(unsafe { a.load(mem.AtomicOrder.SeqCst) })}"
print "${(unsafe { a.xor(3, mem.AtomicOrder.SeqCst) })}"
let b = atomic.AtomicBool.new(false)
print "${(unsafe { b.compareExchange(false, true, mem.AtomicOrder.SeqCst) })} ${(unsafe { b.load(mem.AtomicOrder.SeqCst) })}"
-- stdout --
1
1 3
3 9
9
false true

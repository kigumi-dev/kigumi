-- src --
import binary from std/binary

let data = b"abcd"
print "${debug(&binary.u16Be(data, 18446744073709551615))}"
print "${debug(&binary.u64Le(data, 18446744073709551615))}"
print "${debug(&binary.u16Be(data, 18446744073709551614))}"
print "${debug(&binary.uintBe(data, 18446744073709551615, 2))}"
-- stdout --
None
None
None
None

-- src --
fn o_i128(o: i128?) -> String {
    match o {
        Some(v) -> "Some(${v})"
        None -> "None"
    }
}

fn o_u128(o: u128?) -> String {
    match o {
        Some(v) -> "Some(${v})"
        None -> "None"
    }
}

let f0: Float = 0.0
print "0.0: ${o_i128(f0.toI128())} ${o_u128(f0.toU128())}"
let f1: Float = -0.0
print "-0.0: ${o_i128(f1.toI128())} ${o_u128(f1.toU128())}"

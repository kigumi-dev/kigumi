-- src --
fn blen['a](x: &'a Array[Int]) -> usize { x.len() }
pub interface Sized2 { fn size(self) -> usize }
pub type R2[F: Fn[fn(&Array[Int]) -> usize] + Copy] = { pub cb F }
pub fn R2[F].size(self) -> usize {
    let xs = Array.of(1, 2, 3)
    (self.cb)(&xs)
}
pub type Hn = { pub n Int }
fn Hn.measure[R: Sized2](self, r: R) -> usize { r.size() }
fn annotated['a](hn: Hn, xs: &'a Array[Int]) -> usize {
    let ra: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
    let g: fn(R2[fn(&'a Array[Int]) -> usize]) -> usize = hn.measure
    ra.size()
}
fn dropped['a](hn: Hn, xs: &'a Array[Int]) -> usize {
    let _: fn(R2[fn(&'a Array[Int]) -> usize]) -> usize = hn.measure
    let g: fn(R2[fn(&'a Array[Int]) -> usize]) -> usize = hn.measure
    let h = g
    xs.len()
}
fn called['a](hn: Hn, xs: &'a Array[Int]) -> usize {
    let ra: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
    let g: fn(R2[fn(&'a Array[Int]) -> usize]) -> usize = hn.measure
    let unused: fn(R2[fn(&'a Array[Int]) -> usize]) -> usize = hn.measure
    g(ra) + 10
}
let hn = Hn { n: 1 }
let xs = Array.of(9)
print "${annotated(hn, &xs)} ${dropped(hn, &xs)} ${called(hn, &xs)}"
-- stdout --
3 1 13

-- src --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {
    print "drop ${self.id}"
}

type Bad = resource {
    pub id Int
}

fn Bad.drop(move self) {
    print "bad ${self.id}"
    let _: Void = None.expect("drop failed: ${self.id}")
}

fn replace(x: &mut Bad) {
    x = Bad { id: 4 }
}

fn scope() {
    let a = Res { id: 1 }
    let mut b = Bad { id: 2 }
    replace(&mut b)
    let c = Res { id: 3 }
    print "body"
}

scope()
print "unreachable"
-- stdout --
bad 2
bad 4
drop 1
-- stderr --
panic: drop failed: 2
panic: drop failed: 4
-- exit --
2

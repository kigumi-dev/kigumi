-- src --
import task from std/task
import map from std/map

type Holder = {
    pub cb fn() -> Int
}

type Wrap = {
    pub inner Holder
}

async fn leaf(n: Int) -> Int {
    n
}

fn syncRoot() -> Int {
    let ex = task.currentThreadExecutor()
    ex.runToCompletion(leaf(7))
}

fn maybe() -> Option[Holder] {
    let mut m = map.empty[Int, Holder]()
    m.set(0, Holder { cb: syncRoot })
    m.get(&0)
}

async fn outer() -> Int {
    let h = maybe().unwrap()
    h.cb()
}

print "start"
let ex = task.currentThreadExecutor()
print "got ${ex.runToCompletion(outer())}"
-- stdout --
start
-- stderr --
panic: `Executor.runToCompletion` cannot run inside a task; `await` the future instead
-- exit --
2

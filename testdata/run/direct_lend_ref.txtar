-- src --
// A reference parameter its body only reads takes the value, so lending a local costs no box.
import array from std/array

type Point = {
    pub x Int
    pub y Int
}

type Tick = Up(n: Int) | Down(m: Int) | Flat

fn peek(p: &Point) -> Int { p.x * 10 + p.y }

fn twice(p: &Point) -> Int { peek(p) + peek(p) }

fn weigh(t: &Tick) -> Int {
    match t {
        Up(n) -> n + 100
        Down(m) -> m + 200
        Flat -> 300
    }
}

fn dup(p: &Point) -> Point { Point { x: p.x, y: p.y } }

fn apply(f: fn(&Point) -> Int, p: &Point) -> Int { f(p) }

pure fn Tick.rank(self) -> Int {
    match self {
        Up(n) -> 1 + n
        Down(m) -> 0 - m
        Flat -> 0
    }
}

pure fn Tick.compareTo(self, other: &Tick) -> Ordering {
    let a = self.rank()
    let b = other.rank()
    if a < b { Ordering.Less } else if a > b { Ordering.Greater } else { Ordering.Equal }
}

pure fn Point.compareTo(self, other: &Point) -> Ordering {
    if self.x < other.x { Ordering.Less } else if self.x > other.x { Ordering.Greater } else { Ordering.Equal }
}

fn run(n: Int) -> Int {
    let mut s = 0
    let kept: Array[Point] = Array.of(Point { x: 7, y: 8 })
    for i in 0..n {
        let p = Point { x: i, y: 1 }
        let q = Point { x: 3, y: 1 }
        let a = Up(i)
        let b = if i % 2 == 0 { Down(i) } else { Flat }
        s = s + peek(&p) + twice(&q) + weigh(&a) + weigh(&b)
        s = s + dup(&p).x + apply(peek, &p) + peek(&kept[0])
        if p.compareTo(&q) == Ordering.Less { s = s + 1000 }
        if a < Up(3) { s = s + 2000 }
        if b > Flat { s = s + 4000 }
    }
    s
}

let sorted = array.sortedBy(&Array.of(Up(3), Flat, Down(2), Up(1)), (l: &Tick, r: &Tick) => l.compareTo(r))
print "run ${run(6)} ${run(0)}"
print "sorted ${sorted.len()} ${weigh(&sorted[0])} ${weigh(&sorted[3])}"
-- stdout --
run 12288 0
sorted 4 202 103

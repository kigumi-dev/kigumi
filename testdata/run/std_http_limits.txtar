-- src --
import fs from std/fs
import http from std/net/http
import net from std/net
import task from std/task

fn echo(req: http.Request) -> http.Response! {
    http.Response.ofText(200, "echo ${req.method} ${req.path} [${req.text()?}]")
}

fn reset(_req: http.Request) -> http.Response! {
    http.Response.new(205)
}

// Sends data as-is and reads until the server closes, summarizing each response's status line and body.
async fn raw(n: net.Net, port: Int, data: String) -> String! {
    let pool = task.BlockingPool.new(1)
    let mut conn = (await pool.run(() => n.connect("127.0.0.1", port)).unwrap())?
    let bytes = data.toBytes()
    let mut off: usize = 0
    for off < bytes.len() {
        if conn.pollWrite(bytes.slice(off, bytes.len()) || "".toBytes())? is Some(w) {
            off = off + w
        } else {
            await task.yieldNow()
        }
    }
    let mut got = Array.empty[u8]()
    for true {
        match conn.pollRead(&mut got, 4096)? {
            Some(0) -> break
            Some(_) -> {}
            None -> await task.yieldNow()
        }
    }
    let text = String.fromBytes(Bytes.fromArray(&got))?
    let mut out = ""
    for line in text.split("\r\n") {
        if line.startsWith("HTTP/1.1") || line.startsWith("echo") || line.startsWith("request") || line.startsWith("Connection") || line.startsWith("malformed") || line.startsWith("missing") || line.startsWith("unsupported") || line.startsWith("bare") || line.startsWith("both") || line.startsWith("invalid") || line.startsWith("folded") || line.startsWith("header") {
            out = if out == "" {
                line
            } else {
                "${out} | ${line}"
            }
        }
    }
    out
}

async fn root(n: net.Net, listener: net.Listener) -> Void! {
    let port = listener.port()
    let mut server = http.Server.new(http.Router.new().handle("POST", "/echo", echo).get("/echo", echo).get("/second", echo).get("/reset", reset).handler(), (line) => print "log: ${line}")
    server.limits = http.Limits {
        maxHeaderBytes: 256
        maxHeaders: 8
        maxBodyBytes: 16
        readTimeoutMillis: 600000
        idleTimeoutMillis: 600000
        writeTimeoutMillis: 600000
        maxConnections: 8
    }
    let stop = http.Shutdown.new()
    let running = task.spawn(server.serve(listener, stop.clone()))
    let cases = Array.of(
        "POST /echo HTTP/1.1\r\nHost: t\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello",
        "POST /echo HTTP/1.1\r\nHost: t\r\nContent-Length: 100\r\n\r\n",
        "POST /echo HTTP/1.1\r\nHost: t\r\nExpect: 100-continue\r\nContent-Length: 100\r\n\r\n",
        "POST /echo HTTP/1.1\r\nHost: t\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n3;x=1\r\nabc\r\n2\r\nde\r\n0\r\nTrailer: t\r\n\r\n",
        "POST /echo HTTP/1.1\r\nHost: t\r\nTransfer-Encoding: chunked\r\n\r\n10\r\n0123456789abcdef\r\n1\r\nx\r\n0\r\n\r\n",
        "GARBAGE\r\n\r\n",
        "GET /echo HTTP/1.1\r\nHost: t\r\nBad Header\r\n\r\n",
        "GET /echo HTTP/1.1\r\n\r\n",
        "GET /echo HTTP/2.0\r\nHost: t\r\n\r\n",
        "GET /echo HTTP/1.1\nHost: t\n\n",
        "POST /echo HTTP/1.1\r\nHost: t\r\nContent-Length: 1\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n",
        "POST /echo HTTP/1.1\r\nHost: t\r\nTransfer-Encoding: gzip\r\n\r\n",
        "GET /echo HTTP/1.1\r\nHost: t\r\nX-Long: ${"a".repeat(300)}\r\n\r\n",
        "GET /echo HTTP/1.1\r\nHost: t\r\n A: folded\r\n\r\n",
        "GET /echo HTTP/1.1\r\nHost: t\r\n\r\nGET /second HTTP/1.1\r\nHost: t\r\nConnection: close\r\n\r\n",
        "GET /echo HTTP/1.0\r\n\r\n",
        "POST /echo HTTP/1.0\r\nHost: t\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n",
        "POST /echo HTTP/1.1\r\nHost: t\r\nExpect: 100-continue\r\nContent-Length: 0\r\nConnection: close\r\n\r\n",
        "GET /echo#frag HTTP/1.1\r\nHost: t\r\n\r\n",
        "GET /echo HTTP/1.1\r\nHost: a b\r\n\r\n",
        "GET /reset HTTP/1.1\r\nHost: t\r\nConnection: close\r\n\r\n"
    )
    for data in cases {
        let line = (await raw(n, port, data))?
        print line
    }
    let mut c = http.Client.new(n, task.BlockingPool.new(1))
    c.timeoutMillis = 600000
    let mut session = (await c.open("http://127.0.0.1:${port}"))?
    let first = (await session.send(http.Request.new("GET", "/echo")))?
    print "keep-alive 1: ${first.status} ${first.text()?}"
    let second = (await session.send(http.Request.new("GET", "/second")))?
    print "keep-alive 2: ${second.status} ${second.text()?}"
    stop.request()
    (await running)?
    print "stopped"
    match await session.send(http.Request.new("GET", "/echo")) {
        Ok(_) -> print "after stop: unexpected answer"
        Err(e) -> print "after stop: ${e.message()}"
    }
}

fn fdCount(files: fs.Files) -> usize! {
    let entries = files.list(fs.Path.fromString("/proc/self/fd")?)?
    entries.len()
}

let files = host.files()
let before = fdCount(files)?
let n = host.net()
let listener = n.listen("127.0.0.1", 0)?
let ex = task.currentThreadExecutor()
ex.runToCompletion(root(n, listener))?
print "sockets released: ${fdCount(files)? == before}"
-- stdout --

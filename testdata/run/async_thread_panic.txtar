-- src --
import task from std/task

// The root awaits the task that panics, so the panic surfaces there with its
// own text, and the siblings still running are cancelled before the run ends.
async fn boom() -> Int {
    None.expect("boom")
}

async fn spin() -> Int {
    let mut n = 0
    for !task.cancelRequested() {
        await task.yieldNow()
        n = n + 1
    }
    n
}

async fn root() -> Int {
    let a = task.spawn(boom())
    let b = task.spawn(spin())
    let c = task.spawn(spin())
    await a
}

let ex = task.threadPoolExecutor(3)
print "total ${ex.runToCompletion(root())}"
-- stdout --
-- stderr --
panic: boom
-- exit --
2

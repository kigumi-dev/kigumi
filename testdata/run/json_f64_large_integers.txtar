-- src --
import json from std/json

fn show(r: Float!) -> String {
    match r {
        Ok(f) -> "${f}"
        Err(e) -> "err: ${e.message()}"
    }
}

for input in Array.of("9223372036854775807", "9223372036854775808", "18446744073709551615", "18446744073709551616", "123456789012345678901234567890", "-9223372036854775808", "-9223372036854775809", "-123456789012345678901234567890", "1.5e3", "7") {
    print "<${input}>: ${show(json.decode[f64](input))}"
}
-- stdout --
<9223372036854775807>: 9.223372036854776e+18
<9223372036854775808>: 9.223372036854776e+18
<18446744073709551615>: 1.8446744073709552e+19
<18446744073709551616>: 1.8446744073709552e+19
<123456789012345678901234567890>: 1.2345678901234568e+29
<-9223372036854775808>: -9.223372036854776e+18
<-9223372036854775809>: -9.223372036854776e+18
<-123456789012345678901234567890>: -1.2345678901234568e+29
<1.5e3>: 1500
<7>: 7

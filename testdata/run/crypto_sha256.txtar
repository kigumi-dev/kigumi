-- src --
import hex from std/encoding/hex
import hash from std/crypto/hash
import sha256 from std/crypto/sha256

fn show(b: Bytes) -> String {
    hex.encode(b)
}

// FIPS 180-4 / NIST CAVP の vector
print "empty ${show(sha256.sum(Bytes.zeros(0)))}"
print "abc ${show(sha256.sum(b"abc"))}"
print "two-block ${show(sha256.sum("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".toBytes()))}"
print "million ${show(sha256.sum("a".repeat(1000000).toBytes()))}"

// 分割して update しても同じ digest になる
let mut h = sha256.Hasher.new()
h.update(b"abcdbcdecdefdefgefghfghighijhijk")
h.update(b"ijkljklmklmnlmnomnopnopq")
print "split ${show(h.finish())}"

print "sizes ${sha256.size} ${sha256.blockSize} ${sha256.Hasher.size()} ${sha256.Hasher.blockSize()}"
print "genericsum ${show(hash.sum[sha256.Hasher](b"abc"))}"
let pieces = Array.of[Bytes](b"a", b"b", b"c")
print "sumall ${show(hash.sumAll[sha256.Hasher](&pieces))}"

-- src --
import task from std/task

type Res = resource {
    pub id Int
}

fn Res.drop(move self) {
    print "drop ${self.id}"
}

fn explode() -> Int {
    None.expect("boom")
}

// fold lends each element to the step, so the unwind drops every element once, with the array.
fn total() -> Int {
    let guard = Res { id: 9 }
    let xs = Array.of(Res { id: 1 }, Res { id: 2 }, Res { id: 3 })
    xs.fold(0, (acc: Int, x: &Res) => if x.id == 2 { explode() } else { acc + x.id })
}

async fn boom() -> Int {
    total()
}

async fn root() -> Int {
    let h = task.spawn(boom())
    await h
}

let ex = task.currentThreadExecutor()
print "total ${ex.runToCompletion(root())}"
-- stdout --
drop 3
drop 2
drop 1
drop 9
-- stderr --
panic: boom
-- exit --
2

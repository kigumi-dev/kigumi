-- src --
type V['a] = { pub s &'a String }
type Sink['a] = { pub mut items &'a mut Array[V['a]] }
type W['a] = { pub inner Sink['a] }
type Own['a] = { pub mut own Array[V['a]] }

fn churn() -> Int { let mut arr: Array[String] = Array.of("x"); for i in 100..400 { arr.push("w${i}") }; arr.len().toInt() || 0 }
fn pushByValue['a](k: Sink['a], x: V['a]) { k.items.push(x) }
fn pushRef['a](k: &mut Sink['a], x: V['a]) { k.items.push(x) }
fn at['a](ks: &mut Array[Sink['a]]) -> Sink['a] { ks.takeAt(0).unwrap() }
fn Sink['a].add(mut self, x: V['a]) { self.items.push(x) }

fn forwardLocal2['a](k: Sink['a], x: V['a]) { let kk = k; pushByValue(kk, x) }
fn direct2['a](k: Sink['a], x: V['a]) { let mut kk = k; kk.items.push(x) }
fn Sink['a].putLocalCopy(move self, x: V['a]) { let s = self; s.items.push(x) }
fn refOfCopy['a](k: Sink['a], x: V['a]) { let mut kk = k; pushRef(&mut kk, x) }
fn wrapped['a](k: Sink['a], x: V['a]) { let w = W { inner: k }; w.inner.items.push(x) }
fn mutSelfOnCopy['a](k: Sink['a], x: V['a]) { let mut kk = k; kk.add(x) }
fn fnValueCopy['a](k: Sink['a], x: V['a]) { let f = pushByValue; let kk = k; f(kk, x) }
fn swappedIn['a](k: Sink['a], x: V['a]) -> usize {
    let f = "f"
    let mut mine = Array.of(V { s: &f })
    let mut kk = Sink { items: &mut mine }
    kk = k
    kk.items.push(x)
    mine.len()
}
fn calleeTakes['a](ks: &mut Array[Sink['a]], x: V['a]) { let t = ks.takeAt(0); if let Some(s) = t { pushByValue(s, x) } }
fn calleeTakesRef['a](ks: &mut Array[Sink['a]], x: V['a]) { let t = ks.takeAt(0); if let Some(s) = t { let mut ss = s; pushRef(&mut ss, x) } }
fn calleeTakesDirect['a](ks: &mut Array[Sink['a]], x: V['a]) { let t = ks.takeAt(0); if let Some(s) = t { s.items.push(x) } }
fn helperReturns['a](ks: &mut Array[Sink['a]], x: V['a]) { let s = at(ks); s.items.push(x) }
fn calleeTakesReads['a](ks: &mut Array[Sink['a]]) -> usize { let t = ks.takeAt(0); if let Some(s) = t { s.items.len() } else { 0 } }

fn ownLifetime() -> String {
    let u = "u"
    let v = "v"
    let mut a = Array.of(V { s: &u })
    forwardLocal2(Sink { items: &mut a }, V { s: &v })
    direct2(Sink { items: &mut a }, V { s: &v })
    Sink { items: &mut a }.putLocalCopy(V { s: &v })
    refOfCopy(Sink { items: &mut a }, V { s: &v })
    wrapped(Sink { items: &mut a }, V { s: &v })
    mutSelfOnCopy(Sink { items: &mut a }, V { s: &v })
    fnValueCopy(Sink { items: &mut a }, V { s: &v })
    let m = swappedIn(Sink { items: &mut a }, V { s: &v })
    let n = churn()
    "${a.len()} ${a[1].s} ${a[4].s} ${a[8].s} ${m} ${n}"
}

fn takenOwnLifetime() -> String {
    let u = "u"
    let v = "v"
    let mut a = Array.of(V { s: &u })
    { let mut ks = Array.of(Sink { items: &mut a }); calleeTakes(&mut ks, V { s: &v }) }
    { let mut ks = Array.of(Sink { items: &mut a }); calleeTakesRef(&mut ks, V { s: &v }) }
    { let mut ks = Array.of(Sink { items: &mut a }); calleeTakesDirect(&mut ks, V { s: &v }) }
    { let mut ks = Array.of(Sink { items: &mut a }); helperReturns(&mut ks, V { s: &v }) }
    let r = { let mut ks = Array.of(Sink { items: &mut a }); calleeTakesReads(&mut ks) }
    let n = churn()
    "${a.len()} ${a[1].s} ${a[4].s} ${r} ${n}"
}

fn localHolder['a](k: Sink['a]) -> usize {
    let loc = "l${churn()}"
    let f = "f"
    let mut mine = Array.of(V { s: &f })
    let h = Sink { items: &mut mine }
    h.items.push(V { s: &loc })
    let mut hs = Array.of(Sink { items: &mut mine })
    if let Some(g) = hs.takeAt(0) { g.items.push(V { s: &loc }) }
    let kk = k
    kk.items.len() * 10 + mine.len()
}

fn arrayIndex['a](k: Sink['a], x: V['a]) { let mut arr = Array.of(k); arr[0].items.push(x) }
fn arrayTake['a](k: Sink['a], x: V['a]) { let mut arr = Array.of(k); let t = arr.takeAt(0); if let Some(s) = t { s.items.push(x) } }
fn arrayLoop['a](k: Sink['a], x: V['a]) { let arr = Array.of(k); for s in arr { s.items.push(x) } }
fn resultOf['a](k: Sink['a], x: V['a]) { let r: Result[Sink['a], Int] = Ok(k); if let Ok(s) = r { s.items.push(x) } }

fn arrays() -> String {
    let u = "u"
    let mut a = Array.of(V { s: &u })
    arrayIndex(Sink { items: &mut a }, V { s: &u })
    arrayTake(Sink { items: &mut a }, V { s: &u })
    arrayLoop(Sink { items: &mut a }, V { s: &u })
    resultOf(Sink { items: &mut a }, V { s: &u })
    let n = churn()
    "${a.len()} ${a[4].s} ${n}"
}

fn frameHolders() -> String {
    let u = "u"
    let mut a = Array.of(V { s: &u })
    let m = localHolder(Sink { items: &mut a })
    "${m} ${a.len()}"
}

fn apply['a](g: fn(V['a]) -> Void, x: V['a]) { g(x) }
fn pushArr['a](a: &mut Array[V['a]], x: V['a]) { a.push(x) }
fn ownDirect['a](mut k: Own['a]) -> usize { let loc = "l"; k.own.push(V { s: &loc }); k.own.len() }
fn ownRefDirect['a](mut k: Own['a]) -> usize { let loc = "l"; let r = &mut k.own; r.push(V { s: &loc }); k.own.len() }
fn ownHelper['a](mut k: Own['a]) -> usize { let loc = "l"; pushArr(&mut k.own, V { s: &loc }); k.own.len() }
fn ownHelperRef['a](mut k: Own['a]) -> usize { let loc = "l"; let r = &mut k.own; pushArr(r, V { s: &loc }); k.own.len() }
fn ownLocalClosure['a](k: Own['a]) -> String {
    let loc = "l"
    let mut c = k
    let r = &mut c.own
    apply((x: V['a]) => { r.push(x) }, V { s: &loc })
    let n = churn()
    "${c.own.len()} ${c.own[1].s} ${n}"
}
fn capSinkRef['a](k: Sink['a], x: V['a]) { let r = k.items; apply((x: V['a]) => { r.push(x) }, x) }
fn capTakenRef['a](ks: &mut Array[Sink['a]], x: V['a]) { if let Some(s) = ks.takeAt(0) { let r = s.items; apply((x: V['a]) => { r.push(x) }, x) } }
fn capFieldRef['a](w: W['a], x: V['a]) { let r = w.inner.items; apply((x: V['a]) => { r.push(x) }, x) }
fn capCopy['a](k: Sink['a], x: V['a]) { let kk = k; apply((x: V['a]) => { kk.items.push(x) }, x) }
fn capTaken['a](ks: &mut Array[Sink['a]], x: V['a]) { if let Some(s) = ks.takeAt(0) { apply((x: V['a]) => { s.items.push(x) }, x) } }
fn capDirect['a](k: Sink['a], x: V['a]) { apply((x: V['a]) => { k.items.push(x) }, x) }

fn capturedOwnLifetime() -> String {
    let u = "u"
    let v = "v"
    let mut a = Array.of(V { s: &u })
    capSinkRef(Sink { items: &mut a }, V { s: &v })
    { let mut ks = Array.of(Sink { items: &mut a }); capTakenRef(&mut ks, V { s: &v }) }
    capFieldRef(W { inner: Sink { items: &mut a } }, V { s: &v })
    capCopy(Sink { items: &mut a }, V { s: &v })
    { let mut ks = Array.of(Sink { items: &mut a }); capTaken(&mut ks, V { s: &v }) }
    capDirect(Sink { items: &mut a }, V { s: &v })
    let n = churn()
    "${a.len()} ${a[1].s} ${a[2].s} ${a[3].s} ${a[4].s} ${a[5].s} ${a[6].s} ${n}"
}

fn applyIn['b](g: fn(V['b]) -> Void, x: V['b]) { g(x) }
fn applyDeep['c](g: fn(V['c]) -> Void, x: V['c]) { g(x) }
fn nestedLocalPushed['a](k: Own['a], out: &mut Array[Own['a]], v: V['a]) { let mut c = k; let r = &mut c.own; apply((x: V['a]) => { applyIn((y: V['a]) => { r.push(y) }, x) }, v); out.push(c) }
fn nestedReturned['a](mut k: Own['a], v: V['a]) -> Own['a] { let r = &mut k.own; apply((x: V['a]) => { applyIn((y: V['a]) => { r.push(y) }, x) }, v); k }
fn Own['a].nestedSelf(mut self, v: V['a]) { let r = &mut self.own; apply((x: V['a]) => { applyIn((y: V['a]) => { r.push(y) }, x) }, v) }
fn nestedRefParam['a](k: &mut Own['a], v: V['a]) { let r = &mut k.own; apply((x: V['a]) => { applyIn((y: V['a]) => { r.push(y) }, x) }, v) }
fn deepLocalPushed['a](k: Own['a], out: &mut Array[Own['a]], v: V['a]) { let mut c = k; let r = &mut c.own; apply((x: V['a]) => { applyIn((y: V['a]) => { applyDeep((z: V['a]) => { r.push(z) }, y) }, x) }, v); out.push(c) }
fn deepReturned['a](mut k: Own['a], v: V['a]) -> Own['a] { let r = &mut k.own; apply((x: V['a]) => { applyIn((y: V['a]) => { applyDeep((z: V['a]) => { r.push(z) }, y) }, x) }, v); k }
fn Own['a].deepSelf(mut self, v: V['a]) { let r = &mut self.own; apply((x: V['a]) => { applyIn((y: V['a]) => { applyDeep((z: V['a]) => { r.push(z) }, y) }, x) }, v) }
fn deepRefParam['a](k: &mut Own['a], v: V['a]) { let r = &mut k.own; apply((x: V['a]) => { applyIn((y: V['a]) => { applyDeep((z: V['a]) => { r.push(z) }, y) }, x) }, v) }

fn nestedOwnLifetime() -> String {
    let u = "u"
    let v = "v"
    let mut out = Array.of(Own { own: Array.of(V { s: &u }) })
    nestedLocalPushed(Own { own: Array.of(V { s: &u }) }, &mut out, V { s: &v })
    deepLocalPushed(Own { own: Array.of(V { s: &u }) }, &mut out, V { s: &v })
    let got = nestedReturned(Own { own: Array.of(V { s: &u }) }, V { s: &v })
    let deep = deepReturned(Own { own: Array.of(V { s: &u }) }, V { s: &v })
    let mut k = Own { own: Array.of(V { s: &u }) }
    k.nestedSelf(V { s: &v })
    k.deepSelf(V { s: &v })
    nestedRefParam(&mut k, V { s: &v })
    deepRefParam(&mut k, V { s: &v })
    let n = churn()
    "${out[1].own.len()} ${out[1].own[1].s} ${out[2].own.len()} ${out[2].own[1].s} ${got.own.len()} ${got.own[1].s} ${deep.own.len()} ${deep.own[1].s} ${k.own.len()} ${k.own[1].s} ${k.own[2].s} ${k.own[3].s} ${k.own[4].s} ${n}"
}

fn ownTakenClosure['a](x: V['a]) -> usize {
    let loc = "frame-local"; let mut c = Own { own: Array.of(x) }
    let mut arr = Array.of(Sink { items: &mut c.own })
    if let Some(s) = arr.takeAt(0) {
        let r = s.items
        apply((y: V['a]) => { r.push(y) }, V { s: &loc })
    }
    c.own.len()
}
fn ownUnwrapClosure['a](x: V['a]) -> usize {
    let loc = "frame-local"; let mut c = Own { own: Array.of(x) }
    let mut arr = Array.of(Sink { items: &mut c.own })
    let s = arr.takeAt(0).unwrap()
    let r = s.items
    apply((y: V['a]) => { r.push(y) }, V { s: &loc })
    c.own.len()
}
print ownLifetime()
print takenOwnLifetime()
print frameHolders()
print arrays()
print capturedOwnLifetime()
let u = "u"
print "${ownDirect(Own { own: Array.of(V { s: &u }) })} ${ownRefDirect(Own { own: Array.of(V { s: &u }) })} ${ownHelper(Own { own: Array.of(V { s: &u }) })} ${ownHelperRef(Own { own: Array.of(V { s: &u }) })}"
print ownLocalClosure(Own { own: Array.of(V { s: &u }) })
print nestedOwnLifetime()
print "${ownTakenClosure(V { s: &u })} ${ownUnwrapClosure(V { s: &u })}"

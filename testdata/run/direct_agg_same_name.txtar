-- src --
import os from std/os
import time from std/time

// Both names are taken by direct types of std too; the module keeps the two apart.
type Signal = Up(n: Int) | Down

type Instant = {
    pub ticks Int
}

fn mine(s: Signal) -> Int {
    match s {
        Up(n) -> n
        Down -> 0
    }
}

fn theirs(s: os.Signal) -> Int {
    match s {
        os.Signal.Interrupt -> 1
        _ -> 2
    }
}

fn later(i: Instant) -> Instant { Instant { ticks: i.ticks + 1 } }

let start = time.now()
let mut boxes = Array.of(Up(4), Down)
boxes.push(Up(5))
let mut total = 0
for s in boxes { total = total + mine(s) }
print "signal=${mine(Up(3))} ${theirs(os.Signal.Terminate)} ${total}"
print "instant=${later(Instant { ticks: 1 }).ticks} ${start.elapsedMillis() >= 0}"
-- stdout --
signal=3 2 9
instant=2 true

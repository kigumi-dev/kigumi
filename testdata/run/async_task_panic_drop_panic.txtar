-- src --
import task from std/task

type Res = resource {
    pub id Int
}

fn Res.drop(move self) -> Unit {
    print "drop ${self.id}"
    if self.id == 1 {
        panic("drop panic 1")
    }
}

async fn tick() -> Int {
    1
}

async fn inner() -> Int {
    let r = Res { id: 1 }
    let v = await tick()
    panic("first")
}

// A panic raised while the fault is swept joins it, and the rest of the sweep still runs.
async fn boom() -> Int {
    let r = Res { id: 2 }
    let v = await inner()
    v
}

async fn root() -> Int {
    let a = task.spawn(boom())
    await a
}

let ex = task.currentThreadExecutor()
print "total ${ex.runToCompletion(root())}"
-- stdout --
drop 1
drop 2
-- stderr --
panic: first
panic: drop panic 1
-- exit --
2

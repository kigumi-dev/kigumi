-- src --
type Guard = resource {
    pub id Int
}

fn Guard.drop(move self) {
    let _: Void = None.expect("drop panicked: ${self.id}")
}

fn scope() {
    let g = Guard { id: 7 }
    _ = g
}

print "start"
scope()
print "unreachable"
-- stdout --
start
-- stderr --
panic: drop panicked: 7
-- exit --
2

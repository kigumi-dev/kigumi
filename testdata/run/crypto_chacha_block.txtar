-- src --
import chacha from std/crypto/chacha20poly1305
import hex from std/encoding/hex

fn show(b: Bytes) -> String {
    hex.encode(b)
}

fn dec(s: String) -> Bytes {
    hex.decode(s).expect("hex")
}

// RFC 8439 §2.3.2: the block function at counter 1
let key = dec("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
let nonce = dec("000000090000004a00000000")
print "rfc-block ${show(chacha.chacha20Block(key, 1, nonce))}"

// RFC 8439 §2.6.2: the Poly1305 one-time key is the first half of block 0
let polyKey = chacha.poly1305Key(dec("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f"), dec("000000000001020304050607"))
print "rfc-polykey ${show(polyKey)}"

// RFC 8439 §2.4.2: two full blocks and a partial third
let plaintext = b"Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it."
let cipherNonce = dec("000000000000004a00000000")
let cipher = chacha.chacha20Xor(key, 1, cipherNonce, plaintext)
print "rfc-cipher ${show(cipher)}"
print "roundtrip ${show(chacha.chacha20Xor(key, 1, cipherNonce, cipher))}"
print "empty ${show(chacha.chacha20Xor(key, 1, cipherNonce, Bytes.zeros(0)))}"

// A full 64-byte block at counter 7
print "block64 ${show(chacha.chacha20Xor(key, 7, nonce, Bytes.fill(0x61, 64)))}"

// The unclamped counter-zero block and the sizes the API promises
print "counter0 ${show(chacha.chacha20Block(key, 0, cipherNonce))}"
print "sizes ${chacha.keySize} ${chacha.nonceSize} ${chacha.blockSize}"

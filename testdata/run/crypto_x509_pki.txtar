-- src --
// X.509 parsing, signature, hostname and chain vectors. Certificates were
// generated with OpenSSL 3.5 and embedded as DER hex; NOW is 2026-01-01Z.
import x509 from std/crypto/x509
import hex from std/encoding/hex

const NOW = 1767225600000
const ROOT = ""
const INTER = ""
const LEAF = ""
const EXPIRED = ""
const FUTURE = ""
const PSS = ""
const SELF = ""
const PLROOT = ""
const PLINTER = ""
const PATHLEAF = ""
const BADINTER = ""
const BADLEAF = ""
const ECROOT = ""
const ECINTER = ""
const ECLEAF = ""
const CRITICAL = ""
const MALFORMED = ""
const UNKNOWNALG = ""
const BADSIG = ""
const LEAF_PEM = "-----BEGIN CERTIFICATE-----\nMIIDlTCCAn2gAwIBAgICIAEwDQYJKoZIhvcNAQELBQAwPTELMAkGA1UEBhMCVVMx\nDzANBgNVBAoMBktpZ3VtaTEdMBsGA1UEAwwUVGVzdCBJbnRlcm1lZGlhdGUgQ0Ew\nHhcNMjQwMTAxMDAwMDAwWhcNNDAwMTAxMDAwMDAwWjA4MQswCQYDVQQGEwJVUzEP\nMA0GA1UECgwGS2lndW1pMRgwFgYDVQQDDA93d3cuZXhhbXBsZS5jb20wggEiMA0G\nCSqGSIb3DQEBAQUAA4IBDwAwggEKAoIBAQCsBFfqVqaV5KKZTcg8wQKjeT06KhPl\nbZIonE8NM71rbNViuIIyZrMNuf/UC0TcOv/MeHEuXnPP+319NCUIgkjN8f5UROlD\nFvxF97n53t3cS8U30ju1mUJ/kQtYlnqBEHjdCUWnbI6/heVH6ZpUBoOUUJuLOZnt\n57ePPlcVsqC7Ke2t7kN0VAxu3GkB5Bl633AAU+UFV1qrpuIJZ4ea8JTq3nR++DaL\nsYqplDHhQ85pExyXlyPrm64IhAc8o1fVPCYuyrwQ+gL8k4id1E4Mie1mKzAG/iwF\n/R21j9qQs9moCvY6Bg133GjG0dWvcd3aT0aX6LcMMUIK/HIzMAX9AVPtAgMBAAGj\ngaMwgaAwDAYDVR0TAQH/BAIwADAOBgNVHQ8BAf8EBAMCBaAwEwYDVR0lBAwwCgYI\nKwYBBQUHAwEwKwYDVR0RBCQwIoILZXhhbXBsZS5jb22CDSouZXhhbXBsZS5jb22H\nBH8AAAEwHQYDVR0OBBYEFIvOqHpqJLeUR2pmqoLeul3WPyBPMB8GA1UdIwQYMBaA\nFMAzHqm0/mUpEUgpEAS+xhK/4y/gMA0GCSqGSIb3DQEBCwUAA4IBAQAQAhY0LzmZ\ndEWDk8qUQQNAxkj9N3DQ6qIXiavmMEx8PtccEb0/jsHHXfARaTFclquhYs1Scd+k\nBZbdO5T2/AO9fOqNDwQ1AUac5KUeNIHENHbvbRNJupwbGOYteTp9ygWAZ+2jGDc4\n8UErgFBrs9SpnVWo3FcNUNVqSI8bWZvjvIZrcRiw0SLLwS8ZEFrzrgW+4Z21e2MY\nZfO+p0QGLPWhjR2AtJ7vMpkcHIj8ScSfKdyKIJWTZ+6RxSvuvIZBpJOR/cViCvmK\n7Qt22t4lGmUuxaH105IHlTwv4CaeDabB8OBPma8NZ9qELueGJmhiUr3Y3xF51c6+\nkbTX7cJo7xKM\n-----END CERTIFICATE-----\n"

fn res(r: Result[Void, x509.ValidationError]) -> String {
    match r {
        Ok(_) -> "ok"
        Err(e) -> e.message()
    }
}

fn parseResult(text: String) -> String {
    let bytes = match hex.decode(text) {
        Ok(value) -> value
        Err(e) -> return "hex: ${e.message()}"
    }
    match x509.parse(bytes) {
        Ok(_) -> "ok"
        Err(e) -> e.message()
    }
}

fn keyKind(key: x509.PublicKey) -> String {
    match key {
        x509.PublicKey.Rsa(_) -> "rsa"
        x509.PublicKey.EcP256(_) -> "ec-p256"
    }
}

fn signatureKind(algorithm: x509.SignatureAlgorithm) -> String {
    match algorithm {
        x509.SignatureAlgorithm.Sha256WithRsa -> "sha256-rsa"
        x509.SignatureAlgorithm.RsaPssSha256 -> "rsa-pss-sha256"
        x509.SignatureAlgorithm.EcdsaSha256 -> "ecdsa-sha256"
    }
}

fn main() -> Void! {
    let root = x509.parse(hex.decode(ROOT)?)?
    let inter = x509.parse(hex.decode(INTER)?)?
    let leaf = x509.parse(hex.decode(LEAF)?)?
    let expired = x509.parse(hex.decode(EXPIRED)?)?
    let future = x509.parse(hex.decode(FUTURE)?)?
    let pss = x509.parse(hex.decode(PSS)?)?
    let self = x509.parse(hex.decode(SELF)?)?
    let plroot = x509.parse(hex.decode(PLROOT)?)?
    let plinter = x509.parse(hex.decode(PLINTER)?)?
    let pathleaf = x509.parse(hex.decode(PATHLEAF)?)?
    let badinter = x509.parse(hex.decode(BADINTER)?)?
    let badleaf = x509.parse(hex.decode(BADLEAF)?)?
    let ecroot = x509.parse(hex.decode(ECROOT)?)?
    let ecinter = x509.parse(hex.decode(ECINTER)?)?
    let ecleaf = x509.parse(hex.decode(ECLEAF)?)?
    let critical = x509.parse(hex.decode(CRITICAL)?)?
    let badsig = x509.parse(hex.decode(BADSIG)?)?

    print "root v${root.version} serial=${hex.encode(root.serial)} cn=${root.subject.commonName || "?"} o=${root.subject.organization || "?"} ca=${root.basicConstraints.ca} pathlen=${root.basicConstraints.pathLen || -1} keycertsign=${root.keyUsage.keyCertSign} ski=${root.subjectKeyId is Some(_)} aki=${root.authorityKeyId is Some(_)} key=${keyKind(root.publicKey)} sig=${signatureKind(root.signatureAlgorithm)}"
    print "inter cn=${inter.subject.commonName || "?"} ca=${inter.basicConstraints.ca} pathlen=${inter.basicConstraints.pathLen || -1} key=${keyKind(inter.publicKey)}"
    print "leaf cn=${leaf.subject.commonName || "?"} serial=${hex.encode(leaf.serial)} notbefore=${leaf.validity.notBefore.year}-${leaf.validity.notBefore.month}-${leaf.validity.notBefore.day} notafter=${leaf.validity.notAfter.year}-${leaf.validity.notAfter.month}-${leaf.validity.notAfter.day}"
    print "leaf san=${leaf.subjectAltNamesPresent} dns=${leaf.dnsNames.len()} [${leaf.dnsNames[0]},${leaf.dnsNames[1]}] ips=${leaf.ipAddresses.len()} ip4=${hex.encode(leaf.ipAddresses[0])} serverauth=${leaf.extKeyUsage.serverAuth} digital=${leaf.keyUsage.digitalSignature} keyenc=${leaf.keyUsage.keyEncipherment} ca=${leaf.basicConstraints.ca} ski=${leaf.subjectKeyId is Some(_)} aki=${leaf.authorityKeyId is Some(_)}"
    print "pss sig=${signatureKind(pss.signatureAlgorithm)} verify=${res(pss.verifySignedBy(&inter))}"
    print "ec key=${keyKind(ecleaf.publicKey)} sig=${signatureKind(ecleaf.signatureAlgorithm)} verify=${res(ecleaf.verifySignedBy(&ecinter))}"

    print "host exact=${res(leaf.verifyHostname("example.com"))} case=${res(leaf.verifyHostname("ExAmPle.COM"))}"
    print "host wildcard=${res(leaf.verifyHostname("api.example.com"))} deep=${res(leaf.verifyHostname("a.b.example.com"))} bare=${res(leaf.verifyHostname("example.com"))}"
    print "host ip=${res(leaf.verifyHostname("127.0.0.1"))} wrongip=${res(leaf.verifyHostname("127.0.0.2"))} wrong=${res(leaf.verifyHostname("other.example.org"))}"
    print "sig leaf=${res(leaf.verifySignedBy(&inter))} wrongkey=${res(leaf.verifySignedBy(&root))} wrongalg=${res(leaf.verifySignedBy(&ecinter))} bad=${res(badsig.verifySignedBy(&inter))}"
    let after = leaf.validity.notAfterMillis()
    print "valid=${res(leaf.checkValidity(NOW))} edge=${leaf.validity.containsMillis(after)} pastedge=${leaf.validity.containsMillis(after + 1)} expired=${res(expired.checkValidity(NOW))} future=${res(future.checkValidity(NOW))}"

    let pem = x509.parsePem(LEAF_PEM)?
    print "pem=${pem.len()} ${pem[0].subject.commonName || "?"}"

    print "parse empty=${parseResult("")}"
    let cut = (LEAF.len() / 2) - ((LEAF.len() / 2) % 2)
    print "parse trunc=${parseResult(LEAF.sliceBytes(0, cut) || "")}"
    print "parse trailing=${parseResult(LEAF.concat("00"))}"
    print "parse unknown-alg=${parseResult(UNKNOWNALG)}"
    print "parse malformed-bc=${parseResult(MALFORMED)}"

    let anchors = Array.of(root.clone())
    let chain = Array.of(leaf.clone(), inter.clone())
    print "chain valid=${res(x509.verifyChain(&anchors, &chain, "www.example.com", NOW))}"
    print "chain wildcard=${res(x509.verifyChain(&anchors, &chain, "api.example.com", NOW))}"
    print "chain wrong-host=${res(x509.verifyChain(&anchors, &chain, "wrong.example.org", NOW))}"
    let expChain = Array.of(expired.clone(), inter.clone())
    print "chain expired=${res(x509.verifyChain(&anchors, &expChain, "expired.example.com", NOW))}"
    let futChain = Array.of(future.clone(), inter.clone())
    print "chain future=${res(x509.verifyChain(&anchors, &futChain, "future.example.com", NOW))}"
    let selfChain = Array.of(self.clone())
    print "chain self-signed=${res(x509.verifyChain(&anchors, &selfChain, "self.example.com", NOW))}"
    let incomplete = Array.of(leaf.clone())
    print "chain incomplete=${res(x509.verifyChain(&anchors, &incomplete, "www.example.com", NOW))}"

    let plAnchors = Array.of(plroot.clone())
    let plChain = Array.of(pathleaf.clone(), plinter.clone())
    print "chain pathlen=${res(x509.verifyChain(&plAnchors, &plChain, "path.example.com", NOW))}"
    let badChain = Array.of(badleaf.clone(), badinter.clone())
    print "chain bad-keyusage=${res(x509.verifyChain(&anchors, &badChain, "badku.example.com", NOW))}"
    let critChain = Array.of(critical.clone(), inter.clone())
    print "chain critical-ext=${res(x509.verifyChain(&anchors, &critChain, "critical.example.com", NOW))}"

    let ecAnchors = Array.of(ecroot.clone())
    let ecChain = Array.of(ecleaf.clone(), ecinter.clone())
    print "chain ecdsa=${res(x509.verifyChain(&ecAnchors, &ecChain, "ec.example.com", NOW))}"
    let tamperedChain = Array.of(badsig.clone(), inter.clone())
    print "chain tampered=${res(x509.verifyChain(&anchors, &tamperedChain, "www.example.com", NOW))}"
    let empty = Array.empty[x509.Certificate]()
    print "chain empty=${res(x509.verifyChain(&anchors, &empty, "x", NOW))}"
}
-- stdout --
root v3 serial=1000 cn=Test Root CA o=Kigumi ca=true pathlen=2 keycertsign=true ski=true aki=false key=rsa sig=sha256-rsa
inter cn=Test Intermediate CA ca=true pathlen=1 key=rsa
leaf cn=www.example.com serial=2001 notbefore=2024-1-1 notafter=2040-1-1
leaf san=true dns=2 [example.com,*.example.com] ips=1 ip4=7f000001 serverauth=true digital=true keyenc=true ca=false ski=true aki=true
pss sig=rsa-pss-sha256 verify=ok
ec key=ec-p256 sig=ecdsa-sha256 verify=ok
host exact=ok case=ok
host wildcard=ok deep=x509: certificate does not match hostname a.b.example.com bare=ok
host ip=ok wrongip=x509: certificate does not contain an IP address SAN for 127.0.0.2 wrong=x509: certificate does not match hostname other.example.org
sig leaf=ok wrongkey=x509: signature does not verify wrongalg=x509: RSA signature requires an RSA issuer key bad=x509: signature does not verify
valid=ok edge=true pastedge=false expired=x509: certificate has expired future=x509: certificate is not yet valid
pem=1 www.example.com
parse empty=x509: asn1: truncated element identifier

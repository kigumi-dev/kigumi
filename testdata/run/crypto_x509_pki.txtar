parse malformed-bc=x509: basicConstraints pathLen requires cA
chain valid=ok
chain wildcard=ok
chain wrong-host=x509: certificate does not match hostname wrong.example.org
chain expired=x509: certificate has expired
chain future=x509: certificate is not yet valid
chain self-signed=x509: leaf certificate is self-signed
chain incomplete=x509: certificate chain does not reach a trust anchor
chain pathlen=x509: basicConstraints pathLen 0 exceeded
chain bad-keyusage=x509: CA certificate keyUsage lacks keyCertSign
chain critical-ext=x509: certificate has an unsupported critical extension
chain ecdsa=ok

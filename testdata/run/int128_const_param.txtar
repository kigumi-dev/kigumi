-- src --
fn pick[const N: i128]() -> i128 {
    N
}

fn wide[const N: u128]() -> u128 {
    N
}

fn doubled[const N: i128]() -> i128 {
    N * 2
}

const BIG: u128 = 18446744073709551616

print "${pick[-5]()} ${pick[170141183460469231731687303715884105727]()}"
print "${pick[-170141183460469231731687303715884105728]()} ${doubled[-3]()}"
print "${wide[0]()} ${wide[340282366920938463463374607431768211455]()} ${wide[BIG]()}"

-- src --
// Generated 2041-bit modulus: emLen = 255 while k = 256.
import hex from std/encoding/hex
import rsa from std/crypto/rsa

fn show(r: Result[Bool, rsa.Error]) -> String {
    match r { Ok(v) -> "${v}", Err(e) -> e.message() }
}

fn main() -> Void! {
    let pk = rsa.parsePkcs1(hex.decode("")?)?
    print "boundary-key ${pk.byteSize()} ${pk.bitSize()} ${pk.exponent()}"
    let msg = hex.decode("6b6967756d692072736120626f756e64617279")?
    print "boundary-pss-auto ${show(rsa.verifyPssSha256(pk, msg, hex.decode("")?, rsa.SaltLength.Auto))}"
    print "boundary-pss-exact ${show(rsa.verifyPssSha256(pk, msg, hex.decode("")?, rsa.SaltLength.Exact(32)))}"
    print "boundary-pkcs1 ${show(rsa.verifyPkcs1v15Sha256(pk, msg, hex.decode("")?))}"
    print "boundary-wrong ${show(rsa.verifyPkcs1v15Sha256(pk, b"x", hex.decode("")?))}"
    print "boundary-above-emlen ${show(rsa.verifyPssSha256(pk, msg, hex.decode("")?, rsa.SaltLength.Auto))}"
}
-- stdout --
boundary-key 256 2041 65537
boundary-pss-auto true
boundary-pss-exact true
boundary-pkcs1 true
boundary-wrong false
boundary-above-emlen false

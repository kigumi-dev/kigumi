-- src --
import secret from std/secret

fn secretSeven() -> u64 {
    let mut t = FixedArray.filled[u64, 4](0)
    _ = t.set(2, 7)
    secret.ctLookupU64(&t, secret.SecretIndex[4].from(secret.SecretU32.classify(2)))
}

fn valid(r: String!) -> Bool {
    r is Ok(_)
}

// A Result whose tag a primitive decided from a secret keeps that label when it is passed to a function.
let mut buf = ByteBuffer.tryNew(1).unwrap()
buf.set(0, secretSeven().wrappingAdd(121).truncate[u8]())
if valid(String.fromBytes(buf.freeze())) {
    print "valid"
} else {
    print "invalid"
}
-- stdout --
invalid
-- secret-san --
panic: SecretSan: secret value reaches a conditional branch in main.valid

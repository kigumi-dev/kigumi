-- src --
import task from std/task

async fn twice(x: Int) -> Int {
    print "twice ${x}"
    x * 2
}

async fn total(a: Int, b: Int) -> Int {
    let x = await twice(a)
    let y = await twice(b)
    x + y
}

async fn root() -> Int {
    let pending = total(1, 2)
    print "created"
    let t = task.spawn(twice(10))
    let a = await pending
    let b = await t
    print "${a} ${b}"
    a + b
}

let ex = task.currentThreadExecutor()
print "sum ${ex.runToCompletion(root())}"
-- stdout --
created
twice 1
twice 2
twice 10
6 20
sum 26

-- src --
import net from std/net

let n = host.net()
let mut l = n.listen("127.0.0.1", 0)?
let mut client = n.connect("127.0.0.1", l.port())?
let mut server = l.accept()?
client.close()?
let mut errors = 0
for i in 0..8 {
    let r = server.write("ping".toBytes())
    if r is Err(_) {
        errors = errors + 1
    }
}
print "survived ${errors > 0}"
-- stdout --
survived true

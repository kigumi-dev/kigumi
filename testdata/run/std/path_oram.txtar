-- src --
import secret from std/secret
import oram from std/secret/oram

// A storage adapter that records every level/index pair it is asked for. The
// adapter is a fixture: production adapters (SGX/CVM) implement the same
// interface over authenticated, padded pages.
type TraceStore = resource {
    mut buckets Array[oram.Bucket]
    mut depth usize
    mut log Array[usize]
}

fn TraceStore.new(leaves: usize, blockBytes: usize) -> TraceStore {
    let total = 2 * leaves - 1
    TraceStore {
        buckets: Array.fill[oram.Bucket](oram.Bucket.empty(blockBytes), total)
        depth: oram.levelOf(leaves)
        log: Array.empty[usize]()
    }
}

fn TraceStore.bucketCount(self, level: usize) -> usize {
    if level > self.depth {
        return 0
    }
    let one: usize = 1
    one << level
}

fn TraceStore.payloadBytes(self) -> usize {
    8
}

fn TraceStore.readBucket(mut self, level: usize, index: secret.SecretU32) -> oram.Bucket! {
    let want = unsafe { index.declassify() }.toU64()
    let count = self.bucketCount(level)
    let mut out = oram.Bucket.empty(8)
    let mut j: usize = 0
    for j < count {
        self.log.push(level * 1000000 + j * 2)
        let candidate = self.buckets.get(oram.levelOffset(level) + j) || oram.Bucket.empty(8)
        out = out.combine(oram.maskEq(j.toU64(), want), &candidate)
        j = j + 1
    }
    Ok(out)
}

fn TraceStore.writeBucket(mut self, level: usize, index: secret.SecretU32, bucket: oram.Bucket) -> Void! {
    let want = unsafe { index.declassify() }.toU64()
    let count = self.bucketCount(level)
    let mut j: usize = 0
    for j < count {
        self.log.push(level * 1000000 + j * 2 + 1)
        let at = oram.levelOffset(level) + j
        let mut current = self.buckets.get(at) || oram.Bucket.empty(8)
        self.buckets[at] = current.combine(oram.maskEq(j.toU64(), want), &bucket)
        j = j + 1
    }
}

fn TraceStore.split(move self, leaves: usize, blockBytes: usize) -> oram.Split[TraceStore]! {
    Ok(oram.Split { root: self, child: TraceStore.new(leaves, blockBytes) })
}

fn TraceStore.sameTrace(self, other: &TraceStore) -> Bool {
    self.log.equals(&other.log)
}

fn TraceStore.traceLen(self) -> usize {
    self.log.len()
}


// A page-level trace adapter for the authenticated wrapper. Two sealed
// arrays that write different secret indices must still ask the untrusted
// provider for the same pages in the same order.
type TracePageStore = resource {
    mut pages Array[Bytes]
    mut depth usize
    mut log Array[usize]
}

fn TracePageStore.new(leaves: usize) -> TracePageStore {
    let total = 2 * leaves - 1
    TracePageStore {
        pages: Array.fill[Bytes]("".toBytes(), total)
        depth: oram.levelOf(leaves)
        log: Array.empty[usize]()
    }
}

fn TracePageStore.bucketCount(self, level: usize) -> usize {
    if level > self.depth {
        return 0
    }
    let one: usize = 1
    one << level
}

fn TracePageStore.leafCount(self) -> usize {
    let one: usize = 1
    one << self.depth
}

fn TracePageStore.readPage(mut self, level: usize, index: secret.SecretU32, len: usize) -> Bytes! {
    let want = unsafe { index.declassify() }.toU64()
    let count = self.bucketCount(level)
    let mut out = Bytes.zeros(len)
    let mut j: usize = 0
    for j < count {
        self.log.push(level * 1000000 + j * 2)
        let candidate = self.pages.get(oram.levelOffset(level) + j) || "".toBytes()
        out = oram.selectBytes(oram.maskEq(j.toU64(), want), candidate, out)
        j = j + 1
    }
    Ok(out)
}

fn TracePageStore.writePage(mut self, level: usize, index: secret.SecretU32, page: Bytes) -> Void! {
    let want = unsafe { index.declassify() }.toU64()
    let count = self.bucketCount(level)
    let mut j: usize = 0
    for j < count {
        self.log.push(level * 1000000 + j * 2 + 1)
        let at = oram.levelOffset(level) + j
        let current = self.pages.get(at) || "".toBytes()
        self.pages[at] = oram.selectBytes(oram.maskEq(j.toU64(), want), page, current)
        j = j + 1
    }
}

fn TracePageStore.split(move self, leaves: usize) -> oram.Split[TracePageStore]! {
    Ok(oram.Split { root: self, child: TracePageStore.new(leaves) })
}

fn TracePageStore.sameTrace(self, other: &TracePageStore) -> Bool {
    self.log.equals(&other.log)
}

fn ix8(i: u32) -> secret.SecretIndex[8] {
    secret.SecretIndex[8].from(secret.SecretU32.classify(i))
}

fn ix32(i: u32) -> secret.SecretIndex[32] {
    secret.SecretIndex[32].from(secret.SecretU32.classify(i))
}

fn ix128(i: u32) -> secret.SecretIndex[128] {
    secret.SecretIndex[128].from(secret.SecretU32.classify(i))
}

// The access pattern is a function of N and the operation, not of the secret
// index: two fresh arrays that write different indices see the same trace.
let mut left = oram.ObliviousArray[TraceStore, 8].withStore(TraceStore.new(8, 8), 7)?
let mut right = oram.ObliviousArray[TraceStore, 8].withStore(TraceStore.new(8, 8), 7)?
left.write(ix8(1), 11)?
right.write(ix8(6), 22)?
let same = left.withStore((a: &TraceStore) => right.withStore((b: &TraceStore) => a.sameTrace(b)))
let steps = left.withStore((a: &TraceStore) => a.traceLen())
print "shape=${same} steps=${steps}"

// Correctness: every value survives repeated writes and reads, and the
// position map and block positions stay consistent.
let mut table = oram.onMemory[8](3)?
let mut i: u32 = 0
for i < 8 {
    table.write(ix8(i), i.toU64().wrappingMul(11))?
    i = i + 1
}
table.write(ix8(4), 999)?
i = 0
let mut ok: u64 = 1
for i < 8 {
    let want = if i == 4 { 999 } else { i.toU64().wrappingMul(11) }
    if table.read(ix8(i))? != want {
        ok = 0
    }
    i = i + 1
}
table.verify()?
print "data=${ok}"

// A size the controller does not support is an explicit error, not a
// truncation or a silently padded tree.
let bad = oram.onMemory[7](1)
let tooBig = oram.onMemory[33554432](1)
print "unsupported=${(bad is Err(_)) && (tooBig is Err(_))}"

// An adapter built for a different tree shape is refused instead of being
// indexed out of range.
let wrongShape = oram.ObliviousArray[TraceStore, 8].withStore(TraceStore.new(4, 8), 1)
print "mismatch=${wrongShape is Err(_)}"

// The position map is recursive: 128 slots need two map trees above the data
// tree instead of a 128-entry client table. Values and repeated access still
// round-trip, and verification walks every level.
let mut rec = oram.onMemory[128](5)?
let mut rok: u64 = 1
i = 0
for i < 4 {
    let at = i.wrappingMul(9).wrappingAdd(2)
    rec.write(ix128(at), i.toU64().wrappingMul(5))?
    i = i + 1
}
i = 0
for i < 4 {
    let at = i.wrappingMul(9).wrappingAdd(2)
    if rec.read(ix128(at))? != i.toU64().wrappingMul(5) {
        rok = 0
    }
    i = i + 1
}
rec.verify()?
print "recursive=${rok} levels=${rec.levelCount()}"

// SecretBuffer-sized payloads use the same recursive tree. Bytes are copied
// through masked selects and padded to the public block width.
let mut buf = oram.bufferOnMemory[32](6, 40)?
let payload = secret.SecretBuffer.fromString("hello secret oram")
buf.writeSecret(ix32(17), payload)?
let out = buf.readSecret(ix32(17))?
let got = unsafe { out.equals(&secret.SecretBuffer.fromString("hello secret oram")).declassify() }
let empty = buf.readSecret(ix32(7))?
buf.verify()?
print "buffer=${got} len=${out.len()} empty=${empty.len()}"


// The sealed adapter is shape-preserving at the provider boundary: sealing
// adds no secret-index-dependent page access.
let keyLeft = secret.SecretBuffer.fromString("fedcba9876543210fedcba9876543210")
let keyRight = secret.SecretBuffer.fromString("fedcba9876543210fedcba9876543210")
let sealedLeft = oram.SealedStore[TracePageStore].new(TracePageStore.new(8), keyLeft, 31, 8, 8)?
let sealedRight = oram.SealedStore[TracePageStore].new(TracePageStore.new(8), keyRight, 31, 8, 8)?
let mut leftTable = oram.ObliviousArray[oram.SealedStore[TracePageStore], 8].withStore(sealedLeft, 7)?
let mut rightTable = oram.ObliviousArray[oram.SealedStore[TracePageStore], 8].withStore(sealedRight, 7)?
leftTable.write(ix8(1), 11)?
rightTable.write(ix8(6), 22)?
let sealedSame = leftTable.withStore((a: &oram.SealedStore[TracePageStore]) =>
    a.withInner((pa: &TracePageStore) =>
        rightTable.withStore((b: &oram.SealedStore[TracePageStore]) =>
            b.withInner((pb: &TracePageStore) => pa.sameTrace(pb)))))
print "sealedShape=${sealedSame}"

// The authenticated adapter seals every page. A clean round trip works and a
// single flipped byte anywhere on the root path is detected.
let key = secret.SecretBuffer.fromString("0123456789abcdef0123456789abcdef")
let sealed = oram.sealedMemory[8](key, 21)?
let mut sealedTable = oram.ObliviousArray[oram.SealedStore[oram.MemoryPageStore], 8].withStore(sealed, 8)?
sealedTable.write(ix8(5), 77)?
let sealedValue = sealedTable.read(ix8(5))?
sealedTable.verify()?
print "sealed=${sealedValue}"
sealedTable.withStoreMut((st: &mut oram.SealedStore[oram.MemoryPageStore]) =>
    st.withInnerMut((p: &mut oram.MemoryPageStore) => p.corrupt(0, 0, 12)))
let tampered = sealedTable.verify()
print "tamper=${tampered is Err(_)}"
print "path-oram-ok"
-- stdout --
shape=true steps=60
data=1
unsupported=true
mismatch=true
recursive=1 levels=2
buffer=true len=17 empty=0
sealedShape=true
sealed=77
tamper=true
path-oram-ok

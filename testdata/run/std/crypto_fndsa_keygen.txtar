-- src --
import fndsa from std/crypto/fndsa
import hex from std/encoding/hex

fn main() -> Void! {
    // Deterministic Falcon-512 key generation. The expected key below was
    // cross-checked against the reference Falcon implementation: Python
    // verifies f*G - g*F = q in Z[x]/(x^512+1) and h = g/f mod q, and its
    // decoded h equals this public key exactly.
    let seed = hex.decode("061550234D158C5EC95595FE04EF7A25767F2E24CC2BC479D09D86DC9ABCFDE7056A8C266F9EF97ED08541DBD2E1FFA10011223344556677")?
    let kp = fndsa.keyGen(seed)?
    print "pk len=${kp.publicKey.len()} sk len=${kp.secretKey.len()}"
    print "pk match=${hex.encode(kp.publicKey) == ""}"
    print "sk match=${hex.encode(kp.secretKey) == ""}"
    print "pk derived match=${hex.encode(fndsa.publicKeyOf(kp.secretKey)?) == hex.encode(kp.publicKey)}"
    let msg = "hello falcon".toBytes()
    let salt = Bytes.zeros(40)
    let sig = fndsa.sign(kp.secretKey, msg, salt)?
    print "sign/verify=${fndsa.verify(kp.publicKey, msg, sig)?}"
    match fndsa.keyGen(Bytes.zeros(32)) {
        Ok(_) -> print "short seed: unexpected"
        Err(e) -> print "short seed: ${e.message()}"
    }
}
-- stdout --
pk len=897 sk len=1281
pk match=true
sk match=true
pk derived match=true
sign/verify=true
short seed: fndsa: seed must be 56 bytes

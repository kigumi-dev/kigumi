-- src --
import secret from std/secret

let a = secret.SecretU32.classify(0x12345678)
let b = secret.SecretU32.classify(0x0F0F0F0F)
let z = secret.SecretU32.classify(0)

print "xor ${(unsafe { (a ^ b).declassify() })}"
print "and ${(unsafe { (a & b).declassify() })}"
print "or ${(unsafe { (a | b).declassify() })}"
print "not ${(unsafe { (~z).declassify() })}"
print "add ${(unsafe { a.wrappingAdd(b).declassify() })}"
print "sub ${(unsafe { z.wrappingSub(secret.SecretU32.classify(1)).declassify() })}"
print "mul ${(unsafe { secret.SecretU32.classify(7).wrappingMul(secret.SecretU32.classify(9)).declassify() })}"
print "shl ${(unsafe { secret.SecretU32.classify(1).shiftLeft(33).declassify() })}"
print "shr ${(unsafe { secret.SecretU32.classify(0x80000000).shiftRight(31).declassify() })}"
print "rotl ${(unsafe { secret.SecretU32.classify(1).rotateLeft(4).declassify() })}"
print "rotr ${(unsafe { secret.SecretU32.classify(1).rotateRight(4).declassify() })}"

let eq = a.ctEq(a)
let ne = a.ctEq(b)
let lt = a.ctLt(b)
let zero = z.ctIsZero()
print "eq ${(unsafe { eq.declassify() })} ${(unsafe { ne.declassify() })}"
print "lt ${(unsafe { lt.declassify() })}"
print "zero ${(unsafe { zero.declassify() })}"
print "select ${(unsafe { lt.selectU32(a, b).declassify() })}"

let x = Bytes.fromArray(&Array.of[u8](1, 2, 3, 4))
let y = Bytes.fromArray(&Array.of[u8](1, 2, 3, 4))
let w = Bytes.fromArray(&Array.of[u8](1, 2, 9, 4))
print "bytes eq ${(unsafe { secret.ctEqBytes(&x, &y).declassify() })}"
print "bytes ne ${(unsafe { secret.ctEqBytes(&x, &w).declassify() })}"

let mut wide = secret.SecretU64.classify(0xFFFFFFFFFFFFFFFF)
print "u64 ${(unsafe { wide.declassify() })}"
wide = secret.SecretU64.classify(1)
print "u8 ${(unsafe { secret.SecretU8.classify(255).wrappingAdd(secret.SecretU8.classify(1)).declassify() })}"
print "u16 ${(unsafe { secret.SecretU16.classify(1).shiftLeft(16).declassify() })}"
-- stdout --
xor 490428791
and 33818120
or 524246911
not 4294967295
add 558065031
sub 4294967295
mul 63
shl 2
shr 1
rotl 16
rotr 268435456
eq true false
lt false
zero true
select 252645135
bytes eq true
bytes ne false
u64 18446744073709551615
u8 0
u16 1

-- src --
import hex from std/encoding/hex
import hkdf from std/crypto/hkdf
import sha256 from std/crypto/sha256

fn show(b: Bytes) -> String {
    hex.encode(b)
}

// n バイトの連番 (start から)
fn seq(start: usize, n: usize) -> Bytes {
    let mut a = Array.empty[u8]()
    let mut i: usize = 0
    for i < n {
        a.push((start + i).toU8() || 0)
        i = i + 1
    }
    Bytes.fromArray(&a)
}

// RFC 5869 §A.1 test case 1: salt と info あり
let ikm1 = Bytes.fill(0x0b, 22)
let salt1 = hex.decode("000102030405060708090a0b0c").unwrap()
let info1 = hex.decode("f0f1f2f3f4f5f6f7f8f9").unwrap()
print "case1-prk ${show(hkdf.extract[sha256.Hasher](salt1, ikm1))}"
print "case1-okm ${show(hkdf.expand[sha256.Hasher](hkdf.extract[sha256.Hasher](salt1, ikm1), info1, 42).unwrap())}"
print "case1-derive ${show(hkdf.derive[sha256.Hasher](salt1, ikm1, info1, 42).unwrap())}"

// RFC 5869 §A.2 test case 2: 全入力が 80 バイト
let ikm2 = seq(0x00, 80)
let salt2 = seq(0x60, 80)
let info2 = seq(0xb0, 80)
print "case2-prk ${show(hkdf.extract[sha256.Hasher](salt2, ikm2))}"
print "case2-okm ${show(hkdf.derive[sha256.Hasher](salt2, ikm2, info2, 82).unwrap())}"

// RFC 5869 §A.3 test case 3: salt も info も空
print "case3-prk ${show(hkdf.extract[sha256.Hasher](Bytes.zeros(0), ikm1))}"
print "case3-okm ${show(hkdf.derive[sha256.Hasher](Bytes.zeros(0), ikm1, Bytes.zeros(0), 42).unwrap())}"

// 255 digest を超える要求は Err
print "toolong ${hkdf.expand[sha256.Hasher](Bytes.fill(0x01, 32), Bytes.zeros(0), 32 * 255 + 1) is Err(_)}"
print "limit ${hkdf.expand[sha256.Hasher](Bytes.fill(0x01, 32), Bytes.zeros(0), 32 * 255).unwrap().len()}"
print "zero ${hkdf.expand[sha256.Hasher](Bytes.fill(0x01, 32), Bytes.zeros(0), 0).unwrap().len()}"

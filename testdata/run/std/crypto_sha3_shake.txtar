-- src --
import hex from std/encoding/hex
import sha3 from std/crypto/sha3

fn show(b: Bytes) -> String {
    hex.encode(b)
}

let empty = Bytes.zeros(0)
let m200 = "a".repeat(200).toBytes()

// FIPS 202 §6.2: SHAKE128 and SHAKE256 at several output lengths. Each
// longer request starts with the shorter one because the output is a stream.
print "shake128-empty-16 ${show(sha3.shake128(empty, 16))}"
print "shake128-empty-32 ${show(sha3.shake128(empty, 32))}"
print "shake128-abc-32 ${show(sha3.shake128(b"abc", 32))}"
print "shake128-abc-64 ${show(sha3.shake128(b"abc", 64))}"
print "shake128-abc-200 ${show(sha3.shake128(b"abc", 200))}"
print "shake128-200a-32 ${show(sha3.shake128(m200, 32))}"
print "shake256-empty-32 ${show(sha3.shake256(empty, 32))}"
print "shake256-abc-32 ${show(sha3.shake256(b"abc", 32))}"
print "shake256-abc-64 ${show(sha3.shake256(b"abc", 64))}"
print "shake256-abc-200 ${show(sha3.shake256(b"abc", 200))}"
print "shake256-200a-64 ${show(sha3.shake256(m200, 64))}"

// update in pieces is the same stream as one call.
let mut s = sha3.Xof128.new()
s.update(b"a")
s.update(b"bc")
print "shake128-split ${show(s.finish(32))}"

// Repeated squeeze continues one stream; seven plus twenty-five bytes are
// the first thirty-two.
let mut x = sha3.Xof128.new()
x.update(b"abc")
let p1 = x.squeeze(7)
let p2 = x.squeeze(25)
print "shake128-squeeze ${show(p1.concat(p2))}"

// Byte-at-a-time squeezing crosses the rate boundary twice.
let mut y = sha3.Xof256.new()
y.update(b"abc")
let mut all = Bytes.zeros(0)
let mut i: usize = 0
for i < 200 {
    all = all.concat(y.squeeze(1))
    i = i + 1
}
print "shake256-bytewise ${show(all)}"

print "shake128-zero ${sha3.shake128(b"abc", 0).len()}"
print "rates ${sha3.rate128} ${sha3.rate256} ${sha3.Xof128.blockSize()} ${sha3.Xof256.blockSize()}"

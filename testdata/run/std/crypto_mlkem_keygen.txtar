-- src --
import mlkem from std/crypto/mlkem
import hex from std/encoding/hex

fn main() -> Void! {
    // NIST ACVP ML-KEM-768 keyGen tcId 26.
    let kp26 = mlkem.keyGen(hex.decode("E582B7D75E6C80B05AE392A1FC9F7153B12390FD99930368CC67A768BAEBC8A0")?, hex.decode("1CDACB8740C0B87C4A379575F187B367CBFA3B300BF591B109F79816E9CBE8F0")?)?
    if hex.encode(kp26.encapsulationKey) != "" {
        print "keygen tc 26 encapsulation key mismatch"
    }
    if hex.encode(kp26.decapsulationKey) != "" {
        print "keygen tc 26 decapsulation key mismatch"
    }
    print "keygen tc 26 ok"
    // NIST ACVP ML-KEM-768 keyGen tcId 27.
    let kp27 = mlkem.keyGen(hex.decode("3E5848DB624613F7AC144457CC1375F006FA8CB953E767DC9E7428D00F5DAD8B")?, hex.decode("012DD6C2F0918B9EB6182474EB86D848F65974759D59CE151A396DEEE4CA10D1")?)?
    if hex.encode(kp27.encapsulationKey) != "" {
        print "keygen tc 27 encapsulation key mismatch"
    }
    if hex.encode(kp27.decapsulationKey) != "" {
        print "keygen tc 27 decapsulation key mismatch"
    }
    print "keygen tc 27 ok"
    // NIST ACVP ML-KEM-768 keyGen tcId 28.
    let kp28 = mlkem.keyGen(hex.decode("882FDEA55C6B497A6F2A1321FC82160C630D9A1F2E35BBE0D3332E3A0CFBC8C9")?, hex.decode("3A21F601923C559179A3AA5839A148487379EAAD934BF27F3071E1B1FDC21D1A")?)?
    if hex.encode(kp28.encapsulationKey) != "" {
        print "keygen tc 28 encapsulation key mismatch"
    }
    if hex.encode(kp28.decapsulationKey) != "" {
        print "keygen tc 28 decapsulation key mismatch"
    }
    print "keygen tc 28 ok"
}
-- stdout --
keygen tc 26 ok
keygen tc 27 ok
keygen tc 28 ok

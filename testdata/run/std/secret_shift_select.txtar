-- src --
import secret from std/secret

fn declassify8(v: secret.SecretU8) -> u8 { unsafe { v.declassify() } }
fn declassify16(v: secret.SecretU16) -> u16 { unsafe { v.declassify() } }
fn declassify32(v: secret.SecretU32) -> u32 { unsafe { v.declassify() } }
fn declassify64(v: secret.SecretU64) -> u64 { unsafe { v.declassify() } }

let one8 = secret.SecretU8.classify(1)
print "u8 ${declassify8(one8.shiftLeft(256))} ${declassify8(one8.shiftLeft(8))} ${declassify8(one8.rotateLeft(256))}"
// A count that does not fit the width still wraps (300 & 7 = 4) instead of shifting by zero.
let high8 = secret.SecretU8.classify(128)
print "u8 wrap ${declassify8(one8.shiftLeft(300))} ${declassify8(high8.shiftRight(300))} ${declassify8(one8.rotateLeft(300))} ${declassify8(one8.rotateRight(300))}"
let one16 = secret.SecretU16.classify(1)
print "u16 ${declassify16(one16.shiftLeft(65536))} ${declassify16(one16.rotateRight(65536))}"
let high16 = secret.SecretU16.classify(32768)
print "u16 wrap ${declassify16(one16.shiftLeft(65540))} ${declassify16(high16.shiftRight(65540))} ${declassify16(one16.rotateLeft(65540))} ${declassify16(one16.rotateRight(65540))}"
let one32 = secret.SecretU32.classify(1)
let one64 = secret.SecretU64.classify(1)
print "u32 ${declassify32(one32.shiftLeft(33))} ${declassify32(one32.rotateRight(33))} u64 ${declassify64(one64.shiftLeft(65))} ${declassify64(one64.rotateRight(65))}"
let eq = secret.SecretU64.classify(7).ctEq(secret.SecretU64.classify(7))
let ne = secret.SecretU64.classify(7).ctEq(secret.SecretU64.classify(8))
let a = secret.SecretU64.classify(10)
let b = secret.SecretU64.classify(20)
print "sel ${declassify64(eq.selectU64(a, b))} ${declassify64(ne.selectU64(a, b))}"
-- stdout --
u8 1 1 1
u8 wrap 16 8 16 16
u16 1 1
u16 wrap 16 2048 16 4096
u32 2 2147483648 u64 2 9223372036854775808
sel 10 20

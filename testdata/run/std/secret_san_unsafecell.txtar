-- src --
import secret from std/secret

fn secretSeven() -> u64 {
    let mut t = FixedArray.filled[u64, 4](0)
    _ = t.set(2, 7)
    secret.ctLookupU64(&t, secret.SecretIndex[4].from(secret.SecretU32.classify(2)))
}

import {AtomicOrder, UnsafeCell} from std/mem

// An UnsafeCell written through a shared receiver keeps the stored value's label.
unsafe {
    let c = UnsafeCell.new[u64](0)
    c.atomicStore(secretSeven(), AtomicOrder.SeqCst)
    if c.atomicLoad(AtomicOrder.SeqCst) == 7 {
        print "cell: 7"
    }
}
-- stdout --
cell: 7
-- secret-san --
panic: SecretSan: secret value reaches a conditional branch in main

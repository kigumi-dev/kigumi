-- src --
import secret from std/secret

fn secretSeven() -> u64 {
    let mut t = FixedArray.filled[u64, 4](0)
    _ = t.set(2, 7)
    secret.ctLookupU64(&t, secret.SecretIndex[4].from(secret.SecretU32.classify(2)))
}

import {AtomicOrder, atomicLoad, atomicStore} from std/mem

static mut g: u64 = 0

// The value an atomic stores into a static keeps its label when it is loaded back.
unsafe {
    atomicStore(&mut g, secretSeven(), AtomicOrder.SeqCst)
    if atomicLoad(&g, AtomicOrder.SeqCst) == 7 {
        print "static: 7"
    }
}
-- stdout --
static: 7
-- secret-san --
panic: SecretSan: secret value reaches a conditional branch in main

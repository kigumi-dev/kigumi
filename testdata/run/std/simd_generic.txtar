-- src --
import simd from std/simd
import math from std/math

// Every std/simd primitive through a generic wrapper: the const N and the lane
// type T are only concrete at the instantiation, so each of these calls must
// specialize the wrapper before llgen lowers a 128-bit vector.
fn splatT[T: Copy, const N: usize](v: T) -> simd.Vec[T, N] {
    simd.Vec.splat[T, N](v)
}

fn addT[T: Copy, const N: usize](a: simd.Vec[T, N], b: simd.Vec[T, N]) -> simd.Vec[T, N] {
    a.add(b)
}

fn subT[T: Copy, const N: usize](a: simd.Vec[T, N], b: simd.Vec[T, N]) -> simd.Vec[T, N] {
    a.sub(b)
}

fn mulT[T: Copy, const N: usize](a: simd.Vec[T, N], b: simd.Vec[T, N]) -> simd.Vec[T, N] {
    a.mul(b)
}

fn loadT[T: Copy, const N: usize](a: FixedArray[T, N]) -> simd.Vec[T, N] {
    simd.Vec.fromArray(a)
}

fn dumpT[T: Copy, const N: usize](v: simd.Vec[T, N]) -> FixedArray[T, N] {
    v.toArray()
}

fn fillT[T: Copy, const N: usize](v: simd.Vec[T, N], x: T) -> simd.Vec[T, N] {
    let mut w = v
    for i in 0..N {
        w.setLane(i, x)
    }
    w
}

fn splatI16[const N: usize](v: i16) -> simd.Vec[i16, N] {
    simd.Vec.splat[i16, N](v)
}

// const-only wrappers over the same primitives: no type parameter, so only N
// names the shape.
fn addI16[const N: usize](a: simd.Vec[i16, N], b: simd.Vec[i16, N]) -> simd.Vec[i16, N] {
    a.add(b)
}

fn makeU8[const N: usize](v: u8) -> simd.Vec[u8, N] {
    simd.Vec.splat[u8, N](v)
}

// u8: 16 lanes
let u8_splat = splatT[u8, 16](255)
for i in 0..16 {
    print "u8 splat ${i} 255 - ${u8_splat.lane(i)}"
}
let u8_add = addT[u8, 16](splatT[u8, 16](255), splatT[u8, 16](2))
let u8_sub = subT[u8, 16](splatT[u8, 16](0), splatT[u8, 16](1))
let u8_mul = mulT[u8, 16](splatT[u8, 16](255), splatT[u8, 16](3))
for i in 0..16 {
    print "u8 add ${i} 255 2 ${u8_add.lane(i)}"
}
for i in 0..16 {
    print "u8 sub ${i} 0 1 ${u8_sub.lane(i)}"
}
for i in 0..16 {
    print "u8 mul ${i} 255 3 ${u8_mul.lane(i)}"
}
let u8_rt = loadT[u8, 16](FixedArray.filled[u8, 16](200))
for i in 0..16 {
    print "u8 roundtrip ${i} 200 ${dumpT[u8, 16](u8_rt)[i]} ${u8_rt.lane(i)}"
}
let u8_set = fillT[u8, 16](u8_rt, 7)
for i in 0..16 {
    print "u8 setlane ${i} 7 ${dumpT[u8, 16](u8_set)[i]} ${u8_set.lane(i)}"
}
print "u8 splat 0 255 - ${makeU8[16](255).lane(0)}"

// i16: 8 lanes
let i16_splat = splatT[i16, 8](-32768)
for i in 0..8 {
    print "i16 splat ${i} -32768 - ${i16_splat.lane(i)}"
}
let i16_add = addI16[8](splatI16[8](-32768), splatI16[8](-1))
let i16_sub = subT[i16, 8](splatT[i16, 8](-32768), splatT[i16, 8](1))
let i16_mul = mulT[i16, 8](splatT[i16, 8](-32768), splatT[i16, 8](-1))
for i in 0..8 {
    print "i16 add ${i} -32768 -1 ${i16_add.lane(i)}"
}
for i in 0..8 {
    print "i16 sub ${i} -32768 1 ${i16_sub.lane(i)}"
}
for i in 0..8 {
    print "i16 mul ${i} -32768 -1 ${i16_mul.lane(i)}"
}
let i16_rt = loadT[i16, 8](FixedArray.filled[i16, 8](-7))
for i in 0..8 {
    print "i16 roundtrip ${i} -7 ${dumpT[i16, 8](i16_rt)[i]} ${i16_rt.lane(i)}"
}
let i16_set = fillT[i16, 8](i16_rt, 123)
for i in 0..8 {
    print "i16 setlane ${i} 123 ${dumpT[i16, 8](i16_set)[i]} ${i16_set.lane(i)}"
}

// i32: 4 lanes
let i32_splat = splatT[i32, 4](-2147483648)
for i in 0..4 {
    print "i32 splat ${i} -2147483648 - ${i32_splat.lane(i)}"
}
let i32_add = addT[i32, 4](splatT[i32, 4](2147483647), splatT[i32, 4](1))
let i32_sub = subT[i32, 4](splatT[i32, 4](-2147483648), splatT[i32, 4](1))
let i32_mul = mulT[i32, 4](splatT[i32, 4](-2147483648), splatT[i32, 4](-1))
for i in 0..4 {
    print "i32 add ${i} 2147483647 1 ${i32_add.lane(i)}"
}
for i in 0..4 {
    print "i32 sub ${i} -2147483648 1 ${i32_sub.lane(i)}"
}
for i in 0..4 {
    print "i32 mul ${i} -2147483648 -1 ${i32_mul.lane(i)}"
}

let i32_rt = loadT[i32, 4](FixedArray.filled[i32, 4](42))
for i in 0..4 {
    print "i32 roundtrip ${i} 42 ${dumpT[i32, 4](i32_rt)[i]} ${i32_rt.lane(i)}"
}
let i32_set = fillT[i32, 4](i32_rt, -9)
for i in 0..4 {
    print "i32 setlane ${i} -9 ${dumpT[i32, 4](i32_set)[i]} ${i32_set.lane(i)}"
}

// u64: 2 lanes
let u64_splat = splatT[u64, 2](18446744073709551615)
for i in 0..2 {
    print "u64 splat ${i} 18446744073709551615 - ${u64_splat.lane(i)}"
}
let u64_add = addT[u64, 2](splatT[u64, 2](18446744073709551615), splatT[u64, 2](1))
let u64_sub = subT[u64, 2](splatT[u64, 2](0), splatT[u64, 2](1))
let u64_mul = mulT[u64, 2](splatT[u64, 2](18446744073709551615), splatT[u64, 2](18446744073709551615))
for i in 0..2 {
    print "u64 add ${i} 18446744073709551615 1 ${u64_add.lane(i)}"
}
for i in 0..2 {
    print "u64 sub ${i} 0 1 ${u64_sub.lane(i)}"
}
for i in 0..2 {
    print "u64 mul ${i} 18446744073709551615 18446744073709551615 ${u64_mul.lane(i)}"
}

let u64_rt = loadT[u64, 2](FixedArray.filled[u64, 2](12345678901234567890))
for i in 0..2 {
    print "u64 roundtrip ${i} 12345678901234567890 ${dumpT[u64, 2](u64_rt)[i]} ${u64_rt.lane(i)}"
}
let u64_set = fillT[u64, 2](u64_rt, 1)
for i in 0..2 {
    print "u64 setlane ${i} 1 ${dumpT[u64, 2](u64_set)[i]} ${u64_set.lane(i)}"
}

// f32: 4 lanes
let f32_splat = splatT[f32, 4](0.1)
for i in 0..4 {
    print "f32 splat ${i} ${math.toBits(0.1.toF32().toF64())} - ${math.toBits(f32_splat.lane(i).toF64())}"
}
let f32_add = addT[f32, 4](splatT[f32, 4](0.1), splatT[f32, 4](0.2))
let f32_sub = subT[f32, 4](splatT[f32, 4](1.5), splatT[f32, 4](2.0))
let f32_mul = mulT[f32, 4](splatT[f32, 4](3.0e38), splatT[f32, 4](3.0e38))
for i in 0..4 {
    print "f32 add ${i} ${math.toBits(0.1.toF32().toF64())} ${math.toBits(0.2.toF32().toF64())} ${math.toBits(f32_add.lane(i).toF64())}"
}
for i in 0..4 {
    print "f32 sub ${i} ${math.toBits(1.5.toF32().toF64())} ${math.toBits(2.0.toF32().toF64())} ${math.toBits(f32_sub.lane(i).toF64())}"
}
for i in 0..4 {
    print "f32 mul ${i} ${math.toBits(3.0e38.toF32().toF64())} ${math.toBits(3.0e38.toF32().toF64())} ${math.toBits(f32_mul.lane(i).toF64())}"
}
let f32_rt = loadT[f32, 4](FixedArray.filled[f32, 4](0.5))
for i in 0..4 {
    print "f32 roundtrip ${i} ${math.toBits(0.5.toF32().toF64())} ${math.toBits(dumpT[f32, 4](f32_rt)[i].toF64())} ${math.toBits(f32_rt.lane(i).toF64())}"
}
let f32_set = fillT[f32, 4](f32_rt, -0.0)
for i in 0..4 {
    print "f32 setlane ${i} ${math.toBits((-0.0).toF32().toF64())} ${math.toBits(dumpT[f32, 4](f32_set)[i].toF64())} ${math.toBits(f32_set.lane(i).toF64())}"
}

// f64: 2 lanes
let f64_splat = splatT[f64, 2](-0.0)
for i in 0..2 {
    print "f64 splat ${i} ${math.toBits(-0.0)} - ${math.toBits(f64_splat.lane(i))}"
}
let f64_add = addT[f64, 2](splatT[f64, 2](1.5), splatT[f64, 2](-2.25))
let f64_mul = mulT[f64, 2](splatT[f64, 2](-1.5), splatT[f64, 2](0.0))
for i in 0..2 {
    print "f64 add ${i} ${math.toBits(1.5)} ${math.toBits(-2.25)} ${math.toBits(f64_add.lane(i))}"
}
for i in 0..2 {
    print "f64 mul ${i} ${math.toBits(-1.5)} ${math.toBits(0.0)} ${math.toBits(f64_mul.lane(i))}"
}
let f64_sub = subT[f64, 2](splatT[f64, 2](1.5), splatT[f64, 2](2.0))
for i in 0..2 {
    print "f64 sub ${i} ${math.toBits(1.5)} ${math.toBits(2.0)} ${math.toBits(f64_sub.lane(i))}"
}
let f64_rt = loadT[f64, 2](FixedArray.filled[f64, 2](0.25))
for i in 0..2 {
    print "f64 roundtrip ${i} ${math.toBits(0.25)} ${math.toBits(dumpT[f64, 2](f64_rt)[i])} ${math.toBits(f64_rt.lane(i))}"
}
let f64_set = fillT[f64, 2](f64_rt, 1.0e308)
for i in 0..2 {
    print "f64 setlane ${i} ${math.toBits(1.0e308)} ${math.toBits(dumpT[f64, 2](f64_set)[i])} ${math.toBits(f64_set.lane(i))}"
}

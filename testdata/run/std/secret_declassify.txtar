-- src --
import secret from std/secret

let buf = secret.SecretBuffer.fromString("hunter2")
let same = buf.ctEq(&secret.SecretBuffer.fromString("hunter2"))
print "ctEq=${(unsafe { same.declassify() })} len=${buf.len()}"
let raw = unsafe { buf.declassify() }
print "after: len=${raw.len()} eq=${raw.equals(&"hunter2".toBytes())}"
-- stdout --
ctEq=true len=7
after: len=7 eq=true

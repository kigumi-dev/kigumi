-- src --
import hex from std/encoding/hex
import sha512 from std/crypto/sha512

fn show(b: Bytes) -> String {
    hex.encode(b)
}

// FIPS 180-4 / NIST CAVP の vector
print "512-empty ${show(sha512.sum(Bytes.zeros(0)))}"
print "512-abc ${show(sha512.sum(b"abc"))}"
print "512-two-block ${show(sha512.sum("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu".toBytes()))}"
print "384-abc ${show(sha512.sum384(b"abc"))}"
print "384-empty ${show(sha512.sum384(Bytes.zeros(0)))}"

// 分割して update しても同じ digest になる
let mut h = sha512.Hasher.new()
h.update(b"abcdefghbcdefghicdefghijdefghijk")
h.update(b"efghijklfghijklmghijklmnhijklmno")
h.update(b"ijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")
print "split ${show(h.finish())}"

let mut h384 = sha512.Hasher384.new()
h384.update(b"abc")
print "split384 ${show(h384.finish())}"

print "sizes ${sha512.size} ${sha512.size384} ${sha512.blockSize} ${sha512.Hasher.size()} ${sha512.Hasher384.size()}"

-- src --
import flate from std/compress/flate
import hex from std/encoding/hex

fn hx(b: Bytes) -> String {
    hex.encode(b)
}

fn head(b: Bytes) -> String {
    let n = b.len()
    if n <= 16 {
        hx(b)
    } else {
        "${hx(b.slice(0, 8) || Bytes.zeros(0))}..${hx(b.slice(n - 8, n) || Bytes.zeros(0))}"
    }
}

fn run(name: String, h: String) {
    let raw = hex.decode(h).unwrap()
    match flate.inflate(raw) {
        Ok(b) -> print "${name} ok len=${b.len()} hex=${head(b)}"
        Err(e) -> print "${name} err ${e.message()}"
    }
}

fn main() {
    run("empty", "0300")
    run("hello-fixed", "cb48cdc9c90700")
    run("hello-stored", "010500faff68656c6c6f")
    run("empty-stored", "010000ffff")
    run("repeat-fixed", "4b4c4a4e1c45a368140d4d0400")
    run("fixed-binary", "")
    run("dynamic", "edc8b10900200c00b0573c4ea143a1e0d2f75df502972c19122bb3465c76ed9ccf78efbdf7de7befbdf7de7bffeb0f")
    run("truncated", "cb48cdc9c9")
    // dyn-*: hand-built dynamic blocks; zlib 1.3.1 reaches the same verdict on each.
    run("dyn-cross-run", "0d83050100000040b6f27f04851b")
    run("dyn-no-distances", "0580010900000040b678c7ff033206")
    run("dyn-distance-without-codes", "0d80010900000040b6f27f04e10000")
    run("dyn-empty-distance-code-at-end", "0de0010400000080200000000000000000000000000800000000000000000000000000000000000000780e")
    run("dyn-unused-distance-code-at-end", "0dc0010100000040a0adfc1f4178")
    run("dyn-incomplete", "05c081000000008020d6fc250e")
    run("dyn-oversubscribed", "05c08100000000009056fe2300")
    run("dyn-no-end-of-block", "05c08100000000009056fe2700")
    run("dyn-hdist-31", "051e0000")
    run("dyn-hlit-287", "f5000000")
    run("dyn-repeat-first", "05000224")
    run("dyn-repeat-overflow", "050080e4ff1f")
    run("dyn-incomplete-code-lengths", "0580010900000080fa03")
    run("dyn-truncated-lengths", "0d83050100000040")
    run("reserved-block", "07")
    run("empty-input", "")
    run("bad-distance", "030200")
    let src = "the quick brown fox jumps over the lazy dog".toBytes()
    let c = flate.deflate(src)
    let c2 = flate.deflate(src)
    print "deflate-deterministic=${c.equals(&c2)} len=${c.len()}"
    match flate.inflate(c) {
        Ok(b) -> print "roundtrip=${b.equals(&src)}"
        Err(e) -> print "roundtrip-err=${e.message()}"
    }
    let mut arr = Array.empty[u8]()
    let mut x: u32 = 2463534242
    let mut i: usize = 0
    for i < 20000 {
        x = x ^ x.wrappingShiftLeft(13)
        x = x ^ x.wrappingShiftRight(17)
        x = x ^ x.wrappingShiftLeft(5)
        arr.push((x >> 24).truncate[u8]())
        i = i + 1
    }
    let noise = Bytes.fromArray(&arr)
    let nc = flate.deflate(noise)
    print "noise=${noise.len()} compressed=${nc.len()} bounded=${nc.len() <= noise.len() + 10}"
    match flate.inflate(nc) {
        Ok(b) -> print "noise-roundtrip=${b.equals(&noise)}"
        Err(e) -> print "noise-err=${e.message()}"
    }
    match flate.inflateLimit(hex.decode("4b4c4a4e1c45a368140d4d0400").unwrap(), 100) {
        Ok(b) -> print "limit-ok=${b.len()}"
        Err(e) -> print "limit-err=${e.message()}"
    }
    let dyn = hex.decode("edc8b10900200c00b0573c4ea143a1e0d2f75df502972c19122bb3465c76ed9ccf78efbdf7de7befbdf7de7bffeb0f").unwrap()
    let mut inf = flate.Inflater.new()
    let mut k: usize = 0
    for k < dyn.len() {
        inf.update(dyn.slice(k, k + 1) || Bytes.zeros(0)).unwrap()
        k = k + 1
    }
    let out = inf.finish().unwrap()
    print "stream len=${out.len()} ${head(out)}"
    let mut inf2 = flate.Inflater.new()
    inf2.update(dyn.concat(hex.decode("cafebabe").unwrap())).unwrap()
    let out2 = inf2.finish().unwrap()
    print "remainder=${hx(inf2.remainder())} len=${out2.len()}"
    let stored = hex.decode("010500faff68656c6c6f").unwrap()
    let mut sinf = flate.Inflater.new()
    let mut q: usize = 0
    for q < stored.len() {
        sinf.update(stored.slice(q, q + 1) || Bytes.zeros(0)).unwrap()
        q = q + 1
    }
    print "stream-stored=${hx(sinf.finish().unwrap())}"
    let padded = dyn.concat(hex.decode("cafebabe").unwrap())
    let mut cinf = flate.Inflater.new()
    let mut z: usize = 0
    for z < padded.len() {
        cinf.update(padded.slice(z, z + 1) || Bytes.zeros(0)).unwrap()
        z = z + 1
    }
    print "chunked-remainder=${hx(cinf.remainder())} len=${cinf.finish().unwrap().len()}"
}
-- stdout --
empty ok len=0 hex=
hello-fixed ok len=5 hex=68656c6c6f
hello-stored ok len=5 hex=68656c6c6f
empty-stored ok len=0 hex=
repeat-fixed ok len=960 hex=6162636162636162..6263616263616263
fixed-binary ok len=2478 hex=0001020304050607..6c617a7920646f67
dynamic ok len=4800 hex=68656c6c6f206865..6f20776f726c6420
truncated err flate: input ends in the middle of the stream
dyn-cross-run ok len=5 hex=6162616261
dyn-no-distances ok len=3 hex=686921
dyn-distance-without-codes err flate: invalid Huffman code
dyn-empty-distance-code-at-end err flate: invalid Huffman code
dyn-unused-distance-code-at-end err flate: invalid Huffman code
dyn-incomplete err flate: Huffman code is incomplete
dyn-oversubscribed err flate: Huffman code is oversubscribed
dyn-no-end-of-block err flate: dynamic block has no end-of-block code
dyn-hdist-31 err flate: 31 distance codes exceeds 30
dyn-hlit-287 err flate: 287 literal/length codes exceeds 286
dyn-repeat-first err flate: code length 16 has no previous length to repeat
dyn-repeat-overflow err flate: code length repeat overflows the table
dyn-incomplete-code-lengths err flate: Huffman code is incomplete
dyn-truncated-lengths err flate: input ends in the middle of the stream
reserved-block err flate: reserved block type 3
empty-input err flate: input ends in the middle of the stream
bad-distance err flate: distance 1 reaches before the start of the output
deflate-deterministic=true len=43
roundtrip=true
noise=20000 compressed=20005 bounded=true
noise-roundtrip=true
limit-err=flate: output exceeds the 100 byte limit
stream len=4800 68656c6c6f206865..6f20776f726c6420
remainder=cafebabe len=4800
stream-stored=68656c6c6f
chunked-remainder=cafebabe len=4800

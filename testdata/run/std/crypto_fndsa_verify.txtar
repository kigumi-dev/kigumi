-- src --
import fndsa from std/crypto/fndsa
import hex from std/encoding/hex

fn main() -> Void! {
    // Falcon-512 Round 3 KAT, count 0, NIST padded-signature layout.
    let pk = hex.decode("")?
    let msg = hex.decode("D81C4D8D734FCBFBEADE3D3F8A039FAA2A2C9957E835AD55B22E75BF57BB556AC8")?
    let sig = hex.decode("")?
    print "valid=${fndsa.verify(pk, msg, sig)?}"

    let tampered = hex.decode("D91C4D8D734FCBFBEADE3D3F8A039FAA2A2C9957E835AD55B22E75BF57BB556AC8")?
    print "tampered=${fndsa.verify(pk, tampered, sig)?}"

    match fndsa.verify(Bytes.zeros(896), msg, sig) {
        Ok(_) -> print "short pk: unexpected"
        Err(e) -> print "short pk: ${e.message()}"
    }
    match fndsa.verify(hex.decode("")?, msg, sig) {
        Ok(_) -> print "bad pk header: unexpected"
        Err(e) -> print "bad pk header: ${e.message()}"
    }
    match fndsa.verify(pk, msg, hex.decode("")?) {
        Ok(_) -> print "short sig: unexpected"
        Err(e) -> print "short sig: ${e.message()}"
    }
    match fndsa.verify(pk, msg, hex.decode("")?) {
        Ok(_) -> print "bad sig header: unexpected"
        Err(e) -> print "bad sig header: ${e.message()}"
    }
    // Flipping the first compressed bit must not verify.
    let mut raw = Array.empty[u8]()
    for b in sig {
        raw.push(b)
    }
    raw[41] = raw[41] | 0x80
    match fndsa.verify(pk, msg, Bytes.fromArray(&raw)) {
        Ok(v) -> print "modified sig: accepted=${v}"
        Err(e) -> print "modified sig: ${e.message()}"
    }
}
-- stdout --
valid=true
tampered=false
short pk: fndsa: public key must be 897 bytes
bad pk header: fndsa: invalid public key header
short sig: fndsa: signature must be 656 bytes
bad sig header: fndsa: invalid signature header
modified sig: accepted=false

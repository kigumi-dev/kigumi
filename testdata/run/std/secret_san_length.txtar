-- src --
import secret from std/secret

fn secretSeven() -> u64 {
    let mut t = FixedArray.filled[u64, 4](0)
    _ = t.set(2, 7)
    secret.ctLookupU64(&t, secret.SecretIndex[4].from(secret.SecretU32.classify(2)))
}

// A length the program grew by public pushes stays public, so the loop is accepted; a secret-sized allocation is not.
let mut limbs = Array.empty[u64]()
limbs.push(1)
limbs.push(secretSeven())
let mut acc: u64 = 0
let mut k: usize = 0
for k < limbs.len() {
    acc = acc ^ limbs[k]
    k = k + 1
}
print "xor ${unsafe { secret.SecretU64.classify(acc).declassify() }}"
let sized = Array.tryWithCapacity[u64](secretSeven().truncate[usize]()) || Array.empty[u64]()
print "capacity ${sized.len()}"
-- stdout --
xor 6
capacity 0
-- secret-san --
panic: SecretSan: secret value reaches an allocation size (array.Array.tryWithCapacity) in main

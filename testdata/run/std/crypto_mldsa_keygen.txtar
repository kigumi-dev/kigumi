-- src --
import mldsa from std/crypto/mldsa
import hex from std/encoding/hex

fn main() -> Void! {
    // NIST ACVP ML-DSA-65 keyGen tcId 26 and 27.
    let kp26 = mldsa.keyGen(hex.decode("A991FD42B071D49C48AE3E75C647459E0DAAD1E1BA356A04801912D3294BCFF8")?)?
    if hex.encode(kp26.publicKey) != "" {
        print "keygen tc 26 public key mismatch"
    }
    if hex.encode(kp26.secretKey) != "" {
        print "keygen tc 26 secret key mismatch"
    }
    print "keygen tc 26 ok"

    let kp27 = mldsa.keyGen(hex.decode("494F29AD1C93ABB2B9545BD14CC575A98ECD3062137B439B49EB1A8CC6652FC6")?)?
    if hex.encode(kp27.publicKey) != "" {
        print "keygen tc 27 public key mismatch"
    }
    if hex.encode(kp27.secretKey) != "" {
        print "keygen tc 27 secret key mismatch"
    }
    print "keygen tc 27 ok"
}
-- stdout --
keygen tc 26 ok
keygen tc 27 ok

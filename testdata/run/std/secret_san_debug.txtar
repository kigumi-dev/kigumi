-- src --
import secret from std/secret

fn secretSeven() -> u64 {
    let mut t = FixedArray.filled[u64, 4](0)
    _ = t.set(2, 7)
    secret.ctLookupU64(&t, secret.SecretIndex[4].from(secret.SecretU32.classify(2)))
}

// debug renders a container through every element it reaches, so a labelled element poisons the text it
// returns even when the element's own type has nothing secret in its rendering.
let xs = Array.of[u64](1, secretSeven())
print "public"
print debug(&xs)
-- stdout --
public
[1, 7]
-- secret-san --
panic: SecretSan: secret value reaches host I/O (print) in main

-- src --
import secret from std/secret

fn secretSeven() -> u64 {
    let mut t = FixedArray.filled[u64, 4](0)
    _ = t.set(2, 7)
    secret.ctLookupU64(&t, secret.SecretIndex[4].from(secret.SecretU32.classify(2)))
}

// Filtering on a secret predicate branches on what the predicate returns.
let x = secretSeven()
let ys = Array.of[u64](1, 7, 3).filter((v: &u64) => v == x)
print "kept ${ys.len()}"
-- stdout --
kept 1
-- secret-san --
panic: SecretSan: secret value reaches a conditional branch in main.closure1$boxed

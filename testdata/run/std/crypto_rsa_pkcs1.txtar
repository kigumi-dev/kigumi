-- src --
// Vectors: Wycheproof rsa_signature_2048_sha256, including both exponent-3 groups.
import hex from std/encoding/hex
import rsa from std/crypto/rsa

fn show(r: Result[Bool, rsa.Error]) -> String {
    match r {
        Ok(v) -> "${v}"
        Err(e) -> e.message()
    }
}

fn main() -> Void! {
    let pk = rsa.parsePkcs1(hex.decode("")?)?
    let test = hex.decode("54657374")?
    let sig = hex.decode("")?
    print "pkcs1 ${show(rsa.verifyPkcs1v15Sha256(pk, test, sig))}"
    print "pkcs1-wrong-message ${show(rsa.verifyPkcs1v15Sha256(pk, b"tesT", sig))}"
    print "pkcs1-pss-signature ${show(rsa.verifyPkcs1v15Sha256(pk, test, hex.decode("")?))}"

    let e3 = rsa.parsePkcs1(hex.decode("")?)?
    print "e3-small ${e3.exponent()} ${show(rsa.verifyPkcs1v15Sha256(e3, hex.decode("33363730")?, hex.decode("")?))}"
    let e3edge = rsa.parsePkcs1(hex.decode("")?)?
    print "e3-edge ${e3edge.exponent()} ${show(rsa.verifyPkcs1v15Sha256(e3edge, hex.decode("32353934")?, hex.decode("")?))}"

    let emptySig = hex.decode("")?
    print "pkcs1-empty ${show(rsa.verifyPkcs1v15Sha256(pk, Bytes.zeros(0), emptySig))}"
    print "pkcs1-short-signature ${show(rsa.verifyPkcs1v15Sha256(pk, test, Bytes.zeros(255)))}"
}
-- stdout --
pkcs1 true
pkcs1-wrong-message false
pkcs1-pss-signature false
e3-small 3 true
e3-edge 3 true
pkcs1-empty true
pkcs1-short-signature rsa: signature length does not match the modulus

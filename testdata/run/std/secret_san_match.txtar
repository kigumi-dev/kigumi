-- src --
import secret from std/secret

fn secretSeven() -> u64 {
    let mut t = FixedArray.filled[u64, 4](0)
    _ = t.set(2, 7)
    secret.ctLookupU64(&t, secret.SecretIndex[4].from(secret.SecretU32.classify(2)))
}

// A match on a variant whose tag a primitive decided from a secret is a secret branch.
let wide = secretSeven().wrappingMul(100)
match wide.toU8() {
    Some(_) -> print "fits in u8"
    None -> print "does not fit"
}
-- stdout --
does not fit
-- secret-san --
panic: SecretSan: secret value reaches a conditional branch in main

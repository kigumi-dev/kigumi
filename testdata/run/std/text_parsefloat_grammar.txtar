-- src --
import text from std/text

fn show(s: String) -> String {
    if text.parseFloat(s) is Some(f) {
        return "[${s}] some ${f}"
    }
    "[${s}] none"
}

print show("1.5")
print show("-2.5e3")
print show("0")
print show("-0")
print show("12345678901234567890")
print show("1e5")
print show("1E+5")
print show("1e-2")
print show("0.000001")
print show("1e-400")
print show("inf")
print show("-inf")
print show("Infinity")
print show("nan")
print show("NaN")
print show("0x1p3")
print show("1_0")
print show(".5")
print show("5.")
print show("+1")
print show(" 1")
print show("1 ")
print show("1e")
print show("1e+")
print show("--1")
print show("1.5.5")
print show("1.5x")
print show("")
print show("-")
print show("1e400")
print show("-1e400")
print "embedded nul: ${text.parseFloat("1\u{0}x") is None}"

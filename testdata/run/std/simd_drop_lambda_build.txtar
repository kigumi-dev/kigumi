-- src --
import simd from std/simd
import task from std/task

// A lambda or async body that only builds a record whose drop lowers a SIMD
// operation on its type's lanes hands the record its instantiation.
type G[T: Copy] = resource { pub v simd.Vec[T, 4], pub k Int }
fn G[T: Copy].drop(move self) {
    _ = self.v.add(self.v)
    print "drop ${self.k}"
}

fn mk[T: Copy](v: simd.Vec[T, 4], k: Int) -> fn() -> G[T] { () => G { v: v, k: k } }
async fn asyncMk[T: Copy](v: simd.Vec[T, 4], k: Int) -> Int {
    let g = G { v: v, k: k }
    g.k
}

let a = mk(simd.Vec.splat[i32, 4](1), 7)
let x = a()
let b = mk(simd.Vec.splat[f32, 4](1.5), 9)
print "b ${b().k}"
print "async ${task.currentThreadExecutor().runToCompletion(asyncMk(simd.Vec.splat[u32, 4](2), 11))}"
print "end ${x.k}"
-- stdout --
b 9
drop 9
drop 11
async 11
end 7
drop 7

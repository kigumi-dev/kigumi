-- src --
import secret from std/secret

fn secretSeven() -> u64 {
    let mut t = FixedArray.filled[u64, 4](0)
    _ = t.set(2, 7)
    secret.ctLookupU64(&t, secret.SecretIndex[4].from(secret.SecretU32.classify(2)))
}

// A shift checks its count's range, so a secret count is a sink.
let one: u64 = 1
print "${unsafe { secret.SecretU64.classify(one << secretSeven().truncate[usize]()).declassify() }}"
-- stdout --
128
-- secret-san --
panic: SecretSan: secret value reaches a shift count in main

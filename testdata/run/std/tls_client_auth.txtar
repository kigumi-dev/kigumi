-- src --
// TLS 1.3 client authentication over loopback sockets: the server requests a
// certificate, the client answers with its P-256 chain and a
// CertificateVerify, and the server validates the chain, the usage and the
// signature. A client without a credential is refused rather than admitted.
import hex from std/encoding/hex
import net from std/net
import task from std/task
import tls from std/net/tls
import x509 from std/crypto/x509

const CA = ""
const SERVER = ""
const SERVER_KEY = "179f6244a3702a818aa6fefe5649fa5d4c7d2871bbe1a7aa982caee2874e30a9"
const CLIENT = ""
const CLIENT_KEY = "9fde2a2944c84d8fb9c6c5994ff89cb49c6b1c45dbcb2592d27f2cc6a7da45fe"

fn dec(text: String) -> Bytes {
    hex.decode(text).expect("hex")
}

fn deterministicRandom(n: usize) -> Bytes! {
    host.entropy().bytes(n)
}

fn serverConfig() -> tls.ServerConfig {
    let mut config = tls.ServerConfig.new(Array.of(dec(SERVER)), tls.ServerKey.EcP256(dec(SERVER_KEY)), (k) => deterministicRandom(k))
    config.alpn = Array.of("http/1.1")
    config.requireClientAuth = true
    config.clientAnchors = Array.of((x509.parse(dec(CA)).expect("CA parses")).clone())
    config
}

type Fail = {
    text String
}

fn Fail.message(self) -> String {
    self.text
}

async fn serve(mut listener: net.Listener) -> String {
    let pool = task.BlockingPool.new(1)
    let pending = match pool.run(() => listener.accept().unwrap()) {
        Ok(value) -> value
        Err(e) -> return "accept: ${e.message()}"
    }
    let conn = await pending
    let mut session = match await tls.Server.handshake(conn, serverConfig()) {
        Ok(value) -> value
        Err(e) -> return "handshake: ${e.message()}"
    }
    let got = match await session.read(64) {
        Ok(value) -> value
        Err(e) -> {
            await session.close()
            return "read: ${e.message()}"
        }
    }
    let text = String.fromBytes(got) || ""
    if text != "mutual" {
        await session.close()
        return "request `${text}`"
    }
    match await session.write("accepted".toBytes()) {
        Ok(_) -> {}
        Err(e) -> {
            await session.close()
            return "write: ${e.message()}"
        }
    }
    await session.close()
    "ok"
}

async fn connect(n: net.Net, port: Int, withCredential: Bool) -> tls.Session! {
    let mut config = tls.Config.new("localhost", Array.of((x509.parse(dec(CA)).expect("CA parses")).clone()), (k) => deterministicRandom(k))
    config.alpn = Array.of("http/1.1")
    if withCredential {
        config.clientCertificates = Array.of(dec(CLIENT))
        config.clientKey = Some(tls.ClientKey.EcP256(dec(CLIENT_KEY)))
    }
    let pool = task.BlockingPool.new(1)
    let conn = await pool.run(() => n.connect("127.0.0.1", port).unwrap()).unwrap()
    let session = (await tls.Client.connect(conn, config))?
    session
}

async fn acceptedCase(n: net.Net) -> String! {
    let pool = task.BlockingPool.new(1)
    let listener = await pool.run(() => n.listen("127.0.0.1", 0).unwrap()).unwrap()
    let port = listener.port()
    let running = task.spawn(serve(listener))
    let mut session = match await connect(n, port, true) {
        Ok(value) -> value
        Err(e) -> {
            let server = await running
            return "connect-error ${e.message()}; server ${server}"
        }
    }
    let wrote = await session.write("mutual".toBytes())
    let outcome = match wrote {
        Ok(_) -> await session.read(64)
        Err(e) -> Err(e)
    }
    let response = match outcome {
        Ok(value) -> String.fromBytes(value) || ""
        Err(e) -> "read ${e.message()}"
    }
    await session.close()
    let server = await running
    "client-auth => ${response} ${server}"
}

async fn rejectedCase(n: net.Net) -> String! {
    let pool = task.BlockingPool.new(1)
    let listener = await pool.run(() => n.listen("127.0.0.1", 0).unwrap()).unwrap()
    let port = listener.port()
    let running = task.spawn(serve(listener))
    let outcome = await connect(n, port, false)
    let rejected = match outcome {
        Err(_) -> true
        Ok(value) -> {
            let mut session = value
            let after = await session.read(64)
            await session.close()
            after is Err(_)
        }
    }
    let server = await running
    "client-auth-missing => client ${rejected}; server ${server.contains("requires a client certificate")}"
}

async fn run() -> Void! {
    let n = host.net()
    let acceptedText = (await acceptedCase(n))?
    print acceptedText
    let rejectedText = (await rejectedCase(n))?
    print rejectedText
}

task.currentThreadExecutor().runToCompletion(run())?
-- stdout --
client-auth => accepted ok
client-auth-missing => client true; server true

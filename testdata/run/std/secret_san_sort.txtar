-- src --
import secret from std/secret

fn secretSeven() -> u64 {
    let mut t = FixedArray.filled[u64, 4](0)
    _ = t.set(2, 7)
    secret.ctLookupU64(&t, secret.SecretIndex[4].from(secret.SecretU32.classify(2)))
}

import sort from std/sort

// Sorting secret keys branches on what the comparator returns.
let ys = sort.stable(&Array.of[u64](9, secretSeven(), 2), (a: &u64, b: &u64) => a.compareTo(b))
print "sorted ${ys.len()}"
-- stdout --
sorted 3
-- secret-san --
panic: SecretSan: secret value reaches a conditional branch in main.closure1

-- src --
// Go 1.26 compress/flate output at every level; `=` joins levels that wrote the same stream.
// Each line pins the length and CRC-32 of the original input.
import flate from std/compress/flate
import gzip from std/compress/gzip
import hex from std/encoding/hex

fn check(name: String, h: String) {
    match flate.inflate(hex.decode(h).unwrap()) {
        Ok(b) -> print "${name} len=${b.len()} crc=${gzip.crc32(b)}"
        Err(e) -> print "${name} err ${e.message()}"
    }
}

fn main() {
    textVectors()
    binaryVectors()
}
-- main/vectors.kg --
fn textVectors() {
    check("text-huffman-only", "")
    check("text-l0", "")
    check("text-l1", "")
    check("text-l2", "")
    check("text-l3", "")
    check("text-l4", "")
    check("text-l5=l6=l7=l8=l9", "")
}

fn binaryVectors() {
    check("binary-huffman-only=l1=l2=l3=l4=l5=l6=l7=l8=l9", "")
    check("binary-l0", "")
}
-- stdout --
text-huffman-only len=3000 crc=3402095043
text-l0 len=3000 crc=3402095043
text-l1 len=3000 crc=3402095043
text-l2 len=3000 crc=3402095043
text-l3 len=3000 crc=3402095043
text-l4 len=3000 crc=3402095043
text-l5=l6=l7=l8=l9 len=3000 crc=3402095043
binary-huffman-only=l1=l2=l3=l4=l5=l6=l7=l8=l9 len=1500 crc=4128460329
binary-l0 len=1500 crc=4128460329

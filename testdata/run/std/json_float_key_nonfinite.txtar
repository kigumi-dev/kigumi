-- src --
import json from std/json
import map from std/map
import math from std/math

let mut keys = map.empty[Float, Int]()
keys.set(math.nan(), 1)
keys.set(math.inf(), 2)
keys.set(0.0 - math.inf(), 3)
keys.set(2.0, 4)
let text = json.encodeRef(&keys)?
print "size=${keys.len()} text=${text}"
let back = json.decode[map.Map[Float, Int]](text)?
print "back=${back.len()} nan=${back.get(&math.nan()) || -1} inf=${back.get(&math.inf()) || -1} ninf=${back.get(&(0.0 - math.inf())) || -1} two=${back.get(&2.0) || -1}"

let mut small = map.empty[f32, Int]()
small.set(math.nan().toF32(), 1)
small.set(math.inf().toF32(), 2)
small.set((0.0 - math.inf()).toF32(), 3)
let smallText = json.encodeRef(&small)?
print "f32-size=${small.len()} text=${smallText}"
let smallBack = json.decode[map.Map[f32, Int]](smallText)?
print "f32-back=${smallBack.len()} nan=${smallBack.get(&math.nan().toF32()) || -1} inf=${smallBack.get(&math.inf().toF32()) || -1} ninf=${smallBack.get(&(0.0 - math.inf()).toF32()) || -1}"

match json.decode[map.Map[Float, Int]]("{\"inf\":1}") {
    Ok(_) -> print "bad spelling accepted"
    Err(e) -> print "bad spelling: ${e.message()}"
}
-- stdout --
size=4 text={"NaN":1,"+Inf":2,"-Inf":3,"2.0":4}
back=4 nan=1 inf=2 ninf=3 two=4
f32-size=3 text={"NaN":1,"+Inf":2,"-Inf":3}
f32-back=3 nan=1 inf=2 ninf=3
bad spelling: expected a number key, found "inf"

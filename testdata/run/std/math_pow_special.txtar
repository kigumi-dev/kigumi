-- src --
import math from std/math

print "pow(0.0, -3.0) = ${math.pow(0.0, -3.0)}"
print "pow(-0.0, -3.0) = ${math.pow(-0.0, -3.0)}"
print "pow(0.0, -2.0) = ${math.pow(0.0, -2.0)}"
print "pow(-0.0, -2.0) = ${math.pow(-0.0, -2.0)}"
print "pow(-0.0, -0.5) = ${math.pow(-0.0, -0.5)}"
print "pow(0.0, -inf()) = ${math.pow(0.0, -math.inf())}"
print "pow(-0.0, -inf()) = ${math.pow(-0.0, -math.inf())}"
print "pow(0.0, 3.0) = ${math.pow(0.0, 3.0)}"
print "pow(-0.0, 3.0) = ${math.pow(-0.0, 3.0)}"
print "pow(0.0, 2.0) = ${math.pow(0.0, 2.0)}"
print "pow(-0.0, 2.0) = ${math.pow(-0.0, 2.0)}"
print "pow(-0.0, 0.5) = ${math.pow(-0.0, 0.5)}"
print "pow(-0.0, inf()) = ${math.pow(-0.0, math.inf())}"
print "pow(-1.0, inf()) = ${math.pow(-1.0, math.inf())}"
print "pow(-1.0, -inf()) = ${math.pow(-1.0, -math.inf())}"
print "pow(1.0, nan()) = ${math.pow(1.0, math.nan())}"
print "pow(1.0, inf()) = ${math.pow(1.0, math.inf())}"
print "pow(1.0, -inf()) = ${math.pow(1.0, -math.inf())}"
print "pow(1.0, 2.5) = ${math.pow(1.0, 2.5)}"
print "pow(nan(), 0.0) = ${math.pow(math.nan(), 0.0)}"
print "pow(nan(), -0.0) = ${math.pow(math.nan(), -0.0)}"
print "pow(inf(), 0.0) = ${math.pow(math.inf(), 0.0)}"
print "pow(-inf(), -0.0) = ${math.pow(-math.inf(), -0.0)}"
print "pow(-2.5, 0.0) = ${math.pow(-2.5, 0.0)}"
print "pow(-2.5, 0.5) = ${math.pow(-2.5, 0.5)}"
print "pow(-2.5, -1.5) = ${math.pow(-2.5, -1.5)}"
print "pow(0.5, -inf()) = ${math.pow(0.5, -math.inf())}"
print "pow(-0.5, -inf()) = ${math.pow(-0.5, -math.inf())}"
print "pow(2.0, -inf()) = ${math.pow(2.0, -math.inf())}"
print "pow(-2.0, -inf()) = ${math.pow(-2.0, -math.inf())}"
print "pow(0.5, inf()) = ${math.pow(0.5, math.inf())}"
print "pow(-0.5, inf()) = ${math.pow(-0.5, math.inf())}"
print "pow(2.0, inf()) = ${math.pow(2.0, math.inf())}"
print "pow(-2.0, inf()) = ${math.pow(-2.0, math.inf())}"
print "pow(-inf(), -3.0) = ${math.pow(-math.inf(), -3.0)}"
print "pow(-inf(), -2.0) = ${math.pow(-math.inf(), -2.0)}"
print "pow(-inf(), -0.5) = ${math.pow(-math.inf(), -0.5)}"
print "pow(-inf(), 3.0) = ${math.pow(-math.inf(), 3.0)}"
print "pow(-inf(), 2.0) = ${math.pow(-math.inf(), 2.0)}"
print "pow(-inf(), 0.5) = ${math.pow(-math.inf(), 0.5)}"
print "pow(inf(), -0.5) = ${math.pow(math.inf(), -0.5)}"
print "pow(inf(), 0.5) = ${math.pow(math.inf(), 0.5)}"
print "pow(inf(), -inf()) = ${math.pow(math.inf(), -math.inf())}"
print "pow(inf(), inf()) = ${math.pow(math.inf(), math.inf())}"
print "pow(nan(), 1.0) = ${math.pow(math.nan(), 1.0)}"
print "pow(2.0, nan()) = ${math.pow(2.0, math.nan())}"
print "pow(-1.0, nan()) = ${math.pow(-1.0, math.nan())}"
print "pow(nan(), nan()) = ${math.pow(math.nan(), math.nan())}"
print "pow(-10.0, 309.0) = ${math.pow(-10.0, 309.0)}"
print "pow(-10.0, 310.0) = ${math.pow(-10.0, 310.0)}"
print "pow(-10.0, -325.0) = ${math.pow(-10.0, -325.0)}"
print "pow(-10.0, -326.0) = ${math.pow(-10.0, -326.0)}"
-- stdout --
pow(0.0, -3.0) = +Inf

-- src --
// A scripted TLS 1.3 server over a loopback socket, built independently from
// the client's session code, drives the full handshake and failure paths.
import binary from std/encoding/binary
import hex from std/encoding/hex
import net from std/net
import p256 from std/crypto/p256
import sha256 from std/crypto/sha256
import task from std/task
import tls from std/net/tls
import sec from std/secret
import x509 from std/crypto/x509

const ROOT = ""
const LEAF = ""
const EXPIRED = ""
const LEAF_KEY = "d88a88882b51bedeca8e098d7322bcaa262676a902ba292bc4c69633508084b9"
const EXPIRED_KEY = "0dfc8bc9c20a20872fc3372114a311c107302e70752bd550a2cb33a3660a8763"

type Fail = {
    text String
}

fn Fail.message(self) -> String {
    self.text
}

fn dec(s: String) -> Bytes {
    hex.decode(s).expect("hex")
}

fn u16At(b: Bytes, at: usize) -> usize {
    (binary.u16Be(b, at).expect("u16")).toUsize()
}

fn u24At(b: Bytes, at: usize) -> usize {
    (binary.uintBe(b, at, 3).expect("u24")).toUsize()
}

fn eqBytes(a: Bytes, b: Bytes) -> Bool {
    a.equals(&b)
}

// ---- a minimal independent wire cursor ---------------------------------

type Cursor = {
    data Bytes
    mut at usize
}

fn Cursor.new(data: Bytes) -> Cursor {
    Cursor {
        data: data
        at: 0
    }
}

fn Cursor.left(self) -> usize {
    self.data.len() - self.at
}

fn Cursor.u8(mut self) -> usize! {
    if self.left() < 1 {
        fail Fail { text: "cursor: byte" }
    }
    let v = (self.data[self.at]).toUsize()
    self.at = self.at + 1
    v
}

fn Cursor.u16(mut self) -> usize! {
    if self.left() < 2 {
        fail Fail { text: "cursor: u16" }
    }
    let v = u16At(self.data, self.at)
    self.at = self.at + 2
    v
}

fn Cursor.u24(mut self) -> usize! {
    if self.left() < 3 {
        fail Fail { text: "cursor: u24" }
    }
    let v = u24At(self.data, self.at)
    self.at = self.at + 3
    v
}

fn Cursor.take(mut self, n: usize) -> Bytes! {
    if self.left() < n {
        fail Fail { text: "cursor: take ${n}" }
    }
    let v = self.data.slice(self.at, self.at + n).expect("slice")
    self.at = self.at + n
    v
}

fn Cursor.vec8(mut self) -> Bytes! {
    let n = self.u8()?
    self.take(n)
}

fn Cursor.vec16(mut self) -> Bytes! {
    let n = self.u16()?
    self.take(n)
}

// ---- byte builders -----------------------------------------------------

fn put16(out: &mut Array[u8], v: usize) {
    binary.putU16Be(out, (v.toU16() || 0))
}

fn put24(out: &mut Array[u8], v: usize) {
    binary.putUintBe(out, v.toU64(), 3)
}

fn putBytes(out: &mut Array[u8], b: Bytes) {
    let mut i: usize = 0
    for i < b.len() {
        out.push(b[i])
        i = i + 1
    }
}

fn secretOf(b: Bytes) -> sec.SecretBuffer {
    sec.SecretBuffer.fromBytes(b)
}

fn reveal(b: &sec.SecretBuffer) -> Bytes {
    unsafe { b.copy().declassify() }
}

fn truth(c: sec.Choice) -> Bool {
    unsafe { c.declassify() }
}

fn hs(typ: u8, body: Bytes) -> Bytes {
    let mut out = Array.empty[u8]()
    out.push(typ)
    put24(&mut out, body.len())
    putBytes(&mut out, body)
    Bytes.fromArray(&out)
}

fn ext(typ: u16, body: Array[u8]) -> Array[u8] {
    let mut out = Array.empty[u8]()
    put16(&mut out, typ.toUsize())
    put16(&mut out, body.len())
    out.appendAll(body)
    out
}

fn block(exts: Array[u8]) -> Bytes {
    let mut out = Array.empty[u8]()
    put16(&mut out, exts.len())
    out.appendAll(exts)
    Bytes.fromArray(&out)
}

fn derInt(raw: Bytes) -> Array[u8] {
    let mut start: usize = 0
    for start + 1 < raw.len() && raw[start] == 0 {
        start = start + 1
    }
    let mut out = Array.empty[u8]()
    out.push(2)
    let needsZero = (raw[start] & 0x80) != 0
    out.push((raw.len() - start + (if needsZero { 1 } else { 0 })).toU8() || 0)
    if needsZero {
        out.push(0)
    }
    let mut i = start
    for i < raw.len() {
        out.push(raw[i])
        i = i + 1
    }
    out
}

fn derSignature(rs: Bytes) -> Bytes {
    let r = derInt(rs.slice(0, 32).expect("r"))
    let s = derInt(rs.slice(32, 64).expect("s"))
    let mut seq = Array.empty[u8]()
    seq.appendAll(r)
    seq.appendAll(s)
    let mut out = Array.empty[u8]()
    out.push(0x30)
    out.push(seq.len().toU8() || 0)
    out.appendAll(seq)
    Bytes.fromArray(&out)
}

// ---- a buffered async connection for the server -----------------------

type Wire = resource {
    mut conn net.Conn
    mut pending Bytes
}

type RawRecord = {
    typ u8
    header Bytes
    payload Bytes
}

async fn Wire.fill(mut self) -> Bool! {
    let mut chunk = Array.empty[u8]()
    for true {
        match self.conn.pollRead(&mut chunk, 16384) {
            Ok(Some(0)) -> return false
            Ok(Some(_)) -> {
                self.pending = self.pending.concat(Bytes.fromArray(&chunk))
                return true
            }
            Ok(None) -> await task.yieldNow()
            Err(e) -> fail Fail { text: e.message() }
        }
    }
    false
}

async fn Wire.need(mut self, n: usize) -> Void! {
    for self.pending.len() < n {
        if !(await self.fill())? {
            fail Fail { text: "server: connection closed" }
        }
    }
}

async fn Wire.readRecord(mut self) -> RawRecord! {
    (await self.need(5))?
    let header = self.pending.slice(0, 5).expect("header")
    let typ = header[0]
    let length = u16At(header, 3)
    (await self.need(5 + length))?
    let payload = self.pending.slice(5, 5 + length).expect("payload")
    self.pending = self.pending.slice(5 + length, self.pending.len()).expect("rest")
    RawRecord {
        typ: typ
        header: header
        payload: payload
    }
}

async fn Wire.writeAll(mut self, data: Bytes) -> Void! {
    let mut off: usize = 0
    for off < data.len() {
        let rest = data.slice(off, data.len()).expect("write slice")
        match self.conn.pollWrite(rest) {
            Ok(Some(n)) -> { off = off + n }
            Ok(None) -> await task.yieldNow()
            Err(e) -> fail Fail { text: e.message() }
        }
    }
}

// ---- parsed ClientHello -------------------------------------------------

type ClientHello = {
    sessionId Bytes
    group usize
    keyShare Bytes
    cookie Bytes?
    serverName String
    alpn String
}

fn parseClientHello(message: Bytes) -> ClientHello! {
    if message.len() < 4 || message[0] != 1 {
        fail Fail { text: "server: first message is not a ClientHello" }
    }
    let length = u24At(message, 1)
    if message.len() != 4 + length {
        fail Fail { text: "server: ClientHello length mismatch" }
    }
    let body = message.slice(4, 4 + length).expect("body")
    let mut r = Cursor.new(body)
    let version = r.u16()?
    if version != 0x0303 {
        fail Fail { text: "server: ClientHello legacy_version" }
    }
    _ = r.take(32)?
    let sessionId = r.vec8()?
    let suites = r.vec16()?
    if suites.len() != 2 || u16At(suites, 0) != 0x1303 {
        fail Fail { text: "server: client offered suites ${hex.encode(suites)}" }
    }
    let compression = r.vec8()?
    if compression.len() != 1 || compression[0] != 0 {
        fail Fail { text: "server: client compression" }
    }
    let exts = r.vec16()?
    let mut er = Cursor.new(exts)
    let mut shareFound = false
    let mut group: usize = 0
    let mut keyShare = Bytes.zeros(0)
    let mut cookie: Bytes? = None
    let mut sni = ""
    let mut alpn = ""
    let mut versionsFound = false
    let mut sigsFound = false
    let mut groupsFound = false
    for er.left() > 0 {
        let typ = er.u16()?
        let data = er.vec16()?
        if typ == 51 {
            let mut kr = Cursor.new(data)
            let list = kr.vec16()?
            if kr.left() != 0 {
                fail Fail { text: "server: key_share trailing bytes" }
            }
            let mut lr = Cursor.new(list)
            let g = lr.u16()?
            let share = lr.vec16()?
            if lr.left() != 0 {
                fail Fail { text: "server: more than one key share entry" }
            }
            if g == 0x001D {
                if share.len() != 32 {
                    fail Fail { text: "server: x25519 share length" }
                }
            } else if g == 0x0017 {
                if share.len() != 65 {
                    fail Fail { text: "server: secp256r1 share length" }
                }
            } else {
                fail Fail { text: "server: key share group ${g}" }
            }
            group = g
            keyShare = share
            shareFound = true
        } else if typ == 44 {
            let mut cr = Cursor.new(data)
            let value = cr.vec16()?
            if cr.left() != 0 {
                fail Fail { text: "server: cookie trailing bytes" }
            }
            if value.len() == 0 {
                fail Fail { text: "server: empty cookie" }
            }
            cookie = Some(value)
        } else if typ == 0 {
            let mut sr = Cursor.new(data)
            let list = sr.vec16()?
            let mut lr = Cursor.new(list)
            let nameType = lr.u8()?
            let name = lr.vec16()?
            if nameType != 0 {
                fail Fail { text: "server: SNI type" }
            }
            sni = String.fromBytes(name)?
        } else if typ == 16 {
            let mut ar = Cursor.new(data)
            let list = ar.vec16()?
            let mut lr = Cursor.new(list)
            alpn = String.fromBytes(lr.vec8()?)?
        } else if typ == 43 {
            let mut vr = Cursor.new(data)
            let list = vr.vec8()?
            if list.len() != 2 || u16At(list, 0) != 0x0304 {
                fail Fail { text: "server: supported_versions" }
            }
            versionsFound = true
        } else if typ == 13 {
            let mut sr = Cursor.new(data)
            let list = sr.vec16()?
            if list.len() != 4 || u16At(list, 0) != 0x0804 || u16At(list, 2) != 0x0403 {
                fail Fail { text: "server: signature_algorithms" }
            }
            sigsFound = true
        } else if typ == 10 {
            let mut gr = Cursor.new(data)
            let list = gr.vec16()?
            if list.len() != 4 || u16At(list, 0) != 0x001D || u16At(list, 2) != 0x0017 {
                fail Fail { text: "server: supported_groups" }
            }
            groupsFound = true
        }
    }
    if !shareFound || !versionsFound || !sigsFound || !groupsFound {
        fail Fail { text: "server: a required ClientHello extension is missing" }
    }
    if sni == "" {
        fail Fail { text: "server: SNI is empty" }
    }
    if alpn != "http/1.1" {
        fail Fail { text: "server: ALPN `${alpn}`" }
    }
    ClientHello {
        sessionId: sessionId
        group: group
        keyShare: keyShare
        cookie: cookie
        serverName: sni
        alpn: alpn
    }
}

// ---- server -------------------------------------------------------------

type Mode = | Happy | WrongFinished | BadSuite | WrongOrder | EarlyData | PlainAlert | Oversized | RetryP256 | RetryCookieOnly | RetryBadGroup | RetryReuseX25519 | RetryNoChange | RetryBadCookie | RetryServerGroupMismatch | SecondRetry

type ServerSecrets = {
    handshake tls.HandshakeSecrets
    application tls.ApplicationSecrets
}

fn isRetryMode(mode: Mode) -> Bool {
    match mode {
        RetryP256 -> true
        RetryCookieOnly -> true
        RetryBadGroup -> true
        RetryReuseX25519 -> true
        RetryNoChange -> true
        RetryBadCookie -> true
        RetryServerGroupMismatch -> true
        SecondRetry -> true
        _ -> false
    }
}

// The fixed ServerHello.random that marks a HelloRetryRequest.
fn retryRandom() -> Bytes {
    Bytes.fromArray(&Array.of[u8](0xcf, 0x21, 0xad, 0x74, 0xe5, 0x9a, 0x61, 0x11, 0xbe, 0x1d, 0x8c, 0x02, 0x1e, 0x65, 0xb8, 0x91, 0xc2, 0xa2, 0x11, 0x16, 0x7a, 0xbb, 0x8c, 0x5e, 0x07, 0x9e, 0x09, 0xe2, 0xc8, 0xa8, 0x33, 0x9c))
}

// A HelloRetryRequest with supported_versions, optionally a selected group
// and a cookie. `trailing` appends a byte after the cookie vector, which the
// client must refuse.
fn hrrMessage(sessionId: Bytes, group: usize?, cookie: Bytes?, trailing: Bool) -> Bytes {
    let mut body = Array.empty[u8]()
    put16(&mut body, 0x0303)
    putBytes(&mut body, retryRandom())
    body.push(sessionId.len().toU8() || 0)
    putBytes(&mut body, sessionId)
    put16(&mut body, 0x1303)
    body.push(0)
    let mut exts = Array.empty[u8]()
    exts.appendAll(ext(43, byteArray(Bytes.fromArray(&Array.of[u8](0x03, 0x04)))))
    if let Some(g) = group {
        let mut share = Array.empty[u8]()
        put16(&mut share, g)
        exts.appendAll(ext(51, share))
    }
    if let Some(c) = cookie {
        let mut value = Array.empty[u8]()
        put16(&mut value, c.len())
        putBytes(&mut value, c)
        if trailing {
            value.push(0xee)
        }
        exts.appendAll(ext(44, value))
    }
    let mut blk = Array.empty[u8]()
    put16(&mut blk, exts.len())
    blk.appendAll(exts)
    putBytes(&mut body, Bytes.fromArray(&blk))
    hs(2, Bytes.fromArray(&body))
}

async fn serverAccept(mut listener: net.Listener, mode: Mode, cert: Bytes, key: Bytes) -> Void! {
    let pool = task.BlockingPool.new(1)
    let pending = pool.run(() => listener.accept().unwrap())?
    let conn = await pending
    await serverRun(conn, mode, cert, key)
}

async fn serverRun(conn: net.Conn, mode: Mode, cert: Bytes, key: Bytes) -> Void! {
    let mut wire = Wire { conn: conn, pending: Bytes.zeros(0) }
    let first = (await wire.readRecord())?
    if first.typ != 22 {
        fail Fail { text: "server: ClientHello record type" }
    }
    let helloMsg = first.payload
    let ch1 = parseClientHello(helloMsg)?
    if let Some(_) = ch1.cookie {
        fail Fail { text: "server: first ClientHello carries a cookie" }
    }

    if mode is Mode.Oversized {
        // A five-byte header claiming a 65535-byte record exceeds every cap.
        (await wire.writeAll(Bytes.fromArray(&Array.of[u8](22, 0x03, 0x03, 0xff, 0xff))))?
        return Ok(())
    }

    let mut prefix = helloMsg
    let mut clientGroup = ch1.group
    let mut clientShare = ch1.keyShare

    if isRetryMode(mode) {
        // The server's first flight is a HelloRetryRequest, preceded by the
        // same middlebox-compatibility change_cipher_spec.
        let mut ccs = Array.empty[u8]()
        ccs.push(1)
        (await wire.writeAll(plainRecord(20, Bytes.fromArray(&ccs))))?

        let mut requestedGroup: usize? = None
        let mut cookie: Bytes? = None
        let mut trailing = false
        let mut reject = false
        if mode is Mode.RetryP256 {
            requestedGroup = Some(0x0017)
            cookie = Some(dec("c0ffee01"))
        } else if mode is Mode.RetryServerGroupMismatch {
            requestedGroup = Some(0x0017)
            cookie = Some(dec("c0ffee01"))
        } else if mode is Mode.RetryCookieOnly {
            cookie = Some(dec("c0ffee01"))
        } else if mode is Mode.RetryBadGroup {
            requestedGroup = Some(0x0018)
            reject = true
        } else if mode is Mode.RetryReuseX25519 {
            requestedGroup = Some(0x001D)
            reject = true
        } else if mode is Mode.RetryNoChange {
            reject = true
        } else if mode is Mode.RetryBadCookie {
            cookie = Some(dec("c0ffee01"))
            trailing = true
            reject = true
        } else {
            // SecondRetry: a cookie-only request, then a second one.
            cookie = Some(dec("c0ffee01"))
        }
        let hrr = hrrMessage(ch1.sessionId, requestedGroup, cookie, trailing)
        (await wire.writeAll(plainRecord(22, hrr)))?
        if reject {
            return Ok(())
        }
        let expectedGroup = match requestedGroup {
            Some(g) -> g
            None -> 0x001D
        }
        let second = (await wire.readRecord())?
        if second.typ != 22 {
            fail Fail { text: "server: retried ClientHello record type" }
        }
        let ch2Msg = second.payload
        let ch2 = parseClientHello(ch2Msg)?
        if !ch2.sessionId.equals(&ch1.sessionId) {
            fail Fail { text: "server: retried ClientHello session id" }
        }
        if ch2.serverName != ch1.serverName || ch2.alpn != ch1.alpn {
            fail Fail { text: "server: retried ClientHello changed SNI or ALPN" }
        }
        if ch2.group != expectedGroup {
            fail Fail { text: "server: retried ClientHello key share group ${ch2.group}" }
        }
        let expectedCookie = match cookie {
            Some(value) -> value
            None -> fail Fail { text: "server: retry without a cookie" }
        }
        let echoed = match ch2.cookie {
            Some(value) -> value
            None -> fail Fail { text: "server: retried ClientHello did not echo the cookie" }
        }
        if !echoed.equals(&expectedCookie) {
            fail Fail { text: "server: retried ClientHello cookie mismatch" }
        }
        // RFC 8446 §4.4.1: the transcript replaces ClientHello1 with a
        // message_hash, then carries the HelloRetryRequest and ClientHello2.
        prefix = hs(254, sha256.sum(helloMsg)).concat(hrr).concat(ch2Msg)
        clientGroup = ch2.group
        clientShare = ch2.keyShare
        if mode is Mode.SecondRetry {
            let secondRetry = hrrMessage(ch1.sessionId, Some(0x0017), Some(expectedCookie), false)
            (await wire.writeAll(plainRecord(22, secondRetry)))?
            return Ok(())
        }
    }

    let serverSecret = dec("aabbccddeeff00112233445566778899aabbccddeeff00112233445566778899")
    let mut shareGroup = clientGroup
    let mut serverPublic = if clientGroup == 0x0017 {
        (p256Public(serverSecret))?
    } else {
        (x25519Public(serverSecret))?
    }
    if mode is Mode.RetryServerGroupMismatch {
        // A ServerHello must keep the group the HelloRetryRequest selected.
        shareGroup = 0x001D
        serverPublic = (x25519Public(serverSecret))?
    }
    let shared = if clientGroup == 0x0017 {
        (p256Shared(serverSecret, clientShare))?
    } else {
        (x25519Shared(serverSecret, clientShare))?
    }

    // A middlebox-compatibility dummy change_cipher_spec before ServerHello.
    if !isRetryMode(mode) {
        let mut ccs = Array.empty[u8]()
        ccs.push(1)
        (await wire.writeAll(plainRecord(20, Bytes.fromArray(&ccs))))?
    }

    let mut shBody = Array.empty[u8]()
    put16(&mut shBody, 0x0303)
    // A fixed server random.
    let mut i: usize = 0
    for i < 32 {
        shBody.push((0xA0 + i).toU8() || 0)
        i = i + 1
    }
    shBody.push(ch1.sessionId.len().toU8() || 0)
    putBytes(&mut shBody, ch1.sessionId)
    if mode is Mode.BadSuite {
        put16(&mut shBody, 0x1301)
    } else {
        put16(&mut shBody, 0x1303)
    }
    shBody.push(0)
    let mut shExts = Array.empty[u8]()
    shExts.appendAll(ext(43, byteArray(Bytes.fromArray(&Array.of[u8](0x03, 0x04)))))
    let mut share = Array.empty[u8]()
    put16(&mut share, shareGroup)
    put16(&mut share, serverPublic.len())
    putBytes(&mut share, serverPublic)
    shExts.appendAll(ext(51, share))
    let mut shBlock = Array.empty[u8]()
    put16(&mut shBlock, shExts.len())
    shBlock.appendAll(shExts)
    putBytes(&mut shBody, Bytes.fromArray(&shBlock))
    let shMsg = hs(2, Bytes.fromArray(&shBody))

    if mode is Mode.WrongOrder {
        let certBody = certificateBody(cert)
        (await wire.writeAll(plainRecord(22, hs(11, certBody))))?
        return Ok(())
    }
    if mode is Mode.PlainAlert {
        (await wire.writeAll(plainRecord(21, Bytes.fromArray(&Array.of[u8](2, 70)))))?
        return Ok(())
    }

    let shRecord = plainRecord(22, shMsg)
    (await wire.writeAll(shRecord))?
    if mode is Mode.RetryServerGroupMismatch {
        return Ok(())
    }

    let transcriptBase = prefix.concat(shMsg)
    let transcript1 = sha256.sum(transcriptBase)
    let sharedSecret = secretOf(shared)
    let handshake = (tls.deriveHandshake(&sharedSecret, transcript1))?

    // EncryptedExtensions.
    let mut eeExts = Array.empty[u8]()
    let alpnBytes = "http/1.1".toBytes()
    let mut alpnList = Array.empty[u8]()
    alpnList.push(alpnBytes.len().toU8() || 0)
    putBytes(&mut alpnList, alpnBytes)
    let mut alpnBody = Array.empty[u8]()
    put16(&mut alpnBody, alpnList.len())
    alpnBody.appendAll(alpnList)
    eeExts.appendAll(ext(16, alpnBody))
    if mode is Mode.EarlyData {
        eeExts.appendAll(ext(42, Array.empty[u8]()))
    }
    let eeMsg = hs(8, block(eeExts))
    let certMsg = hs(11, certificateBody(cert))

    let transcriptCv = sha256.sum(transcriptBase.concat(eeMsg).concat(certMsg))
    let signature = (p256.signMessage(&secretOf(key), tls.certificateVerifyMessage(transcriptCv)))?
    let der = derSignature(signature)
    let mut cvBody = Array.empty[u8]()
    put16(&mut cvBody, 0x0403)
    put16(&mut cvBody, der.len())
    putBytes(&mut cvBody, der)
    let cvMsg = hs(15, Bytes.fromArray(&cvBody))

    let transcriptCv = sha256.sum(transcriptBase.concat(eeMsg).concat(certMsg).concat(cvMsg))
    let verifySecret = (tls.finishedVerifyData(&handshake.server.secret, transcriptCv))?
    let mut verify = reveal(&verifySecret)
    if mode is Mode.WrongFinished {
        let mut flipped = Array.empty[u8]()
        let mut k: usize = 0
        for k < verify.len() {
            flipped.push(if k == 0 { verify[k] ^ 1 } else { verify[k] })
            k = k + 1
        }
        verify = Bytes.fromArray(&flipped)
    }
    let finMsg = hs(20, verify)

    let flight = eeMsg.concat(certMsg).concat(cvMsg).concat(finMsg)
    (await wire.writeAll((tls.sealRecord(&handshake.server, 0, 22, &secretOf(flight)))?))?
    if mode is Mode.WrongFinished || mode is Mode.EarlyData {
        return Ok(())
    }

    // Client Finished, sealed under the client handshake keys.
    let finishedRecord = (await wire.readRecord())?
    if finishedRecord.typ != 23 {
        fail Fail { text: "server: client Finished record type ${finishedRecord.typ}" }
    }
    let opened = (tls.openRecord(&handshake.client, 0, finishedRecord.header, finishedRecord.payload))?
    let openedBytes = reveal(&opened.payload)
    if opened.typ != 22 || openedBytes.len() != 36 || openedBytes[0] != 20 {
        fail Fail { text: "server: client Finished framing" }
    }
    let claimed = openedBytes.slice(4, 36).expect("verify")
    let transcriptApp = sha256.sum(transcriptBase.concat(eeMsg).concat(certMsg).concat(cvMsg).concat(finMsg))
    let expected = (tls.finishedVerifyData(&handshake.client.secret, transcriptApp))?
    if !truth(expected.ctEqPublic(&claimed)) {
        fail Fail { text: "server: client Finished verify_data" }
    }

    let application = (tls.deriveApplication(&handshake.master, transcriptApp))?
    let request = (await wire.readRecord())?
    if request.typ != 23 {
        fail Fail { text: "server: application record type" }
    }
    let plain = (tls.openRecord(&application.client, 0, request.header, request.payload))?
    if plain.typ != 23 {
        fail Fail { text: "server: inner application type" }
    }
    let text = String.fromBytes(reveal(&plain.payload))?
    if text != "hello tls" {
        fail Fail { text: "server: request `${text}`" }
    }
    (await wire.writeAll((tls.sealRecord(&application.server, 0, 23, &secretOf("welcome".toBytes())))?))?
    let mut close = Array.empty[u8]()
    close.push(1)
    close.push(0)
    (await wire.writeAll((tls.sealRecord(&application.server, 1, 21, &secretOf(Bytes.fromArray(&close))))?))?
    Ok(())
}

fn plainRecord(typ: u8, payload: Bytes) -> Bytes {
    let mut header = Array.empty[u8]()
    header.push(typ)
    put16(&mut header, 0x0303)
    put16(&mut header, payload.len())
    Bytes.fromArray(&header).concat(payload)
}

fn byteArray(b: Bytes) -> Array[u8] {
    let mut out = Array.empty[u8]()
    putBytes(&mut out, b)
    out
}

fn certificateBody(cert: Bytes) -> Bytes {
    let mut out = Array.empty[u8]()
    out.push(0)
    let mut list = Array.empty[u8]()
    put24(&mut list, cert.len())
    putBytes(&mut list, cert)
    put16(&mut list, 0)
    put24(&mut out, list.len())
    out.appendAll(list)
    Bytes.fromArray(&out)
}

import x25519 from std/crypto/x25519

fn x25519Public(secret: Bytes) -> Bytes! {
    match x25519.publicKey(&secretOf(secret)) {
        Ok(v) -> v
        Err(e) -> fail Fail { text: e.message() }
    }
}

fn x25519Shared(secret: Bytes, peer: Bytes) -> Bytes! {
    match x25519.sharedSecret(&secretOf(secret), peer) {
        Ok(v) -> unsafe { v.declassify() }
        Err(e) -> fail Fail { text: e.message() }
    }
}

fn p256Public(secret: Bytes) -> Bytes! {
    match p256.publicKey(secret) {
        Ok(v) -> v
        Err(e) -> fail Fail { text: e.message() }
    }
}

fn p256Shared(secret: Bytes, peer: Bytes) -> Bytes! {
    match p256.sharedSecret(secret, peer) {
        Ok(v) -> v
        Err(e) -> fail Fail { text: e.message() }
    }
}

// ---- client side --------------------------------------------------------

fn deterministicRandom(n: usize) -> Bytes! {
    Bytes.fill(0x5a, n)
}

type Case = {
    mode Mode
    cert Bytes
    key Bytes
    serverName String
    now Int
    expect String
}

fn modeName(m: Mode) -> String {
    match m {
        Mode.Happy -> "happy"
        Mode.WrongFinished -> "wrong-finished"
        Mode.BadSuite -> "bad-suite"
        Mode.WrongOrder -> "wrong-order"
        Mode.EarlyData -> "early-data"
        Mode.PlainAlert -> "plain-alert"
        Mode.Oversized -> "oversized"
        Mode.RetryP256 -> "retry-p256"
        Mode.RetryCookieOnly -> "retry-cookie"
        Mode.RetryBadGroup -> "retry-bad-group"
        Mode.RetryReuseX25519 -> "retry-reuse-x25519"
        Mode.RetryNoChange -> "retry-no-change"
        Mode.RetryBadCookie -> "retry-bad-cookie"
        Mode.RetryServerGroupMismatch -> "retry-server-group"
        Mode.SecondRetry -> "second-retry"
    }
}


async fn runCase(n: net.Net, c: Case) -> String! {
    let poolListen = task.BlockingPool.new(1)
    let listener = await poolListen.run(() => n.listen("127.0.0.1", 0).unwrap()).unwrap()
    let port = listener.port()
    let running = task.spawn(serverAccept(listener, c.mode, c.cert, c.key))
    let poolConnect = task.BlockingPool.new(1)
    let mut conn = await poolConnect.run(() => n.connect("127.0.0.1", port).unwrap()).unwrap()
    let root = (x509.parse(dec(ROOT)))?
    let mut config = tls.Config.new(c.serverName, Array.of(root), (k) => deterministicRandom(k))
    config.nowMillis = c.now
    let connected = await (tls.Client.connect(conn, config))
    let mut summary = ""
    let session = match connected {
        Ok(value) -> Some(value)
        Err(e) -> {
            summary = e.message()
            None
        }
    }
    if let Some(held) = session {
        let mut s = held
        let helloPlain = secretOf("hello tls".toBytes())
        match await s.write(&helloPlain) {
            Ok(_) -> {}
            Err(e) -> { summary = "write: ${e.message()}" }
        }
        if summary == "" {
            let firstResult = await s.read(64)
            match firstResult {
                Ok(first) -> {
                    let secondResult = await s.read(64)
                    match secondResult {
                        Ok(second) -> {
                            let text = match String.fromBytes(reveal(&first)) {
                                Ok(value) -> value
                                Err(_) -> ""
                            }
                            if first.len() == 7 && text == "welcome" && second.len() == 0 {
                                summary = "ok"
                            } else {
                                summary = "bad application data"
                            }
                        }
                        Err(e) -> { summary = "read2: ${e.message()}" }
                    }
                }
                Err(e) -> { summary = "read1: ${e.message()}" }
            }
        }
        await s.close()
    }
    // A rejection case leaves the scripted server blocked on a closed
    // socket; that failure is expected and is not part of the result.
    _ = await running
    summary
}

async fn run() -> Void! {
    let n = host.net()
    let now = 1794009600000
    let root = (x509.parse(dec(ROOT)))?
    _ = root
    let cases = Array.of(
        Case { mode: Mode.Happy, cert: dec(LEAF), key: dec(LEAF_KEY), serverName: "localhost", now: now, expect: "ok" }
        Case { mode: Mode.WrongFinished, cert: dec(LEAF), key: dec(LEAF_KEY), serverName: "localhost", now: now, expect: "Finished" }
        Case { mode: Mode.BadSuite, cert: dec(LEAF), key: dec(LEAF_KEY), serverName: "localhost", now: now, expect: "cipher" }
        Case { mode: Mode.WrongOrder, cert: dec(LEAF), key: dec(LEAF_KEY), serverName: "localhost", now: now, expect: "unexpected" }
        Case { mode: Mode.EarlyData, cert: dec(LEAF), key: dec(LEAF_KEY), serverName: "localhost", now: now, expect: "early" }
        Case { mode: Mode.PlainAlert, cert: dec(LEAF), key: dec(LEAF_KEY), serverName: "localhost", now: now, expect: "alert" }
        Case { mode: Mode.Oversized, cert: dec(LEAF), key: dec(LEAF_KEY), serverName: "localhost", now: now, expect: "record is larger" }
        Case { mode: Mode.Happy, cert: dec(LEAF), key: dec(LEAF_KEY), serverName: "wrong.example", now: now, expect: "hostname" }
        Case { mode: Mode.Happy, cert: dec(EXPIRED), key: dec(EXPIRED_KEY), serverName: "localhost", now: now, expect: "expired" }
        Case { mode: Mode.RetryP256, cert: dec(LEAF), key: dec(LEAF_KEY), serverName: "localhost", now: now, expect: "ok" }
        Case { mode: Mode.RetryCookieOnly, cert: dec(LEAF), key: dec(LEAF_KEY), serverName: "localhost", now: now, expect: "ok" }
        Case { mode: Mode.RetryBadGroup, cert: dec(LEAF), key: dec(LEAF_KEY), serverName: "localhost", now: now, expect: "group 24" }
        Case { mode: Mode.RetryReuseX25519, cert: dec(LEAF), key: dec(LEAF_KEY), serverName: "localhost", now: now, expect: "already offered" }
        Case { mode: Mode.RetryNoChange, cert: dec(LEAF), key: dec(LEAF_KEY), serverName: "localhost", now: now, expect: "would not change" }
        Case { mode: Mode.RetryBadCookie, cert: dec(LEAF), key: dec(LEAF_KEY), serverName: "localhost", now: now, expect: "cookie has 1 trailing" }
        Case { mode: Mode.RetryServerGroupMismatch, cert: dec(LEAF), key: dec(LEAF_KEY), serverName: "localhost", now: now, expect: "ServerHello selected key share group 29" }
        Case { mode: Mode.SecondRetry, cert: dec(LEAF), key: dec(LEAF_KEY), serverName: "localhost", now: now, expect: "second HelloRetryRequest" }
    )
    let mut remaining = cases
    for remaining.len() > 0 {
        let c = remaining.takeAt(0) || fail Fail { text: "case" }
        let name = modeName(c.mode)
        let expect = c.expect
        let outcome = (await runCase(n, c))?
        let ok = outcome.contains(expect)
        print "${name} => ${outcome} [${ok}]"
    }
}

task.currentThreadExecutor().runToCompletion(run())?
-- stdout --
happy => ok [true]
wrong-finished => tls: Finished verify_data does not match [true]
bad-suite => tls: unsupported: server selected cipher suite 4865, only TLS_CHACHA20_POLY1305_SHA256 is supported [true]
wrong-order => tls: unexpected message: expected ServerHello, got handshake type 11 [true]
early-data => tls: unsupported: server accepted early data this client never offered [true]
plain-alert => tls: peer sent alert 70 (level 2) [true]
oversized => tls: record is larger than the configured limit [true]
happy => tls: bad certificate: x509: certificate does not match hostname wrong.example [true]
happy => tls: bad certificate: x509: certificate has expired [true]
retry-p256 => ok [true]
retry-cookie => ok [true]
retry-bad-group => tls: unsupported: server requested key share group 24, only x25519 and secp256r1 are supported [true]
retry-reuse-x25519 => tls: malformed handshake: HelloRetryRequest requested x25519, which the first ClientHello already offered [true]
retry-no-change => tls: malformed handshake: HelloRetryRequest would not change the ClientHello [true]
retry-bad-cookie => tls: malformed handshake: cookie has 1 trailing bytes [true]
retry-server-group => tls: malformed handshake: ServerHello selected key share group 29, but the ClientHello sent group 23 [true]
second-retry => tls: unexpected message: server sent a second HelloRetryRequest [true]

-- src --
import aead from std/crypto/chacha20poly1305
import hex from std/encoding/hex
import secret from std/secret

fn show(b: Bytes) -> String {
    hex.encode(b)
}

fn showSecret(b: &secret.SecretBuffer) -> String {
    hex.encode(unsafe { b.copy().declassify() })
}

fn sec(b: Bytes) -> secret.SecretBuffer {
    secret.SecretBuffer.fromBytes(b)
}

fn dec(s: String) -> Bytes {
    hex.decode(s).expect("hex")
}

fn outcome(r: Result[secret.SecretBuffer, aead.Error]) -> String {
    match r {
        Ok(b) -> "ok:${b.len()}"
        Err(aead.Error.BadKeySize) -> "bad-key-size"
        Err(aead.Error.BadNonceSize) -> "bad-nonce-size"
        Err(aead.Error.ShortInput) -> "short-input"
        Err(aead.Error.TagMismatch) -> "tag-mismatch"
    }
}

fn openHex(r: Result[secret.SecretBuffer, aead.Error]) -> String {
    match r {
        Ok(b) -> showSecret(&b)
        Err(_) -> "err"
    }
}

fn flip(b: Bytes, at: usize) -> Bytes {
    let mut out = Array.empty[u8]()
    let mut i: usize = 0
    for i < b.len() {
        if i == at {
            out.push(b[i] ^ 1)
        } else {
            out.push(b[i])
        }
        i = i + 1
    }
    Bytes.fromArray(&out)
}

// RFC 8439 §2.8.2
let key = sec(dec("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f"))
let nonce = dec("070000004041424344454647")
let aad = dec("50515253c0c1c2c3c4c5c6c7")
let plaintext = sec(b"Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.")
let sealedSecret = aead.seal(&key, nonce, aad, &plaintext).expect("seal")
// The test boundary releases the sealed bytes so they can be compared.
let sealed = unsafe { sealedSecret.copy().declassify() }
print "rfc-seal ${show(sealed)}"
print "rfc-open ${openHex(aead.open(&key, nonce, aad, sealed))}"
print "rfc-roundtrip ${outcome(aead.open(&key, nonce, aad, sealed))}"

// RFC 8439 §A.5: a 265-byte ciphertext in twelve blocks
let a5key = sec(dec("1c9240a5eb55d38af333888604f6b5f0473917c1402b80099dca5cbc207075c0"))
let a5nonce = dec("000000000102030405060708")
let a5aad = dec("f33388860000000000004e91")
let a5cipher = dec("")
let a5sealed = a5cipher.concat(dec("eead9d67890cbb22392336fea1851f38"))
print "a5-open ${openHex(aead.open(&a5key, a5nonce, a5aad, a5sealed))}"
print "a5-empty ${showSecret(&aead.seal(&a5key, a5nonce, a5aad, &sec(Bytes.zeros(0))).expect("seal"))}"

// Tampering with any authenticated byte, or with the tag, is refused
print "tag-flip ${outcome(aead.open(&key, nonce, aad, flip(sealed, sealed.len() - 1)))}"
print "ct-flip ${outcome(aead.open(&key, nonce, aad, flip(sealed, 0)))}"
print "aad-mismatch ${outcome(aead.open(&key, nonce, Bytes.zeros(0), sealed))}"
print "nonce-mismatch ${outcome(aead.open(&key, dec("000000000000000000000000"), aad, sealed))}"
print "short-input ${outcome(aead.open(&key, nonce, aad, Bytes.zeros(15)))}"
print "empty-input ${outcome(aead.open(&key, nonce, aad, Bytes.zeros(0)))}"
print "bad-key ${outcome(aead.open(&sec(Bytes.zeros(31)), nonce, aad, sealed))}"
print "bad-nonce ${outcome(aead.open(&key, Bytes.zeros(11), aad, sealed))}"
print "seal-bad-key ${outcome(aead.seal(&sec(Bytes.zeros(33)), nonce, aad, &plaintext))}"
print "seal-bad-nonce ${outcome(aead.seal(&key, Bytes.fill(0, 13), aad, &plaintext))}"

// Empty and non-block-aligned shapes
let ek = sec(dec("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"))
print "empty-empty ${showSecret(&aead.seal(&ek, dec("000000000000000000000000"), Bytes.zeros(0), &sec(Bytes.zeros(0))).expect("seal"))}"
print "empty-empty-open ${outcome(aead.open(&ek, dec("000000000000000000000000"), Bytes.zeros(0), unsafe { aead.seal(&ek, dec("000000000000000000000000"), Bytes.zeros(0), &sec(Bytes.zeros(0))).expect("seal").declassify() }))}"
print "empty-aad ${showSecret(&aead.seal(&ek, dec("0102030405060708090a0b0c"), dec("aabbccddee"), &sec(Bytes.zeros(0))).expect("seal"))}"
print "pt-no-aad ${showSecret(&aead.seal(&ek, dec("0c0b0a090807060504030201"), Bytes.zeros(0), &sec(b"abc")).expect("seal"))}"
print "odd-aad ${showSecret(&aead.seal(&ek, dec("ffffffffffffffffffffffff"), Bytes.fill(0x00, 15), &sec(b"0123456789abcdef0123456789abcde")).expect("seal"))}"
let mut block = Array.empty[u8]()
let mut i: usize = 0
for i < 64 {
    block.push(i.truncate[u8]())
    i = i + 1
}
print "block64 ${showSecret(&aead.seal(&ek, dec("000000000000000000000001"), Bytes.fill(0x78, 17), &sec(Bytes.fromArray(&block))).expect("seal"))}"

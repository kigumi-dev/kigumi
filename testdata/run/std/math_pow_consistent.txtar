pow(10.0, -2.0) = 0.01
pow(2.0, -1074.0) = 5e-324
pow(2.0, -1075.0) = 0
pow(2.0, 1023.0) = 8.98846567431158e+307
pow(2.0, 1024.0) = +Inf
pow(1.5, 1750.0) = 1.4444527745742028e+308
pow(1.5, 1760.0) = +Inf

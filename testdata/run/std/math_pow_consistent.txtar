-- src --
import math from std/math

print "pow(1.00000001, 100000000.0) = ${math.pow(1.00000001, 100000000.0)}"
print "pow(1.1, 50.0) = ${math.pow(1.1, 50.0)}"
print "pow(2.0, 10.0) = ${math.pow(2.0, 10.0)}"
print "pow(2.0, 0.5) = ${math.pow(2.0, 0.5)}"
print "pow(4.0, 0.5) = ${math.pow(4.0, 0.5)}"
print "pow(10.0, -2.0) = ${math.pow(10.0, -2.0)}"
print "pow(2.0, -1074.0) = ${math.pow(2.0, -1074.0)}"
print "pow(2.0, -1075.0) = ${math.pow(2.0, -1075.0)}"
print "pow(2.0, 1023.0) = ${math.pow(2.0, 1023.0)}"
print "pow(2.0, 1024.0) = ${math.pow(2.0, 1024.0)}"
print "pow(1.5, 1750.0) = ${math.pow(1.5, 1750.0)}"
print "pow(1.5, 1760.0) = ${math.pow(1.5, 1760.0)}"
print "pow(0.5, 1080.0) = ${math.pow(0.5, 1080.0)}"
print "pow(-2.0, 3.0) = ${math.pow(-2.0, 3.0)}"
print "pow(-2.0, 4.0) = ${math.pow(-2.0, 4.0)}"
print "pow(-2.0, -3.0) = ${math.pow(-2.0, -3.0)}"
print "pow(-2.0, 0.5) = ${math.pow(-2.0, 0.5)}"
print "pow(-8.0, 0.3333333333333333) = ${math.pow(-8.0, 0.3333333333333333)}"
print "pow(-1.0, 1e+300) = ${math.pow(-1.0, 1e+300)}"
print "pow(-1.5, 1e+300) = ${math.pow(-1.5, 1e+300)}"
print "pow(-1.5, 1001.0) = ${math.pow(-1.5, 1001.0)}"
print "pow(0.9999999999999999, 1e+17) = ${math.pow(0.9999999999999999, 1e+17)}"
print "pow(5e-324, 0.5) = ${math.pow(5e-324, 0.5)}"
print "pow(-0.0, -1.0) = ${math.pow(-0.0, -1.0)}"
print "pow(0.0, -1.0) = ${math.pow(0.0, -1.0)}"
print "pow(-0.0, 3.0) = ${math.pow(-0.0, 3.0)}"
print "pow(-0.0, 2.0) = ${math.pow(-0.0, 2.0)}"
print "pow(0.0, 0.0) = ${math.pow(0.0, 0.0)}"
print "pow(nan(), 0.0) = ${math.pow(math.nan(), 0.0)}"
print "pow(1.0, nan()) = ${math.pow(1.0, math.nan())}"
print "pow(nan(), 1.0) = ${math.pow(math.nan(), 1.0)}"
print "pow(2.0, nan()) = ${math.pow(2.0, math.nan())}"
print "pow(-1.0, inf()) = ${math.pow(-1.0, math.inf())}"
print "pow(0.5, inf()) = ${math.pow(0.5, math.inf())}"
print "pow(2.0, inf()) = ${math.pow(2.0, math.inf())}"
print "pow(0.5, -inf()) = ${math.pow(0.5, -math.inf())}"
print "pow(inf(), -1.0) = ${math.pow(math.inf(), -1.0)}"
print "pow(-inf(), 3.0) = ${math.pow(-math.inf(), 3.0)}"
print "pow(-inf(), -3.0) = ${math.pow(-math.inf(), -3.0)}"
print "pow(-inf(), 2.0) = ${math.pow(-math.inf(), 2.0)}"
-- stdout --
pow(1.00000001, 100000000.0) = 2.7182817983473577
pow(1.1, 50.0) = 117.39085287969579
pow(2.0, 10.0) = 1024

-- src --
fn build(n: usize) -> ByteBuffer {
    let mut buf = ByteBuffer.tryNew(n).unwrap()
    buf.set(0, 104)
    buf
}

let mut buf = build(8)
buf.copyFromString(1, "héllo", 1, 6)
buf.copyFrom(6, "!?".toBytes(), 0, 2)
let s = buf.freezeString()
print "string <${s}> ${s.len()}"

let mut raw = ByteBuffer.tryNew(4).unwrap()
raw.set(3, 255)
raw.copyFrom(0, Bytes.fill(7, 3), 1, 3)
let b = raw.freeze()
print "bytes ${b.len()} ${b.get(0) || 0} ${b.get(1) || 0} ${b.get(2) || 0} ${b.get(3) || 0}"

let empty = ByteBuffer.tryNew(0).unwrap().freezeString()
print "empty <${empty}> ${empty.len()}"

let mut whole = ByteBuffer.tryNew(3).unwrap()
whole.copyFromString(0, "日", 0, 3)
whole.copyFromString(3, "日", 3, 3)
let again = whole.freezeString()
print "whole ${again} ${again == "日"}"

let mut parts = Array.empty[ByteBuffer]()
for i in 0..3 {
    let mut p = ByteBuffer.tryNew(1).unwrap()
    p.set(0, 97 + i.truncate[u8]())
    parts.push(p)
}
for p in parts {
    print "part ${p.freezeString()}"
}
-- stdout --
string <héllo!?> 8
bytes 4 7 7 0 255
empty <> 0
whole 日 true
part a
part b
part c

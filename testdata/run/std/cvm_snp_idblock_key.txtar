-- src --
import hex from std/encoding/hex
import binary from std/encoding/binary
import snp from std/cvm/snp

fn withByte(raw: Bytes, at: usize, value: u8) -> Bytes {
    let mut buffer = ByteBuffer.tryNew(raw.len()).expect("byte buffer")
    buffer.copyFrom(0, raw, 0, raw.len())
    buffer.set(at, value)
    buffer.freeze()
}

fn u32Bytes(value: u32) -> Bytes {
    let mut out = Array.empty[u8]()
    binary.putU32Le(&mut out, value)
    Bytes.fromArray(&out)
}

fn responseWith(status: u32) -> Bytes {
    let mut response = ByteBuffer.tryNew(snp.keyResponseSize).expect("response")
    let encoded = u32Bytes(status)
    response.copyFrom(0, encoded, 0, 4)
    response.freeze()
}

fn acceptKey(key: &snp.EcdsaPublicKey, digest: Bytes, signature: &snp.Signature) -> Result[Bool, snp.Error] {
    Ok(key.curve == 2 && digest.len() == 48 && signature.s.len() == 72)
}

fn rejectKey(key: &snp.EcdsaPublicKey, digest: Bytes, signature: &snp.Signature) -> Result[Bool, snp.Error] {
    let _ = key
    let _ = digest
    let _ = signature
    Ok(false)
}

fn main() -> Void! {
    let blockRaw = hex.decode("303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f4b4947554d492d46414d494c592d30314b4947554d492d494d4147452d30303101000000070000000001020000000000")?
    let authRaw = hex.decode("")?
    let block = snp.parseIdBlock(blockRaw)?
    let auth = snp.parseIdAuth(authRaw)?
    print "block ld=${hex.encode(block.launchDigest)}"
    print "block family=${hex.encode(block.familyId)} image=${hex.encode(block.imageId)}"
    print "block version=${block.version} svn=${block.guestSvn} policy=${block.policy.raw} abi=${block.policy.abiMajor()}.${block.policy.abiMinor()}"
    print "auth algorithm=${auth.idKeyAlgorithm}/${auth.authKeyAlgorithm} curve=${auth.idKey.curve}"
    print "auth x=${auth.idKey.x[0]},${auth.idKey.x[71]} y=${auth.idKey.y[0]},${auth.idKey.y[71]}"
    print "auth author=${auth.authorKey is Some(_)} blockSig=${auth.idBlockSignature.r[0]},${auth.idBlockSignature.s[0]} keySig=${auth.idKeySignature.r[0]},${auth.idKeySignature.s[0]}"
    print "auth bytes=${auth.idKey.bytes().len()}"

    match snp.verifyIdBlock(&block, &auth, false, acceptKey) {
        Ok(_) -> print "idblock accept=ok"
        Err(error) -> print "idblock accept=${error.message()}"
    }
    match snp.verifyIdBlock(&block, &auth, false, rejectKey) {
        Ok(_) -> print "idblock reject=accepted"
        Err(error) -> print "idblock reject=${error.message()}"
    }
    match snp.verifyIdBlock(&block, &auth, true, acceptKey) {
        Ok(_) -> print "idblock author=accepted"
        Err(error) -> print "idblock author=${error.message()}"
    }
    let authorRaw = hex.decode("")?
    let authAuthor = snp.parseIdAuth(authorRaw)?
    print "auth author key=${authAuthor.authorKey is Some(_)} x=${match authAuthor.authorKey {
        Some(key) -> key.x[0]
        None -> 0
    }}"
    match snp.verifyIdBlock(&block, &authAuthor, true, acceptKey) {
        Ok(_) -> print "idblock signed-author=ok"
        Err(error) -> print "idblock signed-author=${error.message()}"
    }
    match snp.verifyIdBlock(&block, &authAuthor, true, rejectKey) {
        Ok(_) -> print "idblock signed-author-reject=accepted"
        Err(error) -> print "idblock signed-author-reject=${error.message()}"
    }

    match snp.parseIdBlock(Bytes.zeros(1)) {
        Ok(_) -> print "block size=accepted"
        Err(error) -> print "block size=${error.message()}"
    }
    match snp.parseIdBlock(withByte(blockRaw, 0x50, 2)) {
        Ok(_) -> print "block version=accepted"
        Err(error) -> print "block version=${error.message()}"
    }
    match snp.parseIdBlock(withByte(blockRaw, 0x5A, 0)) {
        Ok(_) -> print "block policy=accepted"
        Err(error) -> print "block policy=${error.message()}"
    }
    match snp.parseIdAuth(Bytes.zeros(1)) {
        Ok(_) -> print "auth size=accepted"
        Err(error) -> print "auth size=${error.message()}"
    }
    match snp.parseIdAuth(withByte(authRaw, 0, 2)) {
        Ok(_) -> print "auth algorithm=accepted"
        Err(error) -> print "auth algorithm=${error.message()}"
    }
    match snp.parseIdAuth(withByte(authRaw, 0x08, 1)) {
        Ok(_) -> print "auth reserved=accepted"
        Err(error) -> print "auth reserved=${error.message()}"
    }
    match snp.parseIdAuth(withByte(authRaw, 0x240, 3)) {
        Ok(_) -> print "auth curve=accepted"
        Err(error) -> print "auth curve=${error.message()}"
    }
    match snp.parseIdAuth(withByte(authRaw, 0x274, 1)) {
        Ok(_) -> print "auth coordinate=accepted"
        Err(error) -> print "auth coordinate=${error.message()}"
    }
    match snp.parseIdAuth(withByte(authRaw, 0x40 + 144, 1)) {
        Ok(_) -> print "auth sigres=accepted"
        Err(error) -> print "auth sigres=${error.message()}"
    }

    let request = snp.DerivedKeyRequest {
        rootKeySelect: snp.RootKeySelect.Vmrk
        keySelect: snp.KeySelect.Vlek
        guestFieldSelect: snp.GuestFieldSelect { raw: 0x67 }
        vmpl: 2
        guestSvn: 9
        tcbVersion: snp.TcbVersion { raw: 0x0102030405060708 }
        launchMitVector: Some(0x20)
    }
    let encoded = snp.encodeKeyRequest(&request)
    print "key request len=${encoded.len()}"
    let parsed = snp.parseKeyRequest(encoded)?
    print "key request root=${parsed.rootKeySelect is snp.RootKeySelect.Vmrk} select=${parsed.keySelect is snp.KeySelect.Vlek} fields=${parsed.guestFieldSelect.raw} vmpl=${parsed.vmpl} svn=${parsed.guestSvn} tcb=${parsed.tcbVersion.raw} mit=${parsed.launchMitVector || 0}"
    let legacy = match encoded.slice(0, snp.keyRequestSizeLegacy) {
        Some(value) -> value
        None -> Bytes.zeros(0)
    }
    let old = snp.parseKeyRequest(legacy)?
    print "key legacy len=${legacy.len()} mit=${old.launchMitVector is None} vmpl=${old.vmpl}"
    match snp.parseKeyRequest(withByte(encoded, 0, 0x08)) {
        Ok(_) -> print "key flags=accepted"
        Err(error) -> print "key flags=${error.message()}"
    }
    match snp.parseKeyRequest(withByte(encoded, 4, 1)) {
        Ok(_) -> print "key reserved=accepted"
        Err(error) -> print "key reserved=${error.message()}"
    }
    match snp.parseKeyRequest(withByte(encoded, 8, 0x80)) {
        Ok(_) -> print "key fields=accepted"
        Err(error) -> print "key fields=${error.message()}"
    }
    match snp.parseKeyRequest(withByte(encoded, 0, 0x06)) {
        Ok(_) -> print "key select=accepted"
        Err(error) -> print "key select=${error.message()}"
    }
    match snp.parseKeyRequest(withByte(encoded, 0x10, 4)) {
        Ok(_) -> print "key vmpl=accepted"
        Err(error) -> print "key vmpl=${error.message()}"
    }

    let mut response = ByteBuffer.tryNew(snp.keyResponseSize).expect("response")
    let key = Bytes.fill(0xAA, 32)
    response.copyFrom(snp.keyResponseKeyOffset, key, 0, key.len())
    let ok = snp.parseKeyResponse(response.freeze())?
    print "key response status=${ok.status} present=${ok.key is Some(_)} first=${match ok.key {
        Some(value) -> value[0]
        None -> 0
    }}"
    let invalid = snp.parseKeyResponse(responseWith(snp.keyStatusInvalidParameters))?
    print "key invalid status=${invalid.status} present=${invalid.key is Some(_)}"
    let forbidden = snp.parseKeyResponse(responseWith(snp.keyStatusInvalidKeySelection))?
    print "key forbidden status=${forbidden.status} present=${forbidden.key is Some(_)}"
    match snp.parseKeyResponse(responseWith(1)) {
        Ok(_) -> print "key unknown=accepted"
        Err(error) -> print "key unknown=${error.message()}"
    }
    match snp.parseKeyResponse(Bytes.zeros(1)) {
        Ok(_) -> print "key size=accepted"
        Err(error) -> print "key size=${error.message()}"
    }
}
-- stdout --
block ld=303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f
block family=4b4947554d492d46414d494c592d3031 image=4b4947554d492d494d4147452d303031
block version=1 svn=7 policy=131328 abi=1.0
auth algorithm=1/1 curve=2
auth x=1,0 y=2,0
auth author=false blockSig=3,4 keySig=5,6
auth bytes=1028
idblock accept=ok
idblock reject=snp: forged or inconsistent ID block signature
idblock author=snp: malformed author public key
auth author key=true x=3
idblock signed-author=ok
idblock signed-author-reject=snp: forged or inconsistent ID block signature
block size=snp: expected 96 bytes, got 1
block version=snp: unsupported version 2
block policy=snp: malformed ID block policy
auth size=snp: expected 4096 bytes, got 1
auth algorithm=snp: unsupported algorithm 2
auth reserved=snp: reserved bytes are not zero in ID auth reserved
auth curve=snp: unsupported algorithm 3
auth coordinate=snp: malformed ID public key
auth sigres=snp: reserved bytes are not zero in ID block signature
key request len=40
key request root=true select=true fields=103 vmpl=2 svn=9 tcb=72623859790382856 mit=32
key legacy len=32 mit=true vmpl=2
key flags=snp: reserved bytes are not zero in key request flags
key reserved=snp: reserved bytes are not zero in key request reserved
key fields=snp: reserved bytes are not zero in guest field select
key select=snp: malformed key select
key vmpl=snp: malformed key request VMPL
key response status=0 present=true first=170
key invalid status=22 present=false
key forbidden status=39 present=false
key unknown=snp: malformed key response status
key size=snp: expected 64 bytes, got 1

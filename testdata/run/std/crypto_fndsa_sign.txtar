-- src --
import fndsa from std/crypto/fndsa
import hex from std/encoding/hex

fn main() -> Void! {
    // Falcon-512 Round 3 KAT, count 0: sign with the published secret key
    // and the salt recorded in the KAT signed message.
    let pk = hex.decode("")?
    let sk = hex.decode("")?
    let msg = hex.decode("D81C4D8D734FCBFBEADE3D3F8A039FAA2A2C9957E835AD55B22E75BF57BB556AC8")?
    let salt = hex.decode("33b3c07507e4201748494d832b6ee2a6c93bff9b0ee343b550d1f85a3d0de0d704c6d17842951309")?
    print "pk match=${hex.encode(fndsa.publicKeyOf(sk)?) == hex.encode(pk)}"
    let sig = fndsa.sign(sk, msg, salt)?
    print "sig len=${sig.len()}"
    print "sig match=${hex.encode(sig) == ""}"
    print "verify=${fndsa.verify(pk, msg, sig)?}"
}
-- stdout --
pk match=true
sig len=656
sig match=true
verify=true

-- src --
// Vectors: Wycheproof rsa_pss_2048_sha256_mgf1_32 and _mgf1_0 (C2SP testvectors_v1).
import hex from std/encoding/hex
import rsa from std/crypto/rsa

fn show(r: Result[Bool, rsa.Error]) -> String {
    match r {
        Ok(v) -> "${v}"
        Err(e) -> e.message()
    }
}

fn main() -> Void! {
    let pk = rsa.parsePkcs1(hex.decode("")?)?
    print "key ${pk.byteSize()} ${pk.bitSize()} ${pk.exponent()}"

    let test = hex.decode("54657374")?
    let sigTest = hex.decode("")?
    print "pss-exact ${show(rsa.verifyPssSha256(pk, test, sigTest, rsa.SaltLength.Exact(32)))}"
    print "pss-auto ${show(rsa.verifyPssSha256(pk, test, sigTest, rsa.SaltLength.Auto))}"
    print "pss-wrong-message ${show(rsa.verifyPssSha256(pk, b"tesT", sigTest, rsa.SaltLength.Auto))}"

    let noSalt = hex.decode("")?
    let noSaltSig = hex.decode("")?
    print "pss-salt0-auto ${show(rsa.verifyPssSha256(pk, noSalt, noSaltSig, rsa.SaltLength.Auto))}"
    print "pss-salt0-exact32 ${show(rsa.verifyPssSha256(pk, noSalt, noSaltSig, rsa.SaltLength.Exact(32)))}"

    let modified = hex.decode("")?
    print "pss-modified ${show(rsa.verifyPssSha256(pk, b"123400", modified, rsa.SaltLength.Auto))}"
    print "pss-range ${show(rsa.verifyPssSha256(pk, test, hex.decode("")?, rsa.SaltLength.Auto))}"
    print "pss-short ${show(rsa.verifyPssSha256(pk, test, hex.decode("")?, rsa.SaltLength.Auto))}"

    let empty = hex.decode("")?
    let emptySig = hex.decode("")?
    print "pss-empty-auto ${show(rsa.verifyPssSha256(pk, empty, emptySig, rsa.SaltLength.Auto))}"
}
-- stdout --
key 256 2048 65537
pss-exact true
pss-auto true
pss-wrong-message false
pss-salt0-auto true
pss-salt0-exact32 false
pss-modified false
pss-range rsa: signature is not below the modulus
pss-short rsa: signature length does not match the modulus
pss-empty-auto true

-- src --
import mldsa from std/crypto/mldsa
import hex from std/encoding/hex

fn flipOne(b: Bytes) -> Bytes {
    let mut a = Array.empty[u8]()
    for x in b {
        a.push(x)
    }
    a[0] = a[0] ^ 1
    Bytes.fromArray(&a)
}

fn main() -> Void! {
    // NIST ACVP ML-DSA-65 sigGen tcId 31, deterministic pure signature.
    let sk31 = hex.decode("")?
    let pk31 = hex.decode("")?
    let msg31 = hex.decode("")?
    let ctx31 = hex.decode("32ACB4CD9FD5F046155769897EDB150CE0")?
    let sig31 = mldsa.sign(sk31, msg31, ctx31, Bytes.zeros(0))?
    if hex.encode(sig31) != "" {
        print "siggen tc 31 signature mismatch"
    }
    print "siggen tc 31 ok"
    let verify31 = mldsa.verify(pk31, msg31, ctx31, sig31)?
    print "verify tc 31 ${verify31}"
    let tampered31 = mldsa.verify(pk31, flipOne(msg31), ctx31, sig31)?
    print "tampered tc 31 ${tampered31}"

    // NIST ACVP ML-DSA-65 sigGen tcId 211, randomized pure signature.
    let sk211 = hex.decode("")?
    let pk211 = hex.decode("")?
    let msg211 = hex.decode("")?
    let ctx211 = hex.decode("270E7D9A16E4AFF615F9DF70DA06779F6A92B2ECBEB0D5BF24B305AC03B393C296BB521E3CB2135FA97B8DB279315F0269A611FF4286167A2CBA4D2A445871A2AB59A23A08E0467B91")?
    let rnd211 = hex.decode("418A9C20FD0D9D9AE226E14CA79C4881ADBCBDDCDDBA0CABFCBDA35E6B7FEF5A")?
    let sig211 = mldsa.sign(sk211, msg211, ctx211, rnd211)?
    if hex.encode(sig211) != "" {
        print "siggen tc 211 signature mismatch"
    }
    print "siggen tc 211 ok"
    print "verify tc 211 ${mldsa.verify(pk211, msg211, ctx211, sig211)?}"
}
-- stdout --
siggen tc 31 ok
verify tc 31 true
tampered tc 31 false
siggen tc 211 ok
verify tc 211 true

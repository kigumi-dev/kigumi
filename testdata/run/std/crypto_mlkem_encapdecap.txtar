-- src --
import mlkem from std/crypto/mlkem
import hex from std/encoding/hex

fn main() -> Void! {
    // NIST ACVP ML-KEM-768 encapsulation tcId 26.
    let e26 = mlkem.encapsulate(hex.decode("")?, hex.decode("4E77596168711E913965D8175AC3BD76AAB08B7F9385A02AE883CF6C6E17DD81")?)?
    if hex.encode(e26.sharedSecret) != "79d74f6c6c2d916bec47bd828fd9b67295a37f54927fab1263c0d122f1c6f1ed" {
        print "encapsulation tc 26 shared secret mismatch"
    }
    if hex.encode(e26.ciphertext) != "" {
        print "encapsulation tc 26 ciphertext mismatch"
    }
    print "encapsulation tc 26 ok"
    // NIST ACVP ML-KEM-768 encapsulation tcId 27.
    let e27 = mlkem.encapsulate(hex.decode("")?, hex.decode("C465031F7464614109C7DDB28AB216181DB5002AE54EAF6C5D6A6EEFC4F72B9E")?)?
    if hex.encode(e27.sharedSecret) != "3d58d95a3556fc5f5784b5b537f4a99c3d83cb0c9d80b1e4fa96f8d1ab08554e" {
        print "encapsulation tc 27 shared secret mismatch"
    }
    if hex.encode(e27.ciphertext) != "" {
        print "encapsulation tc 27 ciphertext mismatch"
    }
    print "encapsulation tc 27 ok"
    // NIST ACVP ML-KEM-768 encapsulation tcId 28.
    let e28 = mlkem.encapsulate(hex.decode("")?, hex.decode("536A7BB351925C3FD11646FA4BF620F57755482F3F891E96E2FED5C847E7F0BD")?)?
    if hex.encode(e28.sharedSecret) != "edeacbd5254d20113da8f7d9391e300634ea574fa1a3303a65c8e3fc919152f9" {
        print "encapsulation tc 28 shared secret mismatch"
    }
    if hex.encode(e28.ciphertext) != "" {
        print "encapsulation tc 28 ciphertext mismatch"
    }
    print "encapsulation tc 28 ok"
    // NIST ACVP ML-KEM-768 decapsulation tcId 86 (modified ciphertext).
    let k86 = mlkem.decapsulate(hex.decode("")?, hex.decode("")?)?
    if hex.encode(k86) != "34cfae7f2ca3b0b9c3e06afeed554c053f6e51d875d3bd3ff0eda2086ee79f3a" {
        print "decapsulation tc 86 shared secret mismatch"
    }
    print "decapsulation tc 86 ok"
    // NIST ACVP ML-KEM-768 decapsulation tcId 88 (modified ciphertext).
    let k88 = mlkem.decapsulate(hex.decode("")?, hex.decode("")?)?
    if hex.encode(k88) != "2cfb695710a6c4377f46c20c13480aef7ac56030d47a0ab5af07ddd6062c28f4" {
        print "decapsulation tc 88 shared secret mismatch"
    }
    print "decapsulation tc 88 ok"
    // NIST ACVP ML-KEM-768 decapsulation tcId 89 (modified ciphertext).
    let k89 = mlkem.decapsulate(hex.decode("")?, hex.decode("")?)?
    if hex.encode(k89) != "6c8c7afc5b05f3aa94d30fed24a6ff89c5c84625b5792cade7e89af988f45447" {
        print "decapsulation tc 89 shared secret mismatch"
    }
    print "decapsulation tc 89 ok"
}
-- stdout --
encapsulation tc 26 ok
encapsulation tc 27 ok
encapsulation tc 28 ok
decapsulation tc 86 ok
decapsulation tc 88 ok
decapsulation tc 89 ok

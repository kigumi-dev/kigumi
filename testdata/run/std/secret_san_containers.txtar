-- src --
import secret from std/secret

fn secretSeven() -> u64 {
    let mut t = FixedArray.filled[u64, 4](0)
    _ = t.set(2, 7)
    secret.ctLookupU64(&t, secret.SecretIndex[4].from(secret.SecretU32.classify(2)))
}

import {Box, Shared} from std/alloc

fn reveal(v: u64) -> u64 {
    unsafe {
        secret.SecretU64.classify(v).declassify()
    }
}

// A fallible allocation's Result tag depends on sizes only, so secret contents pass through.
let b = Box.new(secretSeven())
let s = Shared.new(secretSeven())
let mut xs = Array.of[u64](1, 3)
xs.insertAt(0, secretSeven())
let ys = Array.of[u64](secretSeven(), 3).concat(Array.of[u64](4))
let mut buf = ByteBuffer.tryNew(1).unwrap()
buf.set(0, secretSeven().truncate[u8]())
let bs = buf.freeze().concat("zz".toBytes())
print "${reveal(b.get())} ${reveal(s.get())} ${reveal(xs[0])} ${reveal(ys[0])} ${bs.len()} ${xs.len()} ${ys.len()}"
-- stdout --
7 7 7 7 3 3 3
-- secret-san --

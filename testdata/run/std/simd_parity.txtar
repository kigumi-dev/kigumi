// composition: concrete wrappers, record field, array element
type Slots = {
    pub mut v simd.Vec[i32, 4]
}
fn addPair(a: simd.Vec[i32, 4], b: simd.Vec[i32, 4]) -> simd.Vec[i32, 4] {
    a.add(b)
}
fn makeU8(v: u8) -> simd.Vec[u8, 16] {
    simd.Vec.splat[u8, 16](v)
}
let p = simd.Vec.splat[i32, 4](7)
let q = simd.Vec.splat[i32, 4](5)
let c = addPair(p, q)
print "comp call 0 7 5 ${c.lane(0)}"
let made = makeU8(200)
print "comp wrapper 0 200 - ${made.lane(15)}"
let mut slots = Slots { v: simd.Vec.splat[i32, 4](3) }
slots.v.setLane(1, 9)
print "comp field 0 9 - ${slots.v.lane(1)}"
let all = Array.of(simd.Vec.splat[i32, 4](4), simd.Vec.splat[i32, 4](6))
print "comp array 0 4 6 ${all[0].add(all[1]).lane(2)}"

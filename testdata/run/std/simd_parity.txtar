-- src --
import simd from std/simd
import math from std/math

// Exhaustive std/simd parity table: every public Vec operation over every
// lane type, with boundary and deterministic pseudo-random lanes. Each line
// is "<type> <op> <lane> <a> <b> <result>"; simd_exhaustive_test.go checks
// the result against a scalar two's-complement/IEEE-754 reference.

// i8: 16 lanes

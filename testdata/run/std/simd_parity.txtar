}
let mut sl_i8 = va_i8_0
for i in 0..16 { sl_i8.setLane(i, b_i8_0[i]) }
for i in 0..16 {
    print "i8 setlane ${i} ${b_i8_0[i]} ${sl_i8.toArray()[i]} ${sl_i8.lane(i)}"
}
let sv_i8_0: i8 = -128
let sv_i8_1: i8 = -1
let sp_i8_0 = simd.Vec.splat[i8, 16](sv_i8_0)
let sp_i8_1 = simd.Vec.splat[i8, 16](sv_i8_1)
for i in 0..16 {
    print "i8 splat ${i} ${sv_i8_0} - ${sp_i8_0.lane(i)}"
}
print "i8 splat 0 ${sv_i8_1} - ${sp_i8_1.lane(0)}"


-- src --
import math from std/math
import text from std/text

print "sin(0.5) ${math.toBits(math.sin(0.5))}"
print "cos(0.5) ${math.toBits(math.cos(0.5))}"
print "tan(0.5) ${math.toBits(math.tan(0.5))}"
print "sin(1e+22) ${math.toBits(math.sin(1e+22))}"
print "cos(1e+22) ${math.toBits(math.cos(1e+22))}"
print "tan(1e+22) ${math.toBits(math.tan(1e+22))}"
print "sin(5.319372648326541e+255) ${math.toBits(math.sin(5.319372648326541e+255))}"
print "cos(5.319372648326541e+255) ${math.toBits(math.cos(5.319372648326541e+255))}"
print "tan(5.319372648326541e+255) ${math.toBits(math.tan(5.319372648326541e+255))}"
print "sin(1.152921504606847e+18) ${math.toBits(math.sin(1.152921504606847e+18))}"
print "cos(1.152921504606847e+18) ${math.toBits(math.cos(1.152921504606847e+18))}"
print "tan(1.152921504606847e+18) ${math.toBits(math.tan(1.152921504606847e+18))}"
print "sin(4.71238898038469) ${math.toBits(math.sin(4.71238898038469))}"
print "cos(4.71238898038469) ${math.toBits(math.cos(4.71238898038469))}"
print "tan(4.71238898038469) ${math.toBits(math.tan(4.71238898038469))}"
print "exp(1.0) ${math.toBits(math.exp(1.0))}"
print "exp(-745.0) ${math.toBits(math.exp(-745.0))}"
print "exp(709.78) ${math.toBits(math.exp(709.78))}"
print "exp(-0.5) ${math.toBits(math.exp(-0.5))}"
print "log(2.0) ${math.toBits(math.log(2.0))}"
print "log2(2.0) ${math.toBits(math.log2(2.0))}"
print "log10(2.0) ${math.toBits(math.log10(2.0))}"
print "log(1e-310) ${math.toBits(math.log(1e-310))}"
print "log2(1e-310) ${math.toBits(math.log2(1e-310))}"
print "log10(1e-310) ${math.toBits(math.log10(1e-310))}"
print "log(0.9999999999999999) ${math.toBits(math.log(0.9999999999999999))}"
print "log2(0.9999999999999999) ${math.toBits(math.log2(0.9999999999999999))}"
print "log10(0.9999999999999999) ${math.toBits(math.log10(0.9999999999999999))}"
print "sinh(1e-10) ${math.toBits(math.sinh(1e-10))}"
print "cosh(1e-10) ${math.toBits(math.cosh(1e-10))}"
print "tanh(1e-10) ${math.toBits(math.tanh(1e-10))}"
print "sinh(0.75) ${math.toBits(math.sinh(0.75))}"
print "cosh(0.75) ${math.toBits(math.cosh(0.75))}"
print "tanh(0.75) ${math.toBits(math.tanh(0.75))}"
print "sinh(30.0) ${math.toBits(math.sinh(30.0))}"
print "cosh(30.0) ${math.toBits(math.cosh(30.0))}"
print "tanh(30.0) ${math.toBits(math.tanh(30.0))}"
print "pow(1.00000001, 100000000.0) ${math.toBits(math.pow(1.00000001, 100000000.0))}"
print "pow(1.1, 50.0) ${math.toBits(math.pow(1.1, 50.0))}"
print "pow(-1.5, 1001.0) ${math.toBits(math.pow(-1.5, 1001.0))}"
print "pow(0.5, 1074.0) ${math.toBits(math.pow(0.5, 1074.0))}"
print "fmod(5.5, 0.1) ${math.toBits(math.fmod(5.5, 0.1))}"
print "fmod(1e+308, 3e-308) ${math.toBits(math.fmod(1e+308, 3e-308))}"
print "fmod(-1e+22, 7.0) ${math.toBits(math.fmod(-1e+22, 7.0))}"
print "toBits ${math.toBits(1.0)} ${math.toBits(-0.0)} ${math.toBits(math.inf())} ${math.toBits(5e-324)}"
print "fromBits ${math.fromBits(4607182418800017408)} ${math.fromBits(9223372036854775808)} ${math.fromBits(9218868437227405311)} ${math.isNaN(math.fromBits(9221120237041090560))}"
print "made ${math.toBits(math.nan())} ${math.toBits(math.log(-1.0))} ${math.toBits(math.log2(-math.inf()))} ${math.toBits(math.log10(-2.0))}"
print "made ${math.toBits(math.sin(math.inf()))} ${math.toBits(math.tan(-math.inf()))} ${math.toBits(math.fmod(1.0, 0.0))} ${math.toBits(math.fmod(math.inf(), 2.0))} ${math.toBits(math.pow(-2.0, 0.5))}"
let negQuiet = math.fromBits(0xFFF8000000000000)
print "kept ${math.toBits(math.sinh(negQuiet))} ${math.toBits(math.cosh(negQuiet))} ${math.toBits(math.tanh(negQuiet))}"
print "kept ${math.toBits(math.log10(math.fromBits(0x7FF0000000000001)))} ${math.toBits(math.log(math.fromBits(0x7FF0000000000001)))} ${math.toBits(math.log2(math.fromBits(0xFFF0000000000002)))}"
print "kept ${math.toBits(math.sin(math.fromBits(0xFFF4000000000000)))} ${math.toBits(math.exp(math.fromBits(0x7FF0000000000003)))} ${math.toBits(math.fmod(math.fromBits(0x7FF4000000000000), 1.0))}"
let minusOne = text.parseFloat("-1") || 0.0
print "run ${math.toBits(math.log(minusOne))} ${math.toBits(math.sin(minusOne / 0.0))} ${math.toBits(math.pow(minusOne - 1.0, 0.5))} ${math.toBits(math.fmod(minusOne, 0.0))}"
let sig = math.fromBits(0xFFF4000000000123)
let sigRun = math.fromBits(text.parseUint("18443366373989024035") || 0)
print "round ${math.toBits(math.floor(sig))} ${math.toBits(math.ceil(sig))} ${math.toBits(math.round(sig))} ${math.toBits(math.trunc(sig))} ${math.toBits(math.fract(sig))}"
print "round ${math.toBits(math.floor(sigRun))} ${math.toBits(math.ceil(sigRun))} ${math.toBits(math.round(sigRun))} ${math.toBits(math.trunc(sigRun))} ${math.toBits(math.fract(sigRun))}"
print "fract ${math.toBits(math.fract(math.inf()))} ${math.toBits(math.fract(-math.inf()))} ${math.toBits(math.fract(minusOne / 0.0))}"
let posRun = math.fromBits(text.parseUint("9221120237041090561") || 0)
let negRun = math.fromBits(text.parseUint("18444492273895866370") || 0)
print "pow ${math.toBits(math.pow(posRun, negRun))} ${math.toBits(math.pow(negRun, posRun))} ${math.toBits(math.pow(math.fromBits(0x7FF8000000000005), math.fromBits(0xFFF8000000000006)))}"

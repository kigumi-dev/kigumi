-- src --
// TLS 1.3 PSK resumption and 0-RTT over loopback sockets. Every handshake is
// the module's own client and server; the store is shared across connections
// so a NewSessionTicket is really reusable, really single use for 0-RTT, and
// really refused once stale or over its early-data limit.
import hex from std/encoding/hex
import net from std/net
import task from std/task
import tls from std/net/tls
import sec from std/secret
import x509 from std/crypto/x509

const CA = ""
const SERVER = ""
const SERVER_KEY = "179f6244a3702a818aa6fefe5649fa5d4c7d2871bbe1a7aa982caee2874e30a9"

const NOW: Int = 1800000000000

fn secretOf(b: Bytes) -> sec.SecretBuffer {
    sec.SecretBuffer.fromBytes(b)
}

fn reveal(b: &sec.SecretBuffer) -> Bytes {
    unsafe { b.copy().declassify() }
}

fn revealOwned(b: sec.SecretBuffer) -> Bytes {
    unsafe { b.declassify() }
}

fn dec(text: String) -> Bytes {
    hex.decode(text).expect("hex")
}

fn deterministicRandom(n: usize) -> Bytes! {
    host.entropy().bytes(n)
}

fn anchors() -> Array[x509.Certificate] {
    Array.of((x509.parse(dec(CA)).expect("CA parses")).clone())
}

fn serverConfig(store: tls.TicketStore, now: Int, early: usize, lifetimeMillis: Int) -> tls.ServerConfig {
    let mut config = tls.ServerConfig.new(Array.of(dec(SERVER)), tls.ServerKey.EcP256(secretOf(dec(SERVER_KEY))), (k) => deterministicRandom(k))
    config.alpn = Array.of("http/1.1")
    config.nowMillis = now
    config.tickets = 1
    config.ticketLifetimeMillis = lifetimeMillis
    config.maxEarlyData = early
    config.maxEarlyDataAgeMillis = lifetimeMillis
    config.store = Some(store.clone())
    config
}

async fn serve(mut listener: net.Listener, config: tls.ServerConfig, expect: String) -> String {
    let pool = task.BlockingPool.new(1)
    let pending = match pool.run(() => listener.accept().unwrap()) {
        Ok(value) -> value
        Err(e) -> return "accept: ${e.message()}"
    }
    let conn = await pending
    let mut session = match await tls.Server.handshake(conn, config) {
        Ok(value) -> value
        Err(e) -> return "handshake: ${e.message()}"
    }
    let got = match await session.read(64) {
        Ok(value) -> value
        Err(e) -> {
            await session.close()
            return "read: ${e.message()}"
        }
    }
    let text = String.fromBytes(revealOwned(got)) || ""
    if text != expect {
        await session.close()
        return "request `${text}`"
    }
    match await session.write(&secretOf("pong".toBytes())) {
        Ok(_) -> {}
        Err(e) -> {
            await session.close()
            return "write: ${e.message()}"
        }
    }
    await session.close()
    "ok"
}

async fn connect(n: net.Net, port: Int, ticket: tls.SessionTicket?, early: Bytes) -> tls.Session! {
    let mut config = tls.Config.new("localhost", anchors(), (k) => deterministicRandom(k))
    config.nowMillis = NOW
    config.session = ticket
    config.earlyData = secretOf(early)
    let pool = task.BlockingPool.new(1)
    let conn = await pool.run(() => n.connect("127.0.0.1", port).unwrap()).unwrap()
    let session = (await tls.Client.connect(conn, config))?
    session
}

// One full handshake with a ticket, returning the ticket the client stored.
async fn bootstrap(n: net.Net, store: tls.TicketStore, early: usize, lifetime: Int) -> tls.SessionTicket! {
    let pool = task.BlockingPool.new(1)
    let listener = await pool.run(() => n.listen("127.0.0.1", 0).unwrap()).unwrap()
    let port = listener.port()
    let running = task.spawn(serve(listener, serverConfig(store, NOW, early, lifetime), "hello"))
    let mut session = (await connect(n, port, None, Bytes.zeros(0)))?
    (await session.write(&secretOf("hello".toBytes())))?
    _ = (await session.read(64))?
    let ticket = session.resumptionTicket()
    await session.close()
    let server = await running
    if server != "ok" {
        fail Fail { text: "bootstrap server: ${server}" }
    }
    match ticket {
        Some(value) -> value
        None -> fail Fail { text: "bootstrap produced no ticket" }
    }
}

type Fail = {
    text String
}

fn Fail.message(self) -> String {
    self.text
}

async fn resumptionCase(n: net.Net) -> String! {
    let store = tls.TicketStore.new()
    let ticket = (await bootstrap(n, store.clone(), 64, 60000))?
    let pool = task.BlockingPool.new(1)
    let listener = await pool.run(() => n.listen("127.0.0.1", 0).unwrap()).unwrap()
    let port = listener.port()
    let running = task.spawn(serve(listener, serverConfig(store, NOW, 64, 60000), "again"))
    let mut session = (await connect(n, port, Some(ticket), Bytes.zeros(0)))?
    let resumed = session.resumed()
    (await session.write(&secretOf("again".toBytes())))?
    let response = String.fromBytes(revealOwned((await session.read(64))?)) || ""
    await session.close()
    let server = await running
    "resume => ${resumed} ${response} ${server}"
}

async fn earlyCase(n: net.Net) -> String! {
    let store = tls.TicketStore.new()
    let ticket = (await bootstrap(n, store.clone(), 64, 60000))?
    let pool = task.BlockingPool.new(1)
    let listener = await pool.run(() => n.listen("127.0.0.1", 0).unwrap()).unwrap()
    let port = listener.port()
    let running = task.spawn(serve(listener, serverConfig(store.clone(), NOW, 64, 60000), "early hi"))
    let mut session = (await connect(n, port, Some(ticket.clone()), "early hi".toBytes()))?
    let accepted = session.earlyDataAccepted()
    let response = String.fromBytes(revealOwned((await session.read(64))?)) || ""
    await session.close()
    let first = await running
    // The same ticket again must be refused: 0-RTT is single use.
    let pool2 = task.BlockingPool.new(1)
    let listener2 = await pool2.run(() => n.listen("127.0.0.1", 0).unwrap()).unwrap()
    let port2 = listener2.port()
    let replaying = task.spawn(serve(listener2, serverConfig(store, NOW, 64, 60000), "later"))
    let replay = await connect(n, port2, Some(ticket), "later".toBytes())
    let clientRejected = replay is Err(_)
    let replayServer = await replaying
    "early => ${accepted} ${response} ${first}; replay-client ${clientRejected}; replay-server ${replayServer.contains("replayed")}"
}

async fn staleCase(n: net.Net) -> String! {
    let store = tls.TicketStore.new()
    let ticket = (await bootstrap(n, store.clone(), 0, 60000))?
    let pool = task.BlockingPool.new(1)
    let listener = await pool.run(() => n.listen("127.0.0.1", 0).unwrap()).unwrap()
    let port = listener.port()
    let running = task.spawn(serve(listener, serverConfig(store, NOW + 61000, 0, 60000), "stale"))
    let outcome = await connect(n, port, Some(ticket), Bytes.zeros(0))
    let rejected = outcome is Err(_)
    let server = await running
    "stale => client ${rejected}; server ${server.contains("expired")}"
}

async fn limitCase(n: net.Net) -> String! {
    let store = tls.TicketStore.new()
    let ticket = (await bootstrap(n, store.clone(), 8, 60000))?
    let tooBig = tls.SessionTicket {
        serverName: ticket.serverName
        alpn: ticket.alpn
        ticket: ticket.ticket
        psk: ticket.psk
        lifetimeMillis: ticket.lifetimeMillis
        issuedAtMillis: ticket.issuedAtMillis
        ageAdd: ticket.ageAdd
        maxEarlyData: 64
    }
    let pool = task.BlockingPool.new(1)
    let listener = await pool.run(() => n.listen("127.0.0.1", 0).unwrap()).unwrap()
    let port = listener.port()
    let running = task.spawn(serve(listener, serverConfig(store, NOW, 8, 60000), "too much"))
    let outcome = await connect(n, port, Some(tooBig), "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef".toBytes())
    let rejected = match outcome {
        Err(_) -> true
        Ok(value) -> {
            let mut session = value
            let after = await session.read(64)
            await session.close()
            after is Err(_)
        }
    }
    let server = await running
    "limit => client ${rejected}; server ${server.contains("exceeds")}"
}

fn binderChecks() -> Bool {
    let psk = Bytes.fill(0x11, 32)
    let pskSecret = secretOf(psk)
    let offer = tls.PskOffer {
        identity: "ticket".toBytes()
        obfuscatedAge: 0
        psk: pskSecret.copy()
        earlyData: false
    }
    let hello = match tls.clientHelloPsk(tls.x25519Group, Bytes.fill(0x22, 32), Bytes.zeros(0), Bytes.fill(0x33, 32), None, "", Array.of("http/1.1"), offer) {
        Ok(value) -> value
        Err(_) -> return false
    }
    let bindersAt = hello.len() - 39
    let binder = hello.slice(hello.len() - 32, hello.len()) || Bytes.zeros(0)
    let valid = match tls.verifyPskBinder(hello, bindersAt, &pskSecret, binder) {
        Ok(_) -> true
        Err(_) -> false
    }
    let mut bytes = Array.empty[u8]()
    let mut i: usize = 0
    for i < binder.len() {
        bytes.push(if i == 0 { binder[i] ^ 1 } else { binder[i] })
        i = i + 1
    }
    let tampered = Bytes.fromArray(&bytes)
    let rejected = match tls.verifyPskBinder(hello, bindersAt, &pskSecret, tampered) {
        Ok(_) -> false
        Err(_) -> true
    }
    let wrongPsk = match tls.verifyPskBinder(hello, bindersAt, &secretOf(Bytes.fill(0x44, 32)), binder) {
        Ok(_) -> false
        Err(_) -> true
    }
    valid && rejected && wrongPsk
}

async fn run() -> Void! {
    let n = host.net()
    let resumptionText = (await resumptionCase(n))?
    print resumptionText
    let earlyText = (await earlyCase(n))?
    print earlyText
    let staleText = (await staleCase(n))?
    print staleText
    let limitText = (await limitCase(n))?
    print limitText
    let malformed = match tls.parseNewSessionTicket(Bytes.zeros(3)) {
        Ok(_) -> false
        Err(_) -> true
    }
    print "malformed-ticket ${malformed} binder ${binderChecks()}"
}

task.currentThreadExecutor().runToCompletion(run())?
-- stdout --
resume => true pong ok
early => true pong ok; replay-client true; replay-server true
stale => client true; server true
limit => client true; server true
malformed-ticket true binder true

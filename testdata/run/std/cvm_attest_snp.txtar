-- src --
import hex from std/encoding/hex
import snp from std/cvm/snp
import attest from std/cvm/attest

fn withByte(raw: Bytes, at: usize, value: u8) -> Bytes {
    let mut buffer = ByteBuffer.tryNew(raw.len()).expect("byte buffer")
    buffer.copyFrom(0, raw, 0, raw.len())
    buffer.set(at, value)
    buffer.freeze()
}

fn acceptReport(digest: Bytes, signature: &snp.Signature) -> Result[Bool, snp.Error] {
    Ok(digest.len() == 48 && signature.r.len() == 72)
}

fn rejectReport(digest: Bytes, signature: &snp.Signature) -> Result[Bool, snp.Error] {
    let _ = digest
    let _ = signature
    Ok(false)
}

fn acceptKey(key: &snp.EcdsaPublicKey, digest: Bytes, signature: &snp.Signature) -> Result[Bool, snp.Error] {
    Ok(key.curve == 2 && digest.len() == 48 && signature.s.len() == 72)
}

fn rejectKey(key: &snp.EcdsaPublicKey, digest: Bytes, signature: &snp.Signature) -> Result[Bool, snp.Error] {
    let _ = key
    let _ = digest
    let _ = signature
    Ok(false)
}

fn show(name: String, result: Result[snp.Claims, attest.Error]) {
    match result {
        Ok(claims) -> print "${name}=ok v${claims.version} vmpl=${claims.vmpl} debug=${claims.debugAllowed} smt=${claims.smtAllowed}"
        Err(error) -> print "${name}=${error.message()}"
    }
}

fn main() -> Void! {
    let reportRaw = hex.decode("")?
    let blockRaw = hex.decode("303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f4b4947554d492d46414d494c592d30314b4947554d492d494d4147452d30303101000000070000000001020000000000")?
    let block2Raw = hex.decode("303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f4b4947554d492d46414d494c592d30314b4947554d492d494d4147452d30303101000000070000000000020000000000")?
    let authRaw = hex.decode("")?
    let report = snp.parseReport(reportRaw)?
    let evidence = attest.Evidence { report: reportRaw, idBlock: Some(blockRaw), idAuth: Some(authRaw) }
    let policy = attest.Policy {
        nonce: Some(report.reportData)
        measurement: Some(report.measurement)
        allowDebug: false
        allowSmt: false
        vmpl: Some(1)
        minimumTcb: Some(1)
        requireIdBlock: true
    }
    show("verify", attest.verify(&evidence, &policy, acceptReport, acceptKey))

    let strict = attest.Policy.strict(report.measurement)
    show("strict-no-id", attest.verify(&evidence, &strict, acceptReport, acceptKey))

    let wrongNonce = attest.Policy {
        nonce: Some(Bytes.zeros(64))
        measurement: Some(report.measurement)
        allowDebug: false
        allowSmt: false
        vmpl: Some(1)
        minimumTcb: None
        requireIdBlock: true
    }
    show("nonce", attest.verify(&evidence, &wrongNonce, acceptReport, acceptKey))
    let wrongMeasurement = attest.Policy {
        nonce: Some(report.reportData)
        measurement: Some(Bytes.zeros(48))
        allowDebug: false
        allowSmt: false
        vmpl: Some(1)
        minimumTcb: None
        requireIdBlock: true
    }
    show("measurement", attest.verify(&evidence, &wrongMeasurement, acceptReport, acceptKey))
    let wrongVmpl = attest.Policy {
        nonce: Some(report.reportData)
        measurement: Some(report.measurement)
        allowDebug: false
        allowSmt: false
        vmpl: Some(0)
        minimumTcb: None
        requireIdBlock: true
    }
    show("vmpl", attest.verify(&evidence, &wrongVmpl, acceptReport, acceptKey))
    let highTcb = attest.Policy {
        nonce: Some(report.reportData)
        measurement: Some(report.measurement)
        allowDebug: false
        allowSmt: false
        vmpl: Some(1)
        minimumTcb: Some(0xFFFFFFFFFFFFFFFF)
        requireIdBlock: true
    }
    show("tcb", attest.verify(&evidence, &highTcb, acceptReport, acceptKey))

    let policyNoId = attest.Policy {
        nonce: Some(report.reportData)
        measurement: Some(report.measurement)
        allowDebug: false
        allowSmt: false
        vmpl: Some(1)
        minimumTcb: None
        requireIdBlock: false
    }
    let debugRaw = withByte(reportRaw, 0x0A, 0x0A)
    let debugEvidence = attest.Evidence { report: debugRaw, idBlock: None, idAuth: None }
    show("debug", attest.verify(&debugEvidence, &policyNoId, acceptReport, acceptKey))
    let smtRaw = withByte(reportRaw, 0x0A, 0x03)
    let smtEvidence = attest.Evidence { report: smtRaw, idBlock: None, idAuth: None }
    show("smt", attest.verify(&smtEvidence, &policyNoId, acceptReport, acceptKey))

    show("report-forged", attest.verify(&evidence, &policy, rejectReport, acceptKey))
    show("id-forged", attest.verify(&evidence, &policy, acceptReport, rejectKey))

    let digestMismatch = attest.Evidence { report: withByte(reportRaw, 0xE0, 0xFF), idBlock: Some(blockRaw), idAuth: Some(authRaw) }
    show("digest", attest.verify(&digestMismatch, &policy, acceptReport, acceptKey))
    let policyMismatch = attest.Evidence { report: reportRaw, idBlock: Some(block2Raw), idAuth: Some(authRaw) }
    show("block-policy", attest.verify(&policyMismatch, &policy, acceptReport, acceptKey))
    let noAuth = attest.Evidence { report: reportRaw, idBlock: Some(blockRaw), idAuth: None }
    show("no-auth", attest.verify(&noAuth, &policy, acceptReport, acceptKey))
    let noId = attest.Evidence { report: reportRaw, idBlock: None, idAuth: None }
    show("no-id", attest.verify(&noId, &policy, acceptReport, acceptKey))
    let maskRaw = withByte(withByte(withByte(reportRaw, 0x48, 2), 0x2A0, 0), 0x2E8, 0)
    let maskEvidence = attest.Evidence { report: maskRaw, idBlock: Some(blockRaw), idAuth: Some(authRaw) }
    show("unsigned", attest.verify(&maskEvidence, &policy, acceptReport, acceptKey))

    match attest.verifyCertificateChain(Bytes.zeros(1), Bytes.zeros(1), 0) {
        Ok(_) -> print "chain=accepted"
        Err(error) -> print "chain=${error.message()}"
    }
    match attest.verifyCertificateChain(Bytes.zeros(0), Bytes.zeros(1), 0) {
        Ok(_) -> print "chain-empty=accepted"
        Err(error) -> print "chain-empty=${error.message()}"
    }
    match attest.verifyCertificateChain(b"x", b"y", -1) {
        Ok(_) -> print "chain-time=accepted"
        Err(error) -> print "chain-time=${error.message()}"
    }
}
-- stdout --
verify=ok v5 vmpl=1 debug=false smt=false
strict-no-id=ok v5 vmpl=1 debug=false smt=false
nonce=attest: policy: REPORT_DATA does not match the expected nonce
measurement=attest: policy: MEASUREMENT does not match
vmpl=attest: policy: VMPL 1 is not 0
tcb=attest: policy: CURRENT_TCB is below the required floor
debug=attest: policy: debugging is enabled
smt=attest: policy: SMT is enabled
report-forged=attest: snp: forged or inconsistent report signature
id-forged=attest: snp: forged or inconsistent ID block signature
digest=attest: forged ID key digest does not match the report
block-policy=attest: forged ID block policy does not match the report
no-auth=attest: policy: ID block authentication is missing
no-id=attest: policy: launch ID block evidence is required
unsigned=attest: snp: the report is not signed
chain=attest: unsupported: AMD SEV-SNP VCEK/VLEK certificate chains need ECDSA P-384 X.509, which std/crypto/x509 does not implement
chain-empty=attest: policy: certificate chain is empty
chain-time=attest: policy: negative verification time

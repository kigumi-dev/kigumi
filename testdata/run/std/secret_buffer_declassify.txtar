-- src --
import secret from std/secret

fn text(b: Bytes) -> String {
    match String.fromBytes(b) {
        Ok(s) -> s
        Err(_) -> "?"
    }
}

// declassify consumes the buffer, so its drop has run before each print.
let a = secret.SecretBuffer.fromString("secret")
let b = unsafe {
    a.declassify()
}
print "${b.len()} ${debug(&b.get(0))} ${debug(&b.get(5))} ${text(b)}"
let c = secret.SecretBuffer.fromString("token")
print text(unsafe {
    c.declassify()
})
-- stdout --
6 Some(115) Some(116) secret
token

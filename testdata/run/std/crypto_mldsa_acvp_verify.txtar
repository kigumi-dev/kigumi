-- src --
import mldsa from std/crypto/mldsa
import hex from std/encoding/hex

fn main() -> Void! {
    // NIST ACVP ML-DSA-65 sigVer tcId 31-35: modified z, modified hint,
    // one valid signature, a modified commitment and a modified message.
    let r31 = match mldsa.verify(hex.decode("")?, hex.decode("")?, hex.decode("E8EF3834FDFF882092EF48A8D7")?, hex.decode("")?) {
        Ok(v) -> v
        Err(_) -> false
    }
    print "sigver tc 31 ${r31}"
    let r32 = match mldsa.verify(hex.decode("")?, hex.decode("")?, hex.decode("")?, hex.decode("")?) {
        Ok(v) -> v
        Err(_) -> false
    }
    print "sigver tc 32 ${r32}"
    let r33 = match mldsa.verify(hex.decode("")?, hex.decode("")?, hex.decode("C66E079840FA0FD9FF877E2D2DD123D4DB0D49526510F680D3E1761DB72A0423A83B37F939CBE77DF33566EAED5A9C88E283E6CB83143FFE6740642878030F66716C88C95A0557C1D8CC67A40E5EC03809EF20C6907590310491FE918DC04A5ADA7548AE92A577034A77401345449066D1F1E8C25DE9DBB91B1B6FD108A13819E0ACE99EC4922AF1B17EB06C2EAB")?, hex.decode("")?) {
        Ok(v) -> v
        Err(_) -> false
    }
    print "sigver tc 33 ${r33}"
    let r34 = match mldsa.verify(hex.decode("")?, hex.decode("")?, hex.decode("6B38F739D3496E18D53AC47AC7E50437E3E54AB79009C64979945CE0D6E0DB4DD1C93C4907FE45B4238828F3D99D747B913FA80713FABCA782FF3719FD91A0FE2E9E183B6195768CED5DB24CB14848B0AE597276DE09EBE9059DDF7E8A3311D5D5D93C224E22D503B68711FEE4C145617EC24C0F6775D86AC0665E36992D13FE5C960DF6AAC673FA69DAECB674")?, hex.decode("")?) {
        Ok(v) -> v
        Err(_) -> false
    }
    print "sigver tc 34 ${r34}"
    let r35 = match mldsa.verify(hex.decode("")?, hex.decode("")?, hex.decode("")?, hex.decode("")?) {
        Ok(v) -> v
        Err(_) -> false
    }
    print "sigver tc 35 ${r35}"
}
-- stdout --
sigver tc 31 false
sigver tc 32 false
sigver tc 33 true
sigver tc 34 false
sigver tc 35 false

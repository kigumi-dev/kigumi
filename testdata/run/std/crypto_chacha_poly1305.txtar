-- src --
import poly from std/crypto/chacha20poly1305
import hex from std/encoding/hex
import secret from std/secret

fn showSecret(b: &secret.SecretBuffer) -> String {
    hex.encode(unsafe { b.copy().declassify() })
}

fn sec(b: Bytes) -> secret.SecretBuffer {
    secret.SecretBuffer.fromBytes(b)
}

fn dec(s: String) -> Bytes {
    hex.decode(s).expect("hex")
}

fn truth(c: secret.Choice) -> Bool {
    unsafe { c.declassify() }
}

// RFC 8439 §2.5.2: a 34-byte message over three 16-byte blocks
let key = dec("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b")
let secretKey = sec(key)
let message = b"Cryptographic Forum Research Group"
print "rfc-tag ${showSecret(&poly.sum(&secretKey, &sec(message)))}"

// Splitting the message across updates changes nothing
let mut mac = poly.Poly1305.new(&secretKey)
mac.update(&sec(dec("43727970746f6772617068696320466f")))
mac.update(&sec(dec("72756d2052657365617263682047726f7570")))
mac.update(&sec(Bytes.zeros(0)))
print "split ${showSecret(&mac.finish())}"

// An empty message takes no block, so the tag is s alone
print "empty ${showSecret(&poly.sum(&secretKey, &sec(Bytes.zeros(0))))}"

print "verify ${truth(poly.verify(&secretKey, &sec(message), dec("a8061dc1305136c6c22b8baf0c0127a9")))}"
print "reject ${truth(poly.verify(&secretKey, &sec(message), dec("a8061dc1305136c6c22b8baf0c0127a8")))}"
print "tag-size ${poly.tagSize}"

// A multi-block message with a different key
let key2 = sec(dec("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"))
let data = Bytes.fill(0x7f, 100)
print "multiblock ${showSecret(&poly.sum(&key2, &sec(data)))}"
let mut chunks = poly.Poly1305.new(&key2)
let c0 = data.slice(0, 33).expect("slice")
let c1 = data.slice(33, 67).expect("slice")
let c2 = data.slice(67, 100).expect("slice")
chunks.update(&sec(c0))
chunks.update(&sec(c1))
chunks.update(&sec(c2))
print "multiblock-split ${showSecret(&chunks.finish())}"
-- stdout --
rfc-tag a8061dc1305136c6c22b8baf0c0127a9
split a8061dc1305136c6c22b8baf0c0127a9
empty 0103808afb0db2fd4abff6af4149f51b
verify true
reject false
tag-size 16
multiblock b2bd99b40b5c8b7c91333dced0228f1d
multiblock-split b2bd99b40b5c8b7c91333dced0228f1d

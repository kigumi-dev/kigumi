responder 04d12dfb5289c8d4f81208b70270398c342296970a0bccb74c736fc7554494bf6356fbf3ca366cc23e8157854c13c58d6aac23f046ada30f8353e74f33039872ab
shared-ir d6840f6b42f6edafd13116e0e12565202fef8e9ece7dce03812464d04b9442de
shared-ri d6840f6b42f6edafd13116e0e12565202fef8e9ece7dce03812464d04b9442de
shared-negated dad0b65394221cf9b051e1feca5787d098dfe637fc90b9ef945d0c3772581180

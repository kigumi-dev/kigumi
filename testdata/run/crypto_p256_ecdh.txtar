-- src --
import hex from std/encoding/hex
import p256 from std/crypto/p256

fn show(b: Bytes) -> String {
    hex.encode(b)
}

fn main() -> Void! {
    // RFC 5903 section 8.1: the two Diffie-Hellman private keys and the
    // shared X coordinate they derive.
    let i = hex.decode("C88F01F510D9AC3F70A292DAA2316DE544E9AAB8AFE84049C62A9C57862D1433")?
    let r = hex.decode("C6EF9C5D78AE012A011164ACB397CE2088685D8F06BF9BE0B283AB46476BEE53")?
    let ipub = p256.publicKey(i)?
    let rpub = p256.publicKey(r)?
    print "initiator ${show(ipub)}"
    print "responder ${show(rpub)}"
    print "shared-ir ${show(p256.sharedSecret(i, rpub)?)}"
    print "shared-ri ${show(p256.sharedSecret(r, ipub)?)}"

    // n - 1 negates the peer point, so the X coordinate is unchanged.
    let nMinus1 = hex.decode("FFFFFFFF00000000FFFFFFFFFFFFFFFFBCE6FAADA7179E84F3B9CAC2FC632550")?
    print "shared-negated ${show(p256.sharedSecret(nMinus1, ipub)?)}"
}

-- src --
import secret from std/secret
import fmt from std/fmt
import map from std/map
import {Box} from std/alloc

// A private field of any type renders as <private>: field visibility, not a
// secret type name, decides what debug may show.
type Hidden = {
    hidden u32
    pub shown u32
}

type Holder = {
    pub label String
    key secret.SecretU32
    buf secret.SecretBuffer
}

let hidden = Hidden { hidden: 1234, shown: 1 }
print debug(&hidden)
print hidden.display()
let a = secret.SecretU32.classify(42)
print debug(&a)
let eq = a.ctEq(secret.SecretU32.classify(42))
print debug(&eq)
let buf = secret.SecretBuffer.fromString("hunter2")
print debug(&buf)
let holder = Holder { label: "h", key: a, buf: secret.SecretBuffer.fromString("pw") }
print debug(&holder)
let xs = Array.of[secret.SecretU8](secret.SecretU8.classify(1), secret.SecretU8.classify(2))
print debug(&xs)
let mut m = map.empty[String, secret.SecretU32]()
m.set("k", a)
print debug(&m)
let boxed = Box.new(secret.SecretU32.classify(7))
print debug(&boxed)
let pair = (secret.SecretU16.classify(3), 1)
print debug(&pair)
let maybe: Option[secret.SecretU8] = Some(secret.SecretU8.classify(9))
print debug(&maybe)
let idx = secret.SecretIndex[4].from(secret.SecretU32.classify(2))
print debug(&idx)
-- stdout --
Hidden { hidden: <private>, shown: 1 }
Hidden { hidden: <private>, shown: 1 }
SecretU32 { v: <private> }
Choice { m: <private> }
SecretBuffer { units: <private> }
Holder { label: h, key: <private>, buf: <private> }
[SecretU8 { v: <private> }, SecretU8 { v: <private> }]
Map { k: SecretU32 { v: <private> } }
SecretU32 { v: <private> }
(SecretU16 { v: <private> }, 1)
Some(SecretU8 { v: <private> })
SecretIndex { idx: <private> }
-- secret-san --
panic: SecretSan: secret value reaches host I/O (print) in main

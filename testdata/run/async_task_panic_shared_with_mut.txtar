-- src --
import task from std/task
import {Shared} from std/alloc

async fn boom(s: Shared[Int]) -> Int {
    s.withMut((v: &mut Int) => {
        v = 7
        if v == 7 {
            let _: Void = None.expect("inside")
        }
        0
    })
}

async fn sib(s: Shared[Int]) -> Int {
    s.withMut((v: &mut Int) => { v = v + 1 })
    s.get()
}

async fn root(s: Shared[Int]) -> Int {
    let a = task.spawn(boom(s.clone()))
    let b = task.spawn(sib(s.clone()))
    let x = await b
    print "sibling ${x}"
    await a
}

let ex = task.currentThreadExecutor()
print "total ${ex.runToCompletion(root(Shared.new(1)))}"
-- stdout --
sibling 8
-- stderr --
panic: inside
-- exit --
2

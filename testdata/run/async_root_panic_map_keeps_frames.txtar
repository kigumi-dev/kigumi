-- src --
import task from std/task

type Res = resource {
    pub n Int
}

fn Res.drop(move self) {
    print "drop res ${self.n}"
}

fn nothing() -> Int? {
    None
}

fn mk(x: &Int) -> Res {
    if x == 3 {
        let local = Res { n: 900 }
        let _z = nothing().expect("mid-map")
    }
    Res { n: x + 100 }
}

// The root task keeps its own frames, so only what the primitive was building is dropped.
async fn mapBoom(a: Array[Int]) -> Int {
    let local = Res { n: 800 }
    let r = a.map((x: &Int) => mk(x))
    0
}

let ex = task.currentThreadExecutor()
print "total ${ex.runToCompletion(mapBoom(Array.of(1, 2, 3, 4, 5)))}"
-- stdout --
drop res 102
drop res 101
-- stderr --
panic: mid-map
-- exit --
2

-- src --
fn blen['a](x: &'a Array[Int]) -> usize { x.len() }
pub interface Sized2 { fn size(self) -> usize }
pub type R2[F: Fn[fn(&Array[Int]) -> usize] + Copy] = { pub cb F }
pub fn R2[F].size(self) -> usize {
    let xs = Array.of(1, 2, 3)
    (self.cb)(&xs)
}
pub type Hn = { pub n Int }
fn Hn.measure[R: Sized2](self, r: R) -> usize { r.size() }
fn Hn.use2[R: Sized2](self, a: R, b: R) -> usize { a.size() + b.size() }
fn twoCalls['a](hn: Hn, x: &'a Array[Int]) -> usize {
    let ra: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
    let rb: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
    let g = hn.measure
    g(ra) + g(rb)
}
fn pair['a](hn: Hn, x: &'a Array[Int]) -> usize {
    let ra: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
    let rb: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
    let g = hn.use2
    g(ra, rb)
}
fn annotated['a](hn: Hn, x: &'a Array[Int]) -> usize {
    let r: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
    let g: fn(R2[fn(&'a Array[Int]) -> usize]) -> usize = hn.measure
    g(r)
}
let hn = Hn { n: 1 }
let xs = Array.of(9)
print "${twoCalls(hn, &xs)} ${pair(hn, &xs)} ${annotated(hn, &xs)}"
-- stdout --
6 6 3

-- src --
type Handle = resource {
    pub mut id Int
}

fn Handle.drop(move self) {}

fn Handle.close(move self) {
    print "close ${self.id}"
}

fn Handle.peek(self) -> Int {
    self.id
}

type Pack = {
    pub inner Handle
    pub other Handle
}

type Bag = {
    pub opt Handle?
    pub pack Pack?
    pub other Handle
}

fn mkh(n: Int) -> Handle {
    Handle { id: n }
}

fn mkBag(n: Int) -> Bag {
    Bag { opt: Some(mkh(n)), pack: Some(Pack { inner: mkh(n + 1), other: mkh(n + 2) }), other: mkh(n + 3) }
}

fn payloadOnce() {
    let b = mkBag(10)
    match b.opt {
        Some(h) -> h.close()
        None -> {}
    }
    b.other.close()
}

fn payloadPerIteration() {
    for i in 0..2 {
        let b = mkBag(20 + 10 * i)
        match b.opt {
            Some(h) -> h.close()
            None -> {}
        }
        b.other.close()
    }
}

fn payloadReference() {
    let b = mkBag(50)
    for i in 0..2 {
        match &b.opt {
            Some(h) -> print "peek ${h.peek()}"
            None -> {}
        }
    }
    b.other.close()
}

fn payloadNested() {
    let b = mkBag(60)
    match b.pack {
        Some(Pack { other, inner: _ }) -> other.close()
        None -> {}
    }
    b.other.close()
}

fn payloadGuarded() {
    let b = mkBag(70)
    match b.opt {
        Some(h) if h.peek() > 100 -> h.close()
        Some(h) -> h.close()
        None -> {}
    }
    b.other.close()
}

type Slot = {
    pub mut opt Handle?
    pub mut other Handle
}

fn mkSlot(n: Int) -> Slot {
    Slot { opt: Some(mkh(n)), other: mkh(n + 1) }
}

fn takeAndRefill() {
    let mut b = mkSlot(80)
    for i in 0..3 {
        match b.opt {
            Some(h) -> {
                h.close()
                b.opt = None
            }
            None -> print "empty ${i}"
        }
    }
    b.other.close()
}

fn ifLetTakeAndRefill() {
    let mut b = mkSlot(90)
    for i in 0..3 {
        if let Some(h) = b.opt {
            h.close()
            b.opt = None
        }
    }
    b.other.close()
}

fn putBack() {
    let mut b = mkSlot(100)
    for i in 0..2 {
        match b.opt {
            Some(h) -> {
                b.opt = Some(h)
            }
            None -> {}
        }
    }
    b.opt = None
    b.other.close()
}

fn guardedTakeAndRefill() {
    let mut b = mkSlot(110)
    for i in 0..2 {
        match b.opt {
            Some(h) if h.peek() > 0 -> {
                h.close()
                b.opt = None
            }
            _ -> print "kept ${i}"
        }
    }
    b.other.close()
}

fn guardedPerIteration() {
    for i in 0..2 {
        let b = mkSlot(120 + 10 * i)
        match b.opt {
            Some(h) if h.peek() > 125 -> h.close()
            Some(h) -> print "skipped ${h.peek()}"
            None -> {}
        }
        b.other.close()
    }
}

type Slot1 = {
    pub mut opt Handle?
}

fn isTakeAndClear() {
    let mut o = Some(mkh(400))
    if o is Some(h) {
        h.close()
        o = None
    }
    print "mid"
    if o is Some(h) {
        h.close()
    }
}

fn isTakeAndClearInLoop() {
    let mut o = Some(mkh(410))
    for i in 0..3 {
        if o is Some(h) {
            h.close()
            o = None
        }
        if i == 1 {
            o = Some(mkh(411))
        }
    }
}

fn isTakeAndClearField() {
    let mut g = Slot1 { opt: Some(mkh(420)) }
    for i in 0..3 {
        if g.opt is Some(h) {
            h.close()
            g.opt = None
        }
        if i == 1 {
            g.opt = Some(mkh(421))
        }
    }
}

payloadOnce()
payloadPerIteration()
payloadReference()
payloadNested()
payloadGuarded()
takeAndRefill()
ifLetTakeAndRefill()
putBack()
guardedTakeAndRefill()
guardedPerIteration()
isTakeAndClear()
isTakeAndClearInLoop()
isTakeAndClearField()

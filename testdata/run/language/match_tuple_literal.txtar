-- src --
fn pick(n: Int) -> Int {
    match (n, 2) {
        (1, y) -> y
        (_, 3) -> 30
        _ -> 0
    }
}

print "${pick(1)} ${pick(5)}"
match (1, 2) {
    (1, y) -> print "literal ${y}"
    _ -> print "other"
}
if (3, 4.5) is (3, f) {
    print "is ${f}"
}
let r = match (1, "a") {
    (2, _) -> 0
    (1, "a") -> 7
    _ -> 1
}
print "${r}"
fn tk(x: u8) -> u8 { x }
fn tk2(x: (u8, u16)) -> Int { 1 }
fn lete() -> Int {
    let Some(3) = Some(3) else { return 0 }
    1
}
let sized: u8 = match (1, 2) {
    (a, b) -> a
}
let viaCall = match (1, 2) {
    (p, q) -> tk(p) + 1
}
let tupled = match (1, 2) {
    t -> tk2(t)
}
let ifis = if (1, 2) is (p, q) { tk(p) } else { 0 }
let somed: u8 = match Some(3) {
    Some(n) -> n
    None -> 0
}
print "${sized} ${viaCall} ${tupled} ${ifis} ${somed} ${lete()}"
-- stdout --
2 0
literal 2
is 4.5
7
1 2 1 1 3 1

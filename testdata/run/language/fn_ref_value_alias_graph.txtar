-- src --
fn blen['a](x: &'a Array[Int]) -> usize { x.len() }
pub interface Sized2 { fn size(self) -> usize }
pub type R2[F: Fn[fn(&Array[Int]) -> usize] + Copy] = { pub cb F }
pub fn R2[F].size(self) -> usize {
    let xs = Array.of(1, 2, 3)
    (self.cb)(&xs)
}
pub type Hn = { pub n Int }
fn Hn.measure[R: Sized2](self, r: R) -> usize { r.size() }
fn diamond['a](hn: Hn, xs: &'a Array[Int]) -> usize {
    let ra: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
    let a = hn.measure
    let b = a
    let c = a
    let mut d = b
    d = c
    d(ra)
}
fn cycle['a](hn: Hn, xs: &'a Array[Int]) -> usize {
    let ra: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
    let mut a = hn.measure
    let mut b = a
    a = b
    a(ra)
}
fn selfAlias['a](hn: Hn, xs: &'a Array[Int]) -> usize {
    let ra: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
    let mut g = hn.measure
    g = g
    g(ra)
}
let hn = Hn { n: 1 }
let xs = Array.of(9)
print "${diamond(hn, &xs)} ${cycle(hn, &xs)} ${selfAlias(hn, &xs)}"
-- stdout --
3 3 3

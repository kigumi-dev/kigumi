-- src --
import math from std/math

print "${5.5 % 2.0}"
let mut c: Float = -5.5
c %= 2.0
print "${c}"
print "${1e300 % 7.0}"
print "${1e308 % 3.0}"
print "${math.fmod(5.5, -2.0)}"
let small: f32 = 1e20
let seven: f32 = 7.0
print "${small % seven}"
print "${(1e30) % seven}"

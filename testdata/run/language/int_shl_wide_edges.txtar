-- src --
fn shl64(x: i64, n: usize) -> i64 { x << n }
fn shlU64(x: u64, n: usize) -> u64 { x << n }
fn shl128(x: i128, n: usize) -> i128 { x << n }
fn shlU128(x: u128, n: usize) -> u128 { x << n }

const NEG1: i64 = -1
const ONEU: u64 = 1
const MinI64 = NEG1 << 63
const TopU64 = ONEU << 63

print "${shl64(-1, 63)} ${shl64(-3, 61)} ${shl64(3, 61)} ${MinI64}"
print "${shlU64(1, 63)} ${shlU64(5, 61)} ${TopU64}"
print "${shl128(-1, 127)} ${shl128(1, 126)}"
print "${shlU128(1, 127)} ${shlU128(3, 126)}"
let w: u64 = 3
print "${w.wrappingShiftLeft(63)}"

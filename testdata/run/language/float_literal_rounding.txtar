-- src --
const A: f32 = 3.4028235677973366e38
const B: f32 = 1.000000059604644775390626
const K: Bool = B == 1.0000001

let a: f32 = 3.4028235677973366e38
let b: f32 = 1.000000059604644775390626
print "const ${A} ${B} ${K}"
print "rt ${a} ${b} ${b == 1.0000001}"
-- stdout --
const 3.4028235e+38 1.0000001 true
rt 3.4028235e+38 1.0000001 true

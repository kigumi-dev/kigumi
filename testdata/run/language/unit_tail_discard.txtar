-- src --
fn mi() -> Int { 3 }

fn tailCall() {
  mi()
}

fn tailArith() {
  1 + 2
}

fn tailIf(c: Bool) {
  if c { mi() } else { mi() }
}

fn tailLocal(n: Int) {
  n
}

fn tailMatch(o: Int?) {
  match o {
    Some(v) -> v
    None -> 0
  }
}

fn tailLambda() -> Int {
  let f: fn() -> Void = () => { mi() }
  f()
  7
}

fn main() -> Void! {
  tailCall()
  tailArith()
  tailIf(true)
  tailLocal(4)
  tailMatch(Some(5))
  let u: Void = { mi() }
  print "ok ${tailLambda()}"
}
-- stdout --
ok 7

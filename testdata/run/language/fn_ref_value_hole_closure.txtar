-- src --
fn blen['a](x: &'a Array[Int]) -> usize { x.len() }
pub interface Sized2 { fn size(self) -> usize }
pub type R2[F: Fn[fn(&Array[Int]) -> usize] + Copy] = { pub cb F }
pub fn R2[F].size(self) -> usize {
    let xs = Array.of(1, 2, 3)
    (self.cb)(&xs)
}
pub type Hn = { pub n Int }
fn Hn.measure[R: Sized2](self, r: R) -> usize { r.size() }
fn Hn.measure2[R: Sized2](self, n: Int, r: R) -> usize { r.size() }
fn holeFirst['a](hn: Hn, xs: &'a Array[Int]) -> usize {
    let ra: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
    let g = hn.measure2
    1 |> g(_, ra)
}
fn holeLast['a](hn: Hn, xs: &'a Array[Int]) -> usize {
    let ra: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
    let g = hn.measure2
    ra |> g(1, _)
}
fn inPlace['a](hn: Hn, xs: &'a Array[Int]) -> usize {
    let ra: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
    (hn.measure)(ra)
}
fn inClosure['a](hn: Hn, xs: &'a Array[Int]) -> usize {
    let cl = (n: Int) => {
        let ra: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
        let f = hn.measure
        f(ra)
    }
    cl(1)
}
fn inClosureInPlace['a](hn: Hn, xs: &'a Array[Int]) -> usize {
    let cl = (n: Int) => {
        let ra: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
        (hn.measure)(ra)
    }
    cl(1)
}
fn outerHolder['a](hn: Hn, xs: &'a Array[Int]) -> usize {
    let f = hn.measure
    let cl = (n: Int) => {
        let ra: R2[fn(&'a Array[Int]) -> usize] = R2 { cb: blen }
        f(ra)
    }
    cl(1)
}
let hn = Hn { n: 1 }
let xs = Array.of(9)
print "${holeFirst(hn, &xs)} ${holeLast(hn, &xs)} ${inPlace(hn, &xs)} ${inClosure(hn, &xs)} ${inClosureInPlace(hn, &xs)} ${outerHolder(hn, &xs)}"
-- stdout --
3 3 3 3 3 3

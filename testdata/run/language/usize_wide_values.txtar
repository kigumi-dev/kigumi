-- src --
let big: u64 = 4294967312
let n = big.toUsize()
print "${n}"
print "${n + 1}"
let m: usize = 4294967296
print "${m} ${m * 2}"
let i: isize = -4294967297
print "${i} ${i - 1}"
print "${(n.toU64() << 1)}"
-- stdout --
4294967312
4294967313
4294967296 8589934592
-4294967297 -4294967298
8589934624

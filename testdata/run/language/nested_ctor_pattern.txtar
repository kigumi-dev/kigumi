-- src --
type R = { pub a Int, pub b Int? }

fn m1(x: (Int, Int?)) -> Int {
  match x {
    (a, Some(r)) -> a + r
    (a, None) -> a
  }
}

fn m2(x: R) -> Int {
  match x {
    R { b: Some(v), a } -> a + v
    R { a } -> a
  }
}

fn m3(x: (Int?, Int)) -> Int {
  match x {
    (Some(h), _) -> h
    _ -> -1
  }
}

fn m4(x: (Int, Int?)) -> Int {
  let (a, Some(b)) = x else { return -5 }
  a + b
}

fn m5(x: (Int, Int?)) -> Int {
  if x is (a, Some(r)) {
    return a * r
  }
  0
}


type Shape = Circle(r: Int) | Square(w: Int) | Dot

type Pair = { pub tag Int, pub shape Shape? }

type Msg = Move(dx: Int, to: (Int, Int?)) | Quit

fn area(s: Shape) -> Int {
  match s {
    Circle(r) -> r * 3
    Square(w) -> w * w
    Dot -> 0
  }
}

fn n1(x: (Int, Result[Int, String])) -> String {
  match x {
    (a, Ok(v)) -> "ok ${a + v}"
    (a, Err(e)) -> "err ${a} ${e}"
  }
}

fn n2(x: (Shape?, Int)) -> Int {
  match x {
    (Some(Circle(r)), k) -> r + k
    (Some(Square(w)), _) -> w
    (Some(Dot), k) -> k
    (None, _) -> -1
  }
}

fn n3(p: Pair) -> Int {
  match p {
    Pair { tag, shape: Some(s) } -> tag + area(s)
    Pair { tag, shape: None } -> tag
  }
}

fn n4(x: ((Int, Int?), Int?)) -> Int {
  match x {
    ((a, Some(b)), Some(c)) -> a + b + c
    ((a, None), Some(c)) -> a + c
    ((a, Some(b)), None) -> a + b
    ((a, None), None) -> a
  }
}

fn n5(m: Msg) -> Int {
  match m {
    Move { dx, to: (a, Some(b)) } -> dx + a + b
    Move { dx, to: (a, None) } -> dx + a
    Quit -> 0
  }
}

fn n6(x: (Int?, Int?)) -> Int {
  match x {
    (Some(a), Some(b)) -> a * b
    (Some(a), _) -> a
    (_, Some(b)) -> b
    _ -> 0
  }
}

fn n7(x: (Int, Int?)) -> Int {
  match x {
    (a, Some(b)) if b > 5 -> a + b
    (a, Some(_)) -> a
    (a, None) -> -a
  }
}

fn n8(x: Array[(Int, Int?)]) -> Int {
  let mut t = 0
  for e in x {
    if e is (a, Some(r)) {
      t = t + a * r
    }
  }
  t
}

fn main() -> Void! {
  print "${m1((1, Some(2)))} ${m1((1, None))}"
  print "${m2(R { a: 1, b: Some(5) })} ${m2(R { a: 1, b: None })}"
  print "${m3((Some(4), 1))} ${m3((None, 1))}"
  print "${m4((1, Some(2)))} ${m4((1, None))}"
  print "${m5((3, Some(2)))} ${m5((1, None))}"
  print n1((1, Ok(2)))
  print n1((1, Err("boom")))
  print "${n2((Some(Circle(2)), 5))} ${n2((Some(Square(3)), 5))} ${n2((Some(Dot), 5))} ${n2((None, 5))}"
  print "${n3(Pair { tag: 1, shape: Some(Square(2)) })} ${n3(Pair { tag: 1, shape: None })}"
  print "${n4(((1, Some(2)), Some(3)))} ${n4(((1, None), Some(3)))} ${n4(((1, Some(2)), None))} ${n4(((1, None), None))}"
  print "${n5(Move(1, (2, Some(3))))} ${n5(Move(1, (2, None)))} ${n5(Quit)}"
  print "${n6((Some(2), Some(3)))} ${n6((Some(2), None))} ${n6((None, Some(3)))} ${n6((None, None))}"
  print "${n7((1, Some(9)))} ${n7((1, Some(2)))} ${n7((1, None))}"
  print "${n8(Array.of((1, Some(2)), (3, None), (4, Some(5))))}"
}
-- stdout --
3 1
6 1
4 -1
3 -5
6 0
ok 3
err 1 boom
7 3 5 -1
5 1
6 4 3 1
6 3 0
6 2 3 0
10 1 -1
22

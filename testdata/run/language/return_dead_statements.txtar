-- src --
fn afterReturn() -> Int {
    return 1
    let x = 2
    x
}

fn inBranch(c: Bool) -> Int {
    if c {
        return 1
        let y = 5
        print "${y}"
    }
    for i in 0..2 { print "loop ${i}" }
    3
}

fn inArm(c: Int) -> Int {
    match c {
        1 -> {
            return 1
            defer print "deferred"
            for i in 0..2 { print "arm ${i}" }
            0
        }
        _ -> 2
    }
}

fn inClosure() -> Int {
    let g = () => {
        return 4
        let z = 1
        z
    }
    g()
}

fn endsInLoop() -> Int {
    return 9
    defer print "never"
    for i in 0..2 { print "tail ${i}" }
}

print "${afterReturn()} ${inBranch(true)} ${inBranch(false)}"
print "${inArm(1)} ${inArm(2)} ${inClosure()} ${endsInLoop()}"
-- stdout --
loop 0
loop 1
1 1 3
1 2 4 9

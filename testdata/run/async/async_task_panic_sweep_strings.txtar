-- src --
import task from std/task

type Res = resource {
    pub id Int
}

fn Res.drop(move self) {
    print "drop ${self.id}"
}

type Pair = {
    pub a Res
    pub b Res
}

fn eat(r: Res) {
    print "eat ${r.id}"
}

async fn tick() -> Int {
    1
}

// The only task that panics, so nothing cancels it before it reaches its panic.
async fn strings(n: Int) -> Int {
    let s = "value ${n}"
    let arr = Array.of[Int](n, n + 1)
    let _ = await tick()
    let r = Res { id: 50 }
    None.expect("strings ${s} ${arr.len()}")
}

async fn sentinel() -> Int {
    9
}

async fn root() -> Int {
    let a = task.spawn(strings(5))
    let s = task.spawn(sentinel())
    await s
}

let ex = task.currentThreadExecutor()
print "total ${ex.runToCompletion(root())}"
-- stdout --
drop 50
-- stderr --
panic: strings value 5 2
-- exit --
2

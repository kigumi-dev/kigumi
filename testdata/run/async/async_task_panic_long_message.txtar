-- src --
import task from std/task

// A contained panic keeps its whole text, however long.
async fn boom() -> Int {
    None.expect("")
}

async fn root() -> Int {
    let t = task.spawn(boom())
    await t
}

let ex = task.currentThreadExecutor()
print "total ${ex.runToCompletion(root())}"
-- stdout --
-- stderr --
panic: 
-- exit --
2

-- src --
import task from std/task

type Counter = {
    n Int
}

async fn Counter.bump(move self, by: Int) -> Int {
    print "bump ${self.n} by ${by}"
    self.n + by
}

async fn root() -> Int {
    let a = Counter { n: 10 }
    let b = Counter { n: 100 }
    let pending = a.bump(5)
    print "created"
    let t = task.spawn(b.bump(1))
    let x = await pending
    let y = await t
    print "${x} ${y}"
    x + y
}

let ex = task.currentThreadExecutor()
print "sum ${ex.runToCompletion(root())}"
-- stdout --
created
bump 10 by 5
bump 100 by 1
15 101
sum 116

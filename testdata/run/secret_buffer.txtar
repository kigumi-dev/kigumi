-- src --
import secret from std/secret

let a = secret.SecretBuffer.fromString("secret")
let b = secret.SecretBuffer.fromString("secret")
let c = secret.SecretBuffer.fromString("other")
print "${a.len()} ${(unsafe { a.ctEq(&b).declassify() })} ${(unsafe { a.ctEq(&c).declassify() })}"
print "${(unsafe { a.declassify().len() })}"
-- stdout --
6 true false
6

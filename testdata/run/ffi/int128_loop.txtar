-- src --
let mul: u128 = 47026247687942121848144207491837523525
let inc: u128 = 117397592171526113268558934119004209487
let mut acc: u128 = 12345
let mut i = 0
for i < 3000 {
    acc = acc.wrappingMul(mul).wrappingAdd(inc)
    i = i + 1
}
print "${acc}"
let k: u128 = 123456789012345678901234567890
let mut sum: u128 = 0
let mut j: u128 = 1
for j <= 2000 {
    sum = sum + j * j * k
    j = j + 1
}
print "${sum}"
let mut f: u128 = 1
let top: u128 = 35
for n in 2..top {
    f = f * n
}
print "${f}"
let mut neg: i128 = -1
let mut steps = 0
for steps < 120 {
    neg = neg * 2
    steps = steps + 1
}
print "${neg}"
let lo: u128 = 340282366920938463463374607431768211450
let mut cnt = 0
for v in lo..=340282366920938463463374607431768211455 {
    cnt = cnt + 1
    print "range ${v}"
}
print "${cnt}"

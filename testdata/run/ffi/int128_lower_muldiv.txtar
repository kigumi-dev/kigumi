-- src --
fn ud(a: u128, b: u128) -> String {
    "${a / b} ${a % b}"
}

fn sd(a: i128, b: i128) -> String {
    "${a / b} ${a % b}"
}

fn um(a: u128, b: u128) -> String {
    "${a * b} ${a.wrappingMul(b)}"
}

fn sm(a: i128, b: i128) -> String {
    "${a * b} ${a.wrappingMul(b)}"
}

fn wm(a: i128, b: i128) -> i128 {
    a.wrappingMul(b)
}

fn wum(a: u128, b: u128) -> u128 {
    a.wrappingMul(b)
}


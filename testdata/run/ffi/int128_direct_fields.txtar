copy true true
mixed true -170141183460469231731687303715884105728 z 1.5 340282366920938463463374607431768211455 255
wrap 1000000000000000000000 -1000000000000000000000 1 2000000000000000000000
shapes 0 9 2 -170141183460469231731687303715884105723

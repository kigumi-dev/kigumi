-- src --
fn show(xs: &Array[Float]) {
    let mut out = ""
    for x in xs { out = "${out}${x} " }
    print out
}

fn forward(f: fn(Float) -> Bool, x: Float) -> Bool { f(x) }

fn main() -> Void! {
    let ints = Array.of(-9223372036854775807, -1500, 0, 7, 1023, 1024, 4000000000)
    show(&ints.map((x: &Int) => x.toFloat()))
    show(&ints.map((x: &Int) => x.toFloat() * 0.5))
    let bytes: Array[u8] = Array.of(0, 1, 200, 255)
    show(&bytes.map((x: &u8) => x.toFloat() + 0.25))
    let wide: Array[u64] = Array.of(0, 9223372036854775807, 9223372036854775808, 18446744073709551615)
    show(&wide.map((x: &u64) => x.toFloat()))
    let small: Array[i8] = Array.of(-128, -1, 127)
    show(&small.map((x: &i8) => x.toFloat()))
    let pos = Array.fill(3000, 3).map((x: &Int) => forward((y: Float) => y > 2999.5, x.toFloat()))
    print "${pos.len()} ${pos[0]}"
}

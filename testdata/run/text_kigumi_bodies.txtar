-- src --
import array from std/array
import text from std/text

fn show(xs: &Array[String]) -> String {
    "[${array.join(xs, "|")}] ${xs.len()}"
}

fn idx(r: usize?) -> String {
    match r {
        Some(i) -> "${i}"
        None -> "none"
    }
}

let hay = "abaabaabbabaabaab aaaa abcabcabd ababababab éxé日本語日本"
let needles = Array.of("", "a", "ab", "aab", "abaab", "aaaa", "aaaaa", "abcabd", "ababab", "bab", "z", "日本", "語日", "é", "xé日", "ab ", hay, "${hay}x", "baab", "abba")
for nd in needles {
    let b = hay.toBytes()
    let nb = nd.toBytes()
    print "${nd.len()}: contains=${hay.contains(nd)} index=${idx(b.indexOf(nb))} last=${idx(b.lastIndexOf(nb))} find=${idx(text.find(hay, nd))} rfind=${idx(text.rfind(hay, nd))}"
}
let periodic = "aaaaaaaaab"
for nd in Array.of("aab", "aaab", "aaaaaaaaab", "aaaaaaaaaab", "ab", "b", "ba") {
    print "p ${nd}: ${idx(periodic.toBytes().indexOf(nd.toBytes()))} ${idx(periodic.toBytes().lastIndexOf(nd.toBytes()))} ${periodic.contains(nd)}"
}
print "bytes ${idx(Bytes.fill(7, 5).indexOf(Bytes.fill(7, 2)))} ${idx(Bytes.fill(7, 5).lastIndexOf(Bytes.fill(7, 2)))} ${idx(Bytes.zeros(0).indexOf(Bytes.zeros(0)))} ${idx(Bytes.zeros(0).lastIndexOf(Bytes.zeros(1)))}"

for s in Array.of("", " ", "  x  ", "\t\r\nhé\n ", "a b", "日本 ") {
    print "trim <${s.trim()}> ${s.trim().len()}"
}
for sep in Array.of(",", ", ", "", "x", ",,", "日") {
    print "split ${sep}: ${show(&"a,,b, c,日,,".split(sep))}"
}
for s in Array.of("", "\n", "\n\n", "a", "a\r\n", "a\r\nb\n\r\n", "\r", "x\n\ny") {
    print "lines ${show(&text.lines(s))}"
}
print "graphemes ${show(&text.graphemes("aé日𝄞b"))} ${show(&text.graphemes(""))}"
print "case ${"Hello, Wörld! zAZ@[`{".toUpper()} ${"Hello, Wörld! zAZ@[`{".toLower()} <${"".toUpper()}>"
for c in Array.of(Array.of("aaaa", "aa", "b"), Array.of("abcabc", "abc", ""), Array.of("日本日本", "日", "x"), Array.of("abc", "abcd", "z"), Array.of("aXbXc", "X", "XYZ"), Array.of("", "a", "b"), Array.of("abc", "", "q")) {
    let s = c.get(0) || ""
    let o = c.get(1) || ""
    let n = c.get(2) || ""
    print "replace ${s}/${o}/${n}: <${text.replace(s, o, n)}>"
}
print "prefix <${text.trimPrefix("abc", "abc")}> <${text.trimPrefix("abc", "abcd")}> <${text.trimPrefix("日本", "日")}> <${text.trimPrefix("abc", "b")}>"
print "suffix <${text.trimSuffix("abc", "abc")}> <${text.trimSuffix("abc", "zabc")}> <${text.trimSuffix("日本", "本")}> <${text.trimSuffix("abc", "")}>"
print "concat <${"".concat("")}> <${"é".concat("日")}> <${"ab".repeat(3)}> <${"x".repeat(0)}>"
print "bconcat ${Bytes.zeros(2).concat(Bytes.fill(255, 3)).len()} ${Bytes.fill(255, 3).concat(Bytes.zeros(0)).get(2) || 0} ${Bytes.fill(9, 0).len()} ${Bytes.fill(200, 4).get(3) || 0}"
print "join <${array.join(&Array.of("", "", ""), ",")}> <${array.join(&Array.of("日", "本"), "")}> <${array.join(&Array.empty[String](), "x")}>"
let mut sb = text.StringBuilder.new()
sb.push("héllo")
sb.push("")
sb.pushByte(32)
_ = sb.tryPush("日本")
_ = sb.tryPushByte(33)
print "builder ${sb.len()} <${sb.freeze() || "bad"}>"

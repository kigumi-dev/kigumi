-- src --
fn pick(c: Bool, y: String?) -> Int {
    if c { 1 } else if y is Some(b) { return 5 } else { return 0 }
}

fn pickLen(c: Bool, y: String?) -> Int {
    if c { 1 } else if y is Some(b) { return b.len().toInt().unwrap() } else { return 0 }
}

print "${pick(true, None)} ${pick(false, Some("abc"))} ${pick(false, None)}"
print "${pickLen(true, None)} ${pickLen(false, Some("abc"))} ${pickLen(false, None)}"
-- stdout --
1 5 0
1 3 0

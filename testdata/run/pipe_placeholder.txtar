-- src --
import test from std/test

fn sub(a: Int, b: Int) -> Int { a - b }

fn mk(label: String, n: Int) -> Int {
    print "mk ${label}"
    n
}

fn send(client: Int, request: Int) -> Int { client * 10 + request }

fn mid(client: Int = 7, request: Int = 9) -> Int { client * 10 + request }

fn combine(a: Int, b: Int, c: Int) -> Int { a * 100 + b * 10 + c }

fn log(tag: String, rest: ...Int) -> usize {
    print "${tag} ${rest.len()}"
    rest.len()
}

fn dbl(a: Int) -> Int { a * 2 }

fn div(a: Int, b: Int) -> Int! {
    if b == 0 {
        fail test.failure("zero")
    }
    a / b
}

type Box = {
    pub n Int
}

fn Box.add(self, a: Int, b: Int) -> Int { self.n + a * 10 + b }

fn box() -> Box {
    print "box"
    Box { n: 100 }
}

fn pair[T](label: String, v: T) -> String { label }

type Wrap = Item(Int, Int)

fn main() -> Void! {
    print "${3 |> sub(10, _)}"
    print "${10 |> sub(_, 3)}"
    print "${10 |> sub(3)}"
    print "${mk("lhs", 5) |> sub(mk("a", 20), _)}"
    print "${5 |> send(request: _, client: mk("c", 1))}"
    print "${5 |> mid(request: _)}"
    print "${5 |> mid(client: _)}"
    print "${mk("l2", 6) |> combine(mk("x", 1), _, mk("y", 3))}"
    print "${5 |> log("before", 1, _, 2)}"
    print "${5 |> dbl(_) |> dbl}"
    print "${mk("recv", 2) |> box().add(mk("arg", 3), _)}"
    print "${8 |> div(100, _)?}"
    print "${(4) |> sub((_), 1)}"
    let op: fn(Int, Int) -> Int = sub
    print "${10 |> op(100, _)}"
    print "${5 |> pair[Int]("g", _)}"
    let w = 3 |> Item(1, _)
    match w {
        Item(a, b) -> print "${a} ${b}"
    }
    print "after"
}

import task from std/task
fn churn() -> Int { let mut arr: Array[String] = Array.of("x"); for i in 100..400 { arr.push("w${i}") }; arr.len().toInt() || 0 }
fn offload[F: FnOnce[fn() -> Int]](pool: task.BlockingPool, f: escaping F) -> Future[Int] { pool.run(f).unwrap() }
async fn runOn[F: FnOnce[fn() -> Int]](pool: task.BlockingPool, f: escaping F) -> Int { await pool.run(f).unwrap() }
async fn borrowEndsFirst() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let r = &other
    let before = r.len()
    let w = () => { for i in 0..300 { other = "x${i}${churn()}" }; 1 }
    let fut = pool.run(w).unwrap()
    let n = await fut
    "${before} ${n} ${other}"
}
async fn copyCaptured() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let seed = other
    let w = () => { let mut mine = seed; for i in 0..300 { mine = "c${i}${churn()}" }; mine.len().toInt() || 0 }
    let fut = pool.run(w).unwrap()
    let r = &other
    let mut total: usize = 0
    for j in 0..300 { total = total + r.len() }
    let n = await fut
    other = "after"
    "${total} ${n} ${other}"
}
async fn awaitedBeforeBorrow() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let n = await pool.run(() => { for i in 0..300 { other = "a${i}${churn()}" }; 2 }).unwrap()
    let r = &other
    "${r} ${n}"
}
async fn helperAwaited() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let fut = offload(pool, () => { for i in 0..300 { other = "h${i}${churn()}" }; 3 })
    let n = await fut
    let r = &other
    "${r} ${n}"
}
async fn asyncHelperLazy() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let f = runOn(pool, () => { for i in 0..300 { other = "y${i}${churn()}" }; 4 })
    let r = &other
    let seen = "${r}"
    let n = await f
    "${seen} ${n} ${other}"
}
async fn readersShare() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let fut = pool.run(() => { let mut t: usize = 0; for i in 0..300 { t = t + other.len() }; t.toInt() || 0 }).unwrap()
    let r = &other
    let mut t: usize = 0
    for j in 0..300 { t = t + r.len() }
    let n = await fut
    other = "done"
    "${t} ${n} ${other}"
}
async fn methodValue() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let run = pool.run
    let n = await run(() => { other = "m${churn()}"; 5 }).unwrap()
    let r = &other
    "${r} ${n}"
}
async fn droppedFirst() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    {
        let fut = pool.run(() => { for i in 0..300 { other = "d${i}${churn()}" }; 6 }).unwrap()
    }
    let r = &other
    "${r}"
}
async fn perIteration() -> String {
    let pool = task.BlockingPool.new(4)
    let mut futs = Array.empty[Future[Int]]()
    for i in 0..3 {
        let mut acc = 0
        futs.push(pool.run(() => { for j in 0..100 { acc = acc + j }; acc + i }).unwrap())
    }
    let mut t = 0
    for f in futs {
        t = t + await f
    }
    "${t}"
}
async fn waitIn(h: Future[Int]) -> Int { await h }
async fn awaitedInHelper() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let h = pool.run(() => { for i in 0..300 { other = "w${i}${churn()}" }; 7 }).unwrap()
    let n = await waitIn(h)
    let r = &other
    "${r} ${n}"
}
async fn awaitedFromOption() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let o = Some(pool.run(() => { for i in 0..300 { other = "p${i}${churn()}" }; 8 }).unwrap())
    let n = match o {
        Some(f) -> await f,
        None -> 0
    }
    let r = &other
    "${r} ${n}"
}
fn applyOnce[F: FnOnce[fn() -> Int]](f: F) -> Int { f() }
fn applyFuture[F: FnOnce[fn() -> Future[Int]]](f: F) -> Future[Int] { f() }
async fn countedPassThrough() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let mut calls = 0
    let pass = (h: Future[Int]) => {
        calls = calls + 1
        h
    }
    let h2 = pass(pool.run(() => { for i in 0..300 { other = "c${i}${churn()}" }; 9 }).unwrap())
    let n = await h2
    let r = &other
    "${r} ${n} ${calls}"
}
async fn awaitedInAppliedClosure() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let h = pool.run(() => { for i in 0..300 { other = "a${i}${churn()}" }; 10 }).unwrap()
    let n = await applyFuture(move () => waitIn(h))
    let r = &other
    "${r} ${n}"
}
async fn storedInOwnedCell() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let mut held = Array.empty[Future[Int]]()
    let h = pool.run(() => { for i in 0..300 { other = "s${i}${churn()}" }; 11 }).unwrap()
    let n = applyOnce(move () => {
        held.push(h)
        0
    })
    let r = &other
    let mut total: usize = 0
    for j in 0..300 { total = total + r.len() }
    "${r} ${n} ${total}"
}
type Hd[F] = { pub f F }
async fn storedThroughOuterThenAwaited() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let h = pool.run(() => { for i in 0..300 { other = "t${i}${churn()}" }; 12 }).unwrap()
    let n = {
        let mut held = Array.empty[Future[Int]]()
        let inner = (g: Future[Int]?) => {
            match g {
                Some(x) -> {
                    held.push(x)
                    None
                },
                None -> held.takeAt(0)
            }
        }
        let outer = (g: Future[Int]?) => inner(g)
        let _ = outer(Some(h))
        match outer(None) {
            Some(f) -> await f,
            None -> 0
        }
    }
    let r = &other
    "${r} ${n}"
}
async fn storedThroughFieldThenAwaited() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let h = pool.run(() => { for i in 0..300 { other = "f${i}${churn()}" }; 13 }).unwrap()
    let n = {
        let mut held = Array.empty[Future[Int]]()
        let hd = Hd { f: (g: Future[Int]?) => {
            match g {
                Some(x) -> {
                    held.push(x)
                    None
                },
                None -> held.takeAt(0)
            }
        } }
        let _ = (hd.f)(Some(h))
        match (hd.f)(None) {
            Some(f) -> await f,
            None -> 0
        }
    }
    let r = &other
    "${r} ${n}"
}
fn forwardTo[F: FnOnce[fn(Future[Int]) -> Void]](f: F, h: Future[Int]) { f(h) }
fn forwardTwice[F: FnOnce[fn(Future[Int]) -> Void]](f: F, h: Future[Int]) { forwardTo(f, h) }
async fn forwardAsync[F: FnOnce[fn(Future[Int]) -> Void]](f: F, h: Future[Int]) -> Int {
    f(h)
    14
}
async fn forwardedToStoringClosure() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let mut held = Array.empty[Future[Int]]()
    let add = (h: Future[Int]) => { held.push(h) }
    forwardTo(add, pool.run(() => { for i in 0..300 { other = "g${i}${churn()}" }; 1 }).unwrap())
    let r = &other
    let mut t: usize = 0
    for j in 0..300 { t = t + r.len() }
    "${r} ${t}"
}
async fn forwardedTwiceToMoveLiteral() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let mut held = Array.empty[Future[Int]]()
    forwardTwice(move (h: Future[Int]) => { held.push(h) }, pool.run(() => { for i in 0..300 { other = "m${i}${churn()}" }; 1 }).unwrap())
    let r = &other
    let mut t: usize = 0
    for j in 0..300 { t = t + r.len() }
    "${r} ${t}"
}
async fn forwardedAsyncAwaited() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let mut held = Array.empty[Future[Int]]()
    let add = (h: Future[Int]) => { held.push(h) }
    let fu = forwardAsync(add, pool.run(() => { for i in 0..300 { other = "y${i}${churn()}" }; 1 }).unwrap())
    let n = await fu
    let r = &other
    let mut t: usize = 0
    for j in 0..300 { t = t + r.len() }
    "${r} ${t} ${n}"
}
fn forwardPlain(f: fn(Future[Int]) -> Void, h: Future[Int]) { f(h) }
fn dropTask(h: Future[Int]) { }
fn helperDrops(h: Future[Int]) { forwardPlain(dropTask, h) }
fn helperRunsAndDrops[F: FnOnce[fn() -> Int]](pool: task.BlockingPool, w: escaping F) { forwardPlain(dropTask, pool.run(w).unwrap()) }
async fn helperForwardsToDrop() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    helperDrops(pool.run(() => { for i in 0..300 { other = "d${i}${churn()}" }; 1 }).unwrap())
    let r = &other
    let mut t: usize = 0
    for j in 0..300 { t = t + r.len() }
    "${r} ${t}"
}
async fn helperOffloadsAndDrops() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    helperRunsAndDrops(pool, () => { for i in 0..300 { other = "e${i}${churn()}" }; 1 })
    let r = &other
    let mut t: usize = 0
    for j in 0..300 { t = t + r.len() }
    "${r} ${t}"
}
async fn forwardedFnKept() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let f: fn(Future[Int]) -> Void = dropTask
    forwardPlain(f, pool.run(() => { for i in 0..300 { other = "k${i}${churn()}" }; 1 }).unwrap())
    let r = &other
    let mut t: usize = 0
    for j in 0..300 { t = t + r.len() }
    "${r} ${t}"
}
async fn closureOffloadsAndDrops() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let c = () => { dropTask(pool.run(() => { for i in 0..300 { other = "q${i}${churn()}" }; 1 }).unwrap()) }
    c()
    let r = &other
    let mut t: usize = 0
    for j in 0..300 { t = t + r.len() }
    "${r} ${t}"
}
fn applyForwarder(g: fn(fn(Future[Int]) -> Void, Future[Int]) -> Void, f: fn(Future[Int]) -> Void, h: Future[Int]) { g(f, h) }
async fn droppingClosureRunInLoop() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    let c = () => { dropTask(pool.run(() => { for i in 0..300 { other = "z${i}${churn()}" }; 1 }).unwrap()) }
    for i in 0..1 {
        c()
    }
    let r = &other
    let mut t: usize = 0
    for j in 0..300 { t = t + r.len() }
    "${r} ${t}"
}
async fn dropPassedThroughForwarderParam() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    applyForwarder(forwardPlain, dropTask, pool.run(() => { for i in 0..300 { other = "v${i}${churn()}" }; 1 }).unwrap())
    let r = &other
    let mut t: usize = 0
    for j in 0..300 { t = t + r.len() }
    "${r} ${t}"
}
type FnRec = { pub f fn(Future[Int]) -> Void }
fn wrapFn(f: escaping fn(Future[Int]) -> Void) -> FnRec { FnRec { f: f } }
fn callFirst(a: Array[fn(Future[Int]) -> Void], h: Future[Int]) { a[0](h) }
fn callWrapped(b: FnRec, h: Future[Int]) { (b.f)(h) }
fn passInArray(g: fn(Array[fn(Future[Int]) -> Void], Future[Int]) -> Void, f: escaping fn(Future[Int]) -> Void, h: Future[Int]) { g(Array.of(f), h) }
fn passWrapped(g: fn(FnRec, Future[Int]) -> Void, f: escaping fn(Future[Int]) -> Void, h: Future[Int]) { g(wrapFn(f), h) }
fn callAfter[F: FnOnce[fn() -> Void]](c: F) { c() }
fn dropLaterIn(h: Future[Int]) { callAfter(move () => { dropTask(h) }) }
async fn dropFnInArray() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    passInArray(callFirst, dropTask, pool.run(() => { for i in 0..300 { other = "u${i}${churn()}" }; 1 }).unwrap())
    let r = &other
    let mut t: usize = 0
    for j in 0..300 { t = t + r.len() }
    "${r} ${t}"
}
async fn dropFnWrapped() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    passWrapped(callWrapped, dropTask, pool.run(() => { for i in 0..300 { other = "b${i}${churn()}" }; 1 }).unwrap())
    let r = &other
    let mut t: usize = 0
    for j in 0..300 { t = t + r.len() }
    "${r} ${t}"
}
async fn capturedDropRunLater() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    dropLaterIn(pool.run(() => { for i in 0..300 { other = "n${i}${churn()}" }; 1 }).unwrap())
    let r = &other
    let mut t: usize = 0
    for j in 0..300 { t = t + r.len() }
    "${r} ${t}"
}
type FnSlot = { pub mut f fn(Future[Int]) -> Void }
fn FnSlot.me(mut self) -> &mut FnSlot { &mut self }
fn putSlot(b: &mut FnSlot, f: escaping fn(Future[Int]) -> Void) { b.f = f }
fn storeDropViaReturnedRef(h: Future[Int]) {
    let mut b = FnSlot { f: dropTask }
    let m = b.me()
    m.f = dropTask
    (b.f)(h)
}
fn storeDropViaReturnedRefCall(h: Future[Int]) {
    let mut b = FnSlot { f: dropTask }
    putSlot(b.me(), dropTask)
    (b.f)(h)
}
fn storeDropViaBranch(h: Future[Int], c: Bool) {
    let mut b1 = FnSlot { f: dropTask }
    let mut b2 = FnSlot { f: dropTask }
    let m = if c { &mut b1 } else { &mut b2 }
    m.f = dropTask
    (b1.f)(h)
}
fn storeDropViaCapture(h: Future[Int]) {
    let mut g: fn(Future[Int]) -> Void = dropTask
    let st = () => { g = dropTask }
    st()
    g(h)
}
async fn storedDropThroughReturnedRef() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    storeDropViaReturnedRef(pool.run(() => { for i in 0..300 { other = "r${i}${churn()}" }; 1 }).unwrap())
    let r = &other
    let mut t: usize = 0
    for j in 0..300 { t = t + r.len() }
    "${r} ${t}"
}

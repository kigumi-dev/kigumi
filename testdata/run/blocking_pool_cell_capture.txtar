type SlotHolder = { pub mut b FnSlot }
fn pickSlotDrop['a](h: &'a mut SlotHolder) -> &'a mut FnSlot {
    h.b.f = dropTask
    &mut h.b
}
fn runPickedSlotDrop(h: Future[Int]) {
    let mut hd = SlotHolder { b: FnSlot { f: dropTask } }
    let m = pickSlotDrop(&mut hd)
    (m.f)(h)
}
fn runClosureStoredParamDrop(h: Future[Int]) {
    let mut b = FnSlot { f: dropTask }
    let st = (x: &mut FnSlot) => { x.f = dropTask }
    st(&mut b)
    (b.f)(h)
}
async fn calleeStoresDropAndReturnsSlot() -> String {
    let pool = task.BlockingPool.new(1)
    let mut other = "o${churn()}"
    runPickedSlotDrop(pool.run(() => { for i in 0..300 { other = "p${i}${churn()}" }; 1 }).unwrap())
    let r = &other
    let mut t: usize = 0
    for j in 0..300 { t = t + r.len() }

-- src --
type Leaf = { x Int, y Int }
type Mid = { leaf Leaf, m Int }
type Top = { mid Mid, n Int }
fn mkTop() -> Top { Top { mid: Mid { leaf: Leaf { x: 1, y: 2 }, m: 3 }, n: 4 } }
static top: Top = comptime mkTop()

type Knob = { mut turns Int }
type Dial = { knob Knob, k Int }
type Panel = { dial Dial, p Int }
fn mkPanel() -> Panel { Panel { dial: Dial { knob: Knob { turns: 5 }, k: 6 }, p: 7 } }
static panel: Panel = comptime mkPanel()

fn deep() -> Int { top.mid.leaf.x + panel.dial.knob.turns }

fn main() {
    let t = top
    let p = panel
    print "${top.n} ${panel.p} ${t.n} ${p.p}"
}
-- stdout --
4 7 4 7

-- src --
// Inside a comptime block the generic helpers copy direct values where a run does, so each pair agrees.
type Point = {
    pub mut x Int
    pub mut y Int
}

type Slab = {
    pub mut cells FixedArray[Int, 3]
    pub mut tag Int
}

fn stash[T: Copy](xs: &mut Array[T], v: T) { xs.push(v) }

fn same[T: Copy](v: T) -> T { v }

fn viaGeneric() -> Int {
    let mut p = Point { x: 1, y: 2 }
    let mut pts: Array[Point] = Array.empty()
    stash(&mut pts, p)
    p.x = 9
    pts[0].x * 10 + p.x
}

fn aliasThenWrite() -> Int {
    let p = Point { x: 3, y: 4 }
    let mut q = same(p)
    q.x = 50
    p.x * 100 + q.x
}

fn slabCopy() -> Int {
    let mut s = Slab { cells: FixedArray.filled[Int, 3](1), tag: 2 }
    let mut t = same(s)
    t.cells[2] = 8
    s.tag = 5
    s.cells[2] * 1000 + t.cells[2] * 10 + t.tag + s.tag
}

fn closureCopy() -> Int {
    let mut p = Point { x: 2, y: 5 }
    let read = () => p.x + p.y
    let before = read()
    p.x = 40
    before * 100 + read() + p.x
}

let a = comptime { viaGeneric() }
let b = comptime { aliasThenWrite() }
let c = comptime { slabCopy() }
let d = comptime { closureCopy() }
print "generic ${a} ${viaGeneric()}"
print "alias ${b} ${aliasThenWrite()}"
print "slab ${c} ${slabCopy()}"
print "closure ${d} ${closureCopy()}"
-- stdout --
generic 19 19
alias 350 350
slab 1087 1087
closure 785 785

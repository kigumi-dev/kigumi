d30 big false true false b18446744073709551616
d30 zero true false false b0
d30 max false false false b340282366920938463463374607431768211455
i128 false true i-170141183460469231731687303715884105728 / true false i0
static true false b18446744073709551616
dropi 5 N=-3
dropi 4 N=-170141183460469231731687303715884105728
drop 3 N=18446744073709551616
drop 2 N=18446744073709551616
drop 1 N=340282366920938463463374607431768211455
end 18446744073709551616
drop 0 N=340282366920938463463374607431768211455

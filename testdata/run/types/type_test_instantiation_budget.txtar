fn wr13[T: Copy](v: T, n: Int) -> Show {
    if n == 13 { return W { value: v } }
    if n % 2 == 0 { wr12(P2 { a: v, b: "s" }, n) } else { wr12(P2 { a: v, b: 1 }, n) }

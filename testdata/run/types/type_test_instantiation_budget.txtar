fn wr17[T: Copy](v: T, n: Int) -> Show {
    if n == 17 { return W { value: v } }
    if n % 2 == 0 { wr16(P2 { a: v, b: "s" }, n) } else { wr16(P2 { a: v, b: 1 }, n) }
}

let a = wr17(1, 3)
let b = wr17(1, 16)
let c = wr17(1, 15)
print "${a is W(_)} ${b is W(_)}"
print "${W { value: P2 { a: 0, b: "" } }.same(&b)} ${W { value: P2 { a: 0, b: 0 } }.same(&b)}"
print "${W { value: P2 { a: P2 { a: 0, b: 0 }, b: 0 } }.same(&c)} ${W { value: P2 { a: 0, b: 0 } }.same(&c)} ${W { value: 0 }.same(&a)}"
-- stdout --
true true
true false
true false false

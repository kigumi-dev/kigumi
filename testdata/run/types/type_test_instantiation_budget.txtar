-- src --
// A chain of generic wrappers with two type arguments per level needs no
// instantiation to test exactly: each body composes its runtime types from
// its environment.
interface Show { fn show(self) -> String }

type W[T: Copy] = { pub value T }

fn W[T].show(self) -> String { "w" }

fn W[T].same(self, s: &Show) -> Bool { s is W(_) }

type P2[A: Copy, B: Copy] = { pub a A, pub b B }

fn wr0[T: Copy](v: T, n: Int) -> Show { W { value: v } }

fn wr1[T: Copy](v: T, n: Int) -> Show {
    if n == 1 { return W { value: v } }
    if n % 2 == 0 { wr0(P2 { a: v, b: "s" }, n) } else { wr0(P2 { a: v, b: 1 }, n) }
}

fn wr2[T: Copy](v: T, n: Int) -> Show {
    if n == 2 { return W { value: v } }
    if n % 2 == 0 { wr1(P2 { a: v, b: "s" }, n) } else { wr1(P2 { a: v, b: 1 }, n) }
}

fn wr3[T: Copy](v: T, n: Int) -> Show {
    if n == 3 { return W { value: v } }
    if n % 2 == 0 { wr2(P2 { a: v, b: "s" }, n) } else { wr2(P2 { a: v, b: 1 }, n) }
}

fn wr4[T: Copy](v: T, n: Int) -> Show {
    if n == 4 { return W { value: v } }
    if n % 2 == 0 { wr3(P2 { a: v, b: "s" }, n) } else { wr3(P2 { a: v, b: 1 }, n) }
}

fn wr5[T: Copy](v: T, n: Int) -> Show {
    if n == 5 { return W { value: v } }
    if n % 2 == 0 { wr4(P2 { a: v, b: "s" }, n) } else { wr4(P2 { a: v, b: 1 }, n) }
}

fn wr6[T: Copy](v: T, n: Int) -> Show {
    if n == 6 { return W { value: v } }
    if n % 2 == 0 { wr5(P2 { a: v, b: "s" }, n) } else { wr5(P2 { a: v, b: 1 }, n) }
}

fn wr7[T: Copy](v: T, n: Int) -> Show {
    if n == 7 { return W { value: v } }
    if n % 2 == 0 { wr6(P2 { a: v, b: "s" }, n) } else { wr6(P2 { a: v, b: 1 }, n) }
}

fn wr8[T: Copy](v: T, n: Int) -> Show {
    if n == 8 { return W { value: v } }
    if n % 2 == 0 { wr7(P2 { a: v, b: "s" }, n) } else { wr7(P2 { a: v, b: 1 }, n) }
}

fn wr9[T: Copy](v: T, n: Int) -> Show {
    if n == 9 { return W { value: v } }
    if n % 2 == 0 { wr8(P2 { a: v, b: "s" }, n) } else { wr8(P2 { a: v, b: 1 }, n) }
}

fn wr10[T: Copy](v: T, n: Int) -> Show {
    if n == 10 { return W { value: v } }
    if n % 2 == 0 { wr9(P2 { a: v, b: "s" }, n) } else { wr9(P2 { a: v, b: 1 }, n) }

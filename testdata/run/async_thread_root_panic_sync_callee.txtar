-- src --
import task from std/task

type Res = resource {
    pub id Int
}

fn Res.drop(move self) {
    print "drop ${self.id}"
}

async fn tick() -> Int {
    1
}

fn inner() {
    let r = Res { id: 2 }
    let _: Void = None.expect("sync")
}

// The root keeps its async frame, but a synchronous callee still drops its locals.
async fn root() -> Int {
    let v = await tick()
    inner()
    v
}

let ex = task.threadPoolExecutor(2)
print "total ${ex.runToCompletion(root())}"
-- stdout --
drop 2
-- stderr --
panic: sync
-- exit --
2

-- src --
type R = resource {
    pub id Int
}

fn R.drop(move self) {
    print "drop ${self.id}"
}

fn mk(n: Int) -> R {
    print "mk ${n}"
    R { id: n }
}

fn tick() -> Int {
    print "tick"
    0
}

fn two(a: &R, b: &R) -> Int {
    a.id + b.id
}

fn add(a: Int, b: Int) -> Int {
    a + b
}

fn viaReturn() -> Int {
    return mk(5).id + tick()
}

fn viaArm(x: Int) -> Int {
    match x {
        1 -> mk(10).id + tick(),
        _ -> 0,
    }
}

fn viaGuard(n: Int) {
    match n {
        k if mk(k).id > tick() -> print "guard big",
        _ -> print "guard small",
    }
}

fn viaTail() -> Int {
    let base = 1
    mk(6).id + tick() + base
}

print "a ${two(&mk(2), &mk(3))}"
print "b ${add(mk(1).id, tick())}"
let c = mk(1).id + tick()
print "c ${c}"
print "d ${mk(3).id}${tick()}"
if mk(4).id > tick() {
    print "cond true"
}
print "return ${viaReturn()}"
print "tail ${viaTail()}"
match mk(7).id + tick() {
    7 -> print "matched"
    _ -> print "other"
}
let e = mk(8).id + {
    let inner = mk(9).id
    inner + tick()
}
print "e ${e}"
print "arm ${viaArm(1)}"
let lam = () => mk(11).id + tick()
print "lambda ${lam()}"
viaGuard(12)
let mut x = 0
for mk(13).id > tick() + x {
    x += 13
}
print "loop ${x}"

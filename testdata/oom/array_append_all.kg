fn run() -> Unit {
    let mut a = Array.of(1, 2, 3, 4)
    let before = a.len()
    let r = a.tryAppendAll(Array.of(4, 5, 6, 7))
    if r is Err(_) {
        if a.len() == before && (a.first() || 0) == 1 {
            print "err"
        } else {
            print "CHANGED"
        }
    }
}

run()

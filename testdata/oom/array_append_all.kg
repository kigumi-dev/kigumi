fn run() {
    let mut a = Array.of(1, 2, 3, 4)
    let before = a.len()
    let extra = Array.of(4, 5, 6, 7)
    eprint "go"
    let r = a.tryAppendAll(extra)
    if r is Err(_) {
        if a.len() == before && (a.first() || 0) == 1 {
            print "err"
        } else {
            print "CHANGED"
        }
    }
}

run()

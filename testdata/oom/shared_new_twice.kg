import {Shared} from std/alloc

fn run() {
    let before = 1
    eprint "go"
    let r1 = Shared.tryNew(before)
    let r = Shared.tryNew(before)
    if r is Err(_) || r1 is Err(_) {
        if before == 1 {
            print "err"
        } else {
            print "CHANGED"
        }
    }
}

run()

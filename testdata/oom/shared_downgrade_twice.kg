import {Shared} from std/alloc

fn run() {
    let s = Shared.new(7)
    eprint "go"
    let r1 = s.tryDowngrade()
    let r = s.tryDowngrade()
    if r is Err(_) || r1 is Err(_) {
        if (s.get() == 7) {
            print "err"
        } else {
            print "CHANGED"
        }
    }
}

run()

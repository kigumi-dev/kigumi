fn run() -> Unit {
    let a = Array.of(1, 2, 3)
    eprint "go"
    let first = a.trySlice(0, 2)
    let second = a.trySlice(0, 2)
    if first is Err(_) || second is Err(_) {
        if a.len() == 3 && (a.first() || 0) == 1 {
            print "err"
        } else {
            print "CHANGED"
        }
    }
}

run()

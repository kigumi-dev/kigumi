import map from std/map

fn run() -> Unit {
    let mut m = map.tryEmpty[String, String]().unwrap()
    m.set("a", "b")
    let before = m.len()
    eprint "go"
    let r1 = m.tryClone()
    let r = m.tryClone()
    if r is Err(_) || r1 is Err(_) {
        if m.len() == before && m.contains(&"a") {
            print "err"
        } else {
            print "CHANGED"
        }
    }
}

run()

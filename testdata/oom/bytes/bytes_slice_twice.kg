fn run() {
    let b = Bytes.zeros(6)
    let before = b.len()
    eprint "go"
    let r1 = b.trySlice(1, 4)
    let r = b.trySlice(1, 4)
    if r is Err(_) || r1 is Err(_) {
        if b.len() == before {
            print "err"
        } else {
            print "CHANGED"
        }
    }
}

run()

import text from std/text

fn run() {
    let s = "foobar"
    eprint "go"
    let r1 = text.trySlice(s, 1, 3)
    let r = text.trySlice(s, 1, 3)
    if r is Err(_) || r1 is Err(_) {
        if s.len() == 6 {
            print "err"
        } else {
            print "CHANGED"
        }
    }
}

run()

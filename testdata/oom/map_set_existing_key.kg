import map from std/map

fn run() -> Unit {
    let mut m = map.tryEmpty[Int, Int]().unwrap()
    m.set(1, 10)
    m.set(2, 20)
    eprint "go"
    let r = m.trySet(2, 21)
    if r is Err(_) {
        if m.len() == 2 && (m.get(&2) || 0) == 20 {
            print "err"
        } else {
            print "CHANGED"
        }
    }
}

run()

import map from std/map

fn run() -> Unit {
    let mut m = map.tryEmpty[Int, Int]().unwrap()
    m.set(1, 10)
    m.set(2, 20)
    m.set(3, 30)
    m.set(4, 40)
    eprint "go"
    let r1 = m.trySet(5, 50)
    let mid = m.len()
    let r = m.trySet(6, 60)
    if r is Err(_) || r1 is Err(_) {
        if ((r1 is Err(_) && mid == 4) || (r1 is Ok(_) && mid == 5)) && ((r is Err(_) && m.len() == mid) || (r is Ok(_) && m.len() == mid + 1)) && m.contains(&1) && m.contains(&4) {
            print "err"
        } else {
            print "CHANGED"
        }
    }
}

run()

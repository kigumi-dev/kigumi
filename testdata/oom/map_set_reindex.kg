import map from std/map

fn run() -> Unit {
    let mut m = map.tryEmpty[Int, Int]().unwrap()
    m.set(1, 10)
    m.set(2, 20)
    m.set(3, 30)
    m.set(4, 40)
    eprint "go"
    let r = m.trySet(5, 50)
    if r is Err(_) {
        if m.len() == 4 && m.contains(&1) && m.contains(&4) && !m.contains(&5) {
            print "err"
        } else {
            print "CHANGED"
        }
    }
}

run()

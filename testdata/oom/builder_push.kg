import text from std/text

fn run() -> Unit {
    let mut b = text.StringBuilder.tryNew().unwrap()
    b.push("ab")
    let before = b.len()
    let r = b.tryPush("cdefgh")
    if r is Err(_) {
        if b.len() == before {
            print "err"
        } else {
            print "CHANGED"
        }
    }
}

run()

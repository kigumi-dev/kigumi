import map from std/map

fn run() {
    let mut m = map.tryEmpty[String, Int]().unwrap()
    m.set("a", 1)
    m.set("b", 2)
    let k = "c"
    let before = m.len()
    eprint "go"
    let r = m.trySet(k, 3)
    if r is Err(_) {
        if m.len() == before && m.contains(&"a") && m.contains(&"b") {
            print "err"
        } else {
            print "CHANGED"
        }
    }
}

run()

fn run() -> Unit {
    let a = Array.of("x", "yy", "zzz")
    let before = a.len()
    eprint "go"
    let r1 = a.tryClone()
    let r = a.tryClone()
    if r is Err(_) || r1 is Err(_) {
        if a.len() == before {
            print "err"
        } else {
            print "CHANGED"
        }
    }
}

run()

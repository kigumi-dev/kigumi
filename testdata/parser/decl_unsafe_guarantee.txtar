@unsafeGuarantee(Send)
pub type Socket = resource {
    fd i32
}
@unsafeGuarantee(Send when T: Send, Sync when T: Send + Sync)
pub type Mutex[T] = resource {
    cell T
}
@unsafeGuarantee(Copy, Send, Sync)
pub type NativeTimestamp
fn paramTarget(@unsafeGuarantee(Send) x: Int) -> Unit {}

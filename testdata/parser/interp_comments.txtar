-- src --
fn main() {
    let x = 1
    let a = "${ x // a } in a comment
}"
    let b = "${ x /* } */ }"
    let c = "${ x // }
}"
    let d = "${ x /* /* } */ } */ + 2 }"
    let e = "${ {
        let y = x // { "}" }
        y
    } }"
    let f = "${ x # }
}"
    let g = "${ x # { }
}"
    let h = "${ {
        let y = x # { "}" }
        y
    } }"
    print "${a}${b}${c}${d}${e}${f}${g}${h}"
}

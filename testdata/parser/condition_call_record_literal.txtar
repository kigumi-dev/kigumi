-- src --
type U = { id Int }

fn f(u: U) -> Int { u.id }

fn g() -> Bool {
    if f(U {}) == 0 {
        true
    } else {
        false
    }
}

fn h() -> Int {
    match f(U {}) {
        0 -> 1
        _ -> 2
    }
}

-- src --
type User = {
    name String
    age Int
}
pub type Point = { x Float, y Float, mut score Int }
type Shape = Circle(radius: Float) | Rect(w: Float, h: Float)
pub type Problem = Missing(Int) | Empty
type Cmd =
    | Serve(ServeFlags)
    | Version
type Cmd2 =
    Serve(ServeFlags)
    | Version
type UserId = Int
type IoResult = alias Int
type Callback = pure fn(Event) -> Void
type File = resource {
    handle usize
}
type CPoint layout(C) = {
    x i32
    y i32
}
@impl(Display, Identified)
pub type Named = {
    pub id Int {
        json.name("id")
    }

    pub nickname String? {
        json.name("nickname")
        json.omitNone
    }
}
@impl(Display)
@impl(Identified)
pub type Twice = { pub id Int }
pub type Pair[T] = {
    pub first T
    pub second T
}
type Bad = {
    x Int
    fn method(self) -> Int { 1 }
}

-- src --
fn connect(host: String, port: Int = 443, tls: Bool = true) {}
fn read(data: Bytes, offset: Int = 0, length: Int = data.len() - offset) -> Bytes { data }
type Sum = alias fn(...Int) -> Int
type Cmd = alias fn(String, ...String) -> Void
fn use() {
    show 1 2 3
    f g(x) user.name xs[0] value?
    f a b + c
    let x =
        add(1, 2)
    c =
        add 3 4
    let y = v |> transform(opt, _)
    let z = r |> send(client: c, request: _)
    let w = (xs: ...Int) => xs.len()
}

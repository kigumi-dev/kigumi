type A = alias fn(Int, ...) -> Void
type B = alias fn(...Int, String) -> Void
type C = alias extern(C) fn(*const u8, ...Int) -> i32
fn use() {
    v |> f a _
    let w = (xs: ...Int, y: Int) => xs
    greet name: name
    log ...xs
    greet name 3 4
}

-- src --
fn keep[F: Fn[fn() -> Void]](callback:   escaping   F) -> Handler[F] { Handler { callback: callback } }
fn viaType[F: Fn[fn() -> Void]](register: fn(escaping   F, Int) -> Void, cb: F) { register(cb, 1) }
fn direct(a: escaping   fn() -> Void, rest: ...escaping   Int) {}
interface Registry {
    fn add[F: Fn[fn() -> Void]](self, callback:   escaping F)
}
-- expect --
fn keep[F: Fn[fn() -> Void]](callback: escaping F) -> Handler[F] {
    Handler { callback: callback }
}

fn viaType[F: Fn[fn() -> Void]](register: fn(escaping F, Int) -> Void, cb: F) {
    register(cb, 1)
}

fn direct(a: escaping fn() -> Void, rest: ...escaping Int) {}

interface Registry {
    fn add[F: Fn[fn() -> Void]](self, callback: escaping F)
}

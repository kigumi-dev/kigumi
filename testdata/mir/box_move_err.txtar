-- lib/moves.kg --
import {Box} from std/alloc

fn reuse(b: Box[Int]) -> Int {
    let c = b
    b.get() + c.get()
}

fn twice(b: Box[Int]) -> Int {
    let x = b.into()
    let y = b.into()
    x + y
}

type UserId = u64

pure noalloc fn some(id: UserId) -> UserId? {
    Some(id)
}

pure noalloc fn checked(id: UserId, ok: Bool) -> Result[UserId, UserId] {
    if ok { Ok(id) } else { Err(id) }
}

fn main() -> Void! {
    if some(UserId(5)) is Some(v) { print "${v.value}" }
    if checked(UserId(7), false) is Err(v) { print "${v.value}" }
}

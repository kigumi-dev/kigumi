-- lib/relay.kg --
fn length['a](value: &'a String) -> usize { value.len() }
fn twice(f: fn(&String) -> usize, v: &String) -> usize { f(v) + f(v) }
fn id[T](x: T) -> T { x }

fn relayed['a](value: &'a String) -> usize {
    let q: fn(&'a String) -> usize = length
    twice(id(q), value)
}

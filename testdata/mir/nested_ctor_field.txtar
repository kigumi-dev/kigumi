-- src --
type R = {
    pub a Int
    pub b Int?
}

fn tuplePayload(x: (Int, Int?)) -> Int {
    match x {
        (a, Some(r)) -> a + r
        (a, None) -> a
    }
}

fn recordPayload(x: R) -> Int {
    match x {
        R { b: Some(v), a } -> a + v
        R { a } -> a
    }
}

fn letElse(x: (Int, Int?)) -> Int {
    let (a, Some(b)) = x else { return -1 }
    a + b
}

fn isTest(x: (Int, Int?)) -> Int {
    if x is (a, Some(r)) {
        return a * r
    }
    0
}

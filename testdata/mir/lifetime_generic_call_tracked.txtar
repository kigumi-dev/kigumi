-- lib/lt.kg --
type View['a] = { pub data &'a Bytes, pub off usize }

fn identity[T](x: T) -> T {
    x
}

fn pickData['a, 'b](v: View['a], other: View['b]) -> &'a Bytes {
    identity(v.data)
}
-- expect --
fn lib.identity(%x: T) -> T {
  b0:
    %t1 = move(%x)
    nop
    return %t1
}
fn lib.pickData(%v: View['a], %other: View['b]) -> &Bytes {
  b0:
    %t2 = field 0(%v)
    %t3 = call identity(%t2)
    drop(%other)
    drop(%v)
    return %t3
}

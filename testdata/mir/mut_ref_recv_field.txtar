-- src --
type Box = {
    pub mut n Int
}

fn Box.bump(mut self, k: Int) -> Unit {
    self.n = self.n + k
}

type Holder['a] = {
    pub mut r &'a mut Box
}

fn bumpField['a](h: Holder['a]) -> Unit {
    h.r.bump(2)
}

fn readField['a](h: Holder['a]) -> Int {
    h.r.n
}

let mut b = Box { n: 1 }
bumpField(Holder { r: &mut b })
print "${b.n}"

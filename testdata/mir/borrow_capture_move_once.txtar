-- lib/capture.kg --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) {
    _ = self
}

fn keep(r: Res) -> Int {
    r.id
}

fn once[F: FnOnce[fn() -> Int]](f: F) -> Int {
    f()
}

fn moveOut(r: Res) -> Int {
    once(() => keep(r))
}

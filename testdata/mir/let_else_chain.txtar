-- src --
fn guards(a: Int?, b: Int?) -> Int {
    let Some(x) = a else { return 1 }
    let Some(y) = b else { return 2 }
    x + y
}

fn afterMatch(o: Int?, a: Int?) -> Int {
    match o {
        Some(v) -> print "${v}"
        None -> print "none"
    }
    let Some(x) = a else { return 0 }
    x
}

fn inLoop(xs: Array[Int?]) -> Int {
    let mut t = 0
    for e in xs {
        let Some(v) = e else { continue }
        let Some(w) = Some(v) else { return -1 }
        t = t + w
    }
    t
}

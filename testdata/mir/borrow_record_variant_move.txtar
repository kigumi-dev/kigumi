-- lib/field.kg --
type Inner = resource {
    pub id Int
}

fn Inner.drop(move self) {
    _ = self
}

type Outer = {
    pub inner Inner
    pub n Int
}

type Wrap = {
    pub outer Outer
}

type Box = Wrapped(Outer)

fn Outer.record(self) -> Wrap {
    Wrap { outer: self }
}

fn Outer.variant(self) -> Box {
    Wrapped(self)
}


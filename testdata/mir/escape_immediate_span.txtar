-- lib/esc.kg --
import {Shared} from std/alloc

type Item = { mut count Int }

fn Item.update(mut self, delta: Int) -> Unit {
    self.count = self.count + delta
}

// cell is lent (capBorrow) to the outer closure for the span of this call; touching it again before
// the call returns must be rejected here, not deferred to Shared's runtime exclusive-borrow panic.
fn reentrant(cell: Shared[Item]) -> Unit {
    cell.withMut((x: &mut Item) => {
        cell.withMut((y: &mut Item) => {
            y.update(100)
        })
        x.update(1)
    })
}

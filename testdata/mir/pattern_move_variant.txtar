-- lib/loop.kg --
type Handle = resource {
    pub id Int
}

fn Handle.drop(move self) -> Unit {}

fn Handle.close(move self) -> Unit {}

type Bag = {
    pub opt Handle?
    pub other Handle
}

fn payloadInLoop(b: Bag) -> Unit {
    for i in 0..2 {
        match b.opt {
            Some(h) -> h.close()
            None -> {}
        }
    }
}

fn payloadOnce(b: Bag) -> Unit {
    match b.opt {
        Some(h) -> h.close()
        None -> {}
    }
}

fn payloadGuarded(b: Bag) -> Unit {
    match b.opt {
        Some(h) if true -> h.close()
        Some(h) -> h.close()
        None -> {}
    }
}

type Slot = {
    pub mut opt Handle?
}

fn ok(h: &Handle) -> Bool {
    true
}

fn payloadGuardedLoop(b: Slot) -> Unit {
    for i in 0..2 {
        match b.opt {
            Some(h) if ok(&h) -> h.close()
            _ -> {}
        }
    }
}

fn payloadRefill(s: Slot) -> Unit {
    let mut b = s
    for i in 0..2 {
        match b.opt {
            Some(h) -> {
                h.close()
                b.opt = None
            }
            None -> {}
        }
    }
}

fn isTakeAndClear(s: Slot) -> Unit {
    let mut b = s
    for i in 0..2 {
        if b.opt is Some(h) {
            h.close()
            b.opt = None
        }
    }
}

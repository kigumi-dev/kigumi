-- lib/mv.kg --
type Res = resource {
    pub n Int
}

fn Res.drop(move self) -> Unit {}

fn Res.get(self, k: Int) -> Int { self.n + k }

type Pair = {
    pub tag Int
    pub mut left Res
}

fn take(p: Pair) -> Unit {}

fn reinitBoth(c: Bool) -> Unit {
    let mut p = Pair { tag: 1, left: Res { n: 1 } }
    let f = p.left.get
    if c {
        p.left = Res { n: 2 }
    } else {
        p.left = Res { n: 3 }
    }
    take(p)
}

fn reinitOneBranch(c: Bool) -> Unit {
    let mut p = Pair { tag: 1, left: Res { n: 1 } }
    let f = p.left.get
    if c {
        p.left = Res { n: 9 }
    }
    take(p)
}

fn moveReinitOneBranch(c: Bool) -> Unit {
    let mut p = Pair { tag: 1, left: Res { n: 1 } }
    let g = move p.left
    if c {
        p.left = Res { n: 9 }
    }
    take(p)
}

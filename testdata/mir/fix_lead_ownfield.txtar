type Box = {
    pub mut h Handle
}

fn consume(x: Handle) {
    x.close()
}

fn twiceField(b: Box) {
    consume(b.h)
    consume(b.h)
}

fn plainOverwrite(mut b: Box, fresh: Handle) {
    b.h = fresh
}

fn onceThenRestored(mut b: Box, fresh: Handle) {
    consume(b.h)
    b.h = fresh
    consume(b.h)
}

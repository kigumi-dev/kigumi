-- lib/lt.kg --
async fn pick(a: &Bytes, b: &Bytes) -> u8 {
    a[0] + b[0]
}

async fn run() -> u8 {
    let x = Bytes.fromArray(&Array.of(1, 2, 3))
    let y = Bytes.fromArray(&Array.of(4, 5, 6))
    let r = pick(&x, &y)
    await r
}

-- lib/vh.kg --
type Box = { pub v Int }

type View['a] = { pub data &'a Box }

type Holder['a] = Has(View['a])

type Loose[T] = Wrap2(T)

fn make['a](b: &'a Box) -> Holder['a] {
    let v = View { data: b }
    Has(v)
}

fn makeLoose() -> Unit {
    let b = Box { v: 1 }
    let r = &b
    let l = Wrap2(r)
}


-- lib/lt.kg --
type View['a] = { pub data &'a Bytes, pub off usize }

fn pickEither[T](cond: Bool, a: T, b: T) -> T {
    if cond {
        a
    } else {
        b
    }
}

fn pickData['a, 'b](cond: Bool, v: View['a], other: View['b]) -> &'a Bytes {
    pickEither(cond, v.data, other.data)
}

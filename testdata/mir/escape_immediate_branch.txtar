-- lib/esc.kg --
type Res = resource {
    pub tag Int
}

fn Res.drop(move self) {
    _ = self
}

fn Res.touch(self) {
    _ = self
}

fn sink(r: Res) {
    _ = r
}

// twoArgs's cb is non-escaping (capBorrow granted), but the branching sibling argument moves the
// call to a different block than the closure's creation; a touch of the owner before it must still be rejected.
fn twoArgs(cb: fn() -> Void, flag: Bool) {
    cb()
}

fn danger(flag: Bool) {
    let r = Res { tag: 42 }
    twoArgs(() => r.touch(), if flag { sink(r); true } else { false })
}

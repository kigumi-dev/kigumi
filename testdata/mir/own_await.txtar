-- lib/own_await.kg --
async fn work() -> Int {
    1
}

async fn awaitOnce() -> Int {
    let f = work()
    await f
}

async fn awaitTwice() -> Int {
    let f = work()
    let a = await f
    let b = await f
    a + b
}

async fn awaitValueTwice() -> Int {
    let g = work
    let f = g()
    let a = await f
    let b = await f
    a + b
}

type Box = {
    fut Future[Int]
}

async fn awaitField(b: Box) -> Int {
    let x = await b.fut
    let y = await b.fut
    x + y
}

async fn awaitParam(f: Future[Int]) -> Int {
    let a = await f
    let b = await f
    a + b
}

async fn awaitLoop() -> Int {
    let f = work()
    let mut total = 0
    for i in 0..3 {
        total = total + await f
    }
    total
}

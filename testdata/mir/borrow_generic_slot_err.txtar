-- lib/slot.kg --
// A slot whose declared type is a type parameter owns and releases what it
// holds, however that parameter is later instantiated, so a borrow with no
// count to give cannot go there. Only `&'a T` and a type routing one through
// its own `'a` are skipped by the destructor.
type Box = { pub mut n Int }

type Wrap[T] = { pub v T }

type View['a] = { pub data &'a Box }

fn own[T](x: T) -> Unit {}

fn lend[T](x: &T) -> Unit {}

fn wrapped() -> Unit {
    let b = Box { n: 1 }
    let w = Wrap { v: &b }
}

fn nested() -> Unit {
    let b = Box { n: 1 }
    let w = Wrap { v: Wrap { v: &b } }
}

fn tupled() -> Unit {
    let b = Box { n: 1 }
    let t = (&b, 1)
}

fn variant() -> Unit {
    let b = Box { n: 1 }
    let o = Option.Some(&b)
}

fn element() -> Unit {
    let b = Box { n: 1 }
    let a = Array.of(&b)
}

fn handed() -> Unit {
    let b = Box { n: 1 }
    own(&b)
}

fn forwarded(r: &Box) -> Unit {
    own(r)
}

fn viewed() -> Unit {
    let b = Box { n: 1 }
    let v = View { data: &b }
    lend(v.data)
    own(v.data)
}

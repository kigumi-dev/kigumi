-- lib/slot.kg --
// A slot of a type parameter owns what it holds, so a borrow cannot go there.
type Box = { pub mut n Int }

type Wrap[T] = { pub v T }

type View['a] = { pub data &'a Box }

fn own[T](x: T) {}

fn lend[T](x: &T) {}

fn wrapped() {
    let b = Box { n: 1 }
    let w = Wrap { v: &b }
}

fn nested() {
    let b = Box { n: 1 }
    let w = Wrap { v: Wrap { v: &b } }
}

fn tupled() {
    let b = Box { n: 1 }
    let t = (&b, 1)
}

fn variant() {
    let b = Box { n: 1 }
    let o = Option.Some(&b)
}

fn element() {
    let b = Box { n: 1 }
    let a = Array.of(&b)
}

fn handed() {
    let b = Box { n: 1 }
    own(&b)
}

fn forwarded(r: &Box) {
    own(r)
}

fn viewed() {
    let b = Box { n: 1 }
    let v = View { data: &b }
    lend(v.data)
    own(v.data)
}

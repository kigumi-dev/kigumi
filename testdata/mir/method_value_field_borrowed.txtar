-- lib/mv.kg --
type Res = resource {
    pub n Int
}

fn Res.drop(move self) -> Unit {}

fn Res.get(self, k: Int) -> Int { self.n + k }

type Pair = {
    pub tag Int
    pub mut left Res
    pub mut right Res
}

fn Pair.sum(self) -> Int { self.left.n + self.right.n }

fn show(r: &Res) -> Unit {}

fn two[F: Fn[fn(Int) -> Int]](p: &Pair, f: F) -> Int { p.left.n + f(1) }

fn wholeMethodAfter() -> Int {
    let p = Pair { tag: 1, left: Res { n: 1 }, right: Res { n: 2 } }
    let f = p.left.get
    p.sum()
}

fn wholeMethodAfterMove() -> Int {
    let p = Pair { tag: 1, left: Res { n: 1 }, right: Res { n: 2 } }
    let g = move p.left
    p.sum()
}

fn borrowedArgument() -> Int {
    let p = Pair { tag: 1, left: Res { n: 1 }, right: Res { n: 2 } }
    two(&p, p.left.get)
}

fn borrowedHolder() -> Unit {
    let p = Pair { tag: 1, left: Res { n: 1 }, right: Res { n: 2 } }
    let b = &p
    let f = p.left.get
    show(&b.left)
}

fn siblingStillUsable() -> Int {
    let p = Pair { tag: 1, left: Res { n: 1 }, right: Res { n: 2 } }
    let f = p.left.get
    show(&p.right)
    f(p.tag) + p.right.n
}

fn mkp() -> Pair { Pair { tag: 1, left: Res { n: 1 }, right: Res { n: 2 } } }

fn capturedThenCalled() -> Int {
    let p = mkp()
    let c = () => p.left.n
    let f = p.left.get
    c() + f(1)
}

fn capturedThenMoved() -> Int {
    let p = mkp()
    let c = () => p.left.n
    let x = move p.left
    c() + x.n
}

fn capturedPassedOn() -> Int {
    let p = mkp()
    let c = () => p.tag
    let d = () => c() + 1
    let f = p.left.get
    d() + f(1)
}

fn capturedCalledBefore() -> Int {
    let p = mkp()
    let c = () => p.tag
    let x = c()
    let f = p.left.get
    x + f(1)
}

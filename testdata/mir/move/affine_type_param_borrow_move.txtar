-- lib/peek.kg --
// A generic receiver its method borrows is still the caller's storage, so
// handing it on by value is rejected like a concrete move-only one.
type Box[T] = {
    pub value T
}

fn keep[U](v: U) -> U {
    v
}

fn Box[T].again(self) -> Box[T] {
    keep(self)
}
-- expect --
fn lib.keep(%v: U) -> U {
  b0:
    %t1 = move(%v)
    nop
    return %t1
}
fn lib.Box.again(%self: Box[T]) -> Box[T] {
  b0:
    %t1 = move(%self)
    %t2 = call lib.keep(%t1)
    return %t2
}
error[move-from-borrow]: `self` is borrowed by this method and cannot be moved out; take `move self`
  --> lib/peek.kg:12:10
   |
12 |     keep(self)
   |          ^^^^


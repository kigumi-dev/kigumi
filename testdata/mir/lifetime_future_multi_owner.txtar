-- lib/lt.kg --
async fn pick(a: &Bytes, b: &Bytes) -> u8 {
    a[0] + b[0]
}

async fn run() -> u8 {
    let x = Bytes.fromArray(&Array.of(1, 2, 3))
    let y = Bytes.fromArray(&Array.of(4, 5, 6))
    let r = pick(&x, &y)
    await r
}
-- expect --
async fn lib.pick(%a: &Bytes, %b: &Bytes) -> u8 {
  b0:
    %t2 = const 0: usize
    %t3 = index(%a, %t2)
    %t4 = const 0: usize
    %t5 = index(%b, %t4)
    %t6 = bin +(%t3, %t5)
    %t7 = builtin task.close
    return %t6
}
async fn lib.run() -> u8 {
  b0:
    %t1 = const 1: u8
    %t2 = const 2: u8
    %t3 = const 3: u8
    %t4 = array(%t1, %t2, %t3)
    %t5 = call std/array.Array.of(%t4)
    %t0 = borrow 0(%t5)
    %t6 = call std/prelude.Bytes.fromArray(%t0)
    %x = copy(%t6)
    %t9 = const 4: u8
    %t10 = const 5: u8
    %t11 = const 6: u8
    %t12 = array(%t9, %t10, %t11)
    %t13 = call std/array.Array.of(%t12)
    %t8 = borrow 0(%t13)
    %t14 = call std/prelude.Bytes.fromArray(%t8)
    %y = copy(%t14)
    %t16 = borrow 0(%x)
    %t17 = borrow 0(%y)
    %t18 = fnitem lib.pick async
    %t19 = future(%t18, %t16, %t17)
    %r = copy(%t19)
    %t21 = move(%r)
    %t22 = await(%t21)
    %t23 = cancelled
    branch %t23 ? b1 : b2
  b1:
    nop
    drop(%y)
    drop(%x)
    cancel
    unreachable
  b2:
    %t24 = builtin task.close
    nop
    drop(%y)
    drop(%x)
    return %t22
}

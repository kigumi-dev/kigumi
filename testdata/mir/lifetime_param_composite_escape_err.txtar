type View['a] = { pub data &'a Bytes, pub off usize }

fn swap['a, 'b](v: View['a], other: View['b]) -> View['a] {
    View { data: other.data, off: v.off }
}

fn scoped['a](longView: View['a]) -> View['a] {
    let shortBuf = Bytes.fromArray(&Array.of(1, 2, 3))
    let shortView = View { data: &shortBuf, off: 0 }
    swap(longView, shortView)
}

-- lib/own.kg --
import fs from std/fs

fn consume(f: fs.File) -> Unit! {
    f.close()?
}

fn twice(f: fs.File) -> Unit! {
    consume(f)?
    consume(f)?
}

fn branchy(f: fs.File, flag: Bool) -> Unit! {
    if flag {
        consume(f)?
    }
    consume(f)?
}

fn diverge(f: fs.File, flag: Bool) -> Unit! {
    if flag {
        consume(f)?
        return
    }
    consume(f)?
}

fn dropped(files: fs.Files, p: fs.Path) -> Unit! {
    let f = files.create(p)?
    let g = files.create(p)?
    consume(g)?
}

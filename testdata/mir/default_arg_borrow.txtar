type Res = resource {
    pub n Int
}

fn Res.drop(move self) {
    print "drop ${self.n}"
}

fn peek(r: Res, extra: Int = r.n * 2) -> Int {
    r.n + extra
}

fn main() -> Void! {
    print "${peek(Res { n: 4 })}"
}

interface FromRef[K] {
    fn fromRef(k: &K) -> Self
}
type S['a] = { pub s &'a String }
fn S['a].fromRef(k: &'a String) -> S['a] { S { s: k } }
type Hold[W] = { pub v W }
fn put[W: FromRef[String]](h: Hold[W], k: &String) -> Hold[W] {
    Hold { v: W.fromRef(k) }
}
fn outer[W: FromRef[String]](h: Hold[W], k: String) -> Hold[W] {
    put(h, &k)
}

-- src --
fn bump(k: &mut Int) { k = k + 1 }

fn plain() -> String {
    let mut out = ""
    for i in 0..3 {
        let mut k = i
        bump(&mut k)
        out = "${out} ${k}"
    }
    out
}

fn main() { print plain() }

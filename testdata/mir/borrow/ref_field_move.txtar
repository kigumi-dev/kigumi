-- lib/m.kg --
// A `&mut` field read by value moves out of its holder; passed to a `&mut T` parameter it is lent for the call.
// Out of a `mut self` receiver the move is partial: the field must be back before any whole use and every return.
type Box = {
    pub mut n Int
}

type Hold['a] = {
    pub mut r &'a mut Array[Box]
    pub z Int
}

fn grow(a: &mut Array[Box]) {
    a.push(Box { n: 0 })
}

async fn later(a: &mut Array[Box]) {
    a.push(Box { n: 1 })
}

fn assignMoves['a](mut dst: Hold['a], src: Hold['a]) -> usize {
    dst.r = src.r
    src.r.len()
}

fn letMoves['a](h: Hold['a]) -> usize {
    let r = h.r
    h.r.len()
}

fn wholeAfter['a](h: Hold['a]) -> Hold['a] {
    let r = h.r
    h
}

fn asyncMoves['a](h: Hold['a]) -> usize {
    let f = later(h.r)
    h.r.len()
}

fn Hold['a].steal(mut self) -> usize {
    let r = self.r
    r.len()
}

fn Hold['a].peek(self) -> usize {
    self.r.len()
}

fn Hold['a].useAfter(mut self, other: Hold['a]) {
    let old = self.r
    grow(self.r)
    self.r = other.r
}

fn Hold['a].wholeAfter(mut self, other: Hold['a]) -> usize {
    let old = self.r
    let k = self.peek()
    self.r = other.r
    k
}

fn Hold['a].earlyExit(mut self, other: Hold['a], x: Result[Int, String]) -> Result[Int, String] {
    let old = move self.r
    let v = x?
    self.r = other.r
    Ok(v)
}

fn call[F: FnMut[fn() -> Void]](mut f: F) {
    f()
}

fn Hold['a].lendInClosure(mut self) {
    call(() => {
        let r = self.r
        grow(r)
    })
}

fn Hold['a].swapIn(mut self, mut other: Hold['a]) -> Hold['a] {
    let old = self.r
    grow(old)
    self.r = other.r
    other.r = old
    other
}

fn reborrows['a](h: Hold['a]) -> usize {
    grow(h.r)
    grow(h.r)
    h.r.len()
}

fn restores['a](mut h: Hold['a], other: Hold['a]) -> Hold['a] {
    let r = h.r
    grow(r)
    h.r = other.r
    h
}

type Cnt['a] = {
    pub mut c &'a mut Int
}

type Guard['a] = resource {
    pub r &'a mut Array[Box]
}

fn Guard['a].drop(move self) {
    self.r.push(Box { n: 9 })
}

fn sumReads['a](h: Cnt['a]) -> Int {
    h.c + h.c
}

fn lastUseEnds() -> usize {
    let mut v = Array.of(Box { n: 1 })
    let h = Hold { r: &mut v, z: 0 }
    grow(h.r)
    v.len()
}

fn usedLater() -> usize {
    let mut v = Array.of(Box { n: 1 })
    let h = Hold { r: &mut v, z: 0 }
    let n = v.len()
    grow(h.r)
    n
}

fn dropKeeps() -> usize {
    let mut v = Array.of(Box { n: 1 })
    let g = Guard { r: &mut v }
    v.len()
}

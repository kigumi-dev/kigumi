-- src --
interface Counter {
    fn bump(mut self, by: Int)
    fn get(self) -> Int
}

type Num = {
    pub mut n Int
}

fn Num.bump(mut self, by: Int) {
    self.n = self.n + by
}

fn Num.get(self) -> Int {
    self.n
}

fn read(c: &Counter) -> Int {
    c.get()
}

fn bump(c: &mut Counter) {
    c.bump(1)
}

fn main() -> Void! {
    let mut num = Num { n: 1 }
    bump(&mut num)
    print "${read(&num)}"
}

-- lib/wm.kg --
type Item = {
    pub mut count Int
}

fn Item.update(mut self, delta: Int) {
    self.count = self.count + delta
}

fn sharedThenWithMut(mut xs: Array[Item]) -> usize {
    let r = &xs
    xs.withMut(0, (x: &mut Item) => x.update(1))
    r.len()
}

fn exclusiveThenLen(mut xs: Array[Item]) -> usize {
    let m = &mut xs
    let k = xs.len()
    m.withMut(0, (x: &mut Item) => x.update(1))
    k
}

fn fine(mut xs: Array[Item]) -> usize {
    let r = &xs
    let n = r.len()
    xs.withMut(0, (x: &mut Item) => x.update(1))
    xs.len() + n
}

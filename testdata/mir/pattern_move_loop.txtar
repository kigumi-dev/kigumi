-- lib/loop.kg --
type Handle = resource {
    pub id Int
}

fn Handle.drop(move self) -> Unit {}

fn Handle.close(move self) -> Unit {}

type Pack = {
    pub inner Handle
    pub other Handle
}

fn tupleInLoop(t: (Handle, Handle)) -> Unit {
    for i in 0..2 {
        match t {
            (_, b) -> b.close()
        }
    }
}

fn recordInLoop(p: Pack) -> Unit {
    for i in 0..2 {
        match p {
            Pack { other, inner: _ } -> other.close()
        }
    }
}


-- lib/across.kg --
async fn zero() -> u8 {
    0
}

async fn held() -> u8 {
    let buf = Bytes.fromArray(&Array.of(1, 2, 3))
    let r = &buf
    let v = await zero()
    r[0] + v
}

async fn endedBefore() -> u8 {
    let buf = Bytes.fromArray(&Array.of(1, 2, 3))
    let first = {
        let r = &buf
        r[0]
    }
    let v = await zero()
    first + v
}

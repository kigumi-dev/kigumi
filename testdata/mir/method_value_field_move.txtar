-- lib/mv.kg --
type Res = resource {
    pub n Int
}

fn Res.drop(move self) -> Unit {}

fn Res.get(self, k: Int) -> Int { self.n + k }

type Pair = {
    pub tag Int
    pub left Res
}

fn take(p: Pair) -> Unit {}

fn moved(p: Pair) -> Int {
    let f = p.left.get
    f(1) + p.tag
}

fn wholeAfter(p: Pair) -> Unit {
    let f = p.left.get
    take(p)
}

fn twice(p: Pair) -> Unit {
    let f = p.left.get
    let g = p.left.get
}

fn show(r: &Res) -> Unit {}

fn reserved(p: Pair) -> Unit {
    defer show(&p.left)
    let f = p.left.get
}

fn optional(o: Res?) -> Unit {
    let f = o?.get
    let g = o?.get
}

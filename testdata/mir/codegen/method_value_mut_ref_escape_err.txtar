-- lib/mv.kg --
interface Show {
    fn show(self) -> String
}

type Tag = { pub s String }

fn Tag.show(self) -> String { "<${self.s}>" }

type Tally = { pub mut n Int }

fn Tally.bump[U: Show](mut self, v: U) -> String {
    self.n = self.n + 1
    "${self.n}:${v.show()}"
}

fn Tally.step(mut self, k: Int) -> Int {
    self.n = self.n + k
    self.n
}

fn viaRef(t: &mut Tally) -> String {
    let b: fn(Tag) -> String = t.bump
    b(Tag { s: "r" })
}

fn viaRefPlain(t: &mut Tally) -> Int {
    let s: fn(Int) -> Int = t.step
    s(1)
}

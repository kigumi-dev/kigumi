type Res = resource {
    pub n Int
}

fn Res.drop(move self) {}

fn Res.get(self, k: Int) -> Int { self.n + k }

interface Getter {
    fn get(self, k: Int) -> Int
}

fn sourceAfterMove(w: Res) -> Int {
    let f = w.get
    w.get(2) + f(1)
}

fn valueAfterMove[T: Getter](t: T) -> Int {
    let f = t.get
    let g = f
    f(1) + g(1)
}

type Res = resource {
    pub id Int
}

fn Res.drop(move self) -> Unit {}

fn Res.close(move self) -> Unit {}

fn tryTwice(r: Result[Res, Int]) -> Result[Int, Int] {
    let a = r?
    let b = r?
    a.close()
    b.close()
    Ok(1)
}

fn orTwice(o: Res?, d: Res, e: Res) -> Unit {
    let a = o || d
    let b = o || e
    a.close()
    b.close()
}

fn captureThenClose(r: Res) -> Unit {
    let f = () => { r.close() }
    r.close()
    f()
}

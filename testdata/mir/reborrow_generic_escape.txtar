-- lib/reborrow.kg --
// A type parameter unified to `&mut U` isn't a written `&mut T`, so E220
// can't stop it escaping via a bare-T return; reborrow must not apply here
// (own_borrowed.go's checkAliasedMutArgs doesn't see past a return).
fn identity[T](x: T) -> T {
    x
}

fn outer(out: &mut Array[u8]) -> Unit {
    let r = identity(out)
    out.push(1)
    r.push(2)
}
-- expect --
fn lib.identity(%x: T) -> T {
  b0:
    %t1 = move(%x)
    nop
    return %t1
}
fn lib.outer(%out: &mut Array[u8]) -> Unit {
  b0:
    %t1 = move(%out)
    %t2 = call identity(%t1)
    %r = copy(%t2)
    %t4 = borrow 1(%out)
    %t5 = share retain(%t4)
    %t6 = newcell(%t5)
    %t7 = const 1: u8
    %t8 = call push(%t6, %t7)
    %t9 = celltake(%t6)
    drop(%t9)
    drop(%t8)
    %t10 = borrow 1(%r)
    %t11 = share retain(%t10)
    %t12 = newcell(%t11)
    %t13 = const 2: u8
    %t14 = call push(%t12, %t13)
    %t15 = celltake(%t12)
    drop(%t15)
    drop(%r)
    return %t14
}

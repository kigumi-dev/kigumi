-- lib/lt.kg --
fn pickOne['a](cond: Bool, a: &'a Bytes, b: &'a Bytes) -> &'a Bytes {
    if cond {
        a
    } else {
        b
    }
}

fn peek() -> u8 {
    let buf1 = Bytes.fromArray(&Array.of(1, 2, 3))
    let r = {
        let buf2 = Bytes.fromArray(&Array.of(4, 5, 6))
        pickOne(false, &buf1, &buf2)
    }
    r[0]
}

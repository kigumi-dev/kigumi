type View['a] = { pub data &'a Bytes, pub off usize }

fn head['a](b: &'a Bytes) -> View['a] {
    View { data: b, off: 0 }
}

fn View['a].peek(self) -> &Bytes {
    self.data
}

fn escapeRecv['a](buf: &'a Bytes) -> Unit {
    let v = head(buf)
    let r = v.peek()
    let xs = Array.of(r)
}

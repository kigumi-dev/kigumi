-- lib/field.kg --
type Inner = resource {
    pub id Int
}

fn Inner.drop(move self) {
    _ = self
}

type Outer = {
    pub inner Inner
    pub n Int
}

fn keep(o: Outer) -> Outer {
    o
}

fn Outer.steal(self) -> Outer {
    keep(self)
}

fn Outer.count(self) -> Int {
    self.n
}

fn peek(o: &Outer) -> Int {
    o.inner.id
}


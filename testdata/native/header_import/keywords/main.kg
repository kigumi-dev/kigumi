import kw from c/kw

let sum = unsafe {
    kw.params(1, 1, 1, 1, 1, 1, 1, 1)
}
let m = unsafe {
    kw.match_(5)
}
let f = unsafe {
    kw.fail_(21)
}
let p = kw.Pair {
    type_: 1
    match_: 2
}
let added = unsafe {
    kw.mut_add(1, 2)
}
let fromFn = unsafe {
    kw.fn_t_sum(kw.fn_ { x: 5 })
}
print "${sum} ${m} ${f} ${p.type_ + p.match_} ${fromFn} ${kw.is_} ${added}"

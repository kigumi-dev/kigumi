import ffi from std/ffi
import wide from c/wide

export(C) {
    pub fn kg_echo128(a: i128, b: u128) -> i128 {
        a.wrappingAdd(b.toI128() || 0)
    }
}

let made = unsafe {
    wide.cheader128_make(3, 5, -1, 11)
}
print "made ${made.tag} ${made.big} ${made.neg} ${made.last}"
let bumped = unsafe {
    wide.cheader128_bump(made)
}
print "bumped ${bumped.tag} ${bumped.big} ${bumped.neg} ${bumped.last}"
let mine = wide.Wide {
    tag: 1
    big: 340282366920938463463374607431768211455
    neg: -5
    last: -2
}
print "hi/lo ${unsafe { wide.cheader128_hi(mine) }} ${unsafe { wide.cheader128_lo(mine) }}"
let again = unsafe {
    wide.cheader128_bump(mine)
}
print "again ${again.tag} ${again.big} ${again.neg} ${again.last}"
let cSize = unsafe {
    wide.cheader128_sizeof()
}
let cAlign = unsafe {
    wide.cheader128_alignof()
}
print "layout ${ffi.sizeOf(&mine)} ${cSize} ${ffi.alignOf(&mine)} ${cAlign}"
let sum = unsafe { wide.cheader128_add(mine.neg, mine.big) }
let shifted = unsafe { wide.cheader128_shl(mine.big, 64) }
print "scalar ${sum} ${shifted} ${unsafe { wide.cheader128_sign(mine.neg) }} ${unsafe { wide.cheader128_sign(mine.big.toI128() || 0) }}"
print "echo ${unsafe { wide.cheader128_echo_call(mine.neg, 5) }}"

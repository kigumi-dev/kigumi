# Primitive op registry: the source of truth for the std ops shared by the Go
# compiler, the generated C header rt_std_ops.h and the bodiless std functions.

# Ids are explicit and only appended. Regenerate the header with
# UPDATE=1 go test ./internal/llgen -run StdOpHeader.

# op ID NAME primitive|provider (arg classes) -> result class

# cap C, key K, suffix METHOD, prefix P, type PKG NAME, direct NAME, elem and
# callback N attach to the op above.

# type is a std record the C runtime builds by name; direct the DirectPrim result form;
# elem an op that copies an array element; callback the index of a closure argument.

# builtin NAME (arg classes) -> result [min=N] [iter] [vm] [native=runtime|inline]

# isr inert|mmio DEVICE.OP|sync OP width=W impl=I [nest=C] is the reviewed interrupt contract;
# a `bodiless NAME` group gives it to key/prefix-matched std functions lowered without an op.

op 0 LEN primitive (string|bytes) -> int
isr inert
direct Len
key prelude.Bytes.len
key prelude.String.len
op 1 STRING_TO_BYTES primitive (string) -> bytes
key prelude.String.toBytes
op 2 STRING_FROM_BYTES primitive (bytes) -> result
key prelude.String.fromBytes
op 3 STRING_TRY_FROM_BYTES primitive (bytes) -> result
key prelude.String.tryFromBytes
op 4 EQUALS primitive (any, any) -> bool
suffix equals
op 5 COMPARE_TO primitive (any, any) -> named
suffix compareTo
op 6 HASH primitive (any) -> int
suffix hash
